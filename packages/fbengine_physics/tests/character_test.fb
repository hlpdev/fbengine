// Characters: walking, falling, steps and walls, pushing, crouching, and their bodies.

Import std.math
Import std.test
Import fbengine_physics
Import fbengine_physics.c.fbe_body
Import fbengine_physics.c.fbe_character
Import fbengine_physics.c.fbe_physics
Import fbengine_physics.c.fbe_shape

Function Near(a: Float, b: Float, within: Float = 0.01): Bool => Abs(a - b) <= within

// A world with a floor whose top is at y = 0, and a player, a capsule 1.8 tall, standing on it.
Function Standing(): (PhysicsWorld, Body, Character)
    Local world = PhysicsWorld()
    Local floor = Body(world, Shape.Box(Vec3(40, 1, 40)), Motion.STATIC, Vec3(0, -0.5, 0))
    Local player = Character(world, Shape.Capsule(1.8, 0.3), Vec3(0, 0.9, 0))
    Return (world, floor, player)
End Function

// Walks `player` at `velocity` along the ground for `seconds`, falling while it's in the air.
Function Walk(world: PhysicsWorld, player: Character, velocity: Vec3, seconds: Float64)
    Local fall: Float = 0
    For i = 1 To Round(seconds * 60) As Int
        fall = player.OnGround() ? 0.0 : fall - 9.81 / 60
        player.Move(Vec3(velocity.x, fall, velocity.z), 1.0 / 60)
        world.Step(1.0 / 60)
    End For
End Function

@Test
Function ACharacterWalksOnTheFloor()
    Local world, floor, player = Standing()
    Defer world.Free()
    Walk(world, player, Vec3(0, 0, -2), 1.0)
    Expect(player.OnGround())
    Expect(player.Ground() == Ground.ON_GROUND)
    Expect(Near(player.Position().z, -2, 0.05))
    Expect(Near(player.Position().y, 0.9, 0.05))
    Expect(Distance(player.GroundNormal(), Vec3(0, 1, 0)) < 0.01)
    Expect(player.GroundBody() == floor)
    Expect(Near(player.Velocity().z, -2, 0.05))
End Function

@Test
Function ACharacterInTheAirFallsAndLands()
    Local world, _, player = Standing()
    Defer world.Free()
    player.SetPosition(Vec3(0, 3, 0))
    player.Move(Vec3(0, 0, 0), 1.0 / 60)
    Expect(player.Ground() == Ground.IN_AIR)
    Walk(world, player, Vec3(0, 0, 0), 2.0)
    Expect(player.OnGround())
    Expect(Near(player.Position().y, 0.9, 0.05))
End Function

@Test
Function ACharacterWalksUpAStepButNotAWall()
    Local world, _, player = Standing()
    Defer world.Free()
    // A step 0.3 high ahead, and a wall on it further on.
    Body(world, Shape.Box(Vec3(4, 0.3, 6)), Motion.STATIC, Vec3(0, 0.15, -4))
    Body(world, Shape.Box(Vec3(4, 3, 1)), Motion.STATIC, Vec3(0, 1.8, -6))
    Walk(world, player, Vec3(0, 0, -2), 4.0)
    Expect(player.Position().y > 1.15, "it's at {player.Position()}")
    // The wall's face is at z = -5.5, and the capsule's 0.3 wide.
    Expect(player.Position().z > -5.25)
    Expect(player.Position().z < -5)
End Function

@Test
Function ACharacterDoesntClimbAStepHigherThanItsStepHeight()
    Local world, _, player = Standing()
    Defer world.Free()
    player.SetStepHeight(0.1)
    Expect(Near(player.StepHeight(), 0.1))
    // A step 0.3 high from z = -1 on.
    Body(world, Shape.Box(Vec3(4, 0.3, 6)), Motion.STATIC, Vec3(0, 0.15, -4))
    Walk(world, player, Vec3(0, 0, -2), 2.0)
    Expect(player.Position().y < 1, "it's at {player.Position()}")
    Expect(player.Position().z > -1.05)
End Function

// A ramp of `degrees` rising from z = -1 toward -Z, 6 m long, as a mesh.
Function Ramp(world: PhysicsWorld, degrees: Float) Throws ShapeError
    Local high = 6 * Tan(degrees * Pi / 180)
    Local corners: Vec3[] = [Vec3(-2, 0, -1), Vec3(2, 0, -1), Vec3(2, high, -7), Vec3(-2, high, -7)]
    Body(world, Try Shape.Mesh(corners, [0, 1, 2, 0, 2, 3]), Motion.STATIC, Vec3(0, 0, 0))
End Function

@Test
Function ACharacterWalksUpASlopeNoSteeperThanItsMaxSlope() Throws ShapeError
    Local world, _, player = Standing()
    Defer world.Free()
    Try Ramp(world, 30)
    Walk(world, player, Vec3(0, 0, -2), 2.5)
    // Some 4 m up the ramp, 2.3 m high.
    Expect(player.Position().y > 2, "it's at {player.Position()}")
    Expect(player.OnGround())
End Function

@Test
Function ACharacterDoesntWalkUpASlopeSteeperThanItsMaxSlope() Throws ShapeError
    Local world, _, player = Standing()
    Defer world.Free()
    Try Ramp(world, 60)
    Walk(world, player, Vec3(0, 0, -2), 2.5)
    Expect(player.Position().y < 1.5, "it's at {player.Position()}")
    Expect(player.Position().z > -2)
End Function

@Test
Function ACharacterPushesADynamicBody()
    Local world, _, player = Standing()
    Defer world.Free()
    // Too high to step onto.
    Local crate = Body(world, Shape.Box(Vec3(1, 1, 1)), Motion.DYNAMIC, Vec3(0, 0.5, -1.5))
    crate.SetMass(10)
    Walk(world, player, Vec3(0, 0, -2), 1.5)
    Expect(crate.Position().z < -2, "the crate's at {crate.Position()}")
    Expect(player.Position().y < 1)
End Function

@Test
Function ACharacterCrouchesAndCantStandUnderATable()
    Local world, _, player = Standing()
    Defer world.Free()
    Local crouched = Shape.Capsule(0.9, 0.3)
    Local standing = player.Shape()
    Expect(player.SetShape(crouched))
    Expect(player.Shape() == crouched)
    Expect(player.Body().Shape() == crouched)
    // Under a table top 1.2 up.
    player.SetPosition(Vec3(0, 0.45, 0))
    Body(world, Shape.Box(Vec3(3, 0.1, 3)), Motion.STATIC, Vec3(0, 1.25, 0))
    Expect(!player.SetShape(standing))
    Expect(player.Shape() == crouched)
End Function

@Test
Function CastsHitACharactersBody()
    Local world, _, player = Standing()
    Defer world.Free()
    Local hit = world.CastRay(Vec3(0, 0.9, 5), Vec3(0, 0, -1), 10)
    Expect(hit?.Body == player.Body())
    Expect(Near(hit?.Distance ?? 0, 4.7, 0.02))
    // A sensor notices it walk in.
    Local zone = Body(world, Shape.Box(Vec3(2, 2, 2)), Motion.STATIC, Vec3(0, 1, -3))
    zone.SetSensor(True)
    Walk(world, player, Vec3(0, 0, -2), 1.5)
    Expect(zone.Touching().Contains(player.Body()))
End Function

@Test
Function ACharactersSettingsAreItsOwn()
    Local world, _, player = Standing()
    Defer world.Free()
    Expect(Near(player.MaxSlope(), 50 * Pi / 180, 0.001))
    Expect(Near(player.Mass(), 70))
    Expect(Near(player.Strength(), 100))
    Expect(Near(player.StepHeight(), 0.4))
    player.SetMaxSlope(Pi / 6)
    player.SetMass(90)
    player.SetStrength(500)
    Expect(Near(player.MaxSlope(), Pi / 6, 0.001))
    Expect(Near(player.Mass(), 90) && Near(player.Strength(), 500))
    player.Body().SetLayer(4)
    Expect(player.Body().Layer() == 4)
End Function

@Test @MainThread
Function ACharacterAndItsBodyGoWithItsWorld()
    Local characters = fbe_character_count()
    Local world, _, player = Standing()
    Local body = player.Body()
    Expect(fbe_character_count() == characters + 1)
    Expect(world.Bodies() == 2)
    player.Free()
    Expect(player.Freed() && body.Freed())
    Expect(world.Bodies() == 1)
    Local other = Character(world, Shape.Capsule(1.8, 0.3), Vec3(5, 0.9, 0))
    Local its = other.Body()
    world.Free()
    Expect(other.Freed() && its.Freed())
    Expect(fbe_character_count() == characters)
End Function

@Test @MainThread
Function TheCApiKeepsACharactersBodyItsCharacters()
    Local world = fbe_physics_new(10)
    Defer fbe_physics_free(world)
    Local capsule = fbe_shape_capsule(1.8, 0.3)
    Defer fbe_shape_free(capsule)
    Local start = fbe_character_vec3_t(0, 0.9, 0)
    Local player: UInt64 = 0
    Unsafe
        player = fbe_character_new(world, capsule, AddressOf(start))
    End Unsafe
    Expect(player != 0)
    Local body = fbe_character_body(player)
    Expect(body != 0)
    Local at = fbe_body_vec3_t(0, 5, 0)
    Unsafe
        Expect(!fbe_body_set_position(body, AddressOf(at)))
        Expect(Error() == "a character's body goes as its character goes")
        Expect(!fbe_body_set_velocity(body, AddressOf(at)))
    End Unsafe
    Expect(!fbe_body_free(body))
    Expect(!fbe_body_set_sensor(body, True))
    Expect(!fbe_body_set_motion(body, FBE_BODY_DYNAMIC))
    Expect(!fbe_body_sleep(body))
    Expect(!fbe_body_wake(body))
    Expect(fbe_body_motion(body) == FBE_BODY_KINEMATIC)
    Expect(!fbe_character_set_max_slope(player, 2))
    Expect(Error() == "a max slope is 0 to pi / 2, not 2")
    Local still = fbe_character_vec3_t(0, 0, 0)
    Unsafe
        Expect(!fbe_character_move(player, AddressOf(still), 0))
        Expect(Error() == "a character moves for more than 0 seconds and at most 1, not 0")
    End Unsafe
    Expect(fbe_character_free(player))
    Expect(fbe_body_motion(body) == -1)
    Expect(!fbe_character_free(player))
    Expect(Error() == "the character was freed")
End Function

@MainThread Function Error(): String
    Unsafe
        Return fbe_physics_error().ToString()
    End Unsafe
End Function
