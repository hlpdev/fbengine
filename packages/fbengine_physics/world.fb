// Worlds of bodies, which Jolt steps on.

Import std.collections
Import std.core
Import std.ffi
Import std.math
Import "./body"
Import "./c/fbe_physics"
Import "./character"
Import "./hits"
Import "./joint"
Import "./physics"
Import "./shape"
Import "./state"
Import "./sync"
Import fbengine

/// A world of bodies, which Jolt moves on each time it's stepped: by Step, for the time a game
/// says, or by Update, at a fixed rate for the time frames take, as most games want, since a
/// fixed step is steady and repeats. Its axes and units are std.math's: right-handed, Y up,
/// meters, seconds. It's deterministic: made and stepped by the same calls in the same order, it
/// moves the same, bit for bit, as Step says, and Save and Restore take it back to where it was,
/// as replays and games played in lockstep need. Its bodies are each in one of 32 layers, which
/// collide with each other as SetCollides says, and casts hit as their `layers` say, a bit for
/// each. Free frees it.
///
/// # Examples
///
/// ```
/// Import std.math
/// Import fbengine_physics
///
/// Local world = PhysicsWorld()
/// Expect(world.Gravity() == Vec3(0, -9.81, 0))
/// // A frame of a 30th of a second is two steps of a 60th.
/// Expect(world.Update(1.0 / 30) == 2)
/// world.Free()
/// ```
Public Final Class PhysicsWorld
    Field handle: UInt64
    Field rate: Int32 = 60
    Field mostSteps: Int32 = 4
    // The time Update was given that no step has taken yet.
    Field owed: Float64 = 0
    // Its bodies, joints, and characters, by handle.
    Field bodies: Map<UInt64, Body>
    Field joints: Map<UInt64, Joint>
    Field characters: Map<UInt64, Character>
    // What began and ended touching in the last Step, or the last Update's steps.
    Field began: Contact[] = []
    Field ended: Separation[] = []
    // Whether Update is stepping it, so each step adds to what began and ended, and its bodies and
    // entities are kept together once, around them all.
    Field updating: Bool = False
    // Its bodies kept with entities.
    Field attachments: Attachments
    // Whether each Flip updates it, and whether a Flip has work for it.
    Field eachFrame: Bool = False
    Field atFlips: Bool = False

    /// A world with no bodies and Earth's gravity, which keeps room for at most `maxBodies`, from 1
    /// to 1048576.
    @MainThread Public New(maxBodies: Int32 = 16384)
        If maxBodies < 1 || maxBodies > FBE_PHYSICS_MAX_BODIES
            Panic("PhysicsWorld: a world is for 1 to {FBE_PHYSICS_MAX_BODIES} bodies, not {maxBodies}")
        End If
        bodies = Map<UInt64, Body>()
        joints = Map<UInt64, Joint>()
        characters = Map<UInt64, Character>()
        attachments = Attachments()
        Physics.ChooseThreads()
        handle = fbe_physics_new(maxBodies As UInt32)
        If handle == 0 Then Panic("PhysicsWorld: {LastError()}")
    End New

    /// Frees the world and its bodies, joints, and characters; using any of them after panics.
    /// Freeing one that's freed already does nothing.
    @MainThread Public Method Free()
        If handle == 0 Then Return
        fbe_physics_free(handle)
        handle = 0
        ForgetAll()
        attachments.Clear()
        bodies.Clear()
        joints.Clear()
        characters.Clear()
    End Method

    // A world dropped unfreed frees itself.
    Method Destroy()
        If handle == 0 Then Return
        fbe_physics_free(handle)
        handle = 0
        ForgetAll()
    End Method

    // Its bodies, joints, and characters went with it.
    @MainThread Method ForgetAll()
        For kept In bodies.Values()
            kept.Forget()
        End For
        For joint In joints.Values()
            joint.Forget()
        End For
        For character In characters.Values()
            character.Forget()
        End For
    End Method

    /// Whether Free has freed the world.
    @MainThread Public Method Freed(): Bool => handle == 0

    /// The most bodies the world keeps room for.
    @MainThread Public Method MaxBodies(): Int32 =>
        fbe_physics_max_bodies(Live("PhysicsWorld.MaxBodies")) As Int32

    /// Sets the world's gravity, in meters a second a second, which is (0, -9.81, 0) at first.
    @MainThread Public Method SetGravity(gravity: Vec3)
        Local g = fbe_physics_vec3_t(gravity.x, gravity.y, gravity.z)
        Local ok = False
        Unsafe
            ok = fbe_physics_set_gravity(Live("PhysicsWorld.SetGravity"), AddressOf(g))
        End Unsafe
        If !ok Then Panic("PhysicsWorld.SetGravity: {LastError()}, not {gravity}")
    End Method

    /// The world's gravity, in meters a second a second.
    @MainThread Public Method Gravity(): Vec3
        Local g = fbe_physics_vec3_t(0, 0, 0)
        Unsafe
            fbe_physics_gravity(Live("PhysicsWorld.Gravity"), AddressOf(g))
        End Unsafe
        Return Vec3(g.x, g.y, g.z)
    End Method

    /// Steps the world on by `seconds`, more than 0 and at most 1, finding its collisions
    /// `collisionSteps` times on the way, from 1 to 16, or with 0, once for each 60th of a second,
    /// as Jolt suggests. A world made and stepped by the same calls in the same order moves the
    /// same, bit for bit, on any number of threads, whatever floating point mode the game's thread
    /// is in, while Overflowed is False; Jolt is built to make it the same on every target,
    /// compiler, and build too, which is checked on Windows x64 so far.
    @MainThread Public Method Step(seconds: Float64, collisionSteps: Int32 = 0)
        Local world = Live("PhysicsWorld.Step")
        Local steps = collisionSteps
        // What's out of range C says so of.
        If steps == 0 && seconds > 0 && seconds <= 1 Then steps = CollisionStepsFor(seconds)
        If steps == 0 Then steps = 1
        If !updating && seconds > 0 && seconds <= 1
            attachments.Follow(seconds As Float32, seconds As Float32)
        End If
        If !fbe_physics_step(world, seconds As Float32, steps)
            Panic("PhysicsWorld.Step: {LastError()}")
        End If
        If !updating
            began.Clear()
            ended.Clear()
        End If
        TakeContacts()
        If !updating Then attachments.Drive(fbe_physics_moves(world))
    End Method

    /// How many times the world's been stepped, by Step and by Update.
    @MainThread Public Method Steps(): Int64 => fbe_physics_steps(Live("PhysicsWorld.Steps"))

    /// Whether the last step ran out of room for bodies touching, and so left some of their
    /// contacts out, as a pile of more bodies than MaxBodies keeps room for can. Which it left out
    /// depends on the threads it ran on, so a world is deterministic only while this is False.
    @MainThread Public Method Overflowed(): Bool =>
        fbe_physics_overflowed(Live("PhysicsWorld.Overflowed"))

    /// Steps the world for `seconds` of time, from 0 on, as a frame took: as many steps of a
    /// StepRate()th of a second as are due, carrying what's left over to the next Update. It takes
    /// at most MaxSteps() of them, dropping the rest of the time, so a slow frame never makes the
    /// next one slower. Gives how many steps it took. It keeps entities that bodies drive where
    /// they are, in one batch at its end, and captures their Worlds before its last step, so
    /// RenderWorld(world.Alpha()) draws them between its last two steps.
    @MainThread Public Method Update(seconds: Float64): Int32
        Live("PhysicsWorld.Update")
        If !(seconds >= 0 && seconds < 1e9)
            Panic("PhysicsWorld.Update: a frame takes 0 seconds or more, not {seconds}")
        End If
        Local step = 1.0 / (rate As Float64)
        owed += seconds
        Local taken = 0
        // A step's time owed but for rounding is due.
        Local due = step * 0.999
        began.Clear()
        ended.Clear()
        // Followers get to their entities by the end of the steps due.
        Local stepsDue = 0
        Local left = owed
        While left >= due && stepsDue < mostSteps
            left -= step
            stepsDue += 1
        End While
        If stepsDue > 0 Then attachments.Follow((stepsDue * step) As Float32, step As Float32)
        updating = True
        While owed >= due && taken < mostSteps
            // What's drawn between steps is from where the last began.
            If taken == stepsDue - 1
                attachments.DriveIfMoved(fbe_physics_moves(handle))
                attachments.CaptureWorlds()
            End If
            Step(step)
            owed -= step
            taken += 1
        End While
        updating = False
        If owed >= due Then owed = 0
        If taken > 0 Then attachments.Drive(fbe_physics_moves(handle))
        Return taken
    End Method

    /// Puts the entities of the bodies that drive them where those bodies are now, in one batch, as
    /// each Step, Update, and Flip do, for what moves a body between them, as a Character's Move or
    /// SetPosition, to draw where it's gone in the same frame.
    @MainThread Public Method Sync()
        attachments.Drive(fbe_physics_moves(Live("PhysicsWorld.Sync")))
    End Method

    // How many entities' poses its batches have written, and what's moved its bodies, for tests.
    @MainThread Package Method Writes(): Int64 => attachments.writes

    @MainThread Package Method Moves(): Int64 => fbe_physics_moves(Live("PhysicsWorld.Moves"))

    /// Has each Flip Update the world for the time the last frame took, so a game needn't, or stops
    /// it. A game that steps it itself, as one that's deterministic must, leaves this off, as it is
    /// at first.
    @MainThread Public Method UpdateEachFrame(update: Bool = True)
        Live("PhysicsWorld.UpdateEachFrame")
        eachFrame = update
        If update Then ListForFlips()
    End Method

    /// Whether each Flip updates the world.
    @MainThread Public Method UpdatesEachFrame(): Bool
        Live("PhysicsWorld.UpdatesEachFrame")
        Return eachFrame
    End Method

    // What's kept with `entity`, or Null.
    @MainThread Package Method AttachmentOf(entity: Entity): Attachment? => attachments.Of(entity)

    // Keeps `attachment`, whose body's in it, and works for it at each Flip.
    @MainThread Package Method Attach(attachment: Attachment)
        attachments.Add(attachment)
        ListForFlips()
    End Method

    // Lets go of `attachment`.
    @MainThread Package Method LetGo(attachment: Attachment)
        attachments.Drop(attachment)
    End Method

    @MainThread Method ListForFlips()
        If atFlips Then Return
        atFlips = True
        FlipFor(Self)
    End Method

    // Its work at a Flip, a frame of `seconds` after the last: whether it has any left.
    @MainThread Package Method AtFlip(seconds: Float64): Bool
        If handle == 0 Then Return False
        If eachFrame Then Update(seconds)
        attachments.DriveIfMoved(fbe_physics_moves(handle))
        atFlips = eachFrame || attachments.Any()
        Return atFlips
    End Method

    /// How far through the next step the time Update has been given is, from 0 up to 1, for
    /// drawing what moves between its last two steps, as an entity's TweenedMatrix or RenderWorld
    /// takes it. After SetStepRate raises the rate, it can read 1 until the next Update takes the
    /// steps now due.
    ///
    /// # Examples
    ///
    /// ```
    /// Import std.math
    /// Import fbengine
    /// Import fbengine_physics
    ///
    /// Local world = PhysicsWorld()
    /// Local ball = Pivot()
    /// Local body = Body(world, Shape.Sphere(0.5), Motion.DYNAMIC, ball)
    /// body.SetVelocity(Vec3(60, 0, 0))
    /// world.SetGravity(Vec3(0, 0, 0))
    /// // A frame of a 144th of a second, which takes no step at first.
    /// world.Update(1.0 / 60)
    /// world.Update(1.0 / 144)
    /// // A step moves it a meter; it's drawn as far between the last two as the time's gone on.
    /// Expect(Abs(ball.TweenedMatrix(world.Alpha() As Float).w.x - (world.Alpha() As Float)) < 0.01)
    /// world.Free()
    /// ball.Free()
    /// ```
    @MainThread Public Method Alpha(): Float64
        Live("PhysicsWorld.Alpha")
        Return Clamp(owed * (rate As Float64), 0.0, 1.0)
    End Method

    /// Makes Update step `stepsPerSecond` times a second, from 1 to 1000, 60 at first.
    @MainThread Public Method SetStepRate(stepsPerSecond: Int32)
        Live("PhysicsWorld.SetStepRate")
        If stepsPerSecond < 1 || stepsPerSecond > 1000
            Panic("PhysicsWorld.SetStepRate: a world steps 1 to 1000 times a second, not {stepsPerSecond}")
        End If
        rate = stepsPerSecond
    End Method

    /// How many times a second Update steps the world.
    @MainThread Public Method StepRate(): Int32
        Live("PhysicsWorld.StepRate")
        Return rate
    End Method

    /// Makes Update take at most `steps` steps, from 1 to 100, 4 at first.
    @MainThread Public Method SetMaxSteps(steps: Int32)
        Live("PhysicsWorld.SetMaxSteps")
        If steps < 1 || steps > 100
            Panic("PhysicsWorld.SetMaxSteps: an Update takes 1 to 100 steps, not {steps}")
        End If
        mostSteps = steps
    End Method

    /// The most steps an Update takes.
    @MainThread Public Method MaxSteps(): Int32
        Live("PhysicsWorld.MaxSteps")
        Return mostSteps
    End Method

    /// How many bodies the world has.
    @MainThread Public Method Bodies(): Int32 => fbe_physics_bodies(Live("PhysicsWorld.Bodies"))

    /// Sorts the world's bodies for finding quickly which might touch, as is worth doing once
    /// after adding many at once, as loading a level does, rather than every step.
    @MainThread Public Method Optimize()
        fbe_physics_optimize(Live("PhysicsWorld.Optimize"))
    End Method

    /// Makes the bodies of layers `a` and `b`, from 0 to 31, collide with each other, or not, from
    /// the next step: a player's with a ghost's, say, or not. Every layer collides with every one at
    /// first.
    @MainThread Public Method SetCollides(a: Int32, b: Int32, collides: Bool)
        If !fbe_physics_set_collides(Live("PhysicsWorld.SetCollides"), a, b, collides)
            Panic("PhysicsWorld.SetCollides: {LastError()}")
        End If
    End Method

    /// Whether the bodies of layers `a` and `b`, from 0 to 31, collide.
    @MainThread Public Method Collides(a: Int32, b: Int32): Bool
        Local world = Live("PhysicsWorld.Collides")
        If a < 0 || a >= FBE_PHYSICS_LAYERS || b < 0 || b >= FBE_PHYSICS_LAYERS
            Panic(
                "PhysicsWorld.Collides: a layer is 0 to {FBE_PHYSICS_LAYERS - 1}, not {a} and {b}")
        End If
        Return fbe_physics_collides(world, a, b)
    End Method

    /// The nearest body of the `layers`, a bit for each, but `ignore`, that a ray from `origin`
    /// along `direction`, which isn't 0, hits within `distance` meters, as a shot or a look at
    /// what's ahead does, or Null for none. It hits a mesh's triangles from their front only,
    /// unless `backFaces`, as a ray from inside a room hits its walls, which face in, and one from
    /// outside goes in; and a convex shape from inside it too, at 0 meters. Casts never hit a
    /// sensor. Jolt's test of a ray against a triangle is in floats, and isn't watertight, so a ray
    /// aimed just where a mesh's triangles meet can pass between them, a few in a thousand of such
    /// rays nearby and one in ten from 100 m. What mustn't, as a ground check, uses CastShape with
    /// a Shape.Sphere(0.01), whose sweep doesn't.
    @MainThread Public Method CastRay(origin: Vec3, direction: Vec3, distance: Float,
                                      layers: UInt32 = ALL_LAYERS, ignore: Body? = Null,
                                      backFaces: Bool = False): Hit?
        Local world = Live("PhysicsWorld.CastRay")
        Local from = fbe_physics_vec3_t(origin.x, origin.y, origin.z)
        Local along = fbe_physics_vec3_t(direction.x, direction.y, direction.z)
        Local skip = Ignored(ignore, "PhysicsWorld.CastRay")
        Local hit = fbe_physics_hit_t(0, from, from, 0, -1)
        Local found = False
        Unsafe
            found = fbe_physics_cast_ray(world, AddressOf(from), AddressOf(along), distance, layers,
                                         skip, backFaces, AddressOf(hit))
        End Unsafe
        If !found
            If LastError() != "the ray hits nothing" Then Panic("PhysicsWorld.CastRay: {LastError()}")
            Return Null
        End If
        Return HitOf(hit)
    End Method

    /// Every body CastRay's ray hits, nearest first, as CastRay hits them: once where it crosses
    /// each surface, though it crosses where a mesh's triangles share an edge or a corner.
    @MainThread Public Method CastRayAll(origin: Vec3, direction: Vec3, distance: Float,
                                         layers: UInt32 = ALL_LAYERS, ignore: Body? = Null,
                                         backFaces: Bool = False): Hit[]
        Local world = Live("PhysicsWorld.CastRayAll")
        Local from = fbe_physics_vec3_t(origin.x, origin.y, origin.z)
        Local along = fbe_physics_vec3_t(direction.x, direction.y, direction.z)
        Local skip = Ignored(ignore, "PhysicsWorld.CastRayAll")
        Local hits = Buffer<fbe_physics_hit_t>(16)
        Local count = 0
        Unsafe
            count = fbe_physics_cast_ray_all(world, AddressOf(from), AddressOf(along), distance,
                                             layers, skip, backFaces, hits.Pointer(), 16)
            If count > 16
                hits = Buffer<fbe_physics_hit_t>(count As Int64)
                count = fbe_physics_cast_ray_all(world, AddressOf(from), AddressOf(along), distance,
                                                 layers, skip, backFaces, hits.Pointer(), count)
            End If
        End Unsafe
        If count < 0 Then Panic("PhysicsWorld.CastRayAll: {LastError()}")
        Local all: Hit[] = []
        For i = 0 To count - 1
            Local hit = HitOf(hits[i])
            If hit != Null Then all.Add(hit)
        End For
        Return all
    End Method

    /// The first body of the `layers`, but `ignore`, that `shape`, which has no mesh in it, its
    /// origin at `position` and turned by `rotation`, hits moving by `motion`, as a thrown crate's path or a camera kept out of walls
    /// does, its Distance how far along the motion it got, or Null for none. A shape already
    /// touching a body hits it at 0.
    @MainThread Public Method CastShape(shape: Shape, position: Vec3, rotation: Quat, motion: Vec3,
                                        layers: UInt32 = ALL_LAYERS, ignore: Body? = Null): Hit?
        Local world = Live("PhysicsWorld.CastShape")
        Local at = fbe_physics_vec3_t(position.x, position.y, position.z)
        Local turned = fbe_physics_quat_t(rotation.x, rotation.y, rotation.z, rotation.w)
        Local by = fbe_physics_vec3_t(motion.x, motion.y, motion.z)
        Local of = shape.Live("PhysicsWorld.CastShape")
        Local skip = Ignored(ignore, "PhysicsWorld.CastShape")
        Local hit = fbe_physics_hit_t(0, at, at, 0, -1)
        Local found = False
        Unsafe
            found = fbe_physics_cast_shape(world, of, AddressOf(at), AddressOf(turned),
                                           AddressOf(by),
                                           layers, skip, AddressOf(hit))
        End Unsafe
        If !found
            If LastError() != "the shape hits nothing" Then Panic("PhysicsWorld.CastShape: {LastError()}")
            Return Null
        End If
        Return HitOf(hit)
    End Method

    /// The bodies of the `layers`, but `ignore`, that `shape`, which has no mesh in it, its origin
    /// at `position` and turned by `rotation`, touches, as an explosion reaches or a closing door would crush, in an order
    /// that's the same each run.
    @MainThread Public Method Overlapping(shape: Shape, position: Vec3, rotation: Quat,
                                          layers: UInt32 = ALL_LAYERS, ignore: Body? = Null): Body[]
        Local world = Live("PhysicsWorld.Overlapping")
        Local at = fbe_physics_vec3_t(position.x, position.y, position.z)
        Local turned = fbe_physics_quat_t(rotation.x, rotation.y, rotation.z, rotation.w)
        Local of = shape.Live("PhysicsWorld.Overlapping")
        Local skip = Ignored(ignore, "PhysicsWorld.Overlapping")
        Local found = Buffer<UInt64>(16)
        Local count = 0
        Unsafe
            count = fbe_physics_overlap(world, of, AddressOf(at), AddressOf(turned), layers, skip,
                                        found.Pointer(), 16)
            If count > 16
                found = Buffer<UInt64>(count As Int64)
                count = fbe_physics_overlap(world, of, AddressOf(at), AddressOf(turned), layers,
                                            skip,
                                            found.Pointer(), count)
            End If
        End Unsafe
        If count < 0 Then Panic("PhysicsWorld.Overlapping: {LastError()}")
        Return BodiesOf(found, count)
    End Method

    /// The pairs of bodies that began touching in the last Step, or in the steps of the last
    /// Update, in an order that's the same each run: a sensor's are the bodies that came into it.
    @MainThread Public Method Began(): Contact[]
        Live("PhysicsWorld.Began")
        Local all: Contact[] = []
        all.AddAll(began)
        Return all
    End Method

    /// The pairs of bodies that stopped touching in the last Step, or in the steps of the last
    /// Update: a sensor's are the bodies that left it. A body that's freed stops touching what it
    /// touched without one.
    @MainThread Public Method Ended(): Separation[]
        Live("PhysicsWorld.Ended")
        Local all: Separation[] = []
        all.AddAll(ended)
        Return all
    End Method

    /// Saves all the world's steps change, as a PhysicsState that Restore puts back.
    @MainThread Public Method Save(): PhysicsState
        Local world = Live("PhysicsWorld.Save")
        Local size = fbe_physics_save(world, owed)
        Local saved = Buffer<UInt8>(size)
        Unsafe
            fbe_physics_saved(world, saved.Pointer(), size)
        End Unsafe
        Return PhysicsState(saved.ToArray())
    End Method

    /// A hash of all a Save holds but its handles, so two worlds made and stepped by the same calls
    /// have the same, wherever they are, unless they've gone apart, by as little as a bit, as
    /// games played in lockstep can compare to know they have. It's no use between versions of
    /// fbengine_physics, or of the bytes of a PhysicsState.
    @MainThread Public Method StateHash(): UInt64
        Local world = Live("PhysicsWorld.StateHash")
        Local hash: UInt64 = 0
        Local ok = False
        Unsafe
            ok = fbe_physics_state_hash(world, owed, AddressOf(hash))
        End Unsafe
        If !ok Then Panic("PhysicsWorld.StateHash: {LastError()}")
        Return hash
    End Method

    /// Puts the world back as it was when `state` was saved, its bodies, joints, and characters
    /// where they were and moving as they were, so its steps go on exactly as they did from there.
    /// It's a PhysicsStateError, leaving the world as it is, if the state isn't this world's, the
    /// world has other bodies, joints, or characters now than it had then, or it was saved by
    /// another version of fbengine_physics, or changed since.
    @MainThread Public Method Restore(state: PhysicsState) Throws PhysicsStateError
        Local world = Live("PhysicsWorld.Restore")
        Local bytes = state.Kept()
        If bytes.Count == 0 Then Throw PhysicsStateError("that isn't a world's state")
        Local saved = Buffer<UInt8>.From(bytes)
        Local carried: Float64 = 0
        Local ok = False
        Unsafe
            ok = fbe_physics_restore(world, saved.Pointer(), saved.Count, AddressOf(carried))
        End Unsafe
        If !ok Then Throw PhysicsStateError(LastError())
        owed = carried
        began.Clear()
        ended.Clear()
        attachments.FollowersToBodies()
        attachments.ForgetDriven()
        attachments.Drive(fbe_physics_moves(world))
    End Method

    // What began and ended in the step just taken.
    @MainThread Method TakeContacts()
        Local count = fbe_physics_began(handle, Null, 0)
        If count > 0
            Local contacts = Buffer<fbe_physics_contact_t>(count As Int64)
            Unsafe
                fbe_physics_began(handle, contacts.Pointer(), count)
            End Unsafe
            For contact In contacts
                Local a = bodies.Get(contact.a)
                Local b = bodies.Get(contact.b)
                If a != Null && b != Null
                    Local at = Vec3(contact.position.x, contact.position.y, contact.position.z)
                    Local normal = Vec3(contact.normal.x, contact.normal.y, contact.normal.z)
                    began.Add(Contact(a, b, at, normal, contact.speed))
                End If
            End For
        End If
        Local pairs = fbe_physics_ended(handle, Null, 0)
        If pairs > 0
            Local both = Buffer<UInt64>((pairs * 2) As Int64)
            Unsafe
                fbe_physics_ended(handle, both.Pointer(), pairs)
            End Unsafe
            For i = 0 To pairs - 1
                Local a = bodies.Get(both[(i * 2) As Int64])
                Local b = bodies.Get(both[(i * 2 + 1) As Int64])
                If a != Null && b != Null Then ended.Add(Separation(a, b))
            End For
        End If
    End Method

    // The Hit `hit` is, or Null for a body the world doesn't know.
    @MainThread Method HitOf(hit: fbe_physics_hit_t): Hit?
        Local body = bodies.Get(hit.body)
        If body == Null Then Return Null
        Return Hit(body, Vec3(hit.position.x, hit.position.y, hit.position.z),
                   Vec3(hit.normal.x, hit.normal.y, hit.normal.z), hit.distance, hit.triangle)
    End Method

    // The bodies of the first `count` handles in `handles`.
    @MainThread Package Method BodiesOf(handles: Buffer<UInt64>, count: Int32): Body[]
        Local all: Body[] = []
        For i = 0 To Min(count As Int64, handles.Count) - 1
            Local body = bodies.Get(handles[i])
            If body != Null Then all.Add(body)
        End For
        Return all
    End Method

    // The body `handle` is, or Null.
    @MainThread Package Method BodyOf(handle: UInt64): Body? => bodies.Get(handle)

    // Keeps `joint`, which `handle` is, until it's freed.
    @MainThread Package Method KeepJoint(handle: UInt64, joint: Joint)
        joints.Add(handle, joint)
    End Method

    // Forgets the joint `handle` was.
    @MainThread Package Method DropJoint(handle: UInt64)
        joints.Remove(handle)
    End Method

    // Forgets the joints of `body`, which C freed with it.
    @MainThread Package Method DropJointsOf(body: Body)
        For key In joints.Keys()
            Local joint = joints.Get(key)
            If joint != Null && joint.Joins(body)
                joint.Forget()
                joints.Remove(key)
            End If
        End For
    End Method

    // Keeps `character`, which `handle` is, until it's freed.
    @MainThread Package Method KeepCharacter(handle: UInt64, character: Character)
        characters.Add(handle, character)
    End Method

    // Forgets the character `handle` was.
    @MainThread Package Method DropCharacter(handle: UInt64)
        characters.Remove(handle)
    End Method

    // The world's handle, for `call`, which panics once it's freed.
    @MainThread Package Method Live(call: String): UInt64
        If handle == 0 Then Panic("{call}: this PhysicsWorld was freed")
        Return handle
    End Method

    // Keeps `body`, which `handle` is, until it's freed.
    @MainThread Package Method Keep(handle: UInt64, body: Body)
        bodies.Add(handle, body)
    End Method

    // Forgets the body `handle` was.
    @MainThread Package Method Drop(handle: UInt64)
        bodies.Remove(handle)
    End Method
End Class

// Jolt's suggestion: collisions found once a 60th of a second.
Function CollisionStepsFor(seconds: Float64): Int32
    Return Clamp(Ceil(seconds * 60 - 1e-6) As Int32, 1, FBE_PHYSICS_MAX_COLLISION_STEPS)
End Function

// The handle of the body a cast ignores, 0 for none, for `call`.
@MainThread Function Ignored(ignore: Body?, call: String): UInt64
    Local body = ignore
    If body == Null Then Return 0
    Return body.Live(call)
End Function
