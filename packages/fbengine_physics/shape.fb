// Shapes, which bodies are made of.

Import std.core
Import std.ffi
Import std.math
Import "./c/fbe_shape"
Import "./physics"

/// What a Shape is.
Public Enum ShapeKind
    /// A box: Shape.Box.
    BOX = 1
    /// A sphere: Shape.Sphere.
    SPHERE = 2
    /// A capsule: Shape.Capsule.
    CAPSULE = 3
    /// A cylinder: Shape.Cylinder.
    CYLINDER = 4
    /// The convex hull of points: Shape.ConvexHull.
    CONVEX_HULL = 5
    /// A mesh of triangles: Shape.Mesh.
    MESH = 6
    /// Shapes as one: Shape.Compound.
    COMPOUND = 7
End Enum

/// A shape that can't be made of what it was given: a convex hull of points all on a line, or a
/// mesh of no triangles, or of an index past its vertices.
Public Class ShapeError Extends Error
End Class

/// A part of a compound shape: a Shape, turned by Rotation about its own origin, which is at
/// Position in the compound.
Public Struct ShapePart
    /// The part's shape.
    Public Field Shape: Shape
    /// Where the part's origin is, in the compound.
    Public Field Position: Vec3
    /// How the part's turned about its origin.
    Public Field Rotation: Quat
End Struct

/// What a body is made of, made once and shared by as many bodies, in as many worlds, as like:
/// each keeps its own, so a Shape can be freed as soon as its bodies are made. It's in its own
/// space, in std.math's axes and meters: a primitive centered on its origin, a capsule's and a
/// cylinder's length along Y, and a convex hull's, a mesh's, and a compound's parts where they're
/// given. Boxes, spheres, capsules, and cylinders collide fastest, convex hulls next; a mesh is
/// for what doesn't move on its own, as a level's walls and floors.
///
/// ```
/// Local crate = Shape.Box(Vec3(1, 1, 1))
/// Expect(crate.Volume() == 1.0)
/// Expect(crate.Bounds() == (Vec3(-0.5, -0.5, -0.5), Vec3(0.5, 0.5, 0.5)))
/// crate.Free()
/// ```
Public Final Class Shape
    Field handle: UInt64
    ReadOnly Field kind: ShapeKind

    Private New(handle: UInt64, kind: ShapeKind)
        Self.handle = handle
        Self.kind = kind
    End New

    /// A box `size` across, each more than 0.
    @MainThread Public Static Method Box(size: Vec3): Shape
        Local across = fbe_shape_vec3_t(size.x, size.y, size.z)
        Local handle: UInt64 = 0
        Unsafe
            handle = fbe_shape_box(AddressOf(across))
        End Unsafe
        Return Made(handle, ShapeKind.BOX, "Box")
    End Method

    /// A sphere of `radius`, more than 0.
    @MainThread Public Static Method Sphere(radius: Float): Shape
        Return Made(fbe_shape_sphere(radius), ShapeKind.SPHERE, "Sphere")
    End Method

    /// A capsule `height` from end to end, along Y, at least twice its `radius`, which is more than
    /// 0: a cylinder with half a sphere on each end, as a character's body often is. One just twice
    /// its radius is a sphere.
    @MainThread Public Static Method Capsule(height: Float, radius: Float): Shape
        Return Made(fbe_shape_capsule(height, radius), ShapeKind.CAPSULE, "Capsule")
    End Method

    /// A cylinder `height` from end to end, along Y, of `radius`, both more than 0.
    @MainThread Public Static Method Cylinder(height: Float, radius: Float): Shape
        Return Made(fbe_shape_cylinder(height, radius), ShapeKind.CYLINDER, "Cylinder")
    End Method

    /// The smallest convex shape around `points`, three or more not all on a line, as a rock's or
    /// a prop's, which collides far faster than its mesh would. Points all in a plane make a flat
    /// one.
    @MainThread Public Static Method ConvexHull(points: Vec3[]): Shape Throws ShapeError
        Local buffer = Buffer<fbe_shape_vec3_t>(points.Count As Int64)
        For i = 0 To points.Count - 1
            buffer[i] = fbe_shape_vec3_t(points[i].x, points[i].y, points[i].z)
        End For
        Local handle: UInt64 = 0
        Unsafe
            handle = fbe_shape_convex_hull(buffer.Pointer(), points.Count)
        End Unsafe
        If handle == 0 Then Throw ShapeError(LastError())
        Return Shape(handle, ShapeKind.CONVEX_HULL)
    End Method

    /// A mesh of triangles, three of `indices` each into `vertices`, counter-clockwise seen from
    /// their front, for a static or kinematic body: a level's walls and floors. Triangles of no
    /// area are left out, and the rest keep their numbers, from 0, in the order they're given.
    @MainThread Public Static Method Mesh(vertices: Vec3[],
                                          indices: Int32[]): Shape Throws ShapeError
        Local points = Buffer<fbe_shape_vec3_t>(vertices.Count As Int64)
        For i = 0 To vertices.Count - 1
            points[i] = fbe_shape_vec3_t(vertices[i].x, vertices[i].y, vertices[i].z)
        End For
        Local corners = Buffer<UInt32>(indices.Count As Int64)
        For i = 0 To indices.Count - 1
            If indices[i] < 0 Then Throw ShapeError("index {i} of the mesh is {indices[i]}, before its first vertex")
            corners[i] = indices[i] As UInt32
        End For
        Local handle: UInt64 = 0
        Unsafe
            handle = fbe_shape_mesh(points.Pointer(), vertices.Count, corners.Pointer(),
                                    indices.Count)
        End Unsafe
        If handle == 0 Then Throw ShapeError(LastError())
        Return Shape(handle, ShapeKind.MESH)
    End Method

    /// The `parts`, one or more, as one shape, as a table of a box for its top and four for its
    /// legs, or a shape off its body's origin, as a box whose bottom is a character's feet.
    @MainThread Public Static Method Compound(parts: ShapePart[]): Shape
        Local made = Buffer<fbe_shape_part_t>(parts.Count As Int64)
        For i = 0 To parts.Count - 1
            Local part = parts[i]
            Local at = fbe_shape_vec3_t(part.Position.x, part.Position.y, part.Position.z)
            Local turned = fbe_shape_quat_t(part.Rotation.x, part.Rotation.y, part.Rotation.z,
                                            part.Rotation.w)
            made[i] = fbe_shape_part_t(part.Shape.Live("Shape.Compound"), at, turned)
        End For
        Local handle: UInt64 = 0
        Unsafe
            handle = fbe_shape_compound(made.Pointer(), parts.Count)
        End Unsafe
        Return Made(handle, ShapeKind.COMPOUND, "Compound")
    End Method

    /// Frees the shape, which the bodies made of it keep; using it after panics. Freeing one that's
    /// freed already does nothing.
    @MainThread Public Method Free()
        If handle == 0 Then Return
        fbe_shape_free(handle)
        handle = 0
    End Method

    // A shape dropped unfreed frees itself.
    Method Destroy()
        If handle != 0 Then fbe_shape_free(handle)
    End Method

    /// Whether Free has freed the shape.
    @MainThread Public Method Freed(): Bool => handle == 0

    /// What the shape is.
    @MainThread Public Method Kind(): ShapeKind
        Live("Shape.Kind")
        Return kind
    End Method

    /// The box around the shape, in its own space: its lowest corner, and its highest.
    @MainThread Public Method Bounds(): (Vec3, Vec3)
        Local low = fbe_shape_vec3_t(0, 0, 0)
        Local high = fbe_shape_vec3_t(0, 0, 0)
        Unsafe
            fbe_shape_bounds(Live("Shape.Bounds"), AddressOf(low), AddressOf(high))
        End Unsafe
        Return (Vec3(low.x, low.y, low.z), Vec3(high.x, high.y, high.z))
    End Method

    /// How much space the shape takes, in cubic meters, which a body of it weighs 1000 kilograms
    /// of each of, as water does, unless its mass is set; 0 for a mesh, which has no inside.
    @MainThread Public Method Volume(): Float => fbe_shape_volume(Live("Shape.Volume"))

    // The shape's handle, for `call`, which panics once it's freed.
    @MainThread Package Method Live(call: String): UInt64
        If handle == 0 Then Panic("{call}: this Shape was freed")
        Return handle
    End Method

    // A primitive's shape, which C makes of what Shape's `call` checked.
    @MainThread Static Method Made(handle: UInt64, kind: ShapeKind, call: String): Shape
        If handle == 0 Then Panic("Shape.{call}: {LastError()}")
        Return Shape(handle, kind)
    End Method
End Class
