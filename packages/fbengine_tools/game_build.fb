// A game's build step: its typed references every build, its files cooked into a pak for a release,
// and the way it mounts them.

Import std.collections
Import std.core
Import std.data
Import std.ffi
Import std.io
Import std.text
Import std.text.encoding
Import std.time
Import fbengine
Import "./cook"
Import "./left_out"
Import "./references"

/// What a game's build step does, which `step/game.fb` runs, as its project.toml's `[build]` says.
/// Its files are in `assets/`, beside its project.toml, and the step makes its module `res`, the
/// typed references to them, with a `Mount` that mounts them at res://:
///
/// ```toml
/// [build]
/// package = "fbengine_tools"
/// program = "step/game.fb"
/// ```
///
/// A debug build mounts `assets/` itself, watching it, so what changes there reloads as the game
/// runs, but for its shaders, which each build compiles those of that have changed, so a game running
/// reloads them when that build ends. A release build cooks it into `build/<name>.pak`, which a game ships beside its executable,
/// or in a macOS bundle's Resources, and mounts that, or where it was built, for `fb run --release`,
/// whose executable is elsewhere; one built with `fb build -o` needs its pak copied beside it. Each
/// file is cooked again only when it or its settings change, as
/// the step keeps what it cooked.
Public Final Class GameBuild
    Private New()
    End New

    /// Does the step for the game `name` in the folder `folder`, into its `out` folder, in `mode`,
    /// "debug" or "release", as fb's FB_BUILD_ variables say them, printing what it reads for fb
    /// to run it again when that changes. A game with no `assets/` throws an IOError of NOT_FOUND,
    /// and one the cooker refuses throws as Cooker.CookFolder does.
    @MainThread
    Public Static Method Run(name: String, folder: Path, out: Path, mode: String) Throws IOError
        Local assets = folder / "assets"
        If !Dir.Exists(assets)
            Throw IOError(IOErrorKind.NOT_FOUND,
                          "{assets} isn't there: it holds what {name} has at res://", assets.Text)
        End If
        // From the folder, so a copy of the game doesn't go on reading the original's.
        Print("fb:rerun-if-changed=assets")
        Try PrintLinks(folder, assets, 0, Set<String>())
        Local mount = "Try FbEngine.Assets.MountSource(\"{Literal(assets.Text)}\")"
        If mode == "release"
            // out is build/steps/<target>/<mode>/<package>/out, and the executable's in build.
            Local build = out.Parent().Parent().Parent().Parent().Parent()
            Try Dir.CreateAll(out)
            Try Dir.CreateAll(build)
            Try SweptIn(build)
            Try SweptIn(out)
            Local cooked = out / "{name}.pak"
            Local pak = build / "{name}.pak"
            // The game's version, stamped in the pak, and said to Mount.
            Print("fb:rerun-if-changed=project.toml")
            Local version = Try VersionIn(folder)
            // What each file took that wasn't in the cache, and all of it, in out's cook-times.txt,
            // as fb shows a step's output only when it fails.
            Local began = Instant.Now()
            Local times: String[] = []
            Try Cooker.CookFolder(assets, cooked, out / "cook-cache",
                                  version, Function(file: String, seconds: Float64)
                times.Add("{file} {seconds}")
            End Function)
            times.Add("all {(Instant.Now() - began).TotalSeconds}")
            Try File.WriteText(out / "cook-times.txt", "\n".Join(times) + "\n")
            // The pak's own place is out, so one taken from beside the executable comes back: fb
            // runs this again when it's gone, and then it's the same, or no use.
            Print("fb:rerun-if-changed={pak}")
            If !Try SameFile(cooked, pak) Then Try File.Copy(cooked, pak)
            Local stamped = version != "" ? ", \"{Literal(version)}\"" : ""
            mount = "Try FbEngine.Assets.MountRelease(\"{Literal(name)}\", " +
                    "\"{Literal(pak.Text)}\"{stamped})"
        End If
        Try Dir.CreateAll(out)
        // A debug build reads assets/ as it is, but for its shaders, which only ever run compiled:
        // those go over it, in a folder that stays, as a game running is watching it.
        If mode != "release"
            Local shaders = out / "shaders"
            If (Try Cooker.CookShadersInto(assets, shaders, out / "cook-cache",
                                           Cooker.SlangcNamed())) > 0
                mount += "\n    Try FbEngine.Assets.MountSource(\"{Literal(shaders.Text)}\")"
            End If
        End If
        Try File.WriteText(out / "res.fb", Try References.OfGame(assets, mount))
    End Method

    // The version the project.toml in `folder` says of its [project], read as TOML, or "" with
    // none, or for a file that isn't UTF-8 or isn't TOML, whose build isn't refused for it.
    Static Method VersionIn(folder: Path): String Throws IOError
        Local file = folder / "project.toml"
        If !File.Exists(file) Then Return ""
        // Its bytes, as ReadText takes what isn't UTF-8 in place of what is.
        Local text = String.FromUtf8(Try File.ReadBytes(file))
        If text == Null Then Return ""
        Local toml = Value.Object()
        Try
            toml = Try Toml.Read(text)
        Catch error As ParseError
            Return ""
        End Try
        Local project = toml["project"]
        If project == Null Then Return ""
        Return project["version"]?.AsString() ?? ""
    End Method

    // Takes out what a cook that was ended left in `folder`, under fb's lock on a step.
    Static Method SweptIn(folder: Path) Throws IOError
        For entry In Try Dir.Entries(folder)
            Local name = entry.Name()
            If name.StartsWith(".fbe-") && name.EndsWith(".tmp") Then Try File.Delete(entry.Path)
        End For
    End Method

    // Whether the files at `a` and `b` are there with the same bytes, which can be more than memory.
    Static Method SameFile(a: Path, b: Path): Bool Throws IOError
        If !File.Exists(a) || !File.Exists(b) Then Return False
        If (Try File.Size(a)) != (Try File.Size(b)) Then Return False
        Local first = Try File.Open(a)
        Defer first.Close()
        Local second = Try File.Open(b)
        Defer second.Close()
        Local one = Buffer<UInt8>(65536)
        Local two = Buffer<UInt8>(65536)
        While True
            Local read = Try first.Read(one)
            If read == 0 Then Return True
            Local got: Int64 = 0
            While got < read
                Local more = Try second.Read(two.Slice(got As Int, read As Int))
                If more == 0 Then Return False
                got += more
            End While
            For i = 0 Until read As Int
                If one[i] != two[i] Then Return False
            End For
        End While
        Return True
    End Method

    // Prints each place a link in `at`, in the game's folder `folder`, goes, from that folder, as
    // fb doesn't follow them in the folders it's told of. `within` has the real paths of the linked
    // folders this is in, so links that go round end; past 32 deep is an IOError of INVALID_DATA,
    // as Cooker.CookFolder throws for them.
    Static Method PrintLinks(folder: Path, at: Path, depth: Int,
                             within: Set<String>) Throws IOError
        If depth > 32
            Throw IOError(IOErrorKind.INVALID_DATA,
                          "{at} is more than 32 folders deep, as links that go round make one",
                          at.Text)
        End If
        Local real = Assets.RealPath(at).Text
        If !within.Add(real) Then Return
        For entry In Try Dir.Entries(at)
            If LeftOut(entry.Name()) Then Continue
            If entry.Kind == FileKind.LINK
                Print("fb:rerun-if-changed={entry.Path.RelativeTo(folder) ?? entry.Path}")
                If Dir.Exists(entry.Path) Then Try PrintLinks(folder, entry.Path, depth + 1, within)
            ElseIf entry.Kind == FileKind.DIRECTORY
                Try PrintLinks(folder, entry.Path, depth + 1, within)
            End If
        End For
        within.Remove(real)
    End Method

    // `text` as it's written between the quotes of a String: its braces doubled, and a backslash,
    // a quote, and each control character escaped, by spec 01's escapes, as Escape writes them.
    Static Method Literal(text: String): String
        Return Escape(text.Replace("{{", "{{{{").Replace("}}", "}}}}"))
    End Method
End Class
