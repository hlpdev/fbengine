// The tools' stability: a folder cooked, and a game built, hundreds of times, each run's output
// the same bytes, used, with nothing more left on the disk, or held by the engine, than the first
// left; and each kind of file the cook and the build read cut short and changed at random, from a
// seed, so a failure repeats: an error that names the file, never a crash or a hang, and never a
// pak half written.

Import std.collections
Import std.core
Import std.image.image
Import std.image.jpeg
Import std.image.png
Import std.io
Import std.math
Import std.os
Import std.test
Import std.text
Import std.text.encoding
Import fbengine
Import fbengine_tools

Global toolsState: Int64 = 1

// Park and Miller's, from a seed of 1 or more.
Function ToolsNext(n: Int): Int
    toolsState = toolsState * 48271 % 2147483647
    Return (toolsState % n) As Int
End Function

// A picture of `side` by `side`, each pixel its own, so it has something to compress.
Function Pictured(side: Int): Image
    Local image = Image(side, side)
    For y = 0 Until side
        For x = 0 Until side
            image[x, y] = Color32((x * 37 % 256) As UInt8, (y * 59 % 256) As UInt8,
                                  ((x + y) * 11 % 256) As UInt8, 255)
        End For
    End For
    Return image
End Function

// A triangle's glTF, its buffer beside it in `name`.bin and its texture `name`.png.
Function TriangleJson(name: String): String
    Return "{{\"asset\":{{\"version\":\"2.0\"}},\"buffers\":[{{\"byteLength\":102," +
           "\"uri\":\"{name}.bin\"}}],\"bufferViews\":[{{\"buffer\":0,\"byteLength\":36}}," +
           "{{\"buffer\":0,\"byteOffset\":36,\"byteLength\":36}}," +
           "{{\"buffer\":0,\"byteOffset\":72,\"byteLength\":24}}," +
           "{{\"buffer\":0,\"byteOffset\":96,\"byteLength\":6}}],\"accessors\":[" +
           "{{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"," +
           "\"min\":[0,0,0],\"max\":[1,1,0]}},{{\"bufferView\":1,\"componentType\":5126," +
           "\"count\":3,\"type\":\"VEC3\"}},{{\"bufferView\":2,\"componentType\":5126," +
           "\"count\":3,\"type\":\"VEC2\"}},{{\"bufferView\":3,\"componentType\":5123," +
           "\"count\":3,\"type\":\"SCALAR\"}}],\"meshes\":[{{\"primitives\":[{{" +
           "\"attributes\":{{\"POSITION\":0,\"NORMAL\":1,\"TEXCOORD_0\":2}},\"indices\":3," +
           "\"material\":0}}]}}],\"materials\":[{{\"pbrMetallicRoughness\":{{" +
           "\"baseColorTexture\":{{\"index\":0}}}}}}],\"textures\":[{{\"source\":0}}]," +
           "\"images\":[{{\"uri\":\"{name}.png\"}}],\"nodes\":[{{\"mesh\":0}}]}}"
End Function

// The triangle's buffer: three positions, their normals, UVs, and three indices.
Function TriangleBuffer(): UInt8[]
    Local one = [0, 0, 0x80, 0x3F] As UInt8[]
    Local zero = [0, 0, 0, 0] As UInt8[]
    Local buffer: UInt8[] = []
    For part In [zero, zero, zero, one, zero, zero, zero, one, zero,
                 zero, zero, one, zero, zero, one, zero, zero, one,
                 zero, zero, one, zero, zero, one]
        buffer.AddAll(part)
    End For
    buffer.AddAll([0, 0, 1, 0, 2, 0] As UInt8[])
    Return buffer
End Function

// A game's assets in `folder`: pictures with their sidecars, a model with its buffer and texture,
// and what's copied as it is.
Function WriteAssets(folder: Path) Throws IOError
    Try Dir.CreateAll(folder / "textures")
    Try Dir.CreateAll(folder / "models")
    Try File.WriteBytes(folder / "textures" / "wall.png", Png.Encode(Pictured(16)))
    Try File.WriteText(folder / "textures" / "wall.png.toml", "compression = \"bc7\"\n")
    Try File.WriteBytes(folder / "textures" / "hud.jpg", Jpeg.Encode(Pictured(8)))
    Try File.WriteBytes(folder / "models" / "door.bin", TriangleBuffer())
    Try File.WriteBytes(folder / "models" / "door.png", Png.Encode(Pictured(4)))
    Try File.WriteText(folder / "models" / "door.gltf", TriangleJson("door"))
    Try File.WriteText(folder / "readme.txt", "hello")
    Try File.WriteText(folder / "level.scene", "a scene, as it is")
End Function

// Every file under `folder`, by its path from it, sorted, so two listings are compared.
Function Listed(folder: Path, under: String = ""): String[] Throws IOError
    Local found: String[] = []
    For entry In Try Dir.Entries(folder)
        Local name = entry.Path.FileName()
        If Dir.Exists(entry.Path)
            found.AddAll(Try Listed(entry.Path, under + name + "/"))
        Else
            found.Add(under + name)
        End If
    End For
    found.Sort()
    Return found
End Function

// What the engine loaded of a model: how much is in it.
Class SoakModel Implements Asset
    Field Info: ModelInfo

    New(info: ModelInfo)
        Info = info
    End New

    Public Static Method LoadKind(): AssetKind => AssetKind.MODEL

    Public Static Method FromLoad(load: AssetLoad): SoakModel Throws IOError
        Return SoakModel(load.Model())
    End Method
End Class

// The pak at `pak` used as a game uses it, then let go: mounted at `place`, a place of its own
// each run, so a mount that's kept is seen, its model loaded and released, its readme read, and
// unmounted.
Function Used(pak: Path, place: String) Throws IOError
    Try Assets.MountPak(place, pak)
    Defer Assets.Unmount(place)
    Local model = Try Assets.Load<SoakModel>("{place}/models/door.gltf")
    Expect(model.Info.Meshes == 1 && model.Info.Images == 1, "{place}: its model")
    Assets.Release(model)
    Expect((Try Assets.ReadText("{place}/readme.txt")) == "hello", "{place}: its readme")
End Function

// What the engine holds, as the other soaks count it: the mounts res:// lists, the loads and the
// holds on assets, and the textures and fonts.
Function Held(): String
    Local mounts: String[] = []
    For entry In (Try? Assets.Entries("res://")) ?? []
        mounts.Add(entry.Name)
    End For
    mounts.Sort()
    Return "mounts {mounts}, loads {Assets.Loads()}, holds {Assets.Holds()}, " +
           "textures {Texture.Count()}, fonts {Font.Count()}"
End Function

// The same folder cooked 200 times, with a cache and without, into a pak that's there already,
// and each pak used: each is the first one's bytes, there's no more on the disk beside it, or in
// its cache, than the first cook left, and the engine holds no more than after the first was used.
@Test
Function AFolderCookedHundredsOfTimesIsTheSameBytesAndLeavesNoMore() Throws IOError
    Local source = Try TempDir()
    Defer Try? source.Close()
    Try WriteAssets(source.Path)
    Local built = Try TempDir()
    Defer Try? built.Close()
    Local pak = built.Path / "game.pak"
    Local cache = built.Path / "cache"
    Try Cooker.CookFolder(source.Path, pak, cache)
    Local first = Try File.ReadBytes(pak)
    Local left = Try Listed(built.Path)
    Expect(first.Count > 0)
    Try Used(pak, "res://soak-pak-0")
    Local held = Held()
    For run = 1 To 200
        If run % 4 == 0
            // With no cache, each file cooked again from nothing, into a folder of its own.
            Local alone = Try TempDir()
            Try Cooker.CookFolder(source.Path, alone.Path / "game.pak")
            Local bytes = Try File.ReadBytes(alone.Path / "game.pak")
            Expect(bytes == first, "run {run}, with no cache: {bytes.Count} bytes, not the first's")
            Expect((Try Listed(alone.Path)) == ["game.pak"], "run {run}: more was left than a pak")
            Try Used(alone.Path / "game.pak", "res://soak-alone-{run}")
            Try alone.Close()
        Else
            Try Cooker.CookFolder(source.Path, pak, cache)
            Local bytes = Try File.ReadBytes(pak)
            Expect(bytes == first, "run {run}: {bytes.Count} bytes, not the first's {first.Count}")
            Try Used(pak, "res://soak-pak-{run}")
        End If
        If run % 50 == 0
            Local now = Try Listed(built.Path)
            Expect(now == left, "run {run}: {now.Count} files beside the pak, not {left.Count}")
            Local holds = Held()
            Expect(holds == held, "run {run}: the engine holds {holds}, not {held}")
        End If
    End For
End Function

// Where fb has a step of the game in `game` write.
Function StepOut(game: Path, mode: String): Path
    Return game / "build" / "steps" / "windows-x64" / mode / "game" / "out"
End Function

// A game built 150 times, as a debug build and as a release, and each release's pak used: its
// module and its pak are the first build's bytes, its build folder holds no more than the first
// left there, and the engine holds no more than after the first pak was used.
@Test
Function AGameBuiltHundredsOfTimesIsTheSameBytesAndLeavesNoMore() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try WriteAssets(game.Path / "assets")
    Try File.WriteText(game.Path / "project.toml",
                       "[project]\nname = \"game\"\nversion = \"1.2.3\"\n")
    Local release = StepOut(game.Path, "release")
    Local debug = StepOut(game.Path, "debug")
    Try GameBuild.Run("game", game.Path, release, "release")
    Try GameBuild.Run("game", game.Path, debug, "debug")
    Local built = game.Path / "build" / "game.pak"
    Local pak = Try File.ReadBytes(built)
    Local module = Try File.ReadText(release / "res.fb")
    Local debugModule = Try File.ReadText(debug / "res.fb")
    Try Used(built, "res://soak-game-0")
    Local held = Held()
    // Its times are each run's own, and nothing else is.
    Local left = (Try Listed(game.Path / "build"))
    For run = 1 To 150
        If run % 3 == 0
            Try GameBuild.Run("game", game.Path, debug, "debug")
            Expect((Try File.ReadText(debug / "res.fb")) == debugModule, "run {run}: its module")
        Else
            Try GameBuild.Run("game", game.Path, release, "release")
            Expect((Try File.ReadText(release / "res.fb")) == module, "run {run}: its module")
            Expect((Try File.ReadBytes(built)) == pak, "run {run}: its pak")
            Try Used(built, "res://soak-game-{run}")
        End If
        If run % 50 == 0
            Local now = Try Listed(game.Path / "build")
            Expect(now == left, "run {run}: {now.Count} files in build, not {left.Count}")
            Local holds = Held()
            Expect(holds == held, "run {run}: the engine holds {holds}, not {held}")
        End If
    End For
End Function

// The bytes of `bytes` from `from` up to `until`.
Function Part(bytes: UInt8[], from: Int, until: Int): UInt8[]
    Local part: UInt8[] = []
    For at = from Until until
        part.Add(bytes[at])
    End For
    Return part
End Function

// `bytes` cut short, or changed, at random: a run of them made random, a few flipped, a piece
// taken out, a piece said twice, or none at all.
Function Broken(bytes: UInt8[]): UInt8[]
    Local made = bytes.Clone()
    Select ToolsNext(6)
        Case 0
            Return Part(made, 0, ToolsNext(made.Count + 1))
        Case 1
            If made.Count == 0 Then Return made
            For each = 1 To 1 + ToolsNext(8)
                made[ToolsNext(made.Count)] = ToolsNext(256) As UInt8
            End For
            Return made
        Case 2
            If made.Count == 0 Then Return made
            Local from = ToolsNext(made.Count)
            Local count = Min(1 + ToolsNext(64), made.Count - from)
            For at = from Until from + count
                made[at] = ToolsNext(256) As UInt8
            End For
            Return made
        Case 3
            If made.Count < 2 Then Return []
            Local from = ToolsNext(made.Count - 1)
            Local until = from + 1 + ToolsNext(made.Count - from - 1)
            Local kept = Part(made, 0, from)
            kept.AddAll(Part(made, until, made.Count))
            Return kept
        Case 4
            Local twice = made.Clone()
            twice.AddAll(Part(made, ToolsNext(made.Count + 1), made.Count))
            Return twice
        Default
            Return []
    End Select
End Function

// The bytes the triangle's glTF says its buffer has.
Const BUFFER_BYTES = 102

// Cooks `source` into `pak`, over what's there, with `named` broken in it, as `written`. A cook
// that's refused names the file, leaves the pak that was there as it was, and nothing beside it;
// one that's taken leaves a pak the engine mounts, and nothing beside it. A buffer shorter than
// its glTF says is refused, naming the buffer; a scene, copied as it is, is in the pak as written.
// What was wrong, or "".
Function CookedOrRefused(source: Path, built: Path, named: String, round: Int,
                         written: UInt8[] = []): String Throws IOError
    Local pak = built / "game.pak"
    Try File.WriteText(pak, "what was there")
    Local refused: IOError? = Null
    Try
        Try Cooker.CookFolder(source, pak)
    Catch e As IOError
        refused = e
    End Try
    Local beside = Try Listed(built)
    If beside != ["game.pak"] Then Return "{named}, round {round}: left {beside} beside the pak"
    If refused != Null
        If (Try File.ReadText(pak)) != "what was there"
            Return "{named}, round {round}: refused, and the pak that was there was changed"
        End If
        Local file = named.Split("/").Last() ?? named
        Local said = refused.Message.ToLower()
        // What's wrong inside a model's buffer, as an index past its vertices, is said of the
        // model that reads it; a buffer that's short is named itself.
        Local byItsModel = file.EndsWith(".bin") && written.Count >= BUFFER_BYTES &&
                           said.Contains(file.Replace(".bin", ".gltf"))
        If !said.Contains(file.ToLower()) && !byItsModel
            Return "{named}, round {round}: refused without naming it: {refused.Message}"
        End If
        Return ""
    End If
    If named.EndsWith(".bin") && written.Count < BUFFER_BYTES
        Return "{named}, round {round}: cooked with {written.Count} bytes of its {BUFFER_BYTES}"
    End If
    Local place = "res://fuzz-pak-{round}"
    Try
        Try Assets.MountPak(place, pak)
    Catch e As IOError
        Return "{named}, round {round}: cooked into a pak that doesn't mount: {e.Message}"
    End Try
    Defer Assets.Unmount(place)
    If named.EndsWith(".scene")
        Local kept = Try Assets.ReadBytes("{place}/{named}")
        If kept != written
            Return "{named}, round {round}: the pak's {kept.Count} bytes aren't the {written.Count} written"
        End If
    End If
    Return ""
End Function

// Each kind of file a cook reads, broken 40 ways from a seed: a picture of each kind, a model's
// JSON, its buffer, and its texture, a binary glTF, a scene, and each sidecar, a picture's, a
// model's, and a model's texture's.
@Test
Function EachFileACookReadsBrokenAtRandomIsRefusedByNameOrCooked() Throws IOError
    Local source = Try TempDir()
    Defer Try? source.Close()
    Try WriteAssets(source.Path)
    Try File.WriteText(source.Path / "models" / "door.gltf.toml",
                       "optimize = false\n[images]\ncompression = \"bc7\"\n")
    Try File.WriteText(source.Path / "textures" / "hud.jpg.toml",
                       "compression = \"bc7\"\nsrgb = true\n")
    Try File.WriteText(source.Path / "models" / "door.png.toml", "srgb = true\n")
    // A binary glTF, as the cooker itself makes one of the triangle.
    Local scratch = Try TempDir()
    Defer Try? scratch.Close()
    Try Cooker.CookModel(source.Path / "models" / "door.gltf", scratch.Path / "door.glb",
                         ModelSettings())
    Try File.WriteBytes(source.Path / "models" / "gate.glb",
                        Try File.ReadBytes(scratch.Path / "door.glb"))
    Try File.WriteText(source.Path / "models" / "gate.glb.toml", "optimize = false\n")
    Local built = Try TempDir()
    Defer Try? built.Close()
    Expect((Try CookedOrRefused(source.Path, built.Path, "nothing", 0)) == "")
    toolsState = 424242
    Local round = 0
    For named In ["textures/wall.png", "textures/hud.jpg", "textures/wall.png.toml",
                  "textures/hud.jpg.toml", "models/door.gltf", "models/door.bin",
                  "models/door.png", "models/gate.glb", "models/door.gltf.toml",
                  "models/door.png.toml", "models/gate.glb.toml", "level.scene"]
        Local file = source.Path / named
        Local whole = Try File.ReadBytes(file)
        For each = 1 To 40
            round += 1
            Local written = Broken(whole)
            Try File.WriteBytes(file, written)
            Local wrong = Try CookedOrRefused(source.Path, built.Path, named, round, written)
            Expect(wrong == "", "seed 424242: {wrong}")
        End For
        Try File.WriteBytes(file, whole)
    End For
    // Whole again, it cooks.
    Expect((Try CookedOrRefused(source.Path, built.Path, "nothing", round + 1)) == "")
    Try Cooker.CookFolder(source.Path, built.Path / "game.pak")
End Function

// The version a project.toml's text says, as a release build reads it: what's between the first
// two quotes of a line of [project] that starts with "version", or "" with none.
Function SaidVersion(text: String): String
    Local section = ""
    For line In text.Split("\n")
        Local clean = line.Trim()
        If clean.StartsWith("[") Then section = clean
        If section == "[project]" && clean.StartsWith("version")
            Local parts = clean.Split("\"")
            If parts.Count >= 2 Then Return parts[1]
        End If
    End For
    Return ""
End Function

// The string literals a call in `code` is given, from its name to its closing parenthesis, each
// as it's written between its quotes.
Function LiteralsOf(code: String, call: String): String[]
    Local found: String[] = []
    Local start = code.Find(call + "(")
    If start == Null Then Return found
    Local chars = code.Chars
    Local at = (start ?? 0) + call.Length + 1
    While at < chars.Count && chars[at] != ')'
        If chars[at] != '"'
            at += 1
            Continue
        End If
        Local inside = StringBuilder()
        at += 1
        While at < chars.Count && chars[at] != '"'
            If chars[at] == '\\' && at + 1 < chars.Count
                inside.Append(chars[at])
                at += 1
            End If
            inside.Append(chars[at])
            at += 1
        End While
        found.Add(inside.ToString())
        at += 1
    End While
    Return found
End Function

// The String a literal written as `literal` is, by spec 01's escapes and its doubled braces, or
// Null for one fb wouldn't take as it is: a line break or carriage return in it, which ends it, a
// brace on its own, which starts an interpolation, or an escape that isn't one.
Function ReadBack(literal: String): String?
    Local braces = StringBuilder()
    Local chars = literal.Chars
    Local at = 0
    While at < chars.Count
        Local c = chars[at]
        If c == '\n' || c == '\r' Then Return Null
        If c == '\\' && at + 1 < chars.Count
            // An escape, as it is, and a \u{...}'s braces with it.
            braces.Append(c).Append(chars[at + 1])
            If chars[at + 1] == 'u'
                at += 2
                While at < chars.Count && chars[at] != '}'
                    braces.Append(chars[at])
                    at += 1
                End While
                If at < chars.Count Then braces.Append(chars[at])
                at += 1
            Else
                at += 2
            End If
        ElseIf c == '{' || c == '}'
            If at + 1 >= chars.Count || chars[at + 1] != c Then Return Null
            braces.Append(c)
            at += 2
        Else
            braces.Append(c)
            at += 1
        End If
    End While
    Return Unescape(braces.ToString())
End Function

// What fb itself makes of each literal: a program printing each one's bytes in hex, after "v ",
// run by fb; an IOError where there's no fb to run.
Function CompiledBy(literals: String[]): ProcessOutput Throws IOError
    Local probe = Try TempDir()
    Defer Try? probe.Close()
    Try File.WriteText(probe.Path / "project.toml",
                       "[project]\nname = \"probe\"\nversion = \"0.1.0\"\ntype = \"executable\"\n")
    Local code = "Import std.core\nImport std.text.encoding\n\n"
    For literal In literals
        code += "Print(\"v \" + Hex.Encode(\"" + literal + "\".Bytes))\n"
    End For
    Try File.WriteText(probe.Path / "main.fb", code)
    Return Try Command("fb").Args(["--color", "never", "run", probe.Path.Text]).Output()
End Function

// A game's project.toml, which a release reads its version from, chosen to hold what a String
// escapes, then broken the same ways at random. Nothing in one refuses a build: one that isn't
// TOML, or isn't UTF-8, is read for its version all the same, so each builds, its pak's stamped
// with the version it says, or none when it says none, and its res.fb says that version to
// MountRelease as a literal fb reads back to it, compiled by fb where there's one, else read back
// here; and no pak's left half written where the executable goes.
@Test
Function AProjectsTomlBrokenAtRandomBuildsWithTheVersionItSays() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets")
    Try File.WriteBytes(game.Path / "assets" / "wall.png", Png.Encode(Pictured(4)))
    Local whole = "[project]\nname = \"game\"\nversion = \"1.2.3\"\n\n[dependencies]\n".Bytes
    Local tomls: UInt8[][] = []
    For version In ["1.2.3", "", "1.2\r3", "tab\there", "bell\x07", "{{braces}}", "back\\slash",
                    "nel\u{85}", "\u{E9}t\u{E9}", "quote'", "del\x7F"]
        tomls.Add(("[project]\nname = \"game\"\nversion = \"" + version + "\"\n").Bytes)
    End For
    toolsState = 777
    For round = 1 To 60
        tomls.Add(Broken(whole))
    End For
    Local out = StepOut(game.Path, "release")
    Local versions: String[] = []
    Local literals: String[] = []
    For round = 1 To tomls.Count
        Local toml = game.Path / "project.toml"
        Try File.WriteBytes(toml, tomls[round - 1])
        Local said = SaidVersion(Try File.ReadText(toml))
        Local where = "seed 777, round {round}, version \"{Escape(said)}\""
        Try
            Try GameBuild.Run("game", game.Path, out, "release")
        Catch e As IOError
            Expect(False, "{where}: refused: {e.Message}")
            Continue
        End Try
        // What's where the executable goes is a whole pak, stamped with the version said.
        Local pak = game.Path / "build" / "game.pak"
        Local place = "res://fuzz-game-{round}"
        Try Assets.MountPak(place, pak)
        Local stamp = "{place}/{GAME_VERSION_FILE}"
        Local stamped = Assets.Exists(stamp) ? Try Assets.ReadText(stamp) : ""
        Assets.Unmount(place)
        Expect(stamped == said, "{where}: its pak's stamped \"{Escape(stamped)}\"")
        For entry In Try Dir.Entries(game.Path / "build")
            Local name = entry.Path.FileName()
            Expect(name == "game.pak" || name == "steps", "{where}: {name} was left in build")
        End For
        // And its res.fb says it.
        Local given = LiteralsOf(Try File.ReadText(out / "res.fb"), "MountRelease")
        If said == ""
            Expect(given.Count == 2, "{where}: MountRelease is given {given.Count} strings")
            Continue
        End If
        If given.Count != 3
            Expect(False, "{where}: MountRelease is given {given.Count} strings")
            Continue
        End If
        Local read = ReadBack(given[2])
        Expect(read == said, "{where}: res.fb says \"{Escape(given[2])}\", which is " +
               "{read == Null ? "no literal fb takes" : "\"" + Escape(read ?? "") + "\""}")
        versions.Add(said)
        literals.Add(given[2])
    End For
    // And fb, where there's one, compiles each to the version said.
    Local ran: ProcessOutput? = Null
    Try
        ran = Try CompiledBy(literals)
    Catch e As IOError
        Print("no fb to compile res.fb's versions ({e.Message}); each was read back here")
    End Try
    If ran != Null
        Expect(ran.Status.Success, "seed 777: res.fb's versions don't compile: {ran.ErrorText}")
        Local printed: String[] = []
        For line In ran.Text.Split("\n")
            If line.StartsWith("v ") Then printed.Add(line.Slice(2, line.Length).Trim())
        End For
        Expect(printed.Count == versions.Count, "fb printed {printed.Count} of {versions.Count}")
        For at = 0 Until Min(printed.Count, versions.Count)
            Expect(printed[at] == Hex.Encode(versions[at].Bytes),
                   "seed 777: fb reads res.fb's \"{Escape(literals[at])}\" as the bytes " +
                   "{printed[at]}, not \"{Escape(versions[at])}\"")
        End For
    End If
End Function

// A shader's source broken the same ways, where there's a slangc to compile it: refused naming
// it, with the compiler's own words, or compiled, and never a pak left half written.
@Test
Function AShaderBrokenAtRandomIsRefusedByNameOrCooked() Throws IOError
    If Env.Get("FBENGINE_SLANGC") == Null Then Skip("no slangc here")
    Local source = Try TempDir()
    Defer Try? source.Close()
    Local whole =
        "float4 shade(Surface surface)\n{{\n    return float4(0.5, 0.25, 1.0, 1.0);\n}}\n".Bytes
    Local built = Try TempDir()
    Defer Try? built.Close()
    toolsState = 9001
    For round = 1 To 12
        Try File.WriteBytes(source.Path / "flat.slang", round == 1 ? whole : Broken(whole))
        Local wrong = Try CookedOrRefused(source.Path, built.Path, "flat.slang", round)
        Expect(wrong == "", "seed 9001: {wrong}")
    End For
End Function
