// A game's shaders compiled: what the cooker does with them, and what drawing does with what it made,
// on the slangc FBENGINE_SLANGC names, which ctest's are; a machine with neither skips them.

Import std.collections
Import std.core
Import std.io
Import std.math
Import std.os
Import std.test
Import std.text
Import std.time
Import fbengine
Import fbengine_tools

Function NoSlangc(): Bool => Env.Get("FBENGINE_SLANGC") == Null

Const FLAT = "float4 shade(Surface surface)\n{{\n    return float4(0.5, 0.25, 1.0, 1.0);\n}}\n"

@Test
Function AShaderCompilesToWhatTheEngineLoads() Throws IOError
    If NoSlangc() Then Skip("no slangc here")
    Local folder = Try TempDir()
    Local from = folder.Path / "flat.slang"
    Local to = folder.Path / "flat.cooked"
    Try File.WriteText(from, FLAT)
    Try Cooker.CookShader(from, to)
    Assets.MountFiles("res://shader-compiled", {"flat.slang": Try File.ReadBytes(to)})
    Defer Assets.Unmount("res://shader-compiled")
    Local shader = Try Assets.Load<Shader>("res://shader-compiled/flat.slang")
    Expect(!shader.Freed())
    shader.Free()
End Function

// Its source, loaded as it is, is told to go through the build step.
@Test
Function AShaderThatWasntCompiledIsRefused() Throws IOError
    Assets.MountFiles("res://shader-source", {"flat.slang": FLAT.Bytes})
    Defer Assets.Unmount("res://shader-source")
    Try
        Try Assets.Load<Shader>("res://shader-source/flat.slang")
        Expect(False)
    Catch e As IOError
        Expect(e.Kind == IOErrorKind.INVALID_DATA)
        Expect(e.Message.Contains("CookShader"))
    End Try
End Function

@Test
Function WhatSlangWontCompileSaysSo() Throws IOError
    If NoSlangc() Then Skip("no slangc here")
    Local folder = Try TempDir()
    Local from = folder.Path / "broken.slang"
    Try File.WriteText(from, "float4 shade(Surface surface)\n{{\n    return nonsense;\n}}\n")
    Try
        Try Cooker.CookShader(from, folder.Path / "out")
        Expect(False)
    Catch e As IOError
        Expect(e.Kind == IOErrorKind.INVALID_DATA)
        Expect(e.Message.Contains("nonsense"))
        // At the game's own file and line, not the copy it was compiled from.
        Expect(e.Message.Contains("broken.slang:3:"))
    End Try
End Function

@Test
Function AShaderWithoutShadeSaysSo() Throws IOError
    If NoSlangc() Then Skip("no slangc here")
    Local folder = Try TempDir()
    Local from = folder.Path / "empty.slang"
    Try File.WriteText(from, "// Nothing yet.\n")
    Try
        Try Cooker.CookShader(from, folder.Path / "out")
        Expect(False)
    Catch e As IOError
        Expect(e.Kind == IOErrorKind.INVALID_DATA)
        Expect(e.Message.Contains("shade"))
    End Try
End Function

// A pak has what's compiled at the file's own path, and what it includes as it is.
@Test
Function AFoldersShadersAreCookedIntoItsPak() Throws IOError
    If NoSlangc() Then Skip("no slangc here")
    Local source = Try TempDir()
    Local built = Try TempDir()
    Try File.WriteText(source.Path / "tinted.inc.slang", "static const float tint = 0.5;\n")
    Try File.WriteText(source.Path / "tinted.slang",
                       "#include \"tinted.inc.slang\"\nfloat4 shade(Surface surface)\n" +
                       "{{\n    return float4(tint, tint, tint, 1.0);\n}}\n")
    Local cache = built.Path / "cache"
    Try Cooker.CookFolder(source.Path, built.Path / "game.pak", cache)
    Try Assets.MountPak("res://shader-pak", built.Path / "game.pak")
    Local shader = Try Assets.Load<Shader>("res://shader-pak/tinted.slang")
    shader.Free()
    Expect((Try Assets.ReadText("res://shader-pak/tinted.inc.slang")).Contains("tint"))
    Expect(Assets.Unmount("res://shader-pak"))
    Expect((Try Dir.Entries(cache)).Count == 1)
    // What it includes changing compiles it again, as this no longer does, the cache or not.
    Try File.WriteText(source.Path / "tinted.inc.slang", "static const float tint = nothing;\n")
    Try
        Try Cooker.CookFolder(source.Path, built.Path / "game.pak", cache)
        Expect(False)
    Catch e As IOError
        Expect(e.Kind == IOErrorKind.INVALID_DATA)
    End Try
End Function

// A shader cooked again, while the game runs, is what its materials draw from the next frame on.
@Test
Function AShaderCookedAgainReloads() Throws IOError, GraphicsError
    If NoSlangc() Then Skip("no slangc here")
    If Env.Get("FBENGINE_NO_GPU") == "1" Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local source = Try TempDir()
    Local folder = Try TempDir()
    Local from = source.Path / "tint.slang"
    Local cooked = folder.Path / "tint.slang"
    Try File.WriteText(from,
                       "float4 shade(Surface surface)\n{{\n    return float4(1, 0, 0, 1);\n}}\n")
    Try Cooker.CookShader(from, cooked)
    Assets.MountFolder("res://shader-reload", folder.Path)
    Defer Assets.Unmount("res://shader-reload")
    Try Assets.WatchFolders()
    Defer Assets.StopWatching()
    Local world = World()
    World.SetCurrent(world)
    Defer world.Free()
    Local target = Try Texture.Target(16, 16, TextureFormat.RGBA8, 1, True)
    Local camera = Camera()
    camera.SetRenderTarget(target)
    camera.SetClearColor(Color(0, 0, 1))
    Local material = Material()
    // Held, as what isn't, Assets lets go of, and reloads no more.
    Local shader = Try Assets.Load<Shader>("res://shader-reload/tint.slang")
    Defer shader.Free()
    material.SetShader(shader)
    Local mesh = Mesh(Geometry.Cube())
    mesh.SetMaterial(material)
    mesh.SetPosition(Vec3(0, 0, -6))
    RenderWorld()
    Local at = (8 * 16 + 8) * 4
    Expect(target.ReadPixels()[at] == 255)
    Flip(False)
    // Written whole, so the watcher never reads half of one.
    Try File.WriteText(from,
                       "float4 shade(Surface surface)\n{{\n    return float4(0, 1, 0, 1);\n}}\n")
    Local again = source.Path / "again"
    Try Cooker.CookShader(from, again)
    Try File.WriteBytesAtomic(cooked, Try File.ReadBytes(again))
    Local since = Instant.Now()
    Local green = False
    While !green && (Instant.Now() - since) < 20.Seconds
        Flip(False)
        RenderWorld()
        Local pixels = target.ReadPixels()
        green = pixels[at] == 0 && pixels[at + 1] == 255
        Sleep(5.Milliseconds)
    End While
    Expect(green)
    Flip(False)
End Function
