// A game's build step: its module's typed references and Mount, its pak in a release, beside where
// the executable goes, and the step's program itself, by what fb runs it with.

Import std.core
Import std.image.image
Import std.image.png
Import std.io
Import std.os
Import std.test
Import std.text
Import std.text.encoding
Import fbengine
Import fbengine_tools

// Where fb has a step of the game in `game` write.
Function OutOf(game: Path, mode: String): Path
    Return game / "build" / "steps" / "windows-x64" / mode / "game" / "out"
End Function

@Test
Function ADebugBuildMountsItsFolder() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets" / "textures")
    Try File.WriteText(game.Path / "assets" / "mount.txt", "a name of the module's own")
    Try File.WriteBytes(game.Path / "assets" / "textures" / "wall.png", Png.Encode(Image(4, 4)))
    Local out = OutOf(game.Path, "debug")
    Try GameBuild.Run("game", game.Path, out, "debug")
    Local made = Try File.ReadText(out / "res.fb")
    Expect(made.Contains("FbEngine.Assets.MountSource(\"{game.Path / "assets"}\")"))
    Expect(made.Contains("Public Const MountTxt = \"res://mount.txt\""))
    Expect(made.Contains("\"res://textures/wall.png\""))
    // Nothing's cooked.
    Expect(!File.Exists(game.Path / "build" / "game.pak"))
End Function

@Test
Function AReleaseBuildCooksItsPakWhereTheExecutableGoes() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets")
    Try File.WriteBytes(game.Path / "assets" / "wall.png", Png.Encode(Image(4, 4)))
    Local out = OutOf(game.Path, "release")
    Try GameBuild.Run("game", game.Path, out, "release")
    Local made = Try File.ReadText(out / "res.fb")
    Local pak = game.Path / "build" / "game.pak"
    Expect(made.Contains("FbEngine.Assets.MountRelease(\"game\", \"{pak}\")"))
    Expect(!made.Contains("MountSource"))
    Expect(made.Contains("Public Const Wall = \"res://wall.png\""))
    Expect((Try Dir.Entries(out / "cook-cache")).Count == 1)
    Try Assets.MountPak("res://test-game", pak)
    Defer Assets.Unmount("res://test-game")
    // A KTX2, under the name the game has it by.
    Expect((Try Assets.ReadBytes("res://test-game/wall.png"))[0] == 0xAB)
End Function

// A game with a version says it to Mount, and stamps its pak with it.
@Test
Function AReleaseIsStampedWithItsGamesVersion() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets")
    Try File.WriteBytes(game.Path / "assets" / "wall.png", Png.Encode(Image(4, 4)))
    Try File.WriteText(game.Path / "project.toml",
                       "[other]\nversion = \"9\"\n[project]\nname = \"game\"\nversion = \"1.2.3\"\n")
    Local out = OutOf(game.Path, "release")
    Try GameBuild.Run("game", game.Path, out, "release")
    Local pak = game.Path / "build" / "game.pak"
    Expect((Try File.ReadText(out / "res.fb")).Contains(
        "FbEngine.Assets.MountRelease(\"game\", \"{pak}\", \"1.2.3\")"))
    Try Assets.MountPak("res://stamped-game", pak)
    Defer Assets.Unmount("res://stamped-game")
    Expect((Try Assets.ReadText("res://stamped-game/{GAME_VERSION_FILE}")) == "1.2.3")
End Function

@Test
Function AGameWithoutItsFolderSaysSo() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Local failed = ExpectThrows<IOError>(GameBuild.Run("game", game.Path, OutOf(game.Path, "debug"),
                                                       "debug"))
    Expect(failed?.Kind == IOErrorKind.NOT_FOUND)
    Expect((failed?.Message ?? "").Contains("assets"))
End Function

// Links `link` to the folder `target`, as a junction on Windows, which needs no privilege.
Function LinkFolder(link: Path, target: Path) Throws IOError
    If System.Platform == Platform.WINDOWS
        Try Command("cmd").Args(["/c", "mklink", "/J", link.Text.Replace("/", "\\"),
                                 target.Text.Replace("/", "\\")]).Output()
    Else
        Try Command("ln").Args(["-s", target.Text, link.Text]).Output()
    End If
End Function

@Test
Function TwoLinksThatGoRoundEndAsADebugBuildsStep() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets")
    Try File.WriteText(game.Path / "assets" / "a.txt", "a")
    Try LinkFolder(game.Path / "assets" / "one", game.Path / "assets")
    Try LinkFolder(game.Path / "assets" / "two", game.Path / "assets")
    // Its references throw for them, as the cook does; what it can't do is go on for ever.
    Expect(ExpectThrows<IOError>(GameBuild.Run("game", game.Path, OutOf(game.Path, "debug"),
                                               "debug"))?.Kind == IOErrorKind.INVALID_DATA)
End Function

@Test
Function APakTakenAwayComesBackAndAStaleWriteGoes() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets")
    Try File.WriteText(game.Path / "assets" / "a.txt", "a")
    Local out = OutOf(game.Path, "release")
    Local pak = game.Path / "build" / "game.pak"
    Try GameBuild.Run("game", game.Path, out, "release")
    Expect(File.Exists(out / "game.pak"))
    Local first = Try File.ReadBytes(pak)
    Try File.Delete(pak)
    Try File.WriteText(game.Path / "build" / ".fbe-0123456789ab.tmp", "a cook that was ended")
    Try File.WriteText(out / ".fbe-0123456789ab.tmp", "a cook that was ended")
    Try GameBuild.Run("game", game.Path, out, "release")
    Expect((Try File.ReadBytes(pak)) == first)
    Expect(!File.Exists(game.Path / "build" / ".fbe-0123456789ab.tmp"))
    Expect(!File.Exists(out / ".fbe-0123456789ab.tmp"))
    // One that's changed is put right, and one that's the same left as it is.
    Try File.WriteText(pak, "not this")
    Try GameBuild.Run("game", game.Path, out, "release")
    Expect((Try File.ReadBytes(pak)) == first)
End Function

// A game running from build/ while its game's built again, as a check's or a test's build step
// does, goes on reading the pak it mounted, and the next mount reads the new one, encrypted or not.
@Test
Function AGameRunningWhileItsBuiltAgainKeepsItsPak() Throws IOError
    For keyed In [False, True]
        Local game = Try TempDir()
        Defer Try? game.Close()
        Try Dir.CreateAll(game.Path / "assets")
        Try File.WriteText(game.Path / "assets" / "a.txt", "the first a")
        Try File.WriteText(game.Path / "assets" / "b.txt", "b")
        Local key: UInt8[] = keyed ? TestKey() : []
        If keyed Then Try File.WriteText(game.Path / "pak.key", Hex.Encode(key))
        Local out = OutOf(game.Path, "release")
        Local pak = game.Path / "build" / "game.pak"
        Try GameBuild.Run("game", game.Path, out, "release")
        Try Assets.MountPak("res://running-game", pak, key)
        Defer Assets.Unmount("res://running-game")
        Try File.WriteText(game.Path / "assets" / "a.txt", "a second a, longer than the first")
        Try GameBuild.Run("game", game.Path, out, "release")
        Expect((Try Assets.ReadText("res://running-game/a.txt")) == "the first a")
        Expect((Try Assets.ReadText("res://running-game/b.txt")) == "b")
        Try Assets.MountPak("res://built-again", pak, key)
        Defer Assets.Unmount("res://built-again")
        Expect((Try Assets.ReadText("res://built-again/a.txt")) ==
               "a second a, longer than the first")
        // Nothing's left beside it.
        For entry In Try Dir.Entries(game.Path / "build")
            Expect(!entry.Name().StartsWith(".fbe-"))
        End For
    End For
End Function

// The 32 bytes of the key the tests encrypt a game's pak with.
Function TestKey(): UInt8[]
    Return Hex.Decode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f") ?? []
End Function

// A game with a pak.key has its release's pak encrypted with it, which Mount mounts with the key;
// its debug build reads its folder as it is.
@Test
Function AGamesKeyEncryptsItsReleasesPak() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets")
    Try File.WriteText(game.Path / "assets" / "notes.txt", "the game's own words")
    Try File.WriteText(game.Path / "pak.key", "  {Hex.Encode(TestKey())}\n")
    Local out = OutOf(game.Path, "release")
    Try GameBuild.Run("game", game.Path, out, "release")
    Local pak = game.Path / "build" / "game.pak"
    Expect((Try File.ReadText(out / "res.fb")).Contains(
        "FbEngine.Assets.MountRelease(\"game\", \"{pak}\", \"\", [0x00, 0x01, 0x02, "))
    Expect((Try File.ReadText(out / "res.fb")).Contains(", 0x1f] As UInt8[])"))
    Local bytes = Hex.Encode(Try File.ReadBytes(pak))
    Expect(bytes.StartsWith(Hex.Encode("FBEPAK".Bytes)))
    Expect(!bytes.Contains(Hex.Encode("the game's own words".Bytes)))
    Expect(!bytes.Contains(Hex.Encode("notes.txt".Bytes)))
    Expect(ExpectThrows<IOError>(Assets.MountPak("res://keyed-game", pak))?.Kind ==
           IOErrorKind.INVALID_DATA)
    Try Assets.MountPak("res://keyed-game", pak, TestKey())
    Defer Assets.Unmount("res://keyed-game")
    Expect((Try Assets.ReadText("res://keyed-game/notes.txt")) == "the game's own words")
    Local debug = OutOf(game.Path, "debug")
    Try GameBuild.Run("game", game.Path, debug, "debug")
    Expect(!(Try File.ReadText(debug / "res.fb")).Contains("UInt8[]"))
End Function

@Test
Function AKeyThatIsntOneSaysSo() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets")
    Try File.WriteText(game.Path / "assets" / "notes.txt", "words")
    For text In ["not hex at all", Hex.Encode(TestKey()).Slice(0, 62), Hex.Encode(TestKey()) + "00"]
        Try File.WriteText(game.Path / "pak.key", text)
        Local failed = ExpectThrows<IOError>(GameBuild.Run("game", game.Path,
                                                           OutOf(game.Path, "release"), "release"))
        Expect(failed?.Kind == IOErrorKind.INVALID_DATA)
        Expect((failed?.Message ??
                "").Contains("pak.key isn't a pak's key, which is 64 hex digits"))
    End For
End Function
