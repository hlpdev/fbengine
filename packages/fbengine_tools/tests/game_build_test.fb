// A game's build step: its module's typed references and Mount, its pak in a release, beside where
// the executable goes, and the step's program itself, by what fb runs it with.

Import std.core
Import std.image.image
Import std.image.png
Import std.io
Import std.test
Import std.text
Import fbengine
Import fbengine_tools

// Where fb has a step of the game in `game` write.
Function OutOf(game: Path, mode: String): Path
    Return game / "build" / "steps" / "windows-x64" / mode / "game" / "out"
End Function

@Test
Function ADebugBuildMountsItsFolder() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets" / "textures")
    Try File.WriteText(game.Path / "assets" / "mount.txt", "a name of the module's own")
    Try File.WriteBytes(game.Path / "assets" / "textures" / "wall.png", Png.Encode(Image(4, 4)))
    Local out = OutOf(game.Path, "debug")
    Try GameBuild.Run("game", game.Path, out, "debug")
    Local made = Try File.ReadText(out / "res.fb")
    Expect(made.Contains("FbEngine.Assets.MountSource(\"{game.Path / "assets"}\")"))
    Expect(made.Contains("Public Const MountTxt = \"res://mount.txt\""))
    Expect(made.Contains("\"res://textures/wall.png\""))
    // Nothing's cooked.
    Expect(!File.Exists(game.Path / "build" / "game.pak"))
End Function

@Test
Function AReleaseBuildCooksItsPakWhereTheExecutableGoes() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Try Dir.CreateAll(game.Path / "assets")
    Try File.WriteBytes(game.Path / "assets" / "wall.png", Png.Encode(Image(4, 4)))
    Local out = OutOf(game.Path, "release")
    Try GameBuild.Run("game", game.Path, out, "release")
    Local made = Try File.ReadText(out / "res.fb")
    Local pak = game.Path / "build" / "game.pak"
    Expect(made.Contains("FbEngine.Assets.MountRelease(\"game\", \"{pak}\")"))
    Expect(!made.Contains("MountSource"))
    Expect(made.Contains("Public Const Wall = \"res://wall.png\""))
    Expect((Try Dir.Entries(out / "cook-cache")).Count == 1)
    Try Assets.MountPak("res://test-game", pak)
    Defer Assets.Unmount("res://test-game")
    // A KTX2, under the name the game has it by.
    Expect((Try Assets.ReadBytes("res://test-game/wall.png"))[0] == 0xAB)
End Function

@Test
Function AGameWithoutItsFolderSaysSo() Throws IOError
    Local game = Try TempDir()
    Defer Try? game.Close()
    Local failed = ExpectThrows<IOError>(GameBuild.Run("game", game.Path, OutOf(game.Path, "debug"),
                                                       "debug"))
    Expect(failed?.Kind == IOErrorKind.NOT_FOUND)
    Expect((failed?.Message ?? "").Contains("assets"))
End Function
