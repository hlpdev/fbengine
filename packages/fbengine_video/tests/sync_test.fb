// A video's sound through fbengine_audio, on MANUAL's mix, which each test moves on itself, with
// its clock kept to it; and a video's texture, and what draws it, on the GPU ctest's tests use.

Import std.ffi
From std.image Import Image
Import std.math
Import std.os
Import std.test
Import std.time
Import fbengine
Import fbengine_audio
Import fbengine_video
Import fbengine_video.c.fbe_video

Function NoGpu(): Bool => Env.Get("FBENGINE_NO_GPU") == "1"

// colors.mpg's rate, a frame of it at 25 a second in samples.
Const frameOfMix: Int32 = 1764

Function Near(a: Float64, b: Float64, within: Float64 = 0.03): Bool => Abs(a - b) <= within

@MainThread Function VideoCount(): Int32 => fbe_video_count()

@Test @MainThread
Function ASoundPlaysWithItsVideoAndItsClockKeepsToTheMix() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.Play()
    Expect(Audio.Playing() == 1 && video.SoundChannel().Playing())
    // Frames shorter than the mix: the clock goes as far as what's mixed.
    For i = 1 To 10
        Local sound = Audio.Mix(frameOfMix)
        Expect(i < 3 || Abs(sound[0]) + Abs(sound[100]) > 0, "silent at mix {i}")
        video.Update(0.001)
        Expect(Near(video.Time(), (i As Float64) * 0.04), "at {i}, its clock's {video.Time()}")
    End For
    // Frames longer than the mix: it waits for what's mixed.
    For i = 1 To 5
        Audio.Mix(frameOfMix / 2)
        video.Update(0.1)
        Expect(Near(video.Time(), 0.4 + (i As Float64) * 0.02),
               "at {i}, its clock's {video.Time()}")
    End For
End Function

// A device lost, or a game's own stall: the clock goes on by a frame's time, and the sound's put
// where it is when the mix goes on, not the clock back where the sound is.
@Test @MainThread
Function AMixThatStallsLeavesTheClockGoing() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.Play()
    Audio.Mix(frameOfMix)
    For i = 1 To 20
        video.Update(0.04)
    End For
    Local on = video.Time()
    Expect(Near(on, 0.8, 0.09), "its clock's {on}")
    Audio.Mix(frameOfMix)
    video.Update(0.04)
    Expect(video.Time() >= on, "its clock went back, from {on} to {video.Time()}")
    Audio.Mix(frameOfMix)
    video.Update(0.04)
    Expect(Near(video.SoundChannel().Position(), video.Time(), 0.1),
           "its sound's at {video.SoundChannel().Position()}, its clock at {video.Time()}")
End Function

@Test @MainThread
Function PausingSeekingAndEndingGoForItsSoundToo() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.Play()
    Audio.Mix(frameOfMix)
    video.Pause()
    Expect(video.SoundChannel().Paused())
    video.Play()
    Expect(!video.SoundChannel().Paused())
    video.Seek(1.0)
    Audio.Mix(100)
    Expect(Near(video.SoundChannel().Position(), 1.0, 0.01),
           "its sound's at {video.SoundChannel().Position()}")
    // Past the sound's 2 s, in a video of 2.08 s, there's none.
    video.Seek(2.04)
    Expect(!video.SoundChannel().Playing())
    Audio.Mix(100)
    video.Update(0.1)
    Expect(video.Ended() && Audio.Playing() == 0)
    // Ended, it plays from the start, with its sound.
    video.Play()
    Expect(video.SoundChannel().Playing() && Near(video.Time(), 0))
    Audio.Mix(frameOfMix)
    Expect(Near(video.SoundChannel().Position(), 0.04, 0.01))
    // Sought while paused, it starts from there when it plays.
    video.Pause()
    video.Seek(1.5)
    Expect(!video.SoundChannel().Playing())
    video.Play()
    Audio.Mix(100)
    Expect(Near(video.SoundChannel().Position(), 1.5, 0.01))
    // Freed, it stops.
    video.Free()
    Expect(Audio.Playing() == 0)
End Function

// Its sound's a little shorter than its pictures: each loop's starts again with them.
@Test @MainThread
Function ALoopingVideosSoundStartsEachLoopAgain() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.SetLoop(True)
    video.Play()
    For i = 1 To 75
        Audio.Mix(frameOfMix)
        video.Update(0.04)
    End For
    Expect(video.SoundChannel().Playing())
    Expect(Near(video.Time(), 0.92, 0.1), "its clock's {video.Time()}")
    Expect(Near(video.SoundChannel().Position(), video.Time(), 0.1),
           "its sound's at {video.SoundChannel().Position()}, its clock at {video.Time()}")
End Function

// A video with no sound of its own, beside a sound stream of the game's.
@Test @MainThread
Function AVideoPlaysBesideAGivenSound() Throws VideoError, AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local colors = Try Video.Load(Embed("media/colors.mpg"))
    Defer colors.Free()
    Local music = Try Sound.StreamBytes(colors.Sound())
    Defer music.Free()
    Local video = Try Video.Load(Embed("media/silent.mpg"))
    Defer video.Free()
    Expect(!video.HasSound())
    video.Play()
    Expect(Audio.Playing() == 0 && !video.SoundChannel().Playing())
    video.SetSound(music)
    Expect(video.GivenSound() == music && Audio.Playing() == 1)
    For i = 1 To 5
        Audio.Mix(frameOfMix)
        video.Update(0.001)
    End For
    Expect(Near(video.Time(), 0.2), "its clock's {video.Time()}")
    video.SetVolume(0.5)
    Expect(video.Volume() == 0.5 && video.SoundChannel().Volume() == 0.5)
    video.SetSound(Null)
    Expect(Audio.Playing() == 0)
End Function

// With the audio not started it plays by its frames, and starts its sound when the audio's started.
@Test @MainThread
Function AVideoPlaysWithoutTheAudioUntilItsStarted() Throws VideoError, AudioError
    Expect(!Audio.Started())
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.Play()
    video.Update(0.5)
    Expect(Near(video.Time(), 0.5) && !video.SoundChannel().Playing())
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    video.Update(0.04)
    Expect(video.SoundChannel().Playing())
    Audio.Mix(100)
    Expect(Near(video.SoundChannel().Position(), 0.5, 0.05),
           "its sound's at {video.SoundChannel().Position()}")
End Function

// With the audio stopped and started again, its sound goes on from the clock.
@Test @MainThread
Function AVideosSoundStartsAgainWithTheAudio() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.Play()
    Audio.Mix(frameOfMix)
    video.Update(0.04)
    Audio.Stop()
    video.Update(0.46)
    Expect(!video.SoundChannel().Playing() && Near(video.Time(), 0.5))
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    video.Update(0.04)
    Expect(video.SoundChannel().Playing())
    Audio.Mix(100)
    Expect(Near(video.SoundChannel().Position(), 0.5, 0.05),
           "its sound's at {video.SoundChannel().Position()}")
End Function

// A video dropped unfreed goes with its sound.
@MainThread Function PlayAndDrop() Throws VideoError
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    video.Play()
    Expect(Audio.Playing() == 1)
End Function

@Test @MainThread
Function ADroppedVideosSoundStops() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Try PlayAndDrop()
    Expect(Audio.Playing() == 0)
End Function

@Test
Function AVideoFitsWithItsShapeKept() Throws VideoError
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    // 64 by 48 in a wide screen, and a tall one.
    Expect(video.Fit(200, 96) == Rect(36, 0, 128, 96))
    Expect(video.Fit(64, 480) == Rect(0, 216, 64, 48))
    Expect(video.Fit(640, 480) == Rect(0, 0, 640, 480))
End Function

@Test @MainThread
Function AVideosTextureHasItsFrame() Throws VideoError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    Local texture = Try video.Texture()
    Expect((Try video.Texture()) == texture, "it's the same one each time")
    Expect(texture.Width() == 64 && texture.Height() == 48 && texture.Levels() == 1)
    Expect(texture.WrapAcross() == TextureWrap.CLAMP)
    Local before = texture.ToImage()[32, 24]
    Expect(before.r > 200 && before.g < 50, "at first it's {before}, not red")
    video.Play()
    // Half a second on, green.
    video.Update(0.6)
    Flip(False)
    Local after = texture.ToImage()[32, 24]
    Expect(after.g > 200 && after.r < 50, "half a second on it's {after}, not green")
    Expect(texture.ToImage()[32, 24] == video.Frame()[32, 24])
    video.Seek(1.2)
    Flip(False)
    Local sought = texture.ToImage()[32, 24]
    Expect(sought.b > 200 && sought.r < 50, "at 1.2 s it's {sought}, not blue")
    // Freed with it.
    video.Free()
    Expect(texture.Freed())
End Function

@Test @MainThread
Function AVideoDrawsLetterboxed() Throws VideoError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    Local target = Try Texture.Target(200, 96)
    Defer target.Free()
    Local canvas = Canvas(target)
    canvas.Clear()
    Try video.DrawFitted(canvas, 200, 96)
    Flip(False)
    Local drawn = target.ToImage()
    // Bars either side, 36 wide, black, and the video between them.
    Expect(drawn[10, 48].r == 0 && drawn[190, 48].r == 0, "its bars are {drawn[10, 48]}")
    Expect(drawn[100, 48].r > 200, "its middle is {drawn[100, 48]}")
    Expect(drawn[40, 48].r > 200 && drawn[160, 48].r > 200)
    Expect(canvas.Scale() == Vec2(1, 1) && canvas.Color() == Color32(255, 255, 255, 255))
End Function

// `wav`, one of a video's, of its first `seconds`, as a sound of its own.
Function FirstOf(wav: UInt8[], seconds: Float64): UInt8[]
    Local bytes = (seconds * 44100 As Int64) * 8
    Local cut = Buffer<UInt8>(44 + bytes)
    For i = 0 To 43 + bytes
        cut[i] = wav[i]
    End For
    Local put = Function(at: Int64, value: Int64)
        For b = 0 To 3
            cut[at + b] = ((value >> (b * 8)) & 255) As UInt8
        End For
    End Function
    put(4, 36 + bytes)
    put(40, bytes)
    Return cut.ToArray()
End Function

// A sound that loops isn't a clock, however short: the video goes by its frames to its end.
@Test @MainThread
Function AVideoBesideALoopingSoundKeepsToItsFrames() Throws VideoError, AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local colors = Try Video.Load(Embed("media/colors.mpg"))
    Defer colors.Free()
    Local wav = colors.Sound()
    For length In [0.2, 0.75]
        Local music = Try Sound.FromBytes(FirstOf(wav, length))
        Defer music.Free()
        music.SetLoop(True)
        Local video = Try Video.Load(Embed("media/silent.mpg"))
        Defer video.Free()
        video.SetSound(music)
        video.Play()
        Local frames = 0
        While !video.Ended() && frames < 200
            Audio.Mix(frameOfMix)
            video.Update(0.04)
            frames += 1
            If !video.Ended()
                Expect(video.SoundChannel().Playing(), "of {length} s, at frame {frames}")
                Expect(Near(video.Time(), (frames As Float64) * 0.04),
                       "of {length} s, at frame {frames}, it's at {video.Time()}")
            End If
        End While
        Expect(video.Ended() && Near(video.Time(), 2.08, 0.05), "it's at {video.Time()}")
        Expect(!video.SoundChannel().Playing())
    End For
End Function

// Sought past a looping sound's length goes around.
@Test @MainThread
Function ASeekGoesAroundALoopingSound() Throws VideoError, AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local colors = Try Video.Load(Embed("media/colors.mpg"))
    Defer colors.Free()
    Local music = Try Sound.FromBytes(FirstOf(colors.Sound(), 0.75))
    Defer music.Free()
    music.SetLoop(True)
    Local video = Try Video.Load(Embed("media/silent.mpg"))
    Defer video.Free()
    video.SetSound(music)
    video.Play()
    video.Seek(1.9)
    Audio.Mix(10)
    Expect(video.SoundChannel().Playing() && Near(video.SoundChannel().Position(), 0.4, 0.01),
           "its sound's at {video.SoundChannel().Position()}")
End Function

// A paused video stays so, however long a frame, past its loop's end or not.
@Test @MainThread
Function AnUpdateLeavesAPausedVideosSoundPaused() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.SetLoop(True)
    video.Play()
    Audio.Mix(frameOfMix)
    video.Update(0.04)
    video.Pause()
    // Its 5 ms of ramping to silence.
    Audio.Mix(frameOfMix)
    Local at = video.SoundChannel().Position()
    video.Update(2.5)
    Expect(video.SoundChannel().Paused(), "it was resumed")
    Audio.Mix(frameOfMix)
    Expect(video.SoundChannel().Position() == at)
End Function

// The audio stopped and started with no Update between, or a play stopped, goes on; one past its
// sound's end doesn't.
@Test @MainThread
Function ASoundThatsStoppedStartsAgain() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.Play()
    Audio.Mix(frameOfMix)
    video.Update(0.04)
    Audio.Stop()
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    video.Update(0.04)
    Expect(video.SoundChannel().Playing(), "it stayed off")
    Audio.Mix(100)
    Expect(Near(video.SoundChannel().Position(), 0.04, 0.02),
           "its sound's at {video.SoundChannel().Position()}")
    // Near its end, 2 s in, it's left ended.
    video.Seek(1.9)
    video.SoundChannel().Stop()
    video.Update(0.0)
    Expect(!video.SoundChannel().Playing(), "it was started again at its end")
End Function

// What's freed before it isn't freed again, nor panics inside the video.
@Test @MainThread
Function ATextureFreedFirstLeavesFreeingTheVideo() Throws VideoError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local before = VideoCount()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Local texture = Try video.Texture()
    texture.Free()
    video.Free()
    Expect(VideoCount() == before)
    Local other = Try Video.Load(Embed("media/colors.mpg"))
    Local kept = Try other.Texture()
    other.Free()
    Expect(kept.Freed() && VideoCount() == before)
End Function

@Test @MainThread
Function AFreedSoundOrBusLeavesTheVideoPlaying() Throws VideoError, AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local colors = Try Video.Load(Embed("media/colors.mpg"))
    Defer colors.Free()
    Local music = Try Sound.FromBytes(colors.Sound())
    Local video = Try Video.Load(Embed("media/silent.mpg"))
    Defer video.Free()
    video.SetSound(music)
    video.Play()
    music.Free()
    video.Seek(0.5)
    video.Update(0.04)
    video.SetVolume(0.5)
    Expect(!video.SoundChannel().Playing())
    Expect(Near(video.Time(), 0.54), "it's at {video.Time()}")
    // A Bus freed before its sound next starts.
    Local bus = Bus()
    colors.SetBus(bus)
    colors.Play()
    colors.Pause()
    bus.Free()
    colors.Seek(1.0)
    colors.Play()
    Expect(colors.SoundChannel().Playing())
End Function

// A mix longer than the drift the clock allows moves it on, and never rewinds the sound.
@Test @MainThread
Function ALongMixMovesTheClockAndLeavesTheSound() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.Play()
    Local position: Float64 = 0
    For i = 1 To 5
        Audio.Mix(13230)
        Local mixed = video.SoundChannel().Position()
        Expect(mixed > position, "from {position} it went to {mixed}")
        position = mixed
        video.Update(0.31)
        Expect(video.SoundChannel().Position() == position, "it was sought from {position}")
        Expect(Near(video.Time(), position), "at {i}, its clock's {video.Time()} for {position}")
    End For
End Function

// A clock follows what's heard, a mix's period behind what's been mixed.
@Test @MainThread
Function AClockFollowsWhatsHeardOfAPeriodsMix() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.SILENT, 44100, 2, "", 0.1)
    Defer Audio.Stop()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    Local period = Audio.Period()
    video.Play()
    Local seen = False
    Local start = Instant.Now()
    While start.Elapsed < 800.Milliseconds
        Sleep(10.Milliseconds)
        Local mixed = video.SoundChannel().Position()
        video.Update(0.0)
        If mixed > period + 0.05
            seen = True
            Expect(video.Time() <= mixed - period + 0.02,
                   "of {mixed} s mixed, {period} s at a time, its clock's {video.Time()}")
        End If
    End While
    Expect(seen, "it never mixed enough")
End Function

// A play started again has the Sound's own pan: what's set on the Channel lasts until then.
@Test @MainThread
Function WhatsSetOnASoundChannelLastsUntilItsStartedAgain() Throws VideoError, AudioError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    video.SetVolume(0.5)
    video.Play()
    video.SoundChannel().SetPan(0.5)
    Expect(video.SoundChannel().Pan() == 0.5)
    video.SoundChannel().Stop()
    video.Update(0.04)
    Expect(video.SoundChannel().Playing() && video.SoundChannel().Pan() == 0)
    Expect(video.SoundChannel().Volume() == 0.5)
End Function

// A file's pixels that aren't square: its shape's by them, 16 by 9 of 64 by 48.
@Test
Function AVideosShapeIsByItsPixels() Throws VideoError
    Local wide = Try Video.Load(Embed("media/wide.mpg"))
    Defer wide.Free()
    Expect(Near(wide.PixelAspect(), 1.0 / 0.7615, 0.001), "it's {wide.PixelAspect()}")
    Local fitted = wide.Fit(640, 480)
    Expect(Near(fitted.Width, 640, 0.5) && Near(fitted.Height, 640 * 48 / (64 / 0.7615), 0.5),
           "it's {fitted}")
    Expect(Near(fitted.Y, (480 - fitted.Height) / 2, 0.01))
    Local square = Try Video.Load(Embed("media/count.mpg"))
    Defer square.Free()
    Expect(square.PixelAspect() == 1)
End Function

@Test @MainThread
Function DrawFittedLeavesACanvasAsItWasAndDrawsItsBarsSolid() Throws VideoError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local video = Try Video.Load(Embed("media/colors.mpg"))
    Defer video.Free()
    Local target = Try Texture.Target(200, 96)
    Defer target.Free()
    Local canvas = Canvas(target)
    canvas.Clear()
    // Nothing for a size of nothing, as a window minimized, and it's left as it was.
    Try video.DrawFitted(canvas, 0, 96)
    Try video.DrawFitted(canvas, 200, -1)
    canvas.SetColor(Color32(255, 255, 255, 128))
    canvas.SetBlend(Blend2D.ALPHA)
    canvas.SetRotation(1)
    Try video.DrawFitted(canvas, 200, 96)
    Expect(canvas.Blend() == Blend2D.ALPHA && canvas.Rotation() == 1)
    Expect(canvas.Color() == Color32(255, 255, 255, 128))
    Flip(False)
    Local drawn = target.ToImage()
    // Its bars opaque, whatever the blend, unturned, the video in its place between them.
    Expect(drawn[10, 48].a == 255 && drawn[10, 48].r == 0, "its bars are {drawn[10, 48]}")
    Expect(drawn[100, 48].r > 50, "its middle is {drawn[100, 48]}")
End Function
