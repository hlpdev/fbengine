    End Method
End Class

@Test
Function AClipLeftPushedEndsWithItsDraw() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local after = Sized(Widget("panel"), 20.0, 10.0)
    Local ui = Try Opened([Sized(LeavesAClip(), 20.0, 10.0), after])
    Local box = after.Box()
    Expect((Try Pixels())[(box.X + 19.0) As Int32, (box.Y + 9.0) As Int32] == Solid("#ff0000"))
    Expect(ui.Root().Visible())
