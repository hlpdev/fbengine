@Test
Function LabelsTextGoesWhereItsAlignSays() Throws GraphicsError, IOError
    If NoGpu() Then Skip("no GPU here")
    If Fonts() == "" Then Skip("no test fonts")
    Local label = Label("Hi")
    label.SetTranslates(False)
    label.SetSize(100.0, 24.0)
    label.SetTextAlign(Align.END)
    Local ui = Try Opened([label], 300, 200)
    ui.SetFont("", Try Font.Load("{Fonts()}/OpenSans-Regular.ttf", 16.0))
    Drawn(ui)
    Drawn(ui)
    Local image = Try Pixels()
    Expect(Marked(image, Rect(80.0, 0.0, 20.0, 24.0), clear))
    Expect(!Marked(image, Rect(0.0, 0.0, 70.0, 24.0), clear))
    label.SetTextAlign(Align.START)
    Drawn(ui)
    image = Try Pixels()
    Expect(Marked(image, Rect(0.0, 0.0, 20.0, 24.0), clear))
    Expect(!Marked(image, Rect(30.0, 0.0, 70.0, 24.0), clear))
    EndGraphics()
End Function

@Test
Function TheIMEsAreaIsWhereTheFieldShows() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    // A screen shown with bars, 50 down, and a field 10 in.
    Local field = TextField("")
    field.SetSize(50.0, 20.0)
    field.SetMargin(Insets(10.0, 0.0, 0.0, 0.0))
    Local ui = Try Opened([field], 400, 300)
    Screen.SetSize(100, 50)
    Screen.SetScaling(Scaling.FIT)
    Drawn(ui)
    ui.Focus(field)
    Drawn(ui)
    Local area = TextInputArea()
    Expect(area.X == 10 && area.Y == 50 && area.Width == 50 && area.Height == 20)
    // Scaled: its box's place and size, in the window's units.
    ui.SetScale(2.0)
    Drawn(ui)
    Drawn(ui)
    area = TextInputArea()
    Expect(area.X == 20 && area.Y == 50 && area.Width == 100 && area.Height == 40)
    // With bars at its sides, 100 across.
    ui.SetScale(1.0)
    Try Graphics(600, 200)
    Drawn(ui)
    Drawn(ui)
    area = TextInputArea()
    Expect(area.X == 110 && area.Y == 0)
    Screen.SetSize(0, 0)
    EndGraphics()
End Function
