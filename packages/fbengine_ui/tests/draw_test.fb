@Test
Function AKindKeepsItsParentsPartsAndCanHaveItsOwn() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local slider = Slider(0.0, 1.0, 0.5)
    slider.SetStyleName("slider.volume")
    slider.SetSize(40.0, 8.0)
    Local ui = Try Opened([slider])
    Local image = Try Pixels()
    Expect(image[0, 0] == Solid("#00ff00") && image[20, 0] == Solid("#0000ff"))
    Expect(image[39, 0] == Solid("#101010"))
    ui.CurrentTheme().SetStyle("slider.volume.thumb", Filled("#ff00ff"))
    Drawn(ui)
    image = Try Pixels()
    Expect(image[20, 0] == Solid("#ff00ff") && image[0, 0] == Solid("#00ff00"))
    // Under Dark, too, its fill and thumb aren't its track.
    Local dark = Theme.Dark()
    Expect(dark.PartOf("slider.volume", "fill").Background !=
           dark.StyleOf("slider.volume").Background)
    Expect(dark.PartOf("slider.volume", "thumb").Background ==
           dark.StyleOf("slider.thumb").Background)
    EndGraphics()
End Function

