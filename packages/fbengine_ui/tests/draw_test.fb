@Test
Function TextStaysInItsBoxOnAStretchedScreen() Throws GraphicsError, IOError
    If NoGpu() Then Skip("no GPU here")
    If Fonts() == "" Then Skip("no test fonts")
    Local label = Label("WWWWWWWWWW")
    label.SetTranslates(False)
    Local ui = Try Opened([label], 800, 200)
    ui.SetFont("", Try Font.Load("{Fonts()}/OpenSans-Regular.ttf", 16.0))
    Screen.SetSize(400, 200)
    Screen.SetScaling(Scaling.STRETCH)
    Drawn(ui)
    Drawn(ui)
    Drawn(ui)
    Local box = label.Box()
    // In the screen's pixels, half the window's across: it reaches its box's end, and not past.
    Local right = (box.Width / 2.0) As Int32
    Local image = Try Pixels()
    Expect(Marked(image, Rect((right - 8) As Float32, 0.0, 8.0, box.Height), clear))
    Expect(!Marked(image, Rect((right + 2) As Float32, 0.0, 40.0, box.Height), clear))
    // At half its size, as it's half as wide, not cut off at the box at its full size: its W is 6
    // pixels tall or so, not 12, on the screen's rows that are the window's.
    Local top, bottom = MarkedRows(image, Rect(0.0, 0.0, (right As Float32), 40.0), clear)
    Expect(bottom - top + 1 <= 8)
    Screen.SetSize(0, 0)
    Screen.SetScaling(Scaling.FIT)
    EndGraphics()
End Function

@Test
Function APillsBorderIsEvenInItsMiddleRow() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
