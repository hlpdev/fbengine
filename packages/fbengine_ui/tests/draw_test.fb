    Local style = Filled("#000000")
    style.Background = Color.Transparent
    style.Border = Color(1.0, 0.0, 0.0, 0.5)
    style.BorderWidth = 1.0
    style.CornerRadius = 99.0
    ui.CurrentTheme().SetStyle("pill", style)
    Drawn(ui)
    Local image = Try Pixels()
    Local along = image[20, 0]
    Expect(along != clear)
    Expect(image[0, 10] == along && image[40, 10] == along)
    EndGraphics()
End Function

Class FarBoxes Extends Widget
    New()
        Super.New("panel")
    End New

    @MainThread Public Override Method Draw(paint: Painter)
        Local red = Color.Hex("#ff0000")
        paint.Fill(Rect(1e10, -3e9, 5.0, 5.0), red)
        paint.Fill(Rect(0.0, 0.0, NaN, NaN), red)
        Local style = Filled("#00ff00")
        style.CornerRadius = 1e9
        style.Border = Color.Hex("#0000ff")
        style.BorderWidth = 2.0
        paint.Panel(Rect(-1e9, -1e9, 3e9, 3e9), style)
        Expect(paint.PixelX(1e20) == 536870912 && paint.PixelX(-1e20) == -536870912)
        Expect(paint.PixelY(NaN) == 0)
    End Method
End Class

@Test
Function AHugeOrNaNBoxDraws() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local far = Sized(FarBoxes(), 20.0, 20.0)
    Local huge = Sized(Widget("panel"), 3e9, 3e9)
    Local ui = Try Opened([far, huge])
    Local image = Try Pixels()
    // The far box's middle covers it, each row of it not drawn but those in view.
    Expect(image[10, 10] == Solid("#00ff00"))
    Expect(image[10, 100] == Solid("#ff0000"))
    Expect(ui.Root().Visible())
    EndGraphics()
End Function

@Test
Function TwoDrawsAFrameDontHalveTheBlink() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local field = TextField("")
    field.SetSize(100.0, 24.0)
    Local ui = Try Opened([field])
    Local watch = Stopwatch.StartNew()
    ui.Focus(field)
    Local off = False
    While !off && watch.Elapsed.TotalSeconds < 3.0
        Drawn(ui)
        ui.Draw()
        off = (Try Pixels())[0, 12] == clear
        // Never before half a second has gone.
        If off Then Expect(watch.Elapsed.TotalSeconds >= 0.5)
    End While
    Expect(off)
    EndGraphics()
End Function

@Test
Function ATextureFreedShowsNothing() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Graphics(200, 200)
    Local texture = Try Halved(20, 10, Solid("#ff0000"), Solid("#00ff00"))
    Local box = ImageBox(Sprite2D(texture))
    // One that keeps its size, so it's drawn; and one that measures its image, so measures nothing.
    Local sized = ImageBox(Sprite2D(texture))
    sized.SetSize(20.0, 10.0)
    Local ui = Try Opened([sized, box])
    Expect((Try Pixels())[0, 0] == Solid("#ff0000"))
    texture.Free()
    box.SetSprite(box.Sprite())
    Drawn(ui)
    Drawn(ui)
    Expect((Try Pixels())[0, 0] == clear)
    Expect(box.Box().Width == 0.0)
    EndGraphics()
End Function

// The text drawn in `box`'s rows: its first and last marked, -1 for none.
Function MarkedRows(image: Image, box: Rect, background: Color32): (Int32, Int32)
    Local first: Int32 = -1
    Local last: Int32 = -1
    For y = box.Y As Int32 To ((box.Y + box.Height) As Int32) - 1
        For x = box.X As Int32 To ((box.X + box.Width) As Int32) - 1
            If image[x, y] != background
                If first < 0 Then first = y
                last = y
            End If
        End For
    End For
    Return (first, last)
End Function

@Test
Function TextIsDrawnAtItsUisScaleOnScreenAndTarget() Throws GraphicsError, IOError
    If NoGpu() Then Skip("no GPU here")
    If Fonts() == "" Then Skip("no test fonts")
    Local label = Label("H")
    label.SetTranslates(False)
    Local ui = Try Opened([label], 300, 300)
    ui.SetFont("", Try Font.Load("{Fonts()}/OpenSans-Regular.ttf", 16.0))
    Drawn(ui)
    Drawn(ui)
    Local top, bottom = MarkedRows(Try Pixels(), Rect(0.0, 0.0, 100.0, 100.0), clear)
    Local tall = bottom - top + 1
    Expect(tall >= 9 && tall <= 15)
    ui.SetScale(2.0)
    Drawn(ui)
    Drawn(ui)
    top, bottom = MarkedRows(Try Pixels(), Rect(0.0, 0.0, 100.0, 100.0), clear)
    Local twice = bottom - top + 1
    Expect(twice >= tall * 2 - 2 && twice <= tall * 2 + 2)
    // On a target too.
    Local target = Try Texture.Target(100, 100)
    Local canvas = Canvas(target)
    canvas.SetColor(clear)
    canvas.Clear()
    ui.Draw(canvas)
    top, bottom = MarkedRows(target.ToImage(), Rect(0.0, 0.0, 100.0, 100.0), clear)
    Expect(bottom - top + 1 == twice)
    EndGraphics()
End Function

@Test
Function ThePensRotationAndScaleAreGivenBack() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Graphics(200, 200)
    Local box = ImageBox(Sprite2D(Try Halved(20, 10, Solid("#ff0000"), Solid("#ff0000"))))
    Local ui = Try Opened([box])
    Local target = Try Texture.Target(64, 64)
    Local canvas = Canvas(target)
    canvas.SetColor(clear)
    canvas.Clear()
    canvas.SetRotation(1.0)
    canvas.SetScale(2.0, 3.0)
    ui.Draw(canvas)
    Expect(canvas.Rotation() == 1.0 && canvas.Scale() == Vec2(2.0, 3.0))
    // Drawn straight, whatever the pen was.
    Local image = target.ToImage()
    Expect(image[0, 0] == Solid("#ff0000") && image[19, 9] == Solid("#ff0000"))
    Expect(image[20, 0] == clear && image[0, 10] == clear)
    EndGraphics()
End Function

@Test
Function AnImageBoxLeavesASpritesHandleOutAndCanBeNatural() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Graphics(200, 200)
    Local red = Solid("#ff0000")
    Local sprite = Sprite2D(Try Halved(20, 10, red, red))
    sprite.SetHandle(5.0, 5.0)
    Local handled = ImageBox(sprite)
    handled.SetSize(40.0, 20.0)
    Local natural = ImageBox(Sprite2D(Try Halved(20, 10, red, red)))
    natural.SetSize(40.0, 40.0)
    natural.SetFit(ImageFit.NATURAL)
    Local ui = Try Opened([handled, natural])
    Local image = Try Pixels()
    Expect(image[0, 0] == red && image[39, 19] == red && image[40, 0] == clear)
    // In the middle of its box, at its size: 10 in, and 15 down.
    Local y = natural.Box().Y As Int32
    Expect(image[9, y + 20] == clear && image[10, y + 15] == red && image[29, y + 24] == red)
    Expect(image[30, y + 20] == clear && image[10, y + 14] == clear && image[10, y + 25] == clear)
    Expect(ui.Root().Visible())
    EndGraphics()
End Function

