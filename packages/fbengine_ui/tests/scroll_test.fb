// Scroll views and lists, laid out on their own and driven by Simulate through a Ui, offscreen.

Import std.core
Import std.math
Import std.test
Import fbengine
Import fbengine_ui

// A column of `count` rows, each 20 high.
Function Rows(count: Int): Node
    Local column = Node("rows")
    For i = 1 To count
        Local row = Node("row {i}")
        row.SetHeight(Sizing.Fixed(20.0))
        column.Add(row)
    End For
    Return column
End Function

Function Viewed(content: Node, height: Float32): ScrollView
    Local view = ScrollView("view")
    view.SetHeight(Sizing.Fixed(height))
    view.Add(content)
    Return view
End Function

@Test
Function AScrollViewShowsItsContentFromItsOffset()
    Local rows = Rows(10)
    Local view = Viewed(rows, 50.0)
    Local root = Node("root")
    root.Add(view)
    Local bounds = Rect(0.0, 0.0, 200.0, 300.0)
    root.Layout(bounds)
    Expect(view.Box().Height == 50.0)
    Expect(rows.Box() == Rect(0.0, 0.0, 200.0, 200.0))
    Expect(view.MaxOffset() == 150.0)
    view.SetOffset(60.0)
    root.Layout(bounds)
    Expect(rows.Box().Y == -60.0)
    // Kept to what it shows.
    view.SetOffset(1000.0)
    root.Layout(bounds)
    Expect(view.Offset() == 150.0)
    view.SetOffset(-5.0)
    Expect(view.Offset() == 0.0)
    root.Layout(bounds)
    // What's scrolled out of it isn't found.
    Expect(root.NodeAt(Vec2(10.0, 10.0)) == rows.Find("row 1"))
    view.SetOffset(100.0)
    root.Layout(bounds)
    Expect(root.NodeAt(Vec2(10.0, 10.0)) == rows.Find("row 6"))
    Expect(root.NodeAt(Vec2(10.0, 60.0)) == root)
End Function

@Test
Function ScrollIntoViewMovesItAsLittleAsShowsABox()
    Local rows = Rows(10)
    Local view = Viewed(rows, 50.0)
    Local root = Node("root")
    root.Add(view)
    Local bounds = Rect(0.0, 0.0, 200.0, 300.0)
    root.Layout(bounds)
    Local sixth = rows.Find("row 6")
    Expect(sixth != Null)
    If sixth == Null Then Return
    view.ScrollIntoView(sixth.Box())
    root.Layout(bounds)
    // Its bottom at the view's bottom.
    Expect(view.Offset() == 70.0)
    Local second = rows.Find("row 2")
    If second == Null Then Return
    view.ScrollIntoView(second.Box())
    root.Layout(bounds)
    Expect(view.Offset() == 20.0)
    // One in view already stays.
    view.ScrollIntoView(second.Box())
    Expect(view.Offset() == 20.0)
End Function

// A window and a Ui of `root`, laid out.
Function Shown(root: Node): Ui Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Local ui = Ui(root)
    Flip()
    ui.Update()
    Return ui
End Function

@Test
Function TheWheelScrollsTheViewUnderThePointer() Throws GraphicsError
    Local rows = Rows(10)
    Local view = Viewed(rows, 50.0)
    Local root = Node("root")
    root.Add(view)
    Local ui = Try Shown(root)
    Defer EndGraphics()
    Try Simulate.MoveMouse(10.0, 10.0)
    Try Simulate.Wheel(-1.0)
    Flip()
    ui.Update()
    Expect(view.Offset() == 40.0)
    // Away from the player scrolls back up.
    Try Simulate.Wheel(2.0)
    Flip()
    ui.Update()
    Expect(view.Offset() == 0.0)
    // Off it, the wheel's nothing to it.
    Try Simulate.MoveMouse(10.0, 200.0)
    Try Simulate.Wheel(-1.0)
    Flip()
    ui.Update()
    Expect(view.Offset() == 0.0)
End Function

@Test
Function AListsItemIsPickedByAClickAndChosenByReturn() Throws GraphicsError
    Local list = List(["New game", "Load game", "Options", "Quit"])
    Local root = Node("root")
    root.SetAlign(Align.START)
    root.Add(list)
    Local ui = Try Shown(root)
    Defer EndGraphics()
    Expect(list.Selected() == -1)
    Local third = list.Children()[2]
    Try Simulate.MoveMouse(third.Box().Center.x, third.Box().Center.y)
    Try Simulate.Click(MouseButton.LEFT)
    Flip()
    ui.Update()
    Expect(list.Selected() == 2)
    Expect(list.SelectedText() == "Options")
    Expect(list.SelectionChanged())
    Expect(ui.Focused() == list)
    Expect((third As? Widget)?.StyleName() == "list.item.selected")
    Try Simulate.PressKey(Key.RETURN)
    Flip()
    ui.Update()
    Expect(list.Chosen())
    Expect(!list.SelectionChanged())
End Function

@Test
Function AListsArrowsMoveItsPick() Throws GraphicsError
    Local list = List(["a", "b", "c", "d"])
    Local root = Node("root")
    root.Add(list)
    Local ui = Try Shown(root)
    Defer EndGraphics()
    ui.Focus(list)
    Try Simulate.PressKey(Key.DOWN)
    Flip()
    ui.Update()
    Expect(list.Selected() == 0)
    Try Simulate.PressKey(Key.END)
    Flip()
    ui.Update()
    Expect(list.Selected() == 3)
    Try Simulate.PressKey(Key.DOWN)
    Flip()
    ui.Update()
    Expect(list.Selected() == 3)
    Expect(!list.SelectionChanged())
    Try Simulate.PressKey(Key.UP)
    Flip()
    ui.Update()
    Expect(list.Selected() == 2)
    Flip()
    ui.Update()
    // New items keep the one picked by its text, and with it gone, none.
    list.SetItems(["c", "a"])
    Expect(list.Selected() == 0 && list.SelectedText() == "c")
    Expect(!list.SelectionChanged())
    list.SetItems(["only"])
    Expect(list.Selected() == -1 && list.SelectionChanged())
    list.SetSelected(0)
    list.SetSelected(-1)
    Expect(list.SelectedText() == "")
End Function

// A list in a scroll view scrolls its pick into view.
@Test
Function AListInAScrollViewShowsItsPick() Throws GraphicsError
    Local items: String[] = []
    For i = 1 To 30
        items.Add("Save {i}")
    End For
    Local list = List(items)
    Local view = Viewed(list, 60.0)
    Local root = Node("root")
    root.Add(view)
    Local ui = Try Shown(root)
    Defer EndGraphics()
    ui.Focus(list)
    Try Simulate.PressKey(Key.END)
    Flip()
    ui.Update()
    Expect(view.Offset() == view.MaxOffset())
    Local last = list.Children()[29]
    Expect(last.Box().Y + last.Box().Height <=
           view.ContentBox().Y + view.ContentBox().Height + 0.01)
End Function

@Test
Function ADoubleClickChoosesAnItem() Throws GraphicsError
    Local list = List(["a", "b"])
    Local root = Node("root")
    root.SetAlign(Align.START)
    root.Add(list)
    Local ui = Try Shown(root)
    Defer EndGraphics()
    Local first = list.Children()[0]
    Try Simulate.MoveMouse(first.Box().Center.x, first.Box().Center.y)
    Try Simulate.Click(MouseButton.LEFT)
    Flip()
    ui.Update()
    Expect(!list.Chosen())
    Try Simulate.Click(MouseButton.LEFT, clicks: 2)
    Flip()
    ui.Update()
    Expect(list.Chosen())
End Function

// An offset asked for holds through Layouts: Inf keeps a growing column at its bottom, and one set
// before the first Layout is kept.
@Test
Function AnOffsetAskedForHolds() Throws GraphicsError
    Local column = Rows(2)
    Local view = Viewed(column, 60.0)
    view.SetOffset(Inf)
    Local root = Node("root")
    root.Add(view)
    Local ui = Try Shown(root)
    Defer EndGraphics()
    Expect(view.Offset() == 0.0)
    For i = 1 To 8
        Local row = Node("more {i}")
        row.SetHeight(Sizing.Fixed(20.0))
        column.Add(row)
        Flip()
        ui.Update()
        Expect(view.Offset() == view.MaxOffset())
    End For
    Expect(view.MaxOffset() > 0.0)
    // Set before its first Layout.
    Local early = Viewed(Rows(10), 60.0)
    early.SetOffset(30.0)
    root.Add(early)
    Flip()
    ui.Update()
    Expect(early.Offset() == 30.0)
End Function

// A console's newest line shows once its lines overflow.
@Test
Function AConsolesNewestLineShows() Throws GraphicsError
    Local console = Console()
    console.SetHeight(Sizing.Fixed(120.0))
    Local root = Node("root")
    root.Add(console)
    Local ui = Try Shown(root)
    Defer EndGraphics()
    For i = 1 To 40
        console.Print("line {i}")
    End For
    Flip()
    ui.Update()
    Local view = console.Children()[0] As? ScrollView
    Expect(view != Null)
    If view == Null Then Return
    Expect(view.Offset() == view.MaxOffset() && view.MaxOffset() > 0.0)
End Function

// A double click chooses the item its first press was on, not one beside it.
@Test
Function ADoubleClickChoosesOnlyTheItemItsFirstPressPicked() Throws GraphicsError
    Local list = List(["a", "b"])
    Local root = Node("root")
    root.SetAlign(Align.START)
    root.Add(list)
    Local ui = Try Shown(root)
    Defer EndGraphics()
    Local first = list.Children()[0]
    Local second = list.Children()[1]
    Try Simulate.MoveMouse(first.Box().Center.x, first.Box().Center.y)
    Try Simulate.Click(MouseButton.LEFT)
    Flip()
    ui.Update()
    // SDL counts a second press near the first a double click.
    Try Simulate.MoveMouse(second.Box().Center.x, second.Box().Center.y)
    Try Simulate.Click(MouseButton.LEFT, clicks: 2)
    Flip()
    ui.Update()
    Expect(list.Selected() == 1 && !list.Chosen())
    Try Simulate.Click(MouseButton.LEFT, clicks: 2)
    Flip()
    ui.Update()
    Expect(list.Chosen())
End Function

// At a list's ends, the arrows move the focus on.
@Test
Function AListsEndsLetTheFocusMoveOn() Throws GraphicsError
    Local top = Button("top")
    Local list = List(["a", "b"])
    Local bottom = Button("bottom")
    Local root = Node("root")
    root.SetAlign(Align.START)
    root.Add(top)
    root.Add(list)
    root.Add(bottom)
    Local ui = Try Shown(root)
    Defer EndGraphics()
    ui.Focus(list)
    For i = 1 To 3
        Try Simulate.PressKey(Key.DOWN)
        Flip()
        ui.Update()
    End For
    Expect(list.Selected() == 1)
    Expect(ui.Focused() == bottom)
    ui.Focus(list)
    Try Simulate.PressKey(Key.HOME)
    Try Simulate.PressKey(Key.UP)
    Flip()
    ui.Update()
    Expect(list.Selected() == 0 && ui.Focused() == top)
End Function

// What's under a scroll view's padding is the view's, not what's scrolled under it.
@Test
Function AScrollViewsPaddingIsItsOwn() Throws GraphicsError
    Local view = Viewed(Rows(10), 60.0)
    view.SetWidth(Sizing.Fixed(200.0))
    view.SetPadding(Insets.All(10.0))
    Local root = Node("root")
    root.SetAlign(Align.START)
    root.Add(view)
    root.Layout(Rect(0.0, 0.0, 400.0, 300.0))
    view.SetOffset(30.0)
    root.Layout(Rect(0.0, 0.0, 400.0, 300.0))
    Local box = view.Box()
    Expect(view.NodeAt(Vec2(box.X + 20.0, box.Y + 5.0)) == view)
    Expect(view.NodeAt(Vec2(box.X + 20.0, box.Y + box.Height - 5.0)) == view)
    Local inside = view.NodeAt(Vec2(box.X + 20.0, box.Y + 15.0))
    Expect(inside != Null && inside != view)
End Function

@Test
Function AThumbIsDraggedAndAPressBesideItBringsIt() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    // 420 tall in a view of 100, 200 across: a thumb a little under 24 tall, at the view's right.
    Local rows = Rows(20)
    Local button = Button("under")
    rows.Add(button)
    button.SetHeight(Sizing.Fixed(20.0))
    Local view = Viewed(rows, 100.0)
    view.SetWidth(Sizing.Fixed(200.0))
    Local root = Node("root")
    root.SetAlign(Align.START)
    root.Add(view)
    Local ui = Ui(root)
    Flip()
    ui.Update()
    Local farthest = view.MaxOffset()
    Expect(farthest == 320.0)
    // Held 2 down it, and dragged halfway down the 76 or so it can go.
    Try Simulate.MoveMouse(198.0, 2.0)
    Try Simulate.MouseDown(MouseButton.LEFT)
    Flip()
    ui.Update()
    Expect(view.Offset() == 0.0)
    Expect(ui.Pressed() != Null && RefEquals(ui.Pressed(), view))
    Try Simulate.MoveMouse(198.0, 39.5)
    Flip()
    ui.Update()
    Local room: Float32 = 100.0 - 10000.0 / 420.0
    Expect(IsClose(view.Offset(), 37.5 / room * 320.0, 0.01))
    // Past the end, it's kept; and it goes on off the view, as it's holding the pointer.
    Try Simulate.MoveMouse(300.0, 250.0)
    Flip()
    ui.Update()
    Expect(view.Offset() == farthest)
    Try Simulate.MouseUp(MouseButton.LEFT)
    Flip()
    ui.Update()
    // Let go, moving does nothing.
    Try Simulate.MoveMouse(198.0, 2.0)
    Flip()
    ui.Update()
    Expect(view.Offset() == farthest)
    // A press beside it brings its middle there.
    Try Simulate.Click(MouseButton.LEFT)
    Flip()
    ui.Update()
    Expect(view.Offset() == 0.0)
    Flip()
    ui.Update()
    // Left of its strip, what it shows has the pointer; and with nothing to scroll, so does it.
    Local under = view.NodeAt(Vec2(100.0, 5.0))
    Expect(under != Null && !RefEquals(under, view))
    Local short = Viewed(Rows(2), 100.0)
    short.SetWidth(Sizing.Fixed(200.0))
    short.Layout(Rect(0.0, 0.0, 200.0, 100.0))
    Local kept = short.NodeAt(Vec2(198.0, 5.0))
    Expect(kept != Null && !RefEquals(kept, short))
End Function

// A view of `count` rows in a view `height` tall, 200 across, in a Ui, laid out.
Function Dragging(count: Int, height: Float32): (Node, ScrollView, Ui)
    Local rows = Rows(count)
    Local view = Viewed(rows, height)
    view.SetWidth(Sizing.Fixed(200.0))
    Local root = Node("root")
    root.SetAlign(Align.START)
    root.Add(view)
    Local ui = Ui(root)
    Flip()
    ui.Update()
    Return (rows, view, ui)
End Function

Function Grown(rows: Node, by: Int)
    For i = 1 To by
        Local row = Node("more {i}")
        row.SetHeight(Sizing.Fixed(20.0))
        rows.Add(row)
    End For
End Function

// Moves the pointer to `y` on the strip, a frame.
Function MovedTo(ui: Ui, y: Float32) Throws GraphicsError
    Try Simulate.MoveMouse(198.0, y)
    Flip()
    ui.Update()
End Function

Function Pressing(ui: Ui, y: Float32) Throws GraphicsError
    Try Simulate.MoveMouse(198.0, y)
    Try Simulate.MouseDown(MouseButton.LEFT)
    Flip()
    ui.Update()
End Function

Function LetGo(ui: Ui) Throws GraphicsError
    Try Simulate.MouseUp(MouseButton.LEFT)
    Flip()
    ui.Update()
End Function

// A drag past the end keeps only the end: what it shows growing after doesn't jump.
@Test
Function ADragPastTheEndKeepsOnlyTheEnd() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    Local rows, view, ui = Dragging(20, 100.0)
    Try Pressing(ui, 2.0)
    Try MovedTo(ui, 250.0)
    Expect(view.Offset() == 300.0)
    Try LetGo(ui)
    Grown(rows, 200)
    Flip()
    ui.Update()
    Expect(view.MaxOffset() == 4300.0)
    Expect(view.Offset() == 300.0)
    // Before the start, the same.
    Try Pressing(ui, 2.0 + view.Offset() / view.MaxOffset() * 80.0)
    Try MovedTo(ui, -500.0)
    Expect(view.Offset() == 0.0)
    Try LetGo(ui)
    Expect(view.Offset() == 0.0)
End Function

// While it's held, the wheel's nothing to it, nor to what's under it.
@Test
Function TheWheelDoesNothingWhileTheThumbsHeld() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    Local rows, view, ui = Dragging(20, 100.0)
    Try Pressing(ui, 2.0)
    Try MovedTo(ui, 20.0)
    Local held = view.Offset()
    Expect(held > 0.0)
    Try Simulate.Wheel(-2.0)
    Flip()
    ui.Update()
    Expect(view.Offset() == held)
    // Nor did it build up, for the next move.
    Try MovedTo(ui, 20.5)
    Expect(view.Offset() < held + 5.0 && view.Offset() > held)
    Try LetGo(ui)
    // Let go, it scrolls.
    Local before = view.Offset()
    Try Simulate.Wheel(-1.0)
    Flip()
    ui.Update()
    Expect(view.Offset() == before + 40.0)
    Expect(rows.Children().Count == 20)
End Function

// How tall the thumb of a view `tall` showing `extent` is, as it draws it.
Function ThumbOf(tall: Float32, extent: Float32): Float32 => Max(tall * tall / extent, 16.0)

// What it shows growing under a held thumb, it stays under the pointer, at the same part of it.
@Test
Function AHeldThumbStaysUnderThePointerAsWhatItShowsGrows() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    // 125 in 100: a thumb 80 tall, held 70 down it, 7/8ths.
    Local rows, view, ui = Dragging(6, 100.0)
    rows.Children()[0].SetHeight(Sizing.Fixed(25.0))
    Flip()
    ui.Update()
    Expect(view.MaxOffset() == 25.0)
    Try Pressing(ui, 70.0)
    Expect(view.Offset() == 0.0)
    Grown(rows, 44)
    Flip()
    ui.Update()
    Expect(view.MaxOffset() == 905.0)
    // Not moved: its thumb's smaller, with the pointer as far down it as it was.
    Local tall = ThumbOf(100.0, 1005.0)
    Local top = view.Offset() / view.MaxOffset() * (100.0 - tall)
    Expect(IsClose(top + tall * 0.875, 70.0, 0.01))
    // Moved, the same; and the bottom's in reach.
    Try MovedTo(ui, 80.0)
    top = view.Offset() / view.MaxOffset() * (100.0 - tall)
    Expect(IsClose(top + tall * 0.875, 80.0, 0.01))
    Try MovedTo(ui, 99.0)
    Expect(view.Offset() == view.MaxOffset() ||
           IsClose(view.Offset() / view.MaxOffset() * (100.0 - tall) + tall * 0.875, 99.0, 0.01))
    Try LetGo(ui)
    // Shrunk to nothing to scroll and grown again while held, it comes back under the pointer.
    Try Pressing(ui, 90.0)
    For i = rows.Children().Count - 1 To 2 Step -1
        rows.Remove(rows.Children()[i])
    End For
    Flip()
    ui.Update()
    Expect(view.Offset() == 0.0 && view.MaxOffset() == 0.0)
    Grown(rows, 48)
    Flip()
    ui.Update()
    Expect(view.Offset() > 0.0)
    Try LetGo(ui)
End Function

// SetOffset, as a console's Print is, does nothing while it's held, and goes on after.
@Test
Function ThePointerSaysWhereItsScrolledWhileItsHeld() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    Local rows, view, ui = Dragging(20, 100.0)
    Try Pressing(ui, 2.0)
    Try MovedTo(ui, 20.0)
    Local held = view.Offset()
    view.SetOffset(Inf)
    Expect(view.Offset() == held)
    Flip()
    ui.Update()
    Expect(view.Offset() == held)
    Try LetGo(ui)
    view.SetOffset(Inf)
    Flip()
    ui.Update()
    Expect(view.Offset() == view.MaxOffset())
    Expect(rows.Children().Count == 20)
End Function

// A press on a console's thumb leaves its line the focus, and a Print under a still pointer leaves
// the view where the pointer has it.
@Test
Function AConsolesThumbLeavesItsLineTheFocus() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    Local root = Node("root")
    root.SetArrangement(Arrangement.STACK)
    Local console = Console()
    console.SetHeight(Sizing.Fraction(0.5))
    console.SetAnchors(Anchors(0.0, 0.0, 1.0, 0.0))
    root.Add(console)
    Local ui = Ui(root)
    For i = 1 To 100
        console.Print("line {i}")
    End For
    ui.Focus(console.Line())
    Flip()
    ui.Update()
    Local view = console.Children()[0] As? ScrollView
    If view == Null Then Panic("a console's first child is its view")
    Local box = view.ContentBox()
    Expect(view.Offset() == view.MaxOffset())
    // Dragged up from the bottom.
    Try Simulate.MoveMouse(box.X + box.Width - 2.0, box.Y + box.Height - 2.0)
    Try Simulate.MouseDown(MouseButton.LEFT)
    Flip()
    ui.Update()
    Expect(RefEquals(ui.Pressed(), view))
    Expect(RefEquals(ui.Focused(), console.Line()))
    Try Simulate.MoveMouse(box.X + box.Width - 2.0, box.Y + box.Height / 2.0)
    Flip()
    ui.Update()
    Local held = view.Offset()
    Expect(held < view.MaxOffset() && held > 0.0)
    console.Print("printed mid-drag")
    Flip()
    ui.Update()
    Expect(view.Offset() < view.MaxOffset() - 5.0)
    Try Simulate.MouseUp(MouseButton.LEFT)
    Flip()
    ui.Update()
    Expect(RefEquals(ui.Focused(), console.Line()))
    // A press beside its strip, on the lines, moves the focus as a press does.
    Try Simulate.MoveMouse(box.X + 20.0, box.Y + 20.0)
    Try Simulate.Click(MouseButton.LEFT)
    Flip()
    ui.Update()
    Expect(!RefEquals(ui.Focused(), console.Line()))
End Function

// A view too short for its thumb to move leaves its strip to what it shows.
@Test
Function AViewWithNoRoomForItsThumbToMoveLeavesItsStrip() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    Local rows, view, ui = Dragging(20, 16.0)
    Expect(view.MaxOffset() > 0.0)
    Local under = view.NodeAt(Vec2(198.0, 5.0))
    Expect(under != Null && !RefEquals(under, view))
    Try Pressing(ui, 5.0)
    Expect(ui.Pressed() == Null)
    Try LetGo(ui)
    // A unit taller, its thumb can move.
    view.SetHeight(Sizing.Fixed(17.0))
    Flip()
    ui.Update()
    Local strip = view.NodeAt(Vec2(198.0, 5.0))
    Expect(strip != Null && RefEquals(strip, view))
    Expect(rows.Children().Count == 20)
End Function

// While a view's thumb is held, the wheel's used up by it, so the view it's in doesn't scroll either.
@Test
Function TheWheelOverAHeldThumbDoesntScrollTheViewItsIn() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    Local inner = Viewed(Rows(20), 60.0)
    inner.SetWidth(Sizing.Fixed(100.0))
    Local column = Rows(20)
    column.SetAlign(Align.START)
    column.Insert(0, inner)
    Local outer = Viewed(column, 100.0)
    outer.SetWidth(Sizing.Fixed(200.0))
    Local root = Node("root")
    root.SetAlign(Align.START)
    root.Add(outer)
    Local ui = Ui(root)
    Flip()
    ui.Update()
    Expect(outer.MaxOffset() > 0.0)
    Try Simulate.MoveMouse(98.0, 2.0)
    Try Simulate.MouseDown(MouseButton.LEFT)
    Flip()
    ui.Update()
    Expect(RefEquals(ui.Pressed(), inner))
    Try Simulate.Wheel(-1.0)
    Flip()
    ui.Update()
    Expect(inner.Offset() == 0.0 && outer.Offset() == 0.0)
    Try Simulate.MouseUp(MouseButton.LEFT)
    Flip()
    ui.Update()
End Function
