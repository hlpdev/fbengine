// What holds the pointer taken out of what's shown, by its own press in the frame it's pressed or
// by the game between Updates: removed, hidden, disabled, or in a popup closed. It's told its press
// is called off, once, and never that it's let go; and the next press is the left button's again,
// whichever button pressed it.

Import std.core
Import std.math
Import std.test
Import fbengine
Import fbengine_ui

// Calls Going as it's pressed, by any button, and counts how it's let go.
Class GoesAsPressed Extends Widget
    Public Field Going: (Func(GoesAsPressed))? = Null
    Public Field Cancelling: (Func(GoesAsPressed))? = Null
    Public Field Presses: Int = 0
    Public Field Ups: Int = 0
    Public Field Cancels: Int = 0

    New()
        Super.New("box", "goes")
        SetSize(100.0, 100.0)
    End New

    @MainThread Public Override Method PointerDown(point: Vec2): Bool
        Went()
        Return True
    End Method

    @MainThread Public Override Method PointerDownWith(button: MouseButton, point: Vec2): Bool
        Went()
        Return True
    End Method

    @MainThread Public Override Method PointerUp(point: Vec2, over: Bool)
        Ups += 1
    End Method

    @MainThread Public Override Method PointerCancelled(point: Vec2)
        Cancels += 1
        Local cancelling = Cancelling
        If cancelling != Null Then cancelling(Self)
    End Method

    @MainThread Method Went()
        Presses += 1
        Local going = Going
        If going != Null Then going(Self)
    End Method
End Class

@Test
Function APressTakenOutInItsOwnFrameIsCalledOffOnce() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    For how In ["removed", "hidden", "disabled", "closed"]
        For button In [MouseButton.LEFT, MouseButton.RIGHT, MouseButton.MIDDLE]
            Local root = Node("root")
            Local ui = Ui(root)
            Local widget = GoesAsPressed()
            Local popup = Node("popup")
            If how == "closed"
                popup.Add(widget)
                ui.OpenPopup(popup)
            Else
                root.Add(widget)
            End If
            widget.Going = Function(pressed: GoesAsPressed)
                Select how
                    Case "removed"
                        pressed.Parent()?.Remove(pressed)
                    Case "hidden"
                        pressed.SetVisible(False)
                    Case "disabled"
                        pressed.SetEnabled(False)
                    Default
                        ui.ClosePopup(popup)
                End Select
            End Function
            ui.Update()
            Local center = widget.Box().Center
            Try Simulate.MoveMouse(center.x, center.y)
            Flip()
            ui.Update()
            Try Simulate.MouseDown(button)
            Flip()
            ui.Update()
            Local said = "{how}, pressed by {button}"
            Expect(widget.Presses == 1, "{said}: pressed {widget.Presses} times")
            Expect(ui.Pressed() == Null, "{said}: it's still held")
            Expect(widget.Cancels == 1, "{said}: called off {widget.Cancels} times")
            Expect(widget.Ups == 0, "{said}: let go {widget.Ups} times")
            Expect(ui.PressedButton() == MouseButton.LEFT,
                   "{said}: the button's {ui.PressedButton()}")
            // The button let go, and frames on, it's told nothing more.
            Try Simulate.MouseUp(button)
            For frame = 1 To 2
                Flip()
                ui.Update()
            End For
            Expect(widget.Cancels == 1 && widget.Ups == 0,
                   "{said}: then called off {widget.Cancels} times, let go {widget.Ups}")
            // What it calls holds what holds it.
            widget.Going = Null
        End For
    End For
End Function

@Test
Function APressTakenOutBetweenUpdatesIsCalledOffOnce() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    For how In ["removed", "hidden", "disabled", "closed"]
        For button In [MouseButton.LEFT, MouseButton.RIGHT, MouseButton.MIDDLE]
            Local root = Node("root")
            Local ui = Ui(root)
            Local widget = GoesAsPressed()
            Local popup = Node("popup")
            If how == "closed"
                popup.Add(widget)
                ui.OpenPopup(popup)
            Else
                root.Add(widget)
            End If
            ui.Update()
            Local center = widget.Box().Center
            Try Simulate.MoveMouse(center.x, center.y)
            Flip()
            ui.Update()
            Try Simulate.MouseDown(button)
            Flip()
            ui.Update()
            Local said = "{how} between Updates, pressed by {button}"
            Expect(ui.Pressed() == widget, "{said}: it wasn't held")
            Select how
                Case "removed"
                    root.Remove(widget)
                Case "hidden"
                    widget.SetVisible(False)
                Case "disabled"
                    widget.SetEnabled(False)
                Default
                    ui.ClosePopup(popup)
            End Select
            // The button's still down: its press is called off, not let go of.
            Flip()
            ui.Update()
            Expect(ui.Pressed() == Null, "{said}: it's still held")
            Expect(widget.Cancels == 1, "{said}: called off {widget.Cancels} times")
            Expect(widget.Ups == 0, "{said}: let go {widget.Ups} times")
            Expect(ui.PressedButton() == MouseButton.LEFT,
                   "{said}: the button's {ui.PressedButton()}")
            Try Simulate.MouseUp(button)
            For frame = 1 To 2
                Flip()
                ui.Update()
            End For
            Expect(widget.Cancels == 1 && widget.Ups == 0,
                   "{said}: then called off {widget.Cancels} times, let go {widget.Ups}")
        End For
    End For
End Function

// A press called off whose PointerCancelled takes out what the pointer's over, inside what it
// pressed, leaves it hovered by nothing, that frame.
@Test
Function WhatAPointerCancelledTakesOutIsntHovered() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    Local root = Node("root")
    Local ui = Ui(root)
    Local widget = GoesAsPressed()
    Local inside = Widget("box", "inside")
    inside.SetSize(50.0, 50.0)
    widget.Add(inside)
    root.Add(widget)
    widget.Going = Function(pressed: GoesAsPressed)
        pressed.SetEnabled(False)
    End Function
    widget.Cancelling = Function(pressed: GoesAsPressed)
        pressed.Remove(inside)
    End Function
    ui.Update()
    Local center = inside.Box().Center
    Try Simulate.MoveMouse(center.x, center.y)
    Flip()
    ui.Update()
    Expect(ui.Hovered() == inside, "the pointer's not over what's inside")
    Try Simulate.MouseDown(MouseButton.LEFT)
    Flip()
    ui.Update()
    Expect(widget.Presses == 1 && widget.Cancels == 1,
           "pressed {widget.Presses} times, called off {widget.Cancels}")
    Expect(inside.Parent() == Null && ui.Hovered() == Null,
           "what's taken out is hovered: {ui.Hovered() != Null}")
    Try Simulate.MouseUp(MouseButton.LEFT)
    Flip()
    ui.Update()
End Function

// A click, pressed and let go in one frame, whose own press takes its widget out: the release that
// comes in the same frame doesn't let go of what's out, which is called off, once.
@Test
Function AClickWhosePressTakesItOutIsCalledOffNotLetGo() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    For how In ["removed", "hidden", "disabled", "closed"]
        For button In [MouseButton.LEFT, MouseButton.RIGHT, MouseButton.MIDDLE]
            Local root = Node("root")
            Local ui = Ui(root)
            Local widget = GoesAsPressed()
            Local popup = Node("popup")
            If how == "closed"
                popup.Add(widget)
                ui.OpenPopup(popup)
            Else
                root.Add(widget)
            End If
            widget.Going = Function(pressed: GoesAsPressed)
                Select how
                    Case "removed"
                        pressed.Parent()?.Remove(pressed)
                    Case "hidden"
                        pressed.SetVisible(False)
                    Case "disabled"
                        pressed.SetEnabled(False)
                    Default
                        ui.ClosePopup(popup)
                End Select
            End Function
            ui.Update()
            Local center = widget.Box().Center
            Try Simulate.MoveMouse(center.x, center.y)
            Flip()
            ui.Update()
            Try Simulate.MouseDown(button)
            Try Simulate.MouseUp(button)
            Flip()
            ui.Update()
            Local said = "{how}, clicked by {button}"
            Expect(widget.Presses == 1, "{said}: pressed {widget.Presses} times")
            Expect(ui.Pressed() == Null, "{said}: it's still held")
            Expect(widget.Cancels == 1, "{said}: called off {widget.Cancels} times")
            Expect(widget.Ups == 0, "{said}: let go {widget.Ups} times")
            Expect(ui.PressedButton() == MouseButton.LEFT,
                   "{said}: the button's {ui.PressedButton()}")
            For frame = 1 To 2
                Flip()
                ui.Update()
            End For
            Expect(widget.Cancels == 1 && widget.Ups == 0,
                   "{said}: then called off {widget.Cancels} times, let go {widget.Ups}")
            widget.Going = Null
        End For
    End For
End Function

// A LEFT press that takes its widget out, and a RIGHT or MIDDLE press in the same frame: the left
// one's widget is called off first, so the other press is taken, by what it's in.
@Test
Function APressAfterALeftPressTookItsWidgetOutIsTaken() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(400, 300)
    Defer EndGraphics()
    For button In [MouseButton.RIGHT, MouseButton.MIDDLE]
        Local root = Node("root")
        Local ui = Ui(root)
        Local outer = GoesAsPressed()
        Local inner = GoesAsPressed()
        root.Add(outer)
        outer.Add(inner)
        // Disabled, so the other press goes on to what it's in.
        inner.Going = Function(pressed: GoesAsPressed) => pressed.SetEnabled(False)
        ui.Update()
        Local center = inner.Box().Center
        Try Simulate.MoveMouse(center.x, center.y)
        Flip()
        ui.Update()
        Expect(ui.Hovered() == inner, "{button}: the pointer isn't over the inner widget")
        Try Simulate.MouseDown(MouseButton.LEFT)
        Try Simulate.MouseDown(button)
        Flip()
        ui.Update()
        Local said = "a LEFT press and a {button} press"
        Expect(inner.Presses == 1 && inner.Cancels == 1,
               "{said}: the inner pressed {inner.Presses} times, called off {inner.Cancels}")
        Expect(outer.Presses == 1, "{said}: the outer pressed {outer.Presses} times")
        Expect(ui.Pressed() == outer, "{said}: the outer isn't held")
        Expect(ui.PressedButton() == button, "{said}: the button's {ui.PressedButton()}")
        Try Simulate.MouseUp(button)
        Try Simulate.MouseUp(MouseButton.LEFT)
        Flip()
        ui.Update()
        Expect(outer.Ups == 1 && outer.Cancels == 0,
               "{said}: the outer let go {outer.Ups} times, called off {outer.Cancels}")
        inner.Going = Null
    End For
End Function
