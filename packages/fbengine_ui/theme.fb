// Themes: how widgets look, by their style's name and their state, set in code or loaded from TOML.

Import std.collections
Import std.core
Import std.data.toml
Import std.math
Import std.text
Import "./layout"

/// A theme that can't be loaded.
Public Class UIError Extends Error
End Class

/// What a widget's doing, which its look follows.
Public Enum WidgetState
    NORMAL
    /// The mouse is over it.
    HOVERED
    /// It's held down.
    PRESSED
    /// It has the keyboard's or the gamepad's focus.
    FOCUSED
    /// It can't be used.
    DISABLED
End Enum

/// How a widget looks in one of its states.
Public Struct Style Implements Printable
    /// What's behind it.
    Public Field Background: Color
    /// Its text and its icons.
    Public Field Foreground: Color
    /// Its border's color.
    Public Field Border: Color
    /// How wide its border is, 0 for none.
    Public Field BorderWidth: Float32
    /// How round its corners are.
    Public Field CornerRadius: Float32
    /// The space between its edge and what it shows.
    Public Field Padding: Insets
    /// Its text's font, by name, as fbengine's text finds it; "" for the default one.
    Public Field Font: String
    /// Its text's size.
    Public Field FontSize: Float32

    /// What a theme with no style for a widget gives it: white text, 16 high, on nothing.
    Public Static Method Plain(): Style
        Return Style(Color.Transparent, Color.White, Color.Transparent, 0.0, 0.0, Insets.All(0.0),
                     "",
                     16.0)
    End Method

    Public Method ToString(): String =>
        "{Background.ToHex()} {Foreground.ToHex()} {Font} {FontSize}"
End Struct

/// The fields of a Style that a theme's name sets in one of its states, each Null where it takes
/// the name it's a kind of's, or the name's normal state's.
Public Struct StyleFields
    Public Field Background: Color?
    Public Field Foreground: Color?
    Public Field Border: Color?
    Public Field BorderWidth: Float32?
    Public Field CornerRadius: Float32?
    Public Field Padding: Insets?
    Public Field Font: String?
    Public Field FontSize: Float32?

    /// Every field of `style`.
    Public Static Method Of(style: Style): StyleFields
        Return StyleFields(style.Background, style.Foreground, style.Border, style.BorderWidth,
                           style.CornerRadius, style.Padding, style.Font, style.FontSize)
    End Method

    /// `style` with the fields it sets.
    Public Method Over(style: Style): Style
        Local made = style
        made.Background = Background ?? made.Background
        made.Foreground = Foreground ?? made.Foreground
        made.Border = Border ?? made.Border
        made.BorderWidth = BorderWidth ?? made.BorderWidth
        made.CornerRadius = CornerRadius ?? made.CornerRadius
        made.Padding = Padding ?? made.Padding
        made.Font = Font ?? made.Font
        made.FontSize = FontSize ?? made.FontSize
        Return made
    End Method

    /// The fields it sets, and those `over` sets in their place.
    Public Method With(over: StyleFields): StyleFields
        Return StyleFields(over.Background ?? Background, over.Foreground ?? Foreground,
                           over.Border ?? Border, over.BorderWidth ?? BorderWidth,
                           over.CornerRadius ?? CornerRadius, over.Padding ?? Padding,
                           over.Font ?? Font, over.FontSize ?? FontSize)
    End Method
End Struct

// A state's name in a theme's TOML.
Function StateName(state: WidgetState): String
    Select state
        Case WidgetState.HOVERED
            Return "hovered"
        Case WidgetState.PRESSED
            Return "pressed"
        Case WidgetState.FOCUSED
            Return "focused"
        Case WidgetState.DISABLED
            Return "disabled"
        Default
            Return "normal"
    End Select
End Function

Function StateNamed(name: String): WidgetState?
    For state In States()
        If StateName(state) == name Then Return state
    End For
    Return Null
End Function

// Whether `set` sets no field.
Function Empty(set: StyleFields): Bool
    Return set.Background == Null && set.Foreground == Null && set.Border == Null &&
           set.BorderWidth == Null && set.CornerRadius == Null && set.Padding == Null &&
           set.Font == Null && set.FontSize == Null
End Function

Function States(): WidgetState[]
    Return [WidgetState.NORMAL, WidgetState.HOVERED, WidgetState.PRESSED, WidgetState.FOCUSED,
            WidgetState.DISABLED]
End Function

// A theme's TOML's names for a style's fields.
Function FieldNames(): String[]
    Return ["background", "foreground", "border", "border_width", "corner_radius", "padding",
            "font",
            "font_size"]
End Function

/// How a game's widgets look: for each style name and state, the fields it sets. A widget asks
/// for its style's name, as "button", or a kind of one, as "button.primary", and its state; the
/// theme makes its Style when it's asked, from Style.Plain, then "default"'s fields, then each
/// name in turn down to the widget's own, each name's normal state's then the widget's state's,
/// the nearer winning. So a kind keeps what it doesn't set of the name it's a kind of, whatever
/// that sets later, and every name keeps "default"'s, its disabled state's faded text and all.
Public Final Class Theme
    Field fields: Map<String, StyleFields>

    /// A theme with no styles, so every widget looks as Style.Plain does.
    @MainThread Public New()
        fields = {}
    End New

    /// fbengine_ui's own theme: light text on dark panels, buttons that light up under the mouse
    /// and go darker held, a blue edge on what has the focus, and faded text on what's disabled.
    @MainThread Public Static Method Dark(): Theme
        Local theme = Theme()
        Local text = Color.Hex("#e6e8eb")
        theme.SetStyle("default", Style(Color.Transparent, text, Color.Transparent, 0.0, 0.0,
                                        Insets.All(0.0), "", 16.0))
        Local disabled = StyleFields()
        disabled.Foreground = Color.Hex("#7d838c")
        theme.SetFields("default", disabled, WidgetState.DISABLED)
        Local focused = StyleFields()
        focused.Border = Color.Hex("#4c8dff")
        focused.BorderWidth = 2.0
        theme.SetFields("default", focused, WidgetState.FOCUSED)

        Local panel = StyleFields()
        panel.Background = Color.Hex("#1c1f24")
        panel.Border = Color.Hex("#30353d")
        panel.BorderWidth = 1.0
        panel.CornerRadius = 6.0
        panel.Padding = Insets.All(12.0)
        theme.SetFields("panel", panel)

        Local button = StyleFields()
        button.Background = Color.Hex("#2b3038")
        button.CornerRadius = 4.0
        button.Padding = Insets.Symmetric(12.0, 6.0)
        theme.SetFields("button", button)
        Local hovered = StyleFields()
        hovered.Background = Color.Hex("#363c46")
        theme.SetFields("button", hovered, WidgetState.HOVERED)
        Local pressed = StyleFields()
        pressed.Background = Color.Hex("#22262c")
        theme.SetFields("button", pressed, WidgetState.PRESSED)

        Local field = StyleFields()
        field.Background = Color.Hex("#14161a")
        field.Border = Color.Hex("#30353d")
        field.BorderWidth = 1.0
        field.CornerRadius = 4.0
        field.Padding = Insets.Symmetric(8.0, 6.0)
        theme.SetFields("field", field)
        // Its own border is nearer than default's focused one, so it gives its own.
        theme.SetFields("field", focused, WidgetState.FOCUSED)

        Local track = StyleFields()
        track.Background = Color.Hex("#2b3038")
        track.CornerRadius = 4.0
        theme.SetFields("slider", track)
        Local item = StyleFields()
        item.Padding = Insets.Symmetric(8.0, 4.0)
        theme.SetFields("list.item", item)
        Local under = StyleFields()
        under.Background = Color.Hex("#262a31")
        theme.SetFields("list.item", under, WidgetState.HOVERED)
        Local picked = StyleFields()
        picked.Background = Color.Hex("#2f4a7a")
        theme.SetFields("list.item.selected", picked)

        Local bright = StyleFields()
        bright.Background = Color.Hex("#4c8dff")
        Local faint = StyleFields()
        faint.Background = Color.Hex("#4a505a")
        // What's filled and held, and what's filled in one that's disabled.
        theme.SetFields("slider.fill", bright)
        theme.SetFields("slider.fill", faint, WidgetState.DISABLED)
        Local thumb = StyleFields()
        thumb.Background = text
        theme.SetFields("slider.thumb", thumb)
        theme.SetFields("slider.thumb", faint, WidgetState.DISABLED)
        Local bar = StyleFields()
        bar.Background = Color.Hex("#2b3038")
        bar.CornerRadius = 4.0
        theme.SetFields("progress", bar)
        theme.SetFields("progress.fill", bright)
        theme.SetFields("progress.fill", faint, WidgetState.DISABLED)
        theme.SetFields("scroll.thumb", faint)
        Local box = StyleFields()
        box.Background = Color.Hex("#14161a")
        box.Border = Color.Hex("#4a505a")
        box.BorderWidth = 1.0
        box.CornerRadius = 3.0
        theme.SetFields("toggle.box", box)
        Local boxFocused = StyleFields()
        boxFocused.Border = Color.Hex("#4c8dff")
        boxFocused.BorderWidth = 1.0
        theme.SetFields("toggle.box", boxFocused, WidgetState.FOCUSED)
        // A toggle's text is beside its box, which shows the focus.
        Local plain = StyleFields()
        plain.BorderWidth = 0.0
        theme.SetFields("toggle", plain, WidgetState.FOCUSED)
        Local check = StyleFields()
        check.Background = Color.Hex("#4c8dff")
        check.BorderWidth = 0.0
        check.CornerRadius = 2.0
        theme.SetFields("toggle.check", check)
        theme.SetFields("toggle.check", faint, WidgetState.DISABLED)
        Local selection = StyleFields()
        selection.Background = Color.Hex("#2f4a7a")
        selection.BorderWidth = 0.0
        selection.CornerRadius = 0.0
        theme.SetFields("field.selection", selection)

        theme.SetFields("console", panel)
        theme.SetFields("console.field", field)
        theme.SetFields("console.field", focused, WidgetState.FOCUSED)
        theme.SetFields("console.field.selection", selection)
        Local line = StyleFields()
        line.Padding = Insets.Symmetric(0.0, 1.0)
        line.Background = Color.Transparent
        line.BorderWidth = 0.0
        theme.SetFields("console.line", line)
        Local view = StyleFields()
        view.Background = Color.Transparent
        view.BorderWidth = 0.0
        view.Padding = Insets.All(0.0)
        theme.SetFields("console.view", view)
        theme.SetFields("debug", panel)
        Local name = StyleFields()
        name.Foreground = Color.Hex("#9aa1ab")
        name.Background = Color.Transparent
        name.BorderWidth = 0.0
        name.Padding = Insets.All(0.0)
        theme.SetFields("debug.name", name)
        Return theme
    End Method

    /// Sets every field of the style named `name` in `state`, its normal one at first. Panics for a
    /// name that's "", or has a part that is, as "button." does, and for a field Load wouldn't
    /// take: a width, radius, size, or padding under 0 or not finite.
    @MainThread Public Method SetStyle(name: String, style: Style,
                                       state: WidgetState = WidgetState.NORMAL)
        SetFields(name, StyleFields.Of(style), state)
    End Method

    /// Sets the fields `set` sets of the style named `name` in `state`, in place of those it had,
    /// the others taking the name it's a kind of's. Panics as SetStyle does.
    @MainThread Public Method SetFields(name: String, set: StyleFields,
                                        state: WidgetState = WidgetState.NORMAL)
        CheckName("Theme.SetFields", name)
        CheckFields("Theme.SetFields", set)
        // Nothing set is no fields of its own, as Load reads an empty table.
        If Empty(set)
            fields.Remove(Key(name, state))
            Return
        End If
        fields[Key(name, state)] = set
    End Method

    /// The fields the style named `name` sets in `state` of its own, or Null.
    @MainThread Public Method Fields(name: String,
                                     state: WidgetState = WidgetState.NORMAL): StyleFields?
        Return fields.Get(Key(name, state))
    End Method

    /// Whether the style named `name` sets fields of its own in `state`.
    @MainThread Public Method HasStyle(name: String, state: WidgetState = WidgetState.NORMAL): Bool
        Return fields.Get(Key(name, state)) != Null
    End Method

    /// The Style a widget of style `name` has in `state`: Style.Plain, then the fields "default"
    /// sets, and each name down to `name`, in its normal state and then in `state`.
    @MainThread Public Method StyleOf(name: String, state: WidgetState = WidgetState.NORMAL): Style
        Local made = Style.Plain()
        Local lineage = Lineage(name)
        For i = lineage.Count - 1 To 0 Step -1
            Local normal = fields.Get(Key(lineage[i], WidgetState.NORMAL))
            If normal != Null Then made = normal.Over(made)
            If state != WidgetState.NORMAL
                Local stated = fields.Get(Key(lineage[i], state))
                If stated != Null Then made = stated.Over(made)
            End If
        End For
        Return made
    End Method

    /// The names it has styles for, in order.
    @MainThread Public Method Names(): String[]
        Local names: String[] = []
        For key In fields.Keys()
            Local name = key.Slice(0, key.FindLast("/") ?? key.Length)
            If !names.Contains(name) Then names.Add(name)
        End For
        names.Sort()
        Return names
    End Method

    /// Its styles as a TOML document, which Load reads back the same: a table for each name, with
    /// the fields its normal state sets, and a table in it for each state that sets any. Colors
    /// are CSS's hex, so one between sRGB's bytes is saved as the nearest.
    ///
    /// ```toml
    /// [button]
    /// background = "#2b3038"
    /// padding = [12, 6, 12, 6]
    /// corner_radius = 4
    ///
    /// [button.hovered]
    /// background = "#363c46"
    /// ```
    @MainThread Public Method Save(): String
        Local document = Value.Object()
        For name In Names()
            Local table = Value.Object()
            Local normal = fields.Get(Key(name, WidgetState.NORMAL))
            If normal != Null Then Written(table, normal)
            For state In States()
                If state == WidgetState.NORMAL Then Continue
                Local own = fields.Get(Key(name, state))
                If own == Null Then Continue
                Local stated = Value.Object()
                Written(stated, own)
                table[StateName(state)] = stated
            End For
            document[name] = table
        End For
        Return Toml.Write(document)
    End Method

    /// Reads styles from a TOML document, as Save writes them or a person does, over the ones it
    /// has: a name's table gives the fields its normal state sets, over those it set before, and a
    /// state's table in it, those that state sets. A table in a name's that isn't a state's is a
    /// kind of it: `[button.primary]` with `background = "#4c8dff"` is the style "button.primary",
    /// as `["button.primary"]` is, and keeps every other field of "button"'s, in each state. The
    /// fields: background, foreground, and border, CSS's hex colors; border_width, corner_radius,
    /// and font_size, numbers of 0 or more; padding, one number for every side, two for left and
    /// right then top and bottom, or four, left, top, right, bottom; and font, a name. Nothing
    /// changes when it throws: for text that isn't TOML, a field that isn't one of those, a table
    /// in a state's, or a table named as a field is.
    @MainThread Public Method Load(text: String) Throws UIError
        Local document = Value.Object()
        Try
            document = Try Toml.Read(text)
        Catch e As ParseError
            Throw UIError("the theme isn't TOML: {e.Message}", e)
        End Try
        Local found: (String, Value)[] = []
        For name In document.Keys()
            Local table = document[name]
            If table == Null || !table.IsObject
                Throw UIError("the style {name} is a table of its fields, not {table ?? Value()}")
            End If
            found.Add((name, table))
            Try Kinds(name, table, found)
        End For
        Local loaded = fields.Clone()
        For each In found
            Local name, table = each
            If !GoodName(name) Then Throw UIError("\"{name}\" isn't a style's name, which has no empty parts")
            Local normal = Try Changed(loaded.Get(Key(name, WidgetState.NORMAL)), name, table)
            If normal != Null Then loaded[Key(name, WidgetState.NORMAL)] = normal
            For state In States()
                If state == WidgetState.NORMAL Then Continue
                Local own = table[StateName(state)]
                If own == Null || !own.IsObject Then Continue
                Local named = "{name}.{StateName(state)}"
                For key In own.Keys()
                    Local value = own[key]
                    If value != Null && value.IsObject
                        Throw UIError(
                            "{named} has a table, {key}, in it; a state's table has only fields")
                    End If
                End For
                Local stated = Try Changed(loaded.Get(Key(name, state)), named, own)
                If stated != Null Then loaded[Key(name, state)] = stated
            End For
        End For
        fields = loaded
    End Method
End Class

// The key a style name's fields in `state` are kept by.
Function Key(name: String, state: WidgetState): String => "{name}/{StateName(state)}"

// The kinds of `name` its table has, tables that aren't a state's, as `[button.primary]` is in
// "button"'s, each with its own name, as "button.primary", and theirs, in `found`. A table named
// as a field is, as `background = {}`, is a mistake, not a kind.
Function Kinds(name: String, table: Value, found: (String, Value)[]) Throws UIError
    For key In table.Keys()
        Local value = table[key]
        If value != Null && value.IsObject && key == StateName(WidgetState.NORMAL)
            Throw UIError(
                "{name}.{key}: normal isn't a state; a name's own fields are its normal ones")
        End If
        If value == Null || !value.IsObject || StateNamed(key) != Null Then Continue
        If FieldNames().Contains(key) Then Throw UIError("{name}'s {key} is a field, not a table")
        Local kind = "{name}.{key}"
        found.Add((kind, value))
        Try Kinds(kind, value, found)
    End For
End Function

// `name`, then each name it's a kind of, then "default".
Function Lineage(name: String): String[]
    Local names: String[] = []
    Local at = name
    While at != ""
        names.Add(at)
        Local dot = at.FindLast(".")
        at = dot != Null ? at.Slice(0, dot) : ""
    End While
    If !names.Contains("default") Then names.Add("default")
    Return names
End Function

Function GoodName(name: String): Bool
    If name == "" Then Return False
    For part In name.Split(".")
        If part == "" Then Return False
    End For
    Return True
End Function

Function CheckName(call: String, name: String)
    If !GoodName(name) Then Panic("{call}: \"{name}\" isn't a style's name, which has no empty parts")
End Function

// A length a style's field takes: 0 or more, and finite.
Function GoodLength(length: Float32): Bool => length >= 0.0 && IsFinite(length)

Function CheckFields(call: String, set: StyleFields)
    For each In [set.BorderWidth, set.CornerRadius, set.FontSize]
        If each != Null && !GoodLength(each)
            Panic("{call}: a style's widths, radii, and sizes are 0 or more, not {each}")
        End If
    End For
    Local padding = set.Padding
    If padding != Null
        For side In [padding.Left, padding.Top, padding.Right, padding.Bottom]
            If !GoodLength(side) Then Panic("{call}: a style's padding is 0 or more, not {side}")
        End For
    End If
End Function

// The fields `set` sets, as Save writes them.
Function Written(table: Value, set: StyleFields)
    Local background = set.Background
    If background != Null Then table["background"] = Value(background.ToHex())
    Local foreground = set.Foreground
    If foreground != Null Then table["foreground"] = Value(foreground.ToHex())
    Local border = set.Border
    If border != Null Then table["border"] = Value(border.ToHex())
    Local width = set.BorderWidth
    If width != Null Then table["border_width"] = Number(width)
    Local radius = set.CornerRadius
    If radius != Null Then table["corner_radius"] = Number(radius)
    Local padding = set.Padding
    If padding != Null
        Local sides = Value.Array()
        For side In [padding.Left, padding.Top, padding.Right, padding.Bottom]
            sides.Add(Number(side))
        End For
        table["padding"] = sides
    End If
    Local font = set.Font
    If font != Null Then table["font"] = Value(font)
    Local size = set.FontSize
    If size != Null Then table["font_size"] = Number(size)
End Function

// A Float32 as TOML's number, in its own shortest form.
Function Number(value: Float32): Value
    Return Value(Double.Parse("{value}") ?? value As Double)
End Function

// The fields `had` set, with those `table` gives for the style `name` in their place, or Null when
// neither sets any; a table in it is a state's or a kind's, which aren't fields.
Function Changed(had: StyleFields?, name: String, table: Value): StyleFields? Throws UIError
    Local changed = had ?? StyleFields()
    Local any = had != Null
    For key In table.Keys()
        Local value = table[key]
        If value == Null || value.IsObject Then Continue
        any = True
        Select key
            Case "background"
                changed.Background = Try ColorIn(name, key, value)
            Case "foreground"
                changed.Foreground = Try ColorIn(name, key, value)
            Case "border"
                changed.Border = Try ColorIn(name, key, value)
            Case "border_width"
                changed.BorderWidth = Try LengthIn(name, key, value)
            Case "corner_radius"
                changed.CornerRadius = Try LengthIn(name, key, value)
            Case "font_size"
                changed.FontSize = Try LengthIn(name, key, value)
            Case "padding"
                changed.Padding = Try PaddingIn(name, value)
            Case "font"
                Local font = value.AsString()
                If font == Null Then Throw UIError("{name}'s font is a name, not {value}")
                changed.Font = font
            Default
                Throw UIError("{name} has no field {key}; a style's are background, foreground, " +
                              "border, border_width, corner_radius, padding, font, and font_size, " +
                              "and its states' tables, hovered, pressed, focused, and disabled")
        End Select
    End For
    Return any ? changed : Null
End Function

Function ColorIn(name: String, key: String, value: Value): Color Throws UIError
    Local text = value.AsString()
    Local color = text != Null ? Color.TryHex(text) : Null
    If color == Null Then Throw UIError("{name}'s {key} is a hex color, like \"#ff8800\", not {value}")
    Return color
End Function

Function LengthIn(name: String, key: String, value: Value): Float32 Throws UIError
    Local number = value.AsDouble()
    Local length = number != Null ? number As Float32 : -1.0
    If !GoodLength(length) Then Throw UIError("{name}'s {key} is a number of 0 or more, not {value}")
    Return length
End Function

Function PaddingIn(name: String, value: Value): Insets Throws UIError
    If !value.IsArray Then Return Insets.All(Try LengthIn(name, "padding", value))
    Local sides: Float32[] = []
    For index = 0 To value.Count - 1
        Local side = value[index]
        If side == Null Then Throw UIError("{name}'s padding is numbers")
        sides.Add(Try LengthIn(name, "padding", side))
    End For
    Select sides.Count
        Case 1
            Return Insets.All(sides[0])
        Case 2
            Return Insets.Symmetric(sides[0], sides[1])
        Case 4
            Return Insets(sides[0], sides[1], sides[2], sides[3])
        Default
            Throw UIError("{name}'s padding is one number, two, or four, not {sides.Count}")
    End Select
End Function
