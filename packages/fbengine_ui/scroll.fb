// Scrolling: a view of a column taller than it is, and a list of items to pick from.

Import std.collections
Import std.core
Import std.math
Import fbengine
Import "./controls"
Import "./layout"
Import "./painter"
Import "./widget"

/// A view of what's in it, its one child, which it lays out as tall as that wants and its own
/// width, and shows from Offset down: the wheel scrolls it, and ScrollIntoView brings a part of
/// it into view. A child outside the view isn't found by NodeAt, as it isn't drawn. While what it
/// shows is taller than it, a thumb at its right shows where it's scrolled to, which the pointer
/// drags, and a press beside the thumb brings the thumb there; the 8 units at its right are for
/// this, over what it shows: style "scroll", its thumb "scroll.thumb".
Public Class ScrollView Extends Widget
    Field offset: Float32 = 0.0
    // The offset asked for, which each Layout keeps to what it shows.
    Field wanted: Float32 = 0.0
    Field step: Float32 = 40.0
    Field extent: Float32 = 0.0
    Field view: Float32 = 0.0
    // How far down the thumb the pointer's holding it, or under 0 when it isn't.
    Field holding: Float32 = -1.0

    /// An empty view; Add gives it what it shows.
    @MainThread Public New(name: String = "")
        Super.New("scroll", name)
    End New

    /// How far down what it shows it's scrolled, in the UI's units.
    @MainThread Public Method Offset(): Float32 => offset

    /// Scrolls it to `units` down, kept to what it shows at each Layout, so an offset set before
    /// the first holds, and Inf keeps it at the bottom as what it shows grows, as a console's
    /// does.
    @MainThread Public Method SetOffset(units: Float32)
        Local asked = IsNaN(units) ? 0.0 : Max(units, 0.0)
        If asked == wanted && Kept(asked) == offset Then Return
        wanted = asked
        offset = Kept(asked)
        Reflow()
    End Method

    /// How far one of the wheel's notches scrolls it, 40 units at first.
    @MainThread Public Method SetWheelStep(units: Float32)
        If !(units > 0.0) Then Panic("ScrollView.SetWheelStep: a step is over 0, not {units}")
        step = units
    End Method

    /// The farthest it scrolls: how much taller what it shows is than it is, 0 when it fits.
    @MainThread Public Method MaxOffset(): Float32 => Max(extent - view, 0.0)

    /// Scrolls it as little as brings `box`, a part of what it shows, in the UI's units, into
    /// view: its top, if it's taller than the view.
    @MainThread Public Method ScrollIntoView(box: Rect)
        Local top = ContentBox().Y
        Local below = box.Y + box.Height - (top + view)
        If box.Y < top
            SetOffset(offset - (top - box.Y))
        ElseIf below > 0.0
            SetOffset(offset + Min(below, box.Y - top))
        End If
    End Method

    @MainThread Public Override Method ArrangeChildren(content: Rect)
        view = content.Height
        Local shown = Shown()
        extent = 0.0
        For child In shown
            Local tall = Max(child.NaturalSize().y + child.Margin().Vertical(), content.Height)
            extent = Max(extent, tall)
        End For
        offset = Kept(wanted)
        For child In shown
            Local margin = child.Margin()
            Local tall = Max(extent - margin.Vertical(), 0.0)
            child.Place(Rect(content.X + margin.Left, content.Y + margin.Top - offset,
                             Max(content.Width - margin.Horizontal(), 0.0), tall))
        End For
    End Method

    @MainThread Public Override Method DrawOver(paint: Painter)
        If MaxOffset() <= 0.0 Then Return
        Local content = ContentBox()
        paint.Panel(Rect(content.X + content.Width - 4.0, ThumbTop(), 4.0, ThumbTall()),
                    PartStyle("thumb"))
    End Method

    // The thumb's strip takes the pointer from what it shows.
    @MainThread Public Override Method NodeAt(point: Vec2): Node?
        If Visible() && OnStrip(point) Then Return Self
        Return Super.NodeAt(point)
    End Method

    @MainThread Public Override Method PointerDown(point: Vec2): Bool
        If !OnStrip(point) Then Return False
        Local top = ThumbTop()
        Local tall = ThumbTall()
        // On the thumb, it's held where it was pressed; beside it, it comes there, by its middle.
        holding = point.y >= top && point.y < top + tall ? point.y - top : tall / 2.0
        Dragged(point)
        Return True
    End Method

    @MainThread Public Override Method PointerDrag(point: Vec2)
        If holding >= 0.0 Then Dragged(point)
    End Method

    @MainThread Public Override Method PointerUp(point: Vec2, over: Bool)
        holding = -1.0
    End Method

    // Whether `point` is on the strip the thumb goes along, while it shows.
    @MainThread Method OnStrip(point: Vec2): Bool
        If MaxOffset() <= 0.0 Then Return False
        Local content = ContentBox()
        Return content.Contains(point) && point.x >= content.X + content.Width - 8.0
    End Method

    // How tall its thumb is, in proportion to how much it shows, but not too small to hold.
    @MainThread Method ThumbTall(): Float32 => Max(view * view / extent, Min(16.0, view))

    // Where its thumb's top is.
    @MainThread Method ThumbTop(): Float32
        Local farthest = MaxOffset()
        Return ContentBox().Y + (farthest > 0.0 ? (view - ThumbTall()) * offset / farthest : 0.0)
    End Method

    // Scrolls so the thumb's where the pointer holds it.
    @MainThread Method Dragged(point: Vec2)
        Local room = view - ThumbTall()
        If room <= 0.0 Then Return
        SetOffset((point.y - holding - ContentBox().Y) / room * MaxOffset())
    End Method

    // What it shows is only in its content box.
    @MainThread Public Override Method Clips(): Bool => True

    @MainThread Public Override Method Wheel(steps: Int32): Bool
        Local before = offset
        SetOffset(offset - (steps As Float32) * step)
        Return offset != before
    End Method

    // `units` kept from 0 to the farthest it scrolls.
    Method Kept(units: Float32): Float32 => IsNaN(units) ? 0.0 : Clamp(units, 0.0, MaxOffset())
End Class

/// One of a List's items, which a click picks: style "list.item", or "list.item.selected" while
/// it's the one picked.
Public Class ListItem Extends Label
    Field list: Weak<List>
    Field index: Int

    Package New(list: List, index: Int, text: String)
        Super.New(text)
        SetStyleName("list.item")
        Self.list = list
        Self.index = index
    End New

    /// Which of its list's items it is, from 0.
    @MainThread Public Method Index(): Int => index

    @MainThread Public Override Method PointerDown(point: Vec2): Bool
        Local own = list
        If own == Null Then Return False
        // The OS's double click, by its time and distance, chooses it, when its first press was on
        // it too.
        If MouseDoubleClick(MouseButton.LEFT) && own.pressedItem == index Then own.Choose()
        own.pressedItem = index
        own.Pick(index)
        Return True
    End Method
End Class

/// A column of items to pick one of, by a click, or by the arrows, Home, End, and the pages
/// while it has the focus; a double click, Return, or a gamepad's SOUTH chooses the one picked:
/// style "list". It scrolls the ScrollView it's in to show the one picked.
Public Class List Extends Widget
    Field items: String[] = []
    Field selected: Int = -1
    Field changed: Bool = False
    Field chosen: Bool = False
    // The item the last press was on, -1 for none.
    Field pressedItem: Int = -1

    /// A list of `items`, none picked.
    @MainThread Public New(items: String[] = [], name: String = "")
        Super.New("list", name)
        SetFocusable(True)
        SetItems(items)
    End New

    /// Its items' text.
    @MainThread Public Method Items(): String[] => items.Clone()

    /// Shows `shown`, keeping the item picked if it's still there, by its text; if it isn't, none
    /// is, and SelectionChanged is True.
    @MainThread Public Method SetItems(shown: String[])
        Local had = selected >= 0 ? items[selected] : Null
        items = shown.Clone()
        pressedItem = -1
        For child In Children()
            Remove(child)
        End For
        For i = 0 To items.Count - 1
            Local item = ListItem(Self, i, items[i])
            item.SetTranslates(Translates())
            Add(item)
        End For
        If had != Null
            selected = items.IndexOf(had) ?? -1
            If selected < 0 Then changed = True
        End If
        Restyled()
    End Method

    /// Sets whether its items are keys, as Widget.SetTranslates says, and each item with it.
    @MainThread Public Override Method SetTranslates(on: Bool)
        Super.SetTranslates(on)
        For child In Children()
            (child As? Widget)?.SetTranslates(on)
        End For
    End Method

    /// The item picked, from 0, or -1 for none.
    @MainThread Public Method Selected(): Int => selected

    /// Picks `index`, kept to its items, or none with -1; which isn't a change the player made, so
    /// SelectionChanged stays False.
    @MainThread Public Method SetSelected(index: Int)
        selected = items.Count == 0 || index < 0 ? -1 : Min(index, items.Count - 1)
        Restyled()
    End Method

    /// The picked item's text, "" for none.
    @MainThread Public Method SelectedText(): String => selected >= 0 ? items[selected] : ""

    /// Whether the last Ui.Update read the player pick another item.
    @MainThread Public Method SelectionChanged(): Bool => changed

    /// Whether the last Ui.Update read the player choose the one picked: a double click, Return,
    /// or a gamepad's SOUTH.
    @MainThread Public Method Chosen(): Bool => chosen

    @MainThread Public Override Method KeyTyped(stroke: Keystroke): Bool
        If items.Count == 0 Then Return False
        Local to = selected
        Select stroke.Key
            Case Key.UP
                to = Max(selected - 1, 0)
            Case Key.DOWN
                to = Min(selected + 1, items.Count - 1)
            Case Key.HOME
                to = 0
            Case Key.END
                to = items.Count - 1
            Case Key.PAGE_UP
                to = Max(selected - 10, 0)
            Case Key.PAGE_DOWN
                to = Min(selected + 10, items.Count - 1)
            Default
                Return False
        End Select
        // At an end, the key's the focus's, to move on past it.
        If to == selected Then Return False
        Pick(to)
        Return True
    End Method

    @MainThread Public Override Method Activate()
        If selected >= 0 Then Choose()
    End Method

    @MainThread Public Override Method Forget()
        changed = False
        chosen = False
    End Method

    // Picks `index` as the player does, and shows it in the ScrollView it's in.
    @MainThread Package Method Pick(index: Int)
        If index != selected
            selected = index
            changed = True
            Restyled()
        End If
        Local item = Item(index)
        If item == Null Then Return
        Local above = Parent()
        While above != Null
            Local view = above As? ScrollView
            If view != Null
                view.ScrollIntoView(item.Box())
                Return
            End If
            above = above.Parent()
        End While
    End Method

    @MainThread Package Method Choose()
        chosen = True
    End Method

    @MainThread Method Item(index: Int): ListItem?
        Local children = Children()
        Return index >= 0 && index < children.Count ? children[index] As? ListItem : Null
    End Method

    // Gives the picked item its own style.
    @MainThread Method Restyled()
        For child In Children()
            Local item = child As? ListItem
            If item != Null
                item.SetStyleName(item.Index() == selected ? "list.item.selected" : "list.item")
            End If
        End For
    End Method
End Class
