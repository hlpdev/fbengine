// What's kept between runs, in the user's folder for settings and not in a project, so it doesn't
// dirty a game's repository: which projects were open, and where the window was, for the editor;
// and for each project, by a hash of its path, what's open in it.

Import std.collections
Import std.core
Import std.crypto
Import std.data
Import std.io
Import std.os
Import std.text

// How many recent projects are kept.
Const RECENT = 8

// Whether `value` can be a window's place.
Function Fits(value: Int64): Bool => value >= -2147483648 && value <= 2147483647

// What's said yes to of the project at `path`: its folder, and its name and how it's built, so one
// that's been put there since, or whose [build] has changed, is asked about again.
Function TrustKey(path: String): String
    Local text = (Try? File.ReadText(Path(path) / "project.toml")) ?? ""
    Local read = Try? Toml.Read(text)
    Local says = text
    If read != Null Then says = "{read.Path("project.name")?.AsString() ?? ""}\n{read["build"] ?? Value()}"
    Return "{Folded(path)} {Hex.Encode(Sha256.Hash(says))}"
End Function

// `path` as it's compared: on Windows, whose files are found in any case, in one case. Another spelling
// of a folder on a Mac's or Linux's case-insensitive volume is asked about again, on the safe side.
Function Folded(path: String): String => System.Platform == Platform.WINDOWS ? path.ToLower() : path

/// The window's place and size as it was.
Public Struct WindowPlace
    Public Field X: Int32?
    Public Field Y: Int32?
    Public Field Width: Int32
    Public Field Height: Int32
End Struct

/// What's kept between runs. A file that can't be read, or has been changed to nonsense, is as if
/// it weren't there, and is left as it is, and TakeUnread says so, naming it, once; one that can't
/// be written is only not kept. A line of trusted.txt changed is a project asked about again.
Public Final Class Session
    // What's been said yes to, whether or not it could be kept.
    Field trusted: Set<String>
    Field folder: Path
    // Null when they can't be read, when nothing's kept in them.
    Field preferences: Preferences?
    // What couldn't be read, to be said, and every file that's been said of.
    Field unread: String[] = []
    Field told: Set<String>

    /// What's kept in `folder`, or the OS's folder for settings. It's an IOError if the OS doesn't
    /// say where that is.
    Public New(folder: Path? = Null) Throws IOError
        trusted = Set<String>()
        told = Set<String>()
        Local where = folder
        If where == Null
            Local config = Folders.Config
            If config == Null Then Throw IOError(IOErrorKind.NOT_FOUND,
                                                 "the OS has no folder for settings", "")
            where = Path(config) / "fbengine_editor"
        End If
        Self.folder = where
        Try
            preferences = Try Preferences("fbengine_editor", where)
        Catch error As IOError
            Unread(where / "fbengine_editor" / "preferences.txt", error.Message)
        End Try
    End New

    /// What's kept that couldn't be read, or was nonsense, since this was last asked, each as its
    /// file and why, once a file: each is as if it weren't there. What isn't there isn't one.
    Public Method TakeUnread(): String[]
        Local taken = unread
        unread = []
        Return taken
    End Method

    /// Says what Kept gave for the project at `path` was nonsense to what read it, as `why`, for
    /// TakeUnread to say.
    Package Method Refused(path: String, why: String)
        Unread(FileFor(path), why)
    End Method

    // `file` couldn't be read, as `why` says, which names it or doesn't.
    Method Unread(file: Path, why: String)
        If told.Contains(file.Text) Then Return
        told.Add(file.Text)
        unread.Add(why.Contains(file.Text) ? why : "{file}: {why}")
    End Method

    /// The projects opened lately, the last first, as their folders' paths.
    Public Method Recent(): String[]
        Local recent: String[] = []
        Local kept = preferences
        If kept == Null Then Return recent
        For i = 0 Until RECENT
            Local path = kept.Get("recent.{i}")
            If path != Null && path != "" Then recent.Add(path)
        End For
        Return recent
    End Method

    /// Puts `path` first in Recent.
    Public Method AddRecent(path: String)
        Local kept = preferences
        If kept == Null || path == "" Then Return
        Local recent = Recent()
        recent = recent.Filter(Function(each: String) => Folded(each) != Folded(path))
        recent.Insert(0, path)
        For i = 0 Until RECENT
            If i < recent.Count
                kept.Set("recent.{i}", recent[i])
            Else
                kept.Remove("recent.{i}")
            End If
        End For
        Try? kept.Save()
    End Method

    /// The window's place, as it last was, or a size of 1280 by 720, with no place.
    Public Method Window(): WindowPlace
        Local kept = preferences
        If kept == Null Then Return WindowPlace(Null, Null, 1280, 720)
        Local x = kept.GetInt("window.x")
        Local y = kept.GetInt("window.y")
        // A place past what a window's place can be is nonsense, not a place far away.
        If x == Null || y == Null || !Fits(x) || !Fits(y)
            x = Null
            y = Null
        End If
        Return WindowPlace(x != Null ? x As Int32 : Null, y != Null ? y As Int32 : Null,
                           Clamp(kept.GetInt("window.width", 1280), 320, 16384) As Int32,
                           Clamp(kept.GetInt("window.height", 720), 240, 16384) As Int32)
    End Method

    /// Keeps the window's place.
    Public Method SetWindow(x: Int32, y: Int32, width: Int32, height: Int32)
        Local kept = preferences
        If kept == Null Then Return
        kept.SetInt("window.x", x)
        kept.SetInt("window.y", y)
        kept.SetInt("window.width", width)
        kept.SetInt("window.height", height)
        Try? kept.Save()
    End Method

    /// Whether the person said the project at `path` may run its code: that folder, as it's named and
    /// built when they did.
    Public Method Trusted(path: String): Bool
        Local key = TrustKey(path)
        If trusted.Contains(key) Then Return True
        Local file = folder / "trusted.txt"
        If !File.Exists(file) Then Return False
        Try
            Return (Try File.ReadLines(file)).Contains(key)
        Catch error As IOError
            Unread(file, error.Message)
            Return False
        End Try
    End Method

    /// Says the project at `path` may run its code, from now on, kept whole or not at all. What it gives
    /// is why it couldn't be kept, or Null: it holds until this is gone, even so.
    Public Method Trust(path: String): String?
        If Trusted(path) Then Return Null
        Local key = TrustKey(path)
        trusted.Add(key)
        Local text = (Try? File.ReadText(folder / "trusted.txt")) ?? ""
        Try
            Try Dir.CreateAll(folder)
            Try File.WriteTextAtomic(folder / "trusted.txt", text + key + "\n")
        Catch error As IOError
            Return error.Message
        End Try
        Return Null
    End Method

    /// What's kept for the project at `path`, as Keep had it, or Null for none, or for what can't
    /// be read, which TakeUnread says.
    Public Method Kept(path: String): Value?
        Local file = FileFor(path)
        If !File.Exists(file) Then Return Null
        Local value = Value()
        Try
            value = Try Toml.Read(Try File.ReadText(file))
        Catch error As Error
            Unread(file, error.Message)
            Return Null
        End Try
        Local project = value["project"]?.AsString()
        Local kept = value["kept"]
        If project == Null || Folded(project) != Folded(path) || kept == Null ||
           kept.Kind != ValueKind.OBJECT
            Unread(file, "it isn't what's kept for {path}")
            Return Null
        End If
        Return kept
    End Method

    /// Keeps `value`, an Object, for the project at `path`, whole or not at all.
    Public Method Keep(path: String, value: Value)
        Local document = Value.Object()
        document["project"] = Value(path)
        document["kept"] = value
        Try? Dir.CreateAll(folder / "projects")
        Try? File.WriteTextAtomic(FileFor(path), Toml.Write(document))
    End Method

    Method FileFor(path: String): Path
        Local hash: Int64 = 7
        For byte In Folded(path).Bytes
            hash = (hash * 131 + (byte As Int64)) % 1000000000039
        End For
        Return folder / "projects" / "{hash}.toml"
    End Method
End Class
