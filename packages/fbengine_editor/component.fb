// A game's components as the editor has them: as data, kept on what's in the scene, and what kinds
// there are, which the game's own program says, as the editor can't run a game's code in itself.

Import std.collections
Import std.core
Import std.data
Import std.io
Import std.os
Import std.time
Import fbengine
Import "./history"

// What a game's program is, under its folder, and where it's told to write what it says.
Const COMPONENTS_PROGRAM = "components/main.fb"
Const DESCRIBE_TO = "FBENGINE_COMPONENTS_TO"
// The most it can say, in bytes, and of how many kinds, each of how many Fields.
Const MOST_SAID: Int64 = 1048576
Const MOST_KINDS = 1024

/// A component on an entity, as data: its kind's name, and what its Fields have, which are its kind's
/// first values until they're edited.
Public Final Class ComponentData
    /// What kind it is.
    Public ReadOnly Field Kind: String
    /// What's been set of its Fields.
    Public Field Values: Value

    /// One of the kind `kind`, with every Field at what it is at first.
    Public New(kind: ComponentKind)
        Kind = kind.Name
        Values = Value.Object()
        For field In kind.Fields
            Values[field.Name] = field.First.Clone()
        End For
    End New

    /// One of the kind called `kind`, with `values`, as what's saved of it, as a scene loading has.
    Public New(kind: String, values: Value)
        Kind = kind
        Values = values
    End New
End Class

// What the editor keeps on an entity with SetData, which goes as the entity does.
Final Class EntityComponents
    Package Field Items: ComponentData[] = []
End Class

/// What components `entity` has, in order, as a scene being saved reads them.
@MainThread @PanicsAtCaller
Public Function ComponentsOf(entity: Entity): ComponentData[]
    Local kept = entity.Data<EntityComponents>()
    Return kept != Null ? kept.Items.Clone() : []
End Function

/// Makes what components `entity` has `items`, in order, as a scene being loaded does.
@MainThread @PanicsAtCaller
Public Function SetComponentsOf(entity: Entity, items: ComponentData[])
    Local kept = EntityComponents()
    kept.Items = items.Clone()
    entity.SetData(kept)
End Function

// Gives `entity` what `from` has, as a copy of it, and what's under it what's under `from` has.
Package Function CopyComponents(from: Entity, entity: Entity)
    Local kept = from.Data<EntityComponents>()
    If kept != Null
        Local made = EntityComponents()
        For item In kept.Items
            made.Items.Add(ComponentData(item.Kind, item.Values.Clone()))
        End For
        entity.SetData(made)
    End If
    For i = 0 Until Min(from.ChildCount(), entity.ChildCount())
        CopyComponents(from.Child(i), entity.Child(i))
    End For
End Function

/// A component of one kind put on each entity without one, taken off again on undoing.
Public Final Class AddComponentEdit Extends Edit
    Field entities: Entity[]
    Field kind: ComponentKind
    Field added: (Entity, ComponentData)[] = []

    /// One of `adding` on each of `going` that hasn't one.
    Public New(going: Entity[], adding: ComponentKind)
        entities = going
        kind = adding
        Super.New("Add {adding.Name}")
    End New

    Public Override Method Apply() Throws IOError
        If added.Count == 0
            For entity In entities
                If entity.Freed() Then Continue
                Local has = False
                For item In ComponentsOf(entity)
                    If item.Kind == kind.Name Then has = True
                End For
                If !has Then added.Add((entity, ComponentData(kind)))
            End For
        End If
        For each In added
            If each.0.Freed() Then Continue
            Local kept = each.0.Data<EntityComponents>() ?? EntityComponents()
            kept.Items.Add(each.1)
            each.0.SetData(kept)
        End For
    End Method

    Public Override Method Undo() Throws IOError
        For each In added
            If each.0.Freed() Then Continue
            Local kept = each.0.Data<EntityComponents>()
            If kept != Null Then kept.Items = kept.Items.Filter(Function(item: ComponentData) => !RefEquals(item, each.1))
        End For
    End Method

    Public Override Method ChangesTree(): Bool => False
End Class

/// The component of a kind taken off each entity, each back in its place on undoing.
Public Final Class RemoveComponentEdit Extends Edit
    Field entities: Entity[]
    Field name: String
    Field removed: (Entity, ComponentData, Int)[] = []

    /// What's called `kind` off each of `going`.
    Public New(going: Entity[], kind: String)
        entities = going
        name = kind
        Super.New("Remove {kind}")
    End New

    Public Override Method Apply() Throws IOError
        removed = []
        For entity In entities
            If entity.Freed() Then Continue
            Local kept = entity.Data<EntityComponents>()
            If kept == Null Then Continue
            For i = 0 Until kept.Items.Count
                If kept.Items[i].Kind == name
                    removed.Add((entity, kept.Items[i], i))
                    kept.Items.RemoveAt(i)
                    Break
                End If
            End For
        End For
    End Method

    Public Override Method Undo() Throws IOError
        For each In removed
            If each.0.Freed() Then Continue
            Local kept = each.0.Data<EntityComponents>()
            If kept != Null Then kept.Items.Insert(Min(each.2, kept.Items.Count), each.1)
        End For
    End Method

    Public Override Method ChangesTree(): Bool => False
End Class

/// What kinds of component a game has: what its components/main.fb says, built by fb and run beside the
/// editor, with none if it has none. Update, each frame, sees to it finishing. Killing it ends its
/// program, which is why it's built and run apart, as `fb run` would leave it running.
Public Final Class GameComponents
    /// What it builds with, by its name on the PATH, or a path to it.
    Public Field Fb: String = "fb"
    /// How long, in seconds, its program can be built, which a first build of a game's packages can
    /// take a while for.
    Public Field BuildSeconds: Double = 600
    /// How long, in seconds, its program can run before it's stopped, and said to have failed.
    Public Field RunSeconds: Double = 30
    /// Whether the person's still to say a game's code may run, so nothing's known of it.
    Public Field HeldBack: Bool = False
    Field kinds: ComponentKind[] = []
    Field child: Child? = Null
    Field folder: TempDir? = Null
    Field failed: String? = Null
    Field changes: Int = 0
    Field building: Bool = False
    Field watch: Stopwatch
    Field game: Path? = Null

    /// One that knows of nothing yet.
    Public New()
        watch = Stopwatch.StartNew()
    End New

    /// Whether `at` has a program to say what it has.
    Public Static Method HasProgram(at: Path): Bool => File.Exists(at / COMPONENTS_PROGRAM)

    /// What it knows of, as of the last that finished.
    Public Method Kinds(): ComponentKind[] => kinds.Clone()

    /// The kind called `name`, or Null.
    Public Method Find(name: String): ComponentKind?
        For kind In kinds
            If kind.Name == name Then Return kind
        End For
        Return Null
    End Method

    /// How many times what it knows has changed.
    Public Method Changes(): Int => changes

    /// Whether its program's being built or run.
    Public Method Running(): Bool => child != Null

    /// Whether its program's been built and is running.
    Public Method ProgramRunning(): Bool => child != Null && !building

    /// What went wrong with its program, once, then Null.
    Public Method TakeFailure(): String?
        Local had = failed
        failed = Null
        Return had
    End Method

    /// Builds and runs `at`'s program in place of any that's going, knowing what it knows until that
    /// says otherwise. With none, it stays as it is. It's built by `fb`, which has to be on the PATH.
    Public Method Start(at: Path)
        Stop()
        HeldBack = False
        If !HasProgram(at) Then Return
        game = at
        Try
            Local temp = Try TempDir()
            folder = temp
            Local command = Command(Fb)
            command.Args(["--color", "never", "build", (at / COMPONENTS_PROGRAM).Text, "-o",
                          Program(temp).Text])
            Quietly(command, at)
            child = Try command.Spawn()
            building = True
            watch = Stopwatch.StartNew()
        Catch error As IOError
            failed = "Couldn't run fb on {at / COMPONENTS_PROGRAM}: {error.Message}"
            folder = Null
        End Try
    End Method

    /// Stops its program, knowing what it knows, and only then lets go of where it is.
    Public Method Stop()
        Local running = child
        child = Null
        building = False
        If running != Null
            Try
                Try running.Kill()
            Catch error As IOError
                // It's ended by itself.
            End Try
            running.Wait()
        End If
        folder = Null
    End Method

    /// Sees whether its program's built, or ended, or taken too long, and takes what it says.
    Public Method Update()
        Local running = child
        If running == Null Then Return
        Local ended = running.TryWait()
        If ended == Null
            If watch.Elapsed.TotalSeconds > (building ? BuildSeconds : RunSeconds)
                Local doing = building ? "being built" : "running"
                Stop()
                failed = "The game's {COMPONENTS_PROGRAM} was stopped, after too long {doing}"
            End If
            Return
        End If
        child = Null
        If building
            building = False
            If ended.Success
                Run()
            Else
                failed = "The game's {COMPONENTS_PROGRAM} wasn't built, which fb build says why of"
                folder = Null
            End If
            Return
        End If
        Try
            If !ended.Success Then Throw IOError(IOErrorKind.OTHER, "it ended with {ended}")
            Local temp = folder
            If temp != Null Then Set(Try Read(temp.Path / "kinds.json"))
        Catch error As IOError
            failed = "The game's {COMPONENTS_PROGRAM} didn't say its components: {error.Message}"
        Catch error As ParseError
            failed = "The game's {COMPONENTS_PROGRAM} didn't say its components: {error.Message}"
        End Try
        folder = Null
    End Method

    /// Knows of `known`, in place of what it knew.
    Public Method Set(known: ComponentKind[])
        kinds = known
        changes += 1
    End Method

    // Runs what's been built.
    Method Run()
        Local temp = folder
        Local at = game
        If temp == Null || at == Null Then Return
        Try
            Local command = Command(Program(temp).Text)
            command.Env(DESCRIBE_TO, (temp.Path / "kinds.json").Text)
            Quietly(command, at)
            child = Try command.Spawn()
            watch = Stopwatch.StartNew()
        Catch error As IOError
            failed = "Couldn't run the game's {COMPONENTS_PROGRAM}: {error.Message}"
            folder = Null
        End Try
    End Method

    // What's said in `file`, as long as it's in reason.
    Method Read(file: Path): ComponentKind[] Throws IOError, ParseError
        If (Try File.Size(file)) > MOST_SAID Then Throw IOError(IOErrorKind.OTHER,
                                                                "it said too much")
        Local said = Try Json.Read<ComponentKind[]>(Try File.ReadText(file))
        If said.Count > MOST_KINDS Then Throw IOError(IOErrorKind.OTHER, "it said too many kinds")
        For kind In said
            If kind.Fields.Count > MOST_KINDS Then Throw IOError(IOErrorKind.OTHER,
                                                                 "a kind has too many Fields")
        End For
        Return said
    End Method

    Method Program(temp: TempDir): Path
        Return temp.Path / (System.Platform == Platform.WINDOWS ? "components.exe" : "components")
    End Method

    Method Quietly(command: Command, at: Path)
        command.Folder(at.Text)
        command.Stdin(Stdio.NONE)
        command.Stdout(Stdio.NONE)
        command.Stderr(Stdio.NONE)
    End Method
End Class
