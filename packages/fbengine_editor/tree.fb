// The tree: a scene's entities in a pane, selected, opened and closed, renamed where they are, moved
// under each other by dragging, and found by name, each change through undo.

Import std.collections
Import std.core
Import std.math
Import std.text
Import fbengine
Import fbengine_ui
Import "./history"
Import "./scene"

// How far a row's indented under what it's in, how wide the part that opens and closes it is, and how
// far it's dragged before it's moving.
Const INDENT: Float32 = 14.0
Const OPENER: Float32 = 14.0
Const DRAGGED: Float32 = 6.0
// How high a row is.
Const ROW_HEIGHT: Float32 = 22.0

/// A scene's entities, what's under each shown unless it's closed: a click selects, with Shift adds
/// to that, a double click, or F2, renames in place, a drag takes what's selected to under what it's
/// let go on, or to the top of the scene on nothing, and the right button asks OnRowMenu. The arrows
/// move what's selected, close, and open. Typing in its field at the top shows only what's named
/// that, Return going to the next. Only the rows in view are made, each the same height, however
/// many there are. Update, each frame before the Ui's, sees to all that.
Public Final Class SceneTree Extends Widget
    Field scene: EditedScene
    Field history: History
    Field find: TextField
    Field scroller: ScrollView
    Field list: Node
    // What's above and below what's in view, as tall as what isn't made.
    Field above: Node
    Field below: Node
    Field lines: TreeLine[] = []
    Field rows: TreeRow[] = []
    Field first: Int = 0
    Field held: Weak<TreeRow>
    Field closed: Entity[] = []
    Field dirty: Bool = True
    // What a double click's to rename: at the next Update, as the press goes on to focus what it's on.
    Field pendingRename: Entity? = Null
    Field lastPressed: Entity? = Null
    Field focusingFind: Bool = False
    Field reselected: Bool = False
    Field scrolling: Bool = False
    Field finding: String = ""
    Field renaming: Entity? = Null
    Field field: TextField? = Null
    Field menu: (Func(Ui, Vec2))? = Null
    Field hint: Widget
    Field hinted: Weak<Ui>

    /// The tree of `seen`, whose edits go in `edits`.
    Public New(seen: EditedScene, edits: History)
        scene = seen
        history = edits
        find = TextField("", "Find by name", "tree.find")
        scroller = ScrollView("tree.scroller")
        list = Node("tree.list")
        above = Node("tree.above")
        below = Node("tree.below")
        hint = Widget("tree.hint", "tree.hint")
        Super.New("tree", "tree")
        SetFocusable(True)
        find.SetTranslates(False)
        Add(find)
        scroller.SetHeight(Sizing.Fill())
        list.SetGap(0.0)
        scroller.Add(list)
        Add(scroller)
        hint.SetAnchors(Anchors.Point(0.0, 0.0))
        Watching()
    End New

    /// Shows `seen` in place of what it showed: what it showed is gone, at once, as `seen`'s may be
    /// about to free it.
    Public Method SetScene(seen: EditedScene)
        Finished(False)
        scene = seen
        closed = []
        lastPressed = Null
        pendingRename = Null
        find.SetText("")
        finding = ""
        lines = []
        rows = []
        list.RemoveAll()
        Watching()
        MarkChanged()
    End Method

    /// Says what's in the scene may have changed, as the History does, so the next Update shows it.
    Public Method MarkChanged()
        dirty = True
    End Method

    /// Runs `handler` when a row's pressed with the right button, once it's selected.
    Public Method OnRowMenu(handler: (Func(Ui, Vec2))?)
        menu = handler
    End Method

    /// What it shows, in order, as their entities, in view or not.
    Public Method ShownEntities(): Entity[]
        Local shown: Entity[] = []
        For line In lines
            If !line.Entity.Freed() Then shown.Add(line.Entity)
        End For
        Return shown
    End Method

    /// How many rows it's made: those in view, whatever it shows.
    Public Method RowsMade(): Int => rows.Count

    /// The row of `entity`, or Null if it isn't in view.
    Public Method RowOf(entity: Entity): Widget?
        For row In rows
            If RefEquals(row.entity, entity) Then Return row
        End For
        Return Null
    End Method

    /// Whether what's under `entity` shows.
    Public Method IsOpen(entity: Entity): Bool
        For each In closed
            If RefEquals(each, entity) Then Return False
        End For
        Return True
    End Method

    /// Shows what's under `entity`, or doesn't.
    Public Method SetOpen(entity: Entity, open: Bool)
        If IsOpen(entity) == open Then Return
        If open
            closed = closed.Filter(Function(each: Entity) => !RefEquals(each, entity))
        Else
            closed.Add(entity)
        End If
        MarkChanged()
    End Method

    /// Puts the keyboard in its field, to find by name, by the next Update if it can't yet, as a pane
    /// just opened can't.
    Public Method FocusFind()
        Local ui = Owner()
        If ui != Null Then ui.Focus(find)
        Local focused = ui?.Focused()
        focusingFind = focused == Null || !RefEquals(focused, find)
    End Method

    /// The field it finds by.
    Public Method FindField(): TextField => find

    /// Whether a row's being renamed.
    Public Method Renaming(): Bool => field != Null

    /// The field a row's being renamed in, or Null.
    Public Method RenameField(): TextField? => field

    /// Shows a field on `entity`'s row, scrolled to it, holding its name, which Return, or going
    /// elsewhere, takes as its new name, and Escape leaves as it was; a rename going on finishes first.
    Public Method BeginRename(entity: Entity)
        Finished(True)
        If !scene.Has(entity) Then Return
        Reveal(entity)
        If dirty Then Rebuilt()
        ScrollTo(entity)
        Windowed(False)
        Local row = RowOf(entity)
        If row == Null
            // Its place isn't laid out yet.
            pendingRename = IndexOf(entity) >= 0 ? entity : Null
            Return
        End If
        Local editing = TextField(entity.Name(), "", "tree.rename")
        editing.SetTranslates(False)
        row.Add(editing)
        renaming = entity
        field = editing
        Owner()?.Focus(editing)
    End Method

    /// Renames `entity` by the next Update, as a press that's going on, or a pane just opened, would
    /// take the keyboard from it.
    Public Method RenameSoon(entity: Entity)
        pendingRename = entity
    End Method

    /// Shows what's changed, and sees to its field, what's found, and a rename, each frame before the
    /// Ui's Update, which lays out what's shown.
    Public Method Update()
        Local ui = Owner()
        // What's been freed by anything else has no row.
        For row In rows
            If row.entity.Freed() Then dirty = True
        End For
        Local going = renaming
        If dirty && going != Null Then Finished(!going.Freed())
        Renames(ui)
        If find.Text() != finding
            finding = find.Text()
            dirty = True
            // Found under what's closed, it's shown again where it is.
            If finding == "" Then reselected = True
        End If
        If reselected
            reselected = False
            Local selected = scene.Selected()
            If selected.Count > 0
                Reveal(selected[selected.Count - 1])
                scrolling = True
            End If
            If !dirty
                For row In rows
                    row.Styled(scene)
                End For
            End If
        End If
        If dirty
            Rebuilt()
        ElseIf scrolling
            // Where it is is known, as it's been laid out.
            scrolling = False
            Local selected = scene.Selected()
            If selected.Count > 0 Then ScrollTo(selected[selected.Count - 1])
        End If
        Windowed(False)
        Local asked = pendingRename
        If asked != Null
            pendingRename = Null
            BeginRename(asked)
        End If
        If focusingFind Then FocusFind()
        If find.Submitted() && lines.Count > 0 Then FindNext()
    End Method

    Public Override Method KeyTyped(stroke: Keystroke): Bool
        Rechecked()
        Local at = SelectedLine()
        Select stroke.Key
            Case Key.UP
                If lines.Count > 0 Then scene.SelectOnly(lines[Max(at - 1, 0)].Entity)
            Case Key.DOWN
                If lines.Count > 0 Then scene.SelectOnly(lines[Min(at + 1, lines.Count - 1)].Entity)
            Case Key.LEFT
                If at >= 0 Then SetOpen(lines[at].Entity, False)
            Case Key.RIGHT
                If at >= 0 Then SetOpen(lines[at].Entity, True)
            Default
                Return False
        End Select
        Return True
    End Method

    // A press on nothing selects nothing.
    Public Override Method PointerDown(point: Vec2): Bool
        scene.SelectOnly(Null)
        Return True
    End Method

    Package Method RowMenu(ui: Ui, point: Vec2)
        Local handler = menu
        If handler != Null Then handler(ui, point)
    End Method

    // A row's dragged to `point`: shows where what's selected would go, or nothing.
    Package Method DragOver(ui: Ui, point: Vec2)
        Local going = Going(point)
        If going == Null
            ui.ClosePopup(hint)
            Return
        End If
        Local box = scroller.Box()
        Local over = RowAt(point)
        If over != Null Then box = over.Box()
        hint.SetMargin(Insets(box.X, box.Y, 0.0, 0.0))
        hint.SetSize(box.Width, box.Height)
        hinted = ui
        If hint.Parent() == Null Then ui.OpenPopup(hint, PopupKind.TIP)
    End Method

    // A row's let go of at `point`.
    Package Method Dropped(ui: Ui, point: Vec2)
        ui.ClosePopup(hint)
        Local going = Going(point)
        If going == Null Then Return
        Local target = TargetAt(point)
        // What it went under shows.
        If target != Null Then SetOpen(target, True)
        history.Commit(ReparentEdit(scene, going, target))
    End Method

    // A row's drag was called off.
    Package Method DragCancelled(ui: Ui)
        ui.ClosePopup(hint)
    End Method

    // The row at `point`, or Null.
    Method RowAt(point: Vec2): TreeRow?
        For row In rows
            If row.Box().Contains(point) Then Return row
        End For
        Return Null
    End Method

    Method TargetAt(point: Vec2): Entity?
        Local row = RowAt(point)
        Return row != Null ? row.entity : Null
    End Method

    // What's selected that'd move if it's let go at `point`, Null off the tree: what it isn't in
    // already, nor in itself, as nothing can be under itself.
    Method Going(point: Vec2): Entity[]?
        If !scroller.Box().Contains(point) Then Return Null
        Local target = TargetAt(point)
        Local going: Entity[] = []
        For entity In scene.SelectedTops()
            If target != Null && Under(target, entity) Then Return Null
            Local parent = entity.Parent()
            Local there = target == Null ? parent == Null : parent != Null && RefEquals(parent,
                                                                                        target)
            If !there Then going.Add(entity)
        End For
        Return going.Count > 0 ? going : Null
    End Method

    // Whether `entity` is `above`, or under it.
    Method Under(entity: Entity, above: Entity): Bool
        Local at: Entity? = entity
        While at != Null
            If RefEquals(at, above) Then Return True
            at = at.Parent()
        End While
        Return False
    End Method

    Method Watching()
        scene.OnSelectionChanged(Function[Weak Self]()
            Local own = Self
            If own != Null Then own.reselected = True
        End Function)
    End Method

    // Opens what `entity` is in, so it shows, unless only what's found does.
    Method Reveal(entity: Entity)
        If finding != "" Then Return
        Local above = entity.Parent()
        While above != Null
            If !IsOpen(above)
                SetOpen(above, True)
            End If
            above = above.Parent()
        End While
    End Method

    Method FindNext()
        Rechecked()
        If lines.Count > 0 Then scene.SelectOnly(lines[(SelectedLine() + 1) % lines.Count].Entity)
    End Method

    // Which line the last of what's selected is, or -1.
    Method SelectedLine(): Int
        Local selected = scene.Selected()
        Return selected.Count > 0 ? IndexOf(selected[selected.Count - 1]) : -1
    End Method

    Method IndexOf(entity: Entity): Int
        For i = 0 Until lines.Count
            If RefEquals(lines[i].Entity, entity) Then Return i
        End For
        Return -1
    End Method

    // Shows lines again if one's been freed, which only those in view are checked for each frame.
    Method Rechecked()
        For line In lines
            If line.Entity.Freed()
                Rebuilt()
                Return
            End If
        End For
    End Method

    // Scrolls as little as brings `entity` into view.
    Method ScrollTo(entity: Entity)
        Local at = IndexOf(entity)
        If at < 0 Then Return
        Local top = (at As Float32) * ROW_HEIGHT
        Local view = scroller.Box().Height
        If top < scroller.Offset()
            scroller.SetOffset(top)
        ElseIf top + ROW_HEIGHT > scroller.Offset() + view
            scroller.SetOffset(top + ROW_HEIGHT - view)
        End If
    End Method

    Method Renames(ui: Ui?)
        Local editing = field
        Local entity = renaming
        If editing == Null || entity == Null || ui == Null Then Return
        Local focused = ui.Focused()
        Local elsewhere = focused == Null || !RefEquals(focused, editing)
        If ui.Back()
            Finished(False)
        ElseIf editing.Submitted() || elsewhere
            Finished(True)
        End If
    End Method

    Method Finished(keeping: Bool)
        Local editing = field
        Local entity = renaming
        field = Null
        renaming = Null
        If editing == Null || entity == Null Then Return
        // The keyboard comes back here, unless it went elsewhere by a click.
        Local ui = Owner()
        Local focused = ui?.Focused()
        Local had = focused != Null && RefEquals(focused, editing)
        editing.Parent()?.Remove(editing)
        If ui != Null && had Then ui.Focus(Self)
        Local name = editing.Text()
        If keeping && name != "" && name != entity.Name()
            history.Commit(RenameEdit(entity, name))
        End If
    End Method

    // Finds what it shows, which ends a drag.
    Method Rebuilt()
        dirty = False
        Local ui = hinted
        If ui != Null Then ui.ClosePopup(hint)
        hinted = Null
        lines = []
        For row In rows
            row.DragEnded()
        End For
        If finding != ""
            Local wanted = finding.ToLower()
            For entity In scene.Entities()
                If entity.Name().ToLower().Contains(wanted) Then lines.Add(TreeLine(entity, 0))
            End For
        Else
            For entity In scene.SiblingsOf(Null)
                Walked(entity, 0)
            End For
        End If
        Windowed(True)
    End Method

    Method Walked(entity: Entity, depth: Int)
        lines.Add(TreeLine(entity, depth))
        If !IsOpen(entity) Then Return
        For child In entity.Children()
            Walked(child, depth + 1)
        End For
    End Method

    // Makes the rows in view, keeping those there are; `again` when what's shown has changed. A row
    // being held stays where it is until it's let go, as the pointer's its.
    Method Windowed(again: Bool)
        Local view = scroller.Box().Height
        If view <= 0.0 Then view = Window.Open() ? Window.Height() As Float32 : 0.0
        Local count = Ceil(view / ROW_HEIGHT) As Int + 2
        Local start = Min(Floor(scroller.Offset() / ROW_HEIGHT) As Int, Max(lines.Count - count, 0))
        Local last = Min(start + count, lines.Count) - 1
        If !again && (held != Null || (start == first && last - start + 1 == rows.Count)) Then Return
        Local made: TreeRow[] = []
        For i = start To last
            Local line = lines[i]
            // Freed, the next Update finds what's there now.
            If line.Entity.Freed()
                dirty = True
                Continue
            End If
            Local row: TreeRow? = Null
            For each In rows
                If RefEquals(each.entity, line.Entity) && each.Depth() == line.Depth Then row = each
            End For
            Local shown = row ?? TreeRow(Self, line.Entity, line.Depth)
            shown.Styled(scene)
            made.Add(shown)
        End For
        first = start
        Local same = made.Count == rows.Count && list.Children().Count == rows.Count + 2
        For i = 0 Until made.Count
            If same && !RefEquals(made[i], rows[i]) Then same = False
        End For
        If same && above.Parent() != Null && !again Then Return
        rows = made
        above.SetHeight(Sizing.Fixed((start As Float32) * ROW_HEIGHT))
        below.SetHeight(Sizing.Fixed((Max(lines.Count - last - 1, 0) As Float32) * ROW_HEIGHT))
        If same Then Return
        list.RemoveAll()
        list.Add(above)
        For row In rows
            list.Add(row)
        End For
        list.Add(below)
    End Method

    Method Holding(row: TreeRow?)
        held = row
    End Method

    // Says `entity` was pressed; whether it was the last pressed before this, so a double click's all
    // on it.
    Package Method Pressed(entity: Entity): Bool
        Local last = lastPressed
        lastPressed = entity
        Return last != Null && RefEquals(last, entity)
    End Method

    Package Method IsSelected(entity: Entity): Bool => scene.IsSelected(entity)

    Package Method SelectAlone(entity: Entity)
        scene.SelectOnly(entity)
    End Method

    Package Method Toggle(entity: Entity)
        scene.ToggleSelected(entity)
    End Method
End Class

// What's shown on a line of the tree, made a row while it's in view.
Struct TreeLine
    Public Field Entity: Entity
    Public Field Depth: Int
End Struct

// What a row calls an entity: its name, or with none, what it is.
Function NameOf(entity: Entity): String
    Local name = entity.Name()
    Return name != "" ? name : "({entity.Kind()})"
End Function

// An entity in the tree.
Class TreeRow Extends Widget
    Package Field entity: Entity
    Field tree: Weak<SceneTree>
    Field depth: Int
    Field from: Vec2
    Field dragging: Bool = False
    // Whether the press was on what was selected already, so letting go selects only it.
    Field wasSelected: Bool = False
    Field opening: Bool = False
    // Whether Shift was down at the press.
    Field shifted: Bool = False
    // Whether its drag was ended, so it takes another press to begin one.
    Field ended: Bool = False

    New(owner: SceneTree, shown: Entity, indent: Int)
        entity = shown
        tree = owner
        depth = indent
        Super.New("tree.row", "tree.row")
        SetTranslates(False)
        SetHeight(Sizing.Fixed(ROW_HEIGHT))
    End New

    Package Method Depth(): Int => depth

    // What's shown changed under its drag.
    Package Method DragEnded()
        If dragging Then ended = True
        dragging = False
    End Method

    // Hidden itself, dim; hidden by what it's in, less so.
    Package Method Styled(scene: EditedScene)
        Local selected = scene.IsSelected(entity)
        If entity.Hidden()
            SetStyleName(selected ? "tree.row.selected.hidden" : "tree.row.hidden")
        ElseIf !entity.Showing()
            SetStyleName(selected ? "tree.row.selected.under" : "tree.row.under")
        Else
            SetStyleName(selected ? "tree.row.selected" : "tree.row")
        End If
    End Method

    Public Override Method Measure(): Vec2
        // Freed in this frame, it's gone by the next.
        If entity.Freed() Then Return Vec2(0, 0)
        Local size = TextSize(NameOf(entity))
        Return Vec2(Left() + size.x, size.y)
    End Method

    Public Override Method ArrangeChildren(content: Rect)
        Local left = Left()
        For child In Children()
            child.Place(Rect(content.X + left, content.Y, Max(content.Width - left, 0.0),
                             content.Height))
        End For
    End Method

    Public Override Method Draw(paint: Painter)
        Super.Draw(paint)
        If entity.Freed() Then Return
        Local box = ContentBox()
        If entity.ChildCount() > 0
            Local own = tree
            Local open = own == Null || own.IsOpen(entity)
            paint.TextIn(open ? "-" : "+",
                         Rect(box.X + (depth As Float32) * INDENT, box.Y, OPENER, box.Height),
                         CurrentStyle(), Align.START)
        End If
        If Children().Count > 0 Then Return
        Local left = Left()
        paint.TextIn(NameOf(entity),
                     Rect(box.X + left, box.Y, Max(box.Width - left, 0.0), box.Height),
                     CurrentStyle(),
                     Align.START)
    End Method

    Public Override Method PointerDown(point: Vec2): Bool
        Local own = tree
        If own == Null || entity.Freed() Then Return False
        from = point
        dragging = False
        ended = False
        opening = False
        own.Holding(Self)
        // Its opener.
        Local box = ContentBox()
        Local at = point.x - box.X - (depth As Float32) * INDENT
        If at >= 0.0 && at < OPENER && entity.ChildCount() > 0
            opening = True
            own.SetOpen(entity, !own.IsOpen(entity))
            Return True
        End If
        wasSelected = own.IsSelected(entity)
        shifted = KeyDown(Key.LEFT_SHIFT) || KeyDown(Key.RIGHT_SHIFT)
        If shifted
            own.Toggle(entity)
        ElseIf !wasSelected
            own.SelectAlone(entity)
        End If
        // Two quick clicks, each on another, aren't a double click on either.
        Local again = own.Pressed(entity)
        If !shifted && again && MouseDoubleClick(MouseButton.LEFT) Then own.RenameSoon(entity)
        Return True
    End Method

    Public Override Method PointerDownWith(button: MouseButton, point: Vec2): Bool
        Local own = tree
        Local ui = Owner()
        If button != MouseButton.RIGHT || own == Null || ui == Null || entity.Freed() Then Return False
        If !own.IsSelected(entity) Then own.SelectAlone(entity)
        own.RowMenu(ui, point)
        Return False
    End Method

    Public Override Method PointerDrag(point: Vec2)
        Local own = tree
        Local ui = Owner()
        If opening || ended || own == Null || ui == Null Then Return
        If !dragging && Distance(point, from) < DRAGGED Then Return
        dragging = True
        own.DragOver(ui, point)
    End Method

    Public Override Method PointerUp(point: Vec2, over: Bool)
        Local own = tree
        Local ui = Owner()
        If own == Null || ui == Null Then Return
        own.Holding(Null)
        If dragging
            dragging = False
            own.Dropped(ui, point)
        ElseIf over && wasSelected && !opening && !ended && !own.Renaming() && !shifted &&
               !entity.Freed()
            own.SelectAlone(entity)
        End If
    End Method

    // Called off, its drag goes nowhere.
    Public Override Method PointerCancelled(point: Vec2)
        Local own = tree
        Local ui = Owner()
        If own == Null || ui == Null Then Return
        own.Holding(Null)
        own.DragCancelled(ui)
    End Method

    Method Left(): Float32 => (depth As Float32) * INDENT + OPENER
End Class
