// Play in the editor: the game's own program, built by fb and run on the saved scene, in a process of
// its own, its output shown, stopped from here; nothing it does touches what's being edited.

Import std.collections
Import std.core
Import std.ffi
Import std.io
Import std.math
Import std.os
Import std.text
Import std.time
From fbengine_ui Import Label, Node, ScrollView, Sizing, Widget
Import fbengine
Import "./project"

// How many lines of what a run says are kept, and how long one can be, in bytes; how long what's ended
// waits for the last of its output, and how long stopping holds up a frame for it, in seconds; and how
// much of a stream is read at once, which is as much as it gets a frame.
Const MOST_LINES = 1000
// How high a line of it is, in the UI's units, and how much of one is shown: past that it's cut,
// with a marker, its whole text still the log's, so one very long line costs a frame no more.
Const LINE_HEIGHT: Float32 = 22.0
Const SHOWN_CHARS: Int = 300
Const CUT_MARKER = " …"
Const MOST_LINE_BYTES = 65536
Const LAST_OUTPUT: Float64 = 1.0
Const STOP_WAIT: Float64 = 0.05
Const CHUNK: Int64 = 65536
// How long a frame gives to reading what's coming fast, in seconds: a pipe gives what it holds, little
// at a read however much is asked for, and a frame's one read would keep a game waiting to print.
Const READ_WAIT: Float64 = 0.003
// How long closing a project or quitting waits for what's been killed.
Const STOP_NOW_WAIT: Float64 = 2.0

/// What a run's got to.
Public Enum PlayState
    /// Nothing's been run, or it's been cleared.
    IDLE
    /// fb's building it.
    BUILDING
    /// It's running.
    RUNNING
    /// It ended by itself, as ExitCode says.
    ENDED
    /// fb couldn't build it.
    BUILD_FAILED
    /// Something couldn't be started, as its output says.
    COULDNT_START
    /// It's been killed, and hasn't gone yet, or something it started has its output still.
    STOPPING
    /// It was stopped.
    STOPPED
End Enum

// What's come of a stream that hasn't ended its line.
Final Class Unfinished
    Package Field Bytes: UInt8[] = []
    // Whether what came last was a return, so a newline next is part of that line's end.
    Package Field AfterReturn: Bool = False
End Class

/// What a run says, as lines: bytes as they come, each stream's split at each line's end, a newline, a
/// return, or both, and what's too long for a line cut, what isn't UTF-8 shown as it can be, and only
/// the last so many kept.
Public Final Class OutputLog
    Field lines: String[] = []
    Field streams: Unfinished[]
    Field dropped: Int = 0
    Field added: Int = 0
    Field cleared: Int = 0
    Field most: Int

    /// A log keeping `most` lines.
    Public New(most: Int = MOST_LINES)
        Self.most = most
        streams = [Unfinished(), Unfinished()]
    End New

    /// What it's kept, oldest first.
    Public Method Lines(): String[] => lines.Clone()

    /// How many lines there have been, those it's let go of among them.
    Public Method Total(): Int => added

    /// How many times it's been emptied.
    Public Method Cleared(): Int => cleared

    /// How many lines it's let go of.
    Public Method Dropped(): Int => dropped

    /// How many bytes of the stream numbered `stream` haven't ended their line.
    Public Method Waiting(stream: Int = 0): Int => streams[stream].Bytes.Count

    /// Adds `count` of `bytes` of the stream numbered `stream`, 0 or 1, as much of them as ends a line.
    Public Method Feed(bytes: Buffer<UInt8>, count: Int64, stream: Int = 0)
        Local of = streams[stream]
        For at = 0 To count - 1
            Local byte = bytes[at]
            Local after = of.AfterReturn
            of.AfterReturn = False
            If byte == 10
                If !after Then Finish(of)
            ElseIf byte == 13
                Finish(of)
                of.AfterReturn = True
            Else
                of.Bytes.Add(byte)
                If of.Bytes.Count >= MOST_LINE_BYTES Then Cut(of)
            End If
        End For
    End Method

    /// Adds `line`, as a line of its own, after what's unfinished.
    Public Method Say(line: String)
        Flush()
        Added(line)
    End Method

    /// Ends what hasn't ended its line, as a stream that's closed has.
    Public Method Flush()
        For of In streams
            If of.Bytes.Count > 0 Then Finish(of)
            of.AfterReturn = False
        End For
    End Method

    /// Empties it.
    Public Method Clear()
        lines.Clear()
        For of In streams
            of.Bytes.Clear()
            of.AfterReturn = False
        End For
        dropped = 0
        added = 0
        cleared += 1
    End Method

    Method Finish(of: Unfinished)
        Added(Shown(of.Bytes))
        of.Bytes.Clear()
    End Method

    // A line as long as one gets, ended before a character that's only begun, which starts the next.
    Method Cut(of: Unfinished)
        Local bytes = of.Bytes
        Local start = bytes.Count - 1
        While start > 0 && start > bytes.Count - 4 && (bytes[start] & 192) == 128
            start -= 1
        End While
        Local lead = bytes[start]
        Local length = lead >= 240 ? 4 : (lead >= 224 ? 3 : (lead >= 192 ? 2 : 1))
        If start + length <= bytes.Count
            Finish(of)
            Return
        End If
        Local rest: UInt8[] = []
        For at = start Until bytes.Count
            rest.Add(bytes[at])
        End For
        While bytes.Count > start
            bytes.RemoveAt(bytes.Count - 1)
        End While
        Finish(of)
        of.Bytes = rest
    End Method

    Method Added(line: String)
        lines.Add(line)
        added += 1
        If lines.Count > most
            lines.RemoveAt(0)
            dropped += 1
        End If
    End Method
End Class

// `bytes` as text, each byte of what isn't UTF-8 past ASCII shown as U+FFFD.
Function Shown(bytes: UInt8[]): String
    Local text = String.FromUtf8(bytes)
    If text != Null Then Return text
    Local shown: UInt8[] = []
    For each In bytes
        If each < 128
            shown.Add(each)
        Else
            shown.Add(239)
            shown.Add(191)
            shown.Add(189)
        End If
    End For
    Return String.FromUtf8(shown) ?? ""
End Function

/// A run of a game: build, then its program, one process at a time, each piped to Log, and each ended
/// by Stop, so none goes on without it. Its Update, each frame, moves it on. A game's asked for the
/// scene by `--scene` and its res:// path, which Scene.Requested gives it.
Public Final Class GameRun
    /// What it's said.
    Public ReadOnly Field Log: OutputLog
    /// The fb it builds with, as GameComponents' is.
    Public Field Fb: String = "fb"
    Field child: Child? = Null
    Field state: PlayState = PlayState.IDLE
    Field code: Int64? = Null
    Field folder: Path? = Null
    Field program: Path? = Null
    Field scene: String = ""
    // How a process that's gone ended, while what it started may still have its output, and for how long.
    Field finished: ExitStatus? = Null
    Field draining: Stopwatch
    // How many of its pipes are still being read, and which of its processes those are of: a pipe
    // that something it started still holds is let go of, and what comes after is read and dropped.
    Field reading: Int = 0
    Field pumped: Int = 0
    // How many reads have brought something, and how many had by the last Update.
    Field reads: Int = 0
    Field readsBefore: Int = 0
    // What's to start once what's been killed has gone.
    Field nextProject: GameProject? = Null
    Field nextScene: String = ""
    Field stopFails: String? = Null

    Public New()
        Log = OutputLog()
        draining = Stopwatch.StartNew()
    End New

    /// What it's got to.
    Public Method State(): PlayState => state

    /// Whether a process of it may be going.
    Public Method Going(): Bool => state == PlayState.BUILDING || state == PlayState.RUNNING ||
                                   state == PlayState.STOPPING

    /// Makes each Stop fail, with `message`, as the OS might, or not, with Null, for a test.
    Public Method FailStoppingWith(message: String?)
        stopFails = message
    End Method

    /// How many reads of its processes' pipes there have been, each of what one held, for a test that
    /// what comes fast is read faster than once a frame.
    Public Method Reads(): Int => reads

    /// Where its program's built to, once it's started.
    Public Method Program(): Path? => program

    /// How its program ended by itself, or Null for one that didn't, as one that's going or stopped.
    Public Method ExitCode(): Int64? => code

    /// The OS's number for the process that's going, or Null.
    Public Method ProcessId(): Int64?
        Local going = child
        Return going != Null ? going.Id : Null
    End Method

    /// Builds the game in `project` and runs it on `sceneFile`, a res:// path, after stopping what's
    /// going: now, or by Update once that's gone. If what's going couldn't be stopped, which the log
    /// says, this does nothing, so nothing's left going without being known of.
    Public Method Start(project: GameProject, sceneFile: String)
        Stop()
        If state == PlayState.STOPPING
            nextProject = project
            nextScene = sceneFile
            Return
        End If
        If !Going() Then Begin(project, sceneFile)
    End Method

    Method Begin(project: GameProject, sceneFile: String)
        Log.Clear()
        code = Null
        folder = project.Folder
        scene = sceneFile
        Local built = project.Folder / "build" / "play" /
                      (project.Name + (System.Platform == Platform.WINDOWS ? ".exe" : ""))
        program = built
        Log.Say("Building {project.Name}…")
        Spawned(Command(Fb).Args(["--color", "never", "build", project.Folder.Text, "-o",
                                  built.Text]).Folder(project.Folder.Text),
                PlayState.BUILDING)
    End Method

    /// Kills what's going, and gives it a moment; if it, or what it started that has its output, needs
    /// longer, it's STOPPING, and Update ends that. It's left as it is if nothing's going, or if it
    /// can't be killed, which the log says, and what Start's waiting to start doesn't start.
    Public Method Stop()
        nextProject = Null
        If state == PlayState.STOPPING || !Going() Then Return
        Local going = child
        Try
            Local fails = stopFails
            If fails != Null Then Throw IOError(IOErrorKind.PERMISSION_DENIED, fails)
            If going != Null Then Try going.Kill()
        Catch error As IOError
            // Still going, as far as anyone can tell, so it's still shown as that.
            Log.Say("It couldn't be stopped: {error.Message}")
            Return
        End Try
        state = PlayState.STOPPING
        Local since = Stopwatch.StartNew()
        While state == PlayState.STOPPING && since.Elapsed.TotalSeconds < STOP_WAIT
            Update()
            If state != PlayState.STOPPING Then Break
            Scheduler.Main.Step()
            Sleep(1.Milliseconds)
        End While
    End Method

    /// Stops what's going, and waits for it as long as it's sensible to, as closing a project does,
    /// whose run has nothing to end it after.
    Public Method StopNow()
        Stop()
        Local since = Stopwatch.StartNew()
        While state == PlayState.STOPPING && since.Elapsed.TotalSeconds < STOP_NOW_WAIT
            Update()
            Scheduler.Main.Step()
            Sleep(1.Milliseconds)
        End While
    End Method

    /// Moves it on, never holding up a frame: from what's built to its program, from what's ended to how
    /// it did, and from what's been killed to its being gone.
    Public Method Update()
        ReadMore()
        Local going = child
        If going != Null
            Local ended = going.TryWait()
            If ended == Null Then Return
            child = Null
            finished = ended
            draining = Stopwatch.StartNew()
        End If
        Local status = finished
        If status == Null Then Return
        // Its pipes finish as what's ended has closed them, unless something it started holds them.
        If reading > 0 && draining.Elapsed.TotalSeconds < LAST_OUTPUT Then Return
        finished = Null
        pumped += 1
        reading = 0
        Log.Flush()
        Select state
            Case PlayState.STOPPING
                Log.Say("Stopped.")
                state = PlayState.STOPPED
                Local project = nextProject
                nextProject = Null
                If project != Null Then Begin(project, nextScene)
            Case PlayState.BUILDING
                If status.Success
                    Run()
                Else
                    Log.Say("It couldn't be built.")
                    state = PlayState.BUILD_FAILED
                End If
            Default
                code = status.Code
                Log.Say("It ended, with {status}.")
                state = PlayState.ENDED
        End Select
    End Method

    // The game's own program, on the scene, in its folder.
    Method Run()
        Local built = program
        Local home = folder
        If built == Null || home == Null Then Return
        Log.Say("Running {scene}…")
        Spawned(Command(built.Text).Args(["--scene", scene]).Folder(home.Text), PlayState.RUNNING)
    End Method

    // `command`, its output piped here, or the reason it can't start.
    Method Spawned(command: Command, next: PlayState)
        Try
            Local made =
                Try command.Stdin(Stdio.NONE).Stdout(Stdio.PIPED).Stderr(Stdio.PIPED).Spawn()
            child = made
            state = next
            Local out = made.Stdout
            Local err = made.Stderr
            If out != Null Then Pump(out, pumped, 0)
            If err != Null Then Pump(err, pumped, 1)
        Catch error As IOError
            Log.Say("It couldn't be started: {error.Message}")
            state = PlayState.COULDNT_START
        End Try
    End Method

    // Gives what's coming fast a little longer, and what's quiet nothing.
    Method ReadMore()
        If reading > 0 && reads != readsBefore
            Local since = Stopwatch.StartNew()
            While since.Elapsed.TotalSeconds < READ_WAIT
                Scheduler.Main.Step()
            End While
        End If
        readsBefore = reads
    End Method

    // Goes on reading `stream` until it closes, as it's written, at each Flip; once that's a process
    // that's gone, what it says is dropped, but it's still read, so what has it can finish.
    Async Method Pump(stream: ChildOutput, of: Int, number: Int)
        reading += 1
        Local bytes = Buffer<UInt8>(CHUNK)
        Try
            While True
                Local count = Await stream.ReadAsync(bytes)
                If count <= 0 Then Break
                reads += 1
                If of == pumped Then Log.Feed(bytes, count, number)
            End While
        Catch error As IOError
            If of == pumped Then Log.Say("Its output couldn't be read: {error.Message}")
        End Try
        If of == pumped Then reading -= 1
    End Method
End Class

// What the pane says of `state`.
Function HeadingOf(state: PlayState): String
    Select state
        Case PlayState.IDLE
            Return "Not run"
        Case PlayState.BUILDING
            Return "Building"
        Case PlayState.RUNNING
            Return "Running"
        Case PlayState.ENDED
            Return "Ended"
        Case PlayState.BUILD_FAILED
            Return "Couldn't be built"
        Case PlayState.COULDNT_START
            Return "Couldn't be started"
        Case PlayState.STOPPING
            Return "Stopping"
        Case PlayState.STOPPED
            Return "Stopped"
    End Select
End Function

/// `line` as the output pane shows it: whole, or its first SHOWN_CHARS characters and a marker.
Public Function ShownOf(line: String): String
    // A String's Length is its bytes, which are its characters at most.
    If line.Length <= SHOWN_CHARS Then Return line
    Local shown = ""
    Local count = 0
    For letter In line.Chars
        If count == SHOWN_CHARS Then Return shown + CUT_MARKER
        shown += "{letter}"
        count += 1
    End For
    Return shown
End Function

/// What a run says, in a pane: what it's got to, and its lines, the newest showing. Only the rows in
/// view are made, each a line high, between what stands for those above and below, so however much a
/// game says, a frame lays out only what fits.
Public Final Class OutputPane Extends Widget
    Field run: GameRun
    Field heading: Label
    Field scroller: ScrollView
    Field list: Node
    Field above: Node
    Field below: Node
    // The lines it holds, the log's, and the rows made of them, from the line `first` on.
    Field lines: String[] = []
    Field rows: Label[] = []
    Field first: Int = -1
    Field shown: Int = 0
    Field cleared: Int = 0

    /// The pane of `run`.
    Public New(shows: GameRun)
        run = shows
        heading = Label("", "output.state")
        scroller = ScrollView("output.scroller")
        list = Node("output.list")
        above = Node("output.above")
        below = Node("output.below")
        Super.New("pane", "pane.output")
        heading.SetTranslates(False)
        Add(heading)
        scroller.SetHeight(Sizing.Fill())
        scroller.Add(list)
        list.Add(above)
        list.Add(below)
        Add(scroller)
    End New

    /// What it holds, line by line, which it shows as it's scrolled.
    Public Method ShownLines(): String[] => lines.Clone()

    /// How many rows it's made, for a test that it makes only what fits.
    Public Method RowsMade(): Int => rows.Count

    /// What it says the run's got to.
    Public Method Heading(): String => heading.Text()

    /// Shows what's new, and the rows in view, as it's scrolled.
    Public Method Update()
        heading.SetText(HeadingOf(run.State()))
        Local log = run.Log
        // It follows what's new only if that's where it's been left, so what's above can be read.
        Local following = scroller.Offset() >= scroller.MaxOffset() - 1.0
        Local again = False
        If log.Cleared() != cleared
            following = True
            cleared = log.Cleared()
            shown = 0
            lines = []
            again = True
        End If
        Local total = log.Total()
        If total != shown
            lines = log.Lines()
            shown = total
            again = True
            If following Then scroller.SetOffset(Max((lines.Count As Float32) * LINE_HEIGHT - View(), 0.0))
        End If
        Windowed(again)
    End Method

    // How high its view is, or the window's before it's laid out.
    Method View(): Float32
        Local view = scroller.Box().Height
        If view <= 0.0 Then view = Window.Open() ? Window.Height() As Float32 : 0.0
        Return view
    End Method

    // Makes the rows in view, reusing those there are; `again` when what's held has changed.
    Method Windowed(again: Bool)
        Local count = Ceil(View() / LINE_HEIGHT) As Int + 2
        Local start = Min(Floor(scroller.Offset() / LINE_HEIGHT) As Int,
                          Max(lines.Count - count, 0))
        Local last = Min(start + count, lines.Count) - 1
        If !again && start == first && last - start + 1 == rows.Count Then Return
        first = start
        Local wanted = Max(last - start + 1, 0)
        While rows.Count < wanted
            Local row = Label("", "output.line")
            row.SetStyleName("output.line")
            row.SetTranslates(False)
            row.SetHeight(Sizing.Fixed(LINE_HEIGHT))
            rows.Add(row)
        End While
        While rows.Count > wanted
            rows.RemoveAt(rows.Count - 1)
        End While
        For i = 0 Until wanted
            rows[i].SetText(ShownOf(lines[start + i]))
        End For
        above.SetHeight(Sizing.Fixed((start As Float32) * LINE_HEIGHT))
        below.SetHeight(Sizing.Fixed((Max(lines.Count - last - 1, 0) As Float32) * LINE_HEIGHT))
        If list.Children().Count != rows.Count + 2
            list.RemoveAll()
            list.Add(above)
            For row In rows
                list.Add(row)
            End For
            list.Add(below)
        End If
    End Method
End Class
