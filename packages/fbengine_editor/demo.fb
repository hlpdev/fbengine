// A project and a scene of the editor's own, to show it with: what its --watch plays, and what its
// golden images are of, so neither needs a game.

Import std.core
Import std.image
Import std.io
Import std.math
Import fbengine
Import "./component"
Import "./editor"
Import "./handles"

Const TRIANGLE = "{{\"asset\":{{\"version\":\"2.0\"}},\"scene\":0,\"scenes\":[{{\"nodes\":[0]}}],\"nodes\":[{{\"name\":\"blade\",\"mesh\":0}}],\"meshes\":[{{\"primitives\":[{{\"attributes\":{{\"POSITION\":0}}}}]}}],\"accessors\":[{{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\",\"min\":[0,0,0],\"max\":[1,0,1]}}],\"bufferViews\":[{{\"buffer\":0,\"byteLength\":36}}],\"buffers\":[{{\"byteLength\":36,\"uri\":\"data:application/octet-stream;base64,AAAAAAAAAAAAAAAAAAAAAAAAAAAAAIA/AACAPwAAAAAAAAAA\"}}]}}"

// A door, as a game's own program would say one is.
Enum DemoSwing
    INWARD
    OUTWARD
End Enum

Class DemoDoor
    @Limits(0, 10)
    Public Field Speed: Float = 2.5
    Public Field Label: String = "front door"
    Public Field Locked: Bool = True
    Public Field Way: DemoSwing = DemoSwing.OUTWARD
End Class

/// What's in the demo's scene.
Public Struct DemoScene
    /// The floor.
    Public Field Floor: Entity
    /// A cube on it.
    Public Field Crate: Entity
    /// Another, under the first.
    Public Field Lid: Entity
    /// The light.
    Public Field Lamp: Entity
    /// A camera.
    Public Field Lens: Entity
    /// Something with nothing to show of itself, which a component's on.
    Public Field Hinge: Entity
End Struct

/// Makes a project in `folder` that needs nothing, with some files to show.
Public Function MakeDemoProject(folder: Path) Throws IOError
    Try Dir.CreateAll(folder / "assets" / "levels")
    Try File.WriteText(folder / "project.toml", "[project]\nname = \"demo\"\n")
    Local checks = Image(16, 16)
    For y = 0 Until 16
        For x = 0 Until 16
            checks[x, y] = (x / 4 + y / 4) % 2 == 0 ? Color32(190, 150, 90, 255) : Color32(70, 90,
                                                                                           120, 255)
        End For
    End For
    Try File.WriteBytes(folder / "assets" / "checks.png", Png.Encode(checks))
    Try File.WriteText(folder / "assets" / "notes.txt", "what's left to do\n")
    Try File.WriteText(folder / "assets" / "blade.gltf", TRIANGLE)
    Try File.WriteText(folder / "assets" / "levels" / "first.scene", "format = 1\n")
End Function

/// Fills `editor`'s scene: a floor, a crate with a lid on it, a light and a camera, with what a game's
/// program would say of a door, the crate being one.
@MainThread
Public Function FillDemoScene(editor: Editor): DemoScene
    Local floor = Mesh(Geometry.Cube())
    floor.SetName("Floor")
    floor.SetScale(Vec3(6, 0.1, 6))
    floor.SetMaterial(Material(Color(0.45, 0.47, 0.5)))
    Local crate = Mesh(Geometry.Cube())
    crate.SetName("Crate")
    crate.SetPosition(Vec3(-1.5, 1, 0.5))
    crate.SetRotation(Quat.FromAxisAngle(Vec3(0, 1, 0), 0.5))
    crate.SetMaterial(Material(Color(0.7, 0.42, 0.2)))
    Local lid = Mesh(Geometry.Cube(), crate)
    lid.SetName("Lid")
    lid.SetPosition(Vec3(0, 1.2, 0))
    lid.SetScale(Vec3(1, 0.2, 1))
    lid.SetMaterial(Material(Color(0.3, 0.55, 0.8)))
    Local lamp = Light(LightType.SPOT)
    lamp.SetName("Lamp")
    lamp.SetPosition(Vec3(3, 5, 2))
    lamp.PointAt(Vec3(0, 0, 0))
    lamp.SetIntensity(30)
    lamp.SetRange(20)
    Local lens = Camera()
    lens.SetName("Lens")
    lens.SetPosition(Vec3(4, 2, 4))
    lens.PointAt(Vec3(0, 1, 0))
    lens.Hide()
    Local hinge = Pivot()
    hinge.SetName("Hinge")
    hinge.SetPosition(Vec3(2, 0.5, -1))
    Components.Clear()
    Components.Add<DemoDoor>("Door")
    editor.Kinds.Set(Components.Kinds())
    Components.Clear()
    editor.Tree.MarkChanged()
    Return DemoScene(floor, crate, lid, lamp, lens, hinge)
End Function
