    Expect(DropPlace(Vec3(0, 5, 0), Vec3(0, -1, 0)) == Vec3(0, 0, 0))
End Function

// Wherever a model's mesh is, and however small, it's in its picture.
@Test
Function AModelsThumbnailIsFramedOnIt() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Try File.WriteText(game / "assets" / "far.gltf",
                       TRIANGLE.Replace("\"mesh\":0", "\"mesh\":0,\"translation\":[100,0,0]"))
    Try File.WriteText(game / "assets" / "tiny.gltf",
                       TRIANGLE.Replace("\"mesh\":0", "\"mesh\":0,\"scale\":[0.01,0.01,0.01]"))
