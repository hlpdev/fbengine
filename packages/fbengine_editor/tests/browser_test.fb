// The asset browser and scenes on disk, driven by Simulate's mouse and keys and by commands, offscreen:
// res:// as rows, thumbnails, a model dragged into the scene, import settings' sidecars through undo,
// what changes on disk seen, and scenes saved and opened.

Import std.collections
Import std.core
Import std.ffi
From std.image Import Image, Png
Import std.io
Import std.math
Import std.os
Import std.test
Import std.text
Import std.time
Import fbengine
Import fbengine_editor
Import fbengine_ui
Import "./watching"
Import "./written"

Function NoGpu(): Bool => Env.Get("FBENGINE_NO_GPU") == "1"

// A glTF of one triangle facing up: (0,0,0), (0,0,1), (1,0,0).
Const TRIANGLE = "{{\"asset\":{{\"version\":\"2.0\"}},\"scene\":0,\"scenes\":[{{\"nodes\":[0]}}],\"nodes\":[{{\"name\":\"blade\",\"mesh\":0}}],\"meshes\":[{{\"primitives\":[{{\"attributes\":{{\"POSITION\":0}}}}]}}],\"accessors\":[{{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\",\"min\":[0,0,0],\"max\":[1,0,1]}}],\"bufferViews\":[{{\"buffer\":0,\"byteLength\":36}}],\"buffers\":[{{\"byteLength\":36,\"uri\":\"data:application/octet-stream;base64,AAAAAAAAAAAAAAAAAAAAAAAAAAAAAIA/AACAPwAAAAAAAAAA\"}}]}}"

Function Picture(red: UInt8): UInt8[]
    Local image = Image(1, 1)
    image[0, 0] = Color32(red, 20, 30, 255)
    Return Png.Encode(image)
End Function

// A game's folder: a picture, a note, a picture's sidecar, and a folder with a model and what's broken.
Function Game(at: Path): Path Throws IOError
    Local folder = at / "game"
    Try Dir.CreateAll(folder / "assets" / "sub")
    Try File.WriteText(folder / "project.toml", "[project]\nname = \"game\"\nversion = \"0.1.0\"\n")
    Try File.WriteBytes(folder / "assets" / "wall.png", Picture(200))
    Try File.WriteText(folder / "assets" / "wall.png.toml", "quality = 3\n")
    Try File.WriteText(folder / "assets" / "note.txt", "hello")
    Try File.WriteText(folder / "assets" / "sub" / "ball.gltf", TRIANGLE)
    Try File.WriteText(folder / "assets" / "sub" / "bad.gltf", "this isn't one")
    Return folder
End Function

Function Started(settings: Path, folder: Path): Editor Throws IOError, GraphicsError
    Window.SetHeadless(True)
    Local editor = Try Editor(settings)
    Try editor.Start(folder)
    editor.Docked.Show("assets")
    editor.Step()
    editor.Step()
    If Dir.Exists(folder / "assets") Then Try WatcherStarted(folder / "assets", "res://")
    Return editor
End Function

Function Row(editor: Editor, path: String): Rect
    Local row = editor.Files.RowOf(path)
    If row == Null Then Panic("{path} has no row")
    Return row.Box()
End Function

Function ClickAt(editor: Editor, at: Vec2) Throws GraphicsError
    Try Simulate.MoveMouse(at.x, at.y)
    editor.Step()
    Try Simulate.Click(MouseButton.LEFT)
    editor.Step()
    editor.Step()
End Function

Function ClickOn(editor: Editor, name: String) Throws GraphicsError
    Try ClickAt(editor, Found(editor, name).Box().Center)
End Function

Function Found(editor: Editor, name: String): Node
    For popup In editor.Shown.Popups()
        Local there = popup.Find(name)
        If there != Null Then Return there
    End For
    Local found = editor.Shown.Root().Find(name)
    If found == Null Then Panic("there's no {name}")
    Return found
End Function

// Steps until `done`, for what a watcher tells of in its own time.
Function StepUntil(editor: Editor, done: Func(): Bool)
    Local since = Instant.Now()
    While !done() && (Instant.Now() - since) < 60.Seconds
        editor.Step()
        Sleep(5.Milliseconds)
    End While
    Expect(done(), "what it waited for never came")
End Function

@Test
Function ItsRowsAreResByFoldersThenFiles() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings.Path, Try Game(games.Path))
    Defer editor.Finish()
    // The folder first; a sidecar isn't a row of its own.
    Expect(editor.Files.ShownPaths() == ["res://sub", "res://note.txt", "res://wall.png"],
           "{editor.Files.ShownPaths()}")
    Try ClickAt(editor, Row(editor, "res://sub").Center)
    Expect(editor.Files.IsOpen("res://sub"))
    Expect(editor.Files.ShownPaths() ==
           ["res://sub", "res://sub/bad.gltf", "res://sub/ball.gltf", "res://note.txt",
            "res://wall.png"] ||
           editor.Files.ShownPaths() ==
           ["res://sub", "res://sub/ball.gltf", "res://sub/bad.gltf", "res://note.txt",
            "res://wall.png"],
           "{editor.Files.ShownPaths()}")
    // What's under it's further in, and closed again, it's gone.
    Expect(Found(editor, "assets.list").Children().Count == 5)
    Local sub = Row(editor, "res://sub")
    Try ClickAt(editor, sub.Center)
    Expect(editor.Files.ShownPaths().Count == 3 && !editor.Files.IsOpen("res://sub"))
    // Selected, one at a time.
    Try ClickAt(editor, Row(editor, "res://note.txt").Center)
    Expect(editor.Files.Selected() == "res://note.txt")
    Expect((editor.Files.RowOf("res://note.txt") As? Widget)?.StyleName() == "tree.row.selected")
    Try ClickAt(editor, Row(editor, "res://wall.png").Center)
    Expect(editor.Files.Selected() == "res://wall.png")
    Expect((editor.Files.RowOf("res://note.txt") As? Widget)?.StyleName() == "tree.row")
End Function

// An image is its own thumbnail, by its pixel; a model's seen in a world of its own, which leaves the
// scene's as it was; what can't be read, or has no picture, has none.
@Test
Function ThumbnailsAreOfWhatTheFilesAre() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings.Path, Try Game(games.Path))
    Defer editor.Finish()
    Local wall = Thumb(editor, "res://wall.png")
    If wall == Null
        Fail("a picture has a thumbnail")
        Return
    End If
    Expect(wall.Texture().ReadPixel(0, 0) == Color32(200, 20, 30, 255))
    Expect(editor.Files.RowOf("res://wall.png")?.Find("assets.thumb") != Null)
    Expect(editor.Files.RowOf("res://note.txt")?.Find("assets.thumb") == Null)
    Expect(editor.Files.ThumbOf("res://note.txt") == Null)
    Local stage = World.Current()
    Local before = editor.Edited.Stage.EntityCount()
    Local ball = Thumb(editor, "res://sub/ball.gltf")
    If ball == Null
        Fail("a model has a thumbnail")
        Return
    End If
    Expect(World.Current() == stage && editor.Edited.Stage.EntityCount() == before)
    // Of a size, and more than the clear color; the same one the next time.
    Local image = ball.Texture().ToImage()
    Expect(image.Width == 64 && image.Height == 64)
    Local drawn = 0
    For y = 0 To 63
        For x = 0 To 63
            If image[x, y] != image[0, 0] Then drawn += 1
        End For
    End For
    Expect(drawn > 40, "{drawn} pixels of the triangle")
    Expect(RefEquals(editor.Files.ThumbOf("res://sub/ball.gltf"), ball))
    Expect(Thumb(editor, "res://sub/bad.gltf") == Null)
End Function

// A model dragged to the scene is there, on the ground under the pointer, selected, through undo.
@Test
Function AModelDraggedIntoTheSceneIsPlacedThere() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings.Path, Try Game(games.Path))
    Defer editor.Finish()
    editor.Files.SetOpen("res://sub", True)
    editor.Step()
    editor.View.LookAt(Vec3(0, 0, 0), 10.0)
    editor.Step()
    Local from = Row(editor, "res://sub/ball.gltf").Center
    Local to = editor.View.Box().Center
    // A click, or let go short of the scene, adds nothing.
    Try Simulate.MoveMouse(from.x, from.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MoveMouse(from.x + 2.0, from.y)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    Expect(editor.Edited.Entities().Count == 0 && !editor.Edits.CanUndo())
    // Let go on the scene.
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MoveMouse(to.x, to.y)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    Local all = editor.Edited.Entities()
    Expect(all.Count == 2, "{all}")
    Local placed = all[0]
    Expect(placed.Name() == "ball" && all[1].Name() == "blade")
    Expect(editor.Edited.IsSelected(placed) && editor.Edits.UndoName() == "Add ball")
    // On the ground: y 0, where the ray from the pointer meets it.
    Local ray = editor.View.RayAt(to)
    If ray == Null
        Fail("the view has a ray")
        Return
    End If
    Local start, way = ray
    Local wanted = DropPlace(start, way)
    Expect(IsClose(wanted.y, 0.0, 0.001))
    Expect(IsClose(placed.Position(), wanted, 0.001))
    // Its mesh knows where it's from.
    Local mesh = all[1] As? Mesh
    Expect(mesh != Null && mesh.Geometry()?.Source() == "res://sub/ball.gltf#0")
    editor.Step()
    Expect(editor.Tree.RowOf(placed) != Null)
    Expect(editor.Actions.Run("edit.undo"))
    Expect(editor.Edited.Entities().Count == 0)
    Expect(editor.Actions.Run("edit.redo"))
    Expect(editor.Edited.Entities().Count == 2 && editor.Edited.IsSelected(placed))
    // On the browser itself, a picture, and one that can't be read, nothing, or says why.
    Local count = editor.Edited.Entities().Count
    Local back = Row(editor, "res://sub/ball.gltf").Center
    Try Simulate.MoveMouse(back.x, back.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MoveMouse(back.x + 20.0, back.y)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    Expect(editor.Edited.Entities().Count == count)
    Local wall = Row(editor, "res://wall.png").Center
    Try Simulate.MoveMouse(wall.x, wall.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MoveMouse(to.x, to.y)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    Expect(editor.Edited.Entities().Count == count)
    Expect(editor.ShowingDialog() == Null, "a picture isn't a model")
    Local bad = Row(editor, "res://sub/bad.gltf").Center
    Try Simulate.MoveMouse(bad.x, bad.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MoveMouse(to.x, to.y)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    editor.Step()
    Expect(editor.Edited.Entities().Count == count, "{editor.Edited.Entities()}")
    Expect(editor.ShowingDialog() != Null)
End Function

@Test
Function WhereAModelLands()
    Expect(DropPlace(Vec3(0, 10, 0), Normalize(Vec3(1, -1, 0))) == Vec3(10, 0, 0))
    // Going up or level, 8 along; and too far, the same.
    Expect(DropPlace(Vec3(0, 10, 0), Vec3(0, 1, 0)) == Vec3(0, 18, 0))
    Expect(DropPlace(Vec3(0, 10, 0), Vec3(1, 0, 0)) == Vec3(8, 10, 0))
    Expect(IsClose(DropPlace(Vec3(0, 10, 0), Normalize(Vec3(1000, -1, 0))).y, 10.0, 0.01))
    Expect(NameOf("res://a/b.c.glb") == "b.c" && NameOf("res://x") == "x")
End Function

Function Sidecar(games: TempDir): String? Throws IOError
    Local file = games.Path / "game" / "assets" / "wall.png.toml"
    Return File.Exists(file) ? Try File.ReadText(file) : Null
End Function

// What's selected's import settings: each a sidecar's line, what's at its default left out, what else
// it says kept, each through undo.
@Test
Function ImportSettingsAreEditedInTheSidecar() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings.Path, Try Game(games.Path))
    Defer editor.Finish()
    editor.Files.Choose("res://wall.png")
    editor.Step()
    editor.Step()
    Local srgb = Found(editor, "assets.srgb") As? Toggle
    Local quality = Found(editor, "assets.quality") As? Slider
    If srgb == Null || quality == Null
        Fail("an image has its settings")
        Return
    End If
    Expect(srgb.On() && quality.Value() == 3.0)
    srgb.Click()
    editor.Step()
    editor.Step()
    Expect((Try Sidecar(games)) == "quality = 3\nsrgb = false\n",
           "{(Try Sidecar(games)) ?? "none"}")
    Expect(!(Try Assets.ReadSettings<ImageSettings>("res://wall.png")).Srgb)
    Expect(editor.Files.Edits.UndoName() == "Import Settings" && !editor.Edits.Modified())
    // Back to the default, its line's gone.
    (Found(editor, "assets.srgb") As? Toggle)?.Click()
    editor.Step()
    Expect((Try Sidecar(games)) == "quality = 3\n", "{(Try Sidecar(games)) ?? "none"}")
    // Each kind of field, read back as what it says.
    (Found(editor, "assets.mipmaps") As? Toggle)?.Click()
    editor.Step()
    (Found(editor, "assets.alpha") As? Toggle)?.Click()
    editor.Step()
    (Found(editor, "assets.clamp_across") As? Toggle)?.Click()
    editor.Step()
    (Found(editor, "assets.clamp_down") As? Toggle)?.Click()
    editor.Step()
    (Found(editor, "assets.compression") As? Button)?.Click()
    editor.Step()
    Local read = Try Assets.ReadSettings<ImageSettings>("res://wall.png")
    Expect(!read.Mipmaps && read.Alpha && read.ClampAcross && read.ClampDown)
    Expect(read.Compression == ImageCompression.UASTC && read.Quality == 3)
    // By the keyboard, the slider's a step of 1, its change one, kept when it's let go of.
    Local slider = Found(editor, "assets.quality") As? Slider
    If slider == Null Then Panic("its slider")
    editor.Shown.Focus(slider)
    editor.Step()
    Try Simulate.PressKey(Key.RIGHT)
    editor.Step()
    editor.Step()
    Expect((Try Assets.ReadSettings<ImageSettings>("res://wall.png")).Quality == 4)
    // By the mouse, nothing till it's let go of, then one change.
    editor.Actions.Run("edit.undo")
    editor.Step()
    Local before = Try Sidecar(games)
    Local bar = Found(editor, "assets.quality").Box()
    Try Simulate.MoveMouse(bar.X + bar.Width * 0.5, bar.Center.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MoveMouse(bar.X + bar.Width * 0.25, bar.Center.y)
    editor.Step()
    editor.Step()
    Expect((Try Sidecar(games)) == before, "a slider that's held has changed nothing yet")
    Try Simulate.MoveMouse(bar.X + bar.Width * 0.76, bar.Center.y)
    editor.Step()
    editor.Step()
    Expect((Try Sidecar(games)) == before, "a slider that's held has changed nothing yet")
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    editor.Step()
    Expect((Try Assets.ReadSettings<ImageSettings>("res://wall.png")).Quality == 3)
    // Undone, each back, to the file as it first was.
    While editor.Files.Edits.CanUndo()
        editor.Actions.Run("edit.undo")
    End While
    Expect((Try Sidecar(games)) == "quality = 3\n", "{(Try Sidecar(games)) ?? "none"}")
    // A file with no sidecar: its first change makes it, and undoing takes it away.
    editor.Files.Choose("res://wall.png")
    Try File.Delete(games.Path / "game" / "assets" / "wall.png.toml")
    editor.Files.Choose(Null)
    editor.Files.Choose("res://wall.png")
    editor.Step()
    (Found(editor, "assets.alpha") As? Toggle)?.Click()
    editor.Step()
    Expect((Try Sidecar(games)) == "alpha = true\n")
    editor.Actions.Run("edit.undo")
    Expect((Try Sidecar(games)) == Null)
    // One that isn't TOML says so, and nothing to change it with breaks it.
    Try File.WriteText(games.Path / "game" / "assets" / "wall.png.toml", "= nonsense")
    editor.Files.Choose(Null)
    editor.Files.Choose("res://wall.png")
    editor.Step()
    Expect(editor.Files.Problem() != "")
    Expect((Try Sidecar(games)) == "= nonsense")
    // A model's and a note's: its own, and none.
    Try File.Delete(games.Path / "game" / "assets" / "wall.png.toml")
    editor.Files.SetOpen("res://sub", True)
    editor.Step()
    editor.Files.Choose("res://sub/ball.gltf")
    editor.Step()
    Expect((Found(editor, "assets.optimize") As? Toggle)?.On() == True)
    editor.Files.Choose("res://note.txt")
    editor.Step()
    Expect(!Found(editor, "assets.settings").Visible())
End Function

// How many of `image`'s pixels aren't what its corner is.
Function Differing(image: Image): Int
    Local count = 0
    For y = 0 To image.Height - 1
        For x = 0 To image.Width - 1
            If image[x, y] != image[0, 0] Then count += 1
        End For
    End For
    Return count
End Function

// A file that's changed, new, or gone on disk shows.
@Test
Function WhatChangesOnDiskIsSeen() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings.Path, Try Game(games.Path))
    Defer editor.Finish()
    Local assets = games.Path / "game" / "assets"
    Local thumb = Thumb(editor, "res://wall.png")
    If thumb == Null Then Panic("a picture's thumbnail")
    Expect(thumb.Texture().ReadPixel(0, 0) == Color32(200, 20, 30, 255))
    PastALook(editor)
    Try WriteChanged(assets / "wall.png", Picture(90))
    StepUntil(editor, Function() => RowPixel(editor, "res://wall.png") == Color32(90, 20, 30, 255))
    Expect(RowPixel(editor, "res://wall.png") == Color32(90, 20, 30, 255))
    // New, and gone.
    Try File.WriteText(assets / "new.txt", "new")
    StepUntil(editor, Function() => editor.Files.RowOf("res://new.txt") != Null)
    Expect(editor.Files.RowOf("res://new.txt") != Null)
    editor.Files.Choose("res://new.txt")
    Try File.Delete(assets / "new.txt")
    StepUntil(editor, Function() => editor.Files.RowOf("res://new.txt") == Null)
    Expect(editor.Files.RowOf("res://new.txt") == Null && editor.Files.Selected() == Null)
    // A model dropped goes on being its file's: changed, what's under the spawn's made again.
    editor.Files.SetOpen("res://sub", True)
    editor.Step()
    editor.View.LookAt(Vec3(0, 0, 0), 10.0)
    editor.Step()
    Local from = Row(editor, "res://sub/ball.gltf").Center
    Local to = editor.View.Box().Center
    Try Simulate.MoveMouse(from.x, from.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MoveMouse(to.x, to.y)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    Local placed = editor.Edited.Entities()[0]
    Local reloads = editor.Files.Reloads()
    Try WriteChangedText(assets / "sub" / "ball.gltf", TRIANGLE.Replace("\"blade\"", "\"sharper\""))
    StepUntil(editor, Function() => editor.Files.Reloads() > reloads)
    Expect(placed.ChildCount() == 1 && placed.Child(0).Name() == "sharper")
    // Its thumbnail's the file's as it is now: the triangle turned away from above is none of it drawn.
    Local seen = Thumb(editor, "res://sub/ball.gltf")
    If seen == Null Then Panic("a model's thumbnail")
    Expect(Differing(seen.Texture().ToImage()) > 40)
    reloads = editor.Files.Reloads()
    Try WriteChangedText(assets / "sub" / "ball.gltf",
                         TRIANGLE.Replace("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAIA/AACAPwAAAAAAAAAA",
                                          "AAAAAAAAAAAAAAAAAACAPwAAAAAAAAAAAAAAAAAAAAAAAIA/"))
    StepUntil(editor, Function() => editor.Files.Reloads() > reloads)
    Local after = Thumb(editor, "res://sub/ball.gltf")
    If after == Null Then Panic("a model's thumbnail")
    Expect(Differing(after.Texture().ToImage()) == 0)
    // Its folder let go of, a project closed, nothing's watched or held.
    editor.CloseProject()
    Expect(editor.Files.ShownPaths().Count == 0)
End Function

Function Text(file: Path): String Throws IOError => Try File.ReadText(file)

// Saved whole, in folders it makes, without what's the editor's; opened again as it was, with nothing
// to undo; kept between runs.
@Test
Function ScenesAreSavedAndOpened() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local editor = Try Started(settings.Path, game)
    Expect(editor.SceneFile() == Null)
    Expect(editor.Actions.Run("add.cube"))
    Local cube = editor.Edited.Entities()[0]
    cube.SetPosition(Vec3(1.5, 0.25, -2))
    Expect(editor.Edits.Modified())
    // With no file yet, Save asks where.
    Expect(editor.Actions.Run("file.save"))
    editor.Step()
    Expect(editor.ShowingDialog() != Null)
    Local field = Found(editor, "dialog.path") As? TextField
    If field == Null Then Panic("its field")
    field.SetText("res://levels/first.scene")
    Try ClickOn(editor, "dialog.Save")
    Local file = game / "assets" / "levels" / "first.scene"
    Expect(File.Exists(file))
    Expect(!editor.Edits.Modified() && editor.SceneFile() == "res://levels/first.scene")
    Local text = Try Text(file)
    Expect(text.Contains(
        "path = \"Cube\"\nkind = \"MESH\"\nname = \"Cube\"\nposition = [1.5, 0.25, -2.0]"))
    Expect(!text.Contains("editor"), "the editor's own was saved")
    // What's changed and saved again, with the command's keys.
    editor.Edits.Commit(RenameEdit(cube, "Crate"))
    Expect(editor.Edits.Modified())
    Expect(editor.Actions.Run("file.save"))
    Expect(!editor.Edits.Modified() && (Try Text(file)).Contains("name = \"Crate\""))
    // New, with what's changed asked about first, then what's there gone.
    Expect(editor.Actions.Run("file.new_scene"))
    editor.Step()
    Expect(editor.ShowingDialog() == Null && editor.Edited.Entities().Count == 0 &&
           editor.SceneFile() == Null)
    // A double click on its row opens it, as it was.
    editor.Step()
    editor.Files.SetOpen("res://levels", True)
    StepUntil(editor, Function() => editor.Files.RowOf("res://levels") != Null)
    editor.Files.SetOpen("res://levels", True)
    editor.Step()
    Local row = Row(editor, "res://levels/first.scene").Center
    Try Simulate.MoveMouse(row.x, row.y)
    editor.Step()
    Try Simulate.Click(MouseButton.LEFT, clicks: 1)
    editor.Step()
    Try Simulate.Click(MouseButton.LEFT, clicks: 2)
    editor.Step()
    editor.Step()
    Expect(editor.SceneFile() == "res://levels/first.scene", "{editor.SceneFile() ?? "none"}")
    Local all = editor.Edited.Entities()
    Expect(all.Count == 1 && all[0].Name() == "Crate" && all[0].Position() == Vec3(1.5, 0.25, -2))
    Expect((all[0] As? Mesh)?.Geometry()?.Source() == "builtin:cube")
    Expect(World.Current() == editor.Edited.Stage && !editor.Edits.CanUndo() &&
           !editor.Edits.Modified())
    // Saved to the byte as it was read.
    editor.Actions.Run("file.save")
    Expect((Try Text(file)) == (text.Replace("\"Cube\"", "\"Crate\"")))
    // Changed, an open asks; Cancel leaves it; Don't Save goes on.
    editor.Edits.Commit(RenameEdit(all[0], "Changed"))
    Expect(editor.Actions.Run("file.new_scene"))
    editor.Step()
    Expect(editor.ShowingDialog() != Null)
    Try ClickOn(editor, "dialog.Cancel")
    Expect(editor.Edited.Entities()[0].Name() == "Changed" && editor.SceneFile() != Null)
    Expect(editor.Actions.Run("file.new_scene"))
    editor.Step()
    Try ClickOn(editor, "dialog.Save")
    Expect((Try Text(file)).Contains("name = \"Changed\"") && editor.Edited.Entities().Count == 0)
    editor.OpenScene("res://levels/first.scene")
    editor.Edits.Commit(RenameEdit(editor.Edited.Entities()[0], "Lost"))
    Expect(editor.Actions.Run("file.new_scene"))
    editor.Step()
    Try ClickOn(editor, "dialog.Don't Save")
    Expect(editor.Edited.Entities().Count == 0 && !(Try Text(file)).Contains("Lost"))
    // A scene that's kept is opened with its project next time.
    editor.OpenScene("res://levels/first.scene")
    editor.Finish()
    Local again = Try Started(settings.Path, game)
    Defer again.Finish()
    Expect(again.SceneFile() == "res://levels/first.scene")
    Expect(again.Edited.Entities()[0].Name() == "Changed")
End Function

// What can't be opened says why and leaves what's being edited; what can't be saved says why and
// leaves the file.
@Test
Function WhatCantBeReadOrWrittenChangesNothing() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    Expect(editor.Actions.Run("add.cube"))
    Local stage = editor.Edited.Stage
    Try File.WriteText(game / "assets" / "bad.scene",
                       "format = 1\n[[entity]]\npath = \"a\"\nkind = \"DRAGON\"\n")
    editor.OpenScene("res://bad.scene")
    editor.Step()
    Expect(editor.ShowingDialog() != Null)
    Expect(editor.Edited.Stage == stage && editor.Edited.Entities().Count == 1)
    Expect(World.Current() == stage && editor.SceneFile() == Null && editor.Edits.CanUndo())
    Try Simulate.PressKey(Key.ESCAPE)
    editor.Step()
    editor.OpenScene("res://none.scene")
    editor.Step()
    Expect(editor.ShowingDialog() != Null && editor.Edited.Entities().Count == 1)
    Try Simulate.PressKey(Key.ESCAPE)
    editor.Step()
    // A plane can't be held: nothing's written.
    editor.SaveScene("res://good.scene")
    Local had = Try Text(game / "assets" / "good.scene")
    Local ground = GroundPlane()
    ground.SetName("ground")
    editor.SaveScene()
    editor.Step()
    Expect(editor.ShowingDialog() != Null)
    Expect((Try Text(game / "assets" / "good.scene")) == had)
    ground.Free()
    // A path that isn't one.
    Try Simulate.PressKey(Key.ESCAPE)
    editor.Step()
    editor.SaveScene("not a res path")
    editor.Step()
    Expect(editor.ShowingDialog() != Null && editor.SceneFile() == "res://good.scene")
End Function

Global mangleState: Int64 = 1

// Park and Miller's, from a seed of 1 or more.
Function MangleNext(n: Int): Int
    mangleState = mangleState * 48271 % 2147483647
    Return (mangleState % n) As Int
End Function

// A scene file as a person or a merge can leave it, by its characters.
Function MangledScene(saved: String): String
    Local chars: String[] = []
    For each In saved.Graphemes()
        chars.Add(each)
    End For
    Local pieces = ["[[entity]]", "\"", "]", "=", "\n", "nan", "1e39", "-1",
                    "geometry = \"res://sub/ball.gltf#5\"", "geometry = \"res://sub/ball.gltf#-1\"",
                    "geometry = \"res://sub/ball.gltf#99999999999\"",
                    "geometry = \"res://sub/bad.gltf#0\"",
                    "geometry = \"res://sub/ball.gltf\"", "geometry = \"res://#\"",
                    "kind = \"MESH\"",
                    "path = \"Cube/Cube\"", "<<<<<<< HEAD"]
    For change = 1 To 1 + MangleNext(3)
        Local at = MangleNext(chars.Count + 1)
        If MangleNext(3) == 0 && at < chars.Count
            For cut = 1 To 1 + MangleNext(12)
                If at < chars.Count Then chars.RemoveAt(at)
            End For
        Else
            chars.Insert(at, pieces[MangleNext(pieces.Count)])
        End If
    End For
    Return "".Join(chars)
End Function

// Mangled scenes, opened one after another: each opens, or says why in a dialog and leaves what's
// being edited as it was; never a panic.
@Test
Function MangledScenesOpenOrSayWhy() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    Expect(editor.Actions.Run("add.cube"))
    Expect(editor.Actions.Run("add.light"))
    editor.SaveScene("res://saved.scene")
    editor.Step()
    Local saved = Try Text(game / "assets" / "saved.scene")
    mangleState = 1234
    Local opened = 0
    Local refused = 0
    For round = 1 To 40
        Try File.WriteText(game / "assets" / "mangled.scene", MangledScene(saved))
        Local before = editor.Edited.Entities().Count
        editor.OpenScene("res://mangled.scene")
        editor.Step()
        If editor.ShowingDialog() != Null
            Local opening = editor.SceneFile() == "res://mangled.scene"
            If !opening
                refused += 1
                Expect(editor.Edited.Entities().Count == before,
                       "round {round} changed what's edited")
            Else
                // Opened, with what was lost said.
                opened += 1
            End If
            Try Simulate.PressKey(Key.ESCAPE)
            editor.Step()
        Else
            opened += 1
        End If
        editor.Step()
    End For
    Expect(opened > 0 && refused > 0, "{opened} opened, {refused} refused")
End Function

// A model's saved by where it's from, each thing under it by its path, and read back from it; so with
// the editor gone a game's Scene.Load gives the same.
@Test
Function AGameReadsWhatTheEditorSaved() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local editor = Try Started(settings.Path, game)
    editor.Files.SetOpen("res://sub", True)
    editor.Step()
    editor.View.LookAt(Vec3(0, 0, 0), 10.0)
    editor.Step()
    Local from = Row(editor, "res://sub/ball.gltf").Center
    Local to = editor.View.Box().Center
    Try Simulate.MoveMouse(from.x, from.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MoveMouse(to.x, to.y)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    Local place = editor.Edited.Entities()[0].Position()
    editor.SaveScene("res://level.scene")
    Local text = Try Text(game / "assets" / "level.scene")
    Expect(text.Contains("geometry = \"res://sub/ball.gltf#0\""), text)
    Expect(text.Contains("path = \"ball/blade\""), text)
    editor.Finish()
    Window.SetHeadless(True)
    Try Graphics(320, 200)
    Defer EndGraphics()
    Local mount = Assets.MountFolder("res://", game / "assets")
    Defer Assets.Unmount(mount)
    Local world = World()
    World.SetCurrent(world)
    Defer world.Free()
    Local roots = Try Scene.Load("res://level.scene")
    Expect(roots.Count == 1 && roots[0].Name() == "ball" && roots[0].Position() == place)
    Local blade = roots[0].Child(0) As? Mesh
    If blade == Null Then Panic("its mesh")
    Expect(blade.Name() == "blade" && blade.Geometry()?.Source() == "res://sub/ball.gltf#0")
    Expect(blade.Geometry()?.Surface(0)?.VertexCount() == 3)
End Function

// The thumbnail of `path`, once it's made.
Function Thumb(editor: Editor, path: String): Sprite2D?
    editor.Files.ThumbOf(path)
    StepUntil(editor, Function() => editor.Files.ThumbDone(path))
    Return editor.Files.ThumbOf(path)
End Function

// What the row of `path` shows, at its first pixel.
Function RowPixel(editor: Editor, path: String): Color32
    Local box = editor.Files.RowOf(path)?.Find("assets.thumb") As? ImageBox
    If box == Null Then Panic("{path}'s row has no thumbnail")
    Local sprite = box.Sprite()
    If sprite == Null Then Panic("{path}'s row shows nothing")
    Return sprite.Texture().ReadPixel(0, 0)
End Function

// Whatever's looked at the disk has, since it looks every half a second.
Function PastALook(editor: Editor)
    Local since = Instant.Now()
    While (Instant.Now() - since) < 700.Milliseconds
        editor.Step()
        Sleep(5.Milliseconds)
    End While
End Function

Function Wide(width: Int, height: Int): UInt8[]
    Local image = Image(width, height)
    For y = 0 To height - 1
        For x = 0 To width - 1
            image[x, y] = Color32(10, 200, 30, 255)
        End For
    End For
    Return Png.Encode(image)
End Function

// However many there are, a few a frame; each small; and what's gone let go of.
@Test
Function ThumbnailsComeAFewAFrameAndSmall() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local bytes = Wide(128, 64)
    For at = 1 To 200
        Try File.WriteBytes(game / "assets" / "many{at}.png", bytes)
    End For
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    Local most = 0
    Local was = editor.Files.ThumbsMade()
    Local since = Instant.Now()
    Local steps = 0
    While editor.Files.ThumbsMade() < 201 && (Instant.Now() - since) < 120.Seconds
        // Now and then, a frame long enough for all that's loading to be done by the next.
        steps += 1
        If steps % 3 == 0 Then Sleep(30.Milliseconds)
        editor.Step()
        Expect(editor.Files.ThumbsLoading() <= 2)
        most = Max(most, editor.Files.ThumbsMade() - was)
        was = editor.Files.ThumbsMade()
    End While
    Expect(editor.Files.ThumbsMade() >= 201, "{editor.Files.ThumbsMade()}")
    Expect(most <= 2 && most > 0, "{most} in a frame")
    Local one = editor.Files.ThumbOf("res://many7.png")
    If one == Null Then Panic("its thumbnail")
    Expect(one.Texture().Width() == 64 && one.Texture().Height() == 32)
    Expect(one.Texture().ReadPixel(3, 3) == Color32(10, 200, 30, 255))
    Expect(RowPixel(editor, "res://many7.png") == Color32(10, 200, 30, 255))
    // Gone: what it held for that's let go of.
    Local held = editor.Files.ThumbsHeld()
    Try File.Delete(game / "assets" / "many7.png")
    StepUntil(editor, Function() => editor.Files.ThumbsHeld() < held)
    Expect(editor.Files.ThumbsHeld() == held - 1)
End Function

// A picture changed is shown changed, in its row; one with capitals too, by the path it's asked for by; a
// model no one's dropped; and one that was broken, once it's fixed.
@Test
Function WhatChangesShowsInItsRow() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local assets = game / "assets"
    Try File.WriteBytes(assets / "Wall2.png", Picture(40))
    Try File.WriteBytes(assets / "Wall3.png", Picture(41))
    Try File.WriteText(assets / "bad.png", "not a picture")
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    editor.Files.SetOpen("res://sub", True)
    If (Thumb(editor, "res://wall.png") == Null) || (Thumb(editor, "res://wall2.png") == Null) Then Panic("pictures")
    Expect(RowPixel(editor, "res://wall.png") == Color32(200, 20, 30, 255))
    Expect(RowPixel(editor, "res://Wall2.png") == Color32(40, 20, 30, 255))
    // Asked for by nothing but its row, whose path has its capitals.
    StepUntil(editor,
              Function() => editor.Files.RowOf("res://Wall3.png")?.Find("assets.thumb") != Null)
    Expect(RowPixel(editor, "res://Wall3.png") == Color32(41, 20, 30, 255))
    Expect(Thumb(editor, "res://bad.png") == Null)
    Local shown = Thumb(editor, "res://sub/ball.gltf")
    If shown == Null Then Panic("a model's")
    Expect(Differing(shown.Texture().ToImage()) > 40)
    PastALook(editor)
    Try WriteChanged(assets / "wall.png", Picture(90))
    Try WriteChanged(assets / "Wall2.png", Picture(95))
    Try WriteChanged(assets / "bad.png", Picture(77))
    // Turned away from above: none of it's drawn.
    Try WriteChangedText(assets / "sub" / "ball.gltf",
                         TRIANGLE.Replace("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAIA/AACAPwAAAAAAAAAA",
                                          "AAAAAAAAAAAAAAAAAACAPwAAAAAAAAAAAAAAAAAAAAAAAIA/"))
    Local changed = Function(): Bool
        Local model = editor.Files.ThumbOf("res://sub/ball.gltf")
        Local fixed = editor.Files.ThumbOf("res://bad.png")
        Return fixed != Null && model != Null && Differing(model.Texture().ToImage()) == 0 &&
               RowPixel(editor, "res://wall.png") == Color32(90, 20, 30, 255) &&
               RowPixel(editor, "res://Wall2.png") == Color32(95, 20, 30, 255)
    End Function
    StepUntil(editor, changed)
    Expect(changed())
    Expect(RowPixel(editor, "res://bad.png") == Color32(77, 20, 30, 255))
End Function

// What can't be read keeps what it was, and says why; what can again, doesn't.
@Test
Function AFailedReloadKeepsItsThumbnail() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    If Thumb(editor, "res://wall.png") == Null Then Panic("a picture")
    PastALook(editor)
    Try WriteChangedText(game / "assets" / "wall.png", "garbage now")
    StepUntil(editor, Function() => editor.Files.Problem() != "")
    Expect(editor.Files.Problem().Contains("wall.png"), editor.Files.Problem())
    Expect(RowPixel(editor, "res://wall.png") == Color32(200, 20, 30, 255))
    Try WriteChanged(game / "assets" / "wall.png", Picture(66))
    StepUntil(editor, Function() => RowPixel(editor, "res://wall.png") == Color32(66, 20, 30, 255))
    Expect(editor.Files.Problem() == "", editor.Files.Problem())
End Function

// A model changing leaves a renamed node the entity it was, what's been put under it there, and undo fine;
// and when the file loses it, what's under it goes up.
@Test
Function AModelReloadedKeepsItsEntitiesAndWhatsUnderThem() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local file = game / "assets" / "sub" / "ball.gltf"
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    Local model = Try editor.Files.ModelOf("res://sub/ball.gltf")
    Local spawned = Try model.Spawn()
    Local blade = spawned.Child(0)
    Expect(blade.Name() == "blade")
    editor.Edits.Commit(RenameEdit(blade, "mine"))
    Local own = Pivot(blade)
    own.SetName("own")
    Local reloads = editor.Files.Reloads()
    Try WriteChangedText(file, TRIANGLE.Replace("\"mesh\":0", "\"mesh\":0,\"translation\":[3,0,0]"))
    StepUntil(editor, Function() => editor.Files.Reloads() > reloads)
    Expect(RefEquals(spawned.Child(0), blade) && spawned.ChildCount() == 1)
    Expect(blade.Name() == "mine" && blade.Position() == Vec3(3, 0, 0))
    Expect(blade.ChildCount() == 1 && RefEquals(blade.Child(0), own))
    Local drawn = (blade As? Mesh)?.Geometry()
    Expect(drawn != Null && RefEquals(drawn, model.Geometries()[0]))
    Expect(editor.Actions.Run("edit.undo"))
    Expect(blade.Name() == "blade")
    Expect(editor.Actions.Run("edit.redo"))
    // Lost: what was under it's kept, where it was in the world, and the edit's harmless.
    own.SetPosition(Vec3(0, 1, 0))
    reloads = editor.Files.Reloads()
    Try WriteChangedText(file, TRIANGLE.Replace("\"blade\"", "\"other\""))
    StepUntil(editor, Function() => editor.Files.Reloads() > reloads)
    Expect(blade.Freed() && !own.Freed())
    Expect(RefEquals(own.Parent(), spawned))
    Expect(own.Position() == Vec3(3, 1, 0), "{own.Position()}")
    Expect(spawned.ChildCount() == 2)
    Expect(editor.Actions.Run("edit.undo"))
End Function

// A scene opened goes on being what its files say, though it's what a model's spawned nothing of.
@Test
Function AnOpenedSceneFollowsItsModels() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Try File.WriteText(game / "assets" / "a.scene",
                       "format = 1\n[[entity]]\npath = \"blade\"\nkind = \"MESH\"\ngeometry = \"res://sub/ball.gltf#0\"\n")
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    editor.OpenScene("res://a.scene")
    editor.Step()
    Local mesh = editor.Edited.Entities()[0] As? Mesh
    If mesh == Null Then Panic("its mesh")
    Local was = mesh.Geometry()
    Local held = editor.Files.HeldModel("res://sub/ball.gltf")
    If held == Null Then Panic("it holds its model")
    Expect(was == held.Geometries()[0])
    Local reloads = editor.Files.Reloads()
    Try WriteChangedText(game / "assets" / "sub" / "ball.gltf",
                         TRIANGLE.Replace("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAIA/AACAPwAAAAAAAAAA",
                                          "AAAAAAAAAAAAAAAAAACAPwAAAAAAAAAAAAAAAAAAAAAAAIA/"))
    StepUntil(editor, Function() => editor.Files.Reloads() > reloads)
    Expect(mesh.Geometry() != was)
    Expect(mesh.Geometry() == held.Geometries()[0])
    Expect(mesh.Geometry()?.Source() == "res://sub/ball.gltf#0")
End Function

// A file lost: the scene's opened all the same, says so, and saves its reference again.
@Test
Function ASceneWithALostFileOpens() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local file = game / "assets" / "a.scene"
    Try File.WriteText(file, "format = 1\n[[material]]\nid = \"m\"\n[[material.layers]]\nlayer = 0\ntexture = \"res://gone.png\"\n[[entity]]\npath = \"blade\"\nkind = \"MESH\"\nmaterial = \"m\"\n")
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    editor.OpenScene("res://a.scene")
    editor.Step()
    Expect(editor.SceneFile() == "res://a.scene")
    Expect(editor.ShowingDialog() != Null)
    Try ClickOn(editor, "dialog.OK")
    Expect(editor.Edited.Entities().Count == 1)
    editor.Edits.Commit(RenameEdit(editor.Edited.Entities()[0], "saved"))
    editor.SaveScene()
    Expect((Try Text(file)).Contains("texture = \"res://gone.png\""), Try Text(file))
End Function

// Changed by something else since, Save asks first; and Save As, over what's another's.
@Test
Function SavingOverWhatsChangedAsks() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    editor.Actions.Run("add.cube")
    editor.SaveScene("res://a.scene")
    Local file = game / "assets" / "a.scene"
    Try File.WriteText(file, "someone else's")
    editor.Edits.Commit(RenameEdit(editor.Edited.Entities()[0], "mine"))
    editor.SaveScene()
    editor.Step()
    Expect(editor.ShowingDialog() != Null && (Try Text(file)) == "someone else's" &&
           editor.Edits.Modified())
    Try ClickOn(editor, "dialog.Cancel")
    Expect((Try Text(file)) == "someone else's" && editor.Edits.Modified())
    editor.SaveScene()
    editor.Step()
    Try ClickOn(editor, "dialog.Replace")
    Expect((Try Text(file)).Contains("name = \"mine\"") && !editor.Edits.Modified())
    // And saved, it's not asked again.
    editor.Edits.Commit(RenameEdit(editor.Edited.Entities()[0], "again"))
    editor.SaveScene()
    Expect(editor.ShowingDialog() == Null && (Try Text(file)).Contains("name = \"again\""))
    // Save As: over another's it asks; a scene's by its extension; over its own it doesn't.
    Try File.WriteText(game / "assets" / "other.scene", "other")
    editor.Actions.Run("file.save_as")
    editor.Step()
    Local field = Found(editor, "dialog.path") As? TextField
    If field == Null Then Panic("its field")
    field.SetText("res://other")
    Try ClickOn(editor, "dialog.Save")
    editor.Step()
    Expect((Try Text(game / "assets" / "other.scene")) == "other" &&
           editor.SceneFile() == "res://a.scene")
    Try ClickOn(editor, "dialog.Replace")
    Expect((Try Text(game / "assets" / "other.scene")) != "other" &&
           editor.SceneFile() == "res://other.scene")
    editor.Actions.Run("file.save_as")
    editor.Step()
    field = Found(editor, "dialog.path") As? TextField
    If field == Null Then Panic("its field")
    field.SetText("res://other.scene")
    Try ClickOn(editor, "dialog.Save")
    editor.Step()
    Expect(editor.ShowingDialog() == Null)
End Function

// A disk's names are kept, whatever case they're asked for by; and new ones are as they're typed.
@Test
Function SavedByTheNamesOnDisk() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local assets = game / "assets"
    Try Dir.CreateAll(assets / "Levels")
    Try File.WriteText(assets / "Levels" / "First.scene", "format = 1\n")
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    editor.OpenScene("res://levels/first.scene")
    editor.Actions.Run("add.cube")
    editor.SaveScene()
    Expect(!editor.Edits.Modified() && editor.ShowingDialog() == Null)
    Local names: String[] = []
    For entry In Try Dir.Entries(assets / "Levels")
        names.Add(entry.Path.FileName())
    End For
    Expect(names == ["First.scene"], "{names}")
    Expect((Try Text(assets / "Levels" / "First.scene")).Contains("[[entity]]"))
    names = []
    For entry In Try Dir.Entries(assets)
        names.Add(entry.Path.FileName())
    End For
    Expect(names.Contains("Levels") && !names.Contains("levels"), "{names}")
    editor.SaveScene("res://New/Deep.scene")
    names = []
    For entry In Try Dir.Entries(assets)
        names.Add(entry.Path.FileName())
    End For
    Expect(names.Contains("New"), "{names}")
    names = []
    For entry In Try Dir.Entries(assets / "New")
        names.Add(entry.Path.FileName())
    End For
    Expect(names == ["Deep.scene"], "{names}")
End Function

// A project with no assets gets them with its first scene.
@Test
Function AFirstSaveMakesAndMountsItsAssets() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = games.Path / "bare"
    Try Dir.CreateAll(game)
    Try File.WriteText(game / "project.toml", "[project]\nname = \"bare\"\nversion = \"0.1.0\"\n")
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    editor.Actions.Run("add.cube")
    editor.SaveScene("res://a.scene")
    Expect(editor.ShowingDialog() == Null && File.Exists(game / "assets" / "a.scene"))
    StepUntil(editor, Function() => editor.Files.RowOf("res://a.scene") != Null)
    Expect(editor.Files.RowOf("res://a.scene") != Null)
    editor.OpenScene("res://a.scene")
    editor.Step()
    Expect(editor.ShowingDialog() == Null && editor.Edited.Entities().Count == 1)
End Function

// A sidecar's edits aren't the scene's: it's not changed by them, and they can't block its undo. Undo's
// theirs while the pane has the keys, and the scene's once it hasn't.
@Test
Function SidecarEditsHaveAHistoryOfTheirOwn() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    editor.Actions.Run("add.cube")
    editor.SaveScene("res://a.scene")
    // Its row comes when its watcher says, which is later on a Mac, and moves the rows below it.
    StepUntil(editor, Function() => editor.Files.RowOf("res://a.scene") != Null)
    Try ClickAt(editor, Row(editor, "res://wall.png").Center)
    (Found(editor, "assets.srgb") As? Toggle)?.Click()
    editor.Step()
    editor.Step()
    Expect(!editor.Edits.Modified() && editor.Files.Edits.UndoName() == "Import Settings")
    Expect((Try Sidecar(games)) == "quality = 3\nsrgb = false\n")
    // The same widget says what's so, once it's undone.
    Local toggle = Found(editor, "assets.srgb") As? Toggle
    Expect(toggle != Null && !toggle.On())
    Expect(editor.Actions.Run("edit.undo"))
    editor.Step()
    Expect((Try Sidecar(games)) == "quality = 3\n")
    Expect(toggle != Null && toggle.On() && RefEquals(Found(editor, "assets.srgb"), toggle))
    Expect(editor.Actions.Run("edit.redo"))
    editor.Step()
    Expect(toggle != Null && !toggle.On())
    // A scene edit, by another way in: its undo's the scene's, though the sidecar's can't be undone.
    Try ClickAt(editor, editor.Tree.Box().Center)
    editor.Edits.Commit(RenameEdit(editor.Edited.Entities()[0], "renamed"))
    Try File.Delete(game / "assets" / "wall.png.toml")
    Try File.Delete(game / "assets" / "wall.png")
    Expect(editor.Actions.Run("edit.undo"))
    Expect(editor.Edited.Entities()[0].Name() != "renamed")
End Function

// A slider's keys go on working as what it's changed comes back to it.
@Test
Function ASliderKeepsItsKeysAsItsSaved() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings.Path, Try Game(games.Path))
    Defer editor.Finish()
    editor.Files.Choose("res://wall.png")
    editor.Step()
    editor.Step()
    Local slider = Found(editor, "assets.quality") As? Slider
    If slider == Null Then Panic("its slider")
    editor.Shown.Focus(slider)
    Try Simulate.PressKey(Key.LEFT)
    editor.Step()
    editor.Step()
    // At 2, what's at first, it's said no more.
    Expect((Try Sidecar(games)) == Null, "{(Try Sidecar(games)) ?? "none"}")
    Try Simulate.PressKey(Key.LEFT)
    editor.Step()
    editor.Step()
    Expect((Try Sidecar(games)) == "quality = 1\n", "{(Try Sidecar(games)) ?? "none"}")
    Expect(RefEquals(Found(editor, "assets.quality"), slider) && slider.Value() == 1.0)
    // Undone, it says so, and that isn't a change of its own.
    Expect(editor.Files.Edits.Undo())
    editor.Step()
    editor.Step()
    Expect(slider.Value() == 2.0 && (Try Sidecar(games)) == Null)
    Expect(editor.Files.Edits.CanRedo())
End Function

// A file coming while a model's dragged leaves the drag be, and its drop; then it's listed.
@Test
Function TheListChangingDuringADragLosesNothing() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try Game(games.Path)
    Local editor = Try Started(settings.Path, game)
    Defer editor.Finish()
    editor.Files.SetOpen("res://sub", True)
    editor.Step()
    editor.View.LookAt(Vec3(0, 0, 0), 10.0)
    editor.Step()
    Local from = Row(editor, "res://sub/ball.gltf").Center
    Local to = editor.View.Box().Center
    Try Simulate.MoveMouse(from.x, from.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MoveMouse(to.x, to.y)
    editor.Step()
    Try File.WriteText(game / "assets" / "new.txt", "new")
    PastALook(editor)
    Expect(editor.Files.RowOf("res://new.txt") == Null, "not while it's held")
    Expect(editor.Shown.Popups().Count == 1, "the hint's there")
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    Expect(editor.Edited.Entities().Count == 2, "{editor.Edited.Entities().Count}")
    Expect(editor.Shown.Popups().Count == 0, "the hint's gone")
    StepUntil(editor, Function() => editor.Files.RowOf("res://new.txt") != Null)
    Expect(editor.Files.RowOf("res://new.txt") != Null)
End Function

