@Test
Function AnEditThatThrowsSaysWhyInADialog() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings.Path, Try Game(games.Path, "failing"))
    Expect(!editor.Edits.Commit(Refusing()))
    editor.Step()
    Expect(editor.ShowingDialog() != Null && !editor.Edits.CanUndo())
    editor.Finish()
End Function

Class Refusing Extends Edit
    New()
        Super.New("refuse")
    End New

    Public Override Method Apply() Throws IOError
        Throw IOError(IOErrorKind.OTHER, "no", "")
    End Method
End Class

