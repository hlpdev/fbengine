@Test
Function ADialogKeepsInASmallWindowWhateverItSays() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Graphics(320, 240)
    Defer EndGraphics()
    Local root = Node("root")
    Local ui = Ui(root)
    Flip()
    ui.Update()
    Local long = ""
    For i = 1 To 30
        long += "aaaaaaaaa "
    End For
    Local unbroken = ""
    For i = 1 To 300
        unbroken += "x"
    End For
    For text In [long, unbroken]
        Local dialog = Dialog("A Title", text)
        Local ok = dialog.AddButton("OK")
        dialog.Show(ui)
        For frame = 1 To 3
            Flip()
            ui.Update()
            dialog.Update()
        End For
        Local box = dialog.Box()
        Expect(box.X >= 0 && box.Y >= 0 && box.X + box.Width <= 320 && box.Y + box.Height <= 240,
               "it's {box}")
        Local button = ok.Box()
        Expect(button.X >= 0 && button.Y >= 0 && button.X + button.Width <= 320 &&
               button.Y + button.Height <= 240, "OK's {button}")
        dialog.Close()
    End For
End Function

@Test
Function ControlZWithAGroupOpenDoesNothing() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings.Path, Try Game(games.Path, "group"))
    Local value = 0
    editor.Edits.Commit(EditOf("set", Function()
        value = 1
    End Function, Function()
        value = 0
    End Function))
    editor.Edits.BeginGroup("group")
    Try Primary(Key.Z)
    editor.Step()
    Expect(value == 1, "it undid through a group")
    Try Primary(Key.Z, True)
    editor.Step()
    editor.Edits.EndGroup()
    Try Primary(Key.Z)
    editor.Step()
    Expect(value == 0)
    editor.Finish()
End Function

@Test
Function WhatsTypedForAFolderLeavesTheDialogWhereItIs() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local editor = Try Editor(settings.Path)
    Window.SetHeadless(True)
    Try editor.Start()
    editor.Step()
    Expect(editor.Actions.Run("file.open"))
    editor.Step()
    editor.Step()
    Local field = Found(editor, "dialog.path") As? TextField
    If field == Null Then Panic("there's no field")
    Local open = Found(editor, "dialog.Open").Box()
    Local long = ""
    For i = 1 To 40
        long += "a long folder name/"
    End For
    field.SetText(long)
    editor.Step()
    Expect(Found(editor, "dialog.Open").Box() == open,
           "it went from {open} to {Found(editor, "dialog.Open").Box()}")
    Expect(field.Box().Width == 420, "it's {field.Box()}")
    editor.Finish()
End Function

@Test
Function AShortcutsWrittenAsAPersonWrites()
    Expect("{Shortcut(Key.DELETE, False, False, False)}" == "Delete")
    Expect("{Shortcut(Key.ESCAPE, False, False, False)}" == "Escape")
    Expect("{Shortcut(Key.PAGE_UP, False, False, False)}" == "Page Up")
    Expect("{Shortcut(Key.F2, False, False, False)}" == "F2")
    Local primary = System.Platform == Platform.MACOS ? "Cmd" : "Ctrl"
    Expect("{PrimaryKey(Key.Z, True)}" == "{primary}+Shift+Z", "{PrimaryKey(Key.Z, True)}")
End Function
