// A notice from the editor's start, as of what was kept that couldn't be read, stays through a
// run's start, which clears what the last run said.
@Test
Function ARunsStartLeavesTheEditorsNotices() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "noticed", PLAIN)
    // A folder where the preferences' file would be, which can't be read as one.
    Try Dir.CreateAll(settings.Path / "fbengine_editor" / "preferences.txt")
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    editor.Step()
    Local notice = "What was kept couldn't be read"
    Expect(Said(editor).Contains(notice), "no notice: {Said(editor)}")
    Saved(editor)
    editor.Run.Fb = (games.Path / "no such fb").Text
    editor.Play()
    editor.Step()
    Expect(Said(editor).Contains("It couldn't be started"), Said(editor))
    Expect(Said(editor).Contains(notice), "the run's start cleared the notice: {Said(editor)}")
    Expect(editor.Output.ShownLines().Join("\n").Contains(notice), "the pane doesn't show it")
End Function

// What it says, however much, never holds it up; and something it started that holds its pipes never
// holds the editor up, nor is what that says after taken for the next run's.
Const NOISY = "Import std.collections\nImport std.core\nImport std.io\nImport std.os\nImport std.time\n\nIf Process.Arguments().Contains(\"--hold\")\n    Local waited = 0\n    While !File.Exists(Path(\"go\")) && waited < 60000\n        waited += 1\n        Sleep(10.Milliseconds)\n    End While\n    For at = 1 To 20000\n        Print(\"late late late late late late late late late late late late\")\n    End For\n    Try? File.WriteText(Path(\"held\"), \"yes\")\n    Process.Exit(0)\nEnd If\nFor at = 1 To 40000\n    Print(\"line {{at}}\")\nEnd For\nIf File.Exists(Path(\"hold\"))\n    Local holding = Try? Command(Folders.Executable ?? \"\").Arg(\"--hold\").Stdin(Stdio.NONE).Spawn()\nEnd If\nIf File.Exists(Path(\"linger\"))\n    Try? File.WriteText(Path(\"lingering\"), \"yes\")\n    For at = 1 To 12000\n        Sleep(10.Milliseconds)\n    End For\nEnd If\nProcess.Exit(0)\n"

@Test
Function ANoisyGameAndOneThatLeavesItsPipesHeldHoldNothingUp() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "noisy", NOISY)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    editor.Play()
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.ENDED && editor.Run.ExitCode() == 0, Said(editor))
    Local lines = editor.Run.Log.Lines()
    Expect(lines.Count == 1000 && lines[998] == "line 40000",
           "{lines.Count}: {lines[lines.Count - 2]}")
    Expect(editor.Run.Log.Total() >= 40003 &&
           editor.Run.Log.Dropped() == editor.Run.Log.Total() - 1000)
    // Now it leaves a process of its own going, on its output.
    Try File.WriteText(folder / "hold", "")
    editor.Play()
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.ENDED, Said(editor))
    Expect(!File.Exists(folder / "held"), "it's gone on before it's told to")
    // What it has to say after is more than a pipe holds, so it finishes only if that's still read.
    Try LetHolderFinish(editor, folder)
End Function

// Tells a game's process that holds its pipes to say what it has to say, and sees that it's finished,
// with none of it taken for the run's.
Function LetHolderFinish(editor: Editor, folder: Path) Throws IOError
    Try File.WriteText(folder / "go", "")
    StepUntil(editor, Function() => File.Exists(folder / "held"))
    For i = 1 To 40
        editor.Step()
        Sleep(5.Milliseconds)
    End For
    Expect(File.Exists(folder / "held") && !Said(editor).Contains("late"), Said(editor))
End Function

// Stopped, what it was building with is gone too, not only what would have come after.
@Test
Function StoppingABuildEndsWhatsBuilding() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "as_fb", PLAIN)
    Local beat = folder / "beat"
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    editor.Play()
    StepUntil(editor, Function() => File.Exists(beat) || !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.RUNNING, Said(editor))
    Local built = editor.Run.Program()
    If built == Null Then Panic("its program")
    editor.Run.StopNow()
    Try File.Delete(beat)
    // It builds with what goes on until it's stopped, and says so by its file.
    editor.Run.Fb = built.Text
    Local open = editor.Current()
    If open == Null Then Panic("its project")
    editor.Run.Start(open, "res://level.scene")
    StepUntil(editor, Function() => File.Exists(beat) || !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.BUILDING && (Try Alive(folder)), Said(editor))
    editor.Run.Stop()
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.STOPPED, Said(editor))
    Expect(Try Dead(folder))
End Function

// What can't be stopped is still shown as going, its process known of, and nothing takes its place.
@Test
Function WhatCantBeStoppedStaysKnownOf() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "stuck", PLAIN)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    editor.Play()
    StepUntil(editor, Function() => File.Exists(folder / "beat") || !editor.Run.Going())
    // What it said comes through its pipe a step or two after it's on disk that it's going.
    StepUntil(editor, Function() => Said(editor).Contains("it says --scene") || !editor.Run.Going())
    Local first = editor.Run.ProcessId()
    Expect(first != Null && editor.Run.State() == PlayState.RUNNING, Said(editor))
    editor.Run.FailStoppingWith("it won't")
    editor.Run.Stop()
    Expect(editor.Run.State() == PlayState.RUNNING && editor.Run.ProcessId() == first)
    Expect(Said(editor).Contains("It couldn't be stopped: it won't"), Said(editor))
    editor.Play()
    Expect(editor.Run.State() == PlayState.RUNNING && editor.Run.ProcessId() == first, Said(editor))
    Expect(Said(editor).Contains("it says --scene"), "it was cleared: {Said(editor)}")
    Expect(Try Alive(folder))
    editor.Run.FailStoppingWith(Null)
    editor.Run.StopNow()
    Expect(!editor.Run.Going() && (Try Dead(folder)))
End Function

// Stopping what's left its output held doesn't hold up a frame: it's stopping, playing again waits for
// that, and what's next starts when it's done.
@Test
Function StoppingNeverHoldsUpAFrame() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "lingers", NOISY)
    Try File.WriteText(folder / "hold", "")
    Try File.WriteText(folder / "linger", "")
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    editor.Play()
    StepUntil(editor, Function() => File.Exists(folder / "lingering") || !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.RUNNING, Said(editor))
    Local since = Instant.Now()
    editor.Run.Stop()
    Expect((Instant.Now() - since).TotalSeconds < Budget(0.75),
           "it took {Instant.Now() - since}, {BudgetHeld()}")
    Expect(editor.Run.State() == PlayState.STOPPING && editor.Run.Going(), Said(editor))
    since = Instant.Now()
    editor.Step()
    Expect((Instant.Now() - since).TotalSeconds < Budget(0.75),
           "a frame took {Instant.Now() - since}, {BudgetHeld()}")
    Expect(editor.Output.Heading() == "Stopping")
    Local open = editor.Current()
    If open == Null Then Panic("its project")
    editor.Run.Start(open, "res://level.scene")
    Expect(editor.Run.State() == PlayState.STOPPING, Said(editor))
    StepUntil(editor, Function() => editor.Run.State() != PlayState.STOPPING)
    Expect(editor.Run.State() == PlayState.BUILDING, Said(editor))
    editor.Run.StopNow()
    Expect(!editor.Run.Going())
    Try LetHolderFinish(editor, folder)
End Function

// Closing its project waits for a run to go, however long what it left takes to let go of its output.
@Test
Function ClosingAProjectWaitsForItsRunToGo() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "closes", NOISY)
    Try File.WriteText(folder / "hold", "")
    Try File.WriteText(folder / "linger", "")
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    editor.Play()
    StepUntil(editor, Function() => File.Exists(folder / "lingering") || !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.RUNNING, Said(editor))
    editor.CloseProject()
    Expect(editor.Run.State() == PlayState.STOPPED, "{editor.Run.State()}")
    Try LetHolderFinish(editor, folder)
End Function

// Quitting doesn't wait for what a game left with its output, which needn't ever close.
@Test
Function QuittingDoesntWaitForWhatHoldsAGamesOutput() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "leaves", NOISY)
    Try File.WriteText(folder / "hold", "")
    Local program = (Try Engine()).Parent() ?? Path("")
    Local run = Try os.Command("fb").Args(["--color", "never", "run",
                                           (program / "fbengine_editor").Text, "--",
                                           "--play",
                                           folder.Text]).Stdin(Stdio.NONE).Stdout(
                                               Stdio.NONE).Stderr(Stdio.NONE).Spawn()
    Local since = Instant.Now()
    Local ended = run.TryWait()
    While ended == Null && (Instant.Now() - since) < 240.Seconds
        Sleep(50.Milliseconds)
        ended = run.TryWait()
    End While
    // Whichever, it isn't left holding on after this.
    Try File.WriteText(folder / "go", "")
    Expect(ended?.Success == True, ended != Null ? "it failed" : "it hadn't ended")
    Expect(File.Exists(folder / "assets" / "level.scene") && Dir.Exists(folder / "build" / "play"))
End Function

// However fast a game says things, it isn't kept waiting.
Const LOUD = "Import std.core\nImport std.os\n\nLocal line = \"\"\nFor at = 1 To 100\n    line += \"0123456789\"\nEnd For\nFor at = 1 To 8000\n    Print(line)\nEnd For\nProcess.Exit(0)\n"

@Test
Function AGameSayingALotIsntKeptWaiting() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "loud", LOUD)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    Frame.SetLimit(60)
    Defer Frame.SetLimit(0)
    editor.Play()
    StepUntil(editor, Function() => editor.Run.State() != PlayState.BUILDING)
    // Its pipes' reads, from its running to its end, and how many of them a frame went back for,
    // having read already: one read a frame, the rest left to the next, would be none. How many
    // frames that takes is the machine's: a busy one gives a game less to say in the little longer a
    // frame gives it, 5 of 124 reads here under forty other programs against 100 on its own, and
    // so more frames, 199 against 22. So it's the count of those reads that tells, not frames to
    // reads, which a busy machine brings to one.
    Local readsBefore = editor.Run.Reads()
    Local againBefore = editor.Run.ReadsAgain()
    Local frames = 0
    Local since = Instant.Now()
    While editor.Run.Going() && (Instant.Now() - since) < 180.Seconds
        editor.Step()
        frames += 1
    End While
    Expect(editor.Run.State() == PlayState.ENDED, Said(editor))
    // Here, about 25 frames for 124 reads of 64 KB, the pane making only the rows in view.
    Local reads = editor.Run.Reads() - readsBefore
    Local again = editor.Run.ReadsAgain() - againBefore
    Local fits = (Window.Height() / 22) + 3
    Expect(editor.Output.RowsMade() <= fits,
           "it made {editor.Output.RowsMade()} of what fit in {fits}")
    Expect(reads > 100, "{reads} reads")
    Expect(again > 0,
           "{again} of {reads} reads were a frame's going back for more, in {frames} frames")
End Function

