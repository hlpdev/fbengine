// A yes that can't be kept holds for now, and it says why.
@Test
Function AYesThatCantBeKeptHoldsForNow() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "unkept", PLAIN)
    Try File.WriteText(folder / "ends", "")
    Try Dir.CreateAll(settings.Path / "trusted.txt")
    Local editor = Try Editor(settings.Path)
    Try editor.Start(folder)
    editor.Step()
    Saved(editor)
    editor.Play()
    editor.Step()
    Pressed(editor.ShowingDialog(), "Run It")
    Expect(editor.Run.Going() && editor.Kept.Trusted(folder.Text))
    Expect(editor.ShowingDialog() != Null, "it doesn't say it wasn't kept")
    Pressed(editor.ShowingDialog(), "OK")
    editor.Step()
    editor.Step()
    StepUntil(editor, Function() => !editor.Run.Going())
    editor.Play()
    editor.Step()
    Expect(editor.ShowingDialog() == Null && editor.Run.Going(), "it asked again")
    editor.Finish()
    // It's gone with the editor.
    editor = Try Editor(settings.Path)
    Defer editor.Finish()
    Expect(!editor.Kept.Trusted(folder.Text))
End Function

// A yes is to that folder as it's named and built: what would run differently is asked about again.
@Test
Function AChangedBuildStepAsksAgain() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "changing", PLAIN)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    Local file = folder / "project.toml"
    Local first = Try File.ReadText(file)
    Expect(editor.Kept.Trusted(folder.Text))
    Try File.WriteText(file, first + "\n[build]\nstep = \"something else\"\n")
    Expect(!editor.Kept.Trusted(folder.Text))
    editor.Play()
    editor.Step()
    Expect(editor.ShowingDialog() != Null && !editor.Run.Going(), "it ran without asking")
    Pressed(editor.ShowingDialog(), "Not Now")
    editor.Step()
    editor.Step()
    editor.Kept.Trust(folder.Text)
    Expect(editor.Kept.Trusted(folder.Text))
    // Another section isn't how it's built; another name is another project.
    Local stepped = Try File.ReadText(file)
    Try File.WriteText(file, stepped + "\n[other]\nnote = 1\n")
    Expect(editor.Kept.Trusted(folder.Text))
    Try File.WriteText(file, stepped.Replace("name = \"changing\"", "name = \"another\""))
    Expect(!editor.Kept.Trusted(folder.Text))
End Function

