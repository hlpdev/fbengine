// Play in the editor: a game built by fb and run in a process of its own, offscreen, its output shown,
// stopped from here, with none left behind; and what's being edited never changed by a run.

Import std.collections
Import std.core
Import std.ffi
Import std.io
Import std.math
Import std.os
Import std.test
Import std.text
Import std.time
Import fbengine
Import fbengine_editor
Import fbengine_ui

Function NoGpu(): Bool => Env.Get("FBENGINE_NO_GPU") == "1"

// A game of std alone, quick to build: it says its arguments, on both streams; with `ends` it ends
// with that code; else it goes on, adding to a file named `beat` as it does, so it shows it's alive.
Const PLAIN = "Import std.collections\nImport std.core\nImport std.io\nImport std.os\nImport std.time\n\nLocal arguments = Process.Arguments()\nPrint(\"it says {{arguments.Join(\" \")}}\")\nPrintError(\"its error\")\nIf File.Exists(Path(\"ends\"))\n    Process.Exit(3)\nEnd If\nTry? File.WriteText(Path(\"started\"), \"yes\")\nLocal count = 0\nWhile True\n    count += 1\n    Try? File.WriteText(Path(\"beat\"), \"{{count}}\")\n    Sleep(10.Milliseconds)\nEnd While\n"

Function Game(at: Path, name: String, program: String,
              dependencies: String = ""): Path Throws IOError
    Local folder = at / name
    Try Dir.CreateAll(folder / "assets")
    Try File.WriteText(folder / "project.toml", "[project]\nname = \"{name.Replace(" ", "_")}\"\nversion = \"0.1.0\"\ntype = \"executable\"\n\n[dependencies]\n{dependencies}")
    Try File.WriteText(folder / "main.fb", program)
    Return folder
End Function

Function Started(settings: Path, folder: Path): Editor Throws IOError, GraphicsError
    Window.SetHeadless(True)
    Local editor = Try Editor(settings)
    editor.Kept.Trust(folder.Text)
    Try editor.Start(folder)
    editor.Step()
    Return editor
End Function

// Steps until the run's got past being busy, or `done`.
Function StepUntil(editor: Editor, done: Func(): Bool)
    Local since = Instant.Now()
    While !done() && (Instant.Now() - since) < 180.Seconds
        editor.Step()
        Sleep(5.Milliseconds)
    End While
End Function

Function Said(editor: Editor): String => editor.Run.Log.Lines().Join("\n")

// Whether a game's stopped adding to its file.
Function Dead(folder: Path): Bool Throws IOError
    Local file = folder / "beat"
    If !File.Exists(file) Then Return True
    Sleep(50.Milliseconds)
    Local was = Try? File.ReadText(file)
    Sleep(150.Milliseconds)
    Return (Try? File.ReadText(file)) == was
End Function

// A scene saved, so there's something to run.
Function Saved(editor: Editor)
    editor.Actions.Run("add.cube")
    editor.SaveScene("res://level.scene")
End Function

@Test
Function ItsLinesAreWhatsWrittenByTheirEnds()
    Local log = OutputLog(3)
    Local bytes = Buffer<UInt8>(8)
    Local text: UInt8[] = [97, 98, 13, 10, 99, 100, 10, 101]
    For at = 0 To 7
        bytes[at] = text[at]
    End For
    log.Feed(bytes, 8)
    Expect(log.Lines() == ["ab", "cd"], "{log.Lines()}")
    // What hasn't ended goes on, however it's cut, and its end ends it.
    bytes[0] = 102
    bytes[1] = 10
    log.Feed(bytes, 2)
    Expect(log.Lines() == ["ab", "cd", "ef"], "{log.Lines()}")
    // Past its most, the oldest go, and they're counted.
    log.Say("g")
    Expect(log.Lines() == ["cd", "ef", "g"] && log.Total() == 4 && log.Dropped() == 1)
    // A stream's end ends a line; what's not UTF-8 is still a line.
    bytes[0] = 255
    log.Feed(bytes, 1)
    log.Flush()
    Expect(log.Total() == 5 && log.Lines()[2] != "")
    log.Flush()
    Expect(log.Total() == 5)
    log.Clear()
    Expect(log.Lines().Count == 0 && log.Total() == 0 && log.Dropped() == 0)
End Function

Function Found(editor: Editor, name: String): Node
    For popup In editor.Shown.Popups()
        Local there = popup.Find(name)
        If there != Null Then Return there
    End For
    Local found = editor.Shown.Root().Find(name)
    If found == Null Then Panic("there's no {name}")
    Return found
End Function

// Built, run in its folder on the scene saved, both streams shown, and how it ended.
@Test
Function AGameIsBuiltAndRunOnTheSceneAndItsOutputShown() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "my game", PLAIN)
    Try File.WriteText(folder / "ends", "")
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    Expect(editor.Actions.Find("play.stop")?.Enabled() == False)
    Expect(editor.Actions.Run("play.run"))
    Expect(editor.Run.State() == PlayState.BUILDING && editor.Run.Going())
    Expect(editor.Actions.Find("play.stop")?.Enabled() == True)
    Expect(editor.Docked.Active("output"))
    StepUntil(editor,
              Function() => editor.Run.State() == PlayState.ENDED ||
              editor.Run.State() == PlayState.BUILD_FAILED)
    Expect(editor.Run.State() == PlayState.ENDED, Said(editor))
    Expect(editor.Run.ExitCode() == 3 && !editor.Run.Going() && editor.Run.ProcessId() == Null)
    Expect(Said(editor).Contains("it says --scene res://level.scene"), Said(editor))
    Expect(Said(editor).Contains("its error"), Said(editor))
    Expect(Said(editor).EndsWith("It ended, with exit code 3."), Said(editor))
    Expect(File.Exists(editor.Run.Program() ?? folder))
    // The pane shows it, its heading what it's got to.
    editor.Step()
    Expect(editor.Output.Heading() == "Ended")
    Expect(editor.Output.ShownLines() == editor.Run.Log.Lines())
    // In a column, the newest at the bottom of what shows, in its tab.
    Local list = Found(editor, "output.list")
    Local rows = list.Children()
    Expect(rows.Count >= 4)
    For at = 1 To rows.Count - 1
        Expect(rows[at].Box().Y >= rows[at - 1].Box().Y + rows[at - 1].Box().Height, "{at}")
    End For
    Local scroller = Found(editor, "output.scroller") As? ScrollView
    If scroller == Null Then Panic("its scroller")
    Expect(scroller.Box().Height > 0.0 && scroller.Box().Width > 100.0, "{scroller.Box()}")
    Expect(scroller.Offset() == scroller.MaxOffset())
    // And again, afresh.
    Expect(editor.Actions.Run("play.run"))
    Expect(editor.Run.ExitCode() == Null && editor.Run.State() == PlayState.BUILDING)
    editor.Step()
    Expect(editor.Output.ShownLines().Count <= 2, "{editor.Output.ShownLines()}")
    StepUntil(editor, Function() => editor.Run.State() == PlayState.ENDED)
    Expect(editor.Run.ExitCode() == 3)
End Function

@Test
Function WhatDoesntBuildSaysWhyAndDoesntRun() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "broken", "Local x: Int = \"not a number\"\n")
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    editor.Play()
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.BUILD_FAILED, Said(editor))
    Expect(Said(editor).Contains("main.fb") && Said(editor).Contains("couldn't be built"),
           Said(editor))
    Expect(!Said(editor).Contains("Running"))
    Expect(editor.Run.ExitCode() == Null)
End Function

// Stopped, a run's gone, by the command, by playing again, by closing its project, and by quitting.
@Test
Function AStoppedGameIsNeverLeftBehind() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "goes_on", PLAIN)
    Local beat = folder / "beat"
    Local editor = Try Started(settings.Path, folder)
    Saved(editor)
    editor.Play()
    StepUntil(editor, Function() => File.Exists(beat) || !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.RUNNING, Said(editor))
    Expect(!(Try Dead(folder)), "it's going")
    Expect(editor.Run.ProcessId() != Null)
    // By the command: at once.
    Expect(editor.Actions.Run("play.stop"))
    Expect(editor.Run.State() == PlayState.STOPPED && !editor.Run.Going() &&
           editor.Run.ProcessId() == Null)
    Expect(editor.Run.ExitCode() == Null && Said(editor).EndsWith("Stopped."), Said(editor))
    Expect(Try Dead(folder))
    Expect(!editor.Actions.Run("play.stop"), "there's nothing to stop")
    // Playing again stops the first, so there's one.
    Try File.Delete(beat)
    editor.Play()
    StepUntil(editor, Function() => File.Exists(beat) || !editor.Run.Going())
    Local first = editor.Run.ProcessId()
    editor.Play()
    Expect(editor.Run.State() == PlayState.BUILDING && editor.Run.ProcessId() != first)
    Expect(Try Dead(folder))
    // Stopped while it's building, it isn't run after.
    Try File.Delete(folder / "started")
    editor.Run.Stop()
    For i = 1 To 30
        editor.Step()
        Sleep(10.Milliseconds)
    End For
    Expect(editor.Run.State() == PlayState.STOPPED && !File.Exists(folder / "started"))
    // Closing its project.
    Try File.Delete(beat)
    editor.Play()
    StepUntil(editor, Function() => File.Exists(beat) || !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.RUNNING)
    editor.CloseProject()
    Expect(!editor.Run.Going())
    Expect(Try Dead(folder))
    // Quitting, with no Stop first.
    editor.OpenFolder(folder)
    editor.OpenScene("res://level.scene")
    Try File.Delete(beat)
    editor.Play()
    StepUntil(editor, Function() => File.Exists(beat) || !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.RUNNING)
    editor.Finish()
    Expect(Try Dead(folder))
End Function

// A scene's what's saved: Play saves what's changed, and asks where for what's never been, and what's
// running changes nothing of it, in the editor or on disk.
@Test
Function ARunNeverChangesTheScene() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "reader", PLAIN)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    // Never saved, it asks where.
    editor.Actions.Run("add.cube")
    editor.Play()
    editor.Step()
    Expect(editor.ShowingDialog() != Null && !editor.Run.Going())
    Try Simulate.PressKey(Key.ESCAPE)
    editor.Step()
    Expect(!editor.Run.Going() && editor.SceneFile() == Null)
    // Saved, then changed: Play saves it first.
    editor.SaveScene("res://level.scene")
    editor.Edited.Entities()[0].SetName("Crate")
    editor.Edits.Commit(RenameEdit(editor.Edited.Entities()[0], "Renamed"))
    Expect(editor.Edits.Modified())
    editor.Play()
    Expect(!editor.Edits.Modified())
    Local file = folder / "assets" / "level.scene"
    Local saved = Try File.ReadText(file)
    Expect(saved.Contains("name = \"Renamed\""))
    Local entities = editor.Edited.Entities()
    Local undoable = editor.Edits.UndoName()
    StepUntil(editor, Function() => File.Exists(folder / "beat") || !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.RUNNING, Said(editor))
    For i = 1 To 20
        editor.Step()
    End For
    editor.Run.Stop()
    Expect((Try File.ReadText(file)) == saved)
    Expect(!editor.Edits.Modified() && editor.Edits.UndoName() == undoable)
    Expect(editor.Edited.Entities() == entities && editor.Edited.Entities()[0].Name() == "Renamed")
    // A scene that can't be saved doesn't run.
    Local ground = GroundPlane()
    ground.SetName("ground")
    editor.Edits.Commit(RenameEdit(editor.Edited.Entities()[0], "Again"))
    editor.Play()
    editor.Step()
    Expect(!editor.Run.Going() && editor.ShowingDialog() != Null)
    Expect((Try File.ReadText(file)) == saved)
    ground.Free()
    // With nothing to run, no project, Play's not there.
    editor.CloseProject()
    Expect(!editor.Actions.Run("play.run"))
End Function

Function Pressed(asking: Dialog?, name: String)
    Local button = asking?.Find("dialog." + name) As? Button
    If button == Null Then Panic("there's no {name}")
    button.Click()
End Function

// A folder's code runs only once it's been said it may, once a folder, and that's the yes its components
// go by too; not now leaves nothing built or run, and asks again.
@Test
Function PlayAsksOnceAFolderBeforeItsCodeRuns() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "asked", PLAIN)
    Try File.WriteText(folder / "ends", "")
    Local editor = Try Editor(settings.Path)
    Try editor.Start(folder)
    editor.Step()
    Expect(editor.ShowingDialog() == Null, "there's nothing to run yet")
    Saved(editor)
    editor.Play()
    editor.Step()
    Expect(editor.ShowingDialog() != Null && !editor.Run.Going() &&
           !editor.Kept.Trusted(folder.Text))
    Pressed(editor.ShowingDialog(), "Not Now")
    editor.Step()
    editor.Step()
    Expect(editor.ShowingDialog() == Null && !editor.Run.Going() &&
           editor.Run.State() == PlayState.IDLE)
    Expect(!editor.Kept.Trusted(folder.Text) && !Dir.Exists(folder / "build"))
    editor.Play()
    editor.Step()
    Pressed(editor.ShowingDialog(), "Run It")
    Expect(editor.Run.Going() && editor.Kept.Trusted(folder.Text) && !editor.Kinds.Running())
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.ENDED, Said(editor))
    editor.Finish()
    // Another run of the editor doesn't ask.
    editor = Try Editor(settings.Path)
    Try editor.Start(folder)
    editor.Step()
    Saved(editor)
    editor.Play()
    Expect(editor.ShowingDialog() == Null && editor.Run.Going())
    editor.Finish()
    // Another folder does; and one with components is asked about as it opens, no to that being no yet,
    // and yes to Play reads them too.
    Local other = Try Game(games.Path, "other", PLAIN)
    Try Dir.CreateAll(other / "components")
    Try File.WriteText(other / "components" / "main.fb", "Print(\"it has none\")\n")
    editor = Try Editor(settings.Path)
    Defer editor.Finish()
    Try editor.Start(other)
    editor.Step()
    Pressed(editor.ShowingDialog(), "Not Now")
    editor.Step()
    editor.Step()
    Expect(!editor.Kinds.Running())
    Saved(editor)
    editor.Play()
    editor.Step()
    Pressed(editor.ShowingDialog(), "Run It")
    Expect(editor.Run.Going() && editor.Kinds.Running())
    Expect(editor.Kept.Trusted(other.Text) && editor.Kept.Trusted(folder.Text))
End Function

// A file that's changed under it asks first, as any save does: cancelled, nothing runs; replaced, it does.
@Test
Function PlayGoesByWhatSavingAsks() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "changed", PLAIN)
    Try File.WriteText(folder / "ends", "")
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    Local file = folder / "assets" / "level.scene"
    Try File.WriteText(file, (Try File.ReadText(file)) + "# theirs\n")
    editor.Edits.Commit(RenameEdit(editor.Edited.Entities()[0], "Renamed"))
    editor.Play()
    editor.Step()
    Expect(editor.ShowingDialog() != Null && !editor.Run.Going())
    Pressed(editor.ShowingDialog(), "Cancel")
    editor.Step()
    editor.Step()
    Expect(!editor.Run.Going() && (Try File.ReadText(file)).Contains("# theirs"))
    editor.Play()
    editor.Step()
    Pressed(editor.ShowingDialog(), "Replace")
    Expect(editor.Run.Going() && !editor.Edits.Modified())
    Expect((Try File.ReadText(file)).Contains("Renamed"))
End Function

// What's said after being emptied replaces what was shown, however much of it there is.
@Test
Function ThePaneShowsOnlyWhatsNewAndTheMostItKeeps() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "pane", PLAIN)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Expect(editor.Output.Heading() == "Not run")
    Local log = editor.Run.Log
    log.Say("old 1")
    log.Say("old 2")
    editor.Step()
    Expect(editor.Output.ShownLines() == ["old 1", "old 2"])
    log.Clear()
    log.Say("new 1")
    log.Say("new 2")
    log.Say("new 3")
    editor.Step()
    Expect(editor.Output.ShownLines() == ["new 1", "new 2", "new 3"],
           "{editor.Output.ShownLines()}")
    log.Clear()
    log.Say("again")
    log.Say("again 2")
    log.Say("again 3")
    editor.Step()
    Expect(editor.Output.ShownLines() == ["again", "again 2", "again 3"],
           "{editor.Output.ShownLines()}")
    // More than it keeps: the last of them.
    For at = 1 To 2500
        log.Say("line {at}")
    End For
    editor.Step()
    Local shown = editor.Output.ShownLines()
    Expect(shown == log.Lines() && shown.Count == 1000 && shown[0] == "line 1501" &&
           shown[999] == "line 2500")
    For at = 1 To 3
        log.Say("more {at}")
    End For
    editor.Step()
    shown = editor.Output.ShownLines()
    Expect(shown == log.Lines() && shown.Count == 1000 && shown[0] == "line 1504" &&
           shown[999] == "more 3")
End Function

// The mouse on `node`, and a click.
Function Clicked(editor: Editor, node: Node) Throws GraphicsError
    editor.Step()
    Local at = node.Box().Center
    Try Simulate.MoveMouse(at.x, at.y)
    editor.Step()
    Try Simulate.Click(MouseButton.LEFT)
    editor.Step()
End Function

// Its keys, and its menu.
@Test
Function PlayAndStopHaveKeysAndAMenu() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "keys", PLAIN)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    Try Simulate.PressKey(Key.F5)
    editor.Step()
    Expect(editor.Run.State() == PlayState.BUILDING)
    Try Simulate.KeyDown(Key.LEFT_SHIFT)
    Try Simulate.PressKey(Key.F5)
    editor.Step()
    Try Simulate.KeyUp(Key.LEFT_SHIFT)
    Expect(editor.Run.State() == PlayState.STOPPED, "{editor.Run.State()}")
    editor.Play()
    StepUntil(editor, Function() => File.Exists(folder / "beat") || !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.RUNNING, Said(editor))
    Try Clicked(editor, Found(editor, "menu.Play"))
    Try Clicked(editor, Found(editor, "play.stop"))
    Expect(editor.Run.State() == PlayState.STOPPED, "{editor.Run.State()}")
    Expect(Try Dead(folder))
End Function

// Never saved, it asks where, and plays once it's told.
@Test
Function PlayGoesOnOnceItsToldWhereToSave() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "asks", PLAIN)
    Try File.WriteText(folder / "ends", "")
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    editor.Actions.Run("add.cube")
    editor.Play()
    editor.Step()
    Local field = Found(editor, "dialog.path") As? TextField
    If field == Null Then Panic("its field")
    field.SetText("res://asked.scene")
    Local button = Found(editor, "dialog.Save").Box().Center
    Try Simulate.MoveMouse(button.x, button.y)
    editor.Step()
    Try Simulate.Click(MouseButton.LEFT)
    editor.Step()
    editor.Step()
    Expect(editor.SceneFile() == "res://asked.scene" &&
           File.Exists(folder / "assets" / "asked.scene"))
    Expect(editor.Run.Going(), Said(editor))
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(Said(editor).Contains("it says --scene res://asked.scene"), Said(editor))
End Function

// An fb that isn't there says so, and nothing's going.
@Test
Function WhatCantBeStartedSaysSo() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "no_fb", PLAIN)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    editor.Run.Fb = (games.Path / "no such fb").Text
    editor.Play()
    Expect(editor.Run.State() == PlayState.COULDNT_START && !editor.Run.Going(), Said(editor))
    Expect(Said(editor).Contains("It couldn't be started"), Said(editor))
    editor.Step()
    Expect(editor.Output.Heading() == "Couldn't be started")
End Function

// What it says, however much, never holds it up; and something it started that holds its pipes never
// holds the editor up, nor is what that says after taken for the next run's.
Const NOISY = "Import std.collections\nImport std.core\nImport std.io\nImport std.os\nImport std.time\n\nFor at = 1 To 40000\n    Print(\"line {{at}}\")\nEnd For\nIf Process.Arguments().Contains(\"--hold\")\n    Sleep(1500.Milliseconds)\n    Print(\"late\")\n    Try? File.WriteText(Path(\"held\"), \"yes\")\n    Process.Exit(0)\nEnd If\nIf File.Exists(Path(\"hold\"))\n    Local holding = Try? Command(Folders.Executable ?? \"\").Arg(\"--hold\").Stdin(Stdio.NONE).Spawn()\nEnd If\nProcess.Exit(0)\n"

@Test
Function ANoisyGameAndOneThatLeavesItsPipesHeldHoldNothingUp() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "noisy", NOISY)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    Saved(editor)
    editor.Play()
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.ENDED && editor.Run.ExitCode() == 0, Said(editor))
    Local lines = editor.Run.Log.Lines()
    Expect(lines.Count == 1000 && lines[998] == "line 40000",
           "{lines.Count}: {lines[lines.Count - 2]}")
    Expect(editor.Run.Log.Total() >= 40003 &&
           editor.Run.Log.Dropped() == editor.Run.Log.Total() - 1000)
    // Now it leaves a process of its own going, on its output.
    Try File.WriteText(folder / "hold", "")
    editor.Play()
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.ENDED, Said(editor))
    Expect(!File.Exists(folder / "held"), "it's gone on before that's done")
    Local since = Instant.Now()
    While !File.Exists(folder / "held") && (Instant.Now() - since) < 30.Seconds
        editor.Step()
        Sleep(5.Milliseconds)
    End While
    For i = 1 To 40
        editor.Step()
        Sleep(5.Milliseconds)
    End For
    Expect(File.Exists(folder / "held") && !Said(editor).Contains("late"), Said(editor))
End Function

// The engine's package: where ctest says, since what's above its build folder can be another
// checkout's, or above where a test's been run from by hand.
Function Engine(): Path Throws IOError
    Local said = Env.Get("FBENGINE_PACKAGES")
    If said != Null && said != "" Then Return Path(said) / "fbengine"
    Local here = Try Dir.Current()
    While !Dir.Exists(here / "packages" / "fbengine")
        If here.Parent() == here Then Panic("no packages/fbengine above here")
        here = here.Parent()
    End While
    Return here / "packages" / "fbengine"
End Function

// A game of the engine, offscreen in a process of its own, reading the scene it's asked for.
@Test
Function ARealGameReadsTheSavedScene() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local engine = Try Engine()
    Local program = "Import std.collections\nImport std.core\nImport std.io\nImport fbengine\n\nFunction Main() Throws IOError, GraphicsError\n    Window.SetHeadless(True)\n    Try Graphics(64, 64)\n    Assets.MountFolder(\"res://\", Path(\"assets\"))\n    Local asked = Scene.Requested()\n    If asked == Null Then Panic(\"no scene asked for\")\n    Local roots = Try Scene.Load(asked)\n    Print(\"read {{roots.Count}}, {{roots[0].Name()}} at {{roots[0].Position()}}\")\n    EndGraphics()\nEnd Function\n\nTry Main()\n"
    Local folder = Try Game(games.Path, "real", program, "fbengine = {{ path = \"{engine.Text.Replace("\\", "/")}\" }}\n")
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    editor.Actions.Run("add.cube")
    Local cube = editor.Edited.Entities()[0]
    cube.SetPosition(Vec3(1.5, 2, -3))
    cube.SetName("Crate")
    editor.SaveScene("res://level.scene")
    editor.Play()
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.ENDED && editor.Run.ExitCode() == 0, Said(editor))
    Expect(Said(editor).Contains("read 1, Crate at (1.5, 2, -3)"), Said(editor))
End Function
