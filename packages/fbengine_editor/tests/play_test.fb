// Scrolled up to read, it stays there; at the bottom, it follows.
@Test
Function ThePaneFollowsOnlyFromTheBottom() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try Game(games.Path, "scrolled", PLAIN)
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    editor.Docked.Show("output")
    For at = 1 To 200
        editor.Run.Log.Say("line {at}")
    End For
    editor.Step()
    editor.Step()
    Local scroller = Found(editor, "output.scroller") As? ScrollView
    If scroller == Null Then Panic("its scroller")
    Expect(scroller.MaxOffset() > 100.0 && scroller.Offset() == scroller.MaxOffset())
    scroller.SetOffset(50)
    editor.Step()
    Expect(scroller.Offset() == 50.0, "{scroller.Offset()}")
    editor.Run.Log.Say("more")
    editor.Step()
    editor.Step()
    Expect(scroller.Offset() == 50.0, "{scroller.Offset()}")
    scroller.SetOffset(scroller.MaxOffset())
    editor.Step()
    editor.Run.Log.Say("and more")
    editor.Step()
    editor.Step()
    Expect(scroller.Offset() == scroller.MaxOffset(),
           "{scroller.Offset()} of {scroller.MaxOffset()}")
    Expect(editor.Output.ShownLines()[editor.Output.ShownLines().Count - 1] == "and more")
End Function

// The engine's package: where ctest says, since what's above its build folder can be another
// checkout's, or above where a test's been run from by hand.
Function Engine(): Path Throws IOError
    Local said = Env.Get("FBENGINE_PACKAGES")
    If said != Null && said != "" Then Return Path(said) / "fbengine"
    Local here = Try Dir.Current()
    While !Dir.Exists(here / "packages" / "fbengine")
        If here.Parent() == here Then Panic("no packages/fbengine above here")
        here = here.Parent()
    End While
    Return here / "packages" / "fbengine"
End Function

// A game of the engine, offscreen in a process of its own, reading the scene it's asked for.
@Test
Function ARealGameReadsTheSavedScene() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local engine = Try Engine()
    Local program = "Import std.collections\nImport std.core\nImport std.io\nImport fbengine\n\nClass Door\n    Public Field Speed: Float = 1\nEnd Class\n\nFunction Main() Throws IOError, GraphicsError\n    Window.SetHeadless(True)\n    Try Graphics(64, 64)\n    Components.Add<Door>(\"Door\")\n    Assets.MountFolder(\"res://\", Path(\"assets\"))\n    Local asked = Try Scene.Requested()\n    If asked == Null Then Panic(\"no scene asked for\")\n    Local roots = Try Scene.Load(asked)\n    Print(\"read {{roots.Count}}, {{roots[0].Name()}} at {{roots[0].Position()}}, going {{roots[0].Data<Door>()?.Speed ?? 0}}\")\n    EndGraphics()\nEnd Function\n\nTry Main()\n"
    Local folder = Try Game(games.Path, "real", program,
                            "fbengine = {{ path = \"{engine.Text.Replace("\\", "/")}\" }}\n")
    Local editor = Try Started(settings.Path, folder)
    Defer editor.Finish()
    editor.Actions.Run("add.cube")
    Local cube = editor.Edited.Entities()[0]
    cube.SetPosition(Vec3(1.5, 2, -3))
    cube.SetName("Crate")
    Local door = Value.Object()
    door["Speed"] = Value(7.0)
    SetComponentsOf(cube, [ComponentData("Door", door)])
    editor.SaveScene("res://level.scene")
    editor.Play()
    StepUntil(editor, Function() => !editor.Run.Going())
    Expect(editor.Run.State() == PlayState.ENDED && editor.Run.ExitCode() == 0, Said(editor))
    Expect(Said(editor).Contains("read 1, Crate at (1.5, 2, -3), going 7"), Said(editor))
End Function
