// The editor's stability, headless, on lavapipe: thousands of scripted frames of a session, a
// project opened, a scene edited, undone and redone past both ends, saved, read again, played and
// stopped, and its docks moved, with the tree, the history, and what's held back where they were
// each time round; a project's, a scene's, and what's kept between runs' files changed at random,
// from a seed, each opened, opened with what's lost said, or refused with the file named; random
// runs of its commands, leaving a scene every entity of which is where the tree says; drags that
// lose their pane as they go; and a GPU lost while it runs, after which it draws again.

Import std.collections
Import std.core
From std.image Import Image, Png
Import std.io
Import std.math
Import std.os
Import std.test
Import std.text
Import std.time
Import fbengine
Import fbengine_editor
Import fbengine_ui

Global editorState: Int64 = 1

// Park and Miller's, from a seed of 1 or more.
Function EditorNext(n: Int): Int
    editorState = editorState * 48271 % 2147483647
    Return (editorState % n) As Int
End Function

Function StableNoGpu(): Bool => Env.Get("FBENGINE_NO_GPU") == "1"

// A game of std alone, quick to build, that says so and ends.
Const PLAYED = "Import std.core\n\nPrint(\"it played\")\n"

// A 16 by 16 KTX2 of UASTC, fbengine's tests' uastc.ktx2: compressed, so its thumbnail is the
// texture loaded, which holds its asset until it's freed.
Const STABLE_CHIP =
    "q0tUWCAyMLsNChoKAAAAAAEAAAAQAAAAEAAAAAAAAAAAAAAAAQAAAAEAAAAAAAAAaAAAACwAAACUAAAAMAAAAAAA" +
    "AAAAAAAAAAAAAAAAAADQAAAAAAAAAAABAAAAAAAAAAEAAAAAAAAsAAAAAAAAAAIAKACmAQIAAwMAABAAAAAAAAAA" +
    "AAB/AAAAAAAAAAAA/////ysAAABLVFh3cml0ZXIAVW5pZGVudGlmaWVkIGFwcCAvIGxpYmt0eCB2NC40LjIAAAAA" +
    "AAAAAAAAAAAAAIFT4wHQAR0AMIVTqIXaqP0BEQDiYDwOADzwNvA28DbwgVPLASwBHQAwhVOohdqn/YFCM+IRPA4A" +
    "8JzwnPCc8JzBKmjB8w4GAGxmMzMAAP//wTQIYXEOBABMozSBE3Ca+MEpaMH3DwYAbGYzMwAA//+BJeBgBAIKAKZ4" +
    "gWdwRvjOQVtzANC9EQAwdVOnhdqo/IEQKOBgfB8APPA28DbwNvBBW4sALL0RADB1U6eFyqj8gUIzIBJ8HwDwnPCc" +
    "8JzwnMENsMHzIgEAAAD//8zMmZnBZQMg8DYAABaAm/iJ93jVwVWDwucfAQAAAP//zMyamcFeK6IyFgAAcFb4zte8" +
    "xZs="

// A glTF of one triangle facing up: (0,0,0), (0,0,1), (1,0,0).
Const STABLE_TRIANGLE = "{{\"asset\":{{\"version\":\"2.0\"}},\"scene\":0,\"scenes\":[{{\"nodes\":[0]}}],\"nodes\":[{{\"name\":\"blade\",\"mesh\":0}}],\"meshes\":[{{\"primitives\":[{{\"attributes\":{{\"POSITION\":0}}}}]}}],\"accessors\":[{{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\",\"min\":[0,0,0],\"max\":[1,0,1]}}],\"bufferViews\":[{{\"buffer\":0,\"byteLength\":36}}],\"buffers\":[{{\"byteLength\":36,\"uri\":\"data:application/octet-stream;base64,AAAAAAAAAAAAAAAAAAAAAAAAAAAAAIA/AACAPwAAAAAAAAAA\"}}]}}"

// A game's folder in `at`, called `name`, with `program` as its main.fb if it's given one.
Function StableGame(at: Path, name: String, program: String = ""): Path Throws IOError
    Local folder = at / name
    Try Dir.CreateAll(folder / "assets")
    Local kind = program != "" ? "type = \"executable\"\n" : ""
    Try File.WriteText(folder / "project.toml",
                       "[project]\nname = \"{name}\"\nversion = \"0.1.0\"\n{kind}")
    If program != "" Then Try File.WriteText(folder / "main.fb", program)
    Try File.WriteText(folder / "assets" / "said.txt", name)
    Return folder
End Function

Function StableStarted(settings: Path, folder: Path? = Null,
                       trusted: Bool = False): Editor Throws IOError, GraphicsError
    Window.SetHeadless(True)
    Local editor = Try Editor(settings)
    Local game = folder
    If trusted && game != Null Then editor.Kept.Trust(game.Text)
    Try editor.Start(folder)
    editor.Step()
    Return editor
End Function

// Every node under `node`, and it.
Function StableNodes(node: Node): Int
    Local count = 1
    For child In node.Children()
        count += StableNodes(child)
    End For
    Return count
End Function

// Closes whatever dialog's showing, as Escape does.
Function Dismissed(editor: Editor) Throws GraphicsError
    For tries = 1 To 4
        If editor.ShowingDialog() == Null Then Return
        Try Simulate.PressKey(Key.ESCAPE)
        editor.Step()
        editor.ShowingDialog()?.Close()
        editor.Step()
    End For
End Function

// Steps until `done`, for what goes on outside the editor, as a build: a count of frames, each a
// little apart, never a clock.
Function StableUntil(editor: Editor, done: Func(): Bool)
    For frame = 1 To 60000
        If done() Then Return
        editor.Step()
        Sleep(2.Milliseconds)
    End For
End Function

// What can grow, as a session goes on.
Class Held Implements Printable
    Field Entities: Int
    Field Nodes: Int
    Field Textures: Int32
    Field Fonts: Int32
    Field Panes: Int
    Field Edits: Int
    Field Lines: Int

    Method ToString(): String
        Return "entities {Entities}, nodes {Nodes}, textures {Textures}, fonts {Fonts}, " +
               "panes {Panes}, edits {Edits}, lines {Lines}"
    End Method
End Class

Function Measured(editor: Editor, edits: Int): Held
    Local held = Held()
    held.Entities = editor.Edited.Entities().Count
    held.Nodes = StableNodes(editor.Shown.Root())
    held.Textures = Texture.Count()
    held.Fonts = Font.Count()
    held.Panes = editor.Docked.ShownPanes().Count
    held.Edits = edits
    // The editor's own lines, not a build's, whose count goes with how far it got when stopped.
    held.Lines = editor.Run.Log.Own()
    Return held
End Function

// One round of a session: a scene edited every way the tree edits one, undone and redone past
// both ends, its docks moved and put back, saved, and read again; how many edits the history kept
// before it was read again, which empties it.
Function Round(editor: Editor, round: Int): Int Throws GraphicsError
    Local scene = editor.Edited
    Local made: Entity[] = []
    For each = 1 To 4
        Local edit = MadeEdit("Add", scene, Function(): Entity => Pivot())
        editor.Edits.Commit(edit)
        Local entity = edit.Made()
        If entity != Null Then made.Add(entity)
        editor.Step()
    End For
    If made.Count == 4
        editor.Edits.Commit(RenameEdit(made[0], "named {round}"))
        editor.Edits.Commit(HideEdit([made[1]], True))
        editor.Edits.Commit(CopyEdit(scene, [made[0]]))
        editor.Edits.Commit(ReparentEdit(scene, [made[2]], made[3]))
        scene.SelectOnly(made[3])
        editor.Step()
        editor.Edits.Commit(RemoveEdit(scene, [made[1]]))
        editor.Step()
    End If
    // Undone past the first of them, redone past the last, and undone again.
    For each = 1 To 14
        editor.Edits.Undo()
        If each % 3 == 0 Then editor.Step()
    End For
    For each = 1 To 14
        editor.Edits.Redo()
        If each % 3 == 0 Then editor.Step()
    End For
    For each = 1 To 14
        editor.Actions.Run("edit.undo")
    End For
    editor.Step()
    Local edits = editor.Edits.Count()
    // Its docks: each pane beside another, hidden, shown, and all as they were at first.
    Local panes = editor.Docked.ShownPanes()
    If panes.Count >= 2
        Local moved = panes[round % panes.Count]
        Local target = panes[(round + 1) % panes.Count]
        editor.Docked.Move(moved, target, [DockSide.LEFT, DockSide.RIGHT, DockSide.TOP,
                                           DockSide.BOTTOM][round % 4], 0.3)
        editor.Step()
        editor.Docked.Hide(target)
        editor.Step()
        editor.Docked.Show(target)
        editor.Docked.Activate(moved)
        editor.Step()
    End If
    editor.DefaultLayout()
    editor.Step()
    editor.SaveScene("res://soak.scene")
    editor.Step()
    editor.OpenScene("res://soak.scene")
    editor.Step()
    Return edits
End Function

// The fb the tests run with, as FB says, or Null where it doesn't: the PATH's can be another.
Function TestsFb(): String?
    Local said = Env.Get("FB")
    Return said != Null && said != "" ? said : Null
End Function

// Plays the scene, by the fb the tests run with: to its end if `whole`, else stopped as it builds;
// what's wrong with how it went, or "".
Function Played(editor: Editor, whole: Bool): String
    editor.Play()
    editor.Step()
    If !editor.Run.Going() Then Return "it didn't start: {editor.Run.State()}"
    If !whole Then editor.Run.Stop()
    StableUntil(editor, Function() => !editor.Run.Going())
    Local said = editor.Run.Log.Lines().Join("\n")
    If whole && (editor.Run.State() != PlayState.ENDED || editor.Run.ExitCode() != 0 ||
                 !said.Contains("it played"))
        Return "it didn't play: {editor.Run.State()}: {said}"
    End If
    If !whole && editor.Run.State() != PlayState.STOPPED
        Return "it didn't stop: {editor.Run.State()}: {said}"
    End If
    Return ""
End Function

// Every round plays its scene with the fb the tests run with and stops it as it builds; rounds 3
// and 40 play it to its end, as a build of each is seconds. Where FB doesn't say which fb that is,
// the rounds don't play. The run's log is measured as it's left, never cleared.
@Test
Function ASessionOfThousandsOfFramesIsBackWhereItWasEachRound() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try StableStarted(settings.Path, Try StableGame(games.Path, "soak", PLAYED),
                                     True)
    Defer editor.Finish()
    Local fb = TestsFb()
    If fb != Null
        editor.Run.Fb = fb
    Else
        Print("the rounds don't play: FB doesn't say which fb the tests run with")
    End If
    Local frames = Frame.Count()
    Local warm: Held? = Null
    For round = 1 To 80
        Local edits = Try Round(editor, round)
        If fb != Null
            If round == 3 || round == 40
                Local wrong = Played(editor, True)
                Expect(wrong == "", "round {round}: {wrong}")
            End If
            Local wrong = Played(editor, False)
            Expect(wrong == "", "round {round}: {wrong}")
        End If
        Try Dismissed(editor)
        For each = 1 To 4
            editor.Step()
        End For
        Local now = Measured(editor, edits)
        Expect(now.Edits <= editor.Edits.Most(),
               "round {round}: the history keeps {now.Edits} of at most {editor.Edits.Most()}")
        Expect(now.Lines <= editor.Run.Log.Most(),
               "round {round}: the log keeps {now.Lines} of at most {editor.Run.Log.Most()}")
        If round < 3 Then Continue
        Local was = warm ?? now
        If warm == Null Then warm = now
        Expect(now.Entities == was.Entities, "round {round}: the scene grew: {was} then {now}")
        Expect(now.Nodes == was.Nodes, "round {round}: the UI's tree grew: {was} then {now}")
        Expect(now.Textures == was.Textures, "round {round}: textures: {was} then {now}")
        Expect(now.Fonts == was.Fonts, "round {round}: fonts: {was} then {now}")
        Expect(now.Panes == was.Panes, "round {round}: panes: {was} then {now}")
        Expect(now.Edits == was.Edits, "round {round}: the history: {was} then {now}")
        Expect(now.Lines == was.Lines, "round {round}: the editor's own lines: {was} then {now}")
        Expect(editor.ShowingDialog() == Null, "round {round}: a dialog's left showing")
    End For
    Expect(warm != Null)
    Expect((warm?.Edits ?? 0) > 0, "the history kept nothing to measure")
    Expect(Frame.Count() - frames >= 2000, "{Frame.Count() - frames} frames")
    Expect(editor.Current() != Null && editor.SceneFile() == "res://soak.scene")
End Function

// `bytes` cut short, or changed, at random.
Function Damaged(bytes: UInt8[]): UInt8[]
    Local made = bytes.Clone()
    Select EditorNext(5)
        Case 0
            Local kept: UInt8[] = []
            Local count = EditorNext(made.Count + 1)
            For at = 0 Until count
                kept.Add(made[at])
            End For
            Return kept
        Case 1, 2
            If made.Count == 0 Then Return made
            For each = 1 To 1 + EditorNext(6)
                made[EditorNext(made.Count)] = EditorNext(256) As UInt8
            End For
            Return made
        Case 3
            If made.Count == 0 Then Return made
            Local from = EditorNext(made.Count)
            For at = from Until Min(from + 1 + EditorNext(40), made.Count)
                made[at] = EditorNext(256) As UInt8
            End For
            Return made
        Default
            Return []
    End Select
End Function

// `bytes` damaged as Damaged does, but only the rest of them where any of `spared` is in them, each
// put back where it was, as far as what's left reaches: so the same seed does the same damage
// wherever `spared`, paths, are and however long they are on this OS. Bytes with none of them fail
// the test, as their damage would go with where that is.
Function DamagedBut(bytes: UInt8[], spared: String[]): UInt8[]
    Local text = String.FromUtf8(bytes) ?? ""
    // The text in pieces, and the path that ends each but the last.
    Local pieces: String[] = []
    Local between: String[] = []
    Local left = text
    While True
        Local first: Int? = Null
        Local found = ""
        For path In spared
            Local at = path != "" ? left.Find(path) : Null
            If at != Null && (first == Null || at < (first ?? 0)) Then first = at
            If at != Null && at == first Then found = path
        End For
        Local start = first
        If start == Null Then Break
        pieces.Add(left.Slice(0, start))
        between.Add(found)
        left = left.Slice(start + found.Length, left.Length)
    End While
    pieces.Add(left)
    If between.Count == 0
        Fail("none of {spared} is in what's damaged around it, so its damage goes with the OS")
        Return Damaged(bytes)
    End If
    Local rest = pieces.Join("").Bytes
    Local damaged = Damaged(rest)
    Local cut = damaged.Count < rest.Count
    Local made: UInt8[] = []
    Local at = 0
    For i = 0 Until pieces.Count
        Local count = pieces[i].Bytes.Count
        For j = at Until Min(at + count, damaged.Count)
            made.Add(damaged[j])
        End For
        at += count
        If i < pieces.Count - 1 && (!cut || at < damaged.Count) Then made.AddAll(between[i].Bytes)
    End For
    Return made
End Function

// What the editor's run says, as a notice of what was kept is said.
Function Logged(editor: Editor): String => editor.Run.Log.Lines().Join("\n")

// A project's file, a scene's, and what's kept between runs, each damaged from a seed. A scene
// opens whole, or opens with a dialog saying what of it's lost, or is refused in one that names
// it, the scene that was open left open; a project opens, or is refused in one that names its
// folder; and what's kept is read, or the editor starts as it does at first, saying which file.
@Test
Function FilesDamagedAtRandomOpenOrAreRefusedByName() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local good = Try StableGame(games.Path, "good")
    Local editor = Try StableStarted(settings.Path, good)
    editor.Actions.Run("add.cube")
    editor.Actions.Run("add.light")
    editor.SaveScene("res://level.scene")
    editor.Step()
    Expect(editor.ShowingDialog() == Null && editor.SceneFile() == "res://level.scene")
    Local scene = Try File.ReadBytes(good / "assets" / "level.scene")
    Local entities = editor.Edited.Entities().Count
    editorState = 5150
    Local outcomes = [0, 0, 0]

    // A scene's file; first, one whose cube's a mesh of a file that's gone, which opens saying so.
    Local text = String.FromUtf8(scene) ?? ""
    Expect(text.Contains("\"builtin:cube\""), "the scene has no cube: {text}")
    Local gone = text.Replace("\"builtin:cube\"", "\"res://gone.gltf#0\"").Bytes
    For round = 0 To 40
        Try File.WriteBytes(good / "assets" / "damaged.scene", round == 0 ? gone : Damaged(scene))
        editor.OpenScene("res://damaged.scene")
        editor.Step()
        Local dialog = editor.ShowingDialog()
        Local said = dialog?.Said() ?? ""
        If editor.SceneFile() == "res://damaged.scene"
            // Opened: whole, or saying what's lost.
            If dialog == Null
                outcomes[0] += 1
            Else
                outcomes[1] += 1
                Local title = dialog?.Title() ?? ""
                Expect(title == "Some of what that scene's made of is lost",
                       "seed 5150, round {round}: opened, with a dialog of {title}: {said}")
                Expect(said != "", "seed 5150, round {round}: what's lost isn't said")
            End If
        Else
            outcomes[2] += 1
            Expect(dialog != Null, "seed 5150, round {round}: neither opened nor refused")
            Expect(dialog?.Title() == "Couldn't open that scene",
                   "seed 5150, round {round}: refused, with a dialog of {dialog?.Title() ?? ""}")
            Expect(said.Contains("damaged.scene"),
                   "seed 5150, round {round}: a scene refused without its name: {said}")
            Expect(editor.SceneFile() == "res://level.scene" &&
                   editor.Edited.Entities().Count == entities,
                   "seed 5150, round {round}: a scene refused changed the one that was open")
        End If
        Try Dismissed(editor)
        Local wrong = Unsound(editor)
        Expect(wrong == "", "seed 5150, round {round}: {wrong}")
        editor.OpenScene("res://level.scene")
        editor.Step()
        Try Dismissed(editor)
        Expect(editor.Edited.Entities().Count == entities, "round {round}: the good scene")
    End For
    Expect(outcomes[0] > 0 && outcomes[1] > 0 && outcomes[2] > 0,
           "seed 5150: opened, lost, refused: {outcomes}")

    // A project's file.
    Local bad = Try StableGame(games.Path, "bad")
    Local folder = (Try bad.Absolute()).Text
    Local project = Try File.ReadBytes(bad / "project.toml")
    Local refused = 0
    For round = 1 To 40
        Try File.WriteBytes(bad / "project.toml", Damaged(project))
        editor.OpenFolder(bad)
        editor.Step()
        Local dialog = editor.ShowingDialog()
        Local opened = editor.Current()
        If opened != Null && opened.Folder.Text == folder
            Expect(dialog == Null, "seed 5150, round {round}: opened, and {dialog?.Said() ?? ""}")
            Try Dismissed(editor)
            editor.OpenFolder(good)
            editor.Step()
        Else
            refused += 1
            Expect(dialog != Null, "seed 5150, round {round}: neither opened nor refused")
            Local said = dialog?.Said() ?? ""
            Expect(said.Contains(folder),
                   "seed 5150, round {round}: a project refused without its folder: {said}")
            Expect(opened != Null && opened.Folder.Text != folder,
                   "round {round}: a project refused closed the one that was open")
        End If
        Try Dismissed(editor)
    End For
    Expect(refused > 0, "seed 5150: no project was refused")
    editor.Finish()

    // What's kept between runs: every file of it, damaged, one at a time.
    Local kept: Path[] = []
    For entry In Try Dir.Entries(settings.Path)
        If Dir.Exists(entry.Path)
            For inner In Try Dir.Entries(entry.Path)
                If !Dir.Exists(inner.Path) Then kept.Add(inner.Path)
            End For
        Else
            kept.Add(entry.Path)
        End If
    End For
    Expect(kept.Count >= 2, "{kept.Count} files were kept between runs")
    // What's kept has the projects' paths in it, which aren't damaged, as they're another length on
    // each OS; the rest is the same on each, and so is its damage.
    Local spared = [(Try good.Absolute()).Text, (Try bad.Absolute()).Text]
    Local noticed = 0
    For file In kept
        Local whole = Try File.ReadBytes(file)
        Local ofGood = (String.FromUtf8(whole) ?? "").Contains("good\"")
        Local preferences = file.FileName() == "preferences.txt"
        For round = 1 To 12
            Try File.WriteBytes(file, DamagedBut(whole, spared))
            Local again = Try StableStarted(settings.Path, good)
            again.Step()
            Local said = Logged(again)
            Local named = said.Contains(file.FileName())
            Expect(again.ShowingDialog() == Null, "{file.FileName()}, round {round}: a dialog")
            Expect(again.Current() != Null, "{file.FileName()}, round {round}: it didn't open")
            If named
                noticed += 1
                Expect(said.Contains("as it is at first"),
                       "{file.FileName()}, round {round}: {said}")
            End If
            If preferences
                // Read, it has the project just opened among the recent; else it says so.
                Expect(named != (again.Kept.Recent().Count > 0),
                       "{file.FileName()}, round {round}: read is {!named}, recent " +
                       "{again.Kept.Recent()}: {said}")
            ElseIf ofGood
                // Read, it's what was kept; else it's the panes as at first, and it says so.
                Expect(named != (again.Kept.Kept(good.Text) != Null),
                       "{file.FileName()}, round {round}: read is {!named}: {said}")
                If named
                    Local shown = "{again.Docked.Saved()}"
                    again.DefaultLayout()
                    Expect("{again.Docked.Saved()}" == shown,
                           "{file.FileName()}, round {round}: not as at first: {shown}")
                End If
            End If
            again.Finish()
            Try File.WriteBytes(file, whole)
        End For
    End For
    Expect(noticed > 0, "seed 5150: nothing kept was found damaged")
End Function

// What's wrong with the scene being edited, or "": an entity that isn't in it, or was removed, or
// whose parent isn't, or that's under itself, or isn't among its parent's children as the tree has
// them; a selection of what isn't there, or the inspector showing what's freed; or the focus on
// what isn't in the editor's UI.
Function Unsound(editor: Editor): String
    Local scene = editor.Edited
    Local all = scene.Entities()
    For entity In all
        If entity.Freed() Then Return "an entity listed was freed"
        If !scene.Has(entity) Then Return "{entity.Name()} is listed, and the scene hasn't it"
        If scene.IsRemoved(entity) Then Return "{entity.Name()} is listed, and was removed"
        Local parent = entity.Parent()
        If parent != Null && (!scene.Has(parent) || scene.IsRemoved(parent))
            Return "{entity.Name()}'s parent {parent.Name()} isn't in the scene"
        End If
        // Up from it, it's never met again, in as many steps as there are entities.
        Local up = parent
        Local steps = 0
        While up != Null
            If RefEquals(up, entity) || steps > all.Count
                Return "{entity.Name()} is under itself"
            End If
            up = up.Parent()
            steps += 1
        End While
        Local among = False
        For other In scene.SiblingsOf(parent)
            among = among || RefEquals(other, entity)
        End For
        If !among Then Return "{entity.Name()} isn't among its parent's children"
    End For
    For entity In scene.Selected()
        If entity.Freed() || !scene.Has(entity) || scene.IsRemoved(entity)
            Return "what's selected isn't in the scene"
        End If
    End For
    // The inspector catches up with what a key the UI took did at its next Update, so what it
    // shows may have been removed since, but never freed.
    For entity In editor.Inspector.ShownEntities()
        If entity.Freed() Then Return "the inspector shows what's been freed"
    End For
    Local focused = editor.Shown.Focused()
    If focused != Null
        Local at: Node? = focused
        Local held = False
        While at != Null
            held = held || RefEquals(at, editor.Shown.Root())
            For popup In editor.Shown.Popups()
                held = held || RefEquals(at, popup)
            End For
            at = at.Parent()
        End While
        If !held Then Return "the focus is on what isn't in the editor's UI"
    End If
    Return ""
End Function

// Its commands run at random, from a seed, two thousand of them, with what's selected changed at
// random between: after each, the scene's every entity is where the tree says, what's selected is
// in it, and the focus is on something that's there.
@Test
Function CommandsRunAtRandomLeaveASoundScene() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    // A frame's a 60th of a second, however long it takes, so what's timed by Frame.Delta, as the
    // view's camera, goes as the seed has it.
    Frame.SetFixedDelta(1.0 / 60.0)
    Defer Frame.SetFixedDelta(0)
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try StableStarted(settings.Path, Try StableGame(games.Path, "random"))
    Defer editor.Finish()
    editor.Run.Fb = (games.Path / "no such fb").Text
    editor.SaveScene("res://level.scene")
    editor.Step()
    // All of them but leaving, which ends the session.
    Local commands = editor.Actions.All().Filter(
        Function(each: EditorCommand) => each.Id != "file.quit" && each.Id != "file.close")
    Expect(commands.Count > 20, "{commands.Count} commands")
    editorState = 8086
    Local ran = 0
    For step = 1 To 2000
        Select EditorNext(8)
            Case 0
                Local all = editor.Edited.Entities()
                If all.Count > 0 Then editor.Edited.SelectOnly(all[EditorNext(all.Count)])
            Case 1
                Local all = editor.Edited.Entities()
                If all.Count > 0 Then editor.Edited.ToggleSelected(all[EditorNext(all.Count)])
            Case 2
                Try Dismissed(editor)
            Case 3
                Try Simulate.Text(["a", "b 2", "", "\u{301}", "res://level.scene"][EditorNext(5)])
                Try Simulate.PressKey([Key.RETURN, Key.ESCAPE, Key.TAB, Key.DELETE][EditorNext(4)])
            Default
                Local command = commands[EditorNext(commands.Count)]
                If command.Run() Then ran += 1
        End Select
        editor.Step()
        Local wrong = Unsound(editor)
        If wrong != ""
            Fail("seed 8086, step {step}: {wrong}")
            Return
        End If
        // A scene that's grown past 300 is emptied, as a new one is.
        If editor.Edited.Entities().Count > 300
            Try Dismissed(editor)
            editor.Actions.Run("file.new_scene")
            editor.Step()
            Try Dismissed(editor)
        End If
    End For
    Expect(ran > 500, "{ran} commands ran")
    Expect(!editor.Quitting())
End Function

// Where `point` in the world is in the window.
Function StableShown(editor: Editor, point: Vec3): Vec2
    Local at = editor.View.Viewer().Project(point)
    If at == Null Then Panic("{point} is behind the camera")
    Local scale = editor.Shown.Scale()
    Return Vec2(editor.View.Box().X * scale + at.x, editor.View.Box().Y * scale + at.y)
End Function

// Closes the current pane by a key, as a shortcut does, in the frame the UI reads it in, after
// what the pointer did.
Function ClosedByKey(editor: Editor) Throws GraphicsError
    If editor.Actions.Find("test.close") == Null
        editor.Actions.Add("test.close", "Close", Function[Weak editor]()
            Local own = editor
            If own != Null Then own.Actions.Run("view.close")
        End Function, Shortcut(Key.F9, False, False, False))
    End If
    Try Simulate.PressKey(Key.F9)
    editor.Step()
End Function

// A handle dragged while the pane it's in is closed, as a command's key closes it: the drag ends
// there, so what's done after it is an undo of its own, not more of the drag's.
@Test
Function AHandleDraggedAsItsPaneClosesEndsItsDrag() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try StableStarted(settings.Path, Try StableGame(games.Path, "closing"))
    Defer editor.Finish()
    editor.Step()
    editor.Actions.Run("add.cube")
    Local cube = editor.Edited.Selected()[0]
    cube.SetPosition(Vec3(1, 2, 3))
    editor.Step()
    editor.Edits.Clear()
    // The X arrow, held, and moved.
    Local tip = StableShown(editor, Vec3(1.4, 2, 3))
    Expect(editor.View.HandleAt(tip) == 0, "the X arrow isn't at {tip}")
    Try Simulate.MoveMouse(tip.x, tip.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MouseMotion(40, 0)
    editor.Step()
    Expect(editor.View.HandleHeld() && editor.Edits.UndoName() == "Move",
           "the handle isn't held: {editor.Edits.UndoName() ?? "nothing to undo"}")
    Expect(editor.Edits.Merging(), "a drag's steps aren't offered to merge")
    Local moved = cube.Position()
    // Its pane closed under it, the button still down.
    Expect(editor.Docked.CurrentPane() == "scene", "{editor.Docked.CurrentPane()} is current")
    Try ClosedByKey(editor)
    Expect(!editor.Docked.Showing("scene"))
    Expect(!editor.View.HandleHeld(), "the handle's still held")
    Expect(editor.Shown.Pressed() == Null, "the UI still holds what's pressed")
    // What's done next is its own undo.
    Expect(!editor.Edits.Merging(), "the drag's undo takes in what's done after it")
    Try Simulate.MouseMotion(40, 0)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    Expect(cube.Position() == moved, "it moved on once its pane was closed: {cube.Position()}")
    Expect(editor.Edits.Count() == 1 && editor.Edits.UndoName() == "Move")
    editor.Edits.Undo()
    Expect(cube.Position() == Vec3(1, 2, 3), "the drag's undo: {cube.Position()}")
End Function

// A pane's tab dragged while its pane's closed, by a shortcut in the frame the UI reads it, and by
// a command between frames: the drag's over, with nothing left of it, and the pane stays closed.
@Test
Function ATabDraggedAsItsPaneClosesIsLetGoOf() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try StableStarted(settings.Path, Try StableGame(games.Path, "tabs"))
    Defer editor.Finish()
    editor.Step()
    For byKey In [True, False]
        editor.DefaultLayout()
        editor.Step()
        Local tab = editor.Shown.Root().Find("tab.scene")
        If tab == Null Then Panic("there's no scene tab")
        Local from = tab.Box().Center
        Local over = editor.Inspector.Box().Center
        Try Simulate.MoveMouse(from.x, from.y)
        editor.Step()
        Try Simulate.MouseDown(MouseButton.LEFT)
        editor.Step()
        Try Simulate.MouseMotion(over.x - from.x, over.y - from.y)
        editor.Step()
        Expect(editor.Shown.Root().Find("dock.hint") == Null &&
               editor.Shown.Popups().Any(Function(each: Node) => each.Name() == "dock.hint"),
               "by key {byKey}: no hint shows where it would go")
        Expect(editor.Docked.CurrentPane() == "scene", "{editor.Docked.CurrentPane()} is current")
        If byKey
            Try ClosedByKey(editor)
        Else
            editor.Actions.Run("view.close")
            editor.Step()
        End If
        Local panes = editor.Docked.ShownPanes()
        Expect(!panes.Contains("scene"), "by key {byKey}: {panes}")
        Expect(editor.Shown.Popups().Count == 0, "by key {byKey}: the hint's left showing")
        Expect(editor.Shown.Pressed() == Null && editor.Shown.PressedButton() == MouseButton.LEFT,
               "by key {byKey}: the UI still holds what's pressed")
        // Moved on and let go, nothing goes anywhere.
        Try Simulate.MouseMotion(20, 20)
        editor.Step()
        Expect(editor.Shown.Popups().Count == 0,
               "by key {byKey}: a hint shows for a drag that's over")
        Try Simulate.MouseUp(MouseButton.LEFT)
        editor.Step()
        Expect(editor.Docked.ShownPanes() == panes,
               "by key {byKey}: {editor.Docked.ShownPanes()}, not {panes}")
    End For
End Function

// A scene that can't be opened is named once in what's said, whether it isn't there or what's in
// it is wrong.
@Test
Function ASceneThatCantBeOpenedIsNamedOnce() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try StableGame(games.Path, "named")
    Local editor = Try StableStarted(settings.Path, game)
    Defer editor.Finish()
    Try File.WriteText(game / "assets" / "wrong.scene", "format = 99\n")
    For path In ["res://missing.scene", "res://wrong.scene"]
        editor.OpenScene(path)
        editor.Step()
        Local said = editor.ShowingDialog()?.Said() ?? ""
        Local name = path.Slice(6, path.Length)
        Expect(said.Split(name).Count == 2,
               "{path} is named {said.Split(name).Count - 1} times: {said}")
        Try Dismissed(editor)
    End For
End Function

// The pixels of `image` in `box`, scaled by `scale`, brighter than the clear color.
Function Lit(image: Image, box: Rect, scale: Float32): Int
    Local seen = 0
    For y = ((box.Y * scale) As Int) Until (((box.Y + box.Height) * scale) As Int)
        For x = ((box.X * scale) As Int) Until (((box.X + box.Width) * scale) As Int)
            If x < 0 || y < 0 || x >= image.Width || y >= image.Height Then Continue
            Local pixel = image[x, y]
            If pixel.r > 40 || pixel.g > 40 || pixel.b > 40 Then seen += 1
        End For
    End For
    Return seen
End Function

// Steps until the thumbnails of `paths` are made, as far as they're going to be.
Function Thumbed(editor: Editor, paths: String[])
    For path In paths
        editor.Files.ThumbOf(path)
    End For
    StableUntil(editor,
                Function() => paths.All(Function(path: String) => editor.Files.ThumbDone(path)))
    editor.Step()
End Function

// Whether the thumbnail of `path` is there, and draws.
Function ThumbDrawn(editor: Editor, path: String): Bool
    Local thumb = editor.Files.ThumbOf(path)
    Return thumb != Null && !thumb.Texture().Freed()
End Function

// The screen, as the editor draws it with nothing focused, whose caret would blink.
Function StableScreen(editor: Editor): Image Throws GraphicsError
    editor.Shown.Focus(Null)
    editor.Step()
    Return Try Screen.ToImage()
End Function

// A GPU lost while the editor runs, as a driver's crash or reset loses it: its frames make it
// again, saying so, and then the editor draws what it drew, its view of the scene and its
// thumbnails, and a thumbnail asked for while it was lost is made then.
@Test
Function TheEditorDrawsAgainOnceALostGpuIsMadeAgain() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try StableGame(games.Path, "lost")
    Local image = Image(16, 16)
    For y = 0 Until 16
        For x = 0 Until 16
            image[x, y] = Color32((x * 16) As UInt8, 200, (y * 16) As UInt8, 255)
        End For
    End For
    Try File.WriteBytes(game / "assets" / "wall.png", Png.Encode(image))
    Try File.WriteText(game / "assets" / "ball.gltf", STABLE_TRIANGLE)
    // In a folder that's closed, so it has no row to show.
    Try Dir.CreateAll(game / "assets" / "sub")
    Try File.WriteBytes(game / "assets" / "sub" / "late.png", Png.Encode(image))
    Local editor = Try StableStarted(settings.Path, game)
    Defer editor.Finish()
    editor.Actions.Run("add.cube")
    editor.Actions.Run("add.light")
    editor.Docked.Activate("assets")
    editor.Docked.Activate("scene")
    Local thumbs = ["res://wall.png", "res://ball.gltf"]
    Thumbed(editor, thumbs)
    For frame = 1 To 6
        editor.Step()
    End For
    For path In thumbs
        Expect(ThumbDrawn(editor, path), "{path} has no thumbnail")
    End For
    // As it's left typing in a field, whose caret blinks by the clock.
    editor.Shown.Focus(editor.Tree.FindField())
    Local before = Try StableScreen(editor)
    Local scale = editor.Shown.Scale()
    Local seen = Lit(before, editor.View.Box(), scale)
    Expect(seen > 100, "the view showed {seen} pixels of its scene")
    Local row = editor.Files.RowOf("res://wall.png")?.Find("assets.thumb")
    Local thumbed = row != Null ? Lit(before, row.Box(), scale) : 0
    Expect(thumbed > 20, "the picture's row showed {thumbed} pixels of it")

    Local stops = Gpu.Stops()
    Try Gpu.SimulateLoss()
    editor.Files.ThumbOf("res://sub/late.png")
    For frame = 1 To 6
        editor.Step()
    End For
    Expect(!Gpu.Lost() && Gpu.Started(), "the editor left the GPU lost")
    Expect(Gpu.Stops() == stops + 1, "the GPU was stopped {Gpu.Stops() - stops} times")
    Local said = editor.Output.ShownLines().Join("\n")
    Expect(said.Contains("The GPU was lost") && said.Contains("The GPU's made again."),
           "the Output pane says {said}")
    Local all = ["res://wall.png", "res://ball.gltf", "res://sub/late.png"]
    Thumbed(editor, all)
    Local target = editor.View.Target()
    Expect(target != Null && !target.Freed(), "the view has no texture to draw into")
    For path In all
        Expect(ThumbDrawn(editor, path), "{path} isn't drawn once the GPU's made again")
    End For
    Local after = Try StableScreen(editor)
    Expect(after.Width == before.Width && after.Height == before.Height)
    Local differing = 0
    For y = 0 Until Min(before.Height, after.Height)
        For x = 0 Until Min(before.Width, after.Width)
            If before[x, y] != after[x, y] Then differing += 1
        End For
    End For
    Expect(differing == 0, "{differing} pixels differ once the GPU's made again")
    Expect(editor.View.TextureFailures() == 0)
End Function

// Thumbnails loading as the GPU's lost, stopped, and started again let go of what they loaded,
// whether it landed before the stop or after it, and what they were, so the textures and the holds
// on assets, which a Model and a compressed image's thumbnail keep until they're freed, are as
// they were once the thumbnails are made again; and a folder let go of while they load lets go of
// what they load, which lands once it's gone, and one let go of with them made, of them.
@Test
Function ThumbnailsLoadingAcrossAStopLetGoOfWhatTheyLoaded() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local game = Try StableGame(games.Path, "across")
    Local image = Image(16, 16)
    For y = 0 Until 16
        For x = 0 Until 16
            image[x, y] = Color32(200, (x * 16) As UInt8, (y * 16) As UInt8, 255)
        End For
    End For
    Try File.WriteBytes(game / "assets" / "wall.png", Png.Encode(image))
    Try File.WriteText(game / "assets" / "ball.gltf", STABLE_TRIANGLE)
    Local chip = Base64.Decode(STABLE_CHIP)
    Expect(chip != Null, "the KTX2 isn't base64")
    Try File.WriteBytes(game / "assets" / "chip.ktx2", chip ?? [])
    Local editor = Try StableStarted(settings.Path, game)
    Defer editor.Finish()
    editor.Docked.Activate("assets")
    Local unthumbed = Texture.Count()
    Local unheld = Assets.Holds()
    Local thumbs = ["res://wall.png", "res://ball.gltf", "res://chip.ktx2"]
    Thumbed(editor, thumbs)
    Local textures = Texture.Count()
    Local holds = Assets.Holds()
    // The compressed one's is the texture loaded, holding its asset.
    Expect(holds > unheld, "the thumbnails hold {holds} assets, as many as none did")
    For round = 1 To 3
        // Made again, so every thumbnail's asked for again, and its load's begun.
        Gpu.Stop()
        Try Gpu.Start()
        editor.Step()
        Expect(thumbs.Any(Function(path: String) => !editor.Files.ThumbDone(path)),
               "round {round}: no thumbnail was loading")
        Try Gpu.SimulateLoss()
        Gpu.Stop()
        Try Gpu.Start()
        Thumbed(editor, thumbs)
        For path In thumbs
            Expect(ThumbDrawn(editor, path), "round {round}: {path} isn't drawn")
        End For
        Expect(Texture.Count() == textures,
               "round {round}: {Texture.Count()} textures, not {textures}")
        Expect(Assets.Holds() == holds, "round {round}: {Assets.Holds()} holds, not {holds}")
    End For
    // Made again, so their loads are begun again, and the folder let go of before they land.
    Gpu.Stop()
    Try Gpu.Start()
    editor.Step()
    Local flying = editor.Files.ThumbsLoading()
    Expect(flying > 0, "no thumbnail was loading")
    editor.Files.SetFolder(Null)
    Expect(editor.Files.ThumbsHeld() == 0, "{editor.Files.ThumbsHeld()} thumbnails are held")
    // Each load lands, on the workers however long they take, and is let go of; then two frames
    // for what waited on them to go on.
    StableUntil(editor, Function(): Bool => Assets.Loads() == 0)
    Expect(Assets.Loads() == 0, "{Assets.Loads()} loads never landed")
    editor.Step()
    editor.Step()
    Expect(Assets.Holds() == unheld,
           "{flying} loads outlived their folder: {Assets.Holds()} holds, not {unheld}")
    Expect(Texture.Count() == unthumbed,
           "{flying} loads outlived their folder: {Texture.Count()} textures, not {unthumbed}")
    // Its thumbnails made again, and the folder let go of with them held.
    editor.Files.SetFolder(game / "assets")
    Thumbed(editor, thumbs)
    Expect(editor.Files.ThumbsHeld() == thumbs.Count,
           "{editor.Files.ThumbsHeld()} thumbnails are held, not {thumbs.Count}")
    Expect(Assets.Holds() == holds, "made again: {Assets.Holds()} holds, not {holds}")
    editor.Files.SetFolder(Null)
    Expect(Assets.Holds() == unheld, "let go of: {Assets.Holds()} holds, not {unheld}")
    Expect(Texture.Count() == unthumbed,
           "let go of: {Texture.Count()} textures, not {unthumbed}")
End Function

// How many of the lines the Run pane has said contain `text`.
Function SaidLines(editor: Editor, text: String): Int
    Return editor.Run.Log.Lines().Filter(Function(line: String) => line.Contains(text)).Count
End Function

// A GPU lost again each frame, as a driver that's failing loses it: the editor waits longer each
// time before it makes it again, up to 8 seconds, timed by frames, so its starts and what it says
// are few; and once the losses stop, it draws again, and a loss after it's stayed up a while is
// made again at once.
@Test
Function AGpuLostEachFrameIsMadeAgainLessAndLessOften() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try StableStarted(settings.Path, Try StableGame(games.Path, "failing"))
    Defer editor.Finish()
    Frame.SetFixedDelta(1.0 / 60.0)
    Defer Frame.SetFixedDelta(0)
    For frame = 1 To 4
        editor.Step()
    End For
    Local stops = Gpu.Stops()
    Local lines = editor.Run.Log.Own()
    // Ten seconds: made again at once, then after 1, 2, and 4 seconds, and then not for 8.
    For frame = 1 To 600
        Try? Gpu.SimulateLoss()
        editor.Step()
    End For
    Local starts = (Gpu.Stops() - stops) As Int
    Expect(starts >= 3 && starts <= 5, "the GPU was made again {starts} times in 600 frames")
    // That it was lost, once; that it waits, once for the back-off; and each time it's made again.
    Local lost = SaidLines(editor, "The GPU was lost, as a driver's crash")
    Expect(lost == 1, "the Output pane said the GPU was lost {lost} times")
    Local waits = SaidLines(editor, "so it waits before it's made again")
    Expect(waits == 1, "the Output pane said the GPU waits {waits} times")
    Local made = SaidLines(editor, "The GPU's made again.")
    Expect(made == starts, "the Output pane said the GPU's made again {made} times, not {starts}")
    Local said = editor.Run.Log.Own() - lines
    Expect(said == starts + 2, "the Output pane said {said} lines, not {starts + 2}")
    For frame = 1 To 600
        editor.Step()
        If Gpu.Started() && !Gpu.Lost() Then Break
    End For
    Expect(Gpu.Started() && !Gpu.Lost(), "the editor left the GPU lost")
    For frame = 1 To 120
        editor.Step()
    End For
    Local remade = Gpu.Stops()
    Try Gpu.SimulateLoss()
    editor.Step()
    Expect(Gpu.Stops() == remade + 1 && Gpu.Started() && !Gpu.Lost(),
           "a loss after the GPU stayed up two seconds waited")
    Local target = editor.View.Target()
    Expect(target != Null && !target.Freed(), "the view has no texture to draw into")
End Function

// A GPU lost whose next two Starts fail, as a reset that takes a while fails them: nothing starts
// it while the editor waits, which tries again each second, timed by frames, and says why once;
// the third Start works, and the editor draws again by itself.
@Test
Function ALostGpuThatWontStartIsTriedEachSecondUntilItDoes() Throws IOError, GraphicsError
    If StableNoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try StableStarted(settings.Path, Try StableGame(games.Path, "retried"))
    Defer editor.Finish()
    editor.Actions.Run("add.cube")
    editor.Actions.Run("add.light")
    editor.Docked.Activate("scene")
    Frame.SetFixedDelta(1.0 / 60.0)
    Defer Frame.SetFixedDelta(0)
    For frame = 1 To 4
        editor.Step()
    End For
    Local before = Try StableScreen(editor)
    Local scale = editor.Shown.Scale()
    Expect(Lit(before, editor.View.Box(), scale) > 100, "the view showed nothing of its scene")
    Local lines = editor.Run.Log.Own()
    Try Gpu.SimulateLoss(2)
    // Stopped and failed in the first frame, failed again a second on, and started a second
    // after that: 120 frames, give or take one for the sum of sixtieths.
    Local started = 0
    For frame = 1 To 240
        editor.Step()
        If started == 0 && Gpu.Started() && !Gpu.Lost() Then started = frame
    End For
    Expect(started >= 119 && started <= 123, "the GPU started again in frame {started}")
    Local said = editor.Run.Log.Lines()
    Local failed = said.Filter(Function(line: String) => line.Contains("couldn't be made again"))
    Expect(failed.Count == 1, "why it couldn't start was said {failed.Count} times")
    Expect(said.Any(Function(line: String) => line == "The GPU's made again."),
           "the Output pane never said the GPU's made again")
    Expect(editor.Run.Log.Own() - lines <= 4, "{editor.Run.Log.Own() - lines} lines were said")
    Local target = editor.View.Target()
    Expect(target != Null && !target.Freed(), "the view has no texture to draw into")
    Local after = Try StableScreen(editor)
    Expect(Lit(after, editor.View.Box(), scale) > 100,
           "the view shows nothing once the GPU's made again")
End Function
