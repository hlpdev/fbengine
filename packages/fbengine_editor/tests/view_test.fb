    Try Simulate.MouseMotion(30, 0)
    editor.Step()
    Expect(!editor.View.HandleHeld(), "the drag went on with nothing to drag")
    Try Letting(editor)
    // What undoes it passes over what's gone.
    editor.Edits.Undo()
    editor.Edits.Redo()
    editor.Finish()
End Function

