    Expect(Abs(turned.y) > 0.01, "it hasn't turned: {turned}")
    editor.Finish()
End Function

@Test
Function FramingSeesAllThatsSelected() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local left = Cube(editor, Vec3(-50, 1, 0))
    Local right = Cube(editor, Vec3(50, 1, 0))
    editor.Edited.SelectOnly(left)
    editor.Edited.ToggleSelected(right)
    editor.Step()
    Try Simulate.PressKey(Key.F)
    editor.Step()
    editor.Step()
    Local box = editor.View.Box()
    For entity In [left, right]
        Local at = Shown(editor, entity.Position(Space.WORLD))
        Expect(box.Contains(at), "{at} isn't in {box}")
    End For
    // A mesh with a big geometry at a scale of 1, from outside it.
    Local big = Mesh(Geometry.Cube())
    Local huge = Geometry.Cube()
    For i = 0 To 0
        huge.Add(Geometry.Cube(), Mat4.Scale(Vec3(40, 40, 40)))
    End For
    big.SetGeometry(huge)
    editor.Edited.SelectOnly(big)
    editor.View.FrameSelected()
    Expect(editor.View.ViewDistance() > 69, "it's inside it, at {editor.View.ViewDistance()}")
    // Not past where the camera sees.
    big.SetScale(Vec3(1000000, 1000000, 1000000))
    editor.View.FrameSelected()
    Expect(editor.View.ViewDistance() < editor.View.Viewer().Far())
    editor.Finish()
End Function

@Test
Function HandlesGoWithWhatShows() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
