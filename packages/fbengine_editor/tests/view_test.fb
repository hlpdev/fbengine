    light.Show()
    editor.Step()
    editor.Edits.Undo()
    editor.Step()
    Expect(!editor.Edited.Lamp.Hidden(), "undone, there's no light")
    editor.Finish()
End Function

@Test
Function WhatsFreedLetsGo() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
