    Local cube = Cube(editor, Vec3(0, 1, 0))
    cube.Free()
    editor.Step()
    editor.Step()
    Expect(editor.Edited.Selected().Count == 0)
    Local other = Cube(editor, Vec3(0, 1, 0))
    Local from = OnHandle(editor, Vec3(0, 1, 0), Vec3(1, 0, 0), 0)
    Try Held(editor, from, from + Vec2(30, 0))
