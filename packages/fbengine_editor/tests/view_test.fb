    Try Drag(editor, center, center + Vec2(0, -90), MouseButton.MIDDLE)
    editor.Step()
    Local middle = Shown(editor, Vec3(0, 0, 0))
    Local grab = Vec2(0, 0)
    For x = 10 To 200
