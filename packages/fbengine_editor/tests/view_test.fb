@Test
Function WhatsSelectedShowsThroughWhatsInFrontOfIt() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local target = editor.View.Target()
    If target == Null
        Fail("there's no texture")
        Return
    End If
    // A big cube right in front of a small one, seen through which only its outline can be.
    Local behind = Cube(editor, Vec3(0, 1, 0))
    Local camera = editor.View.Viewer().Position(Space.WORLD)
    Local front = Cube(editor, Lerp(Vec3(0, 1, 0), camera, 0.4))
    front.SetScale(Vec3(3, 3, 3))
    // Handles at another, so what's there's only the outline.
    Local elsewhere = Cube(editor, Vec3(-6, 1, 6))
    editor.Edited.SelectOnly(elsewhere)
    editor.Step()
    Local plain = target.ToImage()
    editor.Edited.SelectOnly(behind)
    editor.Edited.ToggleSelected(elsewhere)
    editor.Step()
    Local outlined = target.ToImage()
    Local at = Shown(editor, Vec3(0, 1, 0))
    Local box = editor.View.Box()
    Local x = (at.x - box.X) As Int32
    Local y = (at.y - box.Y) As Int32
    Local differ = 0
    For dx = -25 To 25
        For dy = -25 To 25
            If outlined[x + dx, y + dy] != plain[x + dx, y + dy] Then differ += 1
        End For
    End For
    Expect(differ > 5, "only {differ} pixels show it through what's in front")
    editor.Finish()
End Function

@Test
Function AtAnotherScaleItsPointerAndHandlesAreWhereTheyShow() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    editor.Shown.SetScale(2.0)
    editor.Step()
    editor.Step()
    Local box = editor.View.Box()
    Local target = editor.View.Target()
    Expect(target != Null && target.Width() == Round(box.Width * 2) As Int32,
           "it's not at the UI's scale")
    Local cube = Cube(editor, Vec3(0, 1, 0))
    editor.Step()
    // Lit over the arrow, at the point the pointer's at.
    Local tip = Shown(editor, Vec3(0.8, 1, 0))
    Expect(editor.View.HandleAt(tip * 0.5) == 0, "the arrow's not under the pointer")
    Try Simulate.MoveMouse(tip.x, tip.y)
    editor.Step()
    editor.Step()
    Expect(editor.View.LitHandle() == 0, "it's lit as {editor.View.LitHandle()}")
    // Its reach is in the UI's units: 6 of them off it, 12 in the window, still has it.
    Local start = Shown(editor, Vec3(0.3, 1, 0))
    Local across = Normalize(tip - start)
    Local off = tip + Vec2(-across.y, across.x) * 12
    Expect(editor.View.HandleAt(off * 0.5) == 0, "12 window units from the arrow it's not had")
    // And as long on the screen, in the UI's units, as at a scale of 1.
    Local middle = Shown(editor, Vec3(0, 1, 0))
    Local length = Distance(middle,
                            Shown(editor,
                                  Vec3(0, 1, 0) +
                                  editor.View.Viewer().Up() * editor.View.HandleLength()))
    Expect(Abs(length - HANDLE_LENGTH * 2) < 2, "it's {length} long on the window")
    // Dragged, it goes along.
    Try Drag(editor, tip, Shown(editor, Vec3(3, 1, 0)))
    Expect(Abs(cube.Position().x - 2.2) < 0.1, "it's at {cube.Position()}")
    editor.Finish()
End Function

@Test
Function ACopyStillThereIsntFreedWhenItsEditsForgotten() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local cube = Cube(editor, Vec3(0, 1, 0))
    Local short = History(1)
    Local copying = CopyEdit(editor.Edited, [cube])
    short.Commit(copying)
    Local copy = copying.Copies()[0]
    short.Commit(EditOf("other", Function()
    End Function, Function()
    End Function))
    Expect(!copy.Freed(), "it's in the scene, and it was freed")
    editor.Finish()
End Function
