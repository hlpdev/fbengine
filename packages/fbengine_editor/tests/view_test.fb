    parent.Hide()
    Expect(editor.View.HandleAt(tip) == -1, "a hidden thing's handle's there")
    // Selected still, for what it's selected for.
    Expect(editor.Edited.IsSelected(child))
    // A light under what's hidden has no mark, and isn't picked.
    Local lamp = Light(LightType.POINT, parent)
    lamp.SetPosition(Vec3(-3, 0, 0))
    Expect(editor.View.Over().ShowMarks(editor.Edited.Entities(),
                                        Function(entity: Entity) => False) == 0)
    editor.Step()
    Expect(editor.View.PickAt(Shown(editor, Vec3(-3, 1, 0))) == Null, "what's hidden was picked")
    parent.Show()
    editor.Step()
    Expect(editor.View.Over().ShowMarks(editor.Edited.Entities(),
                                        Function(entity: Entity) => False) == 1)
    editor.Finish()
End Function

@Test
Function AnUndoUnderAParentIsExact() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local parent = Pivot()
    parent.SetRotation(Quat.FromAxisAngle(Normalize(Vec3(1, 2, 3)), 0.7))
    parent.SetScale(Vec3(2, 3, 4))
    Local child = Mesh(Geometry.Cube(), parent)
    child.SetPosition(Vec3(0.1, 0.2, 0.3))
    child.SetRotation(Quat.FromAxisAngle(Vec3(0, 1, 0), 0.3))
    child.SetScale(Vec3(0.7, 0.7, 0.7))
    editor.Edited.SelectOnly(child)
    editor.Step()
    Local position = child.Position()
    Local rotation = child.Rotation()
    Local scale = child.Scale()
    Local world = child.Position(Space.WORLD)
    Local tip = OnHandle(editor, world, Vec3(1, 0, 0), 0)
    Try Drag(editor, tip, tip + Vec2(50, 0))
    Expect(child.Position() != position)
    editor.Edits.Undo()
    Expect(child.Position() == position && child.Rotation() == rotation && child.Scale() == scale,
           "it's at {child.Position()}, {child.Rotation()}, {child.Scale()}")
    // Its own scale, under a parent's: a local handle's, not the world's.
    Try Simulate.PressKey(Key.R)
    editor.Step()
    editor.Step()
    Local middle = Shown(editor, world)
    Try Drag(editor, middle, middle + Vec2(55, 0))
    Expect(Abs(child.Scale().y / 0.7 - child.Scale().x / 0.7) < 0.001 && child.Scale().x > 0.8,
           "it's {child.Scale()}")
    Expect(Abs(child.Scale().x - 0.7 * (1 + 55.0 / 110)) < 0.01, "it's {child.Scale()}")
    editor.Finish()
End Function

@Test
Function NoChangeIsNoEdit() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local cube = Cube(editor, Vec3(0, 1, 0))
    editor.Edits.Clear()
    editor.View.Snap.On = True
    Local tip = OnHandle(editor, Vec3(0, 1, 0), Vec3(1, 0, 0), 0)
    // Under half a step, in one step and in several.
    For steps In [1, 4]
        Try Drag(editor, tip, tip + Vec2(2, 0), MouseButton.LEFT, steps)
        Expect(!editor.Edits.CanUndo() && !editor.Edits.Modified(), "in {steps}, there's an edit")
    End For
    // Away and back, in one drag: nothing either.
    Local far = Shown(editor, Vec3(2.5, 1, 0))
    Try Held(editor, tip, far)
    Expect(editor.Edits.CanUndo() && cube.Position().x > 0.5)
    Try Simulate.MouseMotion(tip.x - far.x, tip.y - far.y)
    editor.Step()
    Expect(!editor.Edits.CanUndo() && !editor.Edits.Modified(), "there's an edit that does nothing")
    Expect(cube.Position() == Vec3(0, 1, 0))
    // Still there, a little further, nothing either.
    Try Simulate.MouseMotion(1, 0)
    editor.Step()
    Expect(!editor.Edits.CanUndo(), "there's an edit that does nothing")
    Try Simulate.MouseMotion(-1, 0)
    editor.Step()
    // And away again, one edit, undoing to the start.
    Try Simulate.MouseMotion(far.x - tip.x, far.y - tip.y)
    editor.Step()
    Try Letting(editor)
    Expect(editor.Edits.CanUndo())
    editor.Edits.Undo()
    Expect(!editor.Edits.CanUndo() && cube.Position() == Vec3(0, 1, 0))
    editor.Finish()
End Function

