@Test
Function ATurnFollowsThePointerRoundWhateverItsTurned() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local cube = Cube(editor, Vec3(0, 1, 0))
    Local start = Normalize(Quat.FromAxisAngle(Normalize(Vec3(1, 0, 1)), 0.6))
    cube.SetRotation(start)
    Try Simulate.PressKey(Key.E)
    editor.Step()
    editor.Step()
    // In the world, around Y: what was under the pointer's gone where it is.
    Local grab, to = OnRing(editor, Vec3(0, 1, 0), Vec3(0, 1, 0), Vec3(1, 0, 0), 1, 0.8)
    Try Drag(editor, grab, to)
    Local turn = Normalize(cube.Rotation(Space.WORLD) * Inverse(start))
    Local axis = Normalize(Vec3(turn.x, turn.y, turn.z))
    Expect(Abs(Abs(axis.y) - 1) < 0.01, "it turned about {axis}, not Y")
    // The pointer went from X toward -Z, which about Y is positive, by the right-hand rule.
    Local angle = 2 * Atan2(turn.y, turn.w)
    Expect(Abs(angle - 0.8) < 0.1, "it turned {angle}, not the way the pointer went")
    editor.Edits.Undo()
    // In its own axes: around its own Y, which stays where it is.
    Try Simulate.PressKey(Key.X)
    editor.Step()
    editor.Step()
    Local own = cube.Rotation(Space.WORLD) * Vec3(0, 1, 0)
    Local across = cube.Rotation(Space.WORLD) * Vec3(1, 0, 0)
    Local onOwn, toOwn = OnRing(editor, Vec3(0, 1, 0), own, across, 1, 0.8)
    Try Drag(editor, onOwn, toOwn)
    Local now = cube.Rotation(Space.WORLD)
    Expect(Length(now * Vec3(0, 1, 0) - own) < 0.01, "its Y moved")
    Expect(Length(now * Vec3(1, 0, 0) - across) > 0.2, "its X didn't")
    editor.Finish()
End Function

@Test
Function EachScaleHandleScalesItsOwnAxisOfWhatsTurned() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local cube = Cube(editor, Vec3(0, 1, 0))
    Local turned = Quat.FromAxisAngle(Vec3(0, 1, 0), 0.5)
    cube.SetRotation(turned)
    Try Simulate.PressKey(Key.R)
    editor.Step()
    editor.Step()
    // In the world's axes, it's still by its own.
    Expect(editor.View.Axes == HandleSpace.WORLD)
    Local length = editor.View.HandleLength()
    Local xWay = turned * Vec3(1, 0, 0)
    Local xFrom = Along(editor, Vec3(0, 1, 0), xWay, 0)
    Try Drag(editor, Shown(editor, Vec3(0, 1, 0) + xWay * xFrom),
             Shown(editor, Vec3(0, 1, 0) + xWay * (xFrom + 1)))
    Expect(Abs(cube.Scale().x - (1 + 1 / length)) < 0.03,
           "it's {cube.Scale()}, of a length of {length}")
    Expect(cube.Scale().y == 1 && cube.Scale().z == 1, "it's {cube.Scale()}")
    editor.Edits.Undo()
    Local zWay = turned * Vec3(0, 0, 1)
    Local zFrom = Along(editor, Vec3(0, 1, 0), zWay, 2)
    Try Drag(editor, Shown(editor, Vec3(0, 1, 0) + zWay * zFrom),
             Shown(editor, Vec3(0, 1, 0) + zWay * (zFrom + 1)))
    Expect(Abs(cube.Scale().z - (1 + 1 / length)) < 0.03,
           "it's {cube.Scale()}, of a length of {length}")
    Expect(cube.Scale().x == 1 && cube.Scale().y == 1, "it's {cube.Scale()}")
    editor.Finish()
End Function

