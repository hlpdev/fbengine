@Test
Function MarksGoWithWhatTheyMarkAndAHandleLightsUp() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local target = editor.View.Target()
    If target == Null
        Fail("there's no texture")
        Return
    End If
    Local cube = Cube(editor, Vec3(0, 1, 0))
    Local over = editor.View.Over()
    editor.Step()
    // Two outlined, then one: one mark less, and the handles as they were.
    Local other = Cube(editor, Vec3(3, 1, 0))
    editor.Edited.ToggleSelected(cube)
    editor.Step()
    Local marked = over.Viewer.Draws().Count
    editor.Edited.SelectOnly(cube)
    editor.Step()
    Expect(over.Viewer.Draws().Count == marked - 1,
           "it was {marked}, and it's {over.Viewer.Draws().Count}")
    Expect(!other.Freed())
    // Selected again, and the pointer on an arrow.
    editor.Edited.SelectOnly(cube)
    Try Simulate.MoveMouse(0, 0)
    editor.Step()
    editor.Step()
    Local plain = target.ToImage()
    Local arrow = Shown(editor, Vec3(0.5, 1, 0))
    Try Simulate.MoveMouse(arrow.x, arrow.y)
    editor.Step()
    editor.Step()
    Local lit = target.ToImage()
    Local differ = 0
    For x = 0 To lit.Width - 1
        For y = 0 To lit.Height - 1
            If lit[x, y] != plain[x, y] Then differ += 1
        End For
    End For
    Expect(differ > 10, "only {differ} pixels changed under the pointer")
    editor.Finish()
End Function

@Test
Function WhatsUnderWhatElseIsSelectedMovesOnce() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local parent = Cube(editor, Vec3(0, 1, 0))
    Local child = Mesh(Geometry.Cube(), parent)
    child.SetPosition(Vec3(2, 0, 0))
    // The child selected first: the parent's the one handles go by.
    editor.Edited.SelectOnly(child)
    editor.Edited.ToggleSelected(parent)
    editor.Step()
    Local world = child.Position(Space.WORLD)
    Local local = child.Position()
    Local tip = OnHandle(editor, Vec3(0, 1, 0), Vec3(1, 0, 0), 0)
    Try Drag(editor, tip, Shown(editor, Vec3(2, 1, 0)))
    Local gone = parent.Position().x
    Expect(gone > 0.5, "it went {gone}")
    Expect(child.Position() == local, "the child's own place changed: {child.Position()}")
    Expect(Abs(child.Position(Space.WORLD).x - world.x - gone) < 0.001, "it moved twice")
    editor.Edits.Undo()
    Expect(parent.Position() == Vec3(0, 1, 0) && child.Position() == local)
    // Scaled, once.
    Try Simulate.PressKey(Key.R)
    editor.Step()
    editor.Step()
    Local middle = Shown(editor, Vec3(0, 1, 0))
    Try Drag(editor, middle, middle + Vec2(55, 0))
    Local grown = parent.Scale().x
    Expect(grown > 1.2 && child.Scale().x == 1, "the parent's {grown}, the child's {child.Scale()}")
    editor.Finish()
End Function

@Test
Function NoKeyChangesADragWhileItsHeld() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local view = editor.View
    Local cube = Cube(editor, Vec3(0, 1, 0))
    Local from = OnHandle(editor, Vec3(0, 1, 0), Vec3(1, 0, 0), 0)
    Try Held(editor, from, Shown(editor, Vec3(1.5, 1, 0)))
    Local moved = cube.Position()
    Expect(moved.x > 0.5)
    Expect(view.HandleHeld() && view.Busy())
    For key In [Key.R, Key.E, Key.X, Key.G, Key.ESCAPE, Key.H, Key.DELETE]
        Try Simulate.PressKey(key)
        editor.Step()
        editor.Step()
    End For
    Expect(view.Tool == HandleTool.MOVE, "the tool's {view.Tool}")
    Expect(view.Axes == HandleSpace.WORLD && !view.Snap.On)
    Expect(editor.Edited.IsSelected(cube), "Escape let go of what's held")
    Expect(!cube.Hidden() && !editor.Edited.IsRemoved(cube))
    // And it goes on along what it was, under its name.
    Try Simulate.MouseMotion(30, 0)
    editor.Step()
    Expect(cube.Position().y == moved.y && cube.Position().z == moved.z,
           "it's at {cube.Position()}")
    Expect(cube.Scale() == Vec3(1, 1, 1), "it scaled")
    Expect(editor.Edits.UndoName() == "Move")
    Try Letting(editor)
    Expect(!view.HandleHeld())
    // The tool and axes are as they were taken even set from outside, mid-drag, as a script might.
    cube.SetRotation(Quat.FromAxisAngle(Vec3(0, 1, 0), 0.7))
    Try Simulate.MoveMouse(0, 0)
    editor.Step()
    Local again = OnHandle(editor, cube.Position(), Vec3(1, 0, 0), 0)
    Try Held(editor, again, again + Vec2(30, 0))
    Local z = cube.Position().z
    view.Tool = HandleTool.SCALE
    view.Axes = HandleSpace.LOCAL
    Try Simulate.MouseMotion(30, 0)
    editor.Step()
    Expect(cube.Scale() == Vec3(1, 1, 1) && editor.Edits.UndoName() == "Move")
    Expect(cube.Position().z == z, "it went by its own axes: {cube.Position()}")
    view.Axes = HandleSpace.WORLD
    Try Letting(editor)
    // Keys run again after.
    view.Tool = HandleTool.MOVE
    Try Simulate.PressKey(Key.R)
    editor.Step()
    Expect(view.Tool == HandleTool.SCALE, "R didn't pick scale")
    Try Simulate.PressKey(Key.E)
    editor.Step()
    Expect(view.Tool == HandleTool.TURN, "E didn't pick turn")
    Try Simulate.PressKey(Key.W)
    editor.Step()
    Expect(view.Tool == HandleTool.MOVE, "W didn't pick move")
    editor.Finish()
End Function

@Test
Function UndoWaitsForADragToEnd() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local cube = Cube(editor, Vec3(0, 1, 0))
    // One drag done, another held, and two undos, then motion.
    Local from = OnHandle(editor, Vec3(0, 1, 0), Vec3(1, 0, 0), 0)
    Try Drag(editor, from, Shown(editor, Vec3(1.5, 1, 0)))
    Local first = cube.Position()
    Try Simulate.MoveMouse(0, 0)
    editor.Step()
    Local on = OnHandle(editor, first, Vec3(1, 0, 0), 0)
    Try Held(editor, on, on + Vec2(40, 0))
    Local second = cube.Position()
    Try Primary(Key.Z)
    editor.Step()
    editor.Step()
    Try Primary(Key.Z)
    editor.Step()
    editor.Step()
    Expect(cube.Position() == second, "it undid under the drag: {cube.Position()}")
    Try Simulate.MouseMotion(20, 0)
    editor.Step()
    Try Letting(editor)
    Local third = cube.Position()
    // Each's there to undo, and the Add under them, and to redo.
    Expect(editor.Actions.Run("edit.undo") && cube.Position() == first, "it's at {cube.Position()}")
    Expect(editor.Actions.Run("edit.undo") && cube.Position() == Vec3(0, 1, 0),
           "it's at {cube.Position()}")
    Expect(editor.Actions.Run("edit.undo") && editor.Edited.IsRemoved(cube))
    Expect(editor.Actions.Run("edit.redo") && !editor.Edited.IsRemoved(cube))
    Expect(editor.Actions.Run("edit.redo") && editor.Actions.Run("edit.redo") &&
           cube.Position() == third)
    // Redo waits too, with something to redo, held and not yet moved.
    Expect(editor.Actions.Run("edit.undo"))
    Local undone = cube.Position()
    Try Simulate.MoveMouse(0, 0)
    editor.Step()
    Local press = OnHandle(editor, undone, Vec3(1, 0, 0), 0)
    Try Simulate.MoveMouse(press.x, press.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Expect(editor.View.HandleHeld())
    Try Primary(Key.Z, True)
    editor.Step()
    editor.Step()
    Expect(cube.Position() == undone, "it redid under the drag: {cube.Position()}")
    Expect(editor.Edits.CanRedo())
    Try Letting(editor)
    editor.Finish()
End Function

@Test
Function ADragNearlyAlongAnArrowStaysNear() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local cube = Cube(editor, Vec3(0, 0, 0))
    // Orbited nearly down the X arrow.
    editor.Edited.SelectOnly(cube)
    Local center = editor.View.Box().Center
    // From where it starts, 0.6 about Y, to about a quarter turn, and level.
    Try Drag(editor, center, center + Vec2(-192, -90), MouseButton.MIDDLE)
    editor.Step()
    Local camera = editor.View.Viewer()
    Local arrow = Abs(Dot(Normalize(camera.Forward()), Vec3(1, 0, 0)))
    Expect(arrow > 0.9, "it's not looking along the arrow: {arrow}")
    Local dragged = False
    For step = 0 To 30
        Local at = Shown(editor, Vec3(0.05 + (step As Float) * 0.04, 0, 0))
        If editor.View.HandleAt(at) != 0 Then Continue
        Try Held(editor, at, at + Vec2(3, 2))
        For wiggle = 1 To 6
            Try Simulate.MouseMotion(4, -3)
            editor.Step()
            Expect(Length(cube.Position()) < 50, "it went to {cube.Position()}")
        End For
        Try Letting(editor)
        dragged = True
        Break
    End For
    Expect(dragged, "the arrow was never under the pointer")
    editor.Finish()
End Function

@Test
Function WhatsUndoneForGoodIsFreed() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    editor.Actions.Run("add.cube")
    Local first = editor.Edited.Selected()[0]
    editor.Edits.Undo()
    Expect(editor.Edited.Entities().Count == 0 && !first.Freed(), "it could still come back")
    // Something else, and it can't.
    editor.Actions.Run("add.light")
    Expect(editor.Edited.Entities().Count == 1 && first.Freed(),
           "what can't come back is still there")
    // Taken out, then undone past: it's there, and what's taken out for good isn't kept.
    Local light = editor.Edited.Selected()[0]
    editor.Edits.Commit(RemoveEdit(editor.Edited, [light]))
    editor.Edits.Undo()
    Expect(!light.Freed())
    editor.Actions.Run("add.cube")
    Expect(!light.Freed(), "undone, a delete that's forgotten frees nothing")
    // A copy undone and forgotten goes, with what's left beside it.
    editor.Edited.SelectOnly(light)
    Local copying = CopyEdit(editor.Edited, [light])
    editor.Edits.Commit(copying)
    Local copy = copying.Copies()[0]
    editor.Edits.Undo()
    editor.Actions.Run("add.cube")
    Expect(copy.Freed() && !light.Freed())
    // Trimmed off the far end: what's in the scene stays, what was deleted goes.
    Local short = History(1)
    Local kept = Cube(editor, Vec3(1, 1, 1))
    Local going = Cube(editor, Vec3(2, 2, 2))
    short.Commit(RemoveEdit(editor.Edited, [going]))
    Expect(!going.Freed())
    short.Commit(MadeEdit("Made", editor.Edited, Function(): Entity => kept))
    Expect(going.Freed(), "deleted for good, it stayed")
    short.Commit(EditOf("other", Function()
    End Function, Function()
    End Function))
    Expect(!kept.Freed(), "made and kept, it was freed")
    editor.Finish()
End Function

@Test
Function TheLampsOnlyOnWithNoLightOfTheScenes() Throws IOError, GraphicsError
