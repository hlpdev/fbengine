@Test
Function ATextureThatCantBeMadeLeavesTheOneThereIs() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local target = editor.View.Target()
    If target == Null
        Fail("there's no texture")
        Return
    End If
    editor.View.FitTexture(100000, 100)
    Expect(RefEquals(editor.View.Target(), target) && !target.Freed(),
           "it let go of the one it had")
    Expect(editor.View.TextureFailures() == 1)
    editor.View.FitTexture(100000, 100)
    Expect(editor.View.TextureFailures() == 1, "it tried what can't be made again")
    editor.Step()
    Expect(RefEquals(editor.View.Target(), target))
    editor.View.FitTexture(64, 48)
    Local small = editor.View.Target()
    Expect(small != Null && small.Width() == 64, "a size that can be made wasn't")
    editor.Finish()
End Function

