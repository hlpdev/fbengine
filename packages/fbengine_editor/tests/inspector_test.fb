@Test
Function ChangeIsJudgedByWhatsTypedNotWhatsShown() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local pivot = Pivot()
    Selecting(editor, pivot)
    // What's shown the same, as it rounds, is still another value.
    Try Entered(editor, "Position", "0.00004", 0)
    Expect(pivot.Position().x == 0.00004, "it's {pivot.Position()}")
    Expect(editor.Edits.CanUndo(), "it vanished")
    pivot.SetPosition(Vec3(1000000.1875, 0, 0))
    Round(editor)
    Expect(FieldOf(editor, "Position", 0).Text() == "1000000.1875",
           FieldOf(editor, "Position", 0).Text())
    Try Entered(editor, "Position", "1000000.25", 0)
    Expect(pivot.Position().x == 1000000.25, "it's {pivot.Position()}")
    // However big, it's a number.
    pivot.SetPosition(Vec3(100000000000000000000000000000000000.0, 0, 0))
    Round(editor)
    Expect(!FieldOf(editor, "Position", 0).Text().Contains("inf"),
           FieldOf(editor, "Position", 0).Text())
    editor.Finish()
End Function

@Test
Function WhatChangesNothingIsNoUndo() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    KnowingKinds(editor)
    Local pivot = Pivot()
    Selecting(editor, pivot)
    Try Adding(editor, "Door")
    editor.Edits.Clear()
    // What it has already.
    Try Adding(editor, "Door")
    Expect(!editor.Edits.CanUndo(), "adding what it has made an edit")
    // The member it is.
    Local way = RowCalled(editor, "Way") As? ChoiceRow<String>
    If way == Null Then Panic("it's not a list")
    way.Choose(1)
    Expect(!editor.Edits.CanUndo(), "choosing what it is made an edit")
    way.Choose(0)
    Expect(editor.Edits.CanUndo())
    editor.Finish()
End Function

@Test
Function ANewComponentSharesNothing()
    Components.Clear()
    Components.Add<Door>("Door")
    Local kind = Components.Kinds()[0]
    Components.Clear()
    Local one = ComponentData(kind)
    Local two = ComponentData(kind)
    Local at = one.Values["At"]
    If at == Null Then Panic("there's no At")
    at["x"] = Value(5.0)
    Expect((two.Values["At"] ?? Value())["x"]?.AsDouble() == 0,
           "the first's change is in the second")
    Expect((kind.Fields[5].First)["x"]?.AsDouble() == 0, "it's in what a new one starts from")
End Function

@Test
Function WhatsEmptyIsntWhatDiffers() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local one = Pivot()
    Selecting(editor, one)
    Expect(one.Name() == "" && FieldOf(editor, "Name").Placeholder() == "",
           FieldOf(editor, "Name").Placeholder())
    Local two = Pivot()
    two.SetName("two")
    editor.Edited.ToggleSelected(two)
    editor.Step()
    editor.Step()
    editor.Inspector.MarkChanged()
    editor.Step()
    Expect(FieldOf(editor, "Name").Placeholder() == "—", FieldOf(editor, "Name").Placeholder())
    // Alike again, it's as it was.
    two.SetName("")
    editor.Inspector.MarkChanged()
    editor.Step()
    Expect(FieldOf(editor, "Name").Placeholder() == "", FieldOf(editor, "Name").Placeholder())
    editor.Finish()
End Function

// What a scene's saved with for its own use isn't anyone's to type.
@Test
Function WhatsASceneFilesOwnIsntShown() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local cube = Mesh(Geometry.Cube())
    cube.SetMaterial(Material(Color(1, 0, 0)))
    Selecting(editor, cube)
    Local titles = Titles(editor)
    Expect(titles.Contains("Position"), titles)
    Expect(titles.Contains("PickMode") && !titles.Contains("FileNode") &&
           !titles.Contains("SceneId"), titles)
    editor.Finish()
End Function
