// Where the packages are: where ctest says, or under where a test's been run from by hand.
Function Packages(): Path? Throws IOError
    Local said = Env.Get("FBENGINE_PACKAGES")
    If said != Null && said != "" Then Return Path(said)
    Local here = (Try Dir.Current()) / "packages"
    Return File.Exists(here / "fbengine/project.toml") ? here : Null
End Function

// A game whose components/main.fb is `program`, under `games`, depending on the packages.
Function GameOf(games: TempDir, packages: Path, program: String): Path Throws IOError
    Local folder = games.Path / "game"
    Try Dir.CreateAll(folder / "components")
    Local dependency = (packages / "fbengine").Text.Replace("\\", "/")
    Try File.WriteText(folder / "project.toml",
                       "[project]\nname = \"game\"\nversion = \"0.0.1\"\ntype = \"executable\"\n\n" +
                       "[dependencies]\nfbengine = {{ path = \"{dependency}\" }}\n")
    Try File.WriteText(folder / "door.fb",
                       "Public Class Door\n    Public Field Speed: Float = 2.5\nEnd Class\n")
    Try File.WriteText(folder / "gate.fb",
                       "Public Class Gate\n    Public Field Wide: Float = 4\nEnd Class\n")
    Try File.WriteText(folder / "main.fb", "Print(\"the game\")\n")
    Try File.WriteText(folder / "components/main.fb", program)
    Return folder
End Function

Const SAYS_A_DOOR = "Import fbengine\nImport \"../door\"\n\nComponents.Add<Door>(\"Door\")\nTry Components.Describe()\n"

// An editor on `folder`, whose code it's been told may run.
Function Trusting(settings: TempDir, folder: Path): Editor Throws IOError, GraphicsError
    Window.SetHeadless(True)
    Local editor = Try Editor(settings.Path)
    editor.Kept.Trust(folder.Text)
    Try editor.Start(folder)
    Return editor
End Function

// Frames until its program's finished, however that goes.
Function Finishing(editor: Editor)
    Local watch = Stopwatch.StartNew()
    While editor.Kinds.Running() && watch.Elapsed.TotalSeconds < 300
        editor.Step()
    End While
    editor.Step()
    Expect(!editor.Kinds.Running(), "it never finished")
End Function

@Test
Function AGamesProgramSaysItsKinds() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local packages = Try Packages()
    If packages == Null Then Skip("the packages aren't under here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try GameOf(games, packages, SAYS_A_DOOR)
    Local editor = Try Trusting(settings, folder)
    Expect(editor.Kinds.Running(), "it didn't start the program")
    Expect(editor.ShowingDialog() == Null, "it asked about what it's been told")
    Finishing(editor)
    Expect(editor.ShowingDialog() == Null, "it failed")
    Expect(editor.Kinds.Kinds().Count == 1 && editor.Kinds.Kinds()[0].Name == "Door")
    Selecting(editor, Pivot())
    Try Adding(editor, "Door")
    Expect(FieldOf(editor, "Speed").Text() == "2.5")
    // What's said is read again, by asking, what's edited kept as it is.
    Try Entered(editor, "Speed", "7")
    Try File.WriteText(folder / "components/main.fb",
                       "Import fbengine\nImport \"../door\"\nImport \"../gate\"\n\nComponents.Add<Door>(\"Door\")\n" +
                       "Components.Add<Gate>(\"Gate\")\nTry Components.Describe()\n")
    Expect(editor.Actions.Run("file.reload_components"))
    Expect(editor.Kinds.Running())
    Finishing(editor)
    Expect(editor.Kinds.Kinds().Count == 2, "it has {editor.Kinds.Kinds().Count}")
    editor.Step()
    editor.Step()
    Expect(FieldOf(editor, "Speed").Text() == "7", "what's edited went")
    // One that fails says so, and leaves none, if it's a project opened anew.
    Try File.WriteText(folder / "components/main.fb", "This isn't FutureBlitz\n")
    editor.CloseProject()
    editor.OpenFolder(folder)
    Finishing(editor)
    Expect(editor.Kinds.Kinds().Count == 0)
    Expect(editor.ShowingDialog() != Null, "nothing said it failed")
    // One that says them, then fails, has failed.
    Try File.WriteText(folder / "components/main.fb",
                       "Import std.os\nImport fbengine\nImport \"../door\"\n\nComponents.Add<Door>(\"Door\")\n" +
                       "Try Components.Describe()\nProcess.Exit(1)\n")
    editor.CloseProject()
    editor.OpenFolder(folder)
    Finishing(editor)
    Expect(editor.Kinds.Kinds().Count == 0, "it took what a failed program said")
    Expect(editor.ShowingDialog() != Null, "nothing said it failed")
    editor.Finish()
End Function

@Test
Function AProgramEndsWithItsProject() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local packages = Try Packages()
    If packages == Null Then Skip("the packages aren't under here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    // Which leaves a mark if it's left alive.
    Local folder = Try GameOf(games, packages,
                              "Import std.io\nImport std.time\n\nRealWait(3.Seconds).Wait()\n" +
                              "Try File.WriteText(Path(\"marked.txt\"), \"it lived on\")\n")
    Local editor = Try Trusting(settings, folder)
    Local watch = Stopwatch.StartNew()
    While !editor.Kinds.ProgramRunning() && watch.Elapsed.TotalSeconds < 300
        editor.Step()
    End While
    Expect(editor.Kinds.ProgramRunning(), "it never ran")
    editor.CloseProject()
    Expect(!editor.Kinds.Running(), "it's still running")
    editor.Finish()
    RealWait(5.Seconds).Wait()
    Expect(!File.Exists(folder / "marked.txt"), "the program lived on")
End Function

// Runs what's at `folder` by itself, to its end, and says what went wrong.
Function Failure(kinds: GameComponents, folder: Path): String
    kinds.Start(folder)
    Local watch = Stopwatch.StartNew()
    While kinds.Running() && watch.Elapsed.TotalSeconds < 300
        kinds.Update()
    End While
    Expect(!kinds.Running(), "it never finished")
    Return kinds.TakeFailure() ?? ""
End Function

@Test
Function AProgramThatHangsIsStopped() Throws IOError
    Local packages = Try Packages()
    If packages == Null Then Skip("the packages aren't under here")
    Local games = Try TempDir()
    Local folder = Try GameOf(games, packages, "Import std.time\n\nRealWait(600.Seconds).Wait()\n")
    Local kinds = GameComponents()
    kinds.RunSeconds = 0.5
    Local said = Failure(kinds, folder)
    Expect(said.Contains("too long running"), said)
    // What can't even be built, however long it has, is said to be that.
    Try File.WriteText(folder / "components/main.fb", "This isn't FutureBlitz\n")
    said = Failure(kinds, folder)
    Expect(said.Contains("wasn't built"), said)
    // And it can take too long at that.
    kinds.BuildSeconds = 0
    said = Failure(kinds, folder)
    Expect(said.Contains("too long being built"), said)
End Function

@Test
Function AProgramThatSaysTooMuchIsRefused() Throws IOError
    Local packages = Try Packages()
    If packages == Null Then Skip("the packages aren't under here")
    Local games = Try TempDir()
    Local folder = Try GameOf(games, packages, "Import std.core\nImport std.io\nImport std.os\n\nLocal said = \"          \"\nFor i = 1 To 18\n    said += said\nEnd For\n" +
                              "Try File.WriteText(Path(Env.Get(\"FBENGINE_COMPONENTS_TO\") ?? \"\"), \"[\" + said + \"]\")\n")
    Local kinds = GameComponents()
    Local said = Failure(kinds, folder)
    Expect(said.Contains("too much"), said)
    Expect(kinds.Kinds().Count == 0)
    // Too many kinds, however short each.
    Local many = "[" + ",".Join(Repeated("{{\"Name\":\"a\",\"Fields\":[]}}", 1025)) + "]"
    Try File.WriteText(folder / "many.txt", many)
    Try File.WriteText(folder / "components/main.fb", "Import std.core\nImport std.io\nImport std.os\n\n" +
                       "Try File.WriteText(Path(Env.Get(\"FBENGINE_COMPONENTS_TO\") ?? \"\"), Try File.ReadText(Path(\"many.txt\")))\n")
    said = Failure(kinds, folder)
    Expect(said.Contains("too many"), said)
    // One that says nothing it can read says so.
    Try File.WriteText(folder / "components/main.fb", "Import std.core\nImport std.io\nImport std.os\n\n" +
                       "Try File.WriteText(Path(Env.Get(\"FBENGINE_COMPONENTS_TO\") ?? \"\"), \"not JSON\")\n")
    said = Failure(kinds, folder)
    Expect(said.Contains("didn't say"), said)
    // And one that never writes.
    Try File.WriteText(folder / "components/main.fb", "Import std.core\n\nPrint(\"nothing\")\n")
    said = Failure(kinds, folder)
    Expect(said.Contains("didn't say"), said)
End Function

Function Repeated(text: String, times: Int): String[]
    Local all: String[] = []
    For i = 1 To times
        all.Add(text)
    End For
    Return all
End Function

@Test
Function NoFbOnThePathSaysSo() Throws IOError
    Local packages = Try Packages()
    If packages == Null Then Skip("the packages aren't under here")
    Local games = Try TempDir()
    Local folder = Try GameOf(games, packages, SAYS_A_DOOR)
    // By another name, as tests run together, and the PATH is all of theirs.
    Local kinds = GameComponents()
    kinds.Fb = "there-is-no-such-fb"
    kinds.Start(folder)
    Expect(!kinds.Running())
    Local said = kinds.TakeFailure() ?? ""
    Expect(said.Contains("Couldn't run fb"), said)
End Function

@Test
Function AFolderIsAskedAboutOnceBeforeItsCodeRuns() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local packages = Try Packages()
    If packages == Null Then Skip("the packages aren't under here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = Try GameOf(games, packages, SAYS_A_DOOR)
    Window.SetHeadless(True)
    Local first = Try Editor(settings.Path)
    Try first.Start(folder)
    first.Step()
    // Nothing runs until it's said to.
    Expect(!first.Kinds.Running(), "it ran what it wasn't told it could")
    Expect(first.Kinds.HeldBack)
    Local asking = first.ShowingDialog()
    If asking == Null Then Panic("nothing asked")
    first.Step()
    // Not now: it runs nothing, and says why it shows nothing.
    Local notNow = (asking.Find("dialog.Not Now") As? Button)
    If notNow == Null Then Panic("there's no way not to")
    notNow.Click()
    first.Step()
    first.Step()
    Expect(!first.Kinds.Running() && first.ShowingDialog() == Null)
    Selecting(first, Pivot())
    Expect((RowCalled(first, "Components") As? NoteRow) != Null, "nothing says why there's none")
    Expect(!first.Kept.Trusted(folder.Text))
    // Asked again, and yes: it runs, and that's kept.
    Expect(first.Actions.Run("file.reload_components"))
    first.Step()
    Local again = first.ShowingDialog()
    If again == Null Then Panic("nothing asked again")
    Local runIt = (again.Find("dialog.Run It") As? Button)
    If runIt == Null Then Panic("there's no way to")
    runIt.Click()
    first.Step()
    Expect(first.Kinds.Running(), "yes didn't run it")
    Expect(first.Kept.Trusted(folder.Text))
    Finishing(first)
    Expect(first.Kinds.Kinds().Count == 1)
    Expect(!Shows(first, "Components"), "it still says it wasn't let")
    first.Finish()
    // Another run doesn't ask.
    Local second = Try Editor(settings.Path)
    Try second.Start(folder)
    Expect(second.ShowingDialog() == Null, "it asked twice")
    Expect(second.Kinds.Running())
    second.Finish()
    // Another folder does.
    Local games2 = Try TempDir()
    Local other = Try GameOf(games2, packages, SAYS_A_DOOR)
    Local third = Try Editor(settings.Path)
    Try third.Start(other)
    Expect(third.ShowingDialog() != Null && !third.Kinds.Running(),
           "another folder wasn't asked about")
    // Yes to that is yes to that as well, not in place of the first.
    third.TrustProject()
    Expect(third.Kept.Trusted(other.Text) && third.Kept.Trusted(folder.Text),
           "the first was forgotten")
    third.Finish()
End Function

// A kind and a Field called what isn't ASCII, as a Field's own name can't be in FutureBlitz.
Class Portal
    @Rename("Größe")
    Public Field Wide: Float = 1.5
End Class

@Test
Function NamesNeedntBeAscii() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Components.Clear()
    Components.Add<Portal>("Tür")
    editor.Kinds.Set(Components.Kinds())
    Components.Clear()
    editor.Step()
    Selecting(editor, Pivot())
    Try Adding(editor, "Tür")
    Expect(RowCalled(editor, "Tür").Title == "Tür")
    Try Entered(editor, "Größe", "2.5")
    Expect(editor.Edits.UndoName() == "Set Größe", editor.Edits.UndoName() ?? "")
    editor.Finish()
End Function

Struct Named2
    Public Field x: String
    Public Field y: String
End Struct

Struct Whole2
    Public Field x: Int
    Public Field y: Int
End Struct

Struct Tinted
    Public Field r: Float
    Public Field g: Float
    Public Field b: Float
    Public Field a: Float
    Public Field name: String
End Struct

Class Odd
    Public Field Words: Named2
    Public Field Tiles: Whole2
    Public Field Tint: Tinted
    Public Field Small: UInt8 = 3
    @ShownInDegrees
    Public Field Turns: Vec3
    @Limits(0, 5)
    Public Field Speed: Float = 1
End Class

Function KnowingOdd(editor: Editor)
    Components.Clear()
    Components.Add<Odd>("Odd")
    editor.Kinds.Set(Components.Kinds())
    Components.Clear()
    editor.Step()
End Function

@Test
Function WhatOnlyLooksLikeAVectorIsntEditedAsOne() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    KnowingOdd(editor)
    Local pivot = Pivot()
    Selecting(editor, pivot)
    Try Adding(editor, "Odd")
    Expect((RowCalled(editor, "Words") As? NoteRow) != Null,
           "a Struct of Strings is edited as a Vec2")
    Expect((RowCalled(editor, "Tiles") As? NoteRow) != Null, "a Struct of Ints takes 1.5 as a Vec2")
    Expect((RowCalled(editor, "Tint") As? NoteRow) != Null, "a Color's Save would lose its name")
    // An integer type's, in the row: 300 isn't a UInt8.
    Try Entered(editor, "Small", "300")
    Expect(FieldOf(editor, "Small").Text() == "3", "it took 300")
    Try Entered(editor, "Small", "255")
    Expect(FieldOf(editor, "Small").Text() == "255")
    // Degrees, of a vector too.
    Try Entered(editor, "Turns", "90", 1)
    Local data = ComponentsOf(pivot)[0].Values["Turns"] ?? Value()
    Expect(Abs((data["y"]?.AsDouble() ?? 0) - Pi / 2) < 0.001, "{data}")
    Expect(FieldOf(editor, "Turns", 1).Text() == "90", FieldOf(editor, "Turns", 1).Text())
    // Saved as what it isn't, by a scene edited by hand: a note, not a panic.
    Local values = Value.Object()
    values["Speed"] = Value("fast")
    SetComponentsOf(pivot, [ComponentData("Odd", values)])
    editor.Step()
    editor.Step()
    Expect((RowCalled(editor, "Speed") As? NoteRow) != Null, "it edits what isn't what it says")
    // A member there isn't, as well.
    Local door = Pivot()
    KnowingKinds(editor)
    Local unknown = Value.Object()
    unknown["Way"] = Value("SIDEWAYS")
    SetComponentsOf(door, [ComponentData("Door", unknown)])
    Selecting(editor, door)
    Expect((RowCalled(editor, "Way") As? NoteRow) != Null, "it lists what doesn't have what it has")
    // A kind said by hand, too.
    editor.Finish()
End Function

Enum Bits
    ONE
    TWO
End Enum

@Flags
Enum Rights
    READ
    WRITE
End Enum

Class Allowed
    Public Field Can: Rights = Rights.READ
End Class

@Test
Function AnEnumThatCantBeListedIsntText() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Components.Clear()
    Components.Add<Allowed>("Allowed")
    editor.Kinds.Set(Components.Kinds())
    Components.Clear()
    editor.Step()
    Selecting(editor, Pivot())
    Try Adding(editor, "Allowed")
    Expect((RowCalled(editor, "Can") As? NoteRow) != Null,
           "it's free text, or a list that can't be right")
    editor.Finish()
End Function

@Test
Function WhatsSaidOfKindsWaitsForWhatsBeingTyped() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    KnowingKinds(editor)
    Local pivot = Pivot()
    Selecting(editor, pivot)
    Try Adding(editor, "Door")
    Local field = FieldOf(editor, "Speed")
    Try Typing(editor, field, "3")
    editor.Kinds.Set(editor.Kinds.Kinds())
    editor.Step()
    editor.Step()
    Expect(field.Text() == "3", "it took away what's being typed")
    Local focused = editor.Shown.Focused()
    Expect(focused != Null && RefEquals(focused, field), "it took the keyboard")
    Expect(ComponentsOf(pivot)[0].Values["Speed"]?.AsDouble() == 2.5,
           "it took half of what's being typed")
    // Finished, it goes in, and what was said shows.
    Try Simulate.PressKey(Key.RETURN)
    editor.Step()
    editor.Step()
    editor.Step()
    Expect(ComponentsOf(pivot)[0].Values["Speed"]?.AsDouble() == 3)
    Expect(!RefEquals(FieldOf(editor, "Speed"), field), "it never showed what was said")
    editor.Finish()
End Function

@Test
Function LimitsAreTheSettersOwn() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local pivot = Pivot()
    Selecting(editor, pivot)
    Try Entered(editor, "MaxSlope", "90")
    Expect(Near(pivot.MaxSlope(), Pi / 2), "a right angle's refused: {pivot.MaxSlope()}")
    Try Entered(editor, "MaxSlope", "91")
    Expect(Near(pivot.MaxSlope(), Pi / 2))
    // A mirrored scale's fine; only nothing, or next to it, isn't.
    Try Entered(editor, "Scale", "-2", 0)
    Expect(pivot.Scale().x == -2, "it's {pivot.Scale()}")
    Try Entered(editor, "Scale", "0.0001", 0)
    Expect(pivot.Scale().x == -2)
    Try Entered(editor, "Scale", "-0.0001", 0)
    Expect(pivot.Scale().x == -2)
    Local camera = Camera()
    Selecting(editor, camera)
    // Right up to what its setter takes, each way.
    Try Entered(editor, "FieldOfView", "179.95")
    Expect(Near(camera.FieldOfView(), 179.95 * Pi / 180), "it's {camera.FieldOfView()}")
    Try Entered(editor, "FieldOfView", "0.01")
    Expect(Abs(camera.FieldOfView() - 0.01 * Pi / 180) < 0.00001, "it's {camera.FieldOfView()}")
    Try Entered(editor, "OrthographicHeight", "1e-39")
    Expect(camera.OrthographicHeight() > 0.0000001)
    // What a light's shadows take.
    Local shadowed = Light(LightType.DIRECTIONAL)
    Selecting(editor, shadowed)
    Try Entered(editor, "ShadowSize", "8")
    Expect(shadowed.ShadowSize() != 8, "it took what's too small")
    Try Entered(editor, "ShadowDistance", "0")
    Expect(shadowed.ShadowDistance() > 0)
    Try Entered(editor, "ShadowBias", "3", 1)
    Expect(shadowed.ShadowNormalBias() == 3)
    Local depthBias = shadowed.ShadowBias()
    Try Entered(editor, "ShadowBias", "-1", 0)
    Expect(shadowed.ShadowBias() == depthBias, "it took a bias below 0")
    Selecting(editor, camera)
    // A camera's clearing goes one way at a time.
    Local depth = RowCalled(editor, "ClearsDepth") As? ToggleRow
    If depth == Null Then Panic("it's not a box")
    Expect(camera.ClearsColor() && camera.ClearsDepth())
    depth.Ticked().Click()
    editor.Step()
    Expect(camera.ClearsColor() && !camera.ClearsDepth())
    Local color = RowCalled(editor, "ClearsColor") As? ToggleRow
    If color == Null Then Panic("it's not a box")
    color.Ticked().Click()
    editor.Step()
    Expect(!camera.ClearsColor() && !camera.ClearsDepth(), "the other one came back")
    depth.Ticked().Click()
    editor.Step()
    Expect(!camera.ClearsColor() && camera.ClearsDepth(), "the other one came back")
    // An ellipsoid's two radii.
    Try Entered(editor, "CollisionRadius", "2", 1)
    Expect(camera.CollisionRadius() == Vec2(1, 2), "it's {camera.CollisionRadius()}")
    Try Entered(editor, "CollisionRadius", "0", 0)
    Expect(camera.CollisionRadius() == Vec2(1, 2))
    editor.Finish()
End Function

@Test
Function OneRowLooksEachFrameHoweverMuchIsSelected() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local first = Pivot()
    editor.Edited.SelectOnly(first)
    For i = 1 To 500
        editor.Edited.ToggleSelected(Pivot())
    End For
    editor.Step()
    editor.Step()
    Local before = editor.Inspector.Refreshes()
    For i = 1 To 5
        editor.Step()
    End For
    Expect(editor.Inspector.Refreshes() - before == 5,
           "{editor.Inspector.Refreshes() - before} in 5 frames")
    // Something edited shows at once, all of it.
    Try Entered(editor, "Position", "4", 0)
    Expect(FieldOf(editor, "Position", 0).Text() == "4")
    Local rows = editor.Inspector.Rows().Count
    before = editor.Inspector.Refreshes()
    editor.Inspector.MarkChanged()
    editor.Step()
    Expect(editor.Inspector.Refreshes() - before == rows,
           "{editor.Inspector.Refreshes() - before} of {rows}")
    editor.Finish()
End Function

