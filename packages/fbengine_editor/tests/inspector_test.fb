@Test
Function WhatsFreedOrTakenOutGoes() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local light = Light()
    Selecting(editor, light)
    Try Entered(editor, "Intensity", "5")
    Expect(editor.Actions.Run("tree.delete"))
    editor.Step()
    Expect(editor.Inspector.Rows().Count == 0, "it still shows what's taken out")
    Expect(editor.Actions.Run("edit.undo"))
    editor.Step()
    Expect(editor.Inspector.Rows().Count > 0, "what's back doesn't show")
    Expect(FieldOf(editor, "Intensity").Text() == "5")
    // Freed by anything else, with what's being typed in it, and with an edit on it to undo.
    Try Typing(editor, FieldOf(editor, "Intensity"), "6")
    light.Free()
    editor.Step()
    editor.Step()
    Expect(editor.Inspector.Rows().Count == 0)
    While editor.Edits.CanUndo()
        Expect(editor.Actions.Run("edit.undo"))
    End While
    editor.Step()
    While editor.Edits.CanRedo()
        Expect(editor.Actions.Run("edit.redo"))
    End While
    editor.Step()
    editor.Finish()
End Function

