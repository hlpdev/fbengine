    editor.Step()
    Expect(editor.Tree.ShownEntities().Count == 0)
    Try Entered(editor, "Name", "door")
    Expect(pivot.Name() == "door")
    editor.Step()
    Expect(editor.Tree.ShownEntities().Count == 1, "the tree didn't see its new name")
    editor.Finish()
End Function

