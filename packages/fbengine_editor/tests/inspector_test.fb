    End While
    editor.Step()
    editor.Finish()
End Function

// Where the packages are, up from where the tests run; Null if that's not in the repository.
Function Packages(): Path? Throws IOError
    Local at: Path? = Try Dir.Current()
    While at != Null
        If File.Exists(at / "packages/fbengine/project.toml") Then Return at / "packages"
        Local up = at.Parent()
        If up == Null || up == at Then Return Null
        at = up
    End While
    Return Null
End Function

@Test
Function AGamesProgramSaysItsKinds() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local packages = Try Packages()
    If packages == Null Then Skip("the packages aren't up from here")
    Local fb = Env.Get("FBENGINE_NO_FB")
    If fb == "1" Then Skip("no fb here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local folder = games.Path / "game"
    Try Dir.CreateAll(folder / "components")
    Local dependency = packages / "fbengine"
    Try File.WriteText(
        folder / "project.toml",
        "[project]\nname = \"game\"\nversion = \"0.0.1\"\ntype = \"executable\"\n\n" +
        "[dependencies]\nfbengine = {{ path = \"{dependency.Text.Replace("\\", "/")}\" }}\n")
    Try File.WriteText(folder / "door.fb",
                       "Public Class Door\n    Public Field Speed: Float = 2.5\nEnd Class\n")
    Try File.WriteText(folder / "main.fb", "Print(\"the game\")\n")
    Try File.WriteText(folder / "components/main.fb",
                       "Import fbengine\nImport \"../door\"\n\nComponents.Add<Door>(\"Door\")\nTry Components.Describe()\n")
    Window.SetHeadless(True)
    Local editor = Try Editor(settings.Path)
    Try editor.Start(folder)
    Expect(editor.Kinds.Running() || editor.ShowingDialog() != Null, "it didn't start the program")
    Local watch = Stopwatch.StartNew()
    While editor.Kinds.Running() && watch.Elapsed.TotalSeconds < 120
        editor.Step()
    End While
    editor.Step()
    Expect(!editor.Kinds.Running(), "it never ended")
    Expect(editor.ShowingDialog() == Null, "it failed")
    Expect(editor.Kinds.Kinds().Count == 1 && editor.Kinds.Kinds()[0].Name == "Door")
    Selecting(editor, Pivot())
    Try Adding(editor, "Door")
    Expect(FieldOf(editor, "Speed").Text() == "2.5")
    // A program that fails says so, and leaves none.
    Try File.WriteText(folder / "components/main.fb", "This isn't FutureBlitz\n")
    Local second = folder
    editor.CloseProject()
    editor.OpenFolder(second)
    watch = Stopwatch.StartNew()
    While editor.Kinds.Running() && watch.Elapsed.TotalSeconds < 120
        editor.Step()
    End While
    editor.Step()
    Expect(editor.Kinds.Kinds().Count == 0)
    Expect(editor.ShowingDialog() != Null, "nothing said it failed")
    // One that says them, then fails, has failed.
    Try File.WriteText(folder / "components/main.fb",
                       "Import std.os\nImport fbengine\nImport \"../door\"\n\nComponents.Add<Door>(\"Door\")\n" +
                       "Try Components.Describe()\nSystem.Exit(1)\n")
    editor.CloseProject()
    editor.OpenFolder(second)
    watch = Stopwatch.StartNew()
    While editor.Kinds.Running() && watch.Elapsed.TotalSeconds < 120
        editor.Step()
    End While
    editor.Step()
    Expect(editor.Kinds.Kinds().Count == 0, "it took what a failed program said")
    Expect(editor.ShowingDialog() != Null, "nothing said it failed")
    // One that's running is stopped when the project goes.
    Try File.WriteText(folder / "components/main.fb", "Import std.time\nSleepFor(60)\n")
    editor.CloseProject()
    editor.OpenFolder(second)
    editor.CloseProject()
    Expect(!editor.Kinds.Running(), "it's still running")
    editor.Finish()
End Function
