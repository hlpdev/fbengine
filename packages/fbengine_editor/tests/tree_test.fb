    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Edited.SelectOnly(all["d"])
    editor.Step()
    Local told = 0
    editor.Edited.OnSelectionChanged(Function()
        told += 1
    End Function)
    // What wasn't selected isn't news.
    editor.Edited.TakeOut(all["e"])
    Expect(told == 0, "it was told {told} times")
    editor.Edited.TakeOut(all["d"])
    Expect(told == 1 && editor.Edited.Selected().Count == 0, "it was told {told} times")
    editor.Edited.OnSelectionChanged(Null)
    editor.Finish()
End Function

@Test
Function ARebuildWhileDraggingEndsItsHint() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Edited.SelectOnly(all["d"])
    editor.Step()
    editor.Step()
    Try Dragging(editor, OnName(editor, all["d"]), OnName(editor, all["e"]))
    Expect(editor.Shown.Popups().Count == 1)
    editor.Tree.MarkChanged()
    editor.Step()
    Expect(editor.Shown.Popups().Count == 0, "the hint outlived the row")
    // Moving on doesn't begin it again.
    Try Simulate.MouseMotion(4, 0)
    editor.Step()
    Expect(editor.Shown.Popups().Count == 0, "the drag began again")
    Try Letting(editor)
    Expect(all["d"].Parent() == Null, "a drag that was ended went on")
    // Let go back on its row, it's not a click on it.
    editor.Edited.SelectOnly(all["d"])
    editor.Edited.ToggleSelected(all["e"])
    editor.Step()
    Local on = OnName(editor, all["d"])
    Local there = OnName(editor, all["e"])
    Try Dragging(editor, on, there)
    editor.Tree.MarkChanged()
    editor.Step()
    Try Simulate.MouseMotion(on.x - there.x, on.y - there.y)
    editor.Step()
    Try Letting(editor)
    Expect(editor.Edited.Selected().Count == 2, "letting go selected only it")
    editor.Finish()
End Function

@Test
Function ARowDraggedThatAnUndoReplacesIsntDropped() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Edited.SelectOnly(all["d"])
    editor.Step()
    editor.Step()
    Try Dragging(editor, OnName(editor, all["d"]), OnName(editor, all["a"]))
    Try Letting(editor)
    Expect(all["d"].Parent() == all["a"], "the first drag didn't put d under a")
    // d's row, under a, dragged toward e; the undo puts d back, so its row's another.
    Try Dragging(editor, OnName(editor, all["d"]), OnName(editor, all["e"]))
    Local held = editor.Tree.RowOf(all["d"])
    Expect(held != Null && RefEquals(editor.Shown.Pressed(), held), "d's row isn't what's dragged")
    Expect(editor.Shown.Popups().Count == 1, "the drag shows no hint")
    Try Primary(Key.Z)
    editor.Step()
    editor.Step()
    Local now = editor.Tree.RowOf(all["d"])
    Expect(held != Null && now != Null && !RefEquals(now, held), "d's row is the one dragged")
    Expect(all["d"].Parent() == Null,
           "the dragged row, replaced, put d under {all["d"].Parent()?.Name() ?? "nothing"}")
    Expect(editor.Shown.Popups().Count == 0, "the hint outlived the row")
    // Let go of, nothing's moved, and the undo's redone as it was.
    Try Letting(editor)
    Expect(all["d"].Parent() == Null,
           "letting go put d under {all["d"].Parent()?.Name() ?? "nothing"}")
    Expect(editor.Edits.Redo(), "the undo's redo was dropped by a commit")
    Expect(all["d"].Parent() == all["a"], "the redo didn't put d back under a")
    editor.Finish()
End Function

@Test
Function OnlyWhatsInTheSceneRenames() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Tree.BeginRename(editor.Edited.Helpers)
    Expect(!editor.Tree.Renaming())
    editor.Edited.TakeOut(all["d"])
    editor.Tree.BeginRename(all["d"])
    Expect(!editor.Tree.Renaming())
    all["e"].Free()
    editor.Tree.BeginRename(all["e"])
    Expect(!editor.Tree.Renaming())
    editor.Finish()
End Function

// Whether `entity` has a row, as a test of a Widget itself would print all it's in if it fails.
Function Rowed(editor: Editor, entity: Entity): Bool => editor.Tree.RowOf(entity) != Null

// A click on what's named `name`, in a popup or under the root.
Function ClickNamed(editor: Editor, name: String) Throws GraphicsError
    Local found: Node? = Null
    For popup In editor.Shown.Popups()
        found = found ?? popup.Find(name)
    End For
    found = found ?? editor.Shown.Root().Find(name)
    If found == Null Then Panic("there's nothing named {name}")
    Try ClickAt(editor, found.Box().Center)
End Function

// `count` pivots, named by number, at the top of the scene.
Function Many(editor: Editor, count: Int): Entity[]
    Local made: Entity[] = []
    For i = 0 Until count
        Local pivot = Pivot()
        pivot.SetName("n{i}")
        made.Add(pivot)
    End For
    editor.Tree.MarkChanged()
    editor.Step()
    editor.Step()
    Return made
End Function

@Test
Function OpeningAProjectOverOneWithRowsLetsThemGo() Throws IOError, GraphicsError
