    Try Simulate.MoveMouse(on.x, on.y)
    editor.Step()
    Try Simulate.KeyDown(Key.LEFT_SHIFT)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.KeyUp(Key.LEFT_SHIFT)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    editor.Step()
    Local selected = editor.Edited.Selected()
    Expect(selected.Count == 1 && RefEquals(selected[0], all["e"]), "{selected.Count} selected")
    editor.Finish()
End Function

@Test
Function RenamingWhatsOutOfViewScrollsToIt() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Many(editor, 500)
    editor.Edited.SelectOnly(all[400])
    editor.Step()
    editor.Step()
    Local top = all[0]
    editor.Edited.SelectOnly(top)
    editor.Step()
    editor.Step()
    Expect(!Rowed(editor, all[400]))
    editor.Tree.BeginRename(all[400])
    editor.Step()
    editor.Step()
    Expect(editor.Tree.Renaming(), "it didn't rename what's far away")
    Local row = editor.Tree.RowOf(all[400])
    If row == Null Then Panic("it didn't scroll to it")
    Expect(row.Box().Y >= editor.Tree.Box().Y &&
           row.Box().Y + row.Box().Height <= editor.Tree.Box().Y + editor.Tree.Box().Height + 1,
           "{row.Box()} of {editor.Tree.Box()}")
    editor.Finish()
End Function

@Test
Function RenamingOrFindingOpensAClosedTree() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Edited.SelectOnly(all["d"])
    editor.Step()
    editor.Docked.Hide("tree")
    editor.Step()
    Try Simulate.PressKey(Key.F2)
    editor.Step()
    editor.Step()
    editor.Step()
    Expect(editor.Docked.Showing("tree"), "the tree's still closed")
    Expect(editor.Tree.Renaming(), "it isn't renaming")
    Local focused = editor.Shown.Focused()
    Local field = editor.Tree.RenameField()
    Expect(focused != Null && field != Null && RefEquals(focused, field),
           "the field hasn't the keyboard")
    Try Simulate.PressKey(Key.ESCAPE)
    editor.Step()
    editor.Step()
    editor.Docked.Hide("tree")
    editor.Step()
    Try Primary(Key.F)
    editor.Step()
    editor.Step()
    editor.Step()
    focused = editor.Shown.Focused()
    Expect(focused != Null && RefEquals(focused, editor.Tree.FindField()),
           "find hasn't the keyboard")
    editor.Finish()
End Function

@Test
Function WhatsUnnamedCopiesByItsKindAndIsntFoundByIt() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local unnamed = Pivot()
    Local named = Pivot()
    named.SetName("pivot door")
    editor.Tree.MarkChanged()
    editor.Step()
    editor.Edited.SelectOnly(unnamed)
    Expect(editor.Actions.Run("tree.duplicate"))
    editor.Step()
    Local copy = editor.Edited.Selected()[0]
    Expect(copy.Name() == "{unnamed.Kind()} copy", "it's {copy.Name()}")
    copy.SetName("")
    // What a row shows for one with no name isn't its name.
    editor.Tree.FindField().SetText("pivot")
    editor.Step()
    editor.Step()
    Expect(Names(editor) == "pivot door ", "it shows {Names(editor)}")
    editor.Finish()
End Function

@Test
Function AModalCallsOffARowsDrag() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Edited.SelectOnly(all["d"])
    editor.Step()
    Try Dragging(editor, OnName(editor, all["d"]), OnName(editor, all["e"]))
    Expect(editor.Shown.Popups().Count == 1, "there's no hint")
    Try Primary(Key.O)
    editor.Step()
    Expect(all["d"].Parent() == Null, "the modal dropped it")
    Expect(!editor.Edits.CanUndo())
    Try Letting(editor)
    Expect(all["d"].Parent() == Null, "letting go dropped it")
    Expect(editor.Shown.Popups().Count == 1, "the hint's still up, or the modal isn't")
    editor.Finish()
End Function

@Test
Function DroppingOnWhatsClosedOpensIt() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Tree.SetOpen(all["e"], False)
    editor.Edited.SelectOnly(all["d"])
    editor.Step()
    editor.Step()
    Try Dragging(editor, OnName(editor, all["d"]), OnName(editor, all["e"]))
    Try Letting(editor)
    Expect(editor.Tree.IsOpen(all["e"]), "what it went under stayed closed")
    Expect(Names(editor) == "a b c e d ", "it shows {Names(editor)}")
