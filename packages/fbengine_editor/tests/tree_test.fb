    Try Primary(Key.O)
    editor.Step()
    editor.Step()
    Local field: Node? = Null
    For popup In editor.Shown.Popups()
        field = field ?? popup.Find("dialog.path")
    End For
    Local path = field As? TextField
    If path == Null Then Panic("there's no field")
    path.SetText(other.Text)
    Try ClickNamed(editor, "dialog.Open")
    Expect(editor.Current()?.Name == "other")
    Expect(all["a"].Freed())
    Expect(editor.Tree.RowsMade() == 0 && editor.Tree.ShownEntities().Count == 0)
