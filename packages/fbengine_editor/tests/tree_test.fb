@Test
Function WhileRenamingTheTreesCommandsWait() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    Local d = all["d"]
    editor.Edited.SelectOnly(d)
    editor.Step()
    editor.Tree.BeginRename(d)
    Local typing = editor.Tree.RenameField()
    If typing == Null Then Panic("there's no field")
    typing.SetText("x")
    Try Primary(Key.D)
    editor.Step()
    editor.Step()
    Expect(editor.Tree.Renaming() && editor.Tree.ShownEntities().Count == 5,
           "it copied under a rename")
    For id In ["tree.rename", "tree.duplicate", "tree.hide", "tree.delete", "tree.find"]
        Expect(!editor.Actions.Run(id), "{id} ran under a rename")
    End For
    // What's typed is its own: letters and Delete go to the field.
    Try Simulate.KeyDown(Key.H)
    Try Simulate.Text("h")
    editor.Step()
    Try Simulate.KeyUp(Key.H)
    Try Simulate.PressKey(Key.DELETE)
    editor.Step()
    Expect(!d.Hidden() && !editor.Edited.IsRemoved(d), "the field's keys went to what's selected")
    Expect(typing.Text().Contains("h"), "it holds {typing.Text()}")
    // Anything changing the tree takes what's typed.
    typing.SetText("y")
    editor.Tree.MarkChanged()
    editor.Step()
    Expect(d.Name() == "y", "it's {d.Name()}")
    Expect(!editor.Tree.Renaming())
    // Freed while it's being renamed, nothing's left.
    editor.Tree.BeginRename(all["e"])
    all["e"].Free()
    editor.Step()
    editor.Step()
    Expect(!editor.Tree.Renaming() && Names(editor) == "a b c y ", "it shows {Names(editor)}")
    editor.Finish()
End Function

