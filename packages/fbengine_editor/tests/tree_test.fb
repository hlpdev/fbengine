    Expect(back.Count == 2 && RefEquals(back[0], all["b"]) && RefEquals(back[1], all["a"]),
           "{back.Count} selected")
    editor.Finish()
End Function

// Runs `edit`, frees `going`, and undoes and redoes it, which panics if it doesn't look.
Function AfterAFree(editor: Editor, edit: Edit, going: Entity)
    editor.Edits.Commit(edit)
    going.Free()
    Expect(editor.Edits.Undo(), "{edit.Name} didn't undo")
    editor.Step()
    Expect(editor.Edits.Redo(), "{edit.Name} didn't redo")
    editor.Step()
End Function

@Test
Function EditsOfWhatsBeenFreedDoNothing() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local scene = editor.Edited
    Local one = Pivot()
    AfterAFree(editor, RenameEdit(one, "x"), one)
    Local two = Pivot()
    AfterAFree(editor, HideEdit([two], True), two)
    Local three = Pivot()
    AfterAFree(editor, RemoveEdit(scene, [three]), three)
    Local four = Pivot()
    Local copying = CopyEdit(scene, [four])
    editor.Edits.Commit(copying)
    Local copy = copying.Copies()[0]
    copy.Free()
    Expect(editor.Edits.Undo() && editor.Edits.Redo())
    Local five = Pivot()
    AfterAFree(editor, ReparentEdit(scene, [five], four), five)
    Local six = Pivot()
    AfterAFree(editor, ReparentEdit(scene, [six], four), four)
    Expect(!six.Freed() || six.Freed())
    Local made = MadeEdit("Add", scene, Function(): Entity => Pivot())
    editor.Edits.Commit(made)
    Local entity = made.Made()
    If entity == Null Then Panic("it made nothing")
    entity.Free()
    Expect(editor.Edits.Undo() && editor.Edits.Redo())
    // What it was under, freed while it's taken out: it stays out.
    Local parent = Pivot()
    Local child = Pivot(parent)
    editor.Edits.Commit(RemoveEdit(scene, [child]))
    parent.Free()
    Expect(!child.Freed())
    Expect(editor.Edits.Undo())
    Expect(scene.IsRemoved(child), "it came back under nothing")
    editor.Step()
    editor.Finish()
End Function

@Test
Function WhatsHiddenByWhatItsInShowsAsThat() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    Local style = Function(name: String): String
        Local row = editor.Tree.RowOf(all[name])
        Return row != Null ? row.StyleName() : "no row"
    End Function
    Expect(style("b") == "tree.row")
    editor.Edits.Commit(HideEdit([all["a"]], True))
    editor.Step()
    Expect(style("a") == "tree.row.hidden", style("a"))
    Expect(style("b") == "tree.row.under", style("b"))
    Expect(style("c") == "tree.row.under", style("c"))
    editor.Edited.SelectOnly(all["b"])
    editor.Step()
    Expect(style("b") == "tree.row.selected.under", style("b"))
    editor.Edits.Undo()
    editor.Step()
    Expect(style("c") == "tree.row", style("c"))
    editor.Finish()
End Function

@Test
Function OnlyTheRowsInViewAreMade() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Many(editor, 10000)
    Expect(editor.Tree.ShownEntities().Count == 10000)
    Local most = (Window.Height() / 22) + 3
    Expect(editor.Tree.RowsMade() <= most, "it made {editor.Tree.RowsMade()} of what fit in {most}")
    Expect(!Rowed(editor, all[9999]))
    // Selected, it's scrolled to, and it's there.
    editor.Edited.SelectOnly(all[9999])
    editor.Step()
    editor.Step()
    Local row = editor.Tree.RowOf(all[9999])
    If row == Null Then Panic("what's selected isn't in view")
    editor.Step()
    Local view = editor.Tree.FindField().Parent()
    Expect(editor.Tree.RowsMade() <= most, "it made {editor.Tree.RowsMade()} of what fit in {most}")
    Expect(row.Box().Height > 0 && row.Box().Y < Window.Height() As Float32, "it's at {row.Box()}")
    // Back up to the first, one key at a time isn't needed: selected, it's there too.
    editor.Edited.SelectOnly(all[0])
    editor.Step()
    editor.Step()
    Expect(Rowed(editor, all[0]), "the first isn't in view")
    Expect(!Rowed(editor, all[9999]), "what's far away's still made")
    // The down key goes by what's shown.
    editor.Shown.Focus(editor.Tree)
    Try Simulate.PressKey(Key.DOWN)
    editor.Step()
    editor.Step()
    Expect(RefEquals(editor.Edited.Selected()[0], all[1]))
    editor.Finish()
End Function

@Test
Function ALetGoGoesByWhatShiftWasAtThePress() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Edited.SelectOnly(all["d"])
    editor.Edited.ToggleSelected(all["e"])
    editor.Step()
