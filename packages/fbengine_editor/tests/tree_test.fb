@Test
Function ARowOfWhatsFreedDoesNothingBeforeItsGone() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    Local row = editor.Tree.RowOf(all["e"])
    If row == Null Then Panic("it has no row")
    Local box = row.Box()
    all["e"].Free()
    // Before the tree's next Update finds it, as what's freed within one Ui.Update is.
    row.SetStyleName("tree.row.hidden")
    editor.Shown.Update()
    Expect(!row.PointerDown(box.Center), "a press took what's freed")
    Expect(!row.PointerDownWith(MouseButton.RIGHT, box.Center), "a right press took what's freed")
    editor.Step()
    Expect(Names(editor) == "a b c d ", "it shows {Names(editor)}")
    editor.Finish()
End Function

