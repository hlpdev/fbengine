End Function

@Test
Function DroppedOnNothingOnlyWhatsUnderSomethingMoves() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    Local empty = OnName(editor, all["e"]) + Vec2(0, 60)
    editor.Edited.SelectOnly(all["d"])
    editor.Step()
    Try Dragging(editor, OnName(editor, all["d"]), empty)
    Try Letting(editor)
    Expect(!editor.Edits.CanUndo(), "what's at the top went to the top")
    editor.Edited.SelectOnly(all["c"])
    editor.Step()
    Try Dragging(editor, OnName(editor, all["c"]), empty)
    Try Letting(editor)
    Expect(all["c"].Parent() == Null && editor.Edits.CanUndo(), "what's under something stayed")
    editor.Finish()
End Function

@Test
Function LettingGoOffARowLeavesWhatsSelected() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Edited.SelectOnly(all["d"])
    editor.Edited.ToggleSelected(all["e"])
    editor.Step()
    // Off its row by less than a drag.
    Local box = Row(editor, all["d"])
    Local on = Vec2(box.X + box.Width - 12, box.Y + box.Height - 1)
    Try Simulate.MoveMouse(on.x, on.y)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Try Simulate.MouseMotion(0, 3)
    editor.Step()
    Try Letting(editor)
    Expect(editor.Edited.Selected().Count == 2, "it selected only what it left")
    // Let go on it, it's only that, but not under a rename.
    editor.Tree.BeginRename(all["d"])
    editor.Step()
    Local beside = Vec2(box.X + 8, box.Center.y)
    Try ClickAt(editor, beside)
    Expect(!editor.Tree.Renaming(), "a click beside its field left it renaming")
    Expect(editor.Edited.Selected().Count == 2, "a click ending a rename selected only that")
    Try ClickAt(editor, beside)
    Expect(editor.Edited.Selected().Count == 1 && RefEquals(editor.Edited.Selected()[0], all["d"]))
    editor.Finish()
End Function

@Test
Function OnlyWhatsUnderARowOpensItAndOnlyByItsPart() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    // At its indent, b's opener; left of that, only the row.
    Local box = Row(editor, all["b"])
    Local content = box.X + 6
    Try ClickAt(editor, Vec2(content + 14 + 2, box.Center.y))
    Expect(!editor.Tree.IsOpen(all["b"]), "its opener didn't close it")
    Try ClickAt(editor, Vec2(content + 14 + 2, box.Center.y))
    Expect(editor.Tree.IsOpen(all["b"]), "its opener didn't open it")
    Try ClickAt(editor, Vec2(content + 2, box.Center.y))
    Expect(editor.Tree.IsOpen(all["b"]), "its indent closed it")
    Expect(RefEquals(editor.Edited.Selected()[0], all["b"]), "its indent didn't select it")
    // With nothing under it, there's no opener.
    Local leaf = Row(editor, all["d"])
    Try ClickAt(editor, Vec2(leaf.X + 6 + 2, leaf.Center.y))
    Expect(editor.Tree.IsOpen(all["d"]), "it closed what has nothing under it")
    Expect(RefEquals(editor.Edited.Selected()[0], all["d"]), "it didn't select it")
    editor.Finish()
End Function

@Test
Function ANewSceneForgetsWhatWasClosedAndFound() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    editor.Tree.SetOpen(all["a"], False)
    editor.Tree.FindField().SetText("a")
    editor.Step()
    editor.Step()
    Expect(editor.Actions.Run("file.close"))
    editor.Step()
    editor.Step()
    Expect(editor.Tree.FindField().Text() == "", "it still finds {editor.Tree.FindField().Text()}")
    Expect(editor.Tree.IsOpen(all["a"]), "it still has what was closed")
    editor.Finish()
End Function

@Test
Function MovingInTheTreeUndoesItsTurnAndScale() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    Local e = all["e"]
    e.SetRotation(Quat.FromAxisAngle(Vec3(0, 1, 0), 0.7))
    e.SetScale(Vec3(2, 3, 4))
    e.SetPosition(Vec3(5, 0, 0))
    Local d = all["d"]
    d.SetRotation(Quat.FromAxisAngle(Vec3(1, 0, 0), 0.4))
    d.SetScale(Vec3(0.5, 1.5, 2.5))
    Local place = d.Position()
    Local turned = d.Rotation()
    Local size = d.Scale()
    editor.Edits.Commit(ReparentEdit(editor.Edited, [d], e))
    Expect(Distance(d.Position(), place) > 0.1 && d.Scale() != size,
           "going under it changed nothing")
    editor.Edits.Undo()
    Expect(d.Parent() == Null)
    Expect(Distance(d.Position(), place) < 0.0001, "{d.Position()}, not {place}")
    Expect(Abs(Dot(d.Rotation(), turned)) > 0.99999, "{d.Rotation()}, not {turned}")
    Expect(Distance(d.Scale(), size) < 0.0001, "{d.Scale()}, not {size}")
    editor.Finish()
End Function
