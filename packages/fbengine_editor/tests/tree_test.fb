@Test
Function RowsStayThroughWhatDoesntChangeThem() Throws IOError, GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Local settings = Try TempDir()
    Local games = Try TempDir()
    Local editor = Try Started(settings, games)
    Local all = Named(editor)
    Local d = all["d"]
    Local row = editor.Tree.RowOf(d)
    If row == Null Then Panic("it has no row")
    // A handle's drag, step by step, and its undo.
    For step = 1 To 2
        editor.Edits.Commit(TransformEdit("Move", [d], [LocalPlace.Of(d)],
                                          [EntityPlace(Vec3(step As Float, 0, 0), Quat.Identity,
                                                       Vec3(1, 1, 1))], 1))
        editor.Step()
        Local still = editor.Tree.RowOf(d)
        Expect(still != Null && RefEquals(still, row), "a drag's step made its row again")
    End For
    editor.Edits.Undo()
    editor.Step()
    Local undone = editor.Tree.RowOf(d)
    Expect(undone != Null && RefEquals(undone, row), "its undo made its row again")
    // What does change the tree keeps the rows it can, and shows the rest.
    Expect(editor.Actions.Run("add.cube"))
    editor.Step()
    Local after = editor.Tree.RowOf(d)
    Expect(after != Null && RefEquals(after, row), "another's coming made its row again")
    Expect(editor.Tree.ShownEntities().Count == 6)
    // Under something else, it's another row, at another depth.
    d.SetParent(all["e"], True)
    editor.Tree.MarkChanged()
    editor.Step()
    Local moved = editor.Tree.RowOf(d)
    Expect(moved != Null && !RefEquals(moved, row))
    editor.Finish()
End Function

