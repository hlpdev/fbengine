// fbengine's editor: `fb run packages/fbengine_editor -- <a game's folder>`. With `-- --watch`, as
// tools/show.py runs it, it plays a scene of its own in a window, doing what a person would, until
// it's closed or Escape; `--frames <n>` after that, as a test runs it, keeps it headless for that
// many. With `-- --save <folder>`, as ctest runs it, it saves its panes, headless, as PNGs there. With
// `-- --play <folder>`, as a test runs it, it plays that game on a scene of its own, headless, and ends.

Import std.collections
Import std.core
Import std.io
Import std.math
Import std.os
Import fbengine
Import fbengine_ui.controls
Import "./browser"
Import "./commands"
Import "./component"
Import "./demo"
Import "./dialog"
Import "./dock"
Import "./editor"
Import "./handles"
Import "./history"
Import "./inspector"
Import "./menu"
Import "./play"
Import "./project"
Import "./scene"
Import "./session"
Import "./tree"
Import "./view"

Function Run(arguments: String[]) Throws IOError, GraphicsError
    Local editor = Try Editor()
    Try editor.Start(arguments.Count > 0 ? Path(arguments[0]) : Null)
    Frame.SetLimit(60)
    While !editor.Quitting()
        editor.Step()
    End While
    editor.Finish()
End Function

// What's after `name` in `arguments` as a number, or 0.
Function Asked(arguments: String[], name: String): Int
    For i = 0 Until arguments.Count - 1
        If arguments[i] == name Then Return Int.Parse(arguments[i + 1]) ?? 0
    End For
    Return 0
End Function

// An editor of its own, keeping nothing of the person's, on a project of its own with the demo's
// scene, and `folder`'s what keeps them both.
Function Demonstrating(folder: Path, headless: Bool): Editor Throws IOError, GraphicsError
    Window.SetHeadless(headless)
    Try MakeDemoProject(folder / "game")
    Local editor = Try Editor(folder / "settings")
    Try editor.Start(folder / "game")
    Return editor
End Function

// Clicks what's called `name` in the list that's open.
Function Picked(editor: Editor, name: String)
    Local popups = editor.Shown.Popups()
    If popups.Count == 0 Then Panic("there's no list open")
    Local item = popups[0].Find(name) As? Button
    If item == Null Then Panic("its list has no {name}")
    item.Click()
End Function

// What a person would do, one each second or so, around and around.
Function Doing(editor: Editor, scene: DemoScene, turn: Int)
    Select turn % 18
        Case 0
            editor.Edited.SelectOnly(scene.Crate)
        Case 1
            editor.Actions.Run("tool.turn")
        Case 2
            editor.Actions.Run("tool.scale")
        Case 3
            editor.Actions.Run("tool.move")
        Case 4
            editor.Actions.Run("view.frame")
        Case 5
            editor.Edited.SelectOnly(scene.Lamp)
        Case 6
            editor.Actions.Run("add.cube")
        Case 7
            editor.Actions.Run("edit.undo")
        Case 8
            editor.Edited.SelectOnly(scene.Lid)
        Case 9
            editor.Actions.Run("tree.duplicate")
        Case 10
            editor.Actions.Run("edit.undo")
        Case 11
            editor.Edited.SelectOnly(scene.Hinge)
        Case 12
            editor.Actions.Run("component.add")
        Case 13
            Picked(editor, "inspector.kind.Door")
        Case 14
            editor.Actions.Run("edit.undo")
        Case 15
            editor.Actions.Run("view.assets")
        Case 16
            editor.Actions.Run("view.output")
        Default
            editor.Edited.SelectOnly(Null)
    End Select
End Function

Function Watched(arguments: String[]) Throws IOError, GraphicsError
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    Local frames = Asked(arguments, "--frames")
    Local folder = Try TempDir()
    Local editor = Try Demonstrating(folder.Path, frames > 0)
    Window.SetTitle("fbengine's editor, playing by itself: Escape ends it")
    Frame.SetLimit(60)
    editor.Step()
    Local scene = FillDemoScene(editor)
    Local count = 0
    While !editor.Quitting() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        // By the frame, however fast, so each is seen; a test's are all it has.
        If count % (frames > 0 ? 2 : 60) == 0
            Doing(editor, scene, count / (frames > 0 ? 2 : 60))
            // There's nothing to keep, so closing it asks nothing.
            editor.Edits.MarkSaved()
        End If
        If count == Asked(arguments, "--press-at") && count > 0 Then Try Simulate.PressKey(Key.ESCAPE)
        If count == Asked(arguments, "--close-at") && count > 0 Then Try Simulate.CloseWindow()
        editor.Step()
        count += 1
    End While
    editor.Finish()
    Print("watched {count} frames")
End Function

// Plays the game in `folder` until it's ended, keeping nothing of the person's.
Function PlayedOnce(folder: Path) Throws IOError, GraphicsError
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    Window.SetHeadless(True)
    Local settings = Try TempDir()
    Local editor = Try Editor(settings.Path)
    editor.Kept.Trust(folder.Text)
    Try editor.Start(folder)
    editor.Step()
    editor.Actions.Run("add.cube")
    editor.SaveScene("res://level.scene")
    editor.Play()
    While editor.Run.Going()
        editor.Step()
    End While
    editor.Finish()
End Function

// A frame of the editor, as it's settled.
Function Saved(editor: Editor, folder: String, name: String) Throws IOError, GraphicsError
    editor.Step()
    editor.Step()
    Try Screen.Save(Path("{folder}/frame_{name}.png"))
End Function

// Its panes and what opens over them, each as a golden image is of it.
Function Saving(to: String) Throws IOError, GraphicsError
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    Try Dir.CreateAll(Path(to))
    Local folder = Try TempDir()
    Window.SetHeadless(True)
    Try MakeDemoProject(folder.Path / "game")
    Local editor = Try Editor(folder.Path / "settings")
    Try editor.Start()
    Try Simulate.MoveMouse(640, 700)
    Try Saved(editor, to, "welcome")
    editor.OpenFolder(folder.Path / "game")
    editor.Step()
    Local scene = FillDemoScene(editor)
    // All but one without the inspector, whose rows are as many as there are setters.
    editor.Docked.Hide("inspector")
    editor.View.LookAt(Vec3(0, 0.5, 0), 12)
    Try Saved(editor, to, "nothing_selected")
    editor.Edited.SelectOnly(scene.Crate)
    Try Saved(editor, to, "move")
    editor.Actions.Run("tool.turn")
    Try Saved(editor, to, "turn")
    editor.Actions.Run("tool.scale")
    Try Saved(editor, to, "scale")
    editor.Actions.Run("tool.move")
    // What's below it is out of the way too, so all of a component's rows show.
    editor.Docked.Show("inspector")
    editor.Docked.Hide("assets")
    editor.Docked.Hide("output")
    editor.Edited.SelectOnly(scene.Hinge)
    editor.Step()
    editor.Step()
    editor.Actions.Run("component.add")
    editor.Step()
    Picked(editor, "inspector.kind.Door")
    Try Saved(editor, to, "inspector")
    editor.Edited.SelectOnly(scene.Crate)
    Try Saved(editor, to, "inspector_mesh")
    // A material's rows past its color, scrolled to.
    editor.Inspector.ShowRow("EmissiveMap")
    Try Saved(editor, to, "inspector_material")
    editor.Edited.SelectOnly(scene.Lamp)
    Try Saved(editor, to, "inspector_light")
    // What a list of a row looks like, of an Enum's.
    Local kind = editor.Inspector.RowOf("LightType")?.Find("inspector.LightType.button") As? Button
    If kind == Null Then Panic("there's no LightType")
    kind.Click()
    Try Saved(editor, to, "choice_list")
    Try Simulate.PressKey(Key.ESCAPE)
    editor.Step()
    editor.Edited.SelectOnly(scene.Lens)
    Try Saved(editor, to, "inspector_camera")
    editor.Docked.Hide("inspector")
    editor.Docked.Show("assets")
    editor.Edited.SelectOnly(Null)
    editor.Step()
    // What opens over them, each by a click.
    Local title = editor.Shown.Root().Find("menu.Edit")
    If title == Null Then Panic("there's no Edit menu")
    Local on = title.Box().Center
    Try Simulate.MoveMouse(on.x, on.y)
    editor.Step()
    Try Simulate.Click(MouseButton.LEFT)
    Try Saved(editor, to, "menu")
    Try Simulate.PressKey(Key.ESCAPE)
    Try Simulate.MoveMouse(640, 700)
    editor.Step()
    editor.Actions.Run("file.open")
    editor.Step()
    // Without its field's cursor, which blinks.
    editor.Shown.Focus(Null)
    Try Saved(editor, to, "dialog")
    Try Simulate.PressKey(Key.ESCAPE)
    editor.Step()
    If editor.ShowingDialog() != Null Then Panic("the dialog's still there")
    editor.Actions.Run("view.reset")
    editor.Step()
    // What's found, in the tree.
    editor.Tree.FindField().SetText("l")
    editor.Step()
    editor.Shown.Focus(Null)
    Try Saved(editor, to, "tree_found")
    editor.Tree.FindField().SetText("")
    editor.Step()
    // A tab's own menu, and where a tab being dragged would go.
    Local tab = editor.Shown.Root().Find("tab.tree")
    If tab == Null Then Panic("there's no tree tab")
    Local grabbed = tab.Box().Center
    Try Simulate.MoveMouse(grabbed.x, grabbed.y)
    editor.Step()
    Try Simulate.Click(MouseButton.RIGHT)
    Try Saved(editor, to, "tab_menu")
    Try Simulate.PressKey(Key.ESCAPE)
    editor.Step()
    Try Simulate.MouseDown(MouseButton.LEFT)
    editor.Step()
    Local over = editor.View.Box().Center
    Try Simulate.MoveMouse(over.x, over.y)
    editor.Step()
    Try Saved(editor, to, "dock_hint")
    Try Simulate.MoveMouse(grabbed.x, grabbed.y)
    editor.Step()
    Try Simulate.MouseUp(MouseButton.LEFT)
    editor.Step()
    editor.Actions.Run("view.reset")
    Try Simulate.MoveMouse(640, 700)
    editor.Step()
    // The files, a picture's thumbnail come.
    editor.Docked.Activate("assets")
    editor.Files.SetOpen("res://levels", True)
    Local waited = 0
    While !editor.Files.ThumbDone("res://checks.png") ||
          editor.Files.ThumbOf("res://checks.png") == Null ||
          !editor.Files.ThumbDone("res://blade.gltf") ||
          editor.Files.ThumbOf("res://blade.gltf") == Null
        waited += 1
        If waited > 1000 Then Panic("the picture's thumbnail never came")
        editor.Step()
    End While
    editor.Files.Choose("res://notes.txt")
    Try Saved(editor, to, "assets")
    // A picture chosen, with what it's imported as.
    editor.Files.Choose("res://checks.png")
    Try Saved(editor, to, "assets_image")
    // What a run says, of one that can't start, so nothing's left over.
    editor.Docked.Activate("output")
    Local open = editor.Current()
    If open == Null Then Panic("there's no project")
    editor.Run.Fb = "no such program"
    editor.Run.Start(open, "res://level.scene")
    editor.Run.Log.Clear()
    For line In ["Building demo…", "   Compiling demo v0.1.0", "read 1, Crate at (1.5, 2, -3)"]
        editor.Run.Log.Say(line)
    End For
    Try Saved(editor, to, "output")
    editor.Finish()
    Print("saved")
End Function

Try
    Local arguments = Process.Arguments()
    If arguments.Contains("--watch")
        Try Watched(arguments)
    ElseIf arguments.Count == 2 && arguments[0] == "--save"
        Try Saving(arguments[1])
    ElseIf arguments.Count == 2 && arguments[0] == "--play"
        Try PlayedOnce(Path(arguments[1]))
    Else
        Try Run(arguments)
    End If
Catch error As Error
    PrintError("the editor couldn't start: {error.Message}")
    Process.Exit(1)
End Try
// Now, as ending by itself waits for every read that's been asked for, and something a game started can
// hold its output for as long as it likes. All that's to be kept has been.
Process.Exit(0)
