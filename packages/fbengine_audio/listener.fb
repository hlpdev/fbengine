// The Listener: where sounds in the world are heard from.

Import std.core
Import std.math
Import "./audio"
Import "./c/fbe_listener"

/// Where sounds in the world, the Channels Emitters play, are heard from, which there's one of: a
/// game puts it where its camera is, each frame. Its place, rotation, and velocity are in
/// std.math's axes, right-handed, Y up, and -Z forward, and in the game's units, and are kept while
/// the audio's stopped.
Public Final Class Listener
    Static Field position: Vec3 = Vec3(0, 0, 0)
    Static Field rotation: Quat = Quat.Identity
    Static Field velocity: Vec3 = Vec3(0, 0, 0)

    Private New()
    End New

    /// Puts it at `position`.
    @MainThread Public Static Method SetPosition(position: Vec3)
        CheckVector(position, "a Listener's position")
        Listener.position = position
        fbe_listener_set_position(position.x, position.y, position.z)
    End Method

    /// Where it is.
    @MainThread Public Static Method Position(): Vec3 => position

    /// Turns it by `rotation` from facing -Z with Y up, as a camera turned by it faces.
    @MainThread Public Static Method SetRotation(rotation: Quat)
        Local forward = Normalize(rotation) * Vec3(0, 0, -1)
        Local up = Normalize(rotation) * Vec3(0, 1, 0)
        CheckVector(forward, "a Listener's rotation")
        Listener.rotation = rotation
        fbe_listener_set_direction(forward.x, forward.y, forward.z, up.x, up.y, up.z)
    End Method

    /// How it's turned.
    @MainThread Public Static Method Rotation(): Quat => rotation

    /// Sets how fast it's moving, in units a second, which pitches what it hears by the Doppler
    /// effect, as it moves toward an Emitter or away.
    @MainThread Public Static Method SetVelocity(velocity: Vec3)
        CheckVector(velocity, "a Listener's velocity")
        Listener.velocity = velocity
        fbe_listener_set_velocity(velocity.x, velocity.y, velocity.z)
    End Method

    /// How fast it's moving.
    @MainThread Public Static Method Velocity(): Vec3 => velocity

    /// Sets how many units a second sound goes, more than 0: 343.3, as it starts, is in the air in
    /// meters, and a game whose units aren't meters gives its own.
    @MainThread Public Static Method SetSpeedOfSound(unitsPerSecond: Float32)
        If !fbe_listener_set_speed_of_sound(unitsPerSecond) Then Panic(LastError())
    End Method

    /// How many units a second sound goes.
    @MainThread Public Static Method SpeedOfSound(): Float32 => fbe_listener_speed_of_sound()
End Class

// A vector that isn't a number is a mistake.
@PanicsAtCaller
Package Function CheckVector(vector: Vec3, what: String)
    If !IsFinite(vector.x) || !IsFinite(vector.y) || !IsFinite(vector.z)
        Panic("{what} is a vector of numbers, not {vector}")
    End If
End Function
