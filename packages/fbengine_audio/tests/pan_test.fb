// Pan laws, and sound positioned by hand, as SCP:CB's is: each frame, each channel's volume is
// `volume * (1 - distance / range)` and its pan `Sin(-DeltaYaw(camera, source))`. Mixed in stereo
// on no device, a mono 0.5 a frame late, as in sound_test.fb.

Import std.core
Import std.math
Import std.test
Import fbengine_audio
Import "./wav"

Function Close(a: Float32, b: Float32): Bool => a - b < 0.00001 && b - a < 0.00001

// What a mono 0.5 is heard as on each side at `pan`, by `law`.
Function Sides(law: PanLaw, pan: Float32): Float32[]
    If law == PanLaw.CONSTANT_POWER
        Local angle = (pan + 1.0) * Pi / 4.0
        Return [0.5 * Max(Cos(angle), 0.0), 0.5 * Max(Sin(angle), 0.0)]
    End If

    If law == PanLaw.LINEAR Then Return [0.5 * (1.0 - pan) / 2.0, 0.5 * (1.0 + pan) / 2.0]
    Return [0.5 * Min(1.0 - pan, 1.0), 0.5 * Min(1.0 + pan, 1.0)]
End Function

// A channel of a looping mono 0.5, a frame in, so what's mixed next is what it's set to.
Function Playing(): Channel Throws SoundError
    Local sound = Try Sound.FromBytes(Wav(Constant(16384, 64)))
    sound.SetLoop(True)
    Local channel = sound.Play()
    Audio.Mix(1)
    Return channel
End Function

@Test
Function EachLawSplitsAMonoSoundAsItSays() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    Local channel = Try Playing()
    For law In [PanLaw.BALANCE, PanLaw.CONSTANT_POWER, PanLaw.LINEAR]
        Audio.SetPanLaw(law)
        Expect(Audio.PanLaw() == law)
        For pan In [-1.0, -0.5, 0.0, 0.25, 1.0] As Float32[]
            channel.SetPan(pan)
            // Once it's ramped to, over 5 ms of the mix.
            Local mixed = Audio.Mix(221)
            Local sides = Sides(law, pan)
            Expect(Close(mixed[440], sides[0]) && Close(mixed[441], sides[1]))
        End For
    End For
End Function

// A law changed while channels play is ramped to over the next 5 ms of the mix, 221 frames at
// 44100 Hz, so it doesn't click, and leaves their volumes and pans as they were set.
@Test
Function ALawChangesWhatsPlaying() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    Local channel = Try Playing()
    channel.SetVolume(0.5)
    Local settled = Audio.Mix(221)
    Expect(settled[440] == 0.25 && settled[441] == 0.25)
    Audio.SetPanLaw(PanLaw.LINEAR)
    Local mixed = Audio.Mix(300)
    Expect(mixed[0] < 0.25 && mixed[0] > 0.24)
    For i = 1 To 299
        Expect(mixed[i * 2] <= mixed[(i - 1) * 2] && mixed[i * 2] == mixed[i * 2 + 1])
    End For
    Expect(mixed[438] > 0.125)
    Expect(mixed[440] == 0.125 && mixed[598] == 0.125)
    Expect(channel.Volume() == 0.5)
    Expect(channel.Pan() == 0.0)
End Function

// A stereo sound is balanced, whatever the law: in the middle, it plays as it is.
@Test
Function AStereoSoundIsBalancedWhateverTheLaw() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    Audio.SetPanLaw(PanLaw.CONSTANT_POWER)
    Local samples: Int[] = []
    For i = 1 To 600
        samples.Add(16384)
        samples.Add(8192)
    End For
    Local sound = Try Sound.FromBytes(Wav(samples, 2, 44100))
    Local channel = sound.Play()
    Expect(Audio.Mix(2) == [0.0, 0.0, 0.5, 0.25] As Float32[])
    channel.SetPan(1.0)
    // Once it's ramped to, over 5 ms of the mix.
    Local mixed = Audio.Mix(221)
    Expect(mixed[440] == 0.0 && mixed[441] == 0.25)
End Function

// A source going round the camera, as SCP:CB hears one: its pan Sin(-yaw), its volume falling
// off over its range, set each frame on a looping channel.
@Test
Function ASoundPositionedByHandFollowsItsSource() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    Audio.SetPanLaw(PanLaw.CONSTANT_POWER)
    Local channel = Try Playing()
    Local range: Float32 = 10.0
    For frame = 0 To 35
        Local yaw = Deg((frame * 10) As Float)
        Local distance = 1.0 + (frame As Float) / 6.0
        Local volume = 1.0 - distance / range
        Local pan = Sin(-yaw)
        channel.SetVolume(volume)
        channel.SetPan(pan)
        Local mixed = Audio.Mix(735)
        Local sides = Sides(PanLaw.CONSTANT_POWER, pan)
        Expect(Close(mixed[1468], sides[0] * volume) && Close(mixed[1469], sides[1] * volume))
    End For
End Function

// A looping mono sine at 0.5, 441 Hz in a 44100 Hz mix: no step of it is more than 0.5 * 2 * Pi *
// 441 / 44100, about 0.0314.
Function Sine(): Channel Throws SoundError
    Local samples: Int[] = []
    For i = 0 To 99
        samples.Add((Sin(Tau * (i As Float) / 100.0) * 16384.0) As Int)
    End For
    Local sound = Try Sound.FromBytes(Wav(samples, 1, 44100))
    sound.SetLoop(True)
    Local channel = sound.Play()
    Audio.Mix(1)
    Return channel
End Function

// The largest step from one frame to the next on either side, `last` the frame before `mixed`.
Function LargestStep(mixed: Float32[], last: Float32[]): Float32
    Local step = Max(Abs(mixed[0] - last[0]), Abs(mixed[1] - last[1]))
    For i = 1 To mixed.Count / 2 - 1
        step = Max(step, Abs(mixed[i * 2] - mixed[(i - 1) * 2]))
        step = Max(step, Abs(mixed[i * 2 + 1] - mixed[(i - 1) * 2 + 1]))
    End For
    Return step
End Function

// A law switched at the sine's peak is ramped to, so no step is bigger than the sine's own.
@Test
Function ALawSwitchedMidPlayDoesntClick() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    For pair In [[PanLaw.BALANCE, PanLaw.CONSTANT_POWER], [PanLaw.BALANCE, PanLaw.LINEAR],
                 [PanLaw.CONSTANT_POWER, PanLaw.LINEAR]]
        Audio.SetPanLaw(pair[0])
        Local channel = Try Sine()
        channel.SetPan(0.5)
        Local before = Audio.Mix(1025)
        Audio.SetPanLaw(pair[1])
        Local after = Audio.Mix(735)
        Expect(LargestStep(after, [before[2048], before[2049]]) < 0.034)
        channel.Stop()
    End For
End Function

// A source positioned by hand, its pan and volume set each frame, as pan_test's going round the
// camera: where each frame's settings land, the step is no bigger than the sine's own.
@Test
Function ASoundPositionedByHandDoesntZipper() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    Audio.SetPanLaw(PanLaw.CONSTANT_POWER)
    Local channel = Try Sine()
    Local last: Float32[] = [0.0, 0.0]
    Local largest: Float32 = 0.0
    For frame = 0 To 35
        channel.SetVolume(1.0 - (1.0 + (frame As Float) / 6.0) / 10.0)
        channel.SetPan(Sin(-Deg((frame * 10) As Float)))
        Local mixed = Audio.Mix(735)
        If frame > 0 Then largest = Max(largest, LargestStep(mixed, last))
        last = [mixed[1468], mixed[1469]]
    End For
    Expect(largest < 0.034)
End Function
