// Pan laws, and sound positioned by hand, as SCP:CB's is: each frame, each channel's volume is
// `volume * (1 - distance / range)` and its pan `Sin(-DeltaYaw(camera, source))`. Mixed in stereo
// on no device, a mono 0.5 a frame late, as in sound_test.fb.

Import std.core
Import std.math
Import std.test
Import fbengine_audio
Import "./wav"

Function Close(a: Float32, b: Float32): Bool => a - b < 0.00001 && b - a < 0.00001

// What a mono 0.5 is heard as on each side at `pan`, by `law`.
Function Sides(law: PanLaw, pan: Float32): Float32[]
    If law == PanLaw.CONSTANT_POWER
        Local angle = (pan + 1.0) * Pi / 4.0
        Return [0.5 * Max(Cos(angle), 0.0), 0.5 * Max(Sin(angle), 0.0)]
    End If

    If law == PanLaw.LINEAR Then Return [0.5 * (1.0 - pan) / 2.0, 0.5 * (1.0 + pan) / 2.0]
    Return [0.5 * Min(1.0 - pan, 1.0), 0.5 * Min(1.0 + pan, 1.0)]
End Function

// A channel of a looping mono 0.5, a frame in, so what's mixed next is what it's set to.
Function Playing(): Channel Throws SoundError
    Local sound = Try Sound.FromBytes(Wav(Constant(16384, 64)))
    sound.SetLoop(True)
    Local channel = sound.Play()
    Audio.Mix(1)
    Return channel
End Function

@Test
Function EachLawSplitsAMonoSoundAsItSays() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    Local channel = Try Playing()
    For law In [PanLaw.BALANCE, PanLaw.CONSTANT_POWER, PanLaw.LINEAR]
        Audio.SetPanLaw(law)
        Expect(Audio.PanLaw() == law)
        For pan In [-1.0, -0.5, 0.0, 0.25, 1.0] As Float32[]
            channel.SetPan(pan)
            Local mixed = Audio.Mix(1)
            Local sides = Sides(law, pan)
            Expect(Close(mixed[0], sides[0]) && Close(mixed[1], sides[1]))
        End For
    End For
End Function

// A law changed while channels play is heard from the next mix, and leaves their volumes and pans
// as they were set.
@Test
Function ALawChangesWhatsPlaying() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    Local channel = Try Playing()
    channel.SetVolume(0.5)
    Expect(Audio.Mix(1) == [0.25, 0.25] As Float32[])
    Audio.SetPanLaw(PanLaw.LINEAR)
    Expect(Audio.Mix(1) == [0.125, 0.125] As Float32[])
    Expect(channel.Volume() == 0.5)
    Expect(channel.Pan() == 0.0)
End Function

// A stereo sound is balanced, whatever the law: in the middle, it plays as it is.
@Test
Function AStereoSoundIsBalancedWhateverTheLaw() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    Audio.SetPanLaw(PanLaw.CONSTANT_POWER)
    Local sound = Try Sound.FromBytes(Wav([16384, 8192, 16384, 8192, 16384, 8192], 2, 44100))
    Local channel = sound.Play()
    Expect(Audio.Mix(2) == [0.0, 0.0, 0.5, 0.25] As Float32[])
    channel.SetPan(1.0)
    Expect(Audio.Mix(1) == [0.0, 0.25] As Float32[])
End Function

// A source going round the camera, as SCP:CB hears one: its pan Sin(-yaw), its volume falling
// off over its range, set each frame on a looping channel.
@Test
Function ASoundPositionedByHandFollowsItsSource() Throws AudioError, SoundError
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Defer Audio.SetPanLaw(PanLaw.BALANCE)
    Audio.SetPanLaw(PanLaw.CONSTANT_POWER)
    Local channel = Try Playing()
    Local range: Float32 = 10.0
    For frame = 0 To 35
        Local yaw = Deg((frame * 10) As Float)
        Local distance = 1.0 + (frame As Float) / 6.0
        Local volume = 1.0 - distance / range
        Local pan = Sin(-yaw)
        channel.SetVolume(volume)
        channel.SetPan(pan)
        Local mixed = Audio.Mix(735)
        Local sides = Sides(PanLaw.CONSTANT_POWER, pan)
        Expect(Close(mixed[1468], sides[0] * volume) && Close(mixed[1469], sides[1] * volume))
    End For
End Function
