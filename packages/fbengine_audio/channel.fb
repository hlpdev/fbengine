// Channels: one play of a Sound each, a small value Sound.Play gives.

Import std.core
Import std.math
Import "./audio"
Import "./bus"
Import "./c/fbe_channel"

/// One play of a Sound, which Sound.Play gives. It plays until its sound ends, or for good when it
/// loops, until it's stopped, or the audio is; after that it's finished, and its Methods do nothing
/// and say 0 or False, so a game can stop or ask about a Channel whose sound ended long ago. A
/// Channel's zero, a Field's before it's given a play, is finished from the start.
Public Struct Channel
    Package Field handle: UInt64

    /// Whether it's playing, or paused: False once it's finished.
    @MainThread Public Method Playing(): Bool => fbe_channel_playing(handle)

    /// Whether it's paused, which a finished Channel isn't.
    @MainThread Public Method Paused(): Bool => fbe_channel_paused(handle)

    /// Stops it, which finishes it at once; what's heard ramps to silence over the next few
    /// milliseconds the mix makes, so it doesn't click.
    @MainThread Public Method Stop()
        fbe_channel_stop(handle)
    End Method

    /// Pauses it where it is, until Resume, ramping to silence over the next few milliseconds the
    /// mix makes, so it doesn't click.
    @MainThread Public Method Pause()
        fbe_channel_pause(handle)
    End Method

    /// Plays it on from where Pause left it, ramping back from silence, or from its start, for a play
    /// that started paused.
    @MainThread Public Method Resume()
        fbe_channel_resume(handle)
    End Method

    /// Sets its volume, 0 or more: 1 plays its sound as it is, 0.5 at half its amplitude.
    @MainThread Public Method SetVolume(volume: Float32)
        CheckVolume(volume)
        fbe_channel_set_volume(handle, volume)
    End Method

    /// Its volume.
    @MainThread Public Method Volume(): Float32 => fbe_channel_volume(handle)

    /// Sets its pan, from -1, the left only, through 0, both, to 1, the right only, in a stereo
    /// mix, as Audio's PanLaw has it; in a mix that isn't stereo, a pan does nothing. A change of
    /// pan or volume is ramped over the next few milliseconds the mix makes, so it doesn't click.
    @MainThread Public Method SetPan(pan: Float32)
        CheckPan(pan)
        fbe_channel_set_pan(handle, pan)
    End Method

    /// Its pan.
    @MainThread Public Method Pan(): Float32 => fbe_channel_pan(handle)

    /// Sets its pitch, from 1/16 to 16: 1 is as its sound was recorded, 2 an octave higher and
    /// twice as fast. A Channel an Emitter plays is pitched by the Doppler effect too, and plays at
    /// the two together, held to 1/16 to 16.
    @MainThread Public Method SetPitch(pitch: Float32)
        CheckPitch(pitch)
        fbe_channel_set_pitch(handle, pitch)
    End Method

    /// Its pitch.
    @MainThread Public Method Pitch(): Float32 => fbe_channel_pitch(handle)

    /// Makes it loop, from its sound's end to its start, or play to its end and finish.
    @MainThread Public Method SetLoop(loop: Bool)
        fbe_channel_set_loop(handle, loop)
    End Method

    /// Whether it loops.
    @MainThread Public Method Looping(): Bool => fbe_channel_looping(handle)

    /// How many seconds into its sound it's been mixed to, as of the last mix, which a device's
    /// is a few milliseconds ahead of what's heard.
    @MainThread Public Method Position(): Float64 => fbe_channel_position(handle)

    /// Plays it on from `seconds` into its sound, from 0 to its length, from the next mix.
    @MainThread Public Method Seek(seconds: Float64)
        If !IsFinite(seconds) || seconds < 0.0
            Panic("a seek is 0 seconds to its sound's length, not {seconds}")
        End If

        If !fbe_channel_seek(handle, seconds) Then Panic(LastError())
    End Method

    /// Fades it, from where its fade is, 1 as it starts, to `level`, 0 or more, over `seconds`, 0
    /// for at once. Its fade multiplies its volume, so the two don't undo each other.
    @MainThread Public Method FadeTo(level: Float32, seconds: Float64)
        CheckVolume(level)
        CheckFade(seconds)
        fbe_channel_fade(handle, level, seconds)
    End Method

    /// Fades it to silence over `seconds`, then finishes it, or finishes it at once for 0.
    @MainThread Public Method FadeOut(seconds: Float64)
        CheckFade(seconds)
        fbe_channel_fade_out(handle, seconds)
    End Method

    /// Where its fade is, from 1 as it starts.
    @MainThread Public Method Fade(): Float32 => fbe_channel_fade_level(handle)

    /// Moves it into `bus`, or the whole mix for Null, from the next mix.
    @MainThread Public Method SetBus(bus: Bus?)
        Local into: UInt64 = 0
        If bus != Null Then into = bus.Live()
        fbe_channel_set_bus(handle, into)
    End Method
End Struct
