// The frame: Flip ends one, and Frame says how long it took.

Import std.collections
Import std.core
Import "./c/fbe_frame"
Import "./window"

/// Ends the frame: presents it, waiting for the display when `vsync` is True, waits for
/// Frame's limit if there's one, reads the OS's events into the next frame's input, then resumes
/// the coroutines waiting for the next tick, as `Scheduler.Main.Step()` does, so they run before
/// the next frame's code.
@MainThread Public Function Flip(vsync: Bool = True)
    fbe_frame_flip(vsync)
    Frame.RunHooks()
    Scheduler.Main.Step()
End Function

// A function OnFlip added, by the number it gave for it, and whether it runs after the others.
Struct FlipHook
    Field Id: Int
    Field Run: Func()
    Field Late: Bool
End Struct

/// How long frames take, and the most there can be a second.
Public Final Class Frame
    Static Field hooks: FlipHook[] = []
    Static Field lastHook: Int = 0

    Private New()
    End New

    /// Runs `hook` at every Flip, after the OS's events are read and before the coroutines
    /// resume, in the order hooks were added: how a package does its work each frame, as audio
    /// following a camera or physics moving entities, without the game calling it. Gives the
    /// number RemoveOnFlip takes. A `late` hook runs after every other, in the order late ones
    /// were added, as audio following entities does, to hear them where the other hooks, as
    /// physics', moved them that frame.
    @MainThread Public Static Method OnFlip(hook: Func(), late: Bool = False): Int
        lastHook += 1
        hooks.Add(FlipHook(lastHook, hook, late))
        Return lastHook
    End Method

    /// Stops running the hook OnFlip gave `id` for; one that's gone already is left as it is.
    @MainThread Public Static Method RemoveOnFlip(id: Int)
        For i = 0 To hooks.Count - 1
            If hooks[i].Id == id
                hooks.RemoveAt(i)
                Return
            End If
        End For
    End Method

    // Each hook as Flip found them, so one that adds or removes hooks changes the next Flip's: the
    // others, then the late ones.
    @MainThread Package Static Method RunHooks()
        Local running: FlipHook[] = []
        running.AddAll(hooks)
        For hook In running
            If !hook.Late Then hook.Run()
        End For
        For hook In running
            If hook.Late Then hook.Run()
        End For
    End Method

    /// How many seconds the last frame took, from one Flip to the next, 0 before the second; while
    /// SetFixedDelta's set, what it was given, every frame.
    @MainThread Public Static Method Delta(): Float64 => fbe_frame_delta()

    /// Makes Delta `seconds` every frame, from now, whatever the clock says, for tests and tools
    /// that step a game by hand: what's timed by Delta, as a gamepad's repeat in a Ui, a field's
    /// cursor, and whatever a game steps by it, goes the same on any machine, however long its
    /// frames take. 0 takes it away, back to the clock. Rate and the limit stay on the clock.
    /// Under 0, or not finite, panics.
    @MainThread @PanicsAtCaller
    Public Static Method SetFixedDelta(seconds: Float64)
        If !fbe_frame_set_fixed_delta(seconds) Then Panic(LastError())
    End Method

    /// What SetFixedDelta last set, 0 for none.
    @MainThread Public Static Method FixedDelta(): Float64 => fbe_frame_fixed_delta()

    /// Whether the last Flip asked to wait for the display, True before the first.
    @MainThread Public Static Method Vsync(): Bool => fbe_frame_vsync()

    /// How many frames have been flipped.
    @MainThread Public Static Method Count(): Int64 => fbe_frame_count()

    /// Frames a second, over the last half second or more, 0 until then.
    @MainThread Public Static Method Rate(): Float64 => fbe_frame_rate()

    /// Makes Flip wait so there are at most `framesPerSecond` frames a second, from 1 to 1000,
    /// or takes the limit away with 0.
    @MainThread Public Static Method SetLimit(framesPerSecond: Int32)
        If !fbe_frame_set_limit(framesPerSecond) Then Panic(LastError())
    End Method

    /// The most frames a second Flip lets through, 0 for no limit.
    @MainThread Public Static Method Limit(): Int32 => fbe_frame_limit()
End Class
