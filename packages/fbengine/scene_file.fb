// Scenes on disk: a tree of entities as TOML, one table to a thing, so it diffs and merges by its
// lines; what's drawn by what it's made of, a res:// file's or built in, or by its vertices if neither.

Import std.collections
Import std.core
Import std.data
Import std.io
Import std.math
Import std.os
Import std.text
Import "./camera"
Import "./collision"
Import "./components"
Import "./entity"
Import "./geometry"
Import "./light"
Import "./assets"
Import "./material"
Import "./mesh"
Import "./model"
Import "./morph"
Import "./pick"
Import "./sprite"
Import "./texture"
Import "./transform"
Import "./visibility"
Import "./window"
Import "./world"

Const FORMAT: Int32 = 1

// What a file can say of an entity, whatever it is, and of each kind.
Const EVERY_ENTITY = ["path", "kind", "name", "position", "rotation", "scale", "hidden", "pick",
                      "blocks_sight", "group", "shape", "radius", "box", "step_height", "max_slope",
                      "auto_fade", "occluder", "casts_shadows", "components"]
Const OF_MESH = ["geometry", "material", "color", "morph"]
Const OF_LIGHT = ["light", "color", "intensity", "range", "cone", "shadows", "shadow_size",
                  "shadow_bias", "cascades", "shadow_distance"]
Const OF_CAMERA = ["projection", "field_of_view", "height", "range", "clear", "clear_depth",
                   "clear_color", "order", "fog", "fog_color", "fog_range", "fog_density", "hdr",
                   "exposure", "tonemap", "gamma", "bloom", "grade", "occlusion",
                   "ambient_occlusion", "ambient_occlusion_radius", "fxaa", "temporal_aa"]
Const OF_SPRITE = ["material", "color", "view", "size", "handle", "turn"]
Const OF_DOCUMENT = ["format", "material", "geometry", "entity"]
Const OF_MATERIAL = ["id", "color", "shading", "blend", "alpha_cutoff", "shininess",
                     "vertex_colors",
                     "wireframe", "two_sided", "fogged", "order", "layers", "metallic",
                     "roughness", "emissive", "normal_scale", "occlusion_strength", "maps"]
Const OF_MAP = ["map", "texture", "uv_set", "uv"]
Const OF_LAYER = ["layer", "texture", "blend", "uv_set", "uv", "bump"]
Const OF_GEOMETRY = ["id", "source", "surfaces", "cull_box"]
Const OF_SURFACE = ["material", "vertices", "triangles"]

// A number as the shortest text its Float32 is, which a Float32 of it reads back exactly.
Function Number(value: Float32): Value Throws IOError
    Local read = Double.Parse("{value}")
    If read == Null || !IsFinite(value)
        Throw IOError(IOErrorKind.INVALID_DATA, "{value} can't be a number in a scene")
    End If
    Return Value(read)
End Function

Function Numbers(values: Float32[]): Value Throws IOError
    Local made = Value.Array()
    For each In values
        made.Add(Try Number(each))
    End For
    Return made
End Function

Function Three(v: Vec3): Value Throws IOError => Try Numbers([v.x, v.y, v.z])

Function Four(c: Color): Value Throws IOError => Try Numbers([c.r, c.g, c.b, c.a])

// Where in a component `value` is what TOML can't write, which would panic at it, or Null. An Object's
// Null is only left out, so it's read back as what its Field has at first.
Function Unwritable(value: Value, at: String, depth: Int = 0): String?
    If depth >= MOST_NESTED Then Return "{at} is nested past the {MOST_NESTED} deep a scene can hold"
    Select value.Kind
        Case ValueKind.UINT
            Return "{at} is {value}, past the Int64 a scene's whole numbers are"
        Case ValueKind.BYTES
            Return "{at} is bytes, which a scene can't hold"
        Case ValueKind.ARRAY
            Local items = value.AsArray() ?? []
            For i = 0 Until items.Count
                If items[i].IsNull Then Return "{at}[{i}] is Null, which a scene's lists can't hold"
                Local said = Unwritable(items[i], "{at}[{i}]", depth + 1)
                If said != Null Then Return said
            End For
        Case ValueKind.OBJECT
            For key In value.Keys()
                Local part = value[key]
                If part == Null Then Continue
                Local said = Unwritable(part, "{at}.{key}", depth + 1)
                If said != Null Then Return said
            End For
        Default
    End Select
    Return Null
End Function

// What's being written: what's in it, and the ids it's given what's shared. What's in a file keeps its
// id from one save to the next, on the thing itself; what's new takes its id from its first user's
// path and what it is to that, so what's around it changing doesn't change it.
Class Writing
    Field Document: Value
    Field Entities: Value
    Field Materials: Value? = Null
    Field Geometries: Value? = Null
    Field MaterialIds: Map<UInt64, String>
    Field GeometryIds: Map<UInt64, String>
    Field Taken: Set<String>
    Field Claims: Map<String, UInt64>
    Field Uses: Map<UInt64, Int>

    New()
        Document = Value.Object()
        Document["format"] = Value(FORMAT)
        Entities = Value.Array()
        MaterialIds = {}
        GeometryIds = {}
        Taken = Set<String>()
        Claims = {}
        Uses = {}
    End New

    // How often each geometry's used, and the ids what's in the file has already: first come, first
    // served, before anything's given a new one.
    Method Looked(entity: Entity)
        Local mesh = entity As? Mesh
        If mesh != Null
            Local geometry = mesh.Geometry()
            If geometry != Null
                Local handle = geometry.Live("Save")
                Uses[handle] = (Uses.Get(handle) ?? 0) + 1
                Claim(geometry.SceneId(), handle)
                If geometry.Source() == Null
                    For surface In geometry.Surfaces()
                        ClaimOf(surface.Material())
                    End For
                End If
            End If
            ClaimOf(mesh.Material())
        End If
        ClaimOf((entity As? Sprite)?.Material())
        For child In entity.Children()
            Looked(child)
        End For
    End Method

    Method ClaimOf(material: Material?)
        If material != Null Then Claim(material.SceneId(), material.Live("Save"))
    End Method

    Method Claim(id: String, handle: UInt64)
        If id == "" || Claims.Get(id) != Null Then Return
        Claims[id] = handle
        Taken.Add(id)
    End Method

    // `base`, or the first of `base`-2 and on that nothing has yet.
    Method Unique(base: String): String
        Local id = base
        Local n = 1
        While Taken.Contains(id)
            n += 1
            id = "{base}-{n}"
        End While
        Taken.Add(id)
        Return id
    End Method

    // The id of what's kept `kept`, if it's first to it, else a new one from `base`.
    Method IdOf(kept: String, handle: UInt64, base: String): String
        If kept != "" && Claims.Get(kept) == handle Then Return kept
        Return Unique(base)
    End Method

    // The id of `material`, whose first user is at `user`, and it's `slot` to that.
    Method MaterialId(material: Material, user: String, slot: String): String Throws IOError
        Local handle = material.Live("Save")
        Local had = MaterialIds.Get(handle)
        If had != Null Then Return had
        Local id = IdOf(material.SceneId(), handle, "{user}.{slot}")
        material.SetSceneId(id)
        Local table = Value.Object()
        table["id"] = Value(id)
        table["color"] = Try Four(material.Color())
        table["shading"] = Value("{material.Shading()}")
        table["blend"] = Value("{material.Blend()}")
        If material.AlphaCutoff() != 0.0 Then table["alpha_cutoff"] = Try Number(material.AlphaCutoff())
        If material.Shininess() != 0.0 Then table["shininess"] = Try Number(material.Shininess())
        If material.VertexColors() Then table["vertex_colors"] = Value(True)
        If material.Wireframe() Then table["wireframe"] = Value(True)
        If material.TwoSided() Then table["two_sided"] = Value(True)
        If !material.Fogged() Then table["fogged"] = Value(False)
        If material.Order() != 0 Then table["order"] = Value(material.Order() As Int32)
        Local plain = Material()
        Defer plain.Free()
        If material.Metallic() != plain.Metallic() Then table["metallic"] = Try Number(material.Metallic())
        If material.Roughness() != plain.Roughness()
            table["roughness"] = Try Number(material.Roughness())
        End If
        Local glow = material.Emissive()
        If glow != plain.Emissive() Then table["emissive"] = Try Numbers([glow.r, glow.g, glow.b])
        If material.NormalScale() != plain.NormalScale()
            table["normal_scale"] = Try Number(material.NormalScale())
        End If
        If material.OcclusionStrength() != plain.OcclusionStrength()
            table["occlusion_strength"] = Try Number(material.OcclusionStrength())
        End If
        Local maps = Value.Array()
        For map In ALL_MAPS
            Local texture = material.Map(map)
            Local turn = material.MapUv(map)
            Local uvSet = material.MapUvSet(map)
            If texture == Null && uvSet == 0 && turn == plain.MapUv(map) Then Continue
            Local one = Value.Object()
            one["map"] = Value("{map}")
            If texture != Null Then one["texture"] = Value(Try FileOf(texture, user,
                                                                      "the {map} map"))
            If uvSet != 0 Then one["uv_set"] = Value(uvSet)
            If turn != plain.MapUv(map)
                one["uv"] = Try Numbers([turn.Scale.x, turn.Scale.y, turn.Angle, turn.Offset.x,
                                         turn.Offset.y])
            End If
            maps.Add(one)
        End For
        If maps.Count > 0 Then table["maps"] = maps
        Local layers = Value.Array()
        For at = 0 To 7
            Local texture = material.Texture(at)
            Local turn = material.LayerUv(at)
            Local bump = material.LayerBump(at)
            If texture == Null && material.LayerBlend(at) == plain.LayerBlend(at) &&
               material.LayerUvSet(at) == plain.LayerUvSet(at) && turn == plain.LayerUv(at) &&
               bump == plain.LayerBump(at)
                Continue
            End If
            Local layer = Value.Object()
            layer["layer"] = Value(at As Int32)
            If texture != Null Then layer["texture"] = Value(Try FileOf(texture, user,
                                                                        "layer {at}"))
            layer["blend"] = Value("{material.LayerBlend(at)}")
            layer["uv_set"] = Value(material.LayerUvSet(at) As Int32)
            layer["uv"] = Try Numbers([turn.Scale.x, turn.Scale.y, turn.Angle, turn.Offset.x,
                                       turn.Offset.y])
            layer["bump"] = Try Numbers([bump.M00, bump.M01, bump.M10, bump.M11, bump.Scale,
                                         bump.Offset])
            layers.Add(layer)
        End For
        If layers.Count > 0 Then table["layers"] = layers
        Local all = Materials ?? Value.Array()
        Materials = all
        all.Add(table)
        MaterialIds[handle] = id
        Return id
    End Method

    // The res:// file `texture` is from, which `slot` of the material of `user` has it.
    Method FileOf(texture: Texture, user: String, slot: String): String Throws IOError
        Local path = texture.Path()
        If path == Null
            Throw IOError(IOErrorKind.INVALID_DATA,
                          "{user}: {slot} of its material has a texture from no file, which a scene can't name")
        End If
        If !path.StartsWith("res://")
            Throw IOError(IOErrorKind.INVALID_DATA,
                          "{user}: {slot} of its material has a texture from {path}, which isn't under res://, so nothing else would find it")
        End If
        Return path
    End Method

    // What a mesh at `user` is made of: a file's by the text it says; built in by the same, if it's
    // its own, and else, and for what's neither, a table: of what it's made of, or of its vertices.
    Method GeometryValue(geometry: Geometry, user: String): Value Throws IOError
        Local source = geometry.Source()
        Local handle = geometry.Live("Save")
        If source != Null
            If !source.StartsWith("builtin:") && !source.StartsWith("res://")
                Throw IOError(IOErrorKind.INVALID_DATA,
                              "{user}: its mesh is from {source}, which isn't under res://, so nothing else would find it")
            End If
            If !source.StartsWith("builtin:") || (Uses.Get(handle) ?? 0) <= 1 Then Return Value(source)
        End If
        Local had = GeometryIds.Get(handle)
        If had != Null Then Return Value("geometry:{had}")
        Local id = IdOf(geometry.SceneId(), handle, "{user}.geometry")
        geometry.SetSceneId(id)
        GeometryIds[handle] = id
        Local table = Value.Object()
        table["id"] = Value(id)
        If source != Null
            table["source"] = Value(source)
        Else
            Local box = geometry.CullBox()
            If box != Null
                table["cull_box"] = Try Numbers([box.Min.x, box.Min.y, box.Min.z, box.Max.x,
                                                 box.Max.y,
                                                 box.Max.z])
            End If
            Local surfaces = Value.Array()
            Local number = 0
            For surface In geometry.Surfaces()
                If surface.MorphTargetCount() > 0
                    Throw IOError(IOErrorKind.INVALID_DATA,
                                  "{user}: its mesh has morph targets and has changed since its file, which a scene can't hold yet")
                End If
                Local one = Value.Object()
                Local drawn = surface.Material()
                If drawn != Null
                    one["material"] = Value(Try MaterialId(drawn, user, "surface{number}"))
                End If
                Local vertices = Value.Array()
                For at = 0 To surface.VertexCount() - 1
                    Local v = surface.Vertex(at)
                    vertices.Add(Try Numbers([v.Position.x, v.Position.y, v.Position.z, v.Normal.x,
                                              v.Normal.y, v.Normal.z,
                                              v.Uv0.x, v.Uv0.y, v.Uv1.x, v.Uv1.y, v.Color.r,
                                              v.Color.g,
                                              v.Color.b,
                                              v.Color.a]))
                End For
                one["vertices"] = vertices
                Local triangles = Value.Array()
                For at = 0 To surface.TriangleCount() - 1
                    Local corners = surface.Triangle(at)
                    triangles.Add(Value(corners.x As Int32))
                    triangles.Add(Value(corners.y As Int32))
                    triangles.Add(Value(corners.z As Int32))
                End For
                one["triangles"] = triangles
                surfaces.Add(one)
                number += 1
            End For
            table["surfaces"] = surfaces
        End If
        Local all = Geometries ?? Value.Array()
        Geometries = all
        all.Add(table)
        Return Value("geometry:{id}")
    End Method

    // `entity` as a table under its path, and what's under it after it. Its id among `siblings` is its
    // name, or that with the first of #2 and on that none of them has.
    Method Entity(entity: Entity, parent: String, siblings: Set<String>) Throws IOError
        Local base = entity.Name() != "" ? entity.Name().Replace("/", "_") : "entity"
        Local id = base
        Local seen = 1
        While siblings.Contains(id)
            seen += 1
            id = "{base}#{seen}"
        End While
        siblings.Add(id)
        Local path = parent + (parent != "" ? "/" : "") + id
        Local strays = entity.Strays()
        If strays.Count > 0
            Throw IOError(IOErrorKind.INVALID_DATA,
                          "{path}: its file says {strays.Join(", ")}, which saving would lose")
        End If
        Local table = Value.Object()
        table["path"] = Value(path)
        Local kind = entity.Kind()
        If kind != EntityKind.PIVOT && kind != EntityKind.MESH && kind != EntityKind.LIGHT &&
           kind != EntityKind.CAMERA && kind != EntityKind.SPRITE
            Throw IOError(IOErrorKind.INVALID_DATA,
                          "{path} is a {kind}, which a scene can't hold yet")
        End If
        table["kind"] = Value("{kind}")
        If entity.Name() != "" Then table["name"] = Value(entity.Name())
        table["position"] = Try Three(entity.Position())
        Local turn = entity.Rotation()
        table["rotation"] = Try Numbers([turn.x, turn.y, turn.z, turn.w])
        table["scale"] = Try Three(entity.Scale())
        If entity.Hidden() Then table["hidden"] = Value(True)
        If entity.PickMode() != PickMode.NONE Then table["pick"] = Value("{entity.PickMode()}")
        If entity.BlocksSight() Then table["blocks_sight"] = Value(True)
        If entity.CollisionGroup() != 0 Then table["group"] = Value(entity.CollisionGroup() As Int32)
        If entity.CollisionShape() != CollisionShape.AUTO
            table["shape"] = Value("{entity.CollisionShape()}")
        End If
        Local radius = entity.CollisionRadius()
        If radius != Vec2(1, 1) Then table["radius"] = Try Numbers([radius.x, radius.y])
        Local box = entity.CollisionBox()
        If box != AABB(Vec3(-1, -1, -1), Vec3(1, 1, 1))
            table["box"] = Try Numbers([box.Min.x, box.Min.y, box.Min.z, box.Max.x, box.Max.y,
                                        box.Max.z])
        End If
        If entity.StepHeight() != 0.0 Then table["step_height"] = Try Number(entity.StepHeight())
        If entity.MaxSlope() != DEFAULT_SLOPE Then table["max_slope"] = Try Number(entity.MaxSlope())
        Local fade = entity.AutoFade()
        If fade != Vec2(0, 0) Then table["auto_fade"] = Try Numbers([fade.x, fade.y])
        If entity.Occluder() Then table["occluder"] = Value(True)
        If !entity.CastsShadows() Then table["casts_shadows"] = Value(False)
        Local mesh = entity As? Mesh
        If mesh != Null
            Local geometry = mesh.Geometry()
            If geometry != Null Then table["geometry"] = Try GeometryValue(geometry, path)
            Local drawn = mesh.Material()
            If drawn != Null Then table["material"] = Value(Try MaterialId(drawn, path, "material"))
            If mesh.Color() != Color(1, 1, 1, 1) Then table["color"] = Try Four(mesh.Color())
            Local weights = mesh.MorphWeights()
            If weights.Any(Function(each: Float) => each != 0.0) Then table["morph"] = Try Numbers(weights)
        End If
        Local light = entity As? Light
        If light != Null
            table["light"] = Value("{light.LightType()}")
            table["color"] = Try Four(light.Color())
            table["intensity"] = Try Number(light.Intensity())
            table["range"] = Try Number(light.Range())
            table["cone"] = Try Numbers([light.InnerCone(), light.OuterCone()])
            If light.Shadows() Then table["shadows"] = Value(True)
            If light.ShadowSize() != 1024 Then table["shadow_size"] = Value(light.ShadowSize())
            If light.ShadowBias() != DEFAULT_BIAS.x || light.ShadowNormalBias() != DEFAULT_BIAS.y
                table["shadow_bias"] = Try Numbers([light.ShadowBias(), light.ShadowNormalBias()])
            End If
            If light.Cascades() != 3 Then table["cascades"] = Value(light.Cascades())
            If light.ShadowDistance() != 100.0
                table["shadow_distance"] = Try Number(light.ShadowDistance())
            End If
        End If
        Local camera = entity As? Camera
        If camera != Null
            table["projection"] = Value("{camera.Projection()}")
            table["field_of_view"] = Try Number(camera.FieldOfView())
            table["height"] = Try Number(camera.OrthographicHeight())
            table["range"] = Try Numbers([camera.Near(), camera.Far()])
            table["clear"] = Value(camera.ClearsColor())
            table["clear_depth"] = Value(camera.ClearsDepth())
            table["clear_color"] = Try Four(camera.ClearColor())
            If camera.Order() != 0 Then table["order"] = Value(camera.Order() As Int32)
            table["fog"] = Value("{camera.FogMode()}")
            table["fog_color"] = Try Four(camera.FogColor())
            table["fog_range"] = Try Numbers([camera.FogStart(), camera.FogEnd()])
            table["fog_density"] = Try Number(camera.FogDensity())
            If camera.Hdr() Then table["hdr"] = Value(True)
            If camera.Exposure() != 1.0 Then table["exposure"] = Try Number(camera.Exposure())
            If camera.Tonemap() != Tonemap.NONE Then table["tonemap"] = Value("{camera.Tonemap()}")
            If camera.Gamma() != 1.0 Then table["gamma"] = Try Number(camera.Gamma())
            If camera.BloomIntensity() != 0.0 || camera.BloomThreshold() != 1.0
                table["bloom"] = Try Numbers([camera.BloomIntensity(), camera.BloomThreshold()])
            End If
            Local grade = camera.Grade()
            If grade.Slope != Vec3(1, 1, 1) || grade.Offset != Vec3(0, 0, 0) ||
               grade.Power != Vec3(1, 1, 1) || grade.Saturation != 1.0
                table["grade"] = Try Numbers([grade.Slope.x, grade.Slope.y, grade.Slope.z,
                                              grade.Offset.x, grade.Offset.y, grade.Offset.z,
                                              grade.Power.x, grade.Power.y, grade.Power.z,
                                              grade.Saturation])
            End If
            If !camera.Occlusion() Then table["occlusion"] = Value(False)
            If camera.AmbientOcclusion() != 0.0
                table["ambient_occlusion"] = Try Number(camera.AmbientOcclusion())
            End If
            If camera.AmbientOcclusionRadius() != 1.0
                table["ambient_occlusion_radius"] = Try Number(camera.AmbientOcclusionRadius())
            End If
            If camera.Fxaa() Then table["fxaa"] = Value(True)
            If camera.TemporalAA() Then table["temporal_aa"] = Value(True)
        End If
        Local sprite = entity As? Sprite
        If sprite != Null
            Local drawn = sprite.Material()
            If drawn != Null Then table["material"] = Value(Try MaterialId(drawn, path, "material"))
            table["color"] = Try Four(sprite.Color())
            table["view"] = Value("{sprite.ViewMode()}")
            table["size"] = Try Numbers([sprite.SpriteScale().x, sprite.SpriteScale().y])
            table["handle"] = Try Numbers([sprite.Handle().x, sprite.Handle().y])
            table["turn"] = Try Number(sprite.SpriteRotation())
        End If
        Local names = entity.ComponentNames()
        If names.Count > 0
            Local components = Value.Object()
            For name In names
                Local held = entity.Component(name) ?? Value()
                Local wrong = Unwritable(held, name)
                If wrong != Null Then Throw IOError(IOErrorKind.INVALID_DATA, "{path}: its {wrong}")
                components[name] = held
            End For
            table["components"] = components
        End If
        Entities.Add(table)
        Local under = Set<String>()
        For child In entity.Children()
            Try Self.Entity(child, path, under)
        End For
    End Method
End Class

// What's being read: what's in the file by its ids, and what's been made, to be freed if it can't be
// finished. Tolerant, what can't be loaded stands in as something that keeps its reference, and it's
// noted, so a file whose assets have gone can still be opened and saved.
Class Reading
    Field Materials: Map<String, Material>
    Field MaterialTables: Map<String, Value>
    Field Geometries: Map<String, Geometry>
    Field GeometryTables: Map<String, Value>
    Field Models: Map<String, Model>
    Field Made: Map<String, Entity>
    Field Roots: Entity[] = []
    Field Tolerant: Bool
    Field Problems: String[] = []
    // What's to be attached once all's made: which, where it's from, its kind, and what it has.
    Field Attaching: (Entity, String, String, Value)[] = []

    New(document: Value, tolerant: Bool) Throws IOError
        Tolerant = tolerant
        Materials = {}
        MaterialTables = {}
        Geometries = {}
        GeometryTables = {}
        Models = {}
        Made = {}
        Try Only(document, OF_DOCUMENT, "the file")
        For each In Try Items(document, "material", "the file")
            Local id = Try Required(each, "id", "a material")
            If MaterialTables.Get(id) != Null Then Throw Wrong("the material {id} is in it twice")
            Try Only(each, OF_MATERIAL, "the material {id}")
            MaterialTables[id] = each
        End For
        For each In Try Items(document, "geometry", "the file")
            Local id = Try Required(each, "id", "a geometry")
            If GeometryTables.Get(id) != Null Then Throw Wrong("the geometry {id} is in it twice")
            Try Only(each, OF_GEOMETRY, "the geometry {id}")
            GeometryTables[id] = each
        End For
    End New

    // Lets go of each model's hold: what it spawned and what's drawn with it keep what they draw.
    Method LetGo()
        For each In Models.Values()
            each.Free()
        End For
        Models.Clear()
    End Method

    // Each component on what it's for, as a game has them, and it's what can't be that's wrong.
    Method Attached() Throws IOError
        For each In Attaching
            Local entity, path, kind, values = each
            Local said = Components.Attach(entity, kind, values)
            If said != Null Then Throw Wrong("{path}: its {kind}: {said}")
        End For
    End Method

    // What it had made, for a file that couldn't be finished.
    Method Undone()
        For root In Roots
            If !root.Freed() Then root.Free()
        End For
        LetGo()
    End Method

    Method MaterialOf(id: String, at: String): Material Throws IOError
        Local had = Materials.Get(id)
        If had != Null Then Return had
        Local table = MaterialTables.Get(id)
        If table == Null Then Throw Wrong("{at}: there's no material {id}")
        Local made = Material()
        made.SetSceneId(id)
        Local where = "{at}: the material {id}"
        made.SetColor(Try ColorOf(table, "color", Color(1, 1, 1, 1), where, True))
        made.SetShading(Try Named<Shading>(table, "shading", Shading.PBR,
                                           [Shading.PBR, Shading.UNLIT, Shading.VERTEX], where))
        made.SetBlend(Try Named<Blend>(table, "blend", Blend.AUTO,
                                       [Blend.AUTO, Blend.OPAQUE, Blend.ALPHA, Blend.ADD,
                                        Blend.MULTIPLY], where))
        Local cutoff = Try FloatOf(table, "alpha_cutoff", 0.0, where)
        Try Must(cutoff >= 0.0 && cutoff <= 1.0, where, "alpha_cutoff", "is 0 to 1")
        made.SetAlphaCutoff(cutoff)
        Local shininess = Try FloatOf(table, "shininess", 0.0, where)
        Try Must(shininess >= 0.0 && shininess <= 1.0, where, "shininess", "is 0 to 1")
        made.SetShininess(shininess)
        made.SetVertexColors(Try BoolOf(table, "vertex_colors", False, where))
        made.SetWireframe(Try BoolOf(table, "wireframe", False, where))
        made.SetTwoSided(Try BoolOf(table, "two_sided", False, where))
        made.SetFogged(Try BoolOf(table, "fogged", True, where))
        made.SetOrder(Try IntOf(table, "order", 0, where))
        Local metallic = Try FloatOf(table, "metallic", made.Metallic(), where)
        Try Must(metallic >= 0.0 && metallic <= 1.0, where, "metallic", "is 0 to 1")
        Local roughness = Try FloatOf(table, "roughness", made.Roughness(), where)
        Try Must(roughness >= 0.0 && roughness <= 1.0, where, "roughness", "is 0 to 1")
        made.SetMetalRough(metallic, roughness)
        Local glow = Try FloatsOf(table, "emissive", 3, where)
        If glow != Null
            Try Must(glow[0] >= 0.0 && glow[1] >= 0.0 && glow[2] >= 0.0, where, "emissive",
                     "is 0 or more")
            made.SetEmissive(Color(glow[0], glow[1], glow[2]))
        End If
        made.SetNormalScale(Try FloatOf(table, "normal_scale", made.NormalScale(), where))
        Local strength = Try FloatOf(table, "occlusion_strength", made.OcclusionStrength(), where)
        Try Must(strength >= 0.0 && strength <= 1.0, where, "occlusion_strength", "is 0 to 1")
        made.SetOcclusionStrength(strength)
        For one In Try Items(table, "maps", where)
            Try Only(one, OF_MAP, where)
            Try Required(one, "map", where)
            Local map = Try Named<MaterialMap>(one, "map", MaterialMap.NORMAL, ALL_MAPS, where)
            Local uvSet = Try IntOf(one, "uv_set", 0, where)
            Try Must(uvSet == 0 || uvSet == 1, where, "uv_set", "is 0 or 1")
            Local path = Try TextOf(one, "texture", where)
            made.SetMap(map, path != Null ? Try MapTextureOf(map, path, where) : Null, uvSet)
            Local uv = Try FloatsOf(one, "uv", 5, where)
            If uv != Null
                Try Must(uv[0] != 0.0 && uv[1] != 0.0, where, "uv", "has a scale that isn't 0")
                made.SetMapUv(map, UvTurn(Vec2(uv[0], uv[1]), uv[2], Vec2(uv[3], uv[4])))
            End If
        End For
        For layer In Try Items(table, "layers", where)
            Try Only(layer, OF_LAYER, where)
            Local index = Try IntOf(layer, "layer", -1, where)
            If index < 0 || index > 7 Then Throw Wrong("{where}: a layer's 0 to 7, not {index}")
            Local path = Try TextOf(layer, "texture", where)
            If path != Null Then made.SetTexture(index, Try TextureOf(path, where))
            Local uvSet = Try IntOf(layer, "uv_set", 0, where)
            Try Must(uvSet == 0 || uvSet == 1, where, "uv_set", "is 0 or 1")
            made.SetLayer(index, Try Named<LayerBlend>(layer, "blend", LayerBlend.MULTIPLY,
                                                       [LayerBlend.MULTIPLY, LayerBlend.ADD,
                                                        LayerBlend.ALPHA,
                                                        LayerBlend.MULTIPLY_2, LayerBlend.BUMP],
                                                       where), uvSet)
            Local uv = Try FloatsOf(layer, "uv", 5, where)
            If uv != Null
                Try Must(uv[0] != 0.0 && uv[1] != 0.0, where, "uv", "has a scale that isn't 0")
                made.SetLayerUv(index, UvTurn(Vec2(uv[0], uv[1]), uv[2], Vec2(uv[3], uv[4])))
            End If
            Local bump = Try FloatsOf(layer, "bump", 6, where)
            If bump != Null
                made.SetLayerBump(index,
                                  BumpShift(bump[0], bump[1], bump[2], bump[3], bump[4], bump[5]))
            End If
        End For
        Materials[id] = made
        Return made
    End Method

    // The texture of the file at `path`, or if it can't be and that's allowed, one that says it's lost,
    // of `format`.
    Method TextureOf(path: String, at: String,
                     format: TextureFormat = TextureFormat.RGBA8): Texture Throws IOError
        Try
            Return Try Assets.Load<Texture>(path)
        Catch error As IOError
            Return Try LostTexture(path, at, error.Message, format)
        End Try
    End Method

    Method LostTexture(path: String, at: String, says: String,
                       format: TextureFormat): Texture Throws IOError
        If !Tolerant Then Throw Wrong("{at}: {says}")
        Problems.Add("{at}: {says}")
        Try
            Return Try Texture.Lost(path, format)
        Catch lost As GraphicsError
            Throw Wrong("{at}: {lost.Message}")
        End Try
    End Method

    // The texture of the file at `path` as `map`, for what SetMap would panic at otherwise: a color,
    // where what's wanted is numbers.
    Method MapTextureOf(map: MaterialMap, path: String, at: String): Texture Throws IOError
        Local format =
            map == MaterialMap.EMISSIVE ? TextureFormat.RGBA8 : TextureFormat.RGBA8_LINEAR
        Local read = Try TextureOf(path, at, format)
        If Material.MapTakes(map, read) Then Return read
        Return Try LostTexture(path, at,
                               "{path} is stored as a color, and a {map} map's numbers: its import settings can say it isn't sRGB",
                               format)
    End Method

    // What's built in is a mesh's own, and what's in a table or a file is shared.
    Method GeometryOf(source: String, at: String): Geometry Throws IOError
        If source.StartsWith("builtin:") Then Return Try Builtin(source, at)
        Local had = Geometries.Get(source)
        If had != Null Then Return had
        Local made = Try Making(source, at)
        Geometries[source] = made
        Return made
    End Method

    Method Making(source: String, at: String): Geometry Throws IOError
        If source.StartsWith("geometry:")
            Local id = source.Slice(9, source.Length)
            Local table = GeometryTables.Get(id)
            If table == Null Then Throw Wrong("{at}: there's no geometry {id}")
            Local from = Try TextOf(table, "source", "the geometry {id}")
            If from != Null
                Local whole = from.StartsWith("builtin:") ? Try Builtin(from, at) : Try Making(from,
                                                                                               at)
                whole.SetSceneId(id)
                Return whole
            End If
            Local made = Geometry()
            made.SetSceneId(id)
            Local where = "{at}: the geometry {id}"
            For one In Try Items(table, "surfaces", where)
                Try Only(one, OF_SURFACE, where)
                Local surface = made.AddSurface()
                Local material = Try TextOf(one, "material", where)
                If material != Null Then surface.SetMaterial(Try MaterialOf(material, at))
                Local vertices: Vertex[] = []
                For row In Try Items(one, "vertices", where)
                    Local f: Float32[] = []
                    Local numbers = row.AsArray()
                    If numbers == Null Then Throw Wrong("{where}: a vertex is 14 numbers")
                    For each In numbers
                        Local number = each.AsDouble()
                        If number == Null || !IsFinite(number As Float32)
                            Throw Wrong("{where}: a vertex is 14 finite numbers")
                        End If
                        f.Add(number As Float32)
                    End For
                    If f.Count != 14 Then Throw Wrong("{where}: a vertex is 14 numbers, not {f.Count}")
                    vertices.Add(Vertex(Vec3(f[0], f[1], f[2]), Vec3(f[3], f[4], f[5]),
                                        Vec2(f[6], f[7]),
                                        Vec2(f[8], f[9]), Color(f[10], f[11], f[12], f[13])))
                End For
                surface.AddVertices(vertices)
                Local corners = Try Items(one, "triangles", where)
                If corners.Count % 3 != 0 Then Throw Wrong("{where}: triangles are 3 indexes each")
                For i = 0 To corners.Count / 3 - 1
                    Local a = corners[i * 3].AsInt() ?? -1
                    Local b = corners[i * 3 + 1].AsInt() ?? -1
                    Local c = corners[i * 3 + 2].AsInt() ?? -1
                    Local most = vertices.Count
                    If a < 0 || b < 0 || c < 0 || a >= most || b >= most || c >= most
                        Throw Wrong("{where}: a triangle's index isn't one of its {most} vertices")
                    End If
                    surface.AddTriangle(a, b, c)
                End For
            End For
            Local box = Try FloatsOf(table, "cull_box", 6, where)
            If box != Null
                Try Must(box[0] <= box[3] && box[1] <= box[4] && box[2] <= box[5], where,
                         "cull_box",
                         "has its least corner first")
                made.SetCullBox(AABB(Vec3(box[0], box[1], box[2]), Vec3(box[3], box[4], box[5])))
            End If
            Return made
        End If
        // A model's, as res://door.glb#0, by its mesh's number, after the last #.
        Local marked = source.Split("#")
        If marked.Count < 2 Then Throw Wrong("{at}: {source} isn't what a mesh can be made of")
        Local index = Int.Parse(marked[marked.Count - 1])
        marked.RemoveAt(marked.Count - 1)
        Local path = marked.Join("#")
        If index == Null Then Throw Wrong("{at}: {source} says no mesh of its file")
        Local model = Models.Get(path)
        If model == Null
            Try
                model = Try Assets.Load<Model>(path)
            Catch error As IOError
                If !Tolerant Then Throw Wrong("{at}: {error.Message}")
                Return Lost(source, at, error.Message)
            End Try
            Models[path] = model
        End If
        Local parts = model.Geometries()
        If index < 0 || index >= parts.Count
            Local says = "{path} has {parts.Count} meshes, not one numbered {index}"
            If !Tolerant Then Throw Wrong("{at}: {says}")
            Return Lost(source, at, says)
        End If
        Return parts[index]
    End Method

    // What's drawn for a mesh of a file that's lost, keeping what it's from.
    Method Lost(source: String, at: String, says: String): Geometry
        Problems.Add("{at}: {says}")
        Return Sourced(Geometry.Cube(), source)
    End Method

    // What's at the top of the scene goes under this.
    Field Under: Entity? = Null

    // One made as `table` says, under what it's in.
    Method Entity(table: Value) Throws IOError
        Local path = Try Required(table, "path", "an entity")
        If Made.Get(path) != Null Then Throw Wrong("{path} is in it twice")
        Local names = path.Split("/")
        Local parent: Entity? = Null
        If names.Count > 1
            names.RemoveAt(names.Count - 1)
            parent = Made.Get(names.Join("/"))
            If parent == Null Then Throw Wrong("{path}: what it's under comes before it, and doesn't here")
        Else
            parent = Under
        End If
        Local kind = Try Required(table, "kind", path)
        Local own: String[] = []
        Local made: Entity
        Select kind
            Case "PIVOT"
                made = Pivot(parent)
            Case "MESH"
                own = OF_MESH
                Local source = Try TextOf(table, "geometry", path)
                made = source != Null ? Mesh(Try GeometryOf(source, path), parent) : Mesh(Null,
                                                                                          parent)
            Case "LIGHT"
                own = OF_LIGHT
                made = Light(Try Named<LightType>(table, "light", LightType.POINT,
                                                  [LightType.DIRECTIONAL, LightType.POINT,
                                                   LightType.SPOT], path), parent)
            Case "CAMERA"
                own = OF_CAMERA
                made = Camera(parent)
            Case "SPRITE"
                own = OF_SPRITE
                made = Sprite(Null, parent)
            Default
                Throw Wrong("{path} is a {kind}, which a scene can't hold")
        End Select
        Made[path] = made
        If parent == Under Then Roots.Add(made)
        Try Fill(made, table, path)
        // What this doesn't know is kept from being lost by a save, which refuses it.
        Local strays: String[] = []
        For key In table.Keys()
            If !EVERY_ENTITY.Contains(key) && !own.Contains(key) Then strays.Add(key)
        End For
        made.SetStrays(strays)
    End Method

    Method Fill(made: Entity, table: Value, path: String) Throws IOError
        Local name = Try TextOf(table, "name", path)
        If name != Null Then made.SetName(name)
        made.SetPosition(Try VecOf(table, "position", Vec3(0, 0, 0), path))
        Local turn = Try FloatsOf(table, "rotation", 4, path)
        If turn != Null Then made.SetRotation(Quat(turn[0], turn[1], turn[2], turn[3]))
        made.SetScale(Try VecOf(table, "scale", Vec3(1, 1, 1), path))
        If Try BoolOf(table, "hidden", False, path) Then made.Hide()
        made.SetPickMode(Try Named<PickMode>(table, "pick", PickMode.NONE,
                                             [PickMode.NONE, PickMode.ELLIPSOID, PickMode.BOX,
                                              PickMode.MESH], path))
        made.SetBlocksSight(Try BoolOf(table, "blocks_sight", False, path))
        Local group = Try IntOf(table, "group", 0, path)
        Try Must(group >= 0 && group <= 1023, path, "group", "is 0 to 1023")
        made.SetCollisionGroup(group)
        made.SetCollisionShape(Try Named<CollisionShape>(table, "shape", CollisionShape.AUTO,
                                                         [CollisionShape.AUTO,
                                                          CollisionShape.ELLIPSOID,
                                                          CollisionShape.BOX, CollisionShape.MESH],
                                                         path))
        Local radius = Try FloatsOf(table, "radius", 2, path)
        If radius != Null
            Try Must(radius[0] > 0.0 && radius[1] > 0.0, path, "radius", "is above 0")
            made.SetCollisionRadius(radius[0], radius[1])
        End If
        Local box = Try FloatsOf(table, "box", 6, path)
        If box != Null
            Try Must(box[0] <= box[3] && box[1] <= box[4] && box[2] <= box[5], path, "box",
                     "has its least corner first")
            made.SetCollisionBox(AABB(Vec3(box[0], box[1], box[2]), Vec3(box[3], box[4], box[5])))
        End If
        Local step = Try FloatOf(table, "step_height", 0.0, path)
        Try Must(step >= 0.0, path, "step_height", "is 0 or more")
        made.SetStepHeight(step)
        Local slope = Try FloatOf(table, "max_slope", DEFAULT_SLOPE, path)
        Try Must(slope >= 0.0 && slope <= 1.5707964, path, "max_slope", "is 0 to Pi / 2")
        made.SetMaxSlope(slope)
        Local fade = Try FloatsOf(table, "auto_fade", 2, path)
        If fade != Null
            Try Must((fade[0] == 0.0 && fade[1] == 0.0) || (fade[0] >= 0.0 && fade[0] < fade[1]),
                     path,
                     "auto_fade", "is 0 <= start < end, or 0 and 0")
            made.SetAutoFade(fade[0], fade[1])
        End If
        made.SetOccluder(Try BoolOf(table, "occluder", False, path))
        made.SetCastsShadows(Try BoolOf(table, "casts_shadows", True, path))
        Local components = table["components"]
        If components != Null
            Try Must(components.IsObject, path, "components", "is a table")
            For key In components.Keys()
                Local values = components[key] ?? Value()
                made.SetComponent(key, values)
                If !Tolerant Then Attaching.Add((made, path, key, values))
            End For
        End If
        Local mesh = made As? Mesh
        If mesh != Null
            Local material = Try TextOf(table, "material", path)
            If material != Null Then mesh.SetMaterial(Try MaterialOf(material, path))
            mesh.SetColor(Try ColorOf(table, "color", Color(1, 1, 1, 1), path, True))
            Local weights = Try FloatsOf(table, "morph", -1, path)
            If weights != Null Then mesh.SetMorphWeights(weights)
        End If
        Local light = made As? Light
        If light != Null
            light.SetColor(Try ColorOf(table, "color", Color(1, 1, 1, 1), path, False))
            Local intensity = Try FloatOf(table, "intensity", 1.0, path)
            Try Must(intensity >= 0.0, path, "intensity", "is 0 or more")
            light.SetIntensity(intensity)
            Local range = Try FloatOf(table, "range", 10.0, path)
            Try Must(range > 0.0, path, "range", "is above 0")
            light.SetRange(range)
            Local cone = Try FloatsOf(table, "cone", 2, path)
            If cone != Null
                Try Must(cone[0] >= 0.0 && cone[1] >= cone[0] && cone[1] <= 1.5707964, path, "cone",
                         "is 0 <= inner <= outer <= Pi / 2")
                light.SetCone(cone[0], cone[1])
            End If
            light.SetShadows(Try BoolOf(table, "shadows", False, path))
            Local tile = Try IntOf(table, "shadow_size", 1024, path)
            Try Must(tile >= 16 && tile <= 8192, path, "shadow_size", "is 16 to 8192")
            light.SetShadowSize(tile)
            Local bias = Try FloatsOf(table, "shadow_bias", 2, path)
            If bias != Null
                Try Must(bias[0] >= 0.0 && bias[1] >= 0.0, path, "shadow_bias", "is 0 or more")
                light.SetShadowBias(bias[0], bias[1])
            End If
            Local cascades = Try IntOf(table, "cascades", 3, path)
            Try Must(cascades >= 1 && cascades <= 4, path, "cascades", "is 1 to 4")
            light.SetCascades(cascades)
            Local reach = Try FloatOf(table, "shadow_distance", 100.0, path)
            Try Must(reach > 0.0, path, "shadow_distance", "is above 0")
            light.SetShadowDistance(reach)
        End If
        Local camera = made As? Camera
        If camera != Null
            camera.SetProjection(Try Named<Projection>(table, "projection", Projection.PERSPECTIVE,
                                                       [Projection.PERSPECTIVE,
                                                        Projection.ORTHOGRAPHIC], path))
            Local view = Try FloatOf(table, "field_of_view", camera.FieldOfView(), path)
            Try Must(view > 0.0 && view < 3.1415927, path, "field_of_view", "is between 0 and Pi")
            camera.SetFieldOfView(view)
            Local height = Try FloatOf(table, "height", camera.OrthographicHeight(), path)
            Try Must(height > 0.0 && IsFinite(2.0 / height), path, "height", "is above 0")
            camera.SetOrthographicHeight(height)
            Local range = Try FloatsOf(table, "range", 2, path)
            If range != Null
                Try Must(range[0] > 0.0 && range[0] < range[1], path, "range", "is 0 < near < far")
                camera.SetRange(range[0], range[1])
            End If
            camera.SetClear(Try BoolOf(table, "clear", True, path),
                            Try BoolOf(table, "clear_depth", True, path))
            camera.SetClearColor(Try ColorOf(table, "clear_color", camera.ClearColor(), path,
                                             False))
            camera.SetOrder(Try IntOf(table, "order", 0, path))
            camera.SetFogMode(Try Named<FogMode>(table, "fog", FogMode.NONE,
                                                 [FogMode.NONE, FogMode.LINEAR, FogMode.EXPONENTIAL,
                                                  FogMode.EXPONENTIAL_SQUARED], path))
            camera.SetFogColor(Try ColorOf(table, "fog_color", camera.FogColor(), path, False))
            Local fog = Try FloatsOf(table, "fog_range", 2, path)
            If fog != Null
                Try Must(fog[0] >= 0.0 && fog[1] > fog[0], path, "fog_range", "is 0 <= start < end")
                camera.SetFogRange(fog[0], fog[1])
            End If
            Local density = Try FloatOf(table, "fog_density", camera.FogDensity(), path)
            Try Must(density >= 0.0, path, "fog_density", "is 0 or more")
            camera.SetFogDensity(density)
            camera.SetHdr(Try BoolOf(table, "hdr", False, path))
            Local exposure = Try FloatOf(table, "exposure", 1.0, path)
            Try Must(exposure >= 0.0, path, "exposure", "is 0 or more")
            camera.SetExposure(exposure)
            camera.SetTonemap(Try Named<Tonemap>(table, "tonemap", Tonemap.NONE, ALL_TONEMAPS,
                                                 path))
            Local gamma = Try FloatOf(table, "gamma", 1.0, path)
            Try Must(gamma > 0.0 && IsFinite(1.0 / gamma), path, "gamma", "is above 0")
            camera.SetGamma(gamma)
            Local bloom = Try FloatsOf(table, "bloom", 2, path)
            If bloom != Null
                Try Must(bloom[0] >= 0.0 && bloom[1] >= 0.0, path, "bloom", "is 0 or more")
                camera.SetBloom(bloom[0], bloom[1])
            End If
            Local grade = Try FloatsOf(table, "grade", 10, path)
            If grade != Null
                Try Must(grade[0] >= 0.0 && grade[1] >= 0.0 && grade[2] >= 0.0, path, "grade",
                         "has a slope of 0 or more")
                Try Must(grade[6] > 0.0 && grade[7] > 0.0 && grade[8] > 0.0, path, "grade",
                         "has a power above 0")
                Try Must(grade[9] >= 0.0, path, "grade", "has a saturation of 0 or more")
                camera.SetGrade(ColorGrade(Vec3(grade[0], grade[1], grade[2]),
                                           Vec3(grade[3], grade[4], grade[5]),
                                           Vec3(grade[6], grade[7], grade[8]), grade[9]))
            End If
            camera.SetOcclusion(Try BoolOf(table, "occlusion", True, path))
            Local occlusion = Try FloatOf(table, "ambient_occlusion", 0.0, path)
            Try Must(occlusion >= 0.0, path, "ambient_occlusion", "is 0 or more")
            camera.SetAmbientOcclusion(occlusion)
            Local around = Try FloatOf(table, "ambient_occlusion_radius", 1.0, path)
            Try Must(around >= 0.0001, path, "ambient_occlusion_radius", "is 0.0001 or more")
            camera.SetAmbientOcclusionRadius(around)
            camera.SetFxaa(Try BoolOf(table, "fxaa", False, path))
            camera.SetTemporalAA(Try BoolOf(table, "temporal_aa", False, path))
        End If
        Local sprite = made As? Sprite
        If sprite != Null
            Local material = Try TextOf(table, "material", path)
            If material != Null Then sprite.SetMaterial(Try MaterialOf(material, path))
            sprite.SetColor(Try ColorOf(table, "color", Color(1, 1, 1, 1), path, True))
            sprite.SetViewMode(Try Named<SpriteViewMode>(table, "view", SpriteViewMode.BILLBOARD,
                                                         [SpriteViewMode.BILLBOARD,
                                                          SpriteViewMode.FIXED,
                                                          SpriteViewMode.UPRIGHT], path))
            Local size = Try FloatsOf(table, "size", 2, path)
            If size != Null
                Try Must(size[0] >= 0.0 && size[1] >= 0.0, path, "size", "is 0 or more")
                sprite.SetSpriteScale(Vec2(size[0], size[1]))
            End If
            Local handle = Try FloatsOf(table, "handle", 2, path)
            If handle != Null Then sprite.SetHandle(Vec2(handle[0], handle[1]))
            sprite.SetSpriteRotation(Try FloatOf(table, "turn", 0.0, path))
        End If
    End Method
End Class

// A sliding mover's MaxSlope at first.
Const DEFAULT_SLOPE: Float32 = 0.7853982
// A light's shadows' depth and normal biases at first.
Const DEFAULT_BIAS = Vec2(0.02, 1.5)
// As deep as a component's lists and tables can go in a file, which Toml.Write panics past 256 of.
Const MOST_NESTED = 200
Const ALL_MAPS = [MaterialMap.METAL_ROUGH, MaterialMap.NORMAL, MaterialMap.OCCLUSION,
                  MaterialMap.EMISSIVE]
Const ALL_TONEMAPS = [Tonemap.NONE, Tonemap.REINHARD, Tonemap.ACES, Tonemap.NEUTRAL]

// What's in `table`'s array `key`, none if it hasn't one.
Function Items(table: Value, key: String, at: String): Value[] Throws IOError
    Local item = table[key]
    If item == Null
        Local none: Value[] = []
        Return none
    End If
    Local read = item.AsArray()
    If read == Null Then Throw Wrong("{at}'s {key} isn't a list")
    Return read
End Function

Function Wrong(message: String): IOError => IOError(IOErrorKind.INVALID_DATA, "a scene: {message}")

Function Must(holds: Bool, at: String, key: String, says: String) Throws IOError
    If !holds Then Throw Wrong("{at}'s {key} {says}")
End Function

// That `table` says nothing but `keys`, for what a save would otherwise lose without a word.
Function Only(table: Value, keys: String[], at: String) Throws IOError
    If !table.IsObject Then Throw Wrong("{at} isn't a table")
    For key In table.Keys()
        If !keys.Contains(key) Then Throw Wrong("{at} says {key}, which a scene hasn't")
    End For
End Function

Function TextOf(table: Value, key: String, at: String): String? Throws IOError
    Local item = table[key]
    If item == Null Then Return Null
    Local read = item.AsString()
    If read == Null Then Throw Wrong("{at}'s {key} isn't text")
    Return read
End Function

Function Required(table: Value, key: String, at: String): String Throws IOError
    Local text = Try TextOf(table, key, at)
    If text == Null Then Throw Wrong("{at} has no {key}")
    Return text
End Function

Function FloatOf(table: Value, key: String, otherwise: Float32, at: String): Float32 Throws IOError
    Local item = table[key]
    If item == Null Then Return otherwise
    Local read = item.AsDouble()
    If read == Null || !IsFinite(read As Float32) Then Throw Wrong("{at}'s {key} isn't a finite number")
    Return read As Float32
End Function

Function IntOf(table: Value, key: String, otherwise: Int, at: String): Int Throws IOError
    Local item = table[key]
    If item == Null Then Return otherwise
    Local read = item.AsInt()
    If read == Null || read < -2147483648 || read > 2147483647
        Throw Wrong("{at}'s {key} isn't a whole number")
    End If
    Return read
End Function

Function BoolOf(table: Value, key: String, otherwise: Bool, at: String): Bool Throws IOError
    Local item = table[key]
    If item == Null Then Return otherwise
    Local read = item.AsBool()
    If read == Null Then Throw Wrong("{at}'s {key} isn't true or false")
    Return read
End Function

// `count` finite numbers, or as many as there are if that's below 0.
Function FloatsOf(table: Value, key: String, count: Int, at: String): Float32[]? Throws IOError
    Local item = table[key]
    If item == Null Then Return Null
    Local read = item.AsArray()
    If read == Null || (count >= 0 && read.Count != count)
        Throw Wrong("{at}'s {key} isn't {count} numbers")
    End If
    Local made: Float32[] = []
    For each In read
        Local number = each.AsDouble()
        If number == Null || !IsFinite(number As Float32)
            Throw Wrong("{at}'s {key} isn't finite numbers")
        End If
        made.Add(number As Float32)
    End For
    Return made
End Function

Function VecOf(table: Value, key: String, otherwise: Vec3, at: String): Vec3 Throws IOError
    Local read = Try FloatsOf(table, key, 3, at)
    Return read != Null ? Vec3(read[0], read[1], read[2]) : otherwise
End Function

// With `alpha`, its alpha's kept to 0 to 1, for what panics at else.
Function ColorOf(table: Value, key: String, otherwise: Color, at: String,
                 alpha: Bool): Color Throws IOError
    Local read = Try FloatsOf(table, key, 4, at)
    If read == Null Then Return otherwise
    If alpha Then Try Must(read[3] >= 0.0 && read[3] <= 1.0, at, key, "has an alpha of 0 to 1")
    Return Color(read[0], read[1], read[2], read[3])
End Function

// The one of `all` whose name's what `key` says.
Function Named<E: Printable>(table: Value, key: String, otherwise: E, all: E[],
                             at: String): E Throws IOError
    Local text = Try TextOf(table, key, at)
    If text == Null Then Return otherwise
    For each In all
        If "{each}" == text Then Return each
    End For
    Throw Wrong("{at}'s {key} can't be {text}")
End Function

// What's built in, by what Geometry's own factories call it.
Function Builtin(source: String, at: String): Geometry Throws IOError
    Local parts = source.Split(":")
    Local shape = parts[1]
    Local segments = 16
    If parts.Count > 2
        Local read = Int.Parse(parts[2])
        If read == Null Then Throw Wrong("{at}: {source} says no number of segments")
        segments = read
    End If
    Local capped = parts.Count <= 3 || parts[3] == "capped"
    If parts.Count > 4 || (parts.Count == 4 && parts[3] != "capped" && parts[3] != "open") ||
       (shape == "cube" && parts.Count > 2) ||
       ((shape == "sphere" || shape == "plane") && parts.Count > 3)
        Throw Wrong("{at}: {source} isn't built in")
    End If
    Local least = shape == "plane" ? 1 : 3
    If shape != "cube" && (segments < least || segments > 100)
        Throw Wrong("{at}: {source} has {least} to 100 segments")
    End If
    Select shape
        Case "cube"
            Return Geometry.Cube()
        Case "sphere"
            Return Geometry.Sphere(segments)
        Case "cylinder"
            Return Geometry.Cylinder(segments, capped)
        Case "cone"
            Return Geometry.Cone(segments, capped)
        Case "plane"
            Return Geometry.Plane(segments)
        Default
            Throw Wrong("{at}: {source} isn't built in")
    End Select
End Function

/// What Scene.Open made: what's at its top, and what it couldn't load, each naming its entity.
Public Final Class OpenedScene
    /// What's at its top, in order.
    Public ReadOnly Field Roots: Entity[]
    /// What couldn't be loaded, and stands in as something that keeps its reference.
    Public ReadOnly Field Problems: String[]

    Package New(roots: Entity[], problems: String[])
        Roots = roots
        Problems = problems
    End New
End Class

/// Scenes on disk: entities as a text file, which the editor writes and a game reads, one table to a
/// thing, each entity's named by its path of names under its tree, so a change to an entity is a change
/// to its own lines, and what's named after it, as a material whose first user it is, keeps its id. A
/// same-named sibling put before another takes its #n, and so changes those paths; and a Geometry's
/// vertices are a line to each array of them, so two edits of those don't merge.
///
/// A scene holds Pivots, Meshes, Lights, Cameras, and Sprites, with what each is set to, and each one's
/// components, which Load puts on it by Components.Attach; a Mesh by what it's made of: a file's mesh, as a model's that
/// hasn't changed since it loaded, by its res:// path and number; built in, as Geometry.Cube's is; or
/// else by its vertices, in the file. What's drawn in a Material by a table of it, its textures by the
/// res:// files they're from. A Skin and a game's own SetData aren't saved, so a model's skinned Mesh
/// loads in its bind pose. docs/scene-files.md has the format.
///
/// ```vb
/// Local roots = Try Scene.Load("res://levels/first.scene")
/// ```
Public Final Class Scene
    Private New()
    End New

    /// The scene the program's been asked to run on, as the editor's Play asks with `--scene` and a
    /// res:// path; Null if it hasn't. It looks in `arguments`, or the program's. It's an IOError of
    /// INVALID_DATA for a `--scene` with no res:// path after it.
    ///
    /// ```vb
    /// Local asked = Try Scene.Requested()
    /// Local roots = Try Scene.Load(asked ?? "res://levels/first.scene")
    /// ```
    Public Static Method Requested(arguments: String[]? = Null): String? Throws IOError
        Local given = arguments ?? Process.Arguments()
        Local at = given.IndexOf("--scene")
        If at == Null Then Return Null
        If at + 1 >= given.Count
            Throw IOError(IOErrorKind.INVALID_DATA, "--scene needs a res:// path after it")
        End If
        Local asked = given[at + 1]
        If !asked.StartsWith("res://")
            Throw IOError(IOErrorKind.INVALID_DATA, "--scene needs a res:// path, not {asked}")
        End If
        Return asked
    End Method

    /// `roots`, and all under each, as a scene's text. It's an IOError of INVALID_DATA for what can't
    /// be held: a kind of entity it hasn't, a texture or model from no res:// file, a number that isn't
    /// finite, what the file it came from said that it doesn't know, or in a component, what TOML has no
    /// way to write, as a list holding Null, or a whole number past an Int64, which it names.
    @MainThread Public Static Method Text(roots: Entity[]): String Throws IOError
        Local writing = Writing()
        For root In roots
            writing.Looked(root)
        End For
        Local siblings = Set<String>()
        For root In roots
            Try writing.Entity(root, "", siblings)
        End For
        Local materials = writing.Materials
        If materials != Null Then writing.Document["material"] = materials
        Local geometries = writing.Geometries
        If geometries != Null Then writing.Document["geometry"] = geometries
        writing.Document["entity"] = writing.Entities
        Return Toml.Write(writing.Document)
    End Method

    /// Writes `roots`, and all under each, to the file at `path`, whole or not at all: a file that was
    /// there is as it was if this throws, as it does as Text does, or for what the OS won't.
    @MainThread Public Static Method Save(path: Path, roots: Entity[]) Throws IOError
        Try File.WriteTextAtomic(path, Try Text(roots))
    End Method

    /// The scene in the file at `path`, a res:// path, made under `parent` or at the top of the current
    /// World, giving what's at its top in order, each entity's components attached, as Entity.Data
    /// gives them, so a game adds its kinds to Components first. It's an IOError for a file that can't
    /// be read, isn't a scene, names what can't be found, or has a component that can't be attached,
    /// which it names with its entity, all that it had made freed.
    @MainThread Public Static Method Load(path: String,
                                          parent: Entity? = Null): Entity[] Throws IOError
        Return Try FromText(Try Assets.ReadText(path), parent)
    End Method

    /// The scene `text` is, as Load makes it.
    @MainThread Public Static Method FromText(text: String,
                                              parent: Entity? = Null): Entity[] Throws IOError
        Return (Try Reading_(text, parent, False)).Roots
    End Method

    /// The scene in the file at `path`, as an editor wants it: as Load, but a texture or model that
    /// can't be loaded stands in as a plain one, keeping its reference for saving again, and is said
    /// in Problems, and components stay what Entity.Component gives, attached to nothing, as an editor
    /// has no game's kinds. What's wrong with the file itself is still an IOError.
    @MainThread Public Static Method Open(path: String,
                                          parent: Entity? = Null): OpenedScene Throws IOError
        Return Try Reading_(Try Assets.ReadText(path), parent, True)
    End Method

    Private Static Method Reading_(text: String, parent: Entity?,
                                   tolerant: Bool): OpenedScene Throws IOError
        Local document: Value? = Null
        Try
            document = Try Toml.Read(text)
        Catch error As ParseError
            Throw Wrong(error.Message)
        End Try
        If document == Null Then Throw Wrong("it's empty")
        Local format = document["format"]?.AsInt()
        If format != FORMAT Then Throw Wrong("it's of format {format ?? 0}, not {FORMAT}")
        Local reading = Try Reading(document, tolerant)
        reading.Under = parent
        Try
            For table In Try Items(document, "entity", "the file")
                Try reading.Entity(table)
            End For
            Try reading.Attached()
        Catch error As IOError
            reading.Undone()
            Throw error
        End Try
        reading.LetGo()
        Return OpenedScene(reading.Roots, reading.Problems)
    End Method
End Class
