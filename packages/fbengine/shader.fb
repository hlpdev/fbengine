// Materials' own shaders: Slang a game writes, compiled by its build step, drawn in the scene's
// pipelines. fbengine_tools has what compiles one, and how to write one.

Import std.core
Import std.ffi
Import std.io
Import std.math
Import "./assets"
Import "./c/fbe_scene"
Import "./c/fbe_shader"
Import "./camera"
Import "./loads"
Import "./material"
Import "./window"

// One wrapper for each shader the game holds, by its handle's slot; it goes when the game lets go
// of it, and a Material's Shader gets a new one.
Global shaders: Weak<Shader>[] = []

/// A shader of a game's own, for Materials to draw with: a `.slang` file in its assets, which its
/// build step compiles (fbengine_tools' CookShader), so `Assets.Load<Shader>("res://water.slang")`
/// loads what that made, and a change to the file reaches the game at its next build. A file that
/// went round the build step, or that was compiled for another version of fbengine or against other
/// sources of its shaders, throws an IOError of INVALID_DATA, saying so. It lives while the game holds
/// it, or a Material draws with it; a game that wants it reloaded holds it, as Assets reloads only
/// what's held. The same file loaded again is the same code, so a game can load and let go of one as
/// often as it likes. A shader's code the GPU runs: what's in a pak is as trusted as the game, so a
/// game that mounts paks from elsewhere trusts them with that. One no pipeline can be made of, which
/// only a driver knows, says so once, on the error stream, and draws as a Material with none does.
Public Final Class Shader Implements Asset
    Field handle: UInt64

    // A wrapper for a handle C made, which holds it once.
    New(handle: UInt64)
        Self.handle = handle
        Keep(Self)
    End New

    /// Assets' kind of load for one: its file's bytes as they are.
    @MainThread
    Public Static Method LoadKind(): AssetKind => AssetKind.BYTES

    /// Whether a cooked file's `bytes` would load, throwing as FromLoad does with what's wrong, `name`
    /// saying which it is. Nothing's kept: it's what the cooker asks of what it's made.
    @MainThread
    Public Static Method Check(bytes: UInt8[], name: String) Throws IOError
        Local copied = Buffer<UInt8>(bytes.Count)
        For at = 0 Until bytes.Count
            copied[at] = bytes[at]
        End For
        Local fine = False
        Unsafe
            fine = fbe_shader_check(copied.Pointer(), bytes.Count)
        End Unsafe
        If !fine Then Throw IOError(IOErrorKind.INVALID_DATA, "{name}: {LastError()}", name)
    End Method

    /// One of what `load` read.
    @MainThread
    Public Static Method FromLoad(load: AssetLoad): Shader Throws IOError
        Local made: UInt64 = 0
        Unsafe
            made = fbe_shader_create(load.BytesPointer(), load.Size(), load.Path())
        End Unsafe
        If made == 0 Then Throw IOError(IOErrorKind.INVALID_DATA, LastError(), load.Path())
        Return Shader(made)
    End Method

    /// The file it's from, as Assets loaded it, or Null for one that wasn't, as a scene names it by.
    @MainThread @PanicsAtCaller
    Public Method Path(): String?
        Local found = ""
        Unsafe
            found = fbe_shader_path(Live("Path")).ToString()
        End Unsafe
        Return found != "" ? found : Null
    End Method

    /// Takes the file `load` read in its place, for what draws with it from the next frame on, and
    /// gives True. One that isn't a shader throws as FromLoad does, which leaves it as it was.
    @MainThread
    Public Method Reload(load: AssetLoad): Bool Throws IOError
        Local done = False
        Unsafe
            done = fbe_shader_replace(Live("Reload"), load.BytesPointer(), load.Size(), load.Path())
        End Unsafe
        If !done Then Throw IOError(IOErrorKind.INVALID_DATA, LastError(), load.Path())
        Return True
    End Method

    Method Destroy()
        If handle != 0 Then fbe_shader_release(handle)
    End Method

    /// Lets go of the Shader now; Materials drawing with it keep it. Using it after panics. One
    /// Assets gave is let go of once, and goes with the last of its loads' holds.
    @MainThread @PanicsAtCaller
    Public Method Free()
        Local shader = Live("Free")
        If !Assets.Release(Self) Then Return
        fbe_shader_release(shader)
        Local gone: Shader? = Null
        shaders[Slot(handle)] = gone
        handle = 0
    End Method

    /// Whether it's a full-screen pass's, whose file says `#define FBE_PASS`, for Camera.AddPass; a
    /// Material with one draws as one with none does.
    @MainThread Public Method IsPass(): Bool => fbe_shader_is_pass(Live("IsPass"))

    /// Whether Free let go of it.
    @MainThread Public Method Freed(): Bool => handle == 0

    @PanicsAtCaller
    Package Method Live(call: String): UInt64
        If handle == 0 Then Panic("{call} on a Shader that was freed")
        Return handle
    End Method

    Static Method Slot(handle: UInt64): Int => (handle & 0xFFFFFFFF) As Int

    Static Method Keep(shader: Shader)
        Local slot = Slot(shader.handle)
        While shaders.Count <= slot
            shaders.Add(Null)
        End While
        shaders[slot] = shader
    End Method
End Class

// The one wrapper of a handle a Material gave, 0 for none, which this holds if it's a new one.
Function ShaderOf(handle: UInt64): Shader?
    If handle == 0 Then Return Null
    Local slot = (handle & 0xFFFFFFFF) As Int
    If slot < shaders.Count
        Local kept = shaders[slot]
        If kept != Null && kept.handle == handle Then Return kept
    End If
    fbe_shader_retain(handle)
    Return Shader(handle)
End Function

Extend Material
    /// Has it draw with `shader`, which it holds, or as the scene's own does with Null. What it
    /// draws is still its colors, layers, shading, blend, cutoff, and fog; the shader takes what
    /// those make of each pixel, before its cutoff, fog, and blend. BLEND AUTO goes by its color and
    /// textures, not what the shader returns, so a shader whose alpha is to blend wants BLEND ALPHA.
    @MainThread @PanicsAtCaller
    Public Method SetShader(shader: Shader?)
        Local drawn: UInt64 = shader != Null ? shader.Live("SetShader") : 0
        If !fbe_material_set_shader(Live("SetShader"), drawn) Then Failed("SetShader")
    End Method

    /// The shader it draws with, Null for the scene's own.
    @MainThread @PanicsAtCaller
    Public Method Shader(): Shader? => ShaderOf(fbe_material_shader(Live("Shader")))

    /// Sets a parameter for its shader to read, `surface.parameter(index)` there, from 0 to 7, each
    /// four numbers, all 0 until they're set. An index outside that, or what isn't numbers, panics.
    @MainThread @PanicsAtCaller
    Public Method SetParameter(index: Int, value: Vec4)
        If !fbe_material_set_parameter(Live("SetParameter"), index, value.x, value.y, value.z,
                                       value.w)
            Failed("SetParameter")
        End If
    End Method

    /// A parameter. An index outside 0 to 7 panics.
    @MainThread @PanicsAtCaller
    Public Method Parameter(index: Int): Vec4
        Local floats = Buffer<Float32>(4)
        Local done = False
        Unsafe
            done = fbe_material_parameter(Live("Parameter"), index, floats.Pointer())
        End Unsafe
        If !done Then Failed("Parameter")
        Return Vec4(floats[0], floats[1], floats[2], floats[3])
    End Method
End Extend

/// A Camera's full-screen passes.
Extend Camera
    /// Runs a full-screen pass after what it draws: after its tonemap and its grade, if it's HDR, and
    /// after those before it, on its own target. `shader` is one whose file says `#define FBE_PASS`,
    /// and it gives back the Material it holds it by, whose SetParameter and layers' SetTexture are
    /// what that reads: `parameter(index)` and `layer(index, uv)` there. In stored values, the color
    /// it reads and writes is what's stored, not light. One no pipeline can be made of says so once,
    /// on the error stream, and is left out. Any other shader panics.
    @MainThread @PanicsAtCaller
    Public Method AddPass(shader: Shader): Material
        Local pass = Material()
        pass.SetShader(shader)
        If !fbe_camera_add_pass(Live("AddPass"), pass.Live("AddPass")) Then Failed("AddPass")
        Return pass
    End Method

    /// Stops running a pass AddPass gave. One that isn't this camera's panics.
    @MainThread @PanicsAtCaller
    Public Method RemovePass(pass: Material)
        If !fbe_camera_remove_pass(Live("RemovePass"), pass.Live("RemovePass"))
            Failed("RemovePass")
        End If
    End Method

    /// Its passes, in the order they run.
    @MainThread @PanicsAtCaller
    Public Method Passes(): Material[]
        Local camera = Live("Passes")
        Local all: Material[] = []
        For at = 0 Until fbe_camera_pass_count(camera)
            Local pass = MaterialOf(fbe_camera_pass(camera, at))
            If pass != Null Then all.Add(pass)
        End For
        Return all
    End Method
End Extend
