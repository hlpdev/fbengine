// fbengine, over its C API: the bindings in c/, one for each area's header in native/fbengine/,
// which tools/bindgen.sh makes and `Import fbengine` leaves out (they're fbengine.c.fbe_<area>).

Import std.core
Import std.ffi
Import "./c/fbe_core"

/// The version of fbengine the program runs with, like "0.1.0", its DLL's.
Public Function Version(): String
    Unsafe
        Return fbe_version().ToString()
    End Unsafe
End Function
