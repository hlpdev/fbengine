// The app's own calls to the OS: its message box, for errors a player should see, opening a link
// or a file as the OS does, the clipboard, and the player's languages. Headless, neither the
// message box nor a link opens anything, so a test never waits on one.

Import std.collections
Import std.core
Import std.ffi
Import std.text
Import "./c/fbe_app"

/// What a message box says it is, which its icon shows.
Public Enum MessageKind
    ERROR
    WARNING
    INFORMATION
End Enum

/// Shows the OS's message box with `title` and `text`, over the window if it's open, and waits
/// for the player to close it, as a game does with an error it can't go on from, like a missing
/// file or a GPU it can't use. Headless (Window.SetHeadless, or SDL's video driver set to
/// offscreen or dummy, as tests run), or when the OS can't show one, it writes "title: text" to
/// stderr instead, and goes on at once.
@MainThread Public Function ShowMessage(title: String, text: String,
                                        kind: MessageKind = MessageKind.ERROR)
    fbe_app_show_message(title, text, kind As Int32)
End Function

/// Opens `url` as the OS does: a link like "https://example.com" in the player's browser, and a
/// file or a folder, by its path, in the app the OS opens it with; a path that isn't absolute is
/// from the current folder (on Windows, the OS's own full path, as "C:x.txt" is from C:'s own
/// folder). It's the best the OS can do, False when it can't, which a game goes on without.
/// Headless, it opens nothing and keeps the link, a path as its file:// link, which OpenedURLs
/// gives: on Windows the shell's own form, which leaves letters past ASCII as they are and puts a
/// UNC path's server after "file://", and elsewhere RFC 8089's, its UTF-8 in %XX.
@MainThread Public Function OpenURL(url: String): Bool => fbe_app_open_url(url)

/// The links OpenURL kept headless, the first first, for a game's tests to check.
@MainThread Public Function OpenedURLs(): String[]
    Local links: String[] = []
    For index = 0 To fbe_app_opened_count() - 1
        Unsafe
            links.Add(fbe_app_opened_at(index).ToString())
        End Unsafe
    End For
    Return links
End Function

/// Puts `text` on the OS's clipboard, as a text field's copy does; headless, SDL keeps it itself.
/// It's the best the OS can do: False when it can't. It starts the video, as Displays does.
@MainThread Public Function SetClipboard(text: String): Bool => fbe_app_set_clipboard(text)

/// The text on the OS's clipboard, "" for none, as a text field's paste reads it.
@MainThread Public Function Clipboard(): String
    Unsafe
        Return fbe_app_clipboard().ToString()
    End Unsafe
End Function

/// The player's languages, as the OS prefers them, the first most: BCP 47's tags, as "en-US",
/// "fr", or "zh-Hans", which a game picks the language of its text and voices by, as
/// BestLanguage does. They're read again each call, as a player can change them while it runs.
@MainThread Public Function Languages(): String[]
    Local tags: String[] = []
    For index = 0 To fbe_app_language_count() - 1
        Unsafe
            tags.Add(fbe_app_language_at(index).ToString())
        End Unsafe
    End For
    Return tags
End Function

/// Of the languages a game has, `available`, the one the player prefers most, by `preferred`, or
/// Languages() for Null, Null when none is. For each preferred tag in turn: the one that's it,
/// then it with its last parts off, as "fr" for "fr-CA", then any of its language, as "fr-FR" for
/// "fr-CA", each in any case, and in its script: a tag's own, or the one its language is written
/// in where it's from (Chinese's traditional in Taiwan, Hong Kong, and Macau, and simplified
/// elsewhere; Serbian's Cyrillic, but Latin in Montenegro; Uzbek's Latin). Only when none of the
/// player's languages is there in its script is one in another script given, as "zh-Hant" to a
/// "zh-CN" player.
@MainThread Public Function BestLanguage(available: String[], preferred: String[]? = Null): String?
    Local wanted = preferred ?? Languages()
    For sameScript In [True, False]
        For tag In wanted
            Local found = Matching(available, tag, sameScript)
            If found != Null Then Return found
        End For
    End For
    Return Null
End Function

// The one of `available` for `tag`, in its script when `sameScript`: it, it shorter, or another of
// its language.
Function Matching(available: String[], tag: String, sameScript: Bool): String?
    Local parts = tag.Split("-")
    Local script = ScriptOf(tag)
    Local fits = Function(each: String) => !sameScript || ScriptOf(each) == script
    For count = parts.Count To 1 Step -1
        Local shorter = parts[0..count].Join("-")
        For each In available
            If each.EqualsIgnoreCase(shorter) && fits(each) Then Return each
        End For
    End For
    For each In available
        If each.Split("-")[0].EqualsIgnoreCase(parts[0]) && fits(each) Then Return each
    End For
    Return Null
End Function

// The script `tag` is written in, in title case: its own, or its language's there, or "" for a
// language written in one.
Function ScriptOf(tag: String): String
    Local parts = tag.Split("-")
    Local region = ""
    For i = 1 To parts.Count - 1
        Local part = parts[i]
        // A script's four letters, not a variant's digits, as "1996"'s.
        If part.Length == 4 && part.Chars.All(Function(each: Char) => each.IsLetter())
            Return part.Slice(0, 1).ToUpper() + part.Slice(1, 4).ToLower()
        End If
        If part.Length == 2 || part.Length == 3 Then region = part.ToUpper()
    End For
    Select parts[0].ToLower()
        Case "zh"
            Return region == "TW" || region == "HK" || region == "MO" ? "Hant" : "Hans"
        Case "sr"
            Return region == "ME" ? "Latn" : "Cyrl"
        Case "uz"
            Return "Latn"
        Default
            Return ""
    End Select
End Function
