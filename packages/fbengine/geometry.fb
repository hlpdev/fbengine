// Geometry: surfaces of vertices and triangles, built in code or as primitive shapes, which Meshes
// draw and share. A Geometry lives while the game holds it or a Mesh draws it.

Import std.core
Import std.ffi
Import std.math
Import "./c/fbe_scene"
Import "./transform"
Import "./window"
Import "./world"

/// A vertex of a surface: where it is, its normal, two sets of UVs, from the top left of a
/// texture, as the second set a lightmap's are, and its color and alpha, linear, which multiply
/// what's drawn when its material's VertexColors is on. A vertex made from fewer has a zero normal
/// and UVs, and is white.
Public Struct Vertex Implements Printable
    /// Where it is.
    Public Field Position: Vec3
    /// Which way its surface faces there, for lighting.
    Public Field Normal: Vec3
    /// Its first set of UVs.
    Public Field Uv0: Vec2
    /// Its second set of UVs.
    Public Field Uv1: Vec2
    /// Its color and alpha.
    Public Field Color: Color

    Public New(position: Vec3)
        Position = position
        Color = White()
    End New

    Public New(position: Vec3, normal: Vec3)
        Position = position
        Normal = normal
        Color = White()
    End New

    Public New(position: Vec3, normal: Vec3, uv0: Vec2)
        Position = position
        Normal = normal
        Uv0 = uv0
        Color = White()
    End New

    Public New(position: Vec3, normal: Vec3, uv0: Vec2, uv1: Vec2)
        Position = position
        Normal = normal
        Uv0 = uv0
        Uv1 = uv1
        Color = White()
    End New

    Public New(position: Vec3, normal: Vec3, uv0: Vec2, uv1: Vec2, color: Color)
        Position = position
        Normal = normal
        Uv0 = uv0
        Uv1 = uv1
        Color = color
    End New

    Public Method ToString(): String => "Vertex({Position}, {Normal}, {Uv0}, {Uv1}, {Color})"
End Struct

// One wrapper for each geometry the game holds, by its handle's slot; it goes when the game lets
// go of it, and a Mesh's geometry gets a new one.
Global geometries: Weak<Geometry>[] = []

/// Surfaces of vertices and triangles, counterclockwise seen from the front, which Meshes draw:
/// every Mesh drawing one shares it, so changing it changes them all, and Clone makes one of its
/// own. It lives while the game holds it, or a Mesh draws it; Free lets go of it at once.
Public Final Class Geometry
    Field handle: UInt64

    /// A new Geometry, with no surfaces.
    @MainThread
    Public New()
        handle = fbe_geometry_create()
        Keep(Self)
    End New

    // A wrapper for a handle C holds once for it.
    Package New(handle: UInt64)
        If handle == 0 Then Panic(LastError())
        Self.handle = handle
        Keep(Self)
    End New

    Method Destroy()
        If handle != 0 Then fbe_geometry_release(handle)
    End Method

    /// A cube from -1 to 1 on each axis, flat-shaded, each face's UVs from 0 to 1.
    @MainThread Public Static Method Cube(): Geometry => Made(fbe_geometry_cube(), "Cube")

    /// A sphere of radius 1, of `segments` rings from pole to pole and twice as many around, from 3
    /// to 100.
    @MainThread @PanicsAtCaller
    Public Static Method Sphere(segments: Int = 16): Geometry
        Return Made(fbe_geometry_sphere(segments), "Sphere")
    End Method

    /// A cylinder of radius 1 from y -1 to 1, of `segments` around, from 3 to 100, with its ends
    /// closed when `capped`.
    @MainThread @PanicsAtCaller
    Public Static Method Cylinder(segments: Int = 16, capped: Bool = True): Geometry
        Return Made(fbe_geometry_cylinder(segments, capped), "Cylinder")
    End Method

    /// A cone of radius 1 at y -1, to its point at y 1, of `segments` around, from 3 to 100, with
    /// its base closed when `capped`.
    @MainThread @PanicsAtCaller
    Public Static Method Cone(segments: Int = 16, capped: Bool = True): Geometry
        Return Made(fbe_geometry_cone(segments, capped), "Cone")
    End Method

    /// A square from -1 to 1 in X and Z, facing up, of `segments` squares along each side, from 1
    /// to 100.
    @MainThread @PanicsAtCaller
    Public Static Method Plane(segments: Int = 1): Geometry
        Return Made(fbe_geometry_plane(segments), "Plane")
    End Method

    /// Lets go of the geometry now; Meshes drawing it keep it. Using it after panics.
    @MainThread @PanicsAtCaller
    Public Method Free()
        If !fbe_geometry_release(Live("Free")) Then Failed("Free")
        Local gone: Geometry? = Null
        geometries[Slot(handle)] = gone
        handle = 0
    End Method

    /// Whether Free let go of it.
    @MainThread Public Method Freed(): Bool => handle == 0

    /// A Geometry of its own with copies of these surfaces, which draw in the same materials.
    @MainThread @PanicsAtCaller
    Public Method Clone(): Geometry => Made(fbe_geometry_clone(Live("Clone")), "Clone")

    /// How many surfaces it has.
    @MainThread @PanicsAtCaller
    Public Method SurfaceCount(): Int => fbe_geometry_surface_count(Live("SurfaceCount"))

    /// The surface at `index`, from 0. One outside 0 to SurfaceCount() - 1 panics.
    @MainThread @PanicsAtCaller
    Public Method Surface(index: Int): Surface
        Local count = SurfaceCount()
        If index < 0 || index >= count
            Panic(
                "Surface({index}) on a Geometry with {count} {count == 1 ? "surface" : "surfaces"}")
        End If
        Return SurfaceOf(Self, index)
    End Method

    /// Its surfaces, in order.
    @MainThread @PanicsAtCaller
    Public Method Surfaces(): Surface[]
        Local found: Surface[] = []
        For index = 0 Until SurfaceCount()
            found.Add(SurfaceOf(Self, index))
        End For
        Return found
    End Method

    /// Adds an empty surface at the end.
    @MainThread @PanicsAtCaller
    Public Method AddSurface(): Surface
        Local index = fbe_geometry_add_surface(Live("AddSurface"))
        If index < 0 Then Failed("AddSurface")
        Return SurfaceOf(Self, index)
    End Method

    /// Adds copies of another Geometry's surfaces at the end, as they are, drawing in the same
    /// materials; it can be this one.
    @MainThread @PanicsAtCaller
    Public Method Add(other: Geometry)
        Add(other, Mat4.Identity)
    End Method

    /// Adds copies of another Geometry's surfaces at the end, transformed by `transform`, drawing
    /// in the same materials, as building a room of pieces does; it can be this one.
    @MainThread @PanicsAtCaller
    Public Method Add(other: Geometry, transform: Mat4)
        Local geometry = Live("Add")
        Local from = other.Live("Add")
        Local m = MatrixOf(transform)
        Local done = False
        Unsafe
            done = fbe_geometry_add(geometry, from, AddressOf(m))
        End Unsafe
        If !done Then Failed("Add")
    End Method

    /// Transforms every vertex, and its normal with it, staying length 1; a transform that
    /// mirrors turns the triangles too, so they still face out.
    @MainThread @PanicsAtCaller
    Public Method Transform(transform: Mat4)
        Local geometry = Live("Transform")
        Local m = MatrixOf(transform)
        Local done = False
        Unsafe
            done = fbe_geometry_transform(geometry, AddressOf(m))
        End Unsafe
        If !done Then Failed("Transform")
    End Method

    /// Moves every vertex.
    @MainThread @PanicsAtCaller
    Public Method Translate(offset: Vec3)
        Transform(Mat4.Translation(offset))
    End Method

    /// Turns every vertex about the origin.
    @MainThread @PanicsAtCaller
    Public Method Rotate(rotation: Quat)
        Transform(Mat4.Rotation(rotation))
    End Method

    /// Scales every vertex from the origin, on each axis.
    @MainThread @PanicsAtCaller
    Public Method Scale(scale: Vec3)
        Transform(Mat4.Scale(scale))
    End Method

    /// Turns it inside out: every normal reversed, and every triangle's winding.
    @MainThread @PanicsAtCaller
    Public Method Flip()
        If !fbe_geometry_flip(Live("Flip")) Then Failed("Flip")
    End Method

    /// Gives every vertex the normal of the triangles around it, smoothed across a surface's
    /// vertices at one place, each triangle counting by its angle there; vertices of other
    /// surfaces, as across a hard edge, stay apart. Triangles too thin to face anywhere are left
    /// out; where a place's triangles cancel, as a sheet's two sides do, a vertex takes its own
    /// triangles' normal, and one in no triangle keeps the normal it had.
    @MainThread @PanicsAtCaller
    Public Method UpdateNormals()
        If !fbe_geometry_update_normals(Live("UpdateNormals")) Then Failed("UpdateNormals")
    End Method

    /// The box around its vertices, in its own space; nothing at the origin for none.
    @MainThread @PanicsAtCaller
    Public Method Bounds(): AABB
        Local geometry = Live("Bounds")
        Local found = fbe_aabb_t(fbe_vec3_t(0, 0, 0), fbe_vec3_t(0, 0, 0))
        Local done = False
        Unsafe
            done = fbe_geometry_bounds(geometry, AddressOf(found))
        End Unsafe
        If !done Then Failed("Bounds")
        Return AABB(VecOf(found.min), VecOf(found.max))
    End Method

    /// Sets the box, in its own space, its meshes are culled by when drawn instead of its bounds,
    /// as a skinned mesh's, whose vertices move out of them, wants, or its bounds again for Null.
    /// InView and Bounds keep its bounds; copies keep it. A backward box panics.
    @MainThread @PanicsAtCaller
    Public Method SetCullBox(box: AABB?)
        Local geometry = Live("SetCullBox")
        If box == Null
            fbe_geometry_clear_cull_box(geometry)
            Return
        End If
        Local given = fbe_aabb_t(fbe_vec3_t(box.Min.x, box.Min.y, box.Min.z),
                                 fbe_vec3_t(box.Max.x, box.Max.y, box.Max.z))
        Local done = False
        Unsafe
            done = fbe_geometry_set_cull_box(geometry, AddressOf(given))
        End Unsafe
        If !done Then Failed("SetCullBox")
    End Method

    /// The box its meshes are culled by when drawn, or Null for its bounds.
    @MainThread @PanicsAtCaller
    Public Method CullBox(): AABB?
        Local geometry = Live("CullBox")
        Local found = fbe_aabb_t(fbe_vec3_t(0, 0, 0), fbe_vec3_t(0, 0, 0))
        Local done = False
        Unsafe
            done = fbe_geometry_cull_box(geometry, AddressOf(found))
        End Unsafe
        If !done Then Return Null
        Return AABB(VecOf(found.min), VecOf(found.max))
    End Method

    /// Scales and moves it to fill `box`, centered in it, or with `uniform`, keeping its shape at
    /// the largest that fits; a flat axis is moved, not scaled.
    @MainThread @PanicsAtCaller
    Public Method Fit(box: AABB, uniform: Bool = False)
        Local geometry = Live("Fit")
        Local within = fbe_aabb_t(fbe_vec3_t(box.Min.x, box.Min.y, box.Min.z),
                                  fbe_vec3_t(box.Max.x, box.Max.y, box.Max.z))
        Local done = False
        Unsafe
            done = fbe_geometry_fit(geometry, AddressOf(within), uniform)
        End Unsafe
        If !done Then Failed("Fit")
    End Method

    /// Every place a vertex is, welded: once each, bit for bit, in the order surfaces first use
    /// them, as physics' mesh shapes take them, so their triangles meet across UV and normal seams
    /// and what Add joined.
    @MainThread @PanicsAtCaller
    Public Method Positions(): Vec3[]
        Local geometry = Live("Positions")
        Local count = fbe_geometry_positions(geometry, Null, 0)
        Local found = Buffer<fbe_vec3_t>(count)
        Unsafe
            fbe_geometry_positions(geometry, found.Pointer(), count)
        End Unsafe
        Local positions: Vec3[] = []
        For position In found
            positions.Add(VecOf(position))
        End For
        Return positions
    End Method

    /// Every triangle's three indices into what Positions gives, surface after surface, in their
    /// order, so a triangle's number is physics' too.
    @MainThread @PanicsAtCaller
    Public Method Indices(): Int[]
        Local geometry = Live("Indices")
        Local count = fbe_geometry_indices(geometry, Null, 0)
        Local found = Buffer<UInt32>(count)
        Unsafe
            fbe_geometry_indices(geometry, found.Pointer(), count)
        End Unsafe
        Local indices: Int[] = []
        For index In found
            indices.Add(index As Int)
        End For
        Return indices
    End Method

    /// How many times it has changed, so what's worked out from it can know it's stale.
    @MainThread @PanicsAtCaller
    Public Method Version(): UInt64 => fbe_geometry_version(Live("Version"))

    // A panic naming the call, with what C said went wrong.
    @PanicsAtCaller
    Package Method Failed(call: String)
        Panic("{call} on a Geometry: {LastError()}")
    End Method

    // The handle, or a panic naming the call for a Geometry that was freed.
    @PanicsAtCaller
    Package Method Live(call: String): UInt64
        If handle == 0 Then Panic("{call} on a Geometry that was freed")
        Return handle
    End Method

    Static Method Keep(geometry: Geometry)
        Local slot = Slot(geometry.handle)
        While geometries.Count <= slot
            geometries.Add(Null)
        End While
        geometries[slot] = geometry
    End Method
End Class

/// A surface of a Geometry, by its index there: vertices and the triangles between them, drawn
/// in one material. It's the Geometry and the index, so two of the same are equal.
Public Struct Surface
    /// The Geometry it's in.
    Public Field Owner: Geometry
    /// Where it is among the Geometry's surfaces.
    Public Field Index: Int

    /// Adds a vertex and gives its index.
    @MainThread @PanicsAtCaller
    Public Method AddVertex(vertex: Vertex): Int => Added([vertex], "AddVertex")

    /// Adds a white vertex at `position`, with a zero normal and UVs, and gives its index.
    @MainThread @PanicsAtCaller
    Public Method AddVertex(position: Vec3): Int
        Return Added([PlainVertex(position, Vec2.Zero())], "AddVertex")
    End Method

    /// Adds a white vertex at `position` with both sets of UVs `uv`, and a zero normal, and gives
    /// its index.
    @MainThread @PanicsAtCaller
    Public Method AddVertex(position: Vec3, uv: Vec2): Int
        Return Added([PlainVertex(position, uv)], "AddVertex")
    End Method

    /// Adds vertices in one call, as loading or building a big surface does, and gives the first's
    /// index.
    @MainThread @PanicsAtCaller
    Public Method AddVertices(vertices: Vertex[]): Int => Added(vertices, "AddVertices")

    @PanicsAtCaller
    Method Added(vertices: Vertex[], call: String): Int
        Local geometry = Owner.Live(call)
        Local taken = Buffer<fbe_vertex_t>(vertices.Count)
        For i, vertex In vertices
            taken[i] = CVertexOf(vertex)
        End For
        Local first = 0
        Unsafe
            first = fbe_surface_add_vertices(geometry, Index, taken.Pointer(),
                                             vertices.Count As Int32)
        End Unsafe
        If first < 0 Then Owner.Failed(call)
        Return first
    End Method

    /// Adds a triangle between three of its vertices, counterclockwise seen from the front, and
    /// gives its index. An index of a vertex it doesn't have panics.
    @MainThread @PanicsAtCaller
    Public Method AddTriangle(a: Int, b: Int, c: Int): Int
        Return AddedTriangles([a, b, c], "AddTriangle")
    End Method

    /// Adds triangles in one call, three indices each, and gives the first's index. A count that
    /// isn't a multiple of 3, or an index of a vertex it doesn't have, panics.
    @MainThread @PanicsAtCaller
    Public Method AddTriangles(indices: Int[]): Int => AddedTriangles(indices, "AddTriangles")

    @PanicsAtCaller
    Method AddedTriangles(indices: Int[], call: String): Int
        Local geometry = Owner.Live(call)
        Local taken = Buffer<UInt32>(indices.Count)
        For i, index In indices
            If index < 0
                Panic("{call} on a Geometry: a triangle's index is 0 or more, not {index}")
            End If
            taken[i] = index As UInt32
        End For
        Local first = 0
        Unsafe
            first = fbe_surface_add_triangles(geometry, Index, taken.Pointer(),
                                              indices.Count As Int32)
        End Unsafe
        If first < 0 Then Owner.Failed(call)
        Return first
    End Method

    /// How many vertices it has.
    @MainThread @PanicsAtCaller
    Public Method VertexCount(): Int
        Local count = fbe_surface_vertex_count(Owner.Live("VertexCount"), Index)
        If count < 0 Then Owner.Failed("VertexCount")
        Return count
    End Method

    /// How many triangles it has.
    @MainThread @PanicsAtCaller
    Public Method TriangleCount(): Int
        Local count = fbe_surface_triangle_count(Owner.Live("TriangleCount"), Index)
        If count < 0 Then Owner.Failed("TriangleCount")
        Return count
    End Method

    /// The vertex at `index`. One it doesn't have panics.
    @MainThread @PanicsAtCaller
    Public Method Vertex(index: Int): Vertex => Read(index, "Vertex")

    @PanicsAtCaller
    Method Read(index: Int, call: String): Vertex
        Local geometry = Owner.Live(call)
        Local found = Buffer<fbe_vertex_t>(1)
        Local done = False
        Unsafe
            done = fbe_surface_vertices(geometry, Index, index, found.Pointer(), 1)
        End Unsafe
        If !done Then Owner.Failed(call)
        Return VertexOf(found[0])
    End Method

    /// Sets the vertex at `index`. One it doesn't have panics.
    @MainThread @PanicsAtCaller
    Public Method SetVertex(index: Int, vertex: Vertex)
        Written(index, [vertex], "SetVertex")
    End Method

    /// Every vertex, in order.
    @MainThread @PanicsAtCaller
    Public Method Vertices(): Vertex[]
        Local geometry = Owner.Live("Vertices")
        Local count = VertexCount()
        Local found = Buffer<fbe_vertex_t>(count)
        Local done = False
        Unsafe
            done = fbe_surface_vertices(geometry, Index, 0, found.Pointer(), count As Int32)
        End Unsafe
        If !done Then Owner.Failed("Vertices")
        Local vertices: Vertex[] = []
        For vertex In found
            vertices.Add(VertexOf(vertex))
        End For
        Return vertices
    End Method

    /// Sets vertices from `first` in one call. Ones it doesn't have panic.
    @MainThread @PanicsAtCaller
    Public Method SetVertices(first: Int, vertices: Vertex[])
        Written(first, vertices, "SetVertices")
    End Method

    @PanicsAtCaller
    Method Written(first: Int, vertices: Vertex[], call: String)
        Local geometry = Owner.Live(call)
        Local taken = Buffer<fbe_vertex_t>(vertices.Count)
        For i, vertex In vertices
            taken[i] = CVertexOf(vertex)
        End For
        Local done = False
        Unsafe
            done = fbe_surface_set_vertices(geometry, Index, first, taken.Pointer(),
                                            vertices.Count As Int32)
        End Unsafe
        If !done Then Owner.Failed(call)
    End Method

    /// Where the vertex at `index` is.
    @MainThread @PanicsAtCaller
    Public Method VertexPosition(index: Int): Vec3 => Read(index, "VertexPosition").Position

    /// Moves the vertex at `index`.
    @MainThread @PanicsAtCaller
    Public Method SetVertexPosition(index: Int, position: Vec3)
        Local vertex = Read(index, "SetVertexPosition")
        vertex.Position = position
        Written(index, [vertex], "SetVertexPosition")
    End Method

    /// The normal of the vertex at `index`.
    @MainThread @PanicsAtCaller
    Public Method VertexNormal(index: Int): Vec3 => Read(index, "VertexNormal").Normal

    /// Sets the normal of the vertex at `index`, as it's given.
    @MainThread @PanicsAtCaller
    Public Method SetVertexNormal(index: Int, normal: Vec3)
        Local vertex = Read(index, "SetVertexNormal")
        vertex.Normal = normal
        Written(index, [vertex], "SetVertexNormal")
    End Method

    /// The UVs of the vertex at `index` in a set, 0 or 1. Another set panics.
    @MainThread @PanicsAtCaller
    Public Method VertexUv(index: Int, set: Int = 0): Vec2
        Local vertex = Read(index, "VertexUv")
        Return UvSet(set, "VertexUv") == 0 ? vertex.Uv0 : vertex.Uv1
    End Method

    /// Sets the UVs of the vertex at `index` in a set, 0 or 1. Another set panics.
    @MainThread @PanicsAtCaller
    Public Method SetVertexUv(index: Int, uv: Vec2, set: Int = 0)
        Local vertex = Read(index, "SetVertexUv")
        If UvSet(set, "SetVertexUv") == 0
            vertex.Uv0 = uv
        Else
            vertex.Uv1 = uv
        End If
        Written(index, [vertex], "SetVertexUv")
    End Method

    /// The color and alpha of the vertex at `index`.
    @MainThread @PanicsAtCaller
    Public Method VertexColor(index: Int): Color => Read(index, "VertexColor").Color

    /// Sets the color and alpha of the vertex at `index`.
    @MainThread @PanicsAtCaller
    Public Method SetVertexColor(index: Int, color: Color)
        Local vertex = Read(index, "SetVertexColor")
        vertex.Color = color
        Written(index, [vertex], "SetVertexColor")
    End Method

    /// The three vertices of the triangle at `index`, counterclockwise seen from the front. One it
    /// doesn't have panics.
    @MainThread @PanicsAtCaller
    Public Method Triangle(index: Int): Vec3i
        Local geometry = Owner.Live("Triangle")
        Local found = Buffer<UInt32>(3)
        Local done = False
        Unsafe
            done = fbe_surface_triangles(geometry, Index, index, found.Pointer(), 1)
        End Unsafe
        If !done Then Owner.Failed("Triangle")
        Return Vec3i(found[0] As Int, found[1] As Int, found[2] As Int)
    End Method

    /// Every triangle's three indices, in order.
    @MainThread @PanicsAtCaller
    Public Method Triangles(): Int[]
        Local geometry = Owner.Live("Triangles")
        Local count = TriangleCount()
        Local found = Buffer<UInt32>(count * 3)
        Local done = False
        Unsafe
            done = fbe_surface_triangles(geometry, Index, 0, found.Pointer(), count As Int32)
        End Unsafe
        If !done Then Owner.Failed("Triangles")
        Local indices: Int[] = []
        For index In found
            indices.Add(index As Int)
        End For
        Return indices
    End Method

    /// Takes away its triangles and vertices.
    @MainThread @PanicsAtCaller
    Public Method Clear()
        If !fbe_surface_clear(Owner.Live("Clear"), Index, True) Then Owner.Failed("Clear")
    End Method

    /// Takes away its triangles, keeping its vertices.
    @MainThread @PanicsAtCaller
    Public Method ClearTriangles()
        If !fbe_surface_clear(Owner.Live("ClearTriangles"), Index, False)
            Owner.Failed("ClearTriangles")
        End If
    End Method
End Struct

/// A new Geometry for a handle a call made, or a panic naming the call when it made none.
@PanicsAtCaller
Function Made(handle: UInt64, call: String): Geometry
    If handle == 0 Then Panic("{call}: {LastError()}")
    Return Geometry(handle)
End Function

/// The Geometry a handle is for, from its wrapper if the game still holds one, or a new one, which
/// holds the handle once.
Package Function GeometryOf(handle: UInt64): Geometry?
    If handle == 0 Then Return Null
    Local slot = Slot(handle)
    If slot < geometries.Count
        Local kept = geometries[slot]
        If kept != Null && kept.handle == handle Then Return kept
    End If
    If !fbe_geometry_retain(handle) Then Panic("a geometry's handle went stale: {LastError()}")
    Return Geometry(handle)
End Function

@PanicsAtCaller
Function UvSet(set: Int, call: String): Int
    If set != 0 && set != 1
        Panic("{call} on a Geometry: a vertex's UV sets are 0 and 1, not {set}")
    End If
    Return set
End Function

Function White(): Color => Color(1, 1, 1, 1)

Function SurfaceOf(geometry: Geometry, index: Int): Surface => Surface(geometry, index)

Function PlainVertex(position: Vec3, uv: Vec2): Vertex => Vertex(position, Vec3.Zero(), uv, uv)

Function VertexOf(v: fbe_vertex_t): Vertex
    Return Vertex(VecOf(v.position), VecOf(v.normal), Vec2(v.uv0.x, v.uv0.y),
                  Vec2(v.uv1.x, v.uv1.y), Color(v.color.r, v.color.g, v.color.b, v.color.a))
End Function

Function CVertexOf(v: Vertex): fbe_vertex_t
    Return fbe_vertex_t(fbe_vec3_t(v.Position.x, v.Position.y, v.Position.z),
                        fbe_vec3_t(v.Normal.x, v.Normal.y, v.Normal.z),
                        fbe_vec2_t(v.Uv0.x, v.Uv0.y),
                        fbe_vec2_t(v.Uv1.x, v.Uv1.y),
                        fbe_color_t(v.Color.r, v.Color.g, v.Color.b, v.Color.a))
End Function

/// A matrix as C takes it.
Package Function MatrixOf(m: Mat4): fbe_mat4_t
    Local found = fbe_mat4_t()
    Local columns = [m.x, m.y, m.z, m.w]
    For column, v In columns
        found.m[column * 4] = v.x
        found.m[column * 4 + 1] = v.y
        found.m[column * 4 + 2] = v.z
        found.m[column * 4 + 3] = v.w
    End For
    Return found
End Function
