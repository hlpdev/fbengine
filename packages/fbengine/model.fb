// Models: glTF files as Assets, whose meshes, materials, images, skins, and clips are the engine's,
// and whose scenes are made into entities as many times as a game wants.

Import std.collections
Import std.core
Import std.ffi
Import std.io
Import std.text
Import "./assets"
Import "./c/fbe_model"
Import "./c/fbe_gpu"
Import "./c/fbe_scene"
Import "./c/fbe_texture"
Import "./camera"
Import "./clip"
Import "./entity"
Import "./geometry"
Import "./light"
Import "./loads"
Import "./material"
Import "./mesh"
Import "./morph"
Import "./player"
Import "./skin"
Import "./texture"
Import "./transform"
Import "./window"

/// What a model's material reads a Texture for.
Public Enum ModelMap
    BASE_COLOR = 0
    /// Roughness in green, metalness in blue.
    METALLIC_ROUGHNESS = 1
    NORMAL = 2
    OCCLUSION = 3
    EMISSIVE = 4
End Enum

// The root of a Spawn, for as long as it's there, and the scene it was of.
Final Class Spawned
    Field Root: Weak<Entity>
    Field Scene: Int

    New(root: Entity, scene: Int)
        Root = root
        Scene = scene
    End New

    // Its root, if it's there still.
    Method Alive(): Entity?
        Local root = Root
        Return root != Null && !root.Freed() ? root : Null
    End Method
End Class

/// A glTF or a binary glTF, as an Asset: `Assets.Load<Model>("res://door.glb")` reads it through
/// res://, its Geometries, Materials, Textures, Skins, and Clips made as it's made, which Spawn's
/// entities share, however many times it spawns. It starts the GPU if it hasn't, for its Textures,
/// unless Gpu.SetDisabled said there's none: then it has no Textures.
/// Hot reload puts a changed file in its place, and what each Spawn made is made again from it,
/// under the root that Spawn gave, which stays where it is.
///
/// Its Materials are what its file says, each map read from the Texture TextureOf says, with its
/// UV set and what its UVs go through, drawn as a glTF unlit one's are, or as the renderer lights
/// its PBR ones. Its surfaces have their tangents if the file does, and one that names no material
/// draws in glTF's default, a white metal as rough as can be, not one of its Materials.
Public Final Class Model Implements Asset
    Field load: AssetLoad
    Field geometries: Geometry[]
    Field materials: Material[]
    // Null for an image no material reads, as a KTX2's PNG fallback, so they're by the file's
    // indices.
    Field textures: Texture?[]
    // Textures of images read with different samplers, past the first's, or as no color by a map
    // when another reads them as one.
    Field others: Texture[]
    // Each image's name, or its URI for none, by the file's indices, as a reload finds them again.
    Field imageNames: String[]
    // How many times the GPU had stopped when it was made.
    Field stops: UInt64
    Field skins: Skin[]
    Field clips: Clip[]
    Field roots: Spawned[]
    Field freed: Bool

    New(load: AssetLoad)
        Self.load = load
        geometries = []
        materials = []
        textures = []
        others = []
        imageNames = []
        stops = fbe_gpu_stops()
        skins = []
        clips = []
        roots = []
        freed = False
    End New

    /// Assets' kind of load for one, a model's, on a GPU started, so its KTX2s of UASTC are
    /// transcoded to what it samples. A GPU that can't start is what FromLoad throws. With the GPU
    /// disabled it starts nothing, and the model's made without its images.
    @MainThread
    Public Static Method LoadKind(): AssetKind
        If !fbe_gpu_disabled() Then fbe_texture_start_loads()
        Return AssetKind.MODEL
    End Method

    /// One of what `load` read. It throws an IOError of INVALID_DATA for what's wrong in the file,
    /// and of OTHER when the GPU can't make its images.
    @MainThread
    Public Static Method FromLoad(load: AssetLoad): Model Throws IOError
        Local model = Model(load)
        Try model.Build()
        Return model
    End Method

    /// Takes the file `load` read in place of its own, and brings what each Spawn made up to date
    /// with it, under its root, which stays: each node the file still has goes on being the entity
    /// it was, by the name the file has for it and its kind, whatever it's been named since, set as
    /// the file says; what's new is made; what the file's lost is freed, and what a game's put under
    /// that goes up to what it was under, for a game's own entities are never freed. A Player on a
    /// root goes on, each clip it plays the new file's of that name, where it was, or stopped for
    /// none. A Material the file says nothing new of, in its own entry, the images it reads, and
    /// their samplers, is as it was, with all a game set on it: found by its name, if that's one
    /// material's in each file, or else by its number if the file has as many as it had. One the
    /// file's changed is what the file says, and so is one that read a Texture of the model's a
    /// game's freed, and one a game's freed is left; whether it draws vertex colors is by the
    /// file's meshes either way. Assets' OnReload is where a game gives one its look again.
    /// A material of anyone's that read one of its Textures reads the new file's of that image,
    /// found by its name, or its URI, or else its number, where it can: a layer the same format, a map
    /// what it can read; a World's sky and a camera's target aren't followed. It gives True. It throws
    /// as FromLoad does, and an IOError of INVALID_DATA for a file without a scene a Spawn was of,
    /// which leaves it as it was.
    @MainThread
    Public Method Reload(load: AssetLoad): Bool Throws IOError
        Local made = Model(load)
        Try made.Build()
        Try
            Try made.CanSpawn(roots)
        Catch e As IOError
            made.FreeParts()
            Throw e
        End Try
        made.Kept(Self)
        Local before = Model(Self.load)
        before.Took(Self)
        Took(made)
        stops = made.stops
        made.Emptied()
        Local failure: IOError? = Null
        Local taken: Clip?[] = []
        For clip In before.clips
            taken.Add(Named(clip.Name()))
        End For
        For spawned In before.roots
            Local root = spawned.Alive()
            If root == Null Then Continue
            roots.Add(spawned)
            Try
                Try Remade(root, spawned.Scene)
            Catch e As IOError
                failure = e
            End Try
            Local player = PlayerOn(root)
            If player != Null Then player.ReplaceClips(before.clips, taken)
        End For
        Followed(before)
        before.FreeParts()
        If failure != Null Then Throw failure
        Return True
    End Method

    /// Whether it's gone, the GPU stopped since it was made, so Assets makes a new one, and a hot
    /// reload of it doesn't start the GPU again.
    @MainThread
    Public Method Stale(): Bool
        Return freed || fbe_gpu_stops() != stops
    End Method

    /// Lets go of what it holds; what it's spawned keeps what it draws. Using it after panics. One
    /// Assets gave is let go of once, and goes with the last of its loads' holds.
    @MainThread @PanicsAtCaller
    Public Method Free()
        Live("Free")
        If !Assets.Release(Self) Then Return
        FreeParts()
        freed = True
    End Method

    /// Whether Free let go of it.
    @MainThread Public Method Freed(): Bool => freed

    /// Makes a scene of its file entities, each named and placed as its node is, under a new
    /// Pivot, the last child of `parent`, or at the top of the current World with Null, and gives
    /// the Pivot: `scene` from 0, or for -1, the scene its file says to show, or its nodes in no
    /// other node if it has no scenes. Find finds a node under it by name, and its Clips play on
    /// what's under it. It throws an IOError of INVALID_DATA for what the file says that
    /// entities can't be, and frees the Pivot; a scene that isn't there panics.
    @MainThread @PanicsAtCaller
    Public Method Spawn(parent: Entity? = Null, scene: Int = -1): Entity Throws IOError
        Live("Spawn")
        Local which = scene >= 0 ? scene : fbe_model_scene(load.Handle)
        If which >= Scenes() Then Panic("the model has {Scenes()} scenes; there's no scene {which}")
        Local root = Pivot(parent)
        Try
            Try SpawnInto(root, which)
        Catch e As IOError
            root.Free()
            Throw e
        End Try
        Local kept: Spawned[] = []
        For spawned In roots
            If spawned.Alive() != Null Then kept.Add(spawned)
        End For
        kept.Add(Spawned(root, which))
        roots = kept
        Return root
    End Method

    /// How many scenes its file has.
    @MainThread Public Method Scenes(): Int => fbe_model_scene_count(load.Handle)

    /// Its meshes' Geometry, by the file's indices, a surface a primitive.
    @MainThread @PanicsAtCaller
    Public Method Geometries(): Geometry[]
        Live("Geometries")
        Return geometries.Clone()
    End Method

    /// Its Materials, by the file's indices.
    @MainThread @PanicsAtCaller
    Public Method Materials(): Material[]
        Live("Materials")
        Return materials.Clone()
    End Method

    /// Its images' Textures, by the file's indices, Null for an image no material reads.
    @MainThread @PanicsAtCaller
    Public Method Textures(): Texture?[]
        Live("Textures")
        Return textures.Clone()
    End Method

    /// Its Skins, by the file's indices.
    @MainThread @PanicsAtCaller
    Public Method Skins(): Skin[]
        Live("Skins")
        Return skins.Clone()
    End Method

    /// Its Clips, by the file's indices.
    @MainThread @PanicsAtCaller
    Public Method Clips(): Clip[]
        Live("Clips")
        Return clips.Clone()
    End Method

    // Gives each of its Materials that the file says of what `before`'s said of its own, by its
    // name if that's one material's in each, or else its number if the file has as many as it
    // had, all that one has: what a game set on it since, and the textures it read, which
    // Followed then follows to this file's. What's from the file's meshes, whether it draws their
    // vertex colors, is this file's still. One a game's freed, of either, is passed over, and so
    // is one that read a Texture of `before`'s a game's freed, which isn't followed, so it's
    // what the file says.
    @MainThread
    Method Kept(before: Model)
        Local live: UInt64[] = []
        For texture In before.textures
            If texture != Null && !texture.Freed() Then live.Add(texture.Live("Reload"))
        End For
        For texture In before.others
            If !texture.Freed() Then live.Add(texture.Live("Reload"))
        End For
        Local own = "{before.load.Path()}#"
        For at = 0 Until materials.Count
            If materials[at].Freed() Then Continue
            Local name = MaterialNamed(at)
            Local was: Int? = Null
            If name != "" && MaterialsNamed(name) == 1 && before.MaterialsNamed(name) == 1
                For other = 0 Until before.materials.Count
                    If before.MaterialNamed(other) == name Then was = other
                End For
            ElseIf materials.Count == before.materials.Count
                was = at
            End If
            If was == Null Then Continue
            Local old = before.materials[was]
            If old.Freed() Then Continue
            If !fbe_model_material_same(load.Handle, at, before.load.Handle, was) Then Continue
            If ReadsFreed(old.Live("Reload"), live, own) Then Continue
            Local taking = materials[at].Live("Reload")
            Local colored = fbe_material_vertex_colors(taking)
            If !fbe_material_take(taking, old.Live("Reload")) Then Panic(LastError())
            If !fbe_material_set_vertex_colors(taking, colored) Then Panic(LastError())
        End For
    End Method

    // Whether the material `material` reads, in a layer or a map, a texture of the model whose
    // textures' paths begin with `own` that isn't one of `live`: one of its a game's freed.
    @MainThread
    Static Method ReadsFreed(material: UInt64, live: UInt64[], own: String): Bool
        Local read: UInt64[] = []
        For layer = 0 Until FBE_MATERIAL_LAYERS
            read.Add(fbe_material_texture(material, layer))
        End For
        For map = 0 Until FBE_MATERIAL_MAPS
            read.Add(fbe_material_map(material, map))
        End For
        For texture In read
            If texture == 0 || live.Contains(texture) Then Continue
            Local path = ""
            Unsafe
                path = fbe_texture_path(texture).ToString()
            End Unsafe
            If path.StartsWith(own) Then Return True
        End For
        Return False
    End Method

    // What its file calls its material at `at`, and how many of its materials it calls `name`.
    @MainThread
    Method MaterialNamed(at: Int): String
        Unsafe
            Return fbe_model_material_name(load.Handle, at).ToString()
        End Unsafe
    End Method

    @MainThread
    Method MaterialsNamed(name: String): Int
        Local count = 0
        For at = 0 Until materials.Count
            If MaterialNamed(at) == name Then count += 1
        End For
        Return count
    End Method

    // What's read of `before`'s textures by a material of anyone's, a scene's read of them or a game's,
    // reads this one's of the same image now, in one pass: the image of the same name, or of the same
    // number for a name that's none or not one image's. One the file no longer has, or a game's freed,
    // stays as it was.
    @MainThread
    Method Followed(before: Model)
        Local old: Texture[] = before.others.Clone()
        For texture In before.textures
            If texture != Null Then old.Add(texture)
        End For
        Local from: UInt64[] = []
        Local to: UInt64[] = []
        For texture In old
            If texture.Freed() Then Continue
            Local source = texture.Path()
            If source == Null Then Continue
            Local now = TextureFrom(SameImage(before, source), texture)
            If now == Null || now.Freed() Then Continue
            // An image file's own, which the file read again still has.
            If now.Live("Reload") == texture.Live("Reload") Then Continue
            from.Add(texture.Live("Reload"))
            to.Add(now.Live("Reload"))
        End For
        Local froms = Buffer<UInt64>(from.Count As Int64 + 1)
        Local tos = Buffer<UInt64>(to.Count As Int64 + 1)
        For at = 0 Until from.Count
            froms[at] = from[at]
            tos[at] = to[at]
        End For
        Local done = False
        Unsafe
            done = fbe_material_replace_textures(froms.Pointer(), tos.Pointer(),
                                                 from.Count As Int32)
        End Unsafe
        If !done Then Panic(LastError())
    End Method

    // What `source`, a Texture's Path of `before`, is of this one: its image found by its name, if
    // that's one image's in each, or else by its number.
    Method SameImage(before: Model, source: String): String
        Local marked = source.Split("#")
        If marked.Count < 2 Then Return source
        Local which = marked[marked.Count - 1].Split(":")
        Local image = Int.Parse(which[0])
        If image == Null || image < 0 || image >= before.imageNames.Count Then Return source
        Local name = before.imageNames[image]
        If name == "" || before.imageNames.Filter(Function(each: String) => each == name).Count != 1
            Return source
        End If
        Local now = imageNames.IndexOf(name)
        If now == Null || imageNames.Filter(Function(each: String) => each == name).Count != 1
            Return source
        End If
        which[0] = "{now}"
        marked[marked.Count - 1] = which.Join(":")
        Return marked.Join("#")
    End Method

    // Which of its Textures, its own or another of an image, has `source` for its Path, or Null:
    // of several, as an image file's are that's read in more ways than one, the one sampled and
    // made as `like` is, or the first.
    @MainThread
    Package Method TextureFrom(source: String, like: Texture? = Null): Texture?
        Live("TextureFrom")
        Local found: Texture? = Null
        Local all: Texture[] = others.Clone()
        For texture In textures
            If texture != Null Then all.Add(texture)
        End For
        For texture In all
            If texture.Freed() || texture.Path() != source Then Continue
            If like == Null Then Return texture
            If texture.Filter() == like.Filter() && texture.WrapAcross() == like.WrapAcross() &&
               texture.WrapDown() == like.WrapDown() &&
               texture.VulkanFormat() == like.VulkanFormat()
                Return texture
            End If
            found = found ?? texture
        End For
        Return found
    End Method

    /// The Texture its material at `index` reads for `map`, as it's bound, which for an image read
    /// two ways needn't be the one in Textures, or Null for none.
    @MainThread @PanicsAtCaller
    Public Method TextureOf(index: Int, map: ModelMap = ModelMap.BASE_COLOR): Texture?
        Live("TextureOf")
        If index < 0 || index >= materials.Count
            Panic("TextureOf on a Model: it has {materials.Count} materials; there's no material {index}")
        End If
        Local material = materials[index]
        Select map
            Case ModelMap.BASE_COLOR
                Return material.Texture(0)
            Case ModelMap.METALLIC_ROUGHNESS
                Return material.Map(MaterialMap.METAL_ROUGH)
            Case ModelMap.NORMAL
                Return material.Map(MaterialMap.NORMAL)
            Case ModelMap.OCCLUSION
                Return material.Map(MaterialMap.OCCLUSION)
            Case ModelMap.EMISSIVE
                Return material.Map(MaterialMap.EMISSIVE)
        End Select
    End Method

    /// What its file calls its material at `index`, "" for nothing.
    @MainThread @PanicsAtCaller
    Public Method MaterialName(index: Int): String
        Live("MaterialName")
        If index < 0 || index >= materials.Count
            Panic("MaterialName on a Model: it has {materials.Count} materials; there's no material {index}")
        End If
        Unsafe
            Return fbe_model_material_name(load.Handle, index).ToString()
        End Unsafe
    End Method

    /// What its file calls its image at `index`, by the indices Textures has them: its name, or
    /// for none, its URI, its percents decoded, up to any NUL, or "" for an image inside it with
    /// neither.
    @MainThread @PanicsAtCaller
    Public Method TextureName(index: Int): String
        Live("TextureName")
        If index < 0 || index >= textures.Count
            Panic(
                "TextureName on a Model: it has {textures.Count} images; there's no image {index}")
        End If
        Unsafe
            Return fbe_model_image_name(load.Handle, index).ToString()
        End Unsafe
    End Method

    /// What its file calls the image its material at `index` reads for `map`, "" for none, as
    /// TextureName says.
    @MainThread @PanicsAtCaller
    Public Method TextureNameOf(index: Int, map: ModelMap = ModelMap.BASE_COLOR): String
        Live("TextureNameOf")
        If index < 0 || index >= materials.Count
            Panic("TextureNameOf on a Model: it has {materials.Count} materials; there's no material {index}")
        End If
        Local image = fbe_model_material_image(load.Handle, index, map As Int32)
        Return image >= 0 && image < textures.Count ? TextureName(image) : ""
    End Method

    // Makes what its load has. What fails frees what it made.
    @MainThread
    Method Build() Throws IOError
        Try
            Try BuildParts()
        Catch e As IOError
            FreeParts()
            Throw e
        End Try
    End Method

    @MainThread
    Method BuildParts() Throws IOError
        Local info = load.Model()
        Local handles = Buffer<UInt64>(info.Materials As Int64 + 1)
        For at = 0 Until info.Materials
            Local material = fbe_model_material(load.Handle, at)
            If material == 0 Then Throw PartError()
            materials.Add(Material(material))
            handles[at] = material
        End For
        For at = 0 Until info.Meshes
            Local geometry: UInt64 = 0
            Unsafe
                geometry = fbe_model_geometry(load.Handle, at, handles.Pointer(), info.Materials)
            End Unsafe
            If geometry == 0 Then Throw PartError()
            geometries.Add(Sourced(Geometry(geometry), "{load.Path()}#{at}"))
        End For
        // With the GPU disabled, no image is made, and no material reads one.
        Local imaged = !fbe_gpu_disabled()
        For at = 0 Until info.Images
            Unsafe
                imageNames.Add(fbe_model_image_name(load.Handle, at).ToString())
            End Unsafe
            If !imaged || fbe_model_image_levels(load.Handle, at) == 0
                textures.Add(Null)
                Continue
            End If
            Local texture = fbe_model_texture(load.Handle, at, True)
            If texture == 0 Then Throw PartError()
            Local own = TextureShared(texture)
            // One of an image that's a file of its own is every model's that names the file, and
            // says that file.
            If own.Path() == Null Then own.SetSource("{load.Path()}#{at}")
            textures.Add(own)
        End For
        Local read = Buffer<UInt64>(info.Images As Int64 + 1)
        For at = 0 Until info.Images
            Local texture = textures[at]
            read[at] = texture != Null ? texture.Live("FromLoad") : 0
        End For
        Local capacity = info.Materials * FBE_MODEL_MAPS
        Local kept = Buffer<UInt64>(capacity As Int64 + 1)
        Local images = Buffer<Int32>(capacity As Int64 + 1)
        Local made: Int32 = 0
        Local failure: IOError? = Null
        For at = 0 Until (imaged ? info.Materials : 0)
            Local bound = False
            Unsafe
                bound = fbe_model_material_textures(load.Handle, at, handles[at], read.Pointer(),
                                                    info.Images, kept.Pointer(), images.Pointer(),
                                                    capacity, AddressOf(made))
            End Unsafe
            If !bound
                failure = PartError()
                Break
            End If
        End For
        // What it made is here to let go of, even if it then couldn't.
        Local readOtherwise = Map<Int32, Int>()
        For at = 0 Until made
            Local other = TextureShared(kept[at])
            Local image = images[at]
            Local nth = (readOtherwise.Get(image) ?? 0) + 1
            readOtherwise[image] = nth
            If other.Path() == Null Then other.SetSource("{load.Path()}#{image}:{nth}")
            others.Add(other)
        End For
        If failure != Null Then Throw failure
        For at = 0 Until info.Skins
            skins.Add(Try Skin.FromModel(load, at))
        End For
        For at = 0 Until info.Clips
            clips.Add(Try Clip.FromModel(load, at))
        End For
        // What its Textures were made of is theirs now.
        fbe_model_drop_images(load.Handle)
    End Method

    // Throws what its Spawns would, of each of `spawned`, each tried under a Pivot, in its root's
    // World, then freed.
    @MainThread
    Method CanSpawn(spawned: Spawned[]) Throws IOError
        For each In spawned
            Local root = each.Alive()
            If root == Null Then Continue
            If each.Scene >= Scenes()
                Throw IOError(IOErrorKind.INVALID_DATA,
                              "{load.Path()} has {Scenes()} scenes, and a Spawn's of scene " +
                              "{each.Scene}", load.Path())
            End If
            Local trial = Pivot(root)
            Try
                Try SpawnInto(trial, each.Scene)
            Catch e As IOError
                trial.Free()
                Throw e
            End Try
            trial.Free()
        End For
    End Method

    // Its Clip of `name`, if it has one.
    @MainThread
    Method Named(name: String): Clip?
        For clip In clips
            If clip.Name() == name Then Return clip
        End For
        Return Null
    End Method

    // Why a part couldn't be made, as C said.
    @MainThread
    Method PartError(): IOError
        Local kind = fbe_model_invalid() ? IOErrorKind.INVALID_DATA : IOErrorKind.OTHER
        Return IOError(kind, "{load.Path()}: {LastError()}", load.Path())
    End Method

    // What's kept that's skinned, for once what's under its root's settled.
    Field skinning: (Mesh, Skin)[] = []

    // What's under `root` brought up to date with scene `scene` of this file.
    @MainThread
    Method Remade(root: Entity, scene: Int) Throws IOError
        Local fresh = Pivot(root)
        Try
            Try SpawnInto(fresh, scene)
        Catch e As IOError
            fresh.Free()
            Throw e
        End Try
        Mapped(root, fresh)
        fresh.Free()
        Reskinned(root, root)
        For each In skinning
            Local mesh, skin = each
            mesh.SetSkin(skin, root)
        End For
        skinning = []
    End Method

    // What's under `into` made what's under `from` is: each its match, or moved here for none.
    @MainThread
    Method Mapped(into: Entity, from: Entity)
        Local had = into.Children().Filter(Function(each: Entity) => each.FileNode() != "")
        Local used: Entity[] = []
        For child In from.Children()
            Local match: Entity? = Null
            For each In had
                If each.FileNode() == child.FileNode() && each.Kind() == child.Kind() &&
                   !used.Any(Function(taken: Entity) => RefEquals(taken, each))
                    match = each
                    Break
                End If
            End For
            If match == Null
                child.SetParent(into, False)
            Else
                used.Add(match)
                Settled(child, match)
                Mapped(match, child)
            End If
        End For
        For each In had
            If !used.Any(Function(taken: Entity) => RefEquals(taken, each))
                Evicted(each, into)
                each.Free()
            End If
        End For
    End Method

    // What a game's put under `going`, or under anything of the file's under it, moved to `to`.
    @MainThread
    Method Evicted(going: Entity, to: Entity)
        For child In going.Children()
            If child.FileNode() == ""
                child.SetParent(to, True)
            Else
                Evicted(child, to)
            End If
        End For
    End Method

    // `to` set as `from`, the same kind, is, by the file: all but its name.
    @MainThread
    Method Settled(from: Entity, to: Entity)
        to.SetPosition(from.Position())
        to.SetRotation(from.Rotation())
        to.SetScale(from.Scale())
        Local mesh = from As? Mesh
        Local toMesh = to As? Mesh
        If mesh != Null && toMesh != Null
            toMesh.SetGeometry(mesh.Geometry())
            toMesh.SetMaterial(mesh.Material())
            toMesh.SetMorphWeights(mesh.MorphWeights())
            Local skin = mesh.Skin()
            If skin != Null
                skinning.Add((toMesh, skin))
            ElseIf toMesh.Skin() != Null
                toMesh.RemoveSkin()
            End If
        End If
        Local light = from As? Light
        Local toLight = to As? Light
        If light != Null && toLight != Null
            toLight.SetLightType(light.LightType())
            toLight.SetColor(light.Color())
            toLight.SetIntensity(light.Intensity())
            toLight.SetRange(light.Range())
            toLight.SetCone(light.InnerCone(), light.OuterCone())
        End If
        Local camera = from As? Camera
        Local toCamera = to As? Camera
        If camera != Null && toCamera != Null
            toCamera.SetProjection(camera.Projection())
            toCamera.SetFieldOfView(camera.FieldOfView())
            toCamera.SetOrthographicHeight(camera.OrthographicHeight())
            toCamera.SetRange(camera.Near(), camera.Far())
        End If
    End Method

    // Each mesh under `at` of the file's skinned over what's under `root`, the tree it's in now.
    @MainThread
    Method Reskinned(at: Entity, root: Entity)
        For child In at.Children()
            Local mesh = child As? Mesh
            Local skin = mesh?.Skin()
            If mesh != Null && skin != Null && child.FileNode() != "" Then mesh.SetSkin(skin, root)
            Reskinned(child, root)
        End For
    End Method

    // Each of what's under `at`, marked with the name the file has for it.
    @MainThread
    Method MarkNodes(at: Entity)
        For child In at.Children()
            child.SetFileNode(child.Name())
            MarkNodes(child)
        End For
    End Method

    // Makes scene `scene`'s nodes under `root`.
    @MainThread
    Method SpawnInto(root: Entity, scene: Int) Throws IOError
        Local drawn = Buffer<UInt64>(geometries.Count As Int64 + 1)
        For at = 0 Until geometries.Count
            drawn[at] = geometries[at].Live("Spawn")
        End For
        Local skinned = Buffer<UInt64>(skins.Count As Int64 + 1)
        For at = 0 Until skins.Count
            skinned[at] = skins[at].Live("Spawn")
        End For
        Local spawned = False
        Unsafe
            spawned = fbe_model_spawn(load.Handle, scene, root.Live("Spawn"), drawn.Pointer(),
                                      geometries.Count, skinned.Pointer(), skins.Count)
        End Unsafe
        If !spawned
            Local failure = PartError()
            FreeUnder(root)
            Throw failure
        End If
        MarkNodes(root)
    End Method

    // Frees what's under `root`.
    @MainThread
    Method FreeUnder(root: Entity)
        For child In root.Children()
            child.Free()
        End For
    End Method

    // Takes what `other` holds as its own.
    @MainThread
    Method Took(other: Model)
        load = other.load
        geometries = other.geometries
        materials = other.materials
        textures = other.textures
        others = other.others
        imageNames = other.imageNames
        skins = other.skins
        clips = other.clips
        roots = other.roots
    End Method

    // Forgets what it holds, which another's taken.
    @MainThread
    Method Emptied()
        geometries = []
        materials = []
        textures = []
        others = []
        imageNames = []
        skins = []
        clips = []
        roots = []
    End Method

    // Frees what it holds, what's freed already, as Textures the GPU's stopping freed, aside.
    @MainThread
    Method FreeParts()
        For geometry In geometries
            If !geometry.Freed() Then geometry.Free()
        End For
        For material In materials
            If !material.Freed() Then material.Free()
        End For
        For texture In textures
            If texture != Null Then texture.Unshared()
        End For
        For texture In others
            texture.Unshared()
        End For
        For skin In skins
            If !skin.Freed() Then skin.Free()
        End For
        For clip In clips
            If !clip.Freed() Then clip.Free()
        End For
        Emptied()
    End Method

    // A panic for one that's freed.
    @PanicsAtCaller
    Method Live(call: String)
        If freed Then Panic("{call} on a Model that was freed")
    End Method
End Class

/// The Texture of the image file at `path` that the Models naming it share, read as a color or not
/// and sampled so, and whether it's a new wrapper, the caller's to Free: the one there is, or with
/// `make`, one made of the file now. Null for none there without `make`; with it, it throws what
/// the file can't be made one for.
@MainThread
Package Function SharedTexture(path: String, srgb: Bool, filter: TextureFilter, across: TextureWrap,
                               down: TextureWrap, make: Bool): (Texture, Bool)? Throws IOError
    Local handle: UInt64 = 0
    Unsafe
        handle = fbe_model_image_texture(path, srgb, filter As Int32, across As Int32,
                                         down As Int32,
                                         make)
    End Unsafe
    If handle == 0
        If !make Then Return Null
        Local kind = fbe_model_invalid() ? IOErrorKind.INVALID_DATA : IOErrorKind.OTHER
        Throw IOError(kind, "{path}: {LastError()}", path)
    End If
    Return TextureHeld(handle)
End Function
