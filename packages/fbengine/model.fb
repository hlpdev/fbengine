// Models: glTF files as Assets, whose meshes, materials, images, skins, and clips are the engine's,
// and whose scenes are made into entities as many times as a game wants.

Import std.core
Import std.ffi
Import std.io
Import "./assets"
Import "./c/fbe_model"
Import "./c/fbe_scene"
Import "./c/fbe_texture"
Import "./clip"
Import "./entity"
Import "./geometry"
Import "./loads"
Import "./material"
Import "./skin"
Import "./texture"
Import "./window"

/// What a model's material reads a Texture for.
Public Enum ModelMap
    BASE_COLOR = 0
    /// Roughness in green, metalness in blue.
    METALLIC_ROUGHNESS = 1
    NORMAL = 2
    OCCLUSION = 3
    EMISSIVE = 4
End Enum

// The root of a Spawn, for as long as it's there, and the scene it was of.
Final Class Spawned
    Field Root: Weak<Entity>
    Field Scene: Int

    New(root: Entity, scene: Int)
        Root = root
        Scene = scene
    End New

    // Its root, if it's there still.
    Method Alive(): Entity?
        Local root = Root
        Return root != Null && !root.Freed() ? root : Null
    End Method
End Class

/// A glTF or a binary glTF, as an Asset: `Assets.Load<Model>("res://door.glb")` reads it through
/// res://, its Geometries, Materials, Textures, Skins, and Clips made as it's made, which Spawn's
/// entities share, however many times it spawns. It starts the GPU if it hasn't, for its Textures.
/// Hot reload puts a changed file in its place, and what each Spawn made is made again from it,
/// under the root that Spawn gave, which stays where it is.
///
/// The renderer's materials don't take textures until E5's step does, so what a material reads
/// for now is for TextureOf to say.
Public Final Class Model Implements Asset
    Field load: AssetLoad
    Field geometries: Geometry[]
    Field materials: Material[]
    Field textures: Texture[]
    Field skins: Skin[]
    Field clips: Clip[]
    Field roots: Spawned[]
    Field freed: Bool

    New(load: AssetLoad)
        Self.load = load
        geometries = []
        materials = []
        textures = []
        skins = []
        clips = []
        roots = []
        freed = False
    End New

    /// Assets' kind of load for one, a model's, on a GPU started, so its KTX2s of UASTC are
    /// transcoded to what it samples. A GPU that can't start is what FromLoad throws.
    @MainThread
    Public Static Method LoadKind(): AssetKind
        fbe_texture_start_loads()
        Return AssetKind.MODEL
    End Method

    /// One of what `load` read. It throws an IOError of INVALID_DATA for what's wrong in the file,
    /// and of OTHER when the GPU can't make its images.
    @MainThread
    Public Static Method FromLoad(load: AssetLoad): Model Throws IOError
        Local model = Model(load)
        Try model.Build()
        Return model
    End Method

    /// Takes the file `load` read in place of its own, and makes what each Spawn made again from
    /// it, under its root, which stays; what's under a root is freed, a game's own entities there
    /// too. It gives True. It throws as FromLoad does, which leaves it as it was.
    @MainThread
    Public Method Reload(load: AssetLoad): Bool Throws IOError
        Local made = Model(load)
        Try made.Build()
        Local before = Model(Self.load)
        before.Took(Self)
        Took(made)
        made.Emptied()
        Local failure: IOError? = Null
        For spawned In before.roots
            Local root = spawned.Alive()
            If root == Null Then Continue
            roots.Add(spawned)
            FreeUnder(root)
            Try
                Try SpawnInto(root, spawned.Scene)
            Catch e As IOError
                failure = e
            End Try
        End For
        before.FreeParts()
        If failure != Null Then Throw failure
        Return True
    End Method

    /// Whether it's gone, its Textures freed as the GPU stopped, so Assets makes a new one.
    @MainThread
    Public Method Stale(): Bool
        Return freed || (textures.Count > 0 && textures[0].Freed())
    End Method

    /// Lets go of what it holds; what it's spawned keeps what it draws. Using it after panics. One
    /// Assets gave is let go of once, and goes with the last of its loads' holds.
    @MainThread @PanicsAtCaller
    Public Method Free()
        Live("Free")
        If !Assets.Release(Self) Then Return
        FreeParts()
        freed = True
    End Method

    /// Whether Free let go of it.
    @MainThread Public Method Freed(): Bool => freed

    /// Makes a scene of its file entities, each named and placed as its node is, under a new
    /// Pivot, the last child of `parent`, or at the top of the current World with Null, and gives
    /// the Pivot: `scene` from 0, or for -1, the scene its file says to show, or its nodes in no
    /// other node if it has no scenes. Find finds a node under it by name, and its Clips play on
    /// what's under it. It throws an IOError of INVALID_DATA for what the file says that
    /// entities can't be, and frees the Pivot; a scene that isn't there panics.
    @MainThread @PanicsAtCaller
    Public Method Spawn(parent: Entity? = Null, scene: Int = -1): Entity Throws IOError
        Live("Spawn")
        Local which = scene >= 0 ? scene : fbe_model_scene(load.Handle)
        If which >= Scenes() Then Panic("the model has {Scenes()} scenes; there's no scene {which}")
        Local root = Pivot(parent)
        Try
            Try SpawnInto(root, which)
        Catch e As IOError
            root.Free()
            Throw e
        End Try
        Local kept: Spawned[] = []
        For spawned In roots
            If spawned.Alive() != Null Then kept.Add(spawned)
        End For
        kept.Add(Spawned(root, which))
        roots = kept
        Return root
    End Method

    /// How many scenes its file has.
    @MainThread Public Method Scenes(): Int => fbe_model_scene_count(load.Handle)

    /// Its meshes' Geometry, by the file's indices, a surface a primitive.
    @MainThread @PanicsAtCaller
    Public Method Geometries(): Geometry[]
        Live("Geometries")
        Return geometries.Clone()
    End Method

    /// Its Materials, by the file's indices.
    @MainThread @PanicsAtCaller
    Public Method Materials(): Material[]
        Live("Materials")
        Return materials.Clone()
    End Method

    /// Its images' Textures, by the file's indices.
    @MainThread @PanicsAtCaller
    Public Method Textures(): Texture[]
        Live("Textures")
        Return textures.Clone()
    End Method

    /// Its Skins, by the file's indices.
    @MainThread @PanicsAtCaller
    Public Method Skins(): Skin[]
        Live("Skins")
        Return skins.Clone()
    End Method

    /// Its Clips, by the file's indices.
    @MainThread @PanicsAtCaller
    Public Method Clips(): Clip[]
        Live("Clips")
        Return clips.Clone()
    End Method

    /// The Texture its material at `index` reads for `map`, or Null for none.
    @MainThread @PanicsAtCaller
    Public Method TextureOf(index: Int, map: ModelMap = ModelMap.BASE_COLOR): Texture?
        Live("TextureOf")
        If index < 0 || index >= materials.Count
            Panic("the model has {materials.Count} materials; there's no material {index}")
        End If
        Local image = fbe_model_material_image(load.Handle, index, map As Int32)
        If image < 0 || image >= textures.Count Then Return Null
        Return textures[image]
    End Method

    // Makes what its load has. What fails frees what it made.
    @MainThread
    Method Build() Throws IOError
        Try
            Try BuildParts()
        Catch e As IOError
            FreeParts()
            Throw e
        End Try
    End Method

    @MainThread
    Method BuildParts() Throws IOError
        Local info = load.Model()
        Local handles = Buffer<UInt64>(info.Materials As Int64 + 1)
        For at = 0 Until info.Materials
            Local material = fbe_model_material(load.Handle, at)
            If material == 0 Then Throw PartError()
            materials.Add(Material(material))
            handles[at] = material
        End For
        For at = 0 Until info.Meshes
            Local geometry: UInt64 = 0
            Unsafe
                geometry = fbe_model_geometry(load.Handle, at, handles.Pointer(), info.Materials)
            End Unsafe
            If geometry == 0 Then Throw PartError()
            geometries.Add(Geometry(geometry))
        End For
        For at = 0 Until info.Images
            Local texture = fbe_model_texture(load.Handle, at, True)
            If texture == 0 Then Throw PartError()
            textures.Add(Texture(texture))
        End For
        For at = 0 Until info.Skins
            skins.Add(Try Skin.FromModel(load, at))
        End For
        For at = 0 Until info.Clips
            clips.Add(Try Clip.FromModel(load, at))
        End For
    End Method

    // Why a part couldn't be made, as C said.
    @MainThread
    Method PartError(): IOError
        Local kind = fbe_model_invalid() ? IOErrorKind.INVALID_DATA : IOErrorKind.OTHER
        Return IOError(kind, "{load.Path()}: {LastError()}", load.Path())
    End Method

    // Makes scene `scene`'s nodes under `root`.
    @MainThread
    Method SpawnInto(root: Entity, scene: Int) Throws IOError
        Local drawn = Buffer<UInt64>(geometries.Count As Int64 + 1)
        For at = 0 Until geometries.Count
            drawn[at] = geometries[at].Live("Spawn")
        End For
        Local skinned = Buffer<UInt64>(skins.Count As Int64 + 1)
        For at = 0 Until skins.Count
            skinned[at] = skins[at].Live("Spawn")
        End For
        Local spawned = False
        Unsafe
            spawned = fbe_model_spawn(load.Handle, scene, root.Live("Spawn"), drawn.Pointer(),
                                      geometries.Count, skinned.Pointer(), skins.Count)
        End Unsafe
        If !spawned
            Local failure = PartError()
            FreeUnder(root)
            Throw failure
        End If
    End Method

    // Frees what's under `root`.
    @MainThread
    Method FreeUnder(root: Entity)
        For child In root.Children()
            child.Free()
        End For
    End Method

    // Takes what `other` holds as its own.
    @MainThread
    Method Took(other: Model)
        load = other.load
        geometries = other.geometries
        materials = other.materials
        textures = other.textures
        skins = other.skins
        clips = other.clips
        roots = other.roots
    End Method

    // Forgets what it holds, which another's taken.
    @MainThread
    Method Emptied()
        geometries = []
        materials = []
        textures = []
        skins = []
        clips = []
        roots = []
    End Method

    // Frees what it holds, what's freed already, as Textures the GPU's stopping freed, aside.
    @MainThread
    Method FreeParts()
        For geometry In geometries
            If !geometry.Freed() Then geometry.Free()
        End For
        For material In materials
            If !material.Freed() Then material.Free()
        End For
        For texture In textures
            If !texture.Freed() Then texture.Free()
        End For
        For skin In skins
            If !skin.Freed() Then skin.Free()
        End For
        For clip In clips
            If !clip.Freed() Then clip.Free()
        End For
        Emptied()
    End Method

    // A panic for one that's freed.
    @PanicsAtCaller
    Method Live(call: String)
        If freed Then Panic("{call} on a Model that was freed")
    End Method
End Class
