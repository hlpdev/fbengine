// A Sprite2D: a texture as 2D draws it, all of it, a region, or the frames of a sheet, and its
// handle, which a Canvas draws it at, rotates it about, and scales it from. The scene's Sprite is
// a 3D entity, a quad facing the camera.

Import std.core
From std.image Import Image
Import std.io
Import std.math
Import "./c/fbe_2d"
Import "./texture"
Import "./window"

// `image` with every pixel of exactly `key`'s red, green, and blue transparent black.
Function Keyed(image: Image, key: Color32): Image
    Local bytes = image.ToBytes()
    For at = 0 To (bytes.Count / 4) - 1
        If bytes[at * 4] == key.r && bytes[at * 4 + 1] == key.g && bytes[at * 4 + 2] == key.b
            bytes[at * 4] = 0
            bytes[at * 4 + 1] = 0
            bytes[at * 4 + 2] = 0
            bytes[at * 4 + 3] = 0
        End If
    End For
    Return Image.FromBytes(image.Width, image.Height, bytes)
End Function

// A texture of `image`, without mipmaps; here, as in Sprite2D, Texture is its Method.
Function ImageTexture(image: Image): Texture Throws GraphicsError
    Return Try Texture.FromImage(image, False)
End Function

// A texture of an image file's, without mipmaps; here, as in Sprite2D, Texture is its Method.
Function LoadedTexture(path: Path): Texture Throws GraphicsError, IOError
    Return Try Texture.Load(path, False)
End Function

/// A texture as a Canvas draws it: all of it, a region of it, or the frames of a sheet, cells of
/// one size left to right and then down; and its handle, the point of a frame that lands where it's
/// drawn, which it's rotated about and scaled from, its top left unless set. It keeps its texture.
Public Final Class Sprite2D
    Field texture: Texture
    Field region: Rect? = Null
    Field cellWidth: Int32 = 0
    Field cellHeight: Int32 = 0
    Field first: Int32 = 0
    Field count: Int32 = 1
    Field handle: Vec2

    /// A sprite of all of `texture`.
    @MainThread Public New(texture: Texture)
        Self.texture = texture
        handle = Vec2(0, 0)
    End New

    /// A sprite of the texture an image file decodes to, PNG, JPEG, BMP, TGA, GIF, QOI, or WebP,
    /// without mipmaps, as 2D draws it at its size. It throws when the file can't be read or
    /// decoded, or the GPU can't make the texture.
    @MainThread
    Public Static Method Load(path: Path): Sprite2D Throws GraphicsError, IOError
        Return Sprite2D(Try LoadedTexture(path))
    End Method

    /// A sprite of a texture of `image`, without mipmaps, as 2D draws it at its size; every pixel of
    /// exactly `masked`'s red, green, and blue is transparent, as art with a key color's background
    /// wants, and `image` isn't changed. A keyed texture is sampled NEAREST, which SetFilter can
    /// change, so its key color doesn't bleed into its edges when it's scaled. It throws when the GPU
    /// can't make the texture.
    @MainThread
    Public Static Method FromImage(image: Image,
                                   masked: Color32? = Null): Sprite2D Throws GraphicsError
        If masked == Null Then Return Sprite2D(Try ImageTexture(image))
        Local made = Try ImageTexture(Keyed(image, masked))
        made.SetFilter(TextureFilter.NEAREST)
        Return Sprite2D(made)
    End Method

    /// The texture it draws.
    @MainThread Public Method Texture(): Texture => texture

    /// Draws `width` by `height` pixels of its texture at `x`, `y`, one frame, its handle kept. It
    /// panics unless they're in the texture.
    @MainThread @PanicsAtCaller
    Public Method SetRegion(x: Int32, y: Int32, width: Int32, height: Int32)
        If x < 0 || y < 0 || width < 1 || height < 1 || x + width > texture.Width() ||
           y + height > texture.Height()
            Panic("a {width}x{height} region at {x}, {y} isn't in a {texture.Width()}x{texture.Height()} texture")
        End If
        region = Rect(x As Float, y As Float, width As Float, height As Float)
        cellWidth = 0
        cellHeight = 0
        first = 0
        count = 1
    End Method

    /// Draws its texture as a sheet of frames, cells `cellWidth` by `cellHeight` pixels left to
    /// right and then down, partial cells at the right and bottom left out: `count` of them from
    /// the `first`, or with 0, all from the first. It panics for a cell bigger than the texture, or
    /// frames it hasn't.
    @MainThread @PanicsAtCaller
    Public Method SetFrames(cellWidth: Int32, cellHeight: Int32, first: Int32 = 0, count: Int32 = 0)
        If cellWidth < 1 || cellHeight < 1 || cellWidth > texture.Width() ||
           cellHeight > texture.Height()
            Panic("a {cellWidth}x{cellHeight} cell isn't in a {texture.Width()}x{texture.Height()} texture")
        End If
        Local cells = (texture.Width() / cellWidth) * (texture.Height() / cellHeight)
        Local wanted = count == 0 ? cells - first : count
        If first < 0 || wanted < 1 || first + wanted > cells
            Panic("the texture has {cells} cells, not {wanted} from {first}")
        End If
        Self.cellWidth = cellWidth
        Self.cellHeight = cellHeight
        Self.first = first
        Self.count = wanted
        region = Null
    End Method

    /// How many frames it has, 1 unless it's a sheet's.
    @MainThread Public Method Frames(): Int32 => count

    /// How wide a frame is, in pixels.
    @MainThread Public Method Width(): Int32
        If cellWidth > 0 Then Return cellWidth
        Local part = region
        Return part != Null ? part.Width As Int32 : texture.Width()
    End Method

    /// How high a frame is, in pixels.
    @MainThread Public Method Height(): Int32
        If cellHeight > 0 Then Return cellHeight
        Local part = region
        Return part != Null ? part.Height As Int32 : texture.Height()
    End Method

    /// Sets its handle, in a frame's pixels from its top left.
    @MainThread Public Method SetHandle(x: Float, y: Float)
        handle = Vec2(x, y)
    End Method

    /// Puts its handle in a frame's middle, at the whole pixel left of it and above it where its
    /// size is odd, so it's drawn at whole pixels as it's drawn at them; SetHandle puts it exactly
    /// in the middle.
    @MainThread Public Method MidHandle()
        handle = Vec2((Width() / 2) As Float, (Height() / 2) As Float)
    End Method

    /// Its handle, in a frame's pixels from its top left.
    @MainThread Public Method Handle(): Vec2 => handle

    // What C draws of frame `frame`, rotated and scaled as given; it panics for a frame it hasn't.
    @PanicsAtCaller
    Package Method Drawn(frame: Int32, rotation: Float32, scaleX: Float32,
                         scaleY: Float32): fbe_2d_sprite_t
        If frame < 0 || frame >= count Then Panic("the sprite's frames are 0 to {count - 1}, not {frame}")
        Local x: Float32 = 0
        Local y: Float32 = 0
        Local width: Float32 = 0
        Local height: Float32 = 0
        If cellWidth > 0
            Local across = texture.Width() / cellWidth
            Local cell = first + frame
            x = ((cell % across) * cellWidth) As Float32
            y = ((cell / across) * cellHeight) As Float32
            width = cellWidth As Float32
            height = cellHeight As Float32
        Else
            Local part = region
            If part != Null
                x = part.X As Float32
                y = part.Y As Float32
                width = part.Width As Float32
                height = part.Height As Float32
            End If
        End If
        Return fbe_2d_sprite_t(x, y, width, height, handle.x As Float32, handle.y As Float32,
                               rotation,
                               scaleX, scaleY)
    End Method

    // Its texture's handle, or a panic for one that was freed.
    @PanicsAtCaller
    Package Method Live(): UInt64 => texture.Live("Draw")
End Class
