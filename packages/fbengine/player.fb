// Players: what plays Clips on an entity and the entities under it, in layers, which an entity's
// Player() gives, and UpdateWorld moves on, handing the game the events they reach.

Import std.core
Import std.ffi
Import "./c/fbe_player"
Import "./clip"
Import "./entity"
Import "./window"
Import "./world"

/// How a Clip goes on at its end.
Public Enum PlayMode
    /// Once, holding its end, or its start when it plays backward.
    ONCE = 0
    /// From its start again, or its end when it plays backward, over and over.
    LOOP = 1
    /// Back the way it came, then on again, over and over.
    PING_PONG = 2
End Enum

/// An event a Player reached in a Clip it plays: the event's name, the Clip's, the layer the Clip
/// plays on, and the event's time in the Clip.
Public Struct ClipEvent Implements Printable
    Public Field Name: String
    Public Field ClipName: String
    Public Field Layer: Int
    Public Field Time: Float

    Public Method ToString(): String => "\"{Name}\" of \"{ClipName}\" at {Time}, on layer {Layer}"
End Struct

// The Player of each entity that has one, by its entity's handle's slot, and by its own.
Global players: Player?[] = []
Global playersByHandle: Player?[] = []

/// What plays Clips on an entity and the entities under it: the one its Player() gives. Each of a
/// Clip's channels moves the entity of its name, the entity itself or the first under it with the
/// name, depth first, as Find finds them, bound as it's played or once the Clip changes; a name no
/// entity has is left out. UpdateWorld moves it on by its seconds.
///
/// It plays in layers, from 0 to 15, each over the ones before it, as much as its Weight says, and
/// kept to its Mask's entities when it has one; its own methods are layer 0's. A layer plays a
/// Clip, or two or more while a Crossfade goes from one to the next, their poses mixed by how far
/// in each is. Each property a Clip moves starts from where it was when a Clip began moving it, so
/// one faded out leaves it there; what no Clip moves is left as it is, for the game to move. Once
/// its entity's freed, using it panics, and the next update lets go of what it kept, unless the game
/// holds it.
Public Final Class Player
    Field handle: UInt64
    Field owner: Entity
    // Its entity's handle's slot, which it's kept by.
    Field ownerSlot: Int
    // The Clip each layer played last.
    Field currents: Clip?[] = []
    Field handler: (Func(ClipEvent))? = Null

    New(owner: Entity)
        Local entity = owner.Live("Player")
        handle = fbe_player_create(entity)
        If handle == 0 Then Panic("Player on a {owner.KindName()}: {LastError()}")
        Self.owner = owner
        ownerSlot = Slot(entity)
        For index = 0 Until FBE_PLAYER_LAYERS
            currents.Add(Null)
        End For
    End New

    Method Destroy()
        If handle != 0 Then fbe_player_free(handle)
    End Method

    // Puts each of `to` in place of what's at its index in `from`, or stops that for Null, and
    // binds what plays again, to what's under its entity now.
    @MainThread @PanicsAtCaller
    Package Method ReplaceClips(from: Clip[], to: Clip?[])
        Local was = Buffer<UInt64>(from.Count As Int64 + 1)
        Local now = Buffer<UInt64>(from.Count As Int64 + 1)
        For at = 0 Until from.Count
            was[at] = from[at].Live("ReplaceClips")
            Local taking = to[at]
            now[at] = taking != Null ? taking.Live("ReplaceClips") : 0
        End For
        Local done = False
        Unsafe
            done = fbe_player_replace_clips(Live("ReplaceClips"), was.Pointer(), now.Pointer(),
                                            from.Count)
        End Unsafe
        If !done Then Failed("ReplaceClips")
        For layer = 0 Until currents.Count
            Local current = currents[layer]
            If current == Null Then Continue
            For at = 0 Until from.Count
                If RefEquals(current, from[at]) Then currents[layer] = to[at]
            End For
        End For
    End Method

    /// How many Players there are, whose entities' freeing an update hasn't yet found.
    @MainThread Public Static Method Count(): Int64 => fbe_player_count()

    /// The entity it plays on.
    @MainThread Public Method Entity(): Entity => owner

    /// Its layer at `index`, from 0 to 15. One outside that panics.
    @MainThread @PanicsAtCaller
    Public Method Layer(index: Int): PlayerLayer
        If index < 0 || index >= FBE_PLAYER_LAYERS
            Panic("Layer({index}) on a Player: its layers are 0 to {FBE_PLAYER_LAYERS - 1}")
        End If
        Return PlayerLayer(Self, index)
    End Method

    /// Plays `clip` on layer 0, as its layer's Play does.
    @MainThread @PanicsAtCaller
    Public Method Play(clip: Clip, mode: PlayMode = PlayMode.LOOP, speed: Float = 1)
        Layer(0).Play(clip, mode, speed)
    End Method

    /// Crossfades to `clip` on layer 0, as its layer's Crossfade does.
    @MainThread @PanicsAtCaller
    Public Method Crossfade(clip: Clip, seconds: Float, mode: PlayMode = PlayMode.LOOP,
                            speed: Float = 1)
        Layer(0).Crossfade(clip, seconds, mode, speed)
    End Method

    /// Stops layer 0, as its layer's Stop does.
    @MainThread @PanicsAtCaller
    Public Method Stop(seconds: Float = 0)
        Layer(0).Stop(seconds)
    End Method

    /// The Clip layer 0 plays, or Null.
    @MainThread @PanicsAtCaller
    Public Method Clip(): Clip? => Layer(0).Clip()

    /// Whether layer 0 plays its Clip, as its layer's Playing says.
    @MainThread @PanicsAtCaller
    Public Method Playing(): Bool => Layer(0).Playing()

    /// Puts layer 0's Clip at `seconds`, as its layer's SetTime does.
    @MainThread @PanicsAtCaller
    Public Method SetTime(seconds: Float)
        Layer(0).SetTime(seconds)
    End Method

    /// Where layer 0 is in its Clip, in seconds.
    @MainThread @PanicsAtCaller
    Public Method Time(): Float => Layer(0).Time()

    /// Sets how fast layer 0 plays its Clip, as its layer's SetSpeed does.
    @MainThread @PanicsAtCaller
    Public Method SetSpeed(speed: Float)
        Layer(0).SetSpeed(speed)
    End Method

    /// How fast layer 0 plays its Clip.
    @MainThread @PanicsAtCaller
    Public Method Speed(): Float => Layer(0).Speed()

    /// Calls `handler` with each event its Clips reach, on any layer, in the order they're reached,
    /// as UpdateWorld moves them on, once the World's moved and collided; Null stops, even within a
    /// handler, for the rest of that update's. Events reached while it has none are let go of.
    /// Freeing its entity in a handler doesn't stop those of that update, as they were reached.
    @MainThread
    Public Method OnEvent(handler: (Func(ClipEvent))?)
        Self.handler = handler
    End Method

    // A panic naming the call, with what C said went wrong.
    @PanicsAtCaller
    Package Method Failed(call: String)
        Panic("{call} on a Player: {LastError()}")
    End Method

    // The handle, or a panic naming the call once its entity's freed.
    @PanicsAtCaller
    Package Method Live(call: String): UInt64
        If owner.Freed() Then Panic("{call} on a Player whose entity was freed")
        Return handle
    End Method

    // The events it reached, let go of.
    Package Method TakeEvents(): ClipEvent[]
        Local events: ClipEvent[] = []
        For index = 0 Until fbe_player_event_count(handle)
            Local name = ""
            Local clip = ""
            Unsafe
                name = fbe_player_event_name(handle, index).ToString()
                clip = fbe_player_event_clip(handle, index).ToString()
            End Unsafe
            events.Add(ClipEvent(name, clip, fbe_player_event_layer(handle, index),
                                 fbe_player_event_time(handle, index)))
        End For
        fbe_player_clear_events(handle)
        Return events
    End Method
End Class

/// One of a Player's layers, which its Layer(index) gives, over the layers before it.
Public Struct PlayerLayer
    Package Field owner: Player
    Package Field index: Int

    /// The Player it's one of.
    @MainThread Public Method Player(): Player => owner

    /// Which of its Player's layers it is, from 0.
    @MainThread Public Method Index(): Int => index

    /// Plays `clip` in `mode`, at `speed` times as fast as it was made, in place of what the layer
    /// played, posing what it moves at once, from its start, or its end below 0, which plays it
    /// backward. If it's what the layer's playing already, even at its end or fading in, it only
    /// takes the new mode and speed, so a game can ask for its walk, or its death, each frame; Stop
    /// first plays it again. A speed that isn't a number panics.
    @MainThread @PanicsAtCaller
    Public Method Play(clip: Clip, mode: PlayMode = PlayMode.LOOP, speed: Float = 1)
        If !fbe_player_play(owner.Live("Play"), index, clip.Live("Play"), mode As Int32, speed)
            owner.Failed("Play")
        End If
        owner.currents[index] = clip
    End Method

    /// Plays `clip` as Play does, fading it in over `seconds` while what the layer played fades
    /// out; one being faded out goes on where it is, fading back in. Seconds below 0, or not finite,
    /// panic.
    @MainThread @PanicsAtCaller
    Public Method Crossfade(clip: Clip, seconds: Float, mode: PlayMode = PlayMode.LOOP,
                            speed: Float = 1)
        Local played = clip.Live("Crossfade")
        If !fbe_player_crossfade(owner.Live("Crossfade"), index, played, seconds, mode As Int32,
                                 speed)
            owner.Failed("Crossfade")
        End If
        owner.currents[index] = clip
    End Method

    /// Fades out what the layer plays over `seconds`, back to where what it moved was before, or
    /// with 0 stops it at once, leaving what it moved where it is. Seconds below 0, or not finite,
    /// panic.
    @MainThread @PanicsAtCaller
    Public Method Stop(seconds: Float = 0)
        If !fbe_player_stop(owner.Live("Stop"), index, seconds) Then owner.Failed("Stop")
        owner.currents[index] = Null
    End Method

    /// The Clip it played last, which it plays or fades in, or Null.
    @MainThread @PanicsAtCaller
    Public Method Clip(): Clip? => fbe_player_clip(owner.Live("Clip"),
                                                   index) != 0 ? owner.currents[index] : Null

    /// Whether it plays its Clip: False once a ONCE Clip's at its end, or it's stopping.
    @MainThread @PanicsAtCaller
    Public Method Playing(): Bool => fbe_player_playing(owner.Live("Playing"), index)

    /// Puts its Clip at `seconds`, as its mode has it, posing what it moves at once: held at its
    /// ends once, round a loop, there and back for ping-pong. An event at that time isn't reached.
    /// Not finite panics.
    @MainThread @PanicsAtCaller
    Public Method SetTime(seconds: Float)
        If !fbe_player_set_time(owner.Live("SetTime"), index, seconds) Then owner.Failed("SetTime")
    End Method

    /// Where it is in its Clip, in seconds, 0 for none.
    @MainThread @PanicsAtCaller
    Public Method Time(): Float => fbe_player_time(owner.Live("Time"), index)

    /// Sets how many times as fast as it was made it plays its Clip, backward below 0. Not a
    /// number panics.
    @MainThread @PanicsAtCaller
    Public Method SetSpeed(speed: Float)
        If !fbe_player_set_speed(owner.Live("SetSpeed"), index, speed) Then owner.Failed("SetSpeed")
    End Method

    /// How fast it plays its Clip, 0 for none.
    @MainThread @PanicsAtCaller
    Public Method Speed(): Float => fbe_player_speed(owner.Live("Speed"), index)

    /// Sets how much of its pose is over the layers before it, from 0 to 1, as it starts. Outside
    /// that panics.
    @MainThread @PanicsAtCaller
    Public Method SetWeight(weight: Float)
        If !fbe_player_set_weight(owner.Live("SetWeight"), index, weight) Then owner.Failed("SetWeight")
    End Method

    /// How much of its pose is over the layers before it.
    @MainThread @PanicsAtCaller
    Public Method Weight(): Float => fbe_player_weight(owner.Live("Weight"), index)

    /// Keeps it to `bones` and the entities under them, as an upper body's layer keeps to its
    /// spine; with none, it moves all its Clips move. A bone that was freed panics.
    @MainThread @PanicsAtCaller
    Public Method SetMask(bones: Entity[])
        Local player = owner.Live("SetMask")
        Local handles = Buffer<UInt64>(bones.Count)
        For i = 0 Until bones.Count
            handles[i] = bones[i].Live("SetMask")
        End For
        Local done = False
        Unsafe
            done = fbe_player_set_mask(player, index, handles.Pointer(), bones.Count)
        End Unsafe
        If !done Then owner.Failed("SetMask")
    End Method
End Struct

// The Player on `entity`, if it has one, which asking for one would make it.
Package Function PlayerOn(entity: Entity): Player?
    Local slot = Slot(entity.Live("PlayerOn"))
    If slot >= players.Count Then Return Null
    Local kept = players[slot]
    Return kept != Null && RefEquals(kept.owner, entity) ? kept : Null
End Function

Extend Entity
    /// The Player that plays Clips on the entity and the entities under it, made the first time
    /// it's asked for.
    @MainThread @PanicsAtCaller
    Public Method Player(): Player
        Local slot = Slot(Live("Player"))
        If slot < players.Count
            Local kept = players[slot]
            If kept != Null && RefEquals(kept.owner, Self) Then Return kept
        End If
        Return PlayerFor(Self, slot)
    End Method
End Extend

Extend World
    // Moves on every Player on an entity of the World by `seconds`, as Update does, and lets go of
    // those whose entities were freed.
    @PanicsAtCaller
    Package Method Animate(seconds: Float64)
        If !fbe_player_advance(Live("Update"), seconds As Float32) Then Failed("Update")
        LetGoOfOrphans()
    End Method
End Extend

// A new Player for `entity`, kept as its slot's.
Function PlayerFor(entity: Entity, slot: Int): Player
    Local made = Player(entity)
    While players.Count <= slot
        players.Add(Null)
    End While
    players[slot] = made
    Local own = Slot(made.handle)
    While playersByHandle.Count <= own
        playersByHandle.Add(Null)
    End While
    playersByHandle[own] = made
    Return made
End Function

// Room for the handles C gives, for a frame's few.
Global handleRoom = Buffer<UInt64>(64)

// Lets go of the Players of entities that were freed, so what they kept goes with them.
Function LetGoOfOrphans()
    Local count = handleRoom.Count
    While count == handleRoom.Count
        Unsafe
            count = fbe_player_orphans(handleRoom.Pointer(), handleRoom.Count As Int32)
        End Unsafe
        For i = 0 Until count
            Local own = Slot(handleRoom[i])
            Local player = playersByHandle[own]
            If player == Null Then Continue
            playersByHandle[own] = Null
            Local kept = players[player.ownerSlot]
            If kept != Null && RefEquals(kept, player) Then players[player.ownerSlot] = Null
        End For
    End While
End Function

// Hands the events the Players reached to their handlers: every Player's taken first, so what a
// handler does to a Player changes nothing handed, but for stopping its handler.
Package Function HandEvents()
    Local room = handleRoom
    Local count = 0
    Unsafe
        count = fbe_player_evented(room.Pointer(), room.Count As Int32)
    End Unsafe
    If count == 0 Then Return
    If count > room.Count
        room = Buffer<UInt64>(count)
        Unsafe
            count = fbe_player_evented(room.Pointer(), room.Count As Int32)
        End Unsafe
    End If
    Local handing: Player[] = []
    Local taken: ClipEvent[][] = []
    For i = 0 Until count
        Local handle = room[i]
        Local slot = Slot(handle)
        Local player = slot < playersByHandle.Count ? playersByHandle[slot] : Null
        If player == Null || player.handle != handle
            fbe_player_clear_events(handle)
            Continue
        End If
        Local events = player.TakeEvents()
        If player.handler != Null
            handing.Add(player)
            taken.Add(events)
        End If
    End For
    For i = 0 Until handing.Count
        For event In taken[i]
            Local handler = handing[i].handler
            If handler == Null Then Break
            handler(event)
        End For
    End For
End Function
