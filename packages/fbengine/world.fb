// Worlds: the scenes entities live in. There's a main one, so a game with one scene never names
// it, and a game or an editor makes more, as a preview or a scene drawn into a texture.

Import std.core
Import std.ffi
Import std.math
Import "./c/fbe_scene"
Import "./camera"
Import "./entity"
Import "./environment"
Import "./light"
Import "./window"

/// A scene: a tree of entities, which are drawn, collide, and pick only with others in their
/// World. Entities made without a parent go into the current one, the main World at first.
Public Final Class World
    // One wrapper for each live World, by its handle's slot, so each handle gives the same World.
    Static Field worlds: World?[] = []
    Static Field mainWorld: World? = Null
    Static Field current: World? = Null

    Field handle: UInt64
    Field lighting: Environment? = Null

    /// A new World, with no entities.
    @MainThread Public New()
        handle = fbe_world_create()
        Keep(Self)
    End New

    Private New(handle: UInt64)
        Self.handle = handle
        Keep(Self)
    End New

    /// The World there always is, which is current until SetCurrent makes another one current.
    @MainThread Public Static Method Main(): World
        Local found = mainWorld
        If found != Null Then Return found
        Local made = World(fbe_world_main())
        mainWorld = made
        Return made
    End Method

    /// The World that entities made without a parent go into.
    @MainThread Public Static Method Current(): World => current ?? Main()

    /// Makes `world` the one entities made without a parent go into.
    @MainThread @PanicsAtCaller
    Public Static Method SetCurrent(world: World)
        world.Live("SetCurrent")
        current = world
    End Method

    /// Frees the World and every entity in it. The main World stays: freeing it panics, and Clear
    /// empties it. If it was current, the main World is current again.
    @MainThread @PanicsAtCaller
    Public Method Free()
        If !fbe_world_free(Live("Free")) Then Failed("Free")
        lighting = Null
        DropFreed()
        worlds[Slot(handle)] = Null
        handle = 0
        If current == Self Then current = Null
    End Method

    /// Whether the World was freed.
    @MainThread Public Method Freed(): Bool => handle == 0

    /// Frees every entity in the World.
    @MainThread @PanicsAtCaller
    Public Method Clear()
        If !fbe_world_clear(Live("Clear")) Then Failed("Clear")
        DropFreed()
    End Method

    /// How many entities are in the World, at every level.
    @MainThread @PanicsAtCaller
    Public Method EntityCount(): Int => fbe_world_entity_count(Live("EntityCount"))

    /// The entities at the top of the World, with no parent, in the order they came there.
    @MainThread @PanicsAtCaller
    Public Method Roots(): Entity[]
        Local world = Live("Roots")
        Return Handles(Function(out: Ptr<UInt64>, capacity: Int32): Int32
            Return fbe_world_roots(world, out, capacity)
        End Function)
    End Method

    /// The World's cameras, in the order they draw: lower orders first, and those of one order in
    /// the order they were made.
    @MainThread @PanicsAtCaller
    Public Method Cameras(): Camera[]
        Local world = Live("Cameras")
        Local found: Camera[] = []
        For entity In Handles(Function(out: Ptr<UInt64>, capacity: Int32): Int32
            Return fbe_world_cameras(world, out, capacity)
        End Function)
            found.Add(entity As Camera)
        End For
        Return found
    End Method

    /// The World's lights, hidden ones too, in the tree's order, depth first, each parent before
    /// its children.
    @MainThread @PanicsAtCaller
    Public Method Lights(): Light[]
        Local world = Live("Lights")
        Local found: Light[] = []
        For entity In Handles(Function(out: Ptr<UInt64>, capacity: Int32): Int32
            Return fbe_world_lights(world, out, capacity)
        End Function)
            found.Add(entity As Light)
        End For
        Return found
    End Method

    /// Sets the Environment the World's PBR materials are lit by, as well as its Lights and ambient
    /// light, which it holds, Null for none, as at first; its light times `intensity`, 0 or more, or
    /// it panics. One that's freed, or that stopping the GPU lost, lights nothing.
    @MainThread @PanicsAtCaller
    Public Method SetEnvironment(environment: Environment?, intensity: Float = 1.0)
        Local handle: UInt64 = environment != Null ? environment.Live("SetEnvironment") : 0
        If !fbe_world_set_environment(Live("SetEnvironment"), handle, intensity)
            Failed("SetEnvironment")
        End If
        lighting = environment
    End Method

    /// The Environment it's lit by, or Null.
    @MainThread @PanicsAtCaller
    Public Method LitBy(): Environment?
        Live("LitBy")
        Return lighting
    End Method

    /// What its Environment's light is times.
    @MainThread @PanicsAtCaller
    Public Method EnvironmentIntensity(): Float
        Return fbe_world_environment_intensity(Live("EnvironmentIntensity"))
    End Method

    /// Sets the World's ambient light, which lights everything a little, from everywhere:
    /// std.math's Color.Gray, sRGB's half gray, at first. Its alpha is left out.
    @MainThread @PanicsAtCaller
    Public Method SetAmbientLight(color: Color)
        If !fbe_world_set_ambient(Live("SetAmbientLight"), color.r, color.g, color.b)
            Failed("SetAmbientLight")
        End If
    End Method

    /// The World's ambient light, with an alpha of 1.
    @MainThread @PanicsAtCaller
    Public Method AmbientLight(): Color
        Local world = Live("AmbientLight")
        Local found = fbe_color_t(0, 0, 0, 0)
        Local done = False
        Unsafe
            done = fbe_world_ambient(world, AddressOf(found))
        End Unsafe
        If !done Then Failed("AmbientLight")
        Return ColorOf(found)
    End Method

    /// The first entity in the World with the name, depth first, each parent before its
    /// children, or Null.
    @MainThread @PanicsAtCaller
    Public Method Find(name: String): Entity? => EntityOf(fbe_world_find(Live("Find"), name))

    // A panic naming the call and the World, with what C said went wrong.
    @PanicsAtCaller
    Package Method Failed(call: String)
        Local which = handle == fbe_world_main() ? "the main World" : "a World"
        Panic("{call} on {which}: {LastError()}")
    End Method

    // The handle, or a panic naming the call for a World that was freed.
    @PanicsAtCaller
    Package Method Live(call: String): UInt64
        If handle == 0 Then Panic("{call} on a World that was freed")
        Return handle
    End Method

    // The World a handle is for, from its wrapper, made if there isn't one.
    Package Static Method Of(handle: UInt64): World
        Local slot = Slot(handle)
        If slot < worlds.Count
            Local kept = worlds[slot]
            If kept != Null && kept.handle == handle Then Return kept
        End If
        If handle == fbe_world_main() Then Return Main()
        Return World(handle)
    End Method

    Static Method Keep(world: World)
        Local slot = Slot(world.handle)
        While worlds.Count <= slot
            worlds.Add(Null)
        End While
        worlds[slot] = world
    End Method
End Class

/// The slot of a World's or entity's handle, its low 32 bits.
Package Function Slot(handle: UInt64): Int => (handle & 0xFFFFFFFF) As Int

/// The handles a C call writes, as their entities: `write` is given where to put them and how many
/// fit, and gives how many there are, so it's called again when there wasn't room.
Package Function Handles(write: Func(Ptr<UInt64>, Int32): Int32): Entity[]
    Local capacity = 16
    While True
        Local taken = Buffer<UInt64>(capacity)
        Local count = 0
        Unsafe
            count = write(taken.Pointer(), capacity As Int32)
        End Unsafe
        If count < 0 Then Panic("a list of entities: {LastError()}")
        If count <= capacity
            Local found: Entity[] = []
            For i = 0 Until count
                Local entity = EntityOf(taken[i])
                If entity == Null Then Panic("a list of entities had a stale one")
                found.Add(entity)
            End For
            Return found
        End If
        capacity = count
    End While
End Function

/// The World a handle is for.
Package Function WorldOf(handle: UInt64): World => World.Of(handle)

/// The World entities made without a parent go into.
Package Function CurrentWorld(): World => World.Current()
