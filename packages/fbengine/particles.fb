// Particles: what an emitter spawns, moved on the GPU by a formula from when each was born, so a
// million cost the CPU only those born that frame. And a sky behind what a World has that's opaque.

Import std.core
Import std.ffi
Import std.math
Import "./attributes"
Import "./c/fbe_scene"
Import "./entity"
Import "./light"
Import "./material"
Import "./texture"
Import "./world"

/// An entity that spawns particles along its forward axis, -Z. They're born as World.Update's steps
/// come, and at Burst; once born each goes by itself, in the world, however the emitter moves after.
/// Hiding or freeing the emitter takes what's alive from what's drawn at once. Those that blend aren't
/// sorted among themselves, they cast no shadows, and only ambient light lights them, as a sprite.
Public Final Class Particles Extends Entity
    /// A new Particles, holding `capacity` at once, 1 to 1048576, the last child of `parent`, or at
    /// the top of the current World when `parent` is Null. New, it spawns 32 a second, each living 1
    /// second, at speed 1, straight out, half-size 0.1, white and fading out.
    @MainThread @PanicsAtCaller
    Public New(capacity: Int = 1024, parent: Entity? = Null)
        Super.New(Create(parent, FBE_ENTITY_PARTICLES))
        SetCapacity(capacity)
    End New

    Package New(handle: UInt64)
        Super.New(handle)
    End New

    Override Package Method KindName(): String => "Particles"

    /// Sets how many it holds at once, 1 to 1048576, losing those it has; the oldest go first when
    /// more are born. Others panic.
    @Limits(1, 1048576)
    @MainThread @PanicsAtCaller
    Public Method SetCapacity(capacity: Int)
        If !fbe_particles_set_capacity(Live("SetCapacity"), capacity) Then Failed("SetCapacity")
    End Method

    /// How many it holds at once.
    @MainThread @PanicsAtCaller
    Public Method Capacity(): Int => fbe_particles_capacity(Live("Capacity"))

    /// Makes them draw in `material`, whose first layers are their textures, each particle's color
    /// over its life taken as vertex colors; or with Null, full-bright white, blending ALPHA. Its
    /// Blend AUTO is ALPHA here.
    @MainThread @PanicsAtCaller
    Public Method SetMaterial(material: Material?)
        Local drawn: UInt64 = material != Null ? material.Live("SetMaterial") : 0
        If !fbe_particles_set_material(Live("SetMaterial"), drawn) Then Failed("SetMaterial")
    End Method

    /// What they draw in, or Null.
    @MainThread @PanicsAtCaller
    Public Method Material(): Material? => MaterialOf(fbe_particles_material(Live("Material")))

    /// Sets how many are born a second, 0 or more, as World.Update's steps go by. Below 0 panics.
    @Limits(0)
    @MainThread @PanicsAtCaller
    Public Method SetRate(perSecond: Float)
        If !fbe_particles_set_rate(Live("SetRate"), perSecond) Then Failed("SetRate")
    End Method

    /// How many are born a second.
    @MainThread @PanicsAtCaller
    Public Method Rate(): Float => fbe_particles_rate(Live("Rate"))

    /// Sets how long each lives, chosen between these, in seconds, above 0, up to 512. Others panic.
    @MainThread @PanicsAtCaller
    Public Method SetLife(least: Float, most: Float)
        If !fbe_particles_set_life(Live("SetLife"), least, most) Then Failed("SetLife")
    End Method

    /// How long each lives, chosen between these: the least, then the most.
    @MainThread @PanicsAtCaller
    Public Method Life(): Vec2
        Local particles = Live("Life")
        Return Vec2(fbe_particles_life_least(particles), fbe_particles_life_most(particles))
    End Method

    /// Sets how they set off: a speed between these, out to `spread` radians off its forward axis,
    /// up to Pi for all around, and a spin up to this each way, in radians a second. Others panic.
    @MainThread @PanicsAtCaller
    Public Method SetMotion(leastSpeed: Float, mostSpeed: Float, spread: Float, spin: Float = 0)
        If !fbe_particles_set_motion(Live("SetMotion"), leastSpeed, mostSpeed, spread, spin)
            Failed("SetMotion")
        End If
    End Method

    /// The speeds they set off between: the least, then the most.
    @MainThread @PanicsAtCaller
    Public Method Speeds(): Vec2
        Local particles = Live("Speeds")
        Return Vec2(fbe_particles_speed_least(particles), fbe_particles_speed_most(particles))
    End Method

    /// How far off its forward axis they set off, in radians.
    @MainThread @PanicsAtCaller
    Public Method Spread(): Float => fbe_particles_spread(Live("Spread"))

    /// The most spin each way, in radians a second.
    @MainThread @PanicsAtCaller
    Public Method Spin(): Float => fbe_particles_spin(Live("Spin"))

    /// Sets what acts on them after: gravity in the world, in units a second a second, and drag, 0
    /// or more, of which 1 slows them to a little over a third in a second. Others panic.
    @MainThread @PanicsAtCaller
    Public Method SetForces(gravity: Vec3, drag: Float = 0)
        If !fbe_particles_set_forces(Live("SetForces"), gravity.x, gravity.y, gravity.z, drag)
            Failed("SetForces")
        End If
    End Method

    /// The gravity on them, in the world.
    @MainThread @PanicsAtCaller
    Public Method Gravity(): Vec3
        Local particles = Live("Gravity")
        Return Vec3(fbe_particles_gravity_x(particles), fbe_particles_gravity_y(particles),
                    fbe_particles_gravity_z(particles))
    End Method

    /// The drag on them.
    @MainThread @PanicsAtCaller
    Public Method Drag(): Float => fbe_particles_drag(Live("Drag"))

    /// Sets each one's half-size, from its birth to its death. Below 0 panics.
    @MainThread @PanicsAtCaller
    Public Method SetSizes(start: Float, finish: Float)
        If !fbe_particles_set_sizes(Live("SetSizes"), start, finish) Then Failed("SetSizes")
    End Method

    /// Each one's half-size: at its birth, then at its death.
    @MainThread @PanicsAtCaller
    Public Method Sizes(): Vec2
        Local particles = Live("Sizes")
        Return Vec2(fbe_particles_size_start(particles), fbe_particles_size_end(particles))
    End Method

    /// Sets each one's color and alpha, from its birth to its death. A color that isn't finite, or an
    /// alpha outside 0 to 1, panics.
    @MainThread @PanicsAtCaller
    Public Method SetColors(start: Color, finish: Color)
        Local first = fbe_color_t()
        first.r = start.r
        first.g = start.g
        first.b = start.b
        first.a = start.a
        Local last = fbe_color_t()
        last.r = finish.r
        last.g = finish.g
        last.b = finish.b
        last.a = finish.a
        Local done = False
        Unsafe
            done = fbe_particles_set_colors(Live("SetColors"), AddressOf(first), AddressOf(last))
        End Unsafe
        If !done Then Failed("SetColors")
    End Method

    /// Each one's color and alpha at its birth.
    @MainThread @PanicsAtCaller
    Public Method StartColor(): Color => ColorAt(False, "StartColor")

    /// Each one's color and alpha at its death.
    @MainThread @PanicsAtCaller
    Public Method EndColor(): Color => ColorAt(True, "EndColor")

    @PanicsAtCaller
    Method ColorAt(end: Bool, call: String): Color
        Local found = fbe_color_t()
        Local done = False
        Unsafe
            done = fbe_particles_color(Live(call), end, AddressOf(found))
        End Unsafe
        If !done Then Failed(call)
        Return Color(found.r, found.g, found.b, found.a)
    End Method

    /// Sets how far each's turned at its birth, up to `most` radians each way, 0 to Pi, 0 at first.
    /// Others panic.
    @MainThread @PanicsAtCaller
    Public Method SetRoll(most: Float)
        If !fbe_particles_set_roll(Live("SetRoll"), most) Then Failed("SetRoll")
    End Method

    /// How far each's turned at its birth, at most, each way: Roll is an Entity's own.
    @MainThread @PanicsAtCaller
    Public Method BirthRoll(): Float => fbe_particles_roll(Live("BirthRoll"))

    /// Sets what its random numbers follow from, so a run can be the same again.
    @MainThread @PanicsAtCaller
    Public Method SetSeed(seed: UInt32)
        If !fbe_particles_set_seed(Live("SetSeed"), seed) Then Failed("SetSeed")
    End Method

    /// Spawns `count` of them now, as many as it holds at most. Below 0 panics.
    @MainThread @PanicsAtCaller
    Public Method Burst(count: Int)
        If !fbe_particles_burst(Live("Burst"), count) Then Failed("Burst")
    End Method

    /// How many are alive.
    @MainThread @PanicsAtCaller
    Public Method Alive(): Int => fbe_particles_alive(Live("Alive"))

    /// Sets how far to each side of the emitter one may be born, on the emitter's own axes: a box
    /// of twice `half` about it, none at first. Below 0 panics.
    @Limits(0)
    @MainThread @PanicsAtCaller
    Public Method SetStartBox(half: Vec3)
        If !fbe_particles_set_start_box(Live("SetStartBox"), half.x, half.y, half.z)
            Failed("SetStartBox")
        End If
    End Method

    /// How far to each side of the emitter one may be born.
    @MainThread @PanicsAtCaller
    Public Method StartBox(): Vec3
        Local particles = Live("StartBox")
        Local box = fbe_vec3_t()
        Unsafe
            fbe_particles_start_box(particles, AddressOf(box))
        End Unsafe
        Return Vec3(box.x, box.y, box.z)
    End Method

    /// Sets a velocity added to each one's own, on the world's axes, chosen between `least` and
    /// `most` on each axis, in units a second; none at first. A `most` below its `least` panics.
    @MainThread @PanicsAtCaller
    Public Method SetVelocityBox(least: Vec3, most: Vec3)
        Local particles = Live("SetVelocityBox")
        Local low = fbe_vec3_t(least.x, least.y, least.z)
        Local high = fbe_vec3_t(most.x, most.y, most.z)
        Local set = False
        Unsafe
            set = fbe_particles_set_velocity_box(particles, AddressOf(low), AddressOf(high))
        End Unsafe
        If !set Then Failed("SetVelocityBox")
    End Method

    /// The least and the most of the velocity added to each one's own.
    @MainThread @PanicsAtCaller
    Public Method VelocityBox(): (Vec3, Vec3)
        Local particles = Live("VelocityBox")
        Local low = fbe_vec3_t()
        Local high = fbe_vec3_t()
        Unsafe
            fbe_particles_velocity_box(particles, AddressOf(low), AddressOf(high))
        End Unsafe
        Return (Vec3(low.x, low.y, low.z), Vec3(high.x, high.y, high.z))
    End Method

    /// Sets what each one's size is times, chosen at its birth between `least` and `most`, 0 or
    /// more; 1 at first. Others panic.
    @MainThread @PanicsAtCaller
    Public Method SetSizeRange(least: Float, most: Float)
        If !fbe_particles_set_size_range(Live("SetSizeRange"), least, most)
            Failed("SetSizeRange")
        End If
    End Method

    /// What each one's size is times: the least, then the most.
    @MainThread @PanicsAtCaller
    Public Method SizeRange(): Vec2
        Local found = Settings("SizeRange")
        Return Vec2(found.size_least, found.size_most)
    End Method

    /// Sets each one's half-width and half-height, as so many times its size; 1 and 1 at first, a
    /// square. Below 0 panics.
    @MainThread @PanicsAtCaller
    Public Method SetShape(width: Float, height: Float)
        If !fbe_particles_set_shape(Live("SetShape"), width, height) Then Failed("SetShape")
    End Method

    /// Each one's half-width and half-height, as so many times its size.
    @MainThread @PanicsAtCaller
    Public Method Shape(): Vec2
        Local found = Settings("Shape")
        Return Vec2(found.width, found.height)
    End Method

    /// Sets a step's length in seconds, 0 for none, as at first, which SetGrowth and SetFade go
    /// by: a game's tick, for what it would step a tick at a time. With `held`, they change only at
    /// each whole step of a particle's age, as stepping by hand does; without, they go smoothly
    /// between, and are the same at each whole step. Below 0 panics.
    @MainThread @PanicsAtCaller
    Public Method SetSteps(seconds: Float, held: Bool = False)
        If !fbe_particles_set_steps(Live("SetSteps"), seconds, held) Then Failed("SetSteps")
    End Method

    /// A step's length in seconds, 0 for none.
    @MainThread @PanicsAtCaller
    Public Method Step(): Float => Settings("Step").step

    /// Whether growth and fading wait for each whole step.
    @MainThread @PanicsAtCaller
    Public Method StepsHeld(): Bool => Settings("StepsHeld").held

    /// Sets what each step does to each one's half-width and half-height: `added` to each, then
    /// each times `multiplied`, above 0; 0 and 1 at first, for nothing. One shrunk to nothing draws
    /// nothing. Others panic.
    @MainThread @PanicsAtCaller
    Public Method SetGrowth(added: Float, multiplied: Float = 1)
        If !fbe_particles_set_growth(Live("SetGrowth"), added, multiplied) Then Failed("SetGrowth")
    End Method

    /// What each step adds to each one's half-width and half-height, then what it multiplies them
    /// by.
    @MainThread @PanicsAtCaller
    Public Method Growth(): Vec2
        Local found = Settings("Growth")
        Return Vec2(found.added, found.multiplied)
    End Method

    /// Sets what each step takes off each one's alpha, 0 or more, 0 at first, from what its colors
    /// have it. One that reaches none is gone then, before its life's end, and not counted alive.
    /// Below 0 panics.
    @Limits(0)
    @MainThread @PanicsAtCaller
    Public Method SetFade(aStep: Float)
        If !fbe_particles_set_fade(Live("SetFade"), aStep) Then Failed("SetFade")
    End Method

    /// What each step takes off each one's alpha.
    @MainThread @PanicsAtCaller
    Public Method Fade(): Float => Settings("Fade").fade

    /// Sets whether each is rolled the way it's moving in the view, its right along that, with
    /// its own roll and spin added; not at first.
    @MainThread @PanicsAtCaller
    Public Method SetRollAlong(along: Bool)
        If !fbe_particles_set_roll_along(Live("SetRollAlong"), along) Then Failed("SetRollAlong")
    End Method

    /// Whether each is rolled the way it's moving in the view.
    @MainThread @PanicsAtCaller
    Public Method RollAlong(): Bool => Settings("RollAlong").roll_along

    /// Sets bursts of `count`, as many as it holds at most, every `every` seconds from now, the
    /// first in the next step, for `lasts` seconds, 0 for as long as it's on, set off again `again`
    /// seconds after they were, 0 for never. 0 of them stops them. `every` is 0.001 or more, as
    /// `again` is unless it's 0; others panic.
    @MainThread @PanicsAtCaller
    Public Method SetBursts(count: Int, every: Float, lasts: Float = 0, again: Float = 0)
        If count < 0 || count > 2147483647 Then Panic("SetBursts on a Particles: {count} isn't a count")
        If !fbe_particles_set_bursts(Live("SetBursts"), count As Int32, every, lasts, again)
            Failed("SetBursts")
        End If
    End Method

    /// Whether its bursts are set off and have more to come.
    @MainThread @PanicsAtCaller
    Public Method Bursting(): Bool => Settings("Bursting").bursting

    /// Its live particles as they are now, by the formula they're drawn by, with no GPU, as a
    /// server has none, in no order that's kept. It keeps each one's birth from the first call on,
    /// 48 bytes for each it holds, so the first call gives none, and those born after are read.
    @MainThread @PanicsAtCaller
    Public Method Read(): Particle[]
        Local particles = Live("Read")
        Local count = fbe_particles_read(particles, Null, 0)
        Local all: Particle[] = []
        If count <= 0 Then Return all
        Local read = Buffer<fbe_particle_t>(count As Int64)
        Unsafe
            count = fbe_particles_read(particles, read.Pointer(), count)
        End Unsafe
        For at = 0 Until count
            Local one = read[at]
            all.Add(Particle(Vec3(one.position.x, one.position.y, one.position.z), one.half_width,
                             one.half_height, one.alpha, one.age))
        End For
        Return all
    End Method

    Method Settings(call: String): fbe_particles_settings_t
        Local particles = Live(call)
        Local found = fbe_particles_settings_t()
        Unsafe
            fbe_particles_settings(particles, AddressOf(found))
        End Unsafe
        Return found
    End Method
End Class

/// A particle as Particles.Read has it: where it is in the world, its half-width and half-height,
/// its alpha, and its age in seconds.
Public Struct Particle
    Public Field Position: Vec3
    Public Field HalfWidth: Float
    Public Field HalfHeight: Float
    Public Field Alpha: Float
    Public Field Age: Float

    Public New(position: Vec3, halfWidth: Float, halfHeight: Float, alpha: Float, age: Float)
        Position = position
        HalfWidth = halfWidth
        HalfHeight = halfHeight
        Alpha = alpha
        Age = age
    End New
End Struct

Extend World
    /// Sets the World's sky to the atmosphere, one scattering of the sun's light, marched per pixel,
    /// behind what's opaque, with what's in an order below 0 behind it; the sun where `sun`, a
    /// directional Light of this World, shines from, or straight up for Null. Freed, the sky stays as
    /// it last was. `brightness` scales what it adds up to. Others panic.
    @MainThread @PanicsAtCaller
    Public Method SetAtmosphere(sun: Light? = Null, brightness: Float = 20)
        Local light: UInt64 = sun != Null ? sun.Live("SetAtmosphere") : 0
        If !fbe_world_set_sky_atmosphere(Live("SetAtmosphere"), light, brightness)
            Failed("SetAtmosphere")
        End If
    End Method

    /// Sets the World's sky to an equirectangular texture, its top row straight up, its middle
    /// straight ahead along -Z, behind what's opaque, wrapping around the world however it's set,
    /// and stopping at its top and bottom. `brightness` scales it, and below 0 panics.
    @MainThread @PanicsAtCaller
    Public Method SetSkyTexture(texture: Texture, brightness: Float = 1)
        If !fbe_world_set_sky_texture(Live("SetSkyTexture"), texture.Live("SetSkyTexture"),
                                      brightness)
            Failed("SetSkyTexture")
        End If
    End Method

    /// Leaves the World with no sky: behind what's opaque is each camera's clear color, as at first.
    @MainThread @PanicsAtCaller
    Public Method ClearSky()
        If !fbe_world_clear_sky(Live("ClearSky")) Then Failed("ClearSky")
    End Method
End Extend
