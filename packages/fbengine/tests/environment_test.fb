// Environments through the FB API, on the GPU ctest's tests use; a machine with no Vulkan sets
// FBENGINE_NO_GPU to 1 and skips them.

Import std.core
Import std.image
Import std.io
Import std.math
Import std.os
Import std.test
Import fbengine

Function NoGpu(): Bool => Env.Get("FBENGINE_NO_GPU") == "1"

@Test
Function AnEnvironmentIsBakedAndFreed() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local sky = Try Texture(4, 2, TextureFormat.RGBA16F, False)
    Local before = Environment.Count()
    Local baked = Try Environment.Bake(sky, 16, 4)
    Expect(Environment.Count() == before + 1)
    Expect(baked.Levels() == 2)
    // One the game lets go of is freed, as this one is at the end of its line.
    Expect((Try Environment.Bake(sky, 32, 4)).Levels() == 3)
    Expect(Environment.Count() == before + 1)
    baked.Free()
    Expect(Environment.Count() == before)
End Function

// An HDR image's light is a texture's as half floats, as near as they hold it, which bakes.
@Test
Function AnHdrImageIsATextureThatBakes() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local image = HdrImage(4, 2)
    image[0, 0] = Color(4.0, 70000.0, -1.0, 1.0)
    Local sky = Try Texture.FromHdr(image, False)
    Expect(sky.Format() == TextureFormat.RGBA16F)
    Expect(sky.Levels() == 1)
    Local bytes = sky.ReadPixels()
    // 4 is 0x4400, 65504 0x7BFF, and 1 0x3C00, little end first.
    Expect(bytes[0] == 0 && bytes[1] == 0x44)
    Expect(bytes[2] == 0xFF && bytes[3] == 0x7B)
    Expect(bytes[4] == 0 && bytes[5] == 0)
    Expect(bytes[6] == 0 && bytes[7] == 0x3C)
    Expect((Try Environment.Bake(sky, 16, 4)).Levels() == 2)
End Function

// The doc's example: Load takes a file of Radiance's HDR as HDR, and bakes it.
@Test
Function AnHdrFileLoadsAsLight() Throws GraphicsError, IOError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local folder = Try TempDir()
    Local image = HdrImage(8, 4)
    image[0, 0] = Color(4.0, 4.0, 4.0, 1.0)
    Local path = folder.Path / "SKY.HDR"
    Try File.WriteBytes(path, Hdr.Encode(image))
    Local sky = Try Texture.Load(path)
    Expect(sky.Format() == TextureFormat.RGBA16F)
    Expect(sky.Levels() == 4)
    Local bytes = sky.ReadPixels()
    Expect(bytes[0] == 0 && bytes[1] == 0x44)
    Expect((Try Environment.Bake(sky, 16, 4)).Levels() == 2)
End Function

// A World holds what it's lit by.
@Test
Function AWorldIsLitByAnEnvironment() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local world = World()
    Expect(world.LitBy() == Null)
    Local sky = Try Texture(4, 2, TextureFormat.RGBA16F, False)
    Local baked = Try Environment.Bake(sky, 16, 4)
    world.SetEnvironment(baked, 0.5)
    Expect(world.LitBy() == baked)
    Expect(world.EnvironmentIntensity() == 0.5)
    world.SetEnvironment(Null)
    Expect(world.LitBy() == Null)
    world.Free()
End Function

// A surface's tangents, one for each vertex.
@Test
Function ASurfaceHasTangents()
    Local geometry = Geometry.Cube()
    Local surface = geometry.Surface(0)
    Expect(surface.Tangents().Count == 0)
    Local tangents: Vec4[] = []
    For i = 1 To surface.VertexCount()
        tangents.Add(Vec4(1.0, 0.0, 0.0, -1.0))
    End For
    surface.SetTangents(tangents)
    Expect(surface.Tangents() == tangents)
    surface.SetTangents([])
    Expect(surface.Tangents().Count == 0)
End Function

// A normal map from a file holds numbers, as it's loaded to; and it's color at first.
@Test
Function AFileLoadsAsColorOrAsNumbers() Throws GraphicsError, IOError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local folder = Try TempDir()
    Local image = Image.FromBytes(1, 1, [128, 128, 255, 255])
    Local path = folder.Path / "flat.png"
    Try File.WriteBytes(path, Png.Encode(image))
    Local color = Try Texture.Load(path, False)
    Expect(color.Format() == TextureFormat.RGBA8)
    Local numbers = Try Texture.Load(path, False, TextureFormat.RGBA8_LINEAR)
    Expect(numbers.Format() == TextureFormat.RGBA8_LINEAR)
    Expect(numbers.ReadPixels()[0] == 128)
    Local material = Material()
    material.SetMap(MaterialMap.NORMAL, numbers)
    Expect(material.Map(MaterialMap.NORMAL) == numbers)
    Local made = Try Texture.FromImage(image, False, TextureFormat.RGBA8_LINEAR)
    Expect(made.Format() == TextureFormat.RGBA8_LINEAR)
End Function
