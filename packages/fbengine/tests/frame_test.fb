// Flip, the frame's timing, and what the OS's events say of the window, offscreen.

Import std.core
Import std.test
Import std.time
Import fbengine

Global ticks = 0

Async Function CountTicks(times: Int)
    For i = 1 To times
        Await NextTick()
        ticks += 1
    End For
End Function

@Test
Function FlipSaysWhetherItAskedToWait() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(320, 200)
    Defer EndGraphics()
    Flip(False)
    Expect(!Frame.Vsync())
    Flip()
    Expect(Frame.Vsync())
    Flip(False)
    Expect(!Frame.Vsync())
End Function

// E1's done-when, in part: the coroutines waiting for the next tick resume once a frame.
@Test
Function CoroutinesResumeOncePerFlip() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(320, 200)
    Defer EndGraphics()
    ticks = 0
    CountTicks(3)
    Expect(ticks == 0)
    Flip()
    Expect(ticks == 1)
    Flip()
    Flip()
    Expect(ticks == 3)
    Flip()
    Expect(ticks == 3)
End Function

@Test
Function FlipCountsFramesWithoutAWindow()
    Local before = Frame.Count()
    Flip()
    Flip(False)
    Expect(Frame.Count() == before + 2)
End Function

@Test
Function TheLimitSpacesFramesOutAndCapsTheRate()
    Frame.SetLimit(50)
    Defer Frame.SetLimit(0)
    Expect(Frame.Limit() == 50)
    Flip()
    Flip()
    // 50 a second is 20 ms apart; a frame can come later, never sooner.
    Expect(Frame.Delta() >= 0.0195)
    Frame.SetLimit(200)
    // The rate's half second can start before the limit, with the tests before's fast frames, so
    // the second one after it, all at the limit, is the one read.
    For i = 1 To 250
        Flip()
    End For
    Expect(Frame.Rate() > 0.0)
    Expect(Frame.Rate() <= 205.0)
End Function

// A fixed delta is every frame's, however long the frame took, and once it's taken away, the
// clock's again.
@Test
Function AFixedDeltaIsEveryFramesUntilItsTakenAway()
    Local fixed: Float64 = 1.0 / 32.0
    Frame.SetFixedDelta(fixed)
    Defer Frame.SetFixedDelta(0)
    Expect(Frame.FixedDelta() == fixed)
    For frame = 1 To 6
        // Longer than it, then far shorter: neither shows.
        If frame % 2 == 0 Then Sleep(40.Milliseconds)
        Flip(False)
        Expect(Frame.Delta() == fixed, "frame {frame}: {Frame.Delta()}")
    End For
    Frame.SetFixedDelta(0)
    Expect(Frame.FixedDelta() == 0.0)
    Sleep(5.Milliseconds)
    Flip(False)
    Expect(Frame.Delta() >= 0.0 && Frame.Delta() != fixed, "the clock's {Frame.Delta()}")
End Function

@Test
Function TheWindowsCloseButtonStaysPressedUntilItCloses() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(320, 200)
    Expect(!Window.Closed())
    Try Simulate.CloseWindow()
    // Nothing's read until the next Flip.
    Expect(!Window.Closed())
    Flip()
    Expect(Window.Closed())
    Flip()
    Expect(Window.Closed())
    EndGraphics()
    Expect(!Window.Closed())
    Try Graphics(320, 200)
    Defer EndGraphics()
    Expect(!Window.Closed())
End Function

@Test
Function FocusAndMinimizedFollowTheOSsEvents() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(320, 200)
    Defer EndGraphics()
    Try Simulate.FocusWindow()
    Flip()
    Expect(Window.Focused())
    Try Simulate.BlurWindow()
    Try Simulate.MinimizeWindow()
    Flip()
    Expect(!Window.Focused())
    Expect(Window.Minimized())
    Try Simulate.RestoreWindow()
    Flip()
    Expect(!Window.Minimized())
End Function

@Test
Function SimulatingNeedsAWindow()
    Window.SetHeadless(True)
    Expect(ExpectThrows<GraphicsError>(Simulate.CloseWindow()) != Null)
    Expect(!Window.Closed())
End Function

Global said = ""

@Test
Function HooksRunAtEveryFlipInOrderUntilRemoved()
    said = ""
    Local first = Frame.OnFlip(SayA)
    Local second = Frame.OnFlip(SayB)
    Flip()
    Expect(said == "ab")
    Frame.RemoveOnFlip(first)
    Flip()
    Expect(said == "abb")
    Frame.RemoveOnFlip(second)
    // Removing one that's gone is nothing.
    Frame.RemoveOnFlip(second)
    Flip()
    Expect(said == "abb")
End Function

// Late hooks run after every other, in the order they were added, wherever they were added.
@Test
Function LateHooksRunAfterTheOthers()
    said = ""
    Local hooks = [Frame.OnFlip(SayA, late: True), Frame.OnFlip(SayB), Frame.OnFlip(SayH, True),
                   Frame.OnFlip(SayC)]
    Flip()
    Expect(said == "bcah")
    For hook In hooks
        Frame.RemoveOnFlip(hook)
    End For
End Function

// A hook runs before the coroutines waiting for the tick, so they see what it did that frame.
@Test
Function HooksRunBeforeCoroutinesResume()
    said = ""
    Local hook = Frame.OnFlip(SayH)
    Defer Frame.RemoveOnFlip(hook)
    SayAfterTick()
    Flip()
    Expect(said == "hc")
End Function

Async Function SayAfterTick()
    Await NextTick()
    said += "c"
End Function

Function SayA()
    said += "a"
End Function

Function SayB()
    said += "b"
End Function

Function SayH()
    said += "h"
End Function

Function SayC()
    said += "c"
End Function
