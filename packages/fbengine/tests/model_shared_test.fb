// Models sharing the Textures of images that are files of their own: one Texture of a file for
// every Model naming it, by what's in it and how it's read, on the GPU ctest's tests use; a
// machine with no Vulkan sets FBENGINE_NO_GPU to 1 and skips them.

Import std.collections
Import std.core
Import std.image.image
Import std.image.png
Import std.io
Import std.math
Import std.os
Import std.test
Import std.text
Import std.time
Import fbengine
Import "./gltfs"

Function NoSharedGpu(): Bool => Env.Get("FBENGINE_NO_GPU") == "1"

// A PNG of a color.
Function Colored(color: Color32): UInt8[]
    Local image = Image(2, 2)
    image.Fill(color)
    Return Png.Encode(image)
End Function

// A glTF of a triangle whose material reads the image at `uri` for `map`, its base color or its
// normals, sampled as `sampler` says, a glTF sampler's members.
Function Reading(uri: String, sampler: String = "", map: String = "base"): UInt8[]
    Local read = "\"normalTexture\":{{\"index\":0}}"
    If map == "base"
        read = "\"pbrMetallicRoughness\":{{\"baseColorTexture\":{{\"index\":0}}}}"
    End If
    Local file = Gltf(1, "\"images\":[{{\"uri\":\"{uri}\"}}],\"samplers\":[{{{sampler}}}]," +
                      "\"textures\":[{{\"source\":0,\"sampler\":0}}],\"materials\":[{{{read}}}]," +
                      "\"nodes\":[{{\"mesh\":0}}],\"scenes\":[{{\"nodes\":[0]}}]")
    // Its triangle's of that material.
    Return String.FromUtf8(file)?.Replace("\"indices\":3}}",
                                          "\"indices\":3,\"material\":0}}")?.Bytes ?? []
End Function

// Two models naming one image file make one Texture, which goes with the last of them.
@Test
Function TwoModelsNamingAnImageFileShareItsTexture() Throws IOError
    If NoSharedGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Assets.MountFiles("res://shared-two", {"a.gltf": Reading("wall.png"),
                                           "b.gltf": Reading("wall.png"),
                                           "wall.png": Colored(Color32(255, 0, 0, 255))})
    Defer Assets.Unmount("res://shared-two")
    Local before = Texture.Count()
    Local first = Try Assets.Load<Model>("res://shared-two/a.gltf")
    Expect(Texture.Count() == before + 1)
    Local second = Try Assets.Load<Model>("res://shared-two/b.gltf")
    Expect(Texture.Count() == before + 1)
    Expect(first.Textures()[0]?.Path() == "res://shared-two/wall.png")
    Expect(second.Textures()[0]?.Path() == "res://shared-two/wall.png")
    // Freeing one keeps the other's, which still reads as it did.
    first.Free()
    Expect(Texture.Count() == before + 1)
    Local kept = second.Materials()[0].Texture(0)
    Expect(kept != Null && !kept.Freed())
    If kept != Null && !kept.Freed() Then Expect(kept.ReadPixel(0, 0) == Color32(255, 0, 0, 255))
    second.Free()
    Expect(Texture.Count() == before)
    // And one made after that is made anew.
    Local third = Try Assets.Load<Model>("res://shared-two/a.gltf")
    Expect(Texture.Count() == before + 1)
    Expect(third.Materials()[0].Texture(0)?.ReadPixel(0, 0) == Color32(255, 0, 0, 255))
    third.Free()
    Expect(Texture.Count() == before)
End Function

// Read with another sampling, or in another color space, a file's another Texture; read the same
// way again, the same one.
@Test
Function AnotherSamplingOrColorSpaceIsAnotherTexture() Throws IOError
    If NoSharedGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Assets.MountFiles("res://shared-ways",
                      {"plain.gltf": Reading("wall.png"),
                       "again.gltf": Reading("wall.png"),
                       "nearest.gltf": Reading("wall.png", "\"magFilter\":9728"),
                       "clamped.gltf": Reading("wall.png", "\"wrapS\":33071"),
                       "normal.gltf": Reading("wall.png", "", "normal"),
                       "wall.png": Colored(Color32(128, 128, 255, 255))})
    Defer Assets.Unmount("res://shared-ways")
    Local before = Texture.Count()
    Local models: Model[] = []
    For name In ["plain", "nearest", "clamped", "normal"]
        models.Add(Try Assets.Load<Model>("res://shared-ways/{name}.gltf"))
        Expect(Texture.Count() == before + models.Count)
    End For
    models.Add(Try Assets.Load<Model>("res://shared-ways/again.gltf"))
    Expect(Texture.Count() == before + 4)
    Expect(models[1].Materials()[0].Texture(0)?.Filter() == TextureFilter.NEAREST)
    Expect(models[0].Materials()[0].Texture(0)?.Filter() == TextureFilter.LINEAR)
    Expect(models[2].Materials()[0].Texture(0)?.WrapAcross() == TextureWrap.CLAMP)
    Local color = models[0].Textures()[0]
    Local normals = models[3].Textures()[0]
    Expect(color != Null && normals != Null)
    If color != Null && normals != Null
        Expect(color.VulkanFormat() != normals.VulkanFormat())
    End If
    For model In models
        model.Free()
    End For
    Expect(Texture.Count() == before)
End Function

// An image inside a model's file is that model's alone.
@Test
Function AnImageInsideAModelsFileIsItsOwn() Throws IOError
    If NoSharedGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local file = Reading(PngUri(Color32(0, 255, 0, 255)))
    Assets.MountFiles("res://shared-inside", {"a.gltf": file, "b.gltf": file})
    Defer Assets.Unmount("res://shared-inside")
    Local before = Texture.Count()
    Local first = Try Assets.Load<Model>("res://shared-inside/a.gltf")
    Local second = Try Assets.Load<Model>("res://shared-inside/b.gltf")
    Expect(Texture.Count() == before + 2)
    Expect(first.Textures()[0]?.Path() == "res://shared-inside/a.gltf#0")
    Expect(second.Textures()[0]?.Path() == "res://shared-inside/b.gltf#0")
    first.Free()
    second.Free()
    Expect(Texture.Count() == before)
End Function

// A pack of 2,000 models naming 10 image files makes 10 Textures, and freeing them all frees those.
@Test
Function ManyModelsOfTenFilesMakeTenTextures() Throws IOError
    If NoSharedGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local files = Map<String, UInt8[]>()
    For at = 0 Until 10
        files["t{at}.png"] = Colored(Color32((at * 20) As UInt8, 0, 0, 255))
    End For
    For at = 0 Until 2000
        Local which = at % 10
        files["m{at}.gltf"] = Reading("t{which}.png")
    End For
    Assets.MountFiles("res://shared-many", files)
    Defer Assets.Unmount("res://shared-many")
    Local before = Texture.Count()
    Local models: Model[] = []
    For at = 0 Until 2000
        models.Add(Try Assets.Load<Model>("res://shared-many/m{at}.gltf"))
    End For
    Expect(Texture.Count() == before + 10)
    Expect(models[1999].Materials()[0].Texture(0)?.ReadPixel(0, 0) == Color32(180, 0, 0, 255))
    For model In models
        model.Free()
    End For
    Expect(Texture.Count() == before)
End Function

// An image file that's changed reaches every model sharing it, as one Texture still.
@Test
Function AChangedImageFileReachesEveryModelSharingIt() Throws IOError
    If NoSharedGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local folder = Try TempDir()
    Defer Try? folder.Close()
    Try File.WriteBytes(folder.Path / "a.gltf", Reading("wall.png"))
    Try File.WriteBytes(folder.Path / "b.gltf", Reading("wall.png"))
    Try File.WriteBytes(folder.Path / "wall.png", Colored(Color32(255, 0, 0, 255)))
    Assets.MountFolder("res://shared-reload", folder.Path)
    Defer Assets.Unmount("res://shared-reload")
    Local before = Texture.Count()
    Local first = Try Assets.Load<Model>("res://shared-reload/a.gltf")
    Local second = Try Assets.Load<Model>("res://shared-reload/b.gltf")
    Defer first.Free()
    Defer second.Free()
    Local world = World()
    Defer world.Free()
    Local spawned = Try first.Spawn()
    Local also = Try second.Spawn()
    Expect(Texture.Count() == before + 1)
    Assets.Reloaded()
    Try File.WriteBytes(folder.Path / "wall.png", Colored(Color32(0, 255, 0, 255)))
    Try Assets.Reload("res://shared-reload/wall.png")
    Local done = 0
    FlipUntil(Function(): Bool
        done += Assets.Reloaded().Count
        Return done >= 2
    End Function)
    Expect(done == 2)
    Flip()
    Flip()
    Expect(Texture.Count() == before + 1)
    Expect(first.Materials()[0].Texture(0)?.ReadPixel(0, 0) == Color32(0, 255, 0, 255))
    Expect(second.Materials()[0].Texture(0)?.ReadPixel(0, 0) == Color32(0, 255, 0, 255))
    Expect(!spawned.Freed() && !also.Freed())
End Function

// What two models of `files`, a.gltf and b.gltf, look like, side by side, unlit, and how many
// Textures they made.
Function Drawn(at: String, files: Map<String, UInt8[]>): (Image, Int) Throws IOError, GraphicsError
    Assets.MountFiles(at, files)
    Defer Assets.Unmount(at)
    Local world = World()
    Defer world.Free()
    World.SetCurrent(world)
    Local before = Texture.Count()
    Local first = Try Assets.Load<Model>("{at}/a.gltf")
    Defer first.Free()
    Local second = Try Assets.Load<Model>("{at}/b.gltf")
    Defer second.Free()
    Local made = Texture.Count() - before
    For model In [first, second]
        Local paint = model.Materials()[0]
        paint.SetColor(Color(1, 1, 1))
        paint.SetAlphaCutoff(0)
        paint.SetShading(Shading.UNLIT)
    End For
    (Try first.Spawn()).SetPosition(Vec3(-2, -1, -8))
    (Try second.Spawn()).SetPosition(Vec3(0.5, -1, -8))
    Local target = Try Texture.Target(64, 64, TextureFormat.RGBA8, 1, True)
    Defer target.Free()
    Local camera = Camera()
    camera.SetRenderTarget(target)
    camera.SetClearColor(Color(0, 0, 1))
    camera.Render()
    Return (target.ToImage(), made As Int)
End Function

// Two models sharing a Texture draw as two with a Texture each of the same image do, to the pixel.
@Test
Function ModelsSharingATextureDrawAsTheyDidWithTheirOwn() Throws IOError, GraphicsError
    If NoSharedGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local red = Color32(255, 0, 0, 255)
    Local shared, one = Try Drawn("res://shared-drawn", {"a.gltf": Reading("wall.png"),
                                                         "b.gltf": Reading("wall.png"),
                                                         "wall.png": Colored(red)})
    Local own, two = Try Drawn("res://shared-own", {"a.gltf": Reading(PngUri(red)),
                                                    "b.gltf": Reading(PngUri(red))})
    Expect(one == 1)
    Expect(two == 2)
    Local same = True
    Local left = 0
    Local right = 0
    For y = 0 Until 64
        For x = 0 Until 64
            If shared[x, y] != own[x, y] Then same = False
            If shared[x, y] == red && x < 32 Then left += 1
            If shared[x, y] == red && x >= 32 Then right += 1
        End For
    End For
    Expect(same)
    // Each of the two is there, in the image's red.
    Expect(left > 20 && right > 20)
End Function

// A glTF of a triangle whose material's base color is wall.png, read nearest, and whose normals
// are bump.png's.
Function Roomed(): UInt8[]
    Local file = Gltf(1, "\"images\":[{{\"uri\":\"wall.png\"}},{{\"uri\":\"bump.png\"}}]," +
                      "\"samplers\":[{{\"magFilter\":9728}}]," +
                      "\"textures\":[{{\"source\":0,\"sampler\":0}},{{\"source\":1}}]," +
                      "\"materials\":[{{\"pbrMetallicRoughness\":{{\"baseColorTexture\":" +
                      "{{\"index\":0}}}},\"normalTexture\":{{\"index\":1}}}}]," +
                      "\"nodes\":[{{\"mesh\":0}}],\"scenes\":[{{\"nodes\":[0]}}]")
    Return String.FromUtf8(file)?.Replace("\"indices\":3}}",
                                          "\"indices\":3,\"material\":0}}")?.Bytes ?? []
End Function

// What the current World looks like, lit from the camera's side.
Function Lit(): Image Throws GraphicsError
    Local target = Try Texture.Target(64, 64, TextureFormat.RGBA8, 1, True)
    Defer target.Free()
    Local camera = Camera()
    Defer camera.Free()
    camera.SetRenderTarget(target)
    camera.SetClearColor(Color(0, 0, 1))
    Local light = Light(LightType.POINT)
    Defer light.Free()
    light.SetPosition(Vec3(1, 2, 0))
    light.SetRange(40)
    camera.Render()
    Return target.ToImage()
End Function

// A scene that names a model's image files' Textures says how each is read, and reads them back
// so: the same color space and sampling, the same picture, and the same Textures the model has.
@Test
Function ASceneKeepsHowAnImageFilesTextureIsRead() Throws IOError, GraphicsError
    If NoSharedGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local bump = Image(2, 2)
    bump.Fill(Color32(128, 128, 255, 255))
    bump[0, 0] = Color32(200, 128, 200, 255)
    Assets.MountFiles("res://shared-scene", {"room.gltf": Roomed(),
                                             "wall.png": Colored(Color32(255, 128, 0, 255)),
                                             "bump.png": Png.Encode(bump)})
    Defer Assets.Unmount("res://shared-scene")
    Local world = World()
    Defer world.Free()
    World.SetCurrent(world)
    Local before = Texture.Count()
    Local model = Try Assets.Load<Model>("res://shared-scene/room.gltf")
    Defer model.Free()
    Expect(Texture.Count() == before + 2)
    // A material of the game's, reading the model's Textures, on a mesh of its own.
    Local paint = Material()
    paint.SetTexture(0, model.Textures()[0])
    paint.SetMap(MaterialMap.NORMAL, model.Textures()[1])
    Local mesh = Mesh(Geometry.Cube())
    mesh.SetMaterial(paint)
    mesh.SetPosition(Vec3(-1, -1, -6))
    mesh.SetRotation(Quat.FromEuler(0.4, 0.6, 0.0))
    Local text = Try Scene.Text([mesh])
    Expect(text.Contains("texture = \"res://shared-scene/wall.png\"\nfilter = \"NEAREST\"\n"))
    Expect(text.Contains("texture = \"res://shared-scene/bump.png\"\nlinear = true\n"))
    Local first = Try Lit()
    mesh.Free()
    Local roots = Try Scene.FromText(text)
    Expect(roots.Count == 1)
    // Each is the model's, still.
    Expect(Texture.Count() == before + 2)
    Local read = (roots[0] As Mesh).Material()
    Expect(read != Null)
    If read != Null
        Local color = read.Texture(0)
        Local normals = read.Map(MaterialMap.NORMAL)
        Expect(color != Null && normals != Null)
        If color != Null && normals != Null
            Expect(color.Filter() == TextureFilter.NEAREST)
            Expect(color.WrapAcross() == TextureWrap.REPEAT &&
                   color.WrapDown() == TextureWrap.REPEAT)
            Expect(color.Format() == TextureFormat.RGBA8)
            Expect(normals.Format() == TextureFormat.RGBA8_LINEAR)
            Expect(normals.Filter() == TextureFilter.LINEAR)
            Expect(RefEquals(color, model.Textures()[0]))
            Expect(RefEquals(normals, model.Textures()[1]))
        End If
    End If
    Local second = Try Lit()
    Local same = True
    Local drawn = 0
    For y = 0 Until 64
        For x = 0 Until 64
            If first[x, y] != second[x, y] Then same = False
            If first[x, y] != Color32(0, 0, 255, 255) Then drawn += 1
        End For
    End For
    Expect(same)
    Expect(drawn > 20)
    // And it says the same again.
    Expect((Try Scene.Text(roots)) == text)
End Function

// A scene written before, which says a texture's file and no more, reads as it did: the file's
// Texture as Assets loads it, a color, LINEAR and REPEAT, whatever a model's made of it.
@Test
Function ASceneThatSaysOnlyATexturesFileReadsAsItDid() Throws IOError
    If NoSharedGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Assets.MountFiles("res://shared-old", {"room.gltf": Roomed(),
                                           "wall.png": Colored(Color32(255, 128, 0, 255)),
                                           "bump.png": Colored(Color32(128, 128, 255, 255))})
    Defer Assets.Unmount("res://shared-old")
    Local world = World()
    Defer world.Free()
    World.SetCurrent(world)
    Local model = Try Assets.Load<Model>("res://shared-old/room.gltf")
    Defer model.Free()
    Local before = Texture.Count()
    Local text = "format = 1\n[[material]]\nid = \"m\"\n[[material.layers]]\nlayer = 0\n" +
                 "texture = \"res://shared-old/wall.png\"\n[[entity]]\npath = \"wall\"\n" +
                 "kind = \"MESH\"\ngeometry = \"builtin:cube\"\nmaterial = \"m\"\n"
    Local roots = Try Scene.FromText(text)
    Local read = (roots[0] As Mesh).Material()?.Texture(0)
    Expect(read != Null)
    If read != Null
        Expect(read.Filter() == TextureFilter.LINEAR)
        Expect(read.Format() == TextureFormat.RGBA8)
        Expect(read.Path() == "res://shared-old/wall.png")
        Expect(!RefEquals(read, model.Textures()[0]))
    End If
    Expect(Texture.Count() == before + 1)
    Expect((Try Scene.Text(roots)).Contains("texture = \"res://shared-old/wall.png\"\nblend = "))
End Function

// A shared Texture held once more and let go of once is still the one the next model shares: it's
// forgotten when the last hold goes, not at each.
@Test
Function ASharedTextureLetGoOfOnceIsStillShared() Throws IOError
    If NoSharedGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Assets.MountFiles("res://shared-held", {"a.gltf": Reading("wall.png"),
                                            "b.gltf": Reading("wall.png"),
                                            "wall.png": Colored(Color32(255, 0, 0, 255))})
    Defer Assets.Unmount("res://shared-held")
    Local before = Texture.Count()
    Local first = Try Assets.Load<Model>("res://shared-held/a.gltf")
    Local shared = first.Textures()[0]
    Expect(shared != Null)
    // A material of the game's holds it, and lets go.
    Local paint = Material()
    paint.SetTexture(0, shared)
    paint.Free()
    Local second = Try Assets.Load<Model>("res://shared-held/b.gltf")
    Expect(Texture.Count() == before + 1)
    Expect(RefEquals(second.Textures()[0], shared))
    // And one that outlives its models is still shared, until it goes.
    Local keeping = Material()
    keeping.SetTexture(0, shared)
    first.Free()
    second.Free()
    Expect(Texture.Count() == before + 1)
    Local third = Try Assets.Load<Model>("res://shared-held/a.gltf")
    Expect(Texture.Count() == before + 1)
    Expect(keeping.Texture(0)?.Path() == third.Textures()[0]?.Path())
    third.Free()
    keeping.Free()
    Expect(Texture.Count() == before)
End Function
