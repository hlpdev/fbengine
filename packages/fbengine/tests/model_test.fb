    Assets.MountFiles("res://held-model", {"door.gltf": Door()})
    Defer Assets.Unmount("res://held-model")
    Local first = Try Assets.Load<Model>("res://held-model/door.gltf")
    Local second = Try Assets.Load<Model>("res://held-model/door.gltf")
    Expect(RefEquals(first, second))
