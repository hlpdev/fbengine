// Sprites: their settings, copies, and how a camera sees one, with no GPU.

Import std.core
Import std.math
Import std.test
Import fbengine

Function Fresh(): World
    Local world = World()
    World.SetCurrent(world)
    Return world
End Function

Function Near(a: Vec3, b: Vec3): Bool => IsClose(a, b, 0.0001)

@Test
Function ASpritesSettingsComeBackAndCopy()
    Local world = Fresh()
    Defer world.Free()
    Local glow = Material()
    Local sprite = Sprite(glow)
    Expect(sprite.Kind() == EntityKind.SPRITE && sprite.Material() == glow)
    Expect(sprite.ViewMode() == SpriteViewMode.BILLBOARD)
    Expect(sprite.SpriteScale() == Vec2(1, 1) && sprite.Handle() == Vec2(0, 0))
    Expect(sprite.SpriteRotation() == 0 && sprite.Color() == Color(1, 1, 1, 1))
    sprite.SetViewMode(SpriteViewMode.UPRIGHT)
    sprite.SetSpriteScale(Vec2(2, 3))
    sprite.SetHandle(Vec2(0, -1))
    sprite.SetSpriteRotation(0.5)
    sprite.SetColor(Color(1, 0.5, 0.25, 0.75))
    Local copy = sprite.Copy() As Sprite
    Expect(copy.Material() == glow && copy.ViewMode() == SpriteViewMode.UPRIGHT)
    Expect(copy.SpriteScale() == Vec2(2, 3) && copy.Handle() == Vec2(0, -1))
    Expect(copy.SpriteRotation() == 0.5 && copy.Color() == Color(1, 0.5, 0.25, 0.75))
    // White with no material.
    copy.SetMaterial(Null)
    Expect(copy.Material() == Null && sprite.Material() == glow)
End Function

@Test
Function ABillboardFacesTheCamera()
    Local world = Fresh()
    Defer world.Free()
    Local camera = Camera()
    camera.SetViewport(Rect(0, 0, 1600, 900))
    camera.Turn(0, Deg(90), 0)
    Local smoke = Sprite()
    smoke.SetPosition(Vec3(-5, 0, 0))
    smoke.Turn(Deg(30), Deg(10), 0)
    Local m = smoke.MatrixFor(camera)
    // Its front faces back along the camera's view, its right is the camera's.
    Expect(Near(m.TransformVector(Vec3(0, 0, 1)), -camera.Forward()))
    Expect(Near(m.TransformPoint(Vec3(1, 0, 0)), Vec3(-5, 0, 0) + camera.Right()))
    // Its bounds hold it however it turns, and the camera sees it.
    Expect(smoke.Bounds().Contains(m.TransformPoint(Vec3(1, 1, 0))))
    Expect(camera.InView(smoke))
    // Its middle just off the side of the view, its reach still in it.
    smoke.SetPosition(Vec3(-5, 0, -6.5))
    Expect(!camera.InView(smoke.Position(Space.WORLD)) && camera.InView(smoke))
End Function
