// The GPU and Flip's present in a headless window, which draws into an image of its own as a shown
// one's swapchain's. ctest runs them on lavapipe; a machine with no Vulkan sets FBENGINE_NO_GPU to
// 1 and skips them.

Import std.core
Import std.math
Import std.os
Import std.test
Import std.text
Import fbengine
Import fbengine.c.fbe_core
Import fbengine.c.fbe_gpu

Function NoGpu(): Bool => Env.Get("FBENGINE_NO_GPU") == "1"

// What the last call that failed said.
Function Why(): String
    Unsafe
        Return fbe_error().ToString()
    End Unsafe
End Function

@Test
Function TheDevicesSayWhatTheyLack() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local devices = Try Gpu.Devices()
    Expect(devices.Count >= 1)
    Local usable = 0
    For device In devices
        Expect(device.Name != "")
        If device.Usable() Then usable += 1
    End For
    Expect(usable >= 1)
End Function

@Test
Function StartingTheGpuPicksAUsableDevice() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Gpu.Start()
    Expect(Gpu.Started())
    Expect(Gpu.Name() != "")
    Local device = Gpu.Device()
    Expect(device >= 0)
    Expect((Try Gpu.Devices())[device].Usable())
    // Starting it again is nothing.
    Try Gpu.Start()
    Expect(Gpu.Device() == device)
    Expect(Gpu.ValidationErrors() == 0)
End Function

@Test
Function FlipPresentsAHeadlessWindowWithVsyncOrWithout() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Graphics(320, 200)
    Defer EndGraphics()
    Try Gpu.Start()
    Expect(fbe_gpu_swapchain_headless())
    Expect(fbe_gpu_swapchain_width() == Window.PixelWidth())
    Expect(fbe_gpu_swapchain_height() == Window.PixelHeight())
    Local before = Gpu.Presented()
    Flip()
    Expect(Gpu.Presented() == before + 1)
    Expect(fbe_gpu_swapchain_vsync())
    Flip(False)
    Flip(False)
    Expect(Gpu.Presented() == before + 3)
    Expect(!fbe_gpu_swapchain_vsync())
    Flip()
    Expect(fbe_gpu_swapchain_vsync())
    Expect(Gpu.ValidationErrors() == 0)
End Function

@Test
Function TheWindowsImagesFollowItsSize() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Gpu.Start()
    Try Graphics(320, 200)
    Defer EndGraphics()
    Flip()
    Expect(fbe_gpu_swapchain_width() == Window.PixelWidth())
    Try Graphics(640, 480)
    Local before = Gpu.Presented()
    Flip()
    Expect(Gpu.Presented() == before + 1)
    Expect(fbe_gpu_swapchain_width() == Window.PixelWidth())
    Expect(fbe_gpu_swapchain_height() == Window.PixelHeight())
    Try Window.SetMode(WindowMode.BORDERLESS)
    Flip()
    Expect(fbe_gpu_swapchain_width() == Window.PixelWidth())
    Expect(Gpu.ValidationErrors() == 0)
End Function

// Flip presents before it reads the OS's events, so the frame after the one that read them is the
// first one they change.
@Test
Function AMinimizedWindowIsntPresented() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Graphics(320, 200)
    Defer EndGraphics()
    Try Gpu.Start()
    Try Simulate.MinimizeWindow()
    Flip()
    Local before = Gpu.Presented()
    Flip()
    Flip()
    Expect(Gpu.Presented() == before)
    Try Simulate.RestoreWindow()
    Flip()
    Flip()
    Expect(Gpu.Presented() == before + 1)
End Function

@Test
Function AWindowOpenedAgainIsPresentedAgain() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Gpu.Start()
    Try Graphics(320, 200)
    Flip()
    EndGraphics()
    Expect(fbe_gpu_swapchain_width() == 0)
    Local before = Gpu.Presented()
    // Without a window, there's nothing to present.
    Flip()
    Expect(Gpu.Presented() == before)
    Try Graphics(200, 100)
    Defer EndGraphics()
    Flip()
    Expect(Gpu.Presented() == before + 1)
    Expect(fbe_gpu_swapchain_width() == Window.PixelWidth())
    Expect(Gpu.ValidationErrors() == 0)
End Function

@Test
Function TheDeviceCantBeSetToOneThatIsntThere() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Gpu.Stop()
    Local count = (Try Gpu.Devices()).Count
    Expect(!fbe_gpu_set_device(count))
    Expect(Why() == "there's no GPU {count}")
    Expect(!fbe_gpu_set_device(-2))
    Expect(Why() == "there's no GPU -2")
    Expect(fbe_gpu_set_device(-1))
End Function

@Test
Function AStoppedGpuStartsAgainAndPresents() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Graphics(320, 200)
    Defer EndGraphics()
    Try Gpu.Start()
    Flip()
    Gpu.Stop()
    Expect(!Gpu.Started())
    Expect(Gpu.Name() == "")
    Expect(Gpu.Pipelines() == 0)
    Local before = Gpu.Presented()
    Flip()
    Expect(Gpu.Presented() == before)
    Try Gpu.Start()
    Flip()
    Expect(Gpu.Presented() == before + 1)
    Expect(Gpu.ValidationErrors() == 0)
End Function

@Test
Function AGpuLossRefusesACountOfStartsUnder0ByName() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Gpu.Start()
    Defer Gpu.Stop()
    // Under 0, the least Int too; Int is Int32, so a count past it doesn't compile.
    For count In [-1, -2147483648]
        Local said = ExpectThrows<GraphicsError>(Gpu.SimulateLoss(count))?.Message ?? "nothing"
        Expect(said.Contains("not {count}"), "a loss with {count} starts to fail said: {said}")
        Expect(!Gpu.Lost(), "a loss with {count} starts to fail lost the GPU")
    End For
End Function

@Test
Function ThePipelineCacheIsTheUsersByDefaultAndCanBeNone()
    Local path = Gpu.PipelineCache()
    Defer Gpu.SetPipelineCache(path)
    Expect(path.EndsWith("/pipelines.bin"))
    Gpu.SetPipelineCache("")
    Expect(Gpu.PipelineCache() == "")
    Gpu.SetPipelineCache("cache/here.bin")
    Expect(Gpu.PipelineCache() == "cache/here.bin")
    Expect(Gpu.Pipelines() >= 0)
End Function

@Test
Function TheLastFramesCountersSayWhatItDid() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Try Graphics(64, 32)
    Defer EndGraphics()
    Try Gpu.Start()
    Local texture = Try Texture(4, 4, TextureFormat.RGBA8, False)
    Defer texture.Free()
    texture.Clear(Color(1, 0, 0, 1))
    Flip()
    // The clear and Flip's present, which draws one triangle.
    Local counters = Gpu.Counters()
    Expect(counters.Passes == 2)
    Expect(counters.Draws == 1)
    Expect(counters.Triangles == 1)
    Expect(counters.Barriers >= 2)
    Flip()
    Flip()
    Expect(Gpu.Counters().Passes == 1)
    Expect(Gpu.Counters().Uploaded == 0)
    Expect(!Gpu.Lost())
    Expect(Gpu.MemoryBudget() > 0)
    Expect(Gpu.MemoryUsage() > 0)
End Function
