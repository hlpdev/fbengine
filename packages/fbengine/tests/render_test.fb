// What cameras draw, as the renderer extracts it, and the projection they draw with, with no GPU.

Import std.core
Import std.math
Import std.test
Import std.os
Import fbengine

Function Fresh(): World
    Local world = World()
    World.SetCurrent(world)
    Return world
End Function

// A camera at the origin looking down -Z, 1600 by 900.
Function Looking(): Camera
    Local camera = Camera()
    camera.SetViewport(Rect(0, 0, 1600, 900))
    Return camera
End Function

@Test
Function ACameraDrawsWhatItSeesInItsOrder()
    Local world = Fresh()
    Defer world.Free()
    Local camera = Looking()
    Local far = Mesh(Geometry.Cube())
    far.SetPosition(Vec3(0, 0, -20))
    Local near = Mesh(Geometry.Cube())
    near.SetPosition(Vec3(0, 0, -5))
    Local glass = Material()
    glass.SetBlend(Blend.ALPHA)
    Local pane = Mesh(Geometry.Cube())
    pane.SetMaterial(glass)
    pane.SetPosition(Vec3(2, 0, -10))
    Local behind = Mesh(Geometry.Cube())
    behind.SetPosition(Vec3(0, 0, 10))
    Local draws = camera.Draws()
    Expect(draws.Count == 3)
    Expect(draws[0].Entity == near && draws[1].Entity == far && draws[2].Entity == pane)
    Expect(draws[0].Blend == Blend.OPAQUE && draws[2].Blend == Blend.ALPHA)
    Expect(draws[2].Material == glass && draws[0].Surface == near.Geometry()?.Surface(0))
    Expect(IsClose(draws[0].Depth, 5, 0.001))
    Expect(IsClose(draws[0].Matrix.TransformPoint(Vec3.Zero()), Vec3(0, 0, -5), 0.001))
End Function

@Test
Function ACamerasDrawProjectionIsReversedAndYDown()
    Local world = Fresh()
    Defer world.Free()
    Local camera = Looking()
    camera.SetRange(0.5, 100)
    Local p = camera.DrawProjection()
    // A point ahead at the near plane has depth 1, at the far plane 0.
    Local at_near = p * Vec4(0, 0, -0.5, 1)
    Local at_far = p * Vec4(0, 0, -100, 1)
    Expect(IsClose(at_near.z / at_near.w, 1, 0.0001) && IsClose(at_far.z / at_far.w, 0, 0.0001))
    // Above the middle is up the screen: a negative clip y.
    Local above = p * Vec4(0, 1, -5, 1)
    Expect(above.y < 0)
End Function

@Test
Function AGeometrysCullBoxCullsItsMeshes()
    Local world = Fresh()
    Defer world.Free()
    Local camera = Looking()
    Local geometry = Geometry.Cube()
    Local mesh = Mesh(geometry)
    mesh.SetPosition(Vec3(0, 0, -5))
    geometry.Translate(Vec3(100, 0, 0))
    Expect(camera.Draws().Count == 0 && geometry.CullBox() == Null)
    geometry.SetCullBox(AABB(Vec3(-1, -1, -1), Vec3(1, 1, 1)))
    Expect(camera.Draws().Count == 1)
    Expect(geometry.CullBox() == AABB(Vec3(-1, -1, -1), Vec3(1, 1, 1)))
    geometry.SetCullBox(Null)
    Expect(camera.Draws().Count == 0)
End Function

@Test
Function ACameraDrawsATerrainByItsGrid()
    Local world = Fresh()
    Defer world.Free()
    Local camera = Looking()
    Local ground = Terrain(10)
    ground.SetPosition(Vec3(-5, -2, -20))
    Local draws = camera.Draws()
    Expect(draws.Count == 1)
    Expect(draws[0].Entity == ground && draws[0].Surface == Null)
    // Its grid's middle, 15 ahead; its corner is 20.
    Expect(IsClose(draws[0].Depth, 15, 0.001))
End Function

@Test
Function ACameraDrawsFromWhereItIsBetweenSteps()
    Local world = Fresh()
    Defer world.Free()
    Local camera = Looking()
    Local gun = Mesh(Geometry.Cube(), camera)
    gun.SetPosition(Vec3(0, 0, -1))
    world.Capture()
    camera.SetPosition(Vec3(0, 0, -2))
    // Half way, the camera is at z -1, and the gun 1 ahead of it.
    Local view = camera.TweenedViewMatrix(0.5)
    Expect(IsClose(view.TransformPoint(Vec3(0, 0, -1)), Vec3.Zero(), 0.001))
    Local draws = camera.Draws(0.5)
    Expect(draws.Count == 1 && IsClose(draws[0].Depth, 1, 0.001))
    Expect(IsClose(draws[0].Matrix.TransformPoint(Vec3.Zero()), Vec3(0, 0, -2), 0.001))
End Function

@Test
Function ADrawSaysHowItMeetsDepth()
    Local world = Fresh()
    Defer world.Free()
    Local camera = Looking()
    Local sky = Material()
    sky.SetOrder(-1)
    Local dome = Mesh(Geometry.Cube())
    dome.SetMaterial(sky)
    dome.SetPosition(Vec3(0, 0, -3))
    Local box = Mesh(Geometry.Cube())
    box.SetPosition(Vec3(0, 0, -6))
    Local draws = camera.Draws()
    Expect(draws.Count == 2 && draws[0].Entity == dome && draws[1].Entity == box)
    Expect(draws[0].DepthMode == DepthMode.NONE && draws[1].DepthMode == DepthMode.TEST_AND_WRITE)
    Expect(draws[0].Pipeline != draws[1].Pipeline)
End Function

Function NoGpu(): Bool => Env.Get("FBENGINE_NO_GPU") == "1"

// A pixel's red and blue of a 32 pixel wide target's bytes.
Function Red(pixels: UInt8[], x: Int, y: Int): Int => pixels[(y * 32 + x) * 4] As Int
Function Blue(pixels: UInt8[], x: Int, y: Int): Int => pixels[(y * 32 + x) * 4 + 2] As Int

@Test
Function RenderWorldDrawsEveryCameraIntoItsTarget() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local world = Fresh()
    Defer world.Free()
    Local target = Try Texture.Target(32, 32, TextureFormat.RGBA8, 1, True)
    Local camera = Camera()
    camera.SetRenderTarget(target)
    camera.SetClearColor(Color(0, 0, 1))
    Expect(camera.RenderTarget() == target)
    Local red = Material()
    red.SetShading(Shading.UNLIT)
    red.SetColor(Color(1, 0, 0))
    Local cube = Mesh(Geometry.Cube())
    cube.SetMaterial(red)
    cube.SetPosition(Vec3(0, 0, -6))
    world.SetAmbientLight(Color(0, 0, 0))
    RenderWorld()
    Local pixels = target.ReadPixels()
    Expect(Red(pixels, 16, 16) == 255 && Blue(pixels, 16, 16) == 0)
    Expect(Red(pixels, 1, 1) == 0 && Blue(pixels, 1, 1) == 255)
    // A camera's own, with a texture layer of black multiplied over it.
    camera.SetClearColor(Color(0, 1, 0))
    Local layer = Try Texture(2, 2, TextureFormat.RGBA8, False)
    layer.Clear(Color(0, 0, 0))
    red.SetTexture(0, layer)
    Expect(red.Texture(0) == layer)
    red.SetLayer(0, LayerBlend.MULTIPLY)
    camera.Render()
    pixels = target.ReadPixels()
    Expect(Red(pixels, 16, 16) == 0)
    Expect(pixels[(1 * 32 + 1) * 4 + 1] == 255)
    camera.SetRenderTarget(Null)
    Expect(camera.RenderTarget() == Null)
End Function

@Test
Function ALayersUvAndBumpAreWhatTheyreSetTo()
    Local material = Material()
    material.SetLayerUv(1, UvTurn(Vec2(2, 3), 0.5, Vec2(0.25, 0.75)))
    Local uv = material.LayerUv(1)
    Expect(uv.Scale == Vec2(2, 3) && uv.Angle == 0.5 && uv.Offset == Vec2(0.25, 0.75))
    material.SetLayer(0, LayerBlend.BUMP)
    Expect(material.LayerBlend(0) == LayerBlend.BUMP)
    material.SetLayerBump(0, BumpShift(-0.012, -0.012, 0.012, 0.012, 1, 0.5))
    Local bump = material.LayerBump(0)
    Expect(bump.M00 == -0.012 && bump.M11 == 0.012 && bump.Scale == 1 && bump.Offset == 0.5)
    Expect(material.Texture(0) == Null)
End Function

@Test
Function ASurfacesJointsAreOneForEachVertex()
    Local geometry = Geometry.Cube()
    Local surface = geometry.Surface(0)
    Local joints: VertexJoints[] = []
    For i = 1 To surface.VertexCount()
        joints.Add(VertexJoints(1, 2, 3, 4, Vec4(0.5, 0.25, 0.25, 0)))
    End For
    surface.SetJoints(joints)
    Local read = surface.Joints()
    Expect(read.Count == joints.Count)
    Expect(read[0].Joint2 == 3 && read[0].Weights.x == 0.5)
    surface.SetJoints([])
    Expect(surface.Joints().Count == 0)
End Function

@Test
Function ACameraTargetGoneWithTheGpuIsNull() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local world = Fresh()
    Defer world.Free()
    Local target = Try Texture.Target(16, 16, TextureFormat.RGBA8, 1, True)
    Local camera = Camera()
    camera.SetRenderTarget(target)
    Gpu.Stop()
    Expect(camera.RenderTarget() == Null)
    Local material = Material()
    Local layer = Try Texture(2, 2, TextureFormat.RGBA8, False)
    material.SetTexture(0, layer)
    Gpu.Stop()
    Expect(material.Texture(0) == Null)
End Function

@Test
Function ATexturesAlphaAndAWireframeAreWhatTheyreSetTo() Throws GraphicsError
    If NoGpu() Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local texture = Try Texture(2, 2, TextureFormat.RGBA8, False)
    Expect(!texture.Alpha())
    texture.SetAlpha(True)
    Expect(texture.Alpha())
    Local material = Material()
    material.SetWireframe(True)
    Expect(material.Wireframe())
End Function

// A Camera's HDR settings, through to its target: light past white, exposed and tonemapped.
@Test
Function ACameraDrawsHdrLight() Throws GraphicsError
    If Env.Get("FBENGINE_NO_GPU") == "1" Then Skip("no GPU here")
    Window.SetHeadless(True)
    Local world = World()
    World.SetCurrent(world)
    Local camera = Camera()
    Expect(!camera.Hdr() && camera.Exposure() == 1.0)
    Expect(camera.Tonemap() == Tonemap.NONE && camera.Gamma() == 1.0)
    camera.SetHdr(True)
    camera.SetExposure(0.5)
    camera.SetTonemap(Tonemap.NEUTRAL)
    camera.SetGamma(2.0)
    Expect(camera.Hdr() && camera.Exposure() == 0.5)
    Expect(camera.Tonemap() == Tonemap.NEUTRAL && camera.Gamma() == 2.0)
    Expect(camera.BloomIntensity() == 0.0 && camera.BloomThreshold() == 1.0)
    camera.SetBloom(0.5, 2.0)
    Expect(camera.BloomIntensity() == 0.5 && camera.BloomThreshold() == 2.0)
    Local grade = ColorGrade(Vec3(2.0, 1.0, 0.5), Vec3(0.1, 0.0, -0.1), Vec3(1.0, 2.0, 0.5), 0.5)
    camera.SetGrade(grade)
    Expect(camera.Grade() == grade)
    // Through to its target: light past white, exposed, tonemapped, in bytes.
    camera.SetBloom(0.0)
    camera.SetGrade(ColorGrade(Vec3(1.0, 1.0, 1.0), Vec3(0.0, 0.0, 0.0), Vec3(1.0, 1.0, 1.0), 1.0))
    camera.SetGamma(1.0)
    camera.SetTonemap(Tonemap.REINHARD)
    camera.SetExposure(0.5)
    Local target = Try Texture.Target(32, 32, TextureFormat.RGBA8_LINEAR, 1, True)
    camera.SetRenderTarget(target)
    camera.SetClearColor(Color(0, 0, 0))
    Local glowing = Material()
    glowing.SetEmissive(Color(2.0, 2.0, 2.0))
    Local cube = Mesh(Geometry.Cube())
    cube.SetMaterial(glowing)
    cube.SetPosition(Vec3(0, 0, -6))
    world.SetAmbientLight(Color(0, 0, 0))
    camera.Render()
    // 2 at half exposure is 1, and Reinhard's of 1 is a half.
    Local pixels = target.ReadPixels()
    Expect(Abs(Red(pixels, 16, 16) - 128) <= 1)
    camera.SetRenderTarget(Null)
    World.SetCurrent(World.Main())
    world.Free()
End Function
