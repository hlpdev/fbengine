// Bones under the game's control after animation: a head turned toward a target after UpdateWorld,
// on what its Clip posed, and bones released to the game; with no window or GPU.

Import std.math
Import std.test
Import fbengine

Function Fresh(): World
    Local world = World()
    World.SetCurrent(world)
    Return world
End Function

// Hips at the top, walking along x, a neck under them, and a head 1 above the neck.
Function Body(): Pivot
    Local hips = Pivot()
    hips.SetName("hips")
    Local neck = Pivot(hips)
    neck.SetName("neck")
    Local head = Pivot(neck)
    head.SetName("head")
    head.SetPosition(Vec3(0, 1, 0))
    Return hips
End Function

// The hips moving 4 along x over 2 seconds, and the head turning a third of a turn about Y.
Function Walk(): Clip
    Local clip = Clip("walk")
    clip.AddPositions("hips", [0, 2], [Vec3(0, 0, 0), Vec3(4, 0, 0)])
    clip.AddRotations("head", [0, 2], [Quat.Identity, Quat.FromAxisAngle(Vec3(0, 1, 0), Deg(120))])
    Return clip
End Function

@Test
Function AHeadPointedAtATargetAfterUpdateWorldFacesIt()
    Local world = Fresh()
    Defer world.Free()
    Local hips = Body()
    Local head = hips.Child(0).Child(0)
    Local nose = Pivot(head)
    nose.SetPosition(Vec3(0, 0, -1))
    hips.Player().Play(Walk(), PlayMode.ONCE)
    UpdateWorld(1)
    // The head's where its Clip has it, the hips 2 along.
    Expect(IsClose(head.Position(Space.WORLD), Vec3(2, 1, 0)))
    Local target = Vec3(2, 1, 5)
    head.PointAt(target)
    Expect(IsClose(head.Forward(), Vec3(0, 0, 1)))
    // What's under it follows.
    Expect(IsClose(nose.Position(Space.WORLD), Vec3(2, 1, 1)))
    // It stays turned until the next update, which poses it from its Clip again.
    Expect(IsClose(head.Forward(), Vec3(0, 0, 1)))
    UpdateWorld(0)
    Expect(IsClose(head.Forward(), Vec3(-Sin(Deg(60)), 0, -Cos(Deg(60)))))
    // Turned at each update, it's turned as the hips walk on.
    UpdateWorld(0.5)
    head.PointAt(target)
    Expect(IsClose(head.Position(Space.WORLD), Vec3(3, 1, 0)))
    Local toTarget = Normalize(target - Vec3(3, 1, 0))
    Expect(IsClose(head.Forward(), toTarget))
End Function

// A turn on top of what the Clip gave, as a look to one side: it doesn't add up over updates.
@Test
Function ATurnAfterUpdateWorldIsOnTopOfThePose()
    Local world = Fresh()
    Defer world.Free()
    Local hips = Body()
    Local head = hips.Child(0).Child(0)
    hips.Player().Play(Walk(), PlayMode.ONCE)
    For update = 1 To 3
        hips.Player().SetTime(1)
        UpdateWorld(0)
        Local posed = head.Rotation()
        head.Turn(0, Deg(30), 0)
        Expect(IsClose(head.Rotation() * Vec3(0, 0, -1),
                       (posed * Quat.FromAxisAngle(Vec3(0, 1, 0), Deg(30))) * Vec3(0, 0, -1)))
    End For
End Function

// Part of the way from its pose to the target, as a head only half looks.
@Test
Function AHeadCanTurnPartOfTheWayFromItsPose()
    Local world = Fresh()
    Defer world.Free()
    Local hips = Body()
    Local head = hips.Child(0).Child(0)
    hips.Player().Play(Walk(), PlayMode.ONCE)
    UpdateWorld(0)
    Local posed = head.Rotation()
    head.SetRotation(Slerp(posed, Quat.FromAxisAngle(Vec3(1, 0, 0), Deg(90)), 0.5))
    Expect(IsClose(head.Forward(), Normalize(Vec3(0, 1, -1))))
End Function

// The skin's palette and a drawing's tween see what the game turned.
@Test
Function WhatTheGameTurnedIsWhatsDrawn()
    Local world = Fresh()
    Defer world.Free()
    Local hips = Body()
    Local head = hips.Child(0).Child(0)
    Local mesh = Mesh(Null)
    Local skin = Skin()
    skin.AddJoint("head", Mat4.Identity)
    mesh.SetSkin(skin, hips)
    hips.Player().Play(Walk(), PlayMode.ONCE)
    UpdateWorld(0)
    head.SetRotation(Quat.FromAxisAngle(Vec3(0, 1, 0), Deg(90)))
    Expect(IsClose(mesh.Palette()[0].TransformPoint(Vec3(0, 0, -1)), Vec3(-1, 1, 0)))
    // Captured turned, then posed by a step and turned the other way: part way between them.
    CaptureWorld()
    UpdateWorld(0)
    head.SetRotation(Quat.FromAxisAngle(Vec3(0, 1, 0), Deg(-90)))
    Local halfway = head.TweenedMatrix(0.5).TransformPoint(Vec3(0, 0, -1))
    Expect(IsClose(halfway, Vec3(0, 1, -1), 0.001))
End Function

@Test
Function ABoneReleasedIsTheGamesUntilItsReclaimed()
    Local world = Fresh()
    Defer world.Free()
    Local hips = Body()
    Local head = hips.Child(0).Child(0)
    Local player = hips.Player()
    player.Play(Walk(), PlayMode.ONCE)
    Expect(!player.Released(head))
    player.Release(head)
    Expect(player.Released(head))
    Local kept = Quat.FromAxisAngle(Vec3(1, 0, 0), Deg(45))
    head.SetRotation(kept)
    UpdateWorld(1)
    // The hips walk on, and the head's as the game left it.
    Expect(IsClose(hips.Position(), Vec3(2, 0, 0)))
    Expect(IsClose(head.Rotation() * Vec3(0, 0, -1), kept * Vec3(0, 0, -1)))
    // Reclaimed, a Clip moves it again.
    player.Reclaim(head)
    Expect(!player.Released(head))
    UpdateWorld(0)
    Expect(IsClose(head.Rotation() * Vec3(0, 0, -1), Vec3(-Sin(Deg(60)), 0, -Cos(Deg(60)))))
End Function

// A bone no Clip moves is left to the game whatever plays.
@Test
Function ABoneNoClipMovesStaysWhereTheGamePutsIt()
    Local world = Fresh()
    Defer world.Free()
    Local hips = Body()
    Local neck = hips.Child(0)
    neck.SetPosition(Vec3(0, 3, 0))
    hips.Player().Play(Walk())
    UpdateWorld(1)
    Expect(neck.Position() == Vec3(0, 3, 0))
    neck.SetPosition(Vec3(0, 4, 0))
    UpdateWorld(1)
    Expect(neck.Position() == Vec3(0, 4, 0))
End Function
