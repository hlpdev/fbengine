// ShowMessage and OpenURL, headless, where they open nothing (tests/input's show-message cases
// check what ShowMessage writes), and the player's languages.

Import std.core
Import std.os
Import std.test
Import std.text
Import fbengine

// The link the last OpenURL kept.
Function LastOpened(): String
    Local links = OpenedURLs()
    Return links.Count > 0 ? links[links.Count - 1] : ""
End Function

@Test
Function OpenURLKeepsALinkHeadless()
    Window.SetHeadless(True)
    Local before = OpenedURLs().Count
    Expect(OpenURL("https://example.com/a page?x=1"))
    Expect(OpenedURLs().Count == before + 1)
    // A link is opened as it's given.
    Expect(LastOpened() == "https://example.com/a page?x=1")
    Expect(OpenURL("mailto:someone@example.com"))
    Expect(LastOpened() == "mailto:someone@example.com")
End Function

// On Windows, a path's link is UrlCreateFromPathW's, which the shell reads back: other than ASCII
// as it is, and a UNC path's server its host; tests/app's C++ reads each back through the shell.
@Test
Function AWindowsPathOpensAsItsFileLink()
    If System.Platform != Platform.WINDOWS Then Skip("Windows' paths")
    Window.SetHeadless(True)
    Expect(OpenURL("C:\\Games\\Notes #1.txt"))
    Expect(LastOpened() == "file:///C:/Games/Notes%20%231.txt")
    Expect(OpenURL("C:/Games/é.txt"))
    Expect(LastOpened() == "file:///C:/Games/é.txt")
    Expect(OpenURL("\\\\server\\share\\a b.txt"))
    Expect(LastOpened() == "file://server/share/a%20b.txt")
    // A drive's own folder, not the current one with "C:x.txt" on its end.
    Expect(OpenURL("C:x.txt"))
    Expect(LastOpened().StartsWith("file:///C:/"))
    Expect(LastOpened().EndsWith("/x.txt"))
    Expect(!LastOpened().Contains("C:x"))
End Function

// Elsewhere, it's RFC 8089's, its UTF-8 in %XX.
@Test
Function APosixPathOpensAsItsFileLink()
    If System.Platform == Platform.WINDOWS Then Skip("POSIX's paths")
    Window.SetHeadless(True)
    Expect(OpenURL("/home/player/My Saves/slot 1.sav"))
    Expect(LastOpened() == "file:///home/player/My%20Saves/slot%201.sav")
    Expect(OpenURL("/home/José/é.txt"))
    Expect(LastOpened() == "file:///home/Jos%C3%A9/%C3%A9.txt")
End Function

@Test
Function ARelativePathIsFromTheCurrentFolder()
    Window.SetHeadless(True)
    Expect(OpenURL("readme here.txt"))
    Local link = LastOpened()
    Expect(link.StartsWith("file:///"))
    Expect(link.EndsWith("/readme%20here.txt"))
    Expect(!link.Contains("\\"))
End Function

@Test
Function NothingIsNoLink()
    Window.SetHeadless(True)
    Local before = OpenedURLs().Count
    Expect(!OpenURL(""))
    Expect(OpenedURLs().Count == before)
End Function

// Headless, ShowMessage writes to stderr and goes on, so a test never waits for a player.
@Test
Function AMessageHeadlessGoesOnAtOnce()
    Window.SetHeadless(True)
    ShowMessage("fbengine's tests", "a message no one has to close", MessageKind.INFORMATION)
    ShowMessage("fbengine's tests", "a warning", MessageKind.WARNING)
End Function

@Test
Function TheClipboardHoldsWhatsPutOnIt()
    Window.SetHeadless(True)
    Expect(SetClipboard("copied é"))
    Expect(Clipboard() == "copied é")
    Expect(SetClipboard(""))
    Expect(Clipboard() == "")
End Function

@Test
Function ThePlayersLanguagesAreTags()
    For tag In Languages()
        Expect(tag != "" && !tag.Contains("_") && !tag.Contains(" "))
    End For
End Function

@Test
Function TheBestLanguageIsThePlayersFirstThatTheGameHas()
    Local available = ["en-US", "fr", "pt-BR", "zh-Hans"]
    Expect(BestLanguage(available, ["de", "fr-CA", "en-US"]) == "fr")
    Expect(BestLanguage(available, ["EN-us"]) == "en-US")
    // Then any of the language: an "en" player gets the game's "en-US".
    Expect(BestLanguage(available, ["en-GB"]) == "en-US")
    Expect(BestLanguage(available, ["zh-Hans-CN"]) == "zh-Hans")
    Expect(BestLanguage(available, ["pt"]) == "pt-BR")
    Expect(BestLanguage(available, ["de", "ja"]) == Null)
    Expect(BestLanguage([], ["en"]) == Null)
    // Without preferred, the OS's, which picks one of them or none.
    Local best = BestLanguage(available)
    Expect(best == Null || available.Contains(best ?? ""))
End Function
