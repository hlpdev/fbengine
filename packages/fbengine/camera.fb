// Cameras: what each sees of its World, and where on its target it draws it. The target is the
// window, or a texture.

Import std.core
Import std.ffi
Import std.math
Import "./c/fbe_scene"
Import "./entity"
Import "./light"
Import "./texture"
Import "./transform"
Import "./window"

/// How a camera projects what it sees.
Public Enum Projection
    /// With perspective: what's further looks smaller.
    PERSPECTIVE = 0
    /// Without: a box of the world, as plans and overlays want.
    ORTHOGRAPHIC = 1
End Enum

/// How a camera's fog thickens with depth in front of it.
Public Enum FogMode
    /// No fog.
    NONE = 0
    /// None at its start, whole at its end, and evenly between.
    LINEAR = 1
    /// What's seen fades as e to the minus (density x depth).
    EXPONENTIAL = 2
    /// What's seen fades as e to the minus (density x depth) squared.
    EXPONENTIAL_SQUARED = 3
End Enum

/// A camera: it looks along its forward axis, -Z, from where it is, turned as it is, its scale
/// left out. New, it's perspective, at a field of view of 60 degrees from the bottom of its view
/// to the top, sees from 0.1 to 1000 units in front of it, draws to the whole window, and clears
/// it to black first. A hidden camera draws nothing, and a World draws its cameras in their order.
Public Final Class Camera Extends Entity
    /// A new Camera, the last child of `parent`, or at the top of the current World when `parent`
    /// is Null.
    @MainThread @PanicsAtCaller
    Public New(parent: Entity? = Null)
        Super.New(Create(parent, FBE_ENTITY_CAMERA))
    End New

    Package New(handle: UInt64)
        Super.New(handle)
    End New

    Override Package Method KindName(): String => "Camera"

    /// Makes the camera project with perspective, or orthographically.
    @MainThread @PanicsAtCaller
    Public Method SetProjection(projection: Projection)
        If !fbe_camera_set_projection(Live("SetProjection"), projection As Int32)
            Failed("SetProjection")
        End If
    End Method

    /// How the camera projects.
    @MainThread @PanicsAtCaller
    Public Method Projection(): Projection
        Return fbe_camera_projection(Live("Projection")) As Projection
    End Method

    /// Sets the camera's field of view: the angle from the bottom of its view to the top, in
    /// radians, from 0 to Pi, with the angle across following its viewport's shape, so a wider
    /// window sees more at the sides. Outside 0 to Pi panics.
    @MainThread @PanicsAtCaller
    Public Method SetFieldOfView(angle: Float)
        If !fbe_camera_set_field_of_view(Live("SetFieldOfView"), angle)
            Failed("SetFieldOfView")
        End If
    End Method

    /// The angle from the bottom of the camera's view to its top, in radians.
    @MainThread @PanicsAtCaller
    Public Method FieldOfView(): Float => fbe_camera_field_of_view(Live("FieldOfView"))

    /// The angle from the left of the camera's view to its right, in radians, which its field of
    /// view and its viewport's width over its height make.
    @MainThread @PanicsAtCaller
    Public Method HorizontalFieldOfView(): Float
        Target("HorizontalFieldOfView")
        Local view = Viewport()
        // A viewport with no size, as a window dragged to nothing high has, is square.
        If !(view.Width > 0 && view.Height > 0) Then Return FieldOfView()
        Return 2 * Atan(Tan(FieldOfView() / 2) * view.Width / view.Height)
    End Method

    /// Sets how many world units high the camera's view is when it's orthographic, its width
    /// following its viewport's shape. One not above 0 panics.
    @MainThread @PanicsAtCaller
    Public Method SetOrthographicHeight(height: Float)
        If !fbe_camera_set_orthographic_height(Live("SetOrthographicHeight"), height)
            Failed("SetOrthographicHeight")
        End If
    End Method

    /// How many world units high the camera's view is when it's orthographic.
    @MainThread @PanicsAtCaller
    Public Method OrthographicHeight(): Float
        Return fbe_camera_orthographic_height(Live("OrthographicHeight"))
    End Method

    /// Sets how far in front of the camera it sees, from `near` to `far`. Anything but 0 < near <
    /// far, finite, panics.
    @MainThread @PanicsAtCaller
    Public Method SetRange(near: Float, far: Float)
        If !fbe_camera_set_range(Live("SetRange"), near, far) Then Failed("SetRange")
    End Method

    /// The nearest the camera sees.
    @MainThread @PanicsAtCaller
    Public Method Near(): Float => fbe_camera_nearest(Live("Near"))

    /// The furthest the camera sees.
    @MainThread @PanicsAtCaller
    Public Method Far(): Float => fbe_camera_farthest(Live("Far"))

    /// Makes the camera draw to part of the window, in the window's units from its top left, as a
    /// split screen or a picture in a picture does. One with no size panics.
    @MainThread @PanicsAtCaller
    Public Method SetViewport(viewport: Rect)
        Local camera = Live("SetViewport")
        If !fbe_camera_set_viewport(camera, viewport.X, viewport.Y, viewport.Width,
                                    viewport.Height)
            Failed("SetViewport")
        End If
    End Method

    /// Makes the camera draw to the whole window again, whatever size it is.
    @MainThread @PanicsAtCaller
    Public Method ResetViewport()
        If !fbe_camera_reset_viewport(Live("ResetViewport")) Then Failed("ResetViewport")
    End Method

    /// The part of the window the camera draws to, in the window's units from its top left: the
    /// whole of it unless SetViewport gave it a part.
    @MainThread @PanicsAtCaller
    Public Method Viewport(): Rect
        Local camera = Live("Viewport")
        Local target = TargetSize()
        Local found = fbe_viewport_t(0, 0, 0, 0)
        Local done = False
        Unsafe
            done = fbe_camera_viewport(camera, target.x, target.y, AddressOf(found))
        End Unsafe
        If !done Then Failed("Viewport")
        Return Rect(found.x, found.y, found.width, found.height)
    End Method

    /// Whether the camera draws to the whole window, following its size.
    @MainThread @PanicsAtCaller
    Public Method FillsTarget(): Bool => fbe_camera_whole_target(Live("FillsTarget"))

    /// Sets what the camera draws into: a target with depth, or the screen with Null, as at first.
    /// Its viewport's in that target's pixels. Another texture, or a freed one, panics.
    @MainThread @PanicsAtCaller
    Public Method SetRenderTarget(target: Texture?)
        Local handle: UInt64 = target != Null ? target.Live("SetRenderTarget") : 0
        If !fbe_camera_set_target(Live("SetRenderTarget"), handle) Then Failed("SetRenderTarget")
    End Method

    /// What the camera draws into, or Null for the screen.
    @MainThread @PanicsAtCaller
    Public Method RenderTarget(): Texture? => TextureOf(fbe_camera_target(Live("RenderTarget")))

    /// Sets what the camera clears of its viewport before it draws: its color, to the clear
    /// color, and its depth. A camera that clears neither draws over the cameras before it, as an
    /// overlay does; one that clears only depth draws its things in front of theirs.
    @MainThread @PanicsAtCaller
    Public Method SetClear(color: Bool, depth: Bool)
        If !fbe_camera_set_clear(Live("SetClear"), color, depth) Then Failed("SetClear")
    End Method

    /// Whether the camera clears its viewport's color before it draws.
    @MainThread @PanicsAtCaller
    Public Method ClearsColor(): Bool => fbe_camera_clears_color(Live("ClearsColor"))

    /// Whether the camera clears its viewport's depth before it draws.
    @MainThread @PanicsAtCaller
    Public Method ClearsDepth(): Bool => fbe_camera_clears_depth(Live("ClearsDepth"))

    /// Sets the color the camera clears its viewport to, black at first.
    @MainThread @PanicsAtCaller
    Public Method SetClearColor(color: Color)
        If !fbe_camera_set_clear_color(Live("SetClearColor"), color.r, color.g, color.b, color.a)
            Failed("SetClearColor")
        End If
    End Method

    /// The color the camera clears its viewport to.
    @MainThread @PanicsAtCaller
    Public Method ClearColor(): Color
        Local camera = Live("ClearColor")
        Local found = fbe_color_t(0, 0, 0, 0)
        Local done = False
        Unsafe
            done = fbe_camera_clear_color(camera, AddressOf(found))
        End Unsafe
        If !done Then Failed("ClearColor")
        Return ColorOf(found)
    End Method

    /// Sets when the camera draws among its World's cameras: lower orders first, 0 at first, and
    /// those of one order in the order they were made.
    @MainThread @PanicsAtCaller
    Public Method SetOrder(order: Int)
        If !fbe_camera_set_order(Live("SetOrder"), order) Then Failed("SetOrder")
    End Method

    /// When the camera draws among its World's cameras.
    @MainThread @PanicsAtCaller
    Public Method Order(): Int => fbe_camera_order(Live("Order"))

    /// Sets how the camera's fog thickens with depth: none at first. Fog blends what the camera
    /// sees toward its color by how deep it is in front of the camera, so a fogged camera often
    /// sees only as far as its fog, with its far there.
    @MainThread @PanicsAtCaller
    Public Method SetFogMode(mode: FogMode)
        If !fbe_camera_set_fog_mode(Live("SetFogMode"), mode As Int32) Then Failed("SetFogMode")
    End Method

    /// How the camera's fog thickens with depth.
    @MainThread @PanicsAtCaller
    Public Method FogMode(): FogMode => fbe_camera_fog_mode(Live("FogMode")) As FogMode

    /// Sets the color the camera's fog blends toward, black at first; its alpha is left out.
    @MainThread @PanicsAtCaller
    Public Method SetFogColor(color: Color)
        If !fbe_camera_set_fog_color(Live("SetFogColor"), color.r, color.g, color.b)
            Failed("SetFogColor")
        End If
    End Method

    /// The color the camera's fog blends toward, with an alpha of 1.
    @MainThread @PanicsAtCaller
    Public Method FogColor(): Color
        Local camera = Live("FogColor")
        Local found = fbe_color_t(0, 0, 0, 0)
        Local done = False
        Unsafe
            done = fbe_camera_fog_color(camera, AddressOf(found))
        End Unsafe
        If !done Then Failed("FogColor")
        Return ColorOf(found)
    End Method

    /// Sets where linear fog starts and where it's whole, in depth in front of the camera: 1 to
    /// 100 at first. Anything but 0 <= start < end, finite, panics.
    @MainThread @PanicsAtCaller
    Public Method SetFogRange(start: Float, finish: Float)
        If !fbe_camera_set_fog_range(Live("SetFogRange"), start, finish) Then Failed("SetFogRange")
    End Method

    /// Where linear fog starts.
    @MainThread @PanicsAtCaller
    Public Method FogStart(): Float => fbe_camera_fog_start(Live("FogStart"))

    /// Where linear fog is whole.
    @MainThread @PanicsAtCaller
    Public Method FogEnd(): Float => fbe_camera_fog_end(Live("FogEnd"))

    /// Sets how thick exponential fog is, 0.02 at first. Below 0 panics.
    @MainThread @PanicsAtCaller
    Public Method SetFogDensity(density: Float)
        If !fbe_camera_set_fog_density(Live("SetFogDensity"), density) Then Failed("SetFogDensity")
    End Method

    /// How thick exponential fog is.
    @MainThread @PanicsAtCaller
    Public Method FogDensity(): Float => fbe_camera_fog_density(Live("FogDensity"))

    /// The matrix from the world to the camera's view, where it's at the origin looking down -Z.
    @MainThread @PanicsAtCaller
    Public Method ViewMatrix(): Mat4
        Local camera = Live("ViewMatrix")
        Local found = fbe_mat4_t()
        Local done = False
        Unsafe
            done = fbe_camera_view_matrix(camera, AddressOf(found))
        End Unsafe
        If !done Then Failed("ViewMatrix")
        Return MatOf(found)
    End Method

    /// The view matrix `tween` of the way, 0 to 1, from where the camera's World was last
    /// captured to now, as Draws sees from. A tween outside 0 to 1 panics.
    @MainThread @PanicsAtCaller
    Public Method TweenedViewMatrix(tween: Float): Mat4
        Local camera = Live("TweenedViewMatrix")
        Local found = fbe_mat4_t()
        Local done = False
        Unsafe
            done = fbe_camera_tweened_view_matrix(camera, tween, AddressOf(found))
        End Unsafe
        If !done Then Failed("TweenedViewMatrix")
        Return MatOf(found)
    End Method

    /// The camera's projection, as Mat4.Perspective or Mat4.Orthographic makes it, at its
    /// viewport's shape, with depth from 0 at its near to 1 at its far.
    @MainThread @PanicsAtCaller
    Public Method ProjectionMatrix(): Mat4
        Local camera = Live("ProjectionMatrix")
        Local target = Target("ProjectionMatrix")
        Local found = fbe_mat4_t()
        Local done = False
        Unsafe
            done = fbe_camera_projection_matrix(camera, target.x, target.y, AddressOf(found))
        End Unsafe
        If !done Then Failed("ProjectionMatrix")
        Return MatOf(found)
    End Method

    /// What the camera sees, as six planes in the world: what's in view is in it.
    @MainThread @PanicsAtCaller
    Public Method ViewFrustum(): Frustum
        Live("ViewFrustum")
        Target("ViewFrustum")
        Return FrustumOf(ProjectionMatrix() * ViewMatrix())
    End Method

    /// Where a point in the world is in the camera's view: x and y in the window's units from its
    /// top left, and z how far in front of the camera it is; or Null when it's nearer than the
    /// camera's near, so behind it, or the viewport has no size, as a window dragged to nothing
    /// high has. A point off the sides projects outside the viewport. With no window open and no
    /// viewport of its own, it panics.
    @MainThread @PanicsAtCaller
    Public Method Project(point: Vec3): Vec3?
        Local camera = Live("Project")
        Local target = Target("Project")
        Local found = fbe_vec3_t(0, 0, 0)
        Local done = 0
        Unsafe
            done = fbe_camera_project(camera, target.x, target.y, point.x, point.y, point.z,
                                      AddressOf(found))
        End Unsafe
        If done < 0 Then Failed("Project")
        If done == 0 Then Return Null
        Return VecOf(found)
    End Method

    /// The point in the world at x and y in the camera's view, in the window's units from its top
    /// left, z in front of the camera: what Project took there; Null when the viewport has no
    /// size. With no window open and no viewport of its own, it panics.
    @MainThread @PanicsAtCaller
    Public Method Unproject(point: Vec3): Vec3?
        Local camera = Live("Unproject")
        Local target = Target("Unproject")
        Local found = fbe_vec3_t(0, 0, 0)
        Local done = 0
        Unsafe
            done = fbe_camera_unproject(camera, target.x, target.y, point.x, point.y, point.z,
                                        AddressOf(found))
        End Unsafe
        If done < 0 Then Failed("Unproject")
        If done == 0 Then Return Null
        Return VecOf(found)
    End Method

    /// The line through a point of the camera's view, in the window's units from its top left:
    /// from the camera's near, with a Direction of length 1 into what it sees, which is far
    /// away at the camera's far, as the mouse's place picks what's under it.
    /// With a viewport of no size, it's the camera's own line, from it, forward.
    @MainThread @PanicsAtCaller
    Public Method ScreenRay(point: Vec2): Ray
        Live("ScreenRay")
        Target("ScreenRay")
        Local start = Unproject(Vec3(point.x, point.y, Near()))
        Local finish = Unproject(Vec3(point.x, point.y, Far()))
        If start == Null || finish == Null Then Return Ray(Position(Space.WORLD), Forward())
        Return Ray(start, Normalize(finish - start))
    End Method

    // The size of what the camera draws to, or a panic naming the call when that's a window that
    // isn't open and the camera has no viewport of its own.
    @PanicsAtCaller
    Package Method Target(call: String): Vec2
        Local into = RenderTarget()
        If into != Null Then Return Vec2(into.Width() As Float, into.Height() As Float)
        If !Window.Open() && FillsTarget()
            Panic("{call} on a Camera: the camera's viewport has no size: open the window, or " +
                  "give it a viewport")
        End If
        Return TargetSize()
    End Method

    /// Sets whether what it draws is tested against occluders, as it is at first.
    @MainThread @PanicsAtCaller
    Public Method SetOcclusion(occlusion: Bool)
        If !fbe_camera_set_occlusion(Live("SetOcclusion"), occlusion) Then Failed("SetOcclusion")
    End Method

    /// Whether what it draws is tested against occluders.
    @MainThread @PanicsAtCaller
    Public Method Occlusion(): Bool => fbe_camera_occlusion(Live("Occlusion"))
End Class

/// The size of what cameras draw to: the window, in its units.
Package Function TargetSize(): Vec2 => Vec2(Window.Width() As Float, Window.Height() As Float)

Function FrustumOf(m: Mat4): Frustum => Frustum.FromMatrix(m)
