// Components: what a game puts on an entity from a scene, each a Class of its own Public Fields, known
// by a name, described for what edits them, and made from what's saved.

Import std.collections
Import std.core
Import std.data
Import std.io
Import std.os
Import std.test
Import std.text
Import "./attributes"
Import "./entity"

// Where Components.Describe writes, if it's set, as the editor does when it runs a game's program.
Const DESCRIBE_TO = "FBENGINE_COMPONENTS_TO"

/// A Field of a kind of component.
Public Struct ComponentField
    /// What it's called.
    Public Field Name: String
    /// What it is at first, as what's saved of it is: a Bool, a number, a String, the name of an
    /// Enum's member, or an Object of a Struct's Fields.
    Public Field First: Value
    /// Whether it's an Enum, though its First is only a name.
    Public Field Enumerated: Bool
    /// An Enum's members' names, in order; none if MembersOf can't say.
    Public Field Members: String[]
    /// What its @Limits says.
    Public Field Low: Float
    /// What its @Limits says.
    Public Field High: Float
    /// What its @Limits says.
    Public Field Above: Bool
    /// Whether it's @ShownInDegrees.
    Public Field Degrees: Bool
End Struct

/// A kind of component: what it's called, and what it has.
Public Struct ComponentKind
    /// What it's called.
    Public Field Name: String
    /// Its Fields, in order.
    Public Field Fields: ComponentField[]
End Struct

// What a kind's Class is, to tell one from another by.
Class ClassMark
End Class

Class ClassMarkOf<T: Class> Extends ClassMark
End Class

// A kind of component, and how to put one on an entity from what's saved: what went wrong, or Null.
Class Registered
    Field kind: ComponentKind
    Field mark: ClassMark
    Field attach: Func(Entity, Value): String?

    New(kind: ComponentKind, mark: ClassMark, attach: Func(Entity, Value): String?)
        Self.kind = kind
        Self.mark = mark
        Self.attach = attach
    End New
End Class

// What no @Limits says: anything, as a Field's own type takes it.
Const NO_LIMIT: Float = 340282350000000000000000000000000000000.0

Function Unlimited(): Limits => Limits(-NO_LIMIT, NO_LIMIT)

Global registered: Registered[] = []

/// The members of an Enum, by number, as Load takes each, from 0 until `upTo`; none of anything else, nor
/// of an @Open or a @Flags Enum, which has more values than members. FutureBlitz has no way to list an
/// Enum's members yet, so one numbered below 0 or from `upTo` on isn't found.
Public Function MembersOf<E>(upTo: Int = 4096): E[]
    Local all: E[] = []
    For at = 0 Until upTo
        Try
            Local member = Try Load<E>(Value(at As Int64))
            Local name = Save(member).AsString()
            If name == Null Then Return []
            all.Add(member)
        Catch error As ParseError
            // A number no member has, which there can be some of between those that are.
        End Try
    End For
    Return all
End Function

// Whether `E` saves as a name, and only takes one it knows.
Function IsEnum<E>(): Bool
    Try
        Try Load<E>(Value("no member's called this"))
        Return False
    Catch error As ParseError
    End Try
    Try
        Return Save(Try Load<E>(Value(0 As Int64))).IsString
    Catch error As ParseError
        // Nothing's numbered 0, which is what's left of what isn't an Enum.
        Return True
    End Try
End Function

// What an integer type's values go between, as Load takes them, if they're few enough to find.
Function WholeBounds<F>(): Limits
    Local high: Int64 = 0
    For top In [127 As Int64, 255, 32767, 65535]
        Try
            Try Load<F>(Value(top + 1))
        Catch error As ParseError
            high = top
            Break
        End Try
    End For
    If high == 0 Then Return Unlimited()
    Try
        Try Load<F>(Value(-1 As Int64))
        Return Limits(-(high As Float) - 1, high As Float)
    Catch error As ParseError
        Return Limits(0, high As Float)
    End Try
End Function

// What's wrong with `value` for `field`, or Null: a number past what it takes, or one of an Object's or
// an array's.
Function OutOfLimits(field: ComponentField, value: Value): String?
    If field.Low == -NO_LIMIT && field.High == NO_LIMIT Then Return Null
    Local bounds = Limits(field.Low, field.High, field.Above)
    Local number = value.AsDouble()
    If number != Null && value.IsNumber
        Local float = number As Float
        Local takes = (bounds.Above ? float > bounds.Low : float >= bounds.Low) &&
                      float <= bounds.High
        Return takes ? Null : "{field.Name} can't be {number}"
    End If
    Local items = value.AsArray()
    If items != Null
        For item In items
            Local said = OutOfLimits(field, item)
            If said != Null Then Return said
        End For
        Return Null
    End If
    If !value.IsObject Then Return Null
    For key In value.Keys()
        Local part = value[key]
        If part == Null Then Continue
        Local said = OutOfLimits(field, part)
        If said != Null Then Return said
    End For
    Return Null
End Function

// What's known of `T` by its Public Fields, what they are at first as Load makes them from nothing.
Function Described<T: Class>(name: String): ComponentKind
    Local made: T
    Try
        made = Try Load<T>(Value.Object())
    Catch error As ParseError
        Panic("Components.Add: a {name} can't be made from nothing: {error.Message}")
    End Try
    Local fields: ComponentField[] = []
    For Field f: F In T
        Where f Has Set
        If f.Has(Skip) Then Continue
        Local first = Save(f.Get(made))
        Local members: String[] = []
        Local named = first.IsString && IsEnum<F>()
        If named
            For member In MembersOf<F>()
                members.Add(Save(member).AsString() ?? "")
            End For
        End If
        Local limits = f.Attribute(Limits) ?? (first.IsInteger ? WholeBounds<F>() : Unlimited())
        // By the key Save and Load know it by.
        Local key = f.Attribute(Rename)?.Name ?? f.Name
        fields.Add(ComponentField(key, first, named, members, limits.Low, limits.High,
                                  limits.Above, f.Has(ShownInDegrees)))
    End For
    Return ComponentKind(name, fields)
End Function

// Why `T` can't be added as `name`, or Null: an entity has one of each Class, so a Class under two names
// would lose one.
Function Taken<T: Class>(name: String): String?
    For each In registered
        If each.kind.Name == name Then Return "there's a {name} already"
        If (each.mark As? ClassMarkOf<T>) != Null
            Return "{name}'s Class is {each.kind.Name}'s already"
        End If
    End For
    Return Null
End Function

/// The kinds of component a game has. A game's program adds each at its start, and Attach makes one
/// from what's saved, as a scene loading does. So the editor, which can't run a game's code in itself,
/// knows them, a game's small program, its components/main.fb, adds them and ends with Describe.
///
/// A component is a Class Load can make from nothing, each Public Field a value it can Save, what
/// Load leaves it at being what a new one has. `@Skip` leaves a Field out; `@Limits` and
/// `@ShownInDegrees` on a Field say what they say on a setter, a `@Limits` of each number of a Field
/// of many. A Field set to Null is left out of a scene, which has no null, so it's read back as what
/// a new one has. A kind's own New is the game's code, so a panic in it, as Add or a Load makes one,
/// ends the program.
Public Final Class Components
    /// Adds `T` as the kind called `name`. Panics for a name that's there, for a `T` that's there under
    /// another, as an entity has one of each Class, or if Load can't make one from nothing.
    @MainThread @PanicsAtCaller
    Public Static Method Add<T: Class>(name: String)
        Local taken = Taken<T>(name)
        If taken != Null Then Panic("Components.Add: {taken}")
        registered.Add(Registered(Described<T>(name), ClassMarkOf<T>(),
                                  Function(entity: Entity, values: Value): String?
            Try
                entity.SetData<T>(Try Load<T>(values))
            Catch error As ParseError
                Return error.Message
            End Try
            Return Null
        End Function))
    End Method

    /// The kinds there are, in the order they were added.
    @MainThread Public Static Method Kinds(): ComponentKind[]
        Local kinds: ComponentKind[] = []
        For each In registered
            kinds.Add(each.kind)
        End For
        Return kinds
    End Method

    /// Lets go of every kind, as a test that added some does.
    @MainThread Public Static Method Clear()
        registered.Clear()
    End Method

    /// Puts a new component of the kind called `name` on `entity`, as Entity.Data gives it back, made
    /// from `values`, what's in an Object of its Fields. Gives what went wrong: a kind there isn't, a
    /// number past its `@Limits`, or what can't be loaded; Null if it went well.
    @MainThread @PanicsAtCaller
    Public Static Method Attach(entity: Entity, name: String, values: Value): String?
        For each In registered
            If each.kind.Name != name Then Continue
            For field In each.kind.Fields
                Local value = values[field.Name]
                Local said = value != Null ? OutOfLimits(field, value) : Null
                If said != Null Then Return "a {name}'s {said}"
            End For
            Return each.attach(entity, values)
        End For
        Return "there's no kind of component called {name}"
    End Method

    /// The kinds there are as JSON, as ComponentKind[] reads back.
    @MainThread Public Static Method Description(): String => Json.Write(Kinds())

    /// Says what kinds there are, as a game's components/main.fb ends with: printed, or for the editor,
    /// which runs it, where it asks.
    @MainThread Public Static Method Describe() Throws IOError
        Local to = Env.Get(DESCRIBE_TO)
        If to != Null && to != ""
            Try File.WriteText(Path(to), Description())
        Else
            Print(Description())
        End If
    End Method
End Class

Class TakenFirst
End Class

Class TakenSecond
End Class

@Test
Function OneClassHasOneNameAndOneNameOneClass()
    Components.Clear()
    Defer Components.Clear()
    Components.Add<TakenFirst>("first")
    Expect(Taken<TakenFirst>("other") == "other's Class is first's already")
    Expect(Taken<TakenSecond>("first") == "there's a first already")
    Expect(Taken<TakenSecond>("second") == Null)
End Function
