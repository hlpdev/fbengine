// Lights, as the data the renderer lights a World with.

Import std.core
Import std.ffi
Import std.math
Import "./c/fbe_scene"
Import "./entity"
Import "./window"

/// What a light is.
Public Enum LightType
    /// The sun's: from everywhere, along the light's forward axis.
    DIRECTIONAL = 0
    /// A bulb's: out from where the light is, to its range.
    POINT = 1
    /// A torch's: in a cone along the light's forward axis, to its range.
    SPOT = 2
End Enum

/// A light, shining along its forward axis, -Z, or out from where it is. New, it's white, of
/// intensity 1, of range 10, with a cone from 0 to 45 degrees from its axis. A hidden light
/// lights nothing.
Public Final Class Light Extends Entity
    /// A new Light of a type, the last child of `parent`, or at the top of the current World when
    /// `parent` is Null.
    @MainThread @PanicsAtCaller
    Public New(type: LightType = LightType.POINT, parent: Entity? = Null)
        Super.New(Create(parent, FBE_ENTITY_LIGHT))
        SetLightType(type)
    End New

    Package New(handle: UInt64)
        Super.New(handle)
    End New

    Override Package Method KindName(): String => "Light"

    /// Makes the light another type.
    @MainThread @PanicsAtCaller
    Public Method SetLightType(type: LightType)
        If !fbe_light_set_type(Live("SetLightType"), type As Int32) Then Failed("SetLightType")
    End Method

    /// What type of light it is.
    @MainThread @PanicsAtCaller
    Public Method LightType(): LightType => fbe_light_type(Live("LightType")) As LightType

    /// Sets the light's color, linear, as std.math's Color is; its alpha is left out. A color
    /// below 0 takes light away, as dark spots want.
    @MainThread @PanicsAtCaller
    Public Method SetColor(color: Color)
        If !fbe_light_set_color(Live("SetColor"), color.r, color.g, color.b) Then Failed("SetColor")
    End Method

    /// The light's color, with an alpha of 1.
    @MainThread @PanicsAtCaller
    Public Method Color(): Color
        Local light = Live("Color")
        Local found = fbe_color_t(0, 0, 0, 0)
        Local done = False
        Unsafe
            done = fbe_light_color(light, AddressOf(found))
        End Unsafe
        If !done Then Failed("Color")
        Return ColorOf(found)
    End Method

    /// Sets whether the light has shadows, on what's drawn per pixel: UNLIT and VERTEX, the
    /// fixed-function look, have none.
    @MainThread @PanicsAtCaller
    Public Method SetShadows(on: Bool)
        If !fbe_light_set_shadows(Live("SetShadows"), on) Then Failed("SetShadows")
    End Method

    /// Whether the light has shadows.
    @MainThread @PanicsAtCaller
    Public Method Shadows(): Bool => fbe_light_shadows(Live("Shadows"))

    /// Sets how many texels a side its shadows' tiles have, 16 to 8192, 1024 at first: a directional
    /// light has one for each cascade and a point light six. Lights past what the atlas holds have
    /// no shadows, the last first. Others panic.
    @MainThread @PanicsAtCaller
    Public Method SetShadowSize(size: Int32)
        If !fbe_light_set_shadow_size(Live("SetShadowSize"), size) Then Failed("SetShadowSize")
    End Method

    /// How many texels a side its shadows' tiles have.
    @MainThread @PanicsAtCaller
    Public Method ShadowSize(): Int32 => fbe_light_shadow_size(Live("ShadowSize"))

    /// Sets how far from a surface its shadows are compared, in depth, in world units, 0.02 at first,
    /// and along its normal, in texels, 1.5 at first, against a surface shadowing itself. Below 0
    /// panics.
    @MainThread @PanicsAtCaller
    Public Method SetShadowBias(depth: Float, normal: Float)
        If !fbe_light_set_shadow_bias(Live("SetShadowBias"), depth, normal)
            Failed("SetShadowBias")
        End If
    End Method

    /// How far from a surface in depth its shadows are compared, in world units.
    @MainThread @PanicsAtCaller
    Public Method ShadowBias(): Float => fbe_light_shadow_bias(Live("ShadowBias"))

    /// How far along a surface's normal its shadows are compared, in texels.
    @MainThread @PanicsAtCaller
    Public Method ShadowNormalBias(): Float =>
        fbe_light_shadow_normal_bias(Live("ShadowNormalBias"))

    /// Sets how many cascades a directional light's shadows have, 1 to 4, 3 at first. Others panic.
    @MainThread @PanicsAtCaller
    Public Method SetCascades(cascades: Int32)
        If !fbe_light_set_cascades(Live("SetCascades"), cascades) Then Failed("SetCascades")
    End Method

    /// How many cascades a directional light's shadows have.
    @MainThread @PanicsAtCaller
    Public Method Cascades(): Int32 => fbe_light_cascades(Live("Cascades"))

    /// Sets how far from the camera a directional light's shadows reach, 100 at first, or its far
    /// plane. One not above 0 panics.
    @MainThread @PanicsAtCaller
    Public Method SetShadowDistance(distance: Float)
        If !fbe_light_set_shadow_distance(Live("SetShadowDistance"), distance)
            Failed("SetShadowDistance")
        End If
    End Method

    /// How far from the camera a directional light's shadows reach.
    @MainThread @PanicsAtCaller
    Public Method ShadowDistance(): Float => fbe_light_shadow_distance(Live("ShadowDistance"))

    /// Sets how bright the light is, its color times this. Below 0 panics.
    @MainThread @PanicsAtCaller
    Public Method SetIntensity(intensity: Float)
        If !fbe_light_set_intensity(Live("SetIntensity"), intensity) Then Failed("SetIntensity")
    End Method

    /// How bright the light is.
    @MainThread @PanicsAtCaller
    Public Method Intensity(): Float => fbe_light_intensity(Live("Intensity"))

    /// Sets how far a point or spot light reaches, in its shading model's meaning. Per pixel, it's
    /// where it ends, a distance d away falling as glTF's KHR_lights_punctual,
    /// `clamp(1 - (d / range)^4, 0, 1)^2 / max(d^2, 0.0001)`. Per vertex, Shading.VERTEX, it's where
    /// it starts to fall, `min(range / d, 1)`, with no end, as Blitz's LightRange. One not above 0
    /// panics.
    @MainThread @PanicsAtCaller
    Public Method SetRange(range: Float)
        If !fbe_light_set_range(Live("SetRange"), range) Then Failed("SetRange")
    End Method

    /// How far a point or spot light reaches.
    @MainThread @PanicsAtCaller
    Public Method Range(): Float => fbe_light_range(Live("Range"))

    /// Sets a spot light's cone, in radians from its axis: where it starts to fade, `inner`, and
    /// where it's out, `outer`. Anything but 0 <= inner <= outer <= Pi / 2 panics.
    @MainThread @PanicsAtCaller
    Public Method SetCone(inner: Float, outer: Float)
        If !fbe_light_set_cone(Live("SetCone"), inner, outer) Then Failed("SetCone")
    End Method

    /// The angle from a spot light's axis where it starts to fade.
    @MainThread @PanicsAtCaller
    Public Method InnerCone(): Float => fbe_light_inner_cone(Live("InnerCone"))

    /// The angle from a spot light's axis where it's out.
    @MainThread @PanicsAtCaller
    Public Method OuterCone(): Float => fbe_light_outer_cone(Live("OuterCone"))
End Class

/// A C color as std.math's.
Package Function ColorOf(found: fbe_color_t): Color => Color(found.r, found.g, found.b, found.a)
