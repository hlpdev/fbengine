// The GPU fbengine draws with: which devices there are, which one it starts on, and starting it.

Import std.core
Import std.ffi
Import "./c/fbe_gpu"
Import "./window"

/// What kind of GPU a device is, as its driver says.
Public Enum GpuKind
    /// One its driver doesn't say.
    OTHER = 0
    /// Part of the CPU's chip, sharing its memory.
    INTEGRATED = 1
    /// A card of its own, with its own memory.
    DISCRETE = 2
    /// A virtual machine's.
    VIRTUAL = 3
    /// Software on the CPU, as lavapipe is.
    CPU = 4
End Enum

/// A device Vulkan has, as Gpu.Devices() found it.
Public Struct GpuDevice Implements Printable
    /// Its name, like "NVIDIA GeForce RTX 4080".
    Public Field Name: String
    /// What kind of GPU it is.
    Public Field Kind: GpuKind
    /// What it lacks of what fbengine needs, like "dynamic rendering", "" when it has it all.
    Public Field Lacks: String

    /// Whether the GPU can start on it.
    Public Method Usable(): Bool => Lacks == ""

    Public Method ToString(): String => "{Name} ({Kind})"
End Struct

/// What the last frame did, as a debug overlay shows it.
Public Struct GpuCounters
    /// The draws its passes recorded, and their triangles.
    Public Field Draws: Int64
    Public Field Triangles: Int64
    /// The bytes it uploaded: the pixels and data written into textures and buffers.
    Public Field Uploaded: Int64
    /// Its passes, what draws into a target or copies into a texture, and the image barriers
    /// between them.
    Public Field Passes: Int32
    Public Field Barriers: Int32
    /// The images transient targets have, kept for the frames that ask for them.
    Public Field TransientImages: Int32
    /// How long the GPU took over its commands, in milliseconds, a frame or two behind; -1 until
    /// it's known, and where the GPU writes no timestamps.
    Public Field GpuMilliseconds: Float32
End Struct

/// The GPU fbengine draws with, Vulkan 1.2 on a device that has dynamic rendering,
/// synchronization2, descriptor indexing, and buffer device addresses. It starts the first time something needs it:
/// Graphics, for a window that's shown; for a headless one, the first thing that draws, or Start.
Public Class Gpu
    Private New()
    End New

    /// The devices Vulkan has, in its order, which SetDevice takes the index of.
    @MainThread Public Static Method Devices(): GpuDevice[] Throws GraphicsError
        Local count = fbe_gpu_device_count()
        If count < 0 Then Throw GraphicsError(LastError())
        Local devices: GpuDevice[] = []
        For index = 0 To count - 1
            Unsafe
                devices.Add(GpuDevice(fbe_gpu_device_name(index).ToString(),
                                      fbe_gpu_device_kind(index) As GpuKind,
                                      fbe_gpu_device_lacks(index).ToString()))
            End Unsafe
        End For
        Return devices
    End Method

    /// Makes the GPU start on the device at `index` in Devices(), or with -1 on the best usable
    /// one, a discrete GPU first, which is what it does unless told; it panics once the GPU has
    /// started, and for an index Devices() doesn't have.
    @MainThread Public Static Method SetDevice(index: Int32)
        If !fbe_gpu_set_device(index) Then Panic(LastError())
    End Method

    /// The index in Devices() of the device the GPU started on, or of the one it will start on,
    /// -1 for the best.
    @MainThread Public Static Method Device(): Int32 => fbe_gpu_device()

    /// Starts the GPU now, if it hasn't started, with a swapchain for the window if it's open. If it
    /// can't, it never will, and throws why each time.
    @MainThread Public Static Method Start() Throws GraphicsError
        If !fbe_gpu_start() Then Throw GraphicsError(LastError())
    End Method

    /// Stops the GPU, if it's started, freeing everything it made, the window's swapchain first;
    /// the window stays open, Flip presents nothing, and the GPU can start again, on the device
    /// SetDevice says then.
    @MainThread Public Static Method Stop()
        fbe_gpu_stop()
    End Method

    /// Whether the GPU has started.
    @MainThread Public Static Method Started(): Bool => fbe_gpu_started()

    /// How many times the GPU's been stopped since the program started, so with Started, whether
    /// it ever has.
    @MainThread Public Static Method Stops(): UInt64 => fbe_gpu_stops()

    /// Whether there's to be no GPU at all, as for a dedicated server, set before anything starts
    /// it: then Vulkan's never loaded and no device is made, so it needs no driver, loader, or
    /// display. What would start it, a Texture or a shown Window, throws or panics saying "the GPU
    /// is disabled"; a Model's loaded without its images, its materials keeping their factors, and
    /// TextureOf Null. World, entities, picks, scenes, physics, and audio on MANUAL need none. It
    /// panics if the GPU's started; Stop it first.
    @MainThread Public Static Method SetDisabled(disable: Bool)
        If !fbe_gpu_set_disabled(disable) Then Panic(LastError())
    End Method

    /// Whether SetDisabled said there's to be no GPU.
    @MainThread Public Static Method Disabled(): Bool => fbe_gpu_disabled()

    /// Whether the GPU was lost, as a driver's crash or reset loses it: from then on nothing
    /// draws, and nothing's asked of the driver, until Stop and Start make it again. A draw (a
    /// Camera's Render, a Canvas's), a clear, a copy, or a write into a texture does nothing and
    /// doesn't panic, and Flip shows nothing; what makes something on the GPU, as a new Texture or
    /// an Environment's bake, or reads it back, as ReadPixels, and LockPixels after a write or a
    /// draw into the texture, throws or panics, saying the GPU was lost. A setting, as SetLodBias,
    /// is kept, in force once the GPU's made again, and a call's own mistake panics as it would on
    /// a GPU that isn't lost. Nothing made on it before is left, so a game makes its textures
    /// again. Nothing makes it again but the game: its loop does, each frame before it draws, as
    /// the editor's does, trying again later if Start throws:
    ///
    /// ```vb
    /// Flip()
    /// If Gpu.Lost()
    ///     Gpu.Stop()
    ///     Try? Gpu.Start()
    /// End If
    /// ```
    @MainThread Public Static Method Lost(): Bool => fbe_gpu_lost()

    /// Loses the GPU, as a driver's crash or reset does, for a game's tests of what it does then:
    /// Lost from then on, until Stop and Start make it again. It throws GraphicsError unless the
    /// GPU's started.
    @MainThread Public Static Method SimulateLoss() Throws GraphicsError
        If !fbe_gpu_simulate_loss() Then Throw GraphicsError(LastError())
    End Method

    /// How many bytes of the GPU's own memory the program can use, as the driver says where it
    /// can, or else most of it; -1 before the GPU starts.
    @MainThread Public Static Method MemoryBudget(): Int64 => fbe_gpu_memory_budget()

    /// How many bytes of the GPU's own memory the program uses, which counts against its budget;
    /// -1 before the GPU starts.
    @MainThread Public Static Method MemoryUsage(): Int64 => fbe_gpu_memory_usage()

    /// What the last frame did, as a debug overlay shows it.
    @MainThread Public Static Method Counters(): GpuCounters
        Local counters = fbe_gpu_counters_t(0, 0, 0, 0, 0, 0, -1.0)
        Unsafe
            fbe_gpu_counters(AddressOf(counters))
        End Unsafe
        Return GpuCounters(counters.draws, counters.triangles, counters.uploaded, counters.passes,
                           counters.barriers, counters.transient_images, counters.gpu_milliseconds)
    End Method

    /// The name of the device the GPU started on, "" before it starts.
    @MainThread Public Static Method Name(): String
        If !fbe_gpu_started() Then Return ""
        Unsafe
            Return fbe_gpu_device_name(fbe_gpu_device()).ToString()
        End Unsafe
    End Method

    /// The kind of device the GPU started on, OTHER before it starts.
    @MainThread Public Static Method Kind(): GpuKind
        If !fbe_gpu_started() Then Return GpuKind.OTHER
        Return fbe_gpu_device_kind(fbe_gpu_device()) As GpuKind
    End Method

    /// How many frames Flip has presented in the window, which it doesn't while the window's
    /// minimized.
    @MainThread Public Static Method Presented(): Int64 => fbe_gpu_presented()

    /// Keeps the pipelines the GPU makes in the file at `path`, so they're made faster the next time
    /// the program runs: it's read as the GPU starts, if this GPU and driver wrote it, and written
    /// at the Flip after new pipelines are made. "" keeps none. By default it's the user's cache
    /// folder's fbengine/<program>/pipelines.bin: LOCALAPPDATA on Windows, ~/Library/Caches on
    /// macOS, and XDG_CACHE_HOME or ~/.cache elsewhere.
    @MainThread Public Static Method SetPipelineCache(path: String)
        fbe_gpu_set_pipeline_cache(path)
    End Method

    /// The file the GPU keeps its pipelines in, "" for none.
    @MainThread Public Static Method PipelineCache(): String
        Unsafe
            Return fbe_gpu_pipeline_cache().ToString()
        End Unsafe
    End Method

    /// How many pipelines the GPU has made: one for each way of drawing, which a debug overlay
    /// can show.
    @MainThread Public Static Method Pipelines(): Int32 => fbe_gpu_pipelines()

    /// Biases which mipmap every texture is read from, added to the one the GPU picks: negative
    /// is sharper, and can shimmer, positive blurrier, as a texture detail setting wants; from -16
    /// to 16. What a GPU's samplers can't take, all of it on a Mac's, a scene's layers and maps take
    /// in their shader, and shadows' cut-outs; a canvas's textures don't, and a sky's texture is never
    /// biased. It panics for one outside, and throws, keeping the bias it had, when the GPU can't make
    /// samplers with it. Set while the GPU's Lost, it's in force once Start makes the GPU again.
    @MainThread Public Static Method SetLodBias(bias: Float32) Throws GraphicsError
        If !(bias >= -16.0 && bias <= 16.0) Then Panic("a LOD bias is -16 to 16, not {bias}")
        If !fbe_gpu_set_lod_bias(bias) Then Throw GraphicsError(LastError())
    End Method

    /// How every texture's mipmaps are biased, 0 unless set.
    @MainThread Public Static Method LodBias(): Float32 => fbe_gpu_lod_bias()

    /// Sets the most anisotropic filtering textures filtered LINEAR get, sharper at glancing
    /// angles: 1 for none, the default, up to 16, which MaxAnisotropy clamps. It panics for one
    /// outside, and throws, keeping what it had, when the GPU can't make samplers with it. Set
    /// while the GPU's Lost, it's in force once Start makes the GPU again.
    @MainThread Public Static Method SetAnisotropy(anisotropy: Float32) Throws GraphicsError
        If !(anisotropy >= 1.0 && anisotropy <= 16.0)
            Panic("anisotropy is 1, for none, to 16, not {anisotropy}")
        End If
        If !fbe_gpu_set_anisotropy(anisotropy) Then Throw GraphicsError(LastError())
    End Method

    /// The most anisotropic filtering textures get, as set.
    @MainThread Public Static Method Anisotropy(): Float32 => fbe_gpu_anisotropy()

    /// The most anisotropic filtering the GPU has, 1 if it has none, and 0 before it starts.
    @MainThread Public Static Method MaxAnisotropy(): Float32 => fbe_gpu_max_anisotropy()

    /// Whether Vulkan's validation layers check what the GPU's asked to do: in a debug build of
    /// fbengine's DLL when they're installed, or when the FBE_GPU_VALIDATION variable is 1, and
    /// never when it's 0.
    @MainThread Public Static Method Validating(): Bool => fbe_gpu_validating()

    /// How many errors the validation layers have found since the program started, each printed
    /// as it's found.
    @MainThread Public Static Method ValidationErrors(): Int32 => fbe_gpu_validation_errors()
End Class
