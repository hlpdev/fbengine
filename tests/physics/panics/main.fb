// What fbengine_physics panics for, one a run, by its argument, which ctest checks the message
// of, or the exit code of.

Import std.core
Import std.math
Import std.os
Import fbengine_physics

Local which = Process.Arguments()[0]
Local world = PhysicsWorld()
Select which
    Case "step-nan"
        world.Step(NaN)
    Case "step-infinity"
        world.Step(Inf)
    Case "step-huge"
        world.Step(1e30)
    Case "step-freed"
        world.Free()
        world.Step(NaN)
    Case "with-a-world"
        // A game that panics with a world of a body, a joint, and a character still in it, which
        // exits as a panic does, at 101.
        Local door = Body(world, Shape.Box(Vec3(1, 2, 0.1)), Motion.DYNAMIC, Vec3(0.5, 1, -3))
        Joint.Hinge(door, Null, Vec3(0, 1, -3), Vec3(0, 1, 0))
        Character(world, Shape.Capsule(1.8, 0.3), Vec3(0, 0.9, 0))
        world.Step(1.0 / 60)
        Panic("the game's own mistake")
End Select
Print("{which} didn't panic")
