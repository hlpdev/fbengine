// A game whose build step is fbengine_tools': it reads its files through the module the step makes,
// which tests/CMakeLists.txt runs, built both ways.

Import std.core
Import fbengine
Import "./res" As Res

Try
    Res.Mount()
    Print(Try Assets.ReadText(Res.Hello))
    Print((Try Assets.ReadBytes(Res.Textures.Wall))[0] == 0xAB ? "cooked" : "as it is")
Catch e As IOError
    Print("couldn't read them: {e.Message}")
End Try
