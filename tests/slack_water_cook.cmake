# Slack Water's release, built once for every test of what it cooks, which then reads that pak. Takes FB,
# SOURCE, and BUDGET, the seconds a whole cook may take: it says what each file took to cook, from the
# step's cook-times.txt, the slowest first, and fails past the budget.
execute_process(COMMAND "${FB}" --color never build --release "${SOURCE}" RESULT_VARIABLE built)
if(NOT built EQUAL 0)
  message(FATAL_ERROR "the release didn't build: ${built}")
endif()
file(GLOB_RECURSE times "${SOURCE}/build/steps/*/release/*/out/cook-times.txt")
if(NOT times)
  message(FATAL_ERROR "the release's step wrote no cook-times.txt")
endif()
list(GET times 0 first)
file(STRINGS "${first}" lines)
set(cooked "")
set(all "")
foreach(line IN LISTS lines)
  string(REGEX MATCH "^(.*) ([0-9.eE+-]+)$" matched "${line}")
  if(CMAKE_MATCH_1 STREQUAL "all")
    set(all "${CMAKE_MATCH_2}")
  else()
    list(APPEND cooked "${CMAKE_MATCH_2} ${CMAKE_MATCH_1}")
  endif()
endforeach()
list(SORT cooked COMPARE NATURAL ORDER DESCENDING)
foreach(each IN LISTS cooked)
  message(STATUS "cooked in ${each}")
endforeach()
message(STATUS "the whole cook took ${all} s, against a budget of ${BUDGET}")
if(all GREATER BUDGET)
  message(FATAL_ERROR "the cook took ${all} s, past its budget of ${BUDGET} s")
endif()
