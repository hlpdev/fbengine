# fetch.cmake's ways, none of which needs the network or waits: `cmake -P`, in a folder of its own, with
# FOLDER set. Run with WRONG set, it fetches what isn't what its hash says, which is fatal; with NEVER
# set, what's required and never there, which is too.
include("${CMAKE_CURRENT_LIST_DIR}/fetch.cmake")
file(MAKE_DIRECTORY "${FOLDER}")
file(WRITE "${FOLDER}/source.txt" "what's pinned")
file(SHA256 "${FOLDER}/source.txt" pinned)

# Each wait's noted, and the wait named by APPEARS_AFTER brings the file that was missing.
set_property(GLOBAL PROPERTY waited "")
function(fbengine_khronos_wait seconds)
  set_property(GLOBAL APPEND PROPERTY waited "${seconds}")
  get_property(waited GLOBAL PROPERTY waited)
  list(LENGTH waited waits)
  if(waits EQUAL APPEARS_AFTER)
    file(COPY_FILE "${FOLDER}/source.txt" "${FOLDER}/late.txt")
  endif()
endfunction()
function(check_waited expected)
  get_property(waited GLOBAL PROPERTY waited)
  if(NOT "${waited}" STREQUAL "${expected}")
    message(FATAL_ERROR "waited '${waited}', not '${expected}'")
  endif()
  set_property(GLOBAL PROPERTY waited "")
endfunction()

if(WRONG)
  fbengine_fetch_khronos("file://${FOLDER}/source.txt" "${FOLDER}/wrong.txt" "${pinned}0" FALSE fetched)
  message(STATUS "a wrong hash went by")
  return()
endif()
if(NEVER)
  set(APPEARS_AFTER 0)
  fbengine_fetch_khronos("file://${FOLDER}/never.txt" "${FOLDER}/never_got.txt" "${pinned}" TRUE fetched)
  message(STATUS "what's required and never there went by")
  return()
endif()
# Unreachable: nothing listens on port 9. Not required, so it isn't tried again.
set(APPEARS_AFTER 0)
file(REMOVE "${FOLDER}/gone.txt")
fbengine_fetch_khronos("http://127.0.0.1:9/gone.txt" "${FOLDER}/gone.txt" "${pinned}" FALSE fetched)
if(fetched OR EXISTS "${FOLDER}/gone.txt")
  message(FATAL_ERROR "what can't be reached was taken as fetched")
endif()
check_waited("")
# What's there, by its hash.
file(REMOVE "${FOLDER}/got.txt")
fbengine_fetch_khronos("file://${FOLDER}/source.txt" "${FOLDER}/got.txt" "${pinned}" FALSE fetched)
if(NOT fetched OR NOT EXISTS "${FOLDER}/got.txt")
  message(FATAL_ERROR "what's there wasn't fetched")
endif()
check_waited("")
# Required, and there the first time: no waiting.
file(REMOVE "${FOLDER}/got.txt")
fbengine_fetch_khronos("file://${FOLDER}/source.txt" "${FOLDER}/got.txt" "${pinned}" TRUE fetched)
if(NOT fetched)
  message(FATAL_ERROR "what's required and there wasn't fetched")
endif()
check_waited("")
# Already here, as a cache's would be: not fetched again, from a source that isn't there.
fbengine_fetch_khronos("file://${FOLDER}/not_there.txt" "${FOLDER}/got.txt" "${pinned}" TRUE fetched)
if(NOT fetched)
  message(FATAL_ERROR "what's already here wasn't taken")
endif()
check_waited("")
# Here but not what's pinned, as a stale cache's would be: fetched again.
file(WRITE "${FOLDER}/got.txt" "what isn't")
fbengine_fetch_khronos("file://${FOLDER}/source.txt" "${FOLDER}/got.txt" "${pinned}" TRUE fetched)
file(SHA256 "${FOLDER}/got.txt" got)
if(NOT fetched OR NOT got STREQUAL pinned)
  message(FATAL_ERROR "what's here and not what's pinned stayed")
endif()
check_waited("")
# Required, and there after failing twice: it's tried again, longer apart.
set(APPEARS_AFTER 2)
file(REMOVE "${FOLDER}/late.txt" "${FOLDER}/late_got.txt")
fbengine_fetch_khronos("file://${FOLDER}/late.txt" "${FOLDER}/late_got.txt" "${pinned}" TRUE fetched)
file(SHA256 "${FOLDER}/late_got.txt" got)
if(NOT fetched OR NOT got STREQUAL pinned)
  message(FATAL_ERROR "what came on its third try wasn't fetched")
endif()
check_waited("5;20")
# On its last try, the same.
set(APPEARS_AFTER 3)
file(REMOVE "${FOLDER}/late.txt" "${FOLDER}/late_got.txt")
fbengine_fetch_khronos("file://${FOLDER}/late.txt" "${FOLDER}/late_got.txt" "${pinned}" TRUE fetched)
if(NOT fetched OR NOT EXISTS "${FOLDER}/late_got.txt")
  message(FATAL_ERROR "what came on its last try wasn't fetched")
endif()
check_waited("5;20;60")
message(STATUS "fetch's ways are as they should be")
