# Fetches one of Khronos's files into `to`, checked by its SHA-256, and sets `result` to whether it's
# there. One that can't be reached is left out, with a warning, as offline, or fatal if `required`;
# one that isn't what its hash says is always fatal, as what's there isn't what was pinned.
function(fbengine_fetch_khronos url to hash required result)
  if(EXISTS "${to}")
    file(SHA256 "${to}" got)
    if(got STREQUAL hash)
      set(${result} TRUE PARENT_SCOPE)
      return()
    endif()
  endif()
  file(DOWNLOAD "${url}" "${to}" STATUS status INACTIVITY_TIMEOUT 30 TLS_VERIFY ON)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    file(REMOVE "${to}")
    list(GET status 1 why)
    if(required)
      message(FATAL_ERROR "couldn't fetch ${url}: ${why}")
    endif()
    message(WARNING "couldn't fetch ${url}: ${why}; the khronos tests are left out")
    set(${result} FALSE PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${to}" got)
  if(NOT got STREQUAL hash)
    file(REMOVE "${to}")
    message(FATAL_ERROR "${url} is ${got}, not the ${hash} it's pinned to")
  endif()
  set(${result} TRUE PARENT_SCOPE)
endfunction()
