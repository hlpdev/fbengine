# Fetches one of Khronos's files into `to`, checked by its SHA-256, and sets `result` to whether it's
# there. One that can't be reached is left out at once, with a warning, as offline, so configuring
# there doesn't wait; if `required` it's tried again, longer apart each time, as one slow fetch
# shouldn't lose a whole CI job, and is fatal after that. One that isn't what its hash says is always
# fatal, as what's there isn't what was pinned.
set(fbengine_khronos_waits 5 20 60)

# A function of its own so that fetch_test.cmake can take its place, and not wait.
function(fbengine_khronos_wait seconds)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep "${seconds}")
endfunction()

function(fbengine_fetch_khronos url to hash required result)
  if(EXISTS "${to}")
    file(SHA256 "${to}" got)
    if(got STREQUAL hash)
      set(${result} TRUE PARENT_SCOPE)
      return()
    endif()
  endif()
  set(waits "")
  if(required)
    set(waits ${fbengine_khronos_waits})
  endif()
  set(tries 1)
  while(TRUE)
    file(DOWNLOAD "${url}" "${to}" STATUS status INACTIVITY_TIMEOUT 30 TLS_VERIFY ON)
    list(GET status 0 code)
    if(code EQUAL 0)
      break()
    endif()
    file(REMOVE "${to}")
    list(GET status 1 why)
    if(NOT waits)
      if(required)
        message(FATAL_ERROR "${tries} tries, couldn't fetch ${url}: ${why}")
      endif()
      message(WARNING "couldn't fetch ${url}: ${why}; the khronos tests are left out")
      set(${result} FALSE PARENT_SCOPE)
      return()
    endif()
    list(POP_FRONT waits wait)
    message(STATUS "couldn't fetch ${url}: ${why}; trying again in ${wait} s")
    fbengine_khronos_wait("${wait}")
    math(EXPR tries "${tries} + 1")
  endwhile()
  file(SHA256 "${to}" got)
  if(NOT got STREQUAL hash)
    file(REMOVE "${to}")
    message(FATAL_ERROR "${url} is ${got}, not the ${hash} it's pinned to")
  endif()
  set(${result} TRUE PARENT_SCOPE)
endfunction()
