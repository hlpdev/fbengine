// The scene's panics, each a mistake a game can make, which fb test can't catch: ctest runs this
// with a case's name and checks it panics with the case's message.

Import std.core
Import std.math
Import std.os
Import fbengine

Local arguments = Process.Arguments()
If arguments.Count != 1 Then Panic("give the case to run")

Local world = World()
World.SetCurrent(world)
Select arguments[0]
    Case "freed-entity"
        Local pivot = Pivot()
        pivot.Free()
        pivot.SetName("x")
    Case "freed-with-parent"
        Local parent = Pivot()
        Local child = Pivot(parent)
        parent.Free()
        Print(child.Name())
    Case "new-under-freed"
        Local parent = Pivot()
        parent.Free()
        Pivot(parent)
    Case "freed-world"
        world.Free()
        world.Roots()
    Case "current-freed"
        world.Free()
        World.SetCurrent(world)
    Case "free-main"
        World.Main().Free()
    Case "own-parent"
        Local pivot = Pivot()
        pivot.SetParent(pivot)
    Case "under-itself"
        Local top = Pivot()
        Local bottom = Pivot(Pivot(top))
        top.SetParent(bottom)
    Case "child-out-of-range"
        Local parent = Pivot()
        Pivot(parent)
        Pivot(parent)
        parent.Child(2)
    Case "data-freed"
        Local pivot = Pivot()
        pivot.Free()
        pivot.Data<World>()
    Case "poses-count"
        Entity.SetPoses([Pivot() As Entity], [], Space.WORLD)
    Case "poses-freed"
        Local pivot = Pivot()
        pivot.Free()
        Entity.Poses([pivot As Entity], Space.WORLD)
    Case "into-nothing"
        Local flat = Pivot()
        flat.SetScale(Vec3(1, 0, 1))
        TransformPoint(Vec3.Zero(), Null, flat)
    Case "turn-freed"
        Local pivot = Pivot()
        pivot.Free()
        pivot.Turn(0, 1, 0)
    Case "field-of-view"
        Camera().SetFieldOfView(0)
    Case "range"
        Camera().SetRange(5, 1)
    Case "viewport"
        Camera().SetViewport(Rect(0, 0, 0, 10))
    Case "no-window"
        Camera().Project(Vec3(0, 0, -1))
    Case "camera-freed"
        Local camera = Camera()
        camera.Free()
        camera.SetOrder(1)
    Case "intensity"
        Light().SetIntensity(-1)
    Case "light-range"
        Light().SetRange(0)
    Case "cone"
        Light().SetCone(1, 0.5)
    Case "fog-range"
        Camera().SetFogRange(5, 5)
    Case "fog-density"
        Camera().SetFogDensity(-0.1)
    Case "light-freed"
        Local light = Light()
        light.Free()
        light.SetColor(Color.Red)
    Default
        Panic("no case {arguments[0]}")
End Select
Print("no panic")
