// fbengine_ui's cases that need a process of their own, which ctest runs by name and checks
// against what they print: what panics, and what's set before the window opens.

Import std.core
Import std.math
Import std.os
Import fbengine
Import fbengine_ui

// A field that draws the IME's composition at its cursor, read back: each line says what's where.
Function Composing() Throws GraphicsError, IOError
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("underlined True, cursor True, typed a")
        Return
    End If
    SetDrawsComposition(True)
    Window.SetHeadless(True)
    Try Graphics(200, 100)
    Local root = Node("root")
    root.SetArrangement(Arrangement.STACK)
    Local field = TextField("a")
    field.SetTranslates(False)
    field.SetSize(150.0, 16.0)
    field.SetAnchors(Anchors.Point(0.0, 0.0))
    root.Add(field)
    Local ui = Ui(root, Theme())
    ui.SetFont("",
               Try Font.Load("{Env.Get("FBENGINE_OWN_TEST_FONTS") ?? ""}/FbeTestText-Regular.ttf",
                             16.0))
    Local frame = Function()
        Flip()
        ui.Update()
        Local canvas = Screen.Canvas()
        canvas.SetColor(Color32(0, 0, 0, 255))
        canvas.Clear()
        ui.Draw()
    End Function
    frame()
    ui.Focus(field)
    frame()
    // "bb" after the a: its underline from a's 8 pixels to 9.6 of each b more, and the cursor after
    // the first b, in the gap between its box and the next's.
    Try Simulate.Composition("bb", 1, 0)
    frame()
    Local image = Try Screen.ToImage()
    Local black = Color32(0, 0, 0, 255)
    Local underlined = image[8, 15] != black && image[26, 15] != black
    Local before = image[7, 15] == black
    Local after = image[28, 15] == black
    // At 17.6, so column 18, in the row above any glyph.
    Local cursor = image[18, 1] != black && image[20, 1] == black
    Print("underlined {underlined && before && after}, cursor {cursor}, typed {field.Text()}")
    // A screen half the window's size: its underline's still a pixel, on any row.
    Screen.SetSize(100, 50)
    field.SetMargin(Insets(0.0, 3.0, 0.0, 0.0))
    frame()
    frame()
    image = Try Screen.ToImage()
    Local shown = False
    // Below the glyphs' baseline, 3 + 12.8 units down, so 8 pixels.
    For y = 8 To 12
        If image[5, y] != black && image[8, y] != black && image[12, y] != black Then shown = True
    End For
    Print("half size, underlined {shown}")
    EndGraphics()
End Function

// A composition doesn't follow the focus into another field: its text input stops and starts.
Function ComposingMoved() Throws GraphicsError
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("composing bb, then none")
        Return
    End If
    SetDrawsComposition(True)
    Window.SetHeadless(True)
    Try Graphics(200, 100)
    Local root = Node("root")
    Local first = TextField("a")
    Local second = TextField("b")
    root.Add(first)
    root.Add(second)
    Local ui = Ui(root)
    ui.Focus(first)
    Flip()
    ui.Update()
    Try Simulate.Composition("bb")
    Flip()
    ui.Update()
    Local had = TextComposition().Text
    ui.Focus(second)
    ui.Update()
    Flip()
    ui.Update()
    Print("composing {had}, then {TextComposition().Text == "" ? "none" : "kept"}")
    EndGraphics()
End Function

// A widget that ends a clip it didn't push.
Class PopsTooMany Extends Widget
    New()
        Super.New("panel", "greedy")
        SetSize(10.0, 10.0)
    End New

    @MainThread Public Override Method Draw(paint: Painter)
        paint.PopClip()
    End Method
End Class

Function PoppedTooMany() Throws GraphicsError
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Panic("Painter.PopClip: Node \"greedy\" ends a clip it didn't push")
    End If
    Window.SetHeadless(True)
    Try Graphics(100, 100)
    Local root = Node("root")
    root.SetAlign(Align.START)
    root.Add(PopsTooMany())
    Local ui = Ui(root)
    Flip()
    ui.Update()
    ui.Draw()
End Function

Local arguments = Process.Arguments()
Local name = arguments.Count > 0 ? arguments[0] : ""
Select name
    Case "add-twice"
        // Its first parent kept, since a child of one that's gone has no parent.
        Local child = Node("child")
        Local first = Node("a")
        first.Add(child)
        Node("b").Add(child)
    Case "add-into-itself"
        Local outer = Node("outer")
        Local inner = Node("inner")
        outer.Add(inner)
        inner.Add(outer)
    Case "insert-out-of-range"
        Node("a").Insert(1, Node("b"))
    Case "fixed-negative"
        Sizing.Fixed(-1.0)
    Case "fill-zero"
        Sizing.Fill(0.0)
    Case "fraction-past-one"
        Sizing.Fraction(1.5)
    Case "style-empty-name"
        Theme().SetStyle("button.", Style.Plain())
    Case "set-width-unchecked"
        Node("a").SetWidth(Sizing(SizeMode.FILL, 0.0))
    Case "min-size-nan"
        Node("a").SetMinSize(NaN, 0.0)
    Case "padding-negative"
        Node("a").SetPadding(Insets.All(-1.0))
    Case "margin-infinite"
        Node("a").SetMargin(Insets(0.0, Inf, 0.0, 0.0))
    Case "anchors-backward"
        Node("a").SetAnchors(Anchors(1.0, 0.0, 0.0, 1.0))
    Case "style-negative-border"
        Local style = Style.Plain()
        style.BorderWidth = -1.0
        Theme().SetStyle("x", style)
    Case "style-nan-font-size"
        Local style = Style.Plain()
        style.FontSize = NaN
        Theme().SetStyle("x", style)
    Case "style-negative-padding"
        Local style = Style.Plain()
        style.Padding = Insets(0.0, -2.0, 0.0, 0.0)
        Theme().SetStyle("x", style)
    Case "max-size-negative"
        Node("a").SetMaxSize(-1.0, 0.0)
    Case "gap-infinite"
        Node("a").SetGap(Inf)
    Case "content-size-nan"
        Node("a").SetContentSize(NaN, 0.0)
    Case "anchor-nan"
        Node("a").SetAnchors(Anchors(NaN, 0.0, 1.0, 1.0))
    Case "slider-range-backward"
        Slider(0.0, 1.0, 0.0).SetRange(2.0, 1.0)
    Case "slider-range-too-wide"
        Slider(0.0, 1.0, 0.0).SetRange(-3e38, 3e38)
    Case "slider-step-negative"
        Slider(0.0, 1.0, 0.0).SetStep(-1.0)
    Case "max-length-negative"
        TextField().SetMaxLength(-1)
    Case "wheel-step-zero"
        ScrollView("view").SetWheelStep(0.0)
    Case "scale-zero"
        Ui(Node("root")).SetScale(0.0)
    Case "command-with-a-space"
        Console().Register("give item", "", Function(console: Console, words: String[]) => "")
    Case "debug-row-two-kinds"
        Local panel = DebugPanel()
        panel.Watch("mode", "noclip")
        panel.Switch("mode", True)
    Case "console-no-lines"
        Console().SetMaxLines(0)
    Case "strings-fall-back-to-themselves"
        Local english = Strings("en")
        Local french = Strings("fr")
        french.SetFallback(english)
        english.SetFallback(french)
    Case "composition"
        Try Composing()
    Case "composition-moved"
        Try ComposingMoved()
    Case "pop-clip-too-many"
        Try PoppedTooMany()
    Default
        Panic("no case {name}")
End Select
