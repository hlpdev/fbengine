// Animation's panics, each a mistake a game can make, which fb test can't catch: ctest runs this
// with a case's name and checks it panics with the case's message.

Import std.core
Import std.math
Import std.os
Import fbengine

Local arguments = Process.Arguments()
If arguments.Count != 1 Then Panic("give the case to run")

Local world = World()
World.SetCurrent(world)
Local nothing = Vec3(0, 0, 0)
Select arguments[0]
    Case "frame-rate"
        Clip("", -1)
    Case "unpaired"
        Clip().AddPositions("a", [0, 1], [nothing])
    Case "untangented"
        Clip().AddRotations("a", [0], [Quat.Identity], Interpolation.CUBIC)
    Case "tangents-unpaired"
        Clip().AddScales("a", [0], [nothing], [nothing], [])
    Case "times-falling"
        Clip().AddPositions("a", [1, 1], [nothing, nothing])
    Case "moved-twice"
        Local clip = Clip()
        clip.AddScales("a", [0], [nothing])
        clip.AddScales("a", [0], [nothing])
    Case "clip-freed"
        Local clip = Clip()
        clip.Free()
        clip.Length()
    Case "player-of-freed"
        Local pivot = Pivot()
        pivot.Free()
        pivot.Player()
    Case "player-entity-freed"
        Local pivot = Pivot()
        Local player = pivot.Player()
        pivot.Free()
        player.SetTime(1)
    Case "frame-no-clip"
        Pivot().Player().SetFrame(1)
    Case "frame-no-rate"
        Local clip = Clip("no rate")
        clip.AddPositions("a", [0, 1], [Vec3(0, 0, 0), Vec3(1, 0, 0)])
        Local player = Pivot().Player()
        player.Play(clip)
        player.SetFrame(1)
    Case "time-nan"
        Pivot().Player().SetTime(NaN)
    Case "update-negative"
        UpdateWorld(-1)
    Case "palette-unskinned"
        Mesh(Null).Palette()
    Case "joint-twice"
        Local skin = Skin()
        skin.AddJoint("a", Mat4.Identity)
        skin.AddJoint("a", Mat4.Identity)
    Case "joint-out-of-range"
        Skin().JointName(0)
    Case "release-freed"
        Local bone = Pivot()
        bone.Free()
        Pivot().Player().Release(bone)
    Case "weights-uneven"
        Clip().AddWeights("a", [0, 1], [0, 0, 1])
    Case "target-short"
        Local surface = Geometry().AddSurface()
        surface.AddMorphTarget([nothing])
    Case "morphed-nothing"
        Mesh(Null).MorphedPositions()
    Case "layer-out-of-range"
        Pivot().Player().Layer(16)
    Case "crossfade-negative"
        Pivot().Player().Crossfade(Clip(), -1)
    Case "weight-outside"
        Pivot().Player().Layer(1).SetWeight(2)
    Case "event-out-of-range"
        Clip().EventName(0)
    Case "slice-backward"
        Clip().Slice(2, 1)
    Default
        Panic("no case {arguments[0]}")
End Select
