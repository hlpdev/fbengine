// Written by reference.py, from the glTF specification alone: where each frame should be.

Import std.math

// A frame of a sample model, and where it should be.
Package Struct Worked
    Package Field Folder: String
    Package Field Node: String
    Package Field Index: Int
    Package Field Time: Float
    Package Field Weight: Float
    Package Field Camera: Vec3
    Package Field Look: Vec3
    Package Field Low: Vec3
    Package Field High: Vec3
    Package Field Mean: Vec3
    Package Field Left: Int
    Package Field Top: Int
    Package Field Right: Int
    Package Field Bottom: Int
End Struct

// Time and Weight are below 0 for none.
Package Function WorkedOut(): Worked[]
    Local frames: Worked[] = []
    frames.Add(Worked("SimpleSkin", "node_0", 0, 0, -1, Vec3(0, 1, 6), Vec3(0, 1, 0),
                      Vec3(-0.5, 0, 0), Vec3(0.5, 2, 0),
                      Vec3(0, 1, 0), 109, 91, 146, 164))
