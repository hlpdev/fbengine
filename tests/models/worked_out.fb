    Package Field Camera: Vec3
    Package Field Look: Vec3
    Package Field Low: Vec3
    Package Field High: Vec3
    Package Field Mean: Vec3
    // Where its mask's runs start in masks.bin, and how many.
    Package Field Runs: Int
    Package Field RunCount: Int
End Struct

