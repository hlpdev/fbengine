// Written by reference.py, from the glTF specification: where each frame should be.

Import std.math

// A frame of a sample model, and where it should be.
Package Struct Worked
    Package Field Folder: String
    Package Field Node: String
    Package Field Index: Int
    Package Field Time: Float
    Package Field Weight: Float
    // Which of its clips Time is in, by its place in the file.
    Package Field Clip: Int
    Package Field Camera: Vec3
    Package Field Look: Vec3
    Package Field Low: Vec3
    Package Field High: Vec3
    Package Field Mean: Vec3
    // Where its mask's runs start in masks.bin, and how many.
    Package Field Runs: Int
    Package Field RunCount: Int
    // Its light's intensity and range, and pixels it lights, each x, y, red, green, and blue, as
    // stored.
    Package Field Intensity: Float
    Package Field Range: Float
    Package Field Lit: Int[]
    // Pixels, by y * 256 + x, on an edge, which its mask leaves out.
    Package Field Edges: Int[]
End Struct

