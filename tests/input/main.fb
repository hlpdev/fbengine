// Input's and 2D collisions' cases that need a process of their own, which ctest runs by name and
// checks against what they print: what panics, and what's set before the video starts.

Import std.core
Import std.image
Import std.math
Import std.os
Import fbengine

Function Main() Throws GraphicsError, InputError
    Local arguments = Process.Arguments()
    Local name = arguments.Count > 0 ? arguments[0] : ""
    Select name
        Case "key-out-of-range"
            Window.SetHeadless(True)
            Try Graphics(320, 200)
            Try Simulate.KeyDown(9999 As Key)
        Case "button-out-of-range"
            Window.SetHeadless(True)
            Try Graphics(320, 200)
            Try Simulate.MouseDown(33 As MouseButton)
        Case "draws-composition"
            Print("draws {DrawsComposition()}")
            SetDrawsComposition(True)
            Print("draws {DrawsComposition()}")
            Window.SetHeadless(True)
            Try Graphics(320, 200)
            // Saying it again is nothing; changing it now is a mistake.
            SetDrawsComposition(True)
            Print("draws {DrawsComposition()}")
            SetDrawsComposition(False)
        Case "key-name-before-video"
            Window.SetHeadless(True)
            Local before = KeyName(Key.A)
            Try Graphics(320, 200)
            Print("{before} {KeyName(Key.A)}")
            // KeyName started the video, which knows the layout, so it's too late for this.
            Window.SetHeadless(False)
        Case "rumble-negative"
            Window.SetHeadless(True)
            Try Graphics(320, 200)
            Local virtual = Try Simulate.ConnectGamepad()
            Flip()
            virtual.Device().Rumble(1.0, 1.0, -1.0)
        Case "rumble-nan"
            Window.SetHeadless(True)
            Try Graphics(320, 200)
            Local virtual = Try Simulate.ConnectGamepad()
            Flip()
            virtual.Device().RumbleTriggers(1.0, 1.0, NaN As Float64)
        Case "joystick-sizes"
            Try Simulate.ConnectJoystick(JoystickType.WHEEL, 0, 256, 0)
        Case "pads-before-start"
            // A pad connected before SDL's gamepads start, as SDL's own virtual one is by the
            // call that starts them, connects once, at the next Flip, as a pad connected later does.
            Window.SetHeadless(True)
            Try Graphics(320, 200)
            Local virtual = Try Simulate.ConnectGamepad()
            Print("before a Flip {Gamepads().Count == 0 && GamepadsConnected().Count == 0}")
            Flip()
            Local listed = Gamepads().Count
            Print("each connects at the first {listed >= 1 && GamepadsConnected().Count == listed}")
            Flip()
            Flip()
            Print("and once {GamepadsConnected().Count == 0 && Gamepads().Count == listed}")
        Case "show-message"
            Window.SetHeadless(True)
            ShowMessage("Missing file", "rooms.ini isn't there")
            Print("went on")
        Case "show-message-offscreen"
            // Not headless, but SDL's video driver is offscreen, as ctest sets it: no box either.
            ShowMessage("Missing file", "rooms.ini isn't there")
            Print("went on")
        Case "binding-key-out-of-range"
            Binding.OfKey(9999 As Key)
        Case "binding-button-out-of-range"
            Binding.OfMouseButton(0 As MouseButton)
        Case "binding-nan-scale"
            Binding.OfGamepadAxis(GamepadAxis.LEFT_X, NaN)
        Case "bind-unchecked"
            ActionSet().Add("jump").Bind(Binding(BindingKind.KEY, 9999, 1.0))
        Case "bind-y-infinite"
            ActionSet().Add("look").BindY(Binding(BindingKind.MOUSE_AXIS, 0, Inf))
        Case "mask-threshold"
            Mask.FromImage(Image(2, 2), 0)
        Case "mask-region-outside"
            Mask.FromImage(Image(4, 4), 1, Rect(2.0, 0.0, 3.0, 4.0))
        Case "mask-region-fraction"
            Mask.FromImage(Image(4, 4), 1, Rect(0.5, 0.0, 2.0, 2.0))
        Case "mask-pixels-short"
            Mask.FromPixels([0, 0, 0, 255], 2, 1)
        Case "mask-empty-cell"
            Mask.Frames(Image(4, 4), 0, 4)
        Case "replace-overflows"
            Local look = ActionSet().Add("look")
            look.Bind(Binding.OfMouseAxis(MouseAxis.X, 1e30))
            look.Replace(Binding.OfMouseAxis(MouseAxis.X, 1e30),
                         Binding.OfMouseAxis(MouseAxis.Y, 1e30))
        Default
            Panic("no case {name}")
    End Select
End Function

Try Main()
