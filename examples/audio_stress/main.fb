// A game's sound under load, as SCP:CB's is: a mix at 44100 Hz of up to 64 channels, with a
// streamed track looping under them, and each 60 fps frame starting short sounds, moving each
// playing one's pan and volume as its source moves, and stopping some. On no device, each frame
// then mixes its 735 frames, which measures the mixing itself; on miniaudio's null backend, paced
// at 60 fps, its own thread mixes beside the game's, as a device's does. It prints what the game's
// calls take a frame on each, and the mix on no device, and holds the calls to audio's own share
// of the engine's 2 ms frame, 0.5 ms, with room for a debug build on a slow machine.
//
// What it holds them to is what a machine's other work doesn't change, as the clock it reads does:
// the middle frame, as what else is running takes this thread away from few of them, and how many
// frames stalled, of which that leaves few; and a run over either goes again, up to 3 times, as it
// can't be chance every time. What's really slow is slow in the middle frame of every run, and what
// really stalls stalls in more than a twentieth of them, which --stall-every-frame and
// --stall-now-and-then show, as ctest runs them, by stalling it.

Import std.collections
Import std.core
Import std.math
Import std.os
Import std.time
Import fbengine_audio

Const FRAMES = 600
Const PACED_FRAMES = 300
Const MOST_CHANNELS = 64
Const STARTS_A_FRAME = 8
Const RATE = 44100
Const FRAME = 735
Const TRIES = 3

// The game's calls in a frame, at most, in the middle frame; a frame of more than a stall's is
// stalled, and at most a twentieth of them can be.
Const MOST_CALLS: Float64 = 0.5
Const A_STALL: Float64 = 10.0
Const MOST_STALLED = 20

// A mono WAV of `count` frames of a tone at `hertz`, at 44100 Hz.
Function Tone(hertz: Float, count: Int): UInt8[]
    Local bytes: UInt8[] = []
    Add(bytes, "RIFF".Bytes)
    Bytes(bytes, 36 + count * 2, 4)
    Add(bytes, "WAVEfmt ".Bytes)
    Bytes(bytes, 16, 4)
    Bytes(bytes, 1, 2)
    Bytes(bytes, 1, 2)
    Bytes(bytes, RATE, 4)
    Bytes(bytes, RATE * 2, 4)
    Bytes(bytes, 2, 2)
    Bytes(bytes, 16, 2)
    Add(bytes, "data".Bytes)
    Bytes(bytes, count * 2, 4)
    For i = 0 Until count
        Local sample = (Sin(Tau * hertz * (i As Float) / (RATE As Float)) * 8000.0) As Int
        Bytes(bytes, sample < 0 ? sample + 65536 : sample, 2)
    End For
    Return bytes
End Function

Function Add(bytes: UInt8[], more: UInt8[])
    bytes.AddAll(more)
End Function

Function Bytes(bytes: UInt8[], value: Int, count: Int)
    For i = 0 Until count
        bytes.Add(((value >> (i * 8)) & 255) As UInt8)
    End For
End Function

// What a run takes a frame, in milliseconds, in the middle frame and at most; and how many stalled.
Struct Measured
    Field Busiest: Int
    Field Calls: Float64
    Field SlowestCalls: Float64
    Field Stalled: Int
    Field Mix: Float64
    Field SlowestMix: Float64
End Struct

// What's stalled on purpose, to show it's seen: each frame by 2 ms, or each tenth frame by 20.
Enum Stall
    NONE
    EVERY_FRAME
    NOW_AND_THEN
End Enum

// The middle of `values`, 0 for none.
Function Middle(values: Float64[]): Float64
    If values.Count == 0 Then Return 0
    Local sorted: Float64[] = []
    sorted.AddAll(values)
    sorted.Sort()
    Return sorted[sorted.Count / 2]
End Function

// `frames` frames of a game on `device`: mixed by each frame on MANUAL, paced at 60 fps on another.
Function Measure(device: AudioDevice, frames: Int,
                 stall: Stall): Measured Throws AudioError, SoundError
    Try Audio.Start(device, RATE, 2)
    Local effects = Bus()
    effects.SetVolume(0.5)
    Local random = Random(1)
    Local sounds: Sound[] = []
    For i = 0 Until 16
        // From 20 ms to half a second, as footsteps, clicks, and drips are.
        Local sound = Try Sound.FromBytes(Tone(200.0 + (i As Float) * 50.0, random.Int(882, 22050)))
        sound.SetBus(effects)
        sounds.Add(sound)
    End For
    Local music = Try Sound.StreamBytes(Embed("tone.ogg"))
    music.SetLoop(True)
    music.Play()

    Local playing: Channel[] = []
    Local calls: Float64[] = []
    Local mixing: Float64[] = []
    Local slowestCalls = Duration.Zero()
    Local slowestMix = Duration.Zero()
    Local busiest = 0
    Local begun = Instant.Now()
    For frame = 1 To frames
        Local started = Instant.Now()
        // What finished goes; what's playing moves, as each source does against the camera.
        Local still: Channel[] = []
        For channel In playing
            If channel.Playing()
                channel.SetPan(Sin((frame As Float) * 0.05 + (still.Count As Float)))
                channel.SetVolume(random.Float(0.2, 1.0))
                still.Add(channel)
            End If
        End For
        playing = still
        For i = 1 To STARTS_A_FRAME
            If Audio.Playing() >= MOST_CHANNELS Then Break
            Local channel = sounds[random.Int(sounds.Count)].Play()
            channel.SetPitch(random.Float(0.8, 1.25))
            playing.Add(channel)
        End For
        If playing.Count > 4 && random.Int(4) == 0 Then playing[0].Stop()
        busiest = Max(busiest, Audio.Playing())
        If stall == Stall.EVERY_FRAME Then Sleep(2.Milliseconds)
        If stall == Stall.NOW_AND_THEN && frame % 10 == 0 Then Sleep(20.Milliseconds)
        Local took = started.Elapsed
        calls.Add(took.TotalMilliseconds)
        slowestCalls = Max(slowestCalls, took)

        If device == AudioDevice.MANUAL
            Local before = Instant.Now()
            Local mixed = Audio.Mix(FRAME)
            Local mix = before.Elapsed
            mixing.Add(mix.TotalMilliseconds)
            slowestMix = Max(slowestMix, mix)
            If mixed.Count != FRAME * 2 Then Panic("frame {frame} mixed {mixed.Count} samples")
        Else
            Local wait = Duration.FromNanoseconds(16666667 * (frame As Int64)) - begun.Elapsed
            If !wait.IsNegative && !wait.IsZero Then Sleep(wait)
        End If
    End For
    Audio.Stop()
    Local stalled = 0
    For each In calls
        If each > A_STALL Then stalled += 1
    End For
    Return Measured(busiest, Middle(calls), slowestCalls.TotalMilliseconds, stalled, Middle(mixing),
                    slowestMix.TotalMilliseconds)
End Function

// What's over the budget in a run of `frames`, "" for nothing.
Function Over(run: Measured, frames: Int): String
    If run.Calls > MOST_CALLS Then Return "the game's calls take more than audio's 0.5 ms a frame"
    If run.Stalled > frames / MOST_STALLED
        Return "the game's calls stalled in {run.Stalled} of {frames} frames"
    End If
    If run.Mix > 16.7 Then Return "the mix is slower than it plays"
    Return ""
End Function

// One run on each, giving what's over the budget, "" for nothing. What's over on no device doesn't
// wait a paced run's 5 seconds to say so.
Function Once(stall: Stall): String Throws AudioError, SoundError
    Local manual = Try Measure(AudioDevice.MANUAL, FRAMES, stall)
    Print("{FRAMES} frames on no device, up to {manual.Busiest} channels at once")
    Print("the game's calls: {manual.Calls} ms in the middle frame, {manual.SlowestCalls} ms at most, " +
          "{manual.Stalled} stalled")
    Print("the mix: {manual.Mix} ms in the middle frame, {manual.SlowestMix} ms at most")
    Local over = Over(manual, FRAMES)
    If over != "" Then Return over
    Local paced = Try Measure(AudioDevice.SILENT, PACED_FRAMES, stall)
    Print("{PACED_FRAMES} frames on the null backend at 60 fps, up to {paced.Busiest} channels at once")
    Print("the game's calls: {paced.Calls} ms in the middle frame, {paced.SlowestCalls} ms at most, " +
          "{paced.Stalled} stalled")
    Return Over(paced, PACED_FRAMES)
End Function

// The game's calls are within audio's share of the engine's frame, beside the mixing thread too, and
// the mix, on a device's own thread, keeps up with the 16.7 ms each frame plays for.
Function Run() Throws AudioError, SoundError
    Local arguments = Process.Arguments()
    Local stall = Stall.NONE
    If arguments.Contains("--stall-every-frame") Then stall = Stall.EVERY_FRAME
    If arguments.Contains("--stall-now-and-then") Then stall = Stall.NOW_AND_THEN
    Local over = ""
    For attempt = 1 To TRIES
        over = Try Once(stall)
        If over == ""
            Print("within the budget")
            Return
        End If
        Print("run {attempt}: {over}")
    End For
    Panic(over)
End Function

Try Run()
