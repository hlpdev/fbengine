// A game run from its files in `assets/`, by fbengine_tools' build step, as its project.toml says:
// `fb run` reads them as they are, and reloads what changes as it runs; `fb run --release` reads
// them cooked into its pak. It draws its hero offscreen, and says what it drew. With `--change
// <file>`, it writes over its hero there, and waits to see the reload, as a game's developer saving
// a file would, and draws it again, and puts it back. With --watch, a window for a person to watch, which draws the
// hero as it is, a saved file showing as it's saved (tools/show.py plays it), or `--frames` of it
// offscreen, as a test does.

Import std.collections
Import std.core
Import std.image.image
Import std.image.png
Import std.io
Import std.math
Import std.os
Import std.time
Import fbengine
Import "./res" As Res

// What a pixel of the hero looks like, for a test to read.
Function Named(pixel: Color32): String
    If pixel.r > 200 && pixel.g < 60 && pixel.b < 60 Then Return "red"
    If pixel.b > 200 && pixel.r < 60 && pixel.g < 60 Then Return "blue"
    Return "something else, {pixel}"
End Function

// Draws `hero` into a target, as a frame of the game does, and gives what's in its middle.
Function Drawn(hero: Texture): String Throws GraphicsError
    Local target = Try Texture.Target(hero.Width(), hero.Height())
    Defer target.Free()
    Canvas(target).Draw(Sprite2D(hero), 0, 0)
    Return Named(target.ToImage()[hero.Width() / 2, hero.Height() / 2])
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

// A window for a person to watch, or `frames` of it offscreen.
Function Watched(frames: Int) Throws GraphicsError, IOError
    Window.SetHeadless(frames > 0)
    Try Graphics(320, 240)
    Defer EndGraphics()
    Frame.SetLimit(60)
    Local hero = Try Assets.Load<Texture>(Res.Hero)
    Local sprite = Sprite2D(hero)
    sprite.MidHandle()
    Local count = 0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        If Screen.Texture() != Null
            Local canvas = Screen.Canvas()
            canvas.SetColor(Color32(24, 28, 36, 255))
            canvas.Clear()
            canvas.SetColor(Color32(255, 255, 255, 255))
            canvas.Draw(sprite, 160, 120)
        End If
        Flip()
        count += 1
    End While
    Print("watched {count} frames of a hero {hero.Width()} wide")
End Function

Try
    Res.Mount()
    Print(Try Assets.ReadText(Res.Level))
    // A KTX2's signature, what the cooker makes of an image.
    Local cooked = (Try Assets.ReadBytes(Res.Hero))[0] == 0xAB
    Print(cooked ? "hero, cooked" : "hero, as it is")

    Local arguments = Process.Arguments()
    If arguments.Contains("--watch")
        Try Watched(Asked(arguments))
        Return
    End If
    Window.SetHeadless(True)
    Local hero = Try Assets.Load<Texture>(Res.Hero)
    Print("drew {Try Drawn(hero)}")

    If arguments.Count == 2 && arguments[0] == "--change"
        Local blue = Image(8, 8)
        blue.Fill(Color32(0, 0, 255, 255))
        Local saved = Try File.ReadBytes(Path(arguments[1]))
        Try File.WriteBytesAtomic(Path(arguments[1]), Png.Encode(blue))
        Local since = Instant.Now()
        While hero.Width() != 8 && (Instant.Now() - since) < 30.Seconds
            Flip()
            Sleep(5.Milliseconds)
        End While
        Print(hero.Width() == 8 ? "hero reloaded, {hero.Width()} wide" : "hero didn't reload")
        Print("drew {Try Drawn(hero)}")
        // As it was, for what runs next.
        Try File.WriteBytesAtomic(Path(arguments[1]), saved)
    End If
Catch e As GraphicsError
    Print("no GPU: {e.Message}")
Catch e As IOError
    Print(e.Kind == IOErrorKind.OTHER ? "no GPU: {e.Message}" : "couldn't read them: {e.Message}")
End Try
