// What says whether what's made and drawn is right, apart from any GPU: a WAV's bytes, and pixels by
// what they show, with wide thresholds, so a black frame fails, and a change of light doesn't.

Import std.core
Import std.image.image
Import std.math

// How many bytes a WAV has before its samples, as the tools write it.
Const WAV_HEADER: Int = 44
// A sound's samples can't reach this, or they've clipped.
Const CLIPS: Int = 32767

/// What's wrong with a 16-bit WAV, by its bytes, or Null: no samples, no sound in them, or clipping.
Public Function SoundFault(bytes: UInt8[]): String?
    If bytes.Count <= WAV_HEADER Then Return "it has no samples"
    Local peak = 0
    Local at = WAV_HEADER
    While at + 1 < bytes.Count
        Local value = (bytes[at] As Int) | ((bytes[at + 1] As Int) << 8)
        If value >= 32768 Then value -= 65536
        peak = Max(peak, Abs(value))
        at += 2
    End While
    If peak == 0 Then Return "it's silent"
    If peak >= CLIPS Then Return "it clips"
    Return Null
End Function

/// Whether a color's the sea's, which is blue-green, and dark in its red.
Public Function IsSea(pixel: Color32): Bool
    Return (pixel.g As Int) > (pixel.r As Int) + 15 && (pixel.b As Int) > (pixel.r As Int) + 15 &&
           pixel.r < 140
End Function

/// Whether a color's the sky's, which is pale.
Public Function IsSky(pixel: Color32): Bool => pixel.b > 170 && pixel.r > 130

/// How much of an image's pixels `test` holds for, from 0 to 1.
Public Function Share(image: Image, test: Func(Color32): Bool): Float
    Local count = 0
    For y = 0 Until image.Height
        For x = 0 Until image.Width
            If test(image[x, y]) Then count += 1
        End For
    End For
    Return (count As Float) / ((image.Width * image.Height) As Float)
End Function

/// How close two images of a size are, in decibels of PSNR over their colors: higher's closer, and
/// 100 for the same.
Public Function PsnrOf(one: Image, other: Image): Float
    Local sum: Float64 = 0.0
    For y = 0 Until one.Height
        For x = 0 Until one.Width
            Local a = one[x, y]
            Local b = other[x, y]
            Local dr = (a.r As Float64) - (b.r As Float64)
            Local dg = (a.g As Float64) - (b.g As Float64)
            Local db = (a.b As Float64) - (b.b As Float64)
            sum += dr * dr + dg * dg + db * db
        End For
    End For
    If sum == 0.0 Then Return 100.0
    Local mean = sum / ((one.Width * one.Height * 3) As Float64)
    Return (10.0 * Log10(255.0 * 255.0 / mean)) As Float
End Function

/// Whether --fps may draw on a device: software always, and a real GPU only if `asked` is "1", with
/// it the only one of the `devices` the loader shows.
Public Function MayMeasureOn(software: Bool, asked: String?, devices: Int): Bool
    Return software || (asked == "1" && devices == 1)
End Function

/// Whether a frame's cost means anything: a lost GPU says -1 for every frame, which is under any number.
Public Function CostWasRead(lost: Bool, cost: Float): Bool => !lost && cost >= 0.0

/// Whether `arguments` are a mode that draws with no person there, which ctest runs and a window never shows.
Public Function DrawsWithoutAPerson(arguments: String[]): Bool
    If arguments.Count == 0 Then Return False
    Return ["--cooked", "--walk3d", "--end", "--hear", "--feel", "--frames"].Contains(arguments[0])
End Function

/// Whether such a mode may draw, with `devices` shown: not when it would pick one of several for itself.
Public Function MayDrawOn(devices: Int): Bool => devices <= 1

/// Whether `with` shows something `without` doesn't within 6 pixels of (`x`, `y`): by more than the
/// little that a frame differs from another of the same thing.
Public Function DiffersAround(with: Image, without: Image, x: Int, y: Int): Bool
    For row = Max(y - 6, 0) To Min(y + 6, with.Height - 1)
        For column = Max(x - 6, 0) To Min(x + 6, with.Width - 1)
            Local one = with[column, row]
            Local other = without[column, row]
            Local change = Abs(((one.r As Int) + (one.g As Int) + (one.b As Int)) -
                               ((other.r As Int) + (other.g As Int) + (other.b As Int)))
            If change > 24 Then Return True
        End For
    End For
    Return False
End Function

/// Whether `arguments` play the game, as a person does, drawn as a low GPU can or not; Null for any other
/// mode.
Public Function PlaysLow(arguments: String[]): Bool?
    If arguments.Count == 0 Then Return False
    If arguments.Count == 1 && arguments[0] == "--low" Then Return True
    Return Null
End Function

/// How bright `image` is, the mean of its pixels' channels, from 0 to 255.
Public Function MeanBrightness(image: Image): Float
    Local sum = 0.0
    For y = 0 Until image.Height
        For x = 0 Until image.Width
            Local pixel = image[x, y]
            sum += ((pixel.r As Int) + (pixel.g As Int) + (pixel.b As Int)) As Float
        End For
    End For
    Return sum / (3.0 * ((image.Width * image.Height) As Float))
End Function
