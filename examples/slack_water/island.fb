// The island: its ground, from noise, the mill and the far rock joined by a low causeway; the sea
// around it, whose height is the tide's; a mill to walk into, blocked out in boxes for now; the
// parts; and Pip.

Import std.core
Import std.image.image
Import std.math
Import fbengine
Import "./flow"
Import "./follow"
Import "./ground"
Import "./map"
Import "./res" As Res
Import "./sea"
Import "./sky"

// How high the mill's floor is above the yard.
Const FLOOR: Float = 0.1
// How much smaller a part is in your hand, close to you, so it stays this side of a wall.
Const HELD_SIZE: Float = 0.35

// How bright the sun, what a camera's light's multiplied by, and its bloom, how much, and from how
// bright.
Const AROUND_LIGHT: Float = 0.45
Const SUN_LIGHT: Float = 4.5
Const EXPOSURE: Float = 0.8
Const BLOOM: Float = 1.4
// From past the sky's brightness, as it fades in from half of this.
Const BLOOM_FROM: Float = 2.2
Const LAMP_GLOW: Float = 4.0
Const LANTERN_LIGHT: Float = 30.0
/// How high the mill's ceiling is, from its floor.
Public Const CEILING: Float = 4.97
/// How many meters of ground each repeat of the rock's maps takes.
Public Const GROUND_REPEAT: Float = 12.0
// How many meters the ground's finer grit takes to repeat, which goes evenly into nothing the other does.
Const GROUND_FINE: Float = 2.7
/// How much of the light around still gets indoors, past the walls that the light around knows nothing of.
Const INDOORS: UInt8 = 50

/// Places on the island a game goes to, and walks through.
Public Enum Spot
    INSIDE = 0
    DOOR = 1
    YARD_EDGE = 2
    CROSSING = 3
    FAR_ROCK = 4
    WORKS = 5
End Enum

// A surface of PBR's: `albedo`, its color, under `color`; its normal and roughness maps; how much of a
// metal it is; and each repeat of them `size` units of UV across. What's loaded's kept in `held`.
@MainThread
Function Surfaced(held: Texture[], albedo: String, normal: String, rough: String, metal: Float,
                  color: Color, size: Float): Material Throws IOError
    Local material = Material(color)
    Local turn = UvTurn(Vec2(size, size), 0.0, Vec2(0.0, 0.0))
    Local shown = Try Assets.Load<Texture>(albedo)
    held.Add(shown)
    material.SetTexture(0, shown)
    Local bumps = Try Assets.Load<Texture>(normal)
    held.Add(bumps)
    material.SetMap(MaterialMap.NORMAL, bumps)
    Local roughness = Try Assets.Load<Texture>(rough)
    held.Add(roughness)
    material.SetMap(MaterialMap.METAL_ROUGH, roughness)
    If size != 1.0
        material.SetLayerUv(0, turn)
        material.SetMapUv(MaterialMap.NORMAL, turn)
        material.SetMapUv(MaterialMap.METAL_ROUGH, turn)
    End If
    // What's in the maps is multiplied by these: all of their roughness, and this much of their metal.
    material.SetMetalRough(metal, 1.0)
    Return material
End Function

@MainThread
Function Rock(held: Texture[], color: Color, size: Float): Material Throws IOError
    Return Try Surfaced(held, Res.RockAlbedo, Res.RockNormal, Res.RockRough, 0.0, color, size)
End Function

// How many pixels of what covers the ground there are to a meter.
Const COVER_PER_METER: Int = 2

// The ground, of its `heights`, a row of SIDE + 1 after another: what covers it, baked from its height and
// slope, under a fine grit, at two scales, one turned from the other, so no repeat lines up.
@MainThread
Function Ground(held: Texture[], heights: Float[]): Material Throws IOError, GraphicsError
    Local maps = GroundCover(heights)
    Local cover = Try Texture.FromImage(maps.0, True, TextureFormat.RGBA8)
    held.Add(cover)
    Local rough = Try Texture.FromImage(maps.1, True, TextureFormat.RGBA8_LINEAR)
    held.Add(rough)
    Local grit = Try Assets.Load<Texture>(Res.GritAlbedo)
    held.Add(grit)
    Local bumps = Try Assets.Load<Texture>(Res.GritNormal)
    held.Add(bumps)
    Local whole = UvTurn(Vec2(SIDE As Float, SIDE As Float), 0.0, Vec2(0.0, 0.0))
    Local material = Material(Color(1.0, 1.0, 1.0))
    material.SetTexture(0, cover)
    material.SetLayerUv(0, whole)
    material.SetTexture(1, grit)
    material.SetLayer(1, LayerBlend.MULTIPLY_2)
    material.SetLayerUv(1, UvTurn(Vec2(GROUND_REPEAT, GROUND_REPEAT), 0.0, Vec2(0.0, 0.0)))
    material.SetTexture(2, grit)
    material.SetLayer(2, LayerBlend.MULTIPLY_2)
    material.SetLayerUv(2, UvTurn(Vec2(GROUND_FINE, GROUND_FINE), 0.7, Vec2(0.3, 0.1)))
    material.SetMap(MaterialMap.NORMAL, bumps)
    material.SetMapUv(MaterialMap.NORMAL,
                      UvTurn(Vec2(GROUND_REPEAT, GROUND_REPEAT), 0.0, Vec2(0.0, 0.0)))
    material.SetMap(MaterialMap.METAL_ROUGH, rough)
    material.SetMapUv(MaterialMap.METAL_ROUGH, whole)
    material.SetMetalRough(0.0, 1.0)
    Return material
End Function

// `heights` between its points, at (`x`, `z`) meters from its corner.
Function HeightIn(heights: Float[], x: Float, z: Float): Float
    Local left = Min(Floor(x) As Int, SIDE - 1)
    Local top = Min(Floor(z) As Int, SIDE - 1)
    Local u = x - (left As Float)
    Local v = z - (top As Float)
    Local row = SIDE + 1
    Local near = heights[top * row + left] * (1.0 - u) + heights[top * row + left + 1] * u
    Local far = heights[(top + 1) * row + left] * (1.0 - u) +
                heights[(top + 1) * row + left + 1] * u
    Return near * (1.0 - v) + far * v
End Function

/// What covers the ground of these `heights`, as two images over the whole of it: its color, and its
/// roughness in green, as a material's map has it.
Public Function GroundCover(heights: Float[]): (Image, Image)
    Local side = SIDE * COVER_PER_METER
    Local color = Image(side, side)
    Local rough = Image(side, side)
    Local half = (SIDE As Float) / 2.0
    Local most = (SIDE As Float) - 1.0
    For y = 0 Until side
        Local z = ((y As Float) + 0.5) / (COVER_PER_METER As Float)
        For x = 0 Until side
            Local across = ((x As Float) + 0.5) / (COVER_PER_METER As Float)
            Local height = HeightIn(heights, across, z)
            Local dx = HeightIn(heights, Min(across + 1.0, most), z) -
                       HeightIn(heights, Max(across - 1.0, 0.0), z)
            Local dz = HeightIn(heights, across, Min(z + 1.0, most)) -
                       HeightIn(heights, across, Max(z - 1.0, 0.0))
            Local cover = CoverAt(across - half, z - half, height, Sqrt(dx * dx + dz * dz) / 2.0)
            color[x, y] = Color32((cover.0.x * 255.0) As UInt8, (cover.0.y * 255.0) As UInt8,
                                  (cover.0.z * 255.0) As UInt8, 255)
            rough[x, y] = Color32(255, (cover.1 * 255.0) As UInt8, 0, 255)
        End For
    End For
    Return (color, rough)
End Function

@MainThread
Function Wood(held: Texture[]): Material Throws IOError
    Return Try Surfaced(held, Res.WoodAlbedo, Res.WoodNormal, Res.WoodRough, 0.0,
                        Color(1.0, 1.0, 1.0), 1.0)
End Function

@MainThread
Function Brass(held: Texture[]): Material Throws IOError
    Return Try Surfaced(held, Res.BrassAlbedo, Res.BrassNormal, Res.BrassRough, 1.0,
                        Color(1.0, 1.0, 1.0), 1.0)
End Function

@MainThread
Function Iron(held: Texture[], color: Color): Material Throws IOError
    Return Try Surfaced(held, Res.IronAlbedo, Res.IronNormal, Res.IronRough, 1.0, color, 1.0)
End Function

/// Sets `camera` to see as the game does: into an HDR image, its light past white rolled off, bloom on
/// what's brightest, and its far edge into the haze.
@MainThread
Public Function Looked(camera: Camera)
    camera.SetClearColor(SKY)
    camera.SetRange(0.1, 4000.0)
    camera.SetFogMode(FogMode.LINEAR)
    camera.SetFogColor(Color(SKY.r * SKY_LIGHT, SKY.g * SKY_LIGHT, SKY.b * SKY_LIGHT))
    camera.SetFogRange(200.0, 1400.0)
    camera.SetHdr(True)
    camera.SetTonemap(Tonemap.ACES)
    camera.SetExposure(EXPOSURE)
    camera.SetBloom(BLOOM, BLOOM_FROM)
End Function

/// What the storm does to what's seen: `storm`, from 0 to 1, greys it, cools it, and darkens it.
Public Function StormGrade(storm: Float): ColorGrade
    Return ColorGrade(Vec3(1.0 - 0.3 * storm, 1.0 - 0.22 * storm, 1.0 - 0.12 * storm),
                      Vec3(0.0, 0.0, 0.0), Vec3(1.0, 1.0, 1.0), 1.0 - 0.35 * storm)
End Function

// `material`, indoors: the light around's for what can see the sky.
@MainThread
Function Indoors(material: Material, held: Texture[]): Material Throws GraphicsError
    Local image = Image(1, 1)
    image[0, 0] = Color32(INDOORS, INDOORS, INDOORS, 255)
    Local shut = Try Texture.FromImage(image, False, TextureFormat.RGBA8_LINEAR)
    held.Add(shut)
    Local inside = material.Clone()
    inside.SetMap(MaterialMap.OCCLUSION, shut)
    inside.SetOcclusionStrength(1.0)
    Return inside
End Function

// A box, its middle at (`x`, `y`, `z`) from the mill's floor, half `w`, `h`, and `d` across.
@MainThread
Function Box(parent: Entity, material: Material, x: Float, y: Float, z: Float, w: Float, h: Float,
             d: Float)
    Local box = Mesh(Geometry.Cube(), parent)
    box.SetMaterial(material)
    box.SetPosition(Vec3(x, y, z))
    box.SetScale(Vec3(w, h, d))
End Function

// The mill, blocked out: walls with a door in the south one, a floor, a roof, the wheel by its east
// wall, and the lamp on top; gives its pivot, its wheel, and its lamp.
@MainThread
Function BuildMill(held: Texture[]): (Pivot, Mesh, Mesh, Light) Throws IOError, GraphicsError
    Local wood = Try Wood(held)
    Local iron = Try Iron(held, Color(1.0, 1.0, 1.0))
    Local stone = Try Rock(held, Color(0.8, 0.8, 0.82), 0.5)
    Local brass = Try Brass(held)
    Local mill = Pivot()
    mill.SetPosition(Vec3(MAIN_X, GroundHeight(MAIN_X, 0.0), 0.0))
    // Its floor, a little above the yard, so they don't fight.
    Box(mill, Try Indoors(stone, held), 0.0, 0.0, 0.0, 6.0, FLOOR, 5.0)
    Box(mill, stone, 0.0, 2.5, -5.0, 6.0, 2.5, 0.3)
    Box(mill, stone, -6.0, 2.5, 0.0, 0.3, 2.5, 5.0)
    Box(mill, stone, 6.0, 2.5, 0.0, 0.3, 2.5, 5.0)
    Box(mill, stone, -4.0, 2.5, 5.0, 2.0, 2.5, 0.3)
    Box(mill, stone, 4.0, 2.5, 5.0, 2.0, 2.5, 0.3)
    Box(mill, stone, 0.0, 4.2, 5.0, 2.0, 0.8, 0.3)
    Box(mill, wood, 0.0, 5.3, 0.0, 6.6, 0.3, 5.6)
    // The ceiling, under the roof, whose wood would reflect the sky.
    Box(mill, Try Indoors(wood, held), 0.0, CEILING, 0.0, 5.7, 0.02, 4.7)
    // What the parts go on, inside.
    Box(mill, iron, 3.5, 1.0, -3.0, 1.2, 1.0, 1.2)
    // The wheel, on its axle, by the east wall.
    Local wheel = Mesh(Geometry.Cylinder(16), mill)
    wheel.SetMaterial(wood)
    wheel.SetPosition(Vec3(8.0, 2.4, 0.0))
    wheel.SetRotation(0.0, 0.0, ToRadians(90.0))
    wheel.SetScale(Vec3(3.0, 0.5, 3.0))
    // A lantern over the works, so what's fitted can be seen, as the walls keep the sky out.
    Local lantern = Light(LightType.POINT, mill)
    lantern.SetColor(Color(1.0, 0.72, 0.42))
    lantern.SetIntensity(LANTERN_LIGHT)
    lantern.SetRange(14.0)
    lantern.SetPosition(Vec3(0.5, 3.8, 0.0))
    // The lamp on the roof, unlit until the water's back.
    Local lamp = Mesh(Geometry.Sphere(10), mill)
    lamp.SetMaterial(brass)
    lamp.SetPosition(Vec3(0.0, 6.1, 0.0))
    lamp.SetScale(Vec3(0.5, 0.5, 0.5))
    Return (mill, wheel, lamp, lantern)
End Function

// The parts, each lying where it does, by its number: the gear, the paddle, and the belt.
@MainThread
Function BuildParts(held: Texture[]): Mesh[] Throws IOError
    Local gear = Mesh(Geometry.Cylinder(12))
    gear.SetMaterial(Try Brass(held))
    gear.SetScale(Vec3(0.3, 0.06, 0.3))
    Local paddle = Mesh(Geometry.Cube())
    paddle.SetMaterial(Try Wood(held))
    paddle.SetScale(Vec3(0.3, 0.05, 0.42))
    Local belt = Mesh(Geometry.Cylinder(16))
    belt.SetMaterial(Try Iron(held, Color(0.5, 0.45, 0.4)))
    belt.SetScale(Vec3(0.36, 0.08, 0.36))
    Return [gear, paddle, belt]
End Function

/// The island and what's on it, in a World of its own, with its sun.
Public Final Class Island
    Field scene: World
    Field ground: Terrain
    Field sea: Sea
    Field sunShown: SunShown
    Field model: Model
    Field pip: Entity
    Field held: Texture[]
    Field mill: Pivot
    Field wheel: Mesh
    Field lamp: Mesh
    Field parts: Mesh[]
    Field sun: Light
    Field around: Environment
    Field lantern: Light
    Field lampLight: Light? = Null
    Field lampBright = False
    Field lampUnlit: Material
    Field sizes: Vec3[] = []
    Field pipHead: Entity
    Field pipMesh: Mesh

    New(scene: World, ground: Terrain, sea: Sea, sunShown: SunShown, model: Model, pip: Entity,
        held: Texture[],
        mill: Pivot, wheel: Mesh, lamp: Mesh, parts: Mesh[], sun: Light, around: Environment,
        lantern: Light)
        Self.scene = scene
        Self.ground = ground
        Self.sea = sea
        Self.sunShown = sunShown
        Self.model = model
        Self.pip = pip
        Self.held = held
        Self.mill = mill
        Self.wheel = wheel
        Self.lamp = lamp
        Self.parts = parts
        Self.sun = sun
        Self.around = around
        Self.lantern = lantern
        lampUnlit = lamp.Material() ?? Material(Color(1.0, 1.0, 1.0))
        pipHead = pip.Find("head") ?? pip
        pipMesh = (pip.Find("pip") ?? pip) As Mesh
        pip.Player().Release(pipHead)
        For thing In parts
            sizes.Add(thing.Scale())
        End For
        Reset()
    End New

    /// Makes it, from the game's files, which Res has mounted.
    @MainThread
    Public Static Method Make(): Island Throws IOError, GraphicsError
        Local scene = World()
        World.SetCurrent(scene)
        Local held: Texture[] = []
        // The light around it, which is the sky seen, and what a metal reflects.
        Local skyTexture = Try Texture.FromHdr(SkyImage())
        held.Add(skyTexture)
        scene.SetSkyTexture(skyTexture)
        Local around = Try Environment.Bake(skyTexture, 256, 64)
        scene.SetEnvironment(around, AROUND_LIGHT)

        Local sun = Light(LightType.DIRECTIONAL)
        sun.SetColor(Color(1.0, 0.88, 0.7))
        sun.SetIntensity(SUN_LIGHT)
        sun.SetShadows(True)
        sun.SetShadowDistance(180.0)
        // Low, from the south, on the mill's door, and lowering.
        Local height, around2 = SunAt(0.0)
        sun.SetRotation(-height, around2, 0.0)

        Local ground = Terrain(SIDE)
        ground.SetPosition(Vec3(-(SIDE As Float) / 2.0, 0.0, -(SIDE As Float) / 2.0))
        Local heights: Float[] = []
        For z = 0 To SIDE
            For x = 0 To SIDE
                heights.Add(GroundHeight((x - SIDE / 2) As Float, (z - SIDE / 2) As Float))
            End For
        End For
        ground.SetHeights(heights)
        ground.SetMaterial(Try Ground(held, heights))

        Local sea = Try Sea.Make(held)
        Local sunShown = Try SunShown.Make(held)

        Local mill, wheel, lamp, lantern = Try BuildMill(held)
        Local parts = Try BuildParts(held)

        Local model = Try Assets.Load<Model>(Res.Pip)
        Local pip = Try model.Spawn()
        // Its own brass, tarnished, for what its file only has a color of.
        model.Geometries()[0].Surface(0).SetMaterial(Try Brass(held))
        pip.SetPosition(Vec3(MAIN_X + 2.0, GroundHeight(MAIN_X + 2.0, 13.0), 13.0))
        // Facing the yard's view, as glTF's front is +Z.
        pip.SetRotation(0.0, ToRadians(20.0), 0.0)
        pip.Player().Play(model.Clips()[0])
        Return Island(scene, ground, sea, sunShown, model, pip, held, mill, wheel, lamp, parts, sun,
                      around,
                      lantern)
    End Method

    /// The World it's in.
    @MainThread Public Method Scene(): World => scene

    /// Pip's root.
    @MainThread Public Method PipEntity(): Entity => pip

    /// What's fitted is under.
    @MainThread Public Method Works(): Entity => mill

    /// Plays Pip's clip at `index`: idle, walk, or carry.
    @MainThread
    Public Method PlayPip(index: Int)
        pip.Player().Play(model.Clips()[index])
    End Method

    /// A part's thing in the world.
    @MainThread Public Method PartEntity(part: Part): Mesh => parts[part As Int]

    /// Where a part lies at first, across and along the ground.
    @MainThread
    Public Method PartSpot(part: Part): Vec2
        Select part
            Case Part.GEAR
                Return GearSpot()
            Case Part.PADDLE
                Return PaddleSpot()
            Default
                Return BeltSpot()
        End Select
    End Method

    /// Where a Spot is, across and along the ground.
    @MainThread
    Public Method PlaceOf(spot: Spot): Vec2
        Select spot
            Case Spot.INSIDE
                Return MillSpot()
            Case Spot.DOOR
                Return DoorSpot()
            Case Spot.YARD_EDGE
                Return Landing(False)
            Case Spot.WORKS
                Return Vec2(MAIN_X + 3.5, -3.0)
            Case Spot.CROSSING
                Return PaddleSpot()
            Default
                Return Landing(True)
        End Select
    End Method

    /// How high what you stand on is at (`x`, `z`): the mill's floor, or the ground.
    @MainThread
    Public Method FloorAt(x: Float, z: Float): Float
        Local point = ground.SurfacePoint(Vec3(x, 100.0, z))
        Local height = point != Null ? point.y : GroundHeight(x, z)
        Return height + (InMill(x, z) ? FLOOR : 0.0)
    End Method

    /// How high the sea's drawn.
    @MainThread Public Method SeaDrawnAt(): Float => sea.DrawnAt()

    /// How high the ground's drawn at (`x`, `z`), or Null off it.
    @MainThread
    Public Method GroundDrawnAt(x: Float, z: Float): Float?
        Local point = ground.SurfacePoint(Vec3(x, 100.0, z))
        Return point != Null ? point.y : Null
    End Method

    /// Sets the sea's height for `clock` seconds into the slack water.
    @MainThread
    Public Method Update(clock: Float64)
        sea.Update(clock)
        TurnSun(clock)
    End Method

    /// What the ground's drawn with.
    @MainThread
    Public Method GroundMaterial(): Material? => ground.Material()

    /// Turns the sun to where it is `clock` seconds in.
    @MainThread
    Public Method TurnSun(clock: Float64)
        Local height, turned = SunAt(clock)
        sun.SetRotation(-height, turned, 0.0)
        sunShown.Update(clock)
    End Method

    /// Puts a part on the mill's works, each in its place.
    @MainThread
    Public Method FitPart(part: Part)
        Local thing = parts[part As Int]
        thing.SetParent(mill, False)
        thing.SetPosition(Vec3(3.5, 2.15 + ((part As Int) As Float) * 0.25, -3.0))
        thing.SetRotation(0.0, 0.0, 0.0)
        thing.SetScale(sizes[part As Int])
    End Method

    /// Turns the wheel to `angle` radians about its axle.
    @MainThread
    Public Method TurnWheel(angle: Float)
        wheel.SetRotation(angle, 0.0, ToRadians(90.0))
    End Method

    /// What the sun's light does now, its rotation.
    @MainThread Public Method SunTurned(): Quat => sun.Rotation()

    /// Where the sun's drawn.
    @MainThread Public Method SunPlace(): Vec3 => sunShown.Place()

    /// Hides the ground, or shows it again, to see what shows through the sea.
    @MainThread Public Method SetGroundHidden(hidden: Bool)
        If hidden Then ground.Hide() Else ground.Show()
    End Method

    /// How rough the sea is at most, as its wind's patches have it.
    @MainThread Public Method SeaRoughness(): Float => sea.Shown().Roughness()

    /// Stills the sea, or sets it going again, to see what's in it.
    @MainThread Public Method SetSeaStill(still: Bool)
        sea.SetStill(still)
    End Method

    /// Takes the normal maps off, or the light around, to see what they've done.
    @MainThread
    Public Method SetAround(on: Bool)
        scene.SetEnvironment(on ? around : Null, AROUND_LIGHT)
    End Method

    /// Turns the sun's shadows off or on, to see what they do.
    @MainThread Public Method SetSunShadows(on: Bool)
        sun.SetShadows(on)
    End Method

    /// Turns the lantern in the mill off or on, to see what it does.
    @MainThread Public Method SetLantern(on: Bool)
        lantern.SetIntensity(on ? LANTERN_LIGHT : 0.0)
    End Method

    /// What Pip's body is drawn in.
    @MainThread Public Method PipBody(): Material? => model.Geometries()[0].Surface(0).Material()

    /// Draws Pip's body in `material`.
    @MainThread Public Method SetPipBody(material: Material?)
        model.Geometries()[0].Surface(0).SetMaterial(material)
    End Method

    /// Whether Pip's body has brass's maps, which its file hasn't: only a color.
    @MainThread Public Method PipHasMaps(): Bool
        Local body = model.Geometries()[0].Surface(0).Material()
        Return body != Null && body.Map(MaterialMap.NORMAL) != Null
    End Method

    /// How far the wheel's turned.
    @MainThread Public Method WheelTurned(): Quat => wheel.Rotation()

    /// Lights the lamp, bright, or dimmer.
    @MainThread
    Public Method LightLamp(bright: Bool)
        // Each Step after the end asks for what it already is.
        If lampLight != Null && lampBright == bright Then Return
        lampBright = bright
        // Red past white, its blue short of it, so it stays warm as it rolls off.
        Local glow = bright ? Color(1.2, 0.55, 0.08) : Color(0.55, 0.28, 0.05)
        // Brighter than white, which is what bloom's for.
        Local material = Material(Color(0.0, 0.0, 0.0))
        material.SetEmissive(Color(glow.r * LAMP_GLOW, glow.g * LAMP_GLOW, glow.b * LAMP_GLOW))
        lamp.SetMaterial(material)
        Local light = lampLight ?? Light(LightType.POINT, lamp)
        lampLight = light
        light.SetColor(glow)
        light.SetIntensity(bright ? 40.0 : 12.0)
        light.SetRange(bright ? 60.0 : 25.0)
    End Method

    /// What the lamp's drawn in.
    @MainThread Public Method LampMaterial(): Material? => lamp.Material()

    /// Where the lamp is, in the world, and the wheel.
    @MainThread Public Method LampAt(): Vec3 => lamp.Position(Space.WORLD)

    @MainThread Public Method WheelAt(): Vec3 => wheel.Position(Space.WORLD)

    /// Puts a part in your hand, at `hand`.
    @MainThread
    Public Method HoldPart(part: Part, hand: Entity)
        Local thing = parts[part As Int]
        thing.SetParent(hand, False)
        thing.SetPosition(Vec3(0.09, -0.1, -0.2))
        thing.SetScale(sizes[part As Int] * HELD_SIZE)
        thing.Show()
    End Method

    /// Puts a part in Pip's hands.
    @MainThread
    Public Method GivePart(part: Part)
        Local thing = parts[part As Int]
        thing.SetParent(pip, False)
        thing.SetPosition(Vec3(0.0, 0.5, 0.32))
        thing.SetScale(sizes[part As Int])
        thing.Show()
    End Method

    /// Whether the lamp's lit.
    @MainThread Public Method LampLit(): Bool => lampLight != Null

    /// Whether the lamp's as it is unlit: its material, and no light left on it.
    @MainThread
    Public Method LampAsUnlit(): Bool => lamp.Material() == lampUnlit && lamp.Children().Count == 0

    /// Puts it all back as it was at first, so another Game can begin on it: the parts where they lie,
    /// and the lamp and wheel as they were; a Game's first Step says where the sea is.
    @MainThread
    Public Method Reset()
        lamp.SetMaterial(lampUnlit)
        Local light = lampLight
        If light != Null Then light.Free()
        lampLight = Null
        TurnWheel(0.0)
        For number = 0 To 2
            Local spot = PartSpot(number As Part)
            Local thing = parts[number]
            thing.SetParent(Null, False)
            thing.SetPosition(Vec3(spot.x, GroundHeight(spot.x, spot.y) + 0.15, spot.y))
            thing.SetRotation(0.0, 0.0, 0.0)
            thing.SetScale(sizes[number])
            thing.Show()
        End For
    End Method

    /// Pip's clip playing, its name.
    @MainThread
    Public Method PipClipName(): String
        Local clip = pip.Player().Clip()
        Return clip != Null ? clip.Name() : ""
    End Method

    /// Sets how fast Pip's clip plays; at 0, it stands at `at` seconds of it.
    @MainThread
    Public Method SetPipPace(speed: Float, at: Float)
        Local player = pip.Player()
        player.SetSpeed(speed)
        If speed == 0.0 Then player.SetTime(at)
    End Method

    /// Turns Pip's head, radians about Y, from how Pip's facing.
    @MainThread
    Public Method TurnPipHead(turn: Float)
        pipHead.SetRotation(0.0, turn, 0.0)
    End Method

    /// How far Pip's head is turned.
    @MainThread Public Method PipHeadTurned(): Quat => pipHead.Rotation()

    /// How shut Pip's eyes are.
    @MainThread Public Method PipBlink(): Float => pipMesh.MorphWeights()[0]

    /// Shuts Pip's eyes, from 0 to 1.
    @MainThread
    Public Method BlinkPip(weight: Float)
        pipMesh.SetMorphWeights([weight])
    End Method

    /// Frees it.
    @MainThread
    Public Method Free()
        model.Free()
        scene.Free()
        around.Free()
        For texture In held
            texture.Free()
        End For
        held = []
    End Method
End Class

/// What a camera's placed at, and pointed at, to see the island from above, its yard, Pip, and the
/// mill's inside: (`name`, where it is, what it looks at).
Public Function Views(): (String, Vec3, Vec3)[]
    Local yardY = GroundHeight(MAIN_X, 14.0)
    Return [("island", Vec3(5.0, 120.0, 150.0), Vec3(5.0, 0.0, 0.0)),
            ("yard", Vec3(MAIN_X - 22.0, yardY + 5.0, 34.0), Vec3(MAIN_X, yardY + 2.0, 0.0)),
            ("pip", Vec3(MAIN_X + 2.6, yardY + 0.9, 14.6), Vec3(MAIN_X + 2.0, yardY + 0.45, 13.0)),
            ("mill_inside", Vec3(MAIN_X - 3.5, yardY + 1.7, 3.5),
             Vec3(MAIN_X + 3.5, yardY + 1.0, -3.0))]
End Function

/// Where to see the lit mill from: its southeast, with the wheel and the lamp both in sight, and where
/// to look.
Public Function LitView(): (Vec3, Vec3)
    Local y = GroundHeight(MAIN_X, 14.0)
    Return (Vec3(MAIN_X + 21.0, y + 6.0, 19.0), Vec3(MAIN_X + 3.0, y + 3.0, 0.0))
End Function
