// How Pip goes after you, apart from anything drawn: around the mill's walls, by its door, and
// which clip that takes, at what speed, with its head and its eyes.

Import std.core
Import std.math
Import "./ground"
Import "./map"

/// How fast Pip goes, in meters a second; how far it stays; and how near counts as with you.
Public Const PIP_SPEED: Float = 4.6
Public Const PIP_NEAR: Float = 4.0
Const STOPS_AT: Float = 2.0
Const STARTS_AT: Float = 2.1
/// How far Pip's clips go over the ground in a turn of each: tools/pip.fb's swing, as a test checks.
Public Const WALK_STRIDE: Float = 0.93
Public Const CARRY_STRIDE: Float = 0.69
/// Where in the carry clip it stands still, holding, with its legs straight.
Public Const CARRY_STILL_AT: Float = 0.25
// How far it can turn its head, and how often it blinks, for how long.
Const HEAD_TURNS: Float = 1.2
Const BLINK_EVERY: Float = 4.0
Const BLINK_FOR: Float = 0.2

/// Pip's clips, by their numbers.
Public Enum PipClip
    IDLE = 0
    WALK = 1
    CARRY = 2
End Enum

/// How far its head turns from how it's facing, to look at something at `toward`, radians about Y.
Public Function HeadTurn(toward: Float, facing: Float): Float
    Local turn = toward - facing
    While turn > 3.14159
        turn -= 6.28318
    End While
    While turn < -3.14159
        turn += 6.28318
    End While
    Return Clamp(turn, -HEAD_TURNS, HEAD_TURNS)
End Function

/// How shut its eyes are, from 0 to 1, `seconds` in.
Public Function BlinkWeight(seconds: Float): Float
    Local into = seconds - Floor(seconds / BLINK_EVERY) * BLINK_EVERY
    If into >= BLINK_FOR Then Return 0.0
    Local halfway = BLINK_FOR / 2.0
    Return 1.0 - Abs(into - halfway) / halfway
End Function

/// Pip, going after you.
Public Final Class Follower
    Field x: Float
    Field z: Float
    Field walking: Bool = False
    Field moved: Float = 0.0
    Field facing: Float = 0.0

    Public New(x: Float, z: Float)
        Self.x = x
        Self.z = z
    End New

    /// Where it is.
    Public Method Location(): Vec2 => Vec2(x, z)

    /// Which way it's facing, radians about Y.
    Public Method Facing(): Float => facing

    /// How far it went in its last Step.
    Public Method Moved(): Float => moved

    /// Puts it at (`atX`, `atZ`), as the water does.
    Public Method Put(atX: Float, atZ: Float)
        x = atX
        z = atZ
    End Method

    /// Which clip suits what it did in its last Step, carrying or not.
    Public Method Clip(holding: Bool): PipClip
        If holding Then Return PipClip.CARRY
        Return moved > 0.0 ? PipClip.WALK : PipClip.IDLE
    End Method

    /// How fast a clip plays, for its feet to keep to the ground, over a Step of `seconds`: by how far
    /// it went, 0 for a carry standing still, and 1 for an idle.
    Public Method ClipSpeed(holding: Bool, seconds: Float): Float
        If moved <= 0.0 Then Return holding ? 0.0 : 1.0
        Return moved / Max(seconds, 0.001) / (holding ? CARRY_STRIDE : WALK_STRIDE)
    End Method

    /// Moves it on `seconds` toward (`toX`, `toZ`), `clock` seconds in.
    Public Method Step(toX: Float, toZ: Float, seconds: Float, clock: Float64, flooded: Bool)
        Local dx = toX - x
        Local dz = toZ - z
        Local apart = Sqrt(dx * dx + dz * dz)
        If !walking && apart > STARTS_AT Then walking = True
        If walking && apart < STOPS_AT Then walking = False
        moved = 0.0
        If !walking Then Return
        Local aim = Aim(toX, toZ)
        Local aimX = aim.x - x
        Local aimZ = aim.y - z
        Local toAim = Sqrt(aimX * aimX + aimZ * aimZ)
        If toAim < 0.001 Then Return
        Local reach = PIP_SPEED * seconds
        // To where it stops short of you, if it's you it's aiming at.
        If aim.x == toX && aim.y == toZ
            If toAim - STOPS_AT < 0.01
                walking = False
                Return
            End If
            reach = Min(reach, toAim - STOPS_AT)
        End If
        reach = Min(reach, toAim)
        Local fromX = x
        Local fromZ = z
        Slide(aimX / toAim * reach, aimZ / toAim * reach, clock, flooded)
        // Square against something, in line with where it's going: around it.
        If x == fromX && z == fromZ Then Slide(aimZ / toAim * reach, -aimX / toAim * reach, clock,
                                               flooded)
        If x == fromX && z == fromZ Then Slide(-aimZ / toAim * reach, aimX / toAim * reach, clock,
                                               flooded)
        Local wentX = x - fromX
        Local wentZ = z - fromZ
        moved = Sqrt(wentX * wentX + wentZ * wentZ)
        If moved > 0.0 Then facing = Atan2(wentX, wentZ)
    End Method

    // Where it's going next: to you, unless the mill's wall is between you, when it's to the door.
    Method Aim(toX: Float, toZ: Float): Vec2
        If InMill(x, z) == InMill(toX, toZ) Then Return Vec2(toX, toZ)
        Local outside = MILL_D + 1.5
        If !InMill(x, z) && Abs(x - MAIN_X) < DOOR_W - 0.5 && z > 0.0
            Return Vec2(MAIN_X, MILL_D - 1.0)
        End If
        Return Vec2(MAIN_X, outside)
    End Method

    // Each way it can go by itself, so a wall slides it along.
    Method Slide(byX: Float, byZ: Float, clock: Float64, flooded: Bool)
        Local nextX = x + byX
        If !Blocked(nextX, z) && CanWade(x, z, nextX, z, clock, flooded) Then x = nextX
        Local nextZ = z + byZ
        If !Blocked(x, nextZ) && CanWade(x, z, x, nextZ, clock, flooded) Then z = nextZ
    End Method
End Class
