// The game's sounds in its world: streamed wind and sea all around, rising with the tide; gulls
// over the water, creaks and the wheel at the mill, and your own steps, as its Cues say.

Import std.core
Import std.io
Import std.math
Import fbengine
Import fbengine_audio
Import "./cues"
Import "./flow"
Import "./game"
Import "./ground"
Import "./island"
Import "./res" As Res

// How far from you a gull calls, and how near and far something at the mill is heard.
Const GULL_AWAY: Float = 25.0
Const NEAR: Float = 3.0
Const FAR: Float = 60.0

/// What's playing, for a Game, from the Listener at your eyes.
Public Final Class Soundscape
    Field cues: Cues
    Field sounds: Sound[]
    Field wind: Sound
    Field sea: Sound
    Field wheel: Sound
    Field windPlays: Channel
    Field seaPlays: Channel
    Field wheelPlays: Channel?
    // What's outside the mill: the wind, the sea, and gulls.
    Field outside: Bus
    Field atMill: Emitter
    Field overhead: Emitter
    Field fromX: Float
    Field fromZ: Float
    Field played: Int[]

    New(sounds: Sound[], wind: Sound, sea: Sound, wheel: Sound, game: Game, island: Island)
        Self.sounds = sounds
        Self.wind = wind
        Self.sea = sea
        Self.wheel = wheel
        cues = Cues()
        played = [0, 0, 0, 0, 0, 0]
        For number = 0 Until sounds.Count
            sounds[number].SetVolume(CueLevel(number As Cue))
        End For
        outside = Bus()
        wind.SetBus(outside)
        sea.SetBus(outside)
        sounds[Cue.GULL As Int].SetBus(outside)
        wind.SetLoop(True)
        sea.SetLoop(True)
        wheel.SetLoop(True)
        windPlays = wind.Play()
        seaPlays = sea.Play()
        Local works = island.PlaceOf(Spot.WORKS)
        atMill = Emitter()
        atMill.SetPosition(Vec3(works.x, GroundHeight(works.x, works.y) + 2.0, works.y))
        atMill.SetRange(NEAR, FAR)
        overhead = Emitter()
        overhead.SetRange(NEAR, FAR)
        Local start = game.Location()
        fromX = start.x
        fromZ = start.y
        Listener.Follow(game.View())
    End New

    /// Starts it for `game`; the audio's to be started already.
    @MainThread
    Public Static Method Make(game: Game, island: Island): Soundscape Throws IOError
        // By Cue's numbers.
        Local sounds = [Try Assets.Load<Sound>(Res.Step1), Try Assets.Load<Sound>(Res.Step2),
                        Try Assets.Load<Sound>(Res.Step3), Try Assets.Load<Sound>(Res.Gull),
                        Try Assets.Load<Sound>(Res.Creak), Try Assets.Load<Sound>(Res.Splash)]
        Return Soundscape(sounds, Try Assets.Load<Sound>(Res.Wind), Try Assets.Load<Sound>(Res.Sea),
                          Try Assets.Load<Sound>(Res.Wheel), game, island)
    End Method

    /// How many times `cue` has played.
    @MainThread Public Method Played(cue: Cue): Int => played[cue As Int]

    /// Whether the wind and sea are streamed, and playing.
    @MainThread
    Public Method AroundYou(): Bool
        Return wind.Streamed() && sea.Streamed() && windPlays.Playing() && seaPlays.Playing()
    End Method

    /// The low-pass on what's outside, now.
    @MainThread Public Method OutsideNow(): Float => outside.LowPass()

    /// The wind's level now.
    @MainThread Public Method WindNow(): Float => windPlays.Volume()

    /// The sea's level now.
    @MainThread Public Method SeaNow(): Float => seaPlays.Volume()

    /// The wheel's pitch now, or 0 while it isn't turning.
    @MainThread
    Public Method WheelPitch(): Float
        Local plays = wheelPlays
        Return plays != Null ? plays.Pitch() : 0.0
    End Method

    /// Moves it on `seconds`, as `game` has.
    @MainThread
    Public Method Update(game: Game, seconds: Float)
        Local flow = game.Story()
        Local here = game.Location()
        Local dx = here.x - fromX
        Local dz = here.y - fromZ
        fromX = here.x
        fromZ = here.y
        For cue In cues.Step(flow, Sqrt(dx * dx + dz * dz), seconds)
            Play(cue, here)
        End For
        windPlays.SetVolume(WindLevel(flow.Clock()))
        seaPlays.SetVolume(SeaLevel(flow.Clock(), flow.At() == Area.INSIDE))
        outside.SetLowPass(OutsideLowPass(flow.At() == Area.INSIDE))
        Local speed = WheelSpeed(flow.Ended())
        If speed > 0.0 && wheelPlays == Null
            Local plays = atMill.Play(wheel)
            plays.SetVolume(WheelLevel(speed))
            plays.SetPitch(0.6 + 0.4 * speed)
            wheelPlays = plays
        End If
    End Method

    /// Stops it, and lets its sounds go.
    @MainThread
    Public Method Free()
        Listener.Unfollow()
        windPlays.Stop()
        seaPlays.Stop()
        Local plays = wheelPlays
        If plays != Null Then plays.Stop()
        atMill.Free()
        overhead.Free()
        For sound In sounds
            sound.Free()
        End For
        wind.Free()
        sea.Free()
        wheel.Free()
        outside.Free()
    End Method

    // Plays a cue where it happens: your steps at you, a gull out over the water, a creak at the mill.
    @MainThread
    Method Play(cue: Cue, here: Vec2)
        played[cue As Int] += 1
        Local sound = sounds[cue As Int]
        Select cue
            Case Cue.GULL
                overhead.SetPosition(Vec3(here.x + GULL_AWAY, 15.0, here.y - GULL_AWAY))
                overhead.Play(sound)
            Case Cue.CREAK
                atMill.Play(sound)
            Default
                sound.Play()
        End Select
    End Method
End Class
