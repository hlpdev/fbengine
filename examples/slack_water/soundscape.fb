// The game's sounds in its world: streamed wind, sea, and surf all around, by the storm and tide, the
// wind gusting and the surf roaring from the flood, muffled from inside the mill; gulls over the water,
// creaks at the mill, the wheel at the wheel, the flood's splash on the road, the mill's parts fitted,
// its sluice, and its works once the wheel turns; and your own steps, on sand, rock, turf, the road,
// the mill's boards, or the shallows, as its Cues say. What's in the mill rings in its room, your steps
// too while you're in it, and is muffled from outside, as the outside is from in. And a music bed, the
// calm theme turning to the storm's as the weather and tide come, under the cues, quieter inside.

Import std.core
Import std.math
Import fbengine
Import fbengine_audio
Import "./cues"
Import "./flow"
Import "./game"
Import "./ground"
Import "./island"
Import "./map"
Import "./res" As Res

// How near something's at its full level, and how far it's heard; a gull's nearer and falls off less,
// as it's far off, and it's high, as gulls are.
Const NEAR: Float = 3.0
Const FAR: Float = 60.0
Const GULL_NEAR: Float = 15.0
Const GULL_ROLLOFF: Float = 0.3
Const GULL_HIGH: Float = 12.0
// How high Pip's voice is over the ground, at its head.
Const PIP_HIGH: Float = 0.7
// How long the wheel takes to be heard.
Const WHEEL_FADE: Float64 = 1.0

/// What a player's options set the level of: everything, the music, the wind's, sea's, and surf's beds,
/// and the effects, everything else.
Public Enum Mix
    MASTER = 0
    MUSIC = 1
    AMBIENCE = 2
    EFFECTS = 3
End Enum

/// The mill's room: stone and boards, middling, its highs soaked up a little, and its ring under what
/// rings it.
Public Function MillReverb(): Reverb
    Return Reverb(RoomSize: 0.55, Damping: 0.45, Width: 0.8, Wet: 0.28, Dry: 1.0)
End Function

/// What's playing, for a Game, from the Listener at your eyes.
Public Final Class Soundscape
    Field cues: Cues
    Field sounds: Sound[]
    Field wind: Sound
    Field sea: Sound
    Field surf: Sound
    Field wheel: Sound
    Field works: Sound
    Field calm: Sound
    Field storm: Sound
    Field calmPlays: Channel
    Field stormPlays: Channel
    // Its buses, by what a player's options set: everything, under which the music's level, the beds',
    // and the effects'. Each holds what does the work: the music's own, turned down under the cues and
    // inside; the beds outside, and the effects outside, each muffled from inside; and the mill's room.
    Field everything: Bus
    Field musicLevel: Bus
    Field ambience: Bus
    Field effects: Bus
    Field mixLevels: Float[]
    Field music: Bus
    Field ducking: Ducking
    Field cued: Bool = False
    Field musicSet: Float = 1.0
    Field windPlays: Channel
    Field seaPlays: Channel
    Field surfPlays: Channel
    Field wheelPlays: Channel?
    Field worksPlays: Channel?
    // What's outside the mill: the wind, sea, and surf, and the gulls, the wheel, and the splash.
    Field outsideBeds: Bus
    Field outsideEffects: Bus
    Field cutoff: Float
    // What's in the mill, in its room: creaks, parts fitted, the sluice, the works, and your steps while
    // you're in it; and its low-pass, which muffles it from outside.
    Field mill: Bus
    // Your own steps while you're in the mill: its room, with no low-pass, as you're never outside
    // them, so the first step in isn't muffled while the mill's low-pass opens.
    Field stepsInside: Bus
    Field millCutoff: Float
    Field inMill: Bool = False
    Field pipInMill: Bool = False
    Field atPip: Emitter
    Field atMill: Emitter
    Field atWheel: Emitter
    Field onRoad: Emitter
    Field overhead: Emitter
    Field fromX: Float
    Field fromZ: Float
    Field played: Int[]
    // What the wind, sea, and surf are at, 0 for none, to hear the rest by itself.
    Field beds: Float = 1.0
    // What the surf's at, and the wind and sea, apart, under beds, so a test can hear each alone.
    Field surfBed: Float = 1.0
    Field windSea: Float = 1.0
    // The terrain's heights, as its cover's baked, which say what you're walking on.
    Field heights: Float[]
    // How far through the door the wind's, sea's, and surf's levels are, from 0, outside, to 1, inside.
    Field indoors: Float = 0.0

    New(sounds: Sound[], wind: Sound, sea: Sound, surf: Sound, wheel: Sound, works: Sound,
        calm: Sound, storm: Sound, game: Game, island: Island)
        Self.sounds = sounds
        Self.wind = wind
        Self.sea = sea
        Self.surf = surf
        heights = TerrainHeights()
        Self.wheel = wheel
        Self.works = works
        works.SetLoop(True)
        Self.calm = calm
        Self.storm = storm
        ducking = Ducking()
        everything = Bus()
        musicLevel = Bus(everything)
        ambience = Bus(everything)
        effects = Bus(everything)
        mixLevels = [1.0, 1.0, 1.0, 1.0]
        music = Bus(musicLevel)
        calm.SetBus(music)
        storm.SetBus(music)
        calm.SetLoop(True)
        storm.SetLoop(True)
        // Together, from the start, so the crossfade's of one bed in time.
        Local levels = MusicLevels(0.0, False)
        calm.SetVolume(levels.0)
        storm.SetVolume(levels.1)
        calmPlays = calm.Play()
        stormPlays = storm.Play()
        cues = Cues()
        played = []
        For number = 0 Until CUES
            played.Add(0)
        End For
        For number = 0 Until sounds.Count
            sounds[number].SetVolume(CueLevel(number As Cue))
        End For
        outsideBeds = Bus(ambience)
        outsideEffects = Bus(effects)
        cutoff = OutsideCutoff(False)
        outsideBeds.SetLowPass(cutoff)
        outsideEffects.SetLowPass(cutoff)
        mill = Bus(effects)
        stepsInside = Bus(effects)
        stepsInside.SetReverb(MillReverb())
        mill.SetReverb(MillReverb())
        millCutoff = OutsideCutoff(True)
        mill.SetLowPass(millCutoff)
        works.SetBus(mill)
        For cue In [Cue.CREAK, Cue.FIT, Cue.SLUICE]
            sounds[cue As Int].SetBus(mill)
        End For
        wind.SetBus(outsideBeds)
        sea.SetBus(outsideBeds)
        surf.SetBus(outsideBeds)
        wheel.SetBus(outsideEffects)
        sounds[Cue.GULL As Int].SetBus(outsideEffects)
        sounds[Cue.SPLASH As Int].SetBus(outsideEffects)
        wind.SetLoop(True)
        sea.SetLoop(True)
        surf.SetLoop(True)
        wheel.SetLoop(True)
        // They start at their levels, not at 1.
        wind.SetVolume(WindLevel(0.0, True))
        sea.SetVolume(SeaLevel(0.0, True))
        surf.SetVolume(SurfLevel(0.0, True))
        windPlays = wind.Play()
        seaPlays = sea.Play()
        surfPlays = surf.Play()
        Local worksAt = island.PlaceOf(Spot.WORKS)
        atMill = MadeEmitter(Vec3(worksAt.x, GroundHeight(worksAt.x, worksAt.y) + 2.0, worksAt.y))
        atWheel = MadeEmitter(island.WheelAt())
        Local middle = PaddleSpot()
        onRoad = MadeEmitter(Vec3(middle.x, GroundHeight(middle.x, middle.y) + 1.0, middle.y))
        onRoad.SetRange(GULL_NEAR, FAR * 2.0)
        overhead = MadeEmitter(Vec3(0.0, GULL_HIGH, 0.0))
        Local pip = game.PipLocation()
        atPip = MadeEmitter(Vec3(pip.x, GroundHeight(pip.x, pip.y) + PIP_HIGH, pip.y))
        pipInMill = InMill(pip.x, pip.y)
        overhead.SetRange(GULL_NEAR, FAR * 2.0)
        overhead.SetRolloff(GULL_ROLLOFF)
        Local start = game.Location()
        fromX = start.x
        fromZ = start.y
        Listener.Follow(game.View())
    End New

    // An Emitter at `place`, with no Doppler effect, as nothing here goes fast enough to want it.
    @MainThread
    Static Method MadeEmitter(place: Vec3): Emitter
        Local made = Emitter()
        made.SetPosition(place)
        made.SetRange(NEAR, FAR)
        made.SetDoppler(0.0)
        Return made
    End Method

    /// Starts it for `game`; the audio's to be started already.
    @MainThread
    Public Static Method Make(game: Game, island: Island): Soundscape Throws IOError
        // By Cue's numbers.
        Local sounds = [Try Assets.Load<Sound>(Res.Step1), Try Assets.Load<Sound>(Res.Step2),
                        Try Assets.Load<Sound>(Res.Step3), Try Assets.Load<Sound>(Res.Gull),
                        Try Assets.Load<Sound>(Res.Creak), Try Assets.Load<Sound>(Res.Splash),
                        Try Assets.Load<Sound>(Res.Floor1), Try Assets.Load<Sound>(Res.Floor2),
                        Try Assets.Load<Sound>(Res.Wade1), Try Assets.Load<Sound>(Res.Wade2),
                        Try Assets.Load<Sound>(Res.Sand1), Try Assets.Load<Sound>(Res.Sand2),
                        Try Assets.Load<Sound>(Res.Turf1), Try Assets.Load<Sound>(Res.Turf2),
                        Try Assets.Load<Sound>(Res.Fit), Try Assets.Load<Sound>(Res.Sluice),
                        Try Assets.Load<Sound>(Res.PipHello), Try Assets.Load<Sound>(Res.PipTakes),
                        Try Assets.Load<Sound>(Res.PipGives),
                        Try Assets.Load<Sound>(Res.PipWorries),
                        Try Assets.Load<Sound>(Res.PipGlad), Try Assets.Load<Sound>(Res.PipSad)]
        Return Soundscape(sounds, Try Assets.Load<Sound>(Res.Wind), Try Assets.Load<Sound>(Res.Sea),
                          Try Assets.Load<Sound>(Res.Surf), Try Assets.Load<Sound>(Res.Wheel),
                          Try Assets.Load<Sound>(Res.Works), Try Assets.Load<Sound>(Res.Calm),
                          Try Assets.Load<Sound>(Res.Storm), game, island)
    End Method

    /// How many times `cue` has played.
    @MainThread Public Method Played(cue: Cue): Int => played[cue As Int]

    /// Whether the wind, sea, and surf are streamed, and playing.
    @MainThread
    Public Method AroundYou(): Bool
        Return wind.Streamed() && sea.Streamed() && surf.Streamed() && windPlays.Playing() &&
               seaPlays.Playing() && surfPlays.Playing()
    End Method

    /// The low-pass on what's outside, now.
    @MainThread Public Method OutsideNow(): Float => outsideBeds.LowPass()

    /// Sets what a player's options say `mix` is at, from 0, none, to 1, as it's made. Outside that
    /// panics.
    @MainThread
    Public Method SetLevel(mix: Mix, level: Float)
        If !(level >= 0.0 && level <= 1.0) Then Panic("a level is 0 to 1, not {level}")
        mixLevels[mix As Int] = level
        Select mix
            Case Mix.MASTER
                everything.SetVolume(level)
            Case Mix.MUSIC
                musicLevel.SetVolume(level)
            Case Mix.AMBIENCE
                ambience.SetVolume(level)
            Default
                effects.SetVolume(level)
        End Select
    End Method

    /// What a player's options say `mix` is at.
    @MainThread Public Method Level(mix: Mix): Float => mixLevels[mix As Int]

    /// The wind's level now.
    @MainThread Public Method WindNow(): Float => windPlays.Volume()

    /// The sea's level now.
    @MainThread Public Method SeaNow(): Float => seaPlays.Volume()

    /// The surf's level now.
    @MainThread Public Method SurfNow(): Float => surfPlays.Volume()

    /// The wind's pitch now.
    @MainThread Public Method WindPitchNow(): Float => windPlays.Pitch()

    /// The wheel's pitch now, or 0 while it isn't turning.
    @MainThread
    Public Method WheelPitch(): Float
        Local plays = wheelPlays
        Return plays != Null ? plays.Pitch() : 0.0
    End Method

    /// The works' pitch now, or 0 while they aren't running.
    @MainThread
    Public Method WorksPitch(): Float
        Local plays = worksPlays
        Return plays != Null ? plays.Pitch() : 0.0
    End Method

    /// Where a creak's heard from, the wheel, and the flood's splash.
    @MainThread Public Method MillAt(): Vec3 => atMill.Position()

    @MainThread Public Method WheelAt(): Vec3 => atWheel.Position()

    @MainThread Public Method SplashAt(): Vec3 => onRoad.Position()

    /// Where Pip's voice is heard from, and whether that's in the mill.
    @MainThread Public Method PipAt(): Vec3 => atPip.Position()

    @MainThread Public Method PipInMill(): Bool => pipInMill

    /// Whether what's outside the mill goes through the buses that muffle it, the beds' and the effects',
    /// each under its own level, and everything under Master.
    @MainThread
    Public Method OutsideOnItsBus(): Bool
        For sound In [wind, sea, surf]
            If sound.Bus() != outsideBeds Then Return False
        End For
        For sound In [wheel, sounds[Cue.GULL As Int], sounds[Cue.SPLASH As Int]]
            If sound.Bus() != outsideEffects Then Return False
        End For
        Return outsideBeds.Parent() == ambience && outsideEffects.Parent() == effects &&
               mill.Parent() == effects && music.Parent() == musicLevel &&
               musicLevel.Parent() == everything && ambience.Parent() == everything &&
               effects.Parent() == everything && everything.Parent() == Null
    End Method

    /// Sets what the wind and sea are at, 0 for none, to hear the rest by itself.
    @MainThread
    Public Method SetBeds(level: Float)
        beds = level
        windPlays.SetVolume(WindLevel(0.0, False) * beds * windSea)
        seaPlays.SetVolume(SeaLevel(0.0, False) * beds * windSea)
        surfPlays.SetVolume(SurfLevel(0.0, False) * beds * surfBed)
    End Method

    /// Sets what the surf's at by itself, 0 for none, under SetBeds'.
    @MainThread
    Public Method SetSurf(level: Float)
        surfBed = level
        surfPlays.SetVolume(SurfLevel(0.0, False) * beds * surfBed)
    End Method

    /// Sets what the wind and sea are at by themselves, 0 for none, under SetBeds'.
    @MainThread
    Public Method SetWindAndSea(level: Float)
        windSea = level
        windPlays.SetVolume(WindLevel(0.0, False) * beds * windSea)
        seaPlays.SetVolume(SeaLevel(0.0, False) * beds * windSea)
    End Method

    /// How many cues it has a sound for.
    @MainThread Public Method CueCount(): Int => sounds.Count

    /// Moves it on `seconds`, as `game` has.
    @MainThread
    Public Method Update(game: Game, seconds: Float)
        Local flow = game.Story()
        Local here = game.Location()
        Local dx = here.x - fromX
        Local dz = here.y - fromZ
        fromX = here.x
        fromZ = here.y
        Local inside = InMill(here.x, here.y)
        // Pip's voice from its head, in the mill's room while it's in it, and outside's while not.
        Local pip = game.PipLocation()
        atPip.SetPosition(Vec3(pip.x, GroundHeight(pip.x, pip.y) + PIP_HIGH, pip.y))
        pipInMill = InMill(pip.x, pip.y)
        Local surface = SurfaceAt(heights, here.x, here.y, inside, SeaHeight(flow.Clock()))
        For cue In cues.Step(flow, Sqrt(dx * dx + dz * dz), seconds, surface, inside)
            sounds[cue As Int].SetPitch(
                IsStep(cue) ? StepPitch(surface) : 1.0)
            Play(cue, here)
        End For
        Surroundings(flow.Clock(), inside, seconds)
        Local speed = WheelSpeed(flow.Ended())
        If speed > 0.0 && wheelPlays == Null
            // At its level and pitch from its first sample.
            wheel.SetVolume(WheelLevel(speed))
            wheel.SetPitch(speed)
            wheelPlays = atWheel.Play(wheel, False, WHEEL_FADE)
        End If
        If speed > 0.0 && worksPlays == Null
            works.SetVolume(WorksLevel(speed))
            works.SetPitch(speed)
            worksPlays = atMill.Play(works, False, WHEEL_FADE)
        End If
    End Method

    /// Sets the wind, sea, and surf for `clock`, heard from `inside` the mill or not, the low-pass
    /// moving toward what suits, `seconds` on, and the wind's pitch by the storm.
    @MainThread
    Public Method Surroundings(clock: Float64, inside: Bool, seconds: Float)
        // Their levels move as the low-pass does, so going through the door doesn't click.
        Local goal = inside ? 1.0 : 0.0
        Local most = seconds * 2.5
        indoors += Clamp(goal - indoors, -most, most)
        Local windAt = WindLevel(clock, False) +
                       (WindLevel(clock, True) - WindLevel(clock, False)) * indoors
        Local seaAt = SeaLevel(clock, False) +
                      (SeaLevel(clock, True) - SeaLevel(clock, False)) * indoors
        Local surfAt = SurfLevel(clock, False) +
                       (SurfLevel(clock, True) - SurfLevel(clock, False)) * indoors
        windPlays.SetVolume(windAt * beds * windSea)
        seaPlays.SetVolume(seaAt * beds * windSea)
        surfPlays.SetVolume(surfAt * beds * surfBed)
        windPlays.SetPitch(WindPitch(clock))
        // The music: crossfaded by the weather and tide, ducked under what's been cued, and quieter
        // inside, as far through the door as the beds are.
        Local levels = MusicLevels(clock, False)
        calmPlays.SetVolume(levels.0 * musicSet)
        stormPlays.SetVolume(levels.1 * musicSet)
        music.SetVolume(ducking.Step(seconds, cued) * (1.0 + (MUSIC_INSIDE - 1.0) * indoors))
        cued = False
        cutoff = CutoffToward(cutoff, OutsideCutoff(inside), seconds)
        outsideBeds.SetLowPass(cutoff)
        outsideEffects.SetLowPass(cutoff)
        // The mill's room, the other way round: open from inside, muffled from out.
        millCutoff = CutoffToward(millCutoff, OutsideCutoff(!inside), seconds)
        mill.SetLowPass(millCutoff)
        inMill = inside
    End Method

    /// Whether what's in the mill goes through its room, and its ring's heard.
    @MainThread
    Public Method MillOnItsBus(): Bool
        Local all = [works, sounds[Cue.CREAK As Int], sounds[Cue.FIT As Int],
                     sounds[Cue.SLUICE As Int]]
        For sound In all
            If sound.Bus() != mill Then Return False
        End For
        Return mill.ReverbHeard() && stepsInside.ReverbHeard() && stepsInside.LowPass() == 0.0
    End Method

    /// The calm theme's level and the storm's, now, and the music's ducking and inside's together.
    @MainThread Public Method MusicNow(): (Float, Float) => (calmPlays.Volume(),
                                                             stormPlays.Volume())

    @MainThread Public Method MusicBusNow(): Float => music.Volume()

    /// Whether the two themes are streamed, and playing.
    @MainThread
    Public Method MusicPlaying(): Bool
        Return calm.Streamed() && storm.Streamed() && calmPlays.Playing() && stormPlays.Playing()
    End Method

    /// Sets the music by itself, 0 for none, as SetBeds does the beds, from the next Surroundings.
    @MainThread Public Method SetMusic(level: Float)
        musicSet = level
    End Method

    /// The low-pass on what's in the mill, now.
    @MainThread Public Method MillNow(): Float => mill.LowPass()

    /// Plays a cue where it happens: steps at you, a gull out over the water, a creak at the mill, and
    /// the splash on the road.
    @MainThread
    Public Method Play(cue: Cue, here: Vec2)
        played[cue As Int] += 1
        // The music's ducked under anything but your steps.
        If !IsStep(cue) Then cued = True
        Local sound = sounds[cue As Int]
        Select cue
            Case Cue.GULL
                Local at = cues.GullAt(here.x, here.y)
                overhead.SetPosition(Vec3(at.x, GULL_HIGH, at.y))
                overhead.Play(sound)
            Case Cue.CREAK, Cue.FIT, Cue.SLUICE
                atMill.Play(sound)
            Case Cue.PIP_HELLO, Cue.PIP_TAKES, Cue.PIP_GIVES, Cue.PIP_WORRIES, Cue.PIP_GLAD,
                 Cue.PIP_SAD
                sound.SetBus(pipInMill ? mill : outsideEffects)
                atPip.Play(sound)
            Case Cue.SPLASH
                onRoad.Play(sound)
            Default
                // Your steps, in the mill's room while you're in it, and the effects' outside.
                sound.SetBus(inMill ? stepsInside : effects)
                sound.Play()
        End Select
    End Method

    /// Stops it, and lets its sounds go.
    @MainThread
    Public Method Free()
        Listener.Unfollow()
        windPlays.Stop()
        seaPlays.Stop()
        surfPlays.Stop()
        calmPlays.Stop()
        stormPlays.Stop()
        Local plays = wheelPlays
        If plays != Null Then plays.Stop()
        Local running = worksPlays
        If running != Null Then running.Stop()
        atPip.Free()
        atMill.Free()
        atWheel.Free()
        onRoad.Free()
        overhead.Free()
        For sound In sounds
            sound.Free()
        End For
        wind.Free()
        sea.Free()
        surf.Free()
        calm.Free()
        storm.Free()
        music.Free()
        musicLevel.Free()
        wheel.Free()
        works.Free()
        outsideBeds.Free()
        outsideEffects.Free()
        mill.Free()
        stepsInside.Free()
        ambience.Free()
        effects.Free()
        everything.Free()
    End Method
End Class
