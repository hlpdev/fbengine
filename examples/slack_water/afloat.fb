// What moves as bodies, of fbengine_physics: the rowboat on the sea, roped to the jetty's bollard,
// riding the tide and the swell and swinging on its rope; the barrels and crates by the mill, which you
// and Pip knock over; and the driftwood along the shores, which the flood lifts and floats, and which
// settles as the water falls. It's stepped in real time, in steps of a 60th of a second, whatever the
// flow's clock does as it waits, so it's the same each run, to the bit; the sea's height is the tide's,
// by that clock, and its swell, by real time.

Import std.collections
Import std.core
Import std.math
Import std.time
Import fbengine
Import fbengine_physics
Import "./ground"

// A step, and the most taken for one frame, so a slow one never makes the next slower.
Const STEP: Float64 = 1.0 / 60.0
Const MOST_STEPS: Int = 8
// Earth's pull, and water's weight, in kilograms a cubic metre.
Const PULL: Float = 9.81
Const WATER: Float = 1000.0
// The swell: how high, and how fast, as the boat bobbed before it was a body.
Const SWELL: Float = 0.05
Const SWELL_RATE: Float = 1.3

// The boat: its weight, in kilograms, how far into the sea its keel goes as it floats, and how much
// the water holds it back, by how fast it goes, up and down and along: up and down, half what would
// stop it bouncing at all, as what floats it is a spring of its weight over its draft.
Const BOAT_MASS: Float = 140.0
Const BOAT_DRAFT: Float = 0.06
Const BOAT_HEAVE: Float = 12.0
Const BOAT_DRAG: Float = 0.35
// How much longer its rope is than from the bollard to the boat as it's tied; how hard the tide pulls
// it as the water rises, in newtons for each metre a second; and how far either way of straight out
// from its bollard it pulls, swinging it, in radians, and how slowly, by the tide's clock.
Const SLACK: Float = 0.6
Const TIDE_PULL: Float = 6000.0
Const TIDE_SWING: Float = 0.6
Const TIDE_SWING_RATE: Float = 0.03

// Driftwood: how heavy it is for its size, as a fraction of water, and how much the water holds it,
// along and up and down.
Const DRIFTWOOD: Float = 0.55
Const LOG_DRAG: Float = 0.8
Const LOG_HEAVE: Float = 8.0
// A barrel's and a crate's weight, in kilograms.
Const BARREL_MASS: Float = 45.0
Const CRATE_MASS: Float = 25.0
// You and Pip, as what pushes: how tall, how wide, and how far off the ground, from the knee, so what
// you walk into tips over rather than sliding along whole; and how much the ground and what's on it
// hold each other.
Const WALKER_HIGH: Float = 1.0
Const WALKER_RADIUS: Float = 0.3
Const WALKER_KNEE: Float = 0.5
Const GRIP: Float = 0.8
Const PIP_HIGH: Float = 0.6
Const PIP_RADIUS: Float = 0.25
// How far you or Pip go in a frame that's a jump, not a walk.
Const JUMP: Float = 2.0

/// How high the swell lifts the sea at (`x`, `z`), `time` seconds of real time in: two sines across it,
/// so nothing bobs quite with its neighbor.
Public Function SwellAt(x: Float, z: Float, time: Float64): Float
    Local t = time As Float
    Return SWELL * (Sin(t * SWELL_RATE + x * 0.21 + z * 0.17) * 0.65 +
                    Sin(t * SWELL_RATE * 1.6 - x * 0.13 + z * 0.29) * 0.35)
End Function

// A point a body floats by, in its own frame; how far under it, in the world, it's in the water
// from, as a log's underside is under its axis however it's rolled; how much of its weight in water
// it holds up there when it's all under; and how far under that is.
Struct Floater
    Field at: Vec3
    Field below: Float
    Field holds: Float
    Field deep: Float
End Struct

// What floats, its points, how the water drags it, and whether the tide pulls it, as it does the
// boat, swinging it on its rope.
Final Class Floating
    Field body: Body
    Field points: Floater[]
    Field drag: Float
    Field heave: Float
    Field pulled: Bool

    New(body: Body, points: Floater[], drag: Float, heave: Float, pulled: Bool)
        Self.body = body
        Self.points = points
        Self.drag = drag
        Self.heave = heave
        Self.pulled = pulled
    End New
End Class

/// What the bodies are made of, as Afloat takes them: the boat's root, where its rope's tied on it in
/// its own frame, the bollard's top in the world, and its hull's points; each barrel and crate, by
/// kind, 0 a barrel and 1 a crate, and size; each log, its length and radius; and the static ground,
/// as triangles over where they are, and boxes, by their middles, half sizes, and turns.
Public Final Class Afloat
    Field world: PhysicsWorld
    Field boat: Body
    Field rope: Joint
    Field bollard: Vec3
    Field tie: Vec3
    Field length: Float
    // Which way the tide pulls the boat, out from its bollard, flat.
    Field away: Vec3
    Field floating: Floating[] = []
    Field props: Body[] = []
    Field logs: Body[] = []
    Field you: Body
    Field pip: Body
    Field youAt: Vec3
    Field pipAt: Vec3
    Field clock: Float64 = 0.0
    Field time: Float64 = 0.0
    Field owed: Float64 = 0.0
    Field spent: Float64 = 0.0
    Field steps: Int64 = 0
    // Each body as it was made, to put back.
    Field starts: (Body, Vec3, Quat)[] = []

    New(world: PhysicsWorld, boat: Body, rope: Joint, bollard: Vec3, tie: Vec3, length: Float,
        you: Body, pip: Body)
        Self.world = world
        Self.boat = boat
        Self.rope = rope
        Self.bollard = bollard
        Self.tie = tie
        Self.length = length
        Local out = Vec3(boat.Position().x - bollard.x, 0, boat.Position().z - bollard.z)
        away = out * (1.0 / Max(Distance(out, Vec3(0, 0, 0)), 0.001))
        Self.you = you
        Self.pip = pip
        youAt = you.Position()
        pipAt = pip.Position()
    End New

    /// The bodies, of `boat`, tied at `tie` in its frame to `bollard`, floating by `hull`'s points;
    /// `props`; `logs`; on `ground`, triangles by three of its indices into its vertices, and `boxes`.
    @MainThread
    Public Static Method Make(boat: Entity, hull: Vec3[], tie: Vec3, bollard: Vec3,
                              props: (Entity, Int, Vec3)[], logs: (Entity, Float, Float)[],
                              ground: (Vec3[], Int32[]), boxes: (Vec3, Vec3, Quat)[],
                              youAt: Vec3, pipAt: Vec3): Afloat Throws ShapeError
        Local world = PhysicsWorld()
        // Stepped by hand, a step at a time, so the water's forces go on before each.
        Body(world, Try Shape.Mesh(ground.0, ground.1), Motion.STATIC,
             Vec3(0, 0, 0)).SetFriction(GRIP)
        For box In boxes
            Body(world, Shape.Box(box.1 * 2.0), Motion.STATIC, box.0, box.2).SetFriction(GRIP)
        End For
        // The boat, of its hull's points, by what floats it: eight along its bottom, by its keel.
        Local shell = Try Shape.ConvexHull(hull)
        Local floated = Body(world, shell, Motion.DYNAMIC, boat)
        floated.SetMass(BOAT_MASS)
        Local low: Float = 1000
        Local wide: Float = 0
        Local longest: Float = 0
        For point In hull
            low = Min(low, point.y)
            wide = Max(wide, Abs(point.x))
            longest = Max(longest, Abs(point.z))
        End For
        Local points: Floater[] = []
        For along In [-0.6, -0.2, 0.2, 0.6]
            For across In [-0.45, 0.45]
                points.Add(Floater(Vec3(across * wide, low + 0.02, along * longest), 0.0,
                                   2.0 * BOAT_MASS / 8.0, BOAT_DRAFT * 2.0))
            End For
        End For
        Local tied = floated.Position() + floated.Rotation() * tie
        Local length = Distance(tied, bollard) + SLACK
        Local rope = Joint.Distance(floated, Null, tied, bollard)
        rope.SetLimits(0, length)
        // You and Pip, pushing what you walk into.
        Local you = Body(world, Shape.Capsule(WALKER_HIGH, WALKER_RADIUS), Motion.KINEMATIC, youAt)
        Local pip = Body(world, Shape.Capsule(PIP_HIGH, PIP_RADIUS), Motion.KINEMATIC, pipAt)
        Local made = Afloat(world, floated, rope, bollard, tie, length, you, pip)
        made.floating.Add(Floating(floated, points, BOAT_DRAG, BOAT_HEAVE, True))
        For prop In props
            Local thing, kind, size = prop
            If kind == 0
                // A barrel's origin is its bottom's middle.
                Local barrel = Shape.Compound([ShapePart(Shape.Cylinder(size.y, size.x),
                                                         Vec3(0, size.y * 0.5, 0), Quat.Identity)])
                Local body = Body(world, barrel, Motion.DYNAMIC, thing)
                body.SetMass(BARREL_MASS)
                body.SetFriction(GRIP)
                made.props.Add(body)
            Else
                Local body = Body(world, Shape.Box(size * 2.0), Motion.DYNAMIC, thing)
                body.SetMass(CRATE_MASS)
                body.SetFriction(GRIP)
                made.props.Add(body)
            End If
        End For
        For log In logs
            Local thing, long, radius = log
            Local wood = Shape.Compound([ShapePart(Shape.Cylinder(long, radius), Vec3(0, 0, 0),
                                                   Quat.FromAxisAngle(Vec3(0, 0, 1), Pi / 2))])
            Local body = Body(world, wood, Motion.DYNAMIC, thing)
            Local mass = DRIFTWOOD * WATER * Pi * radius * radius * long
            body.SetMass(mass)
            made.logs.Add(body)
            // Held up at two points along its axis, each half its weight in water when it's all under,
            // from its underside, its radius under, however it's rolled.
            Local holds = WATER * Pi * radius * radius * long * 0.5
            made.floating.Add(Floating(body, [Floater(Vec3(-0.3 * long, 0, 0), radius, holds,
                                                      2.0 * radius),
                                              Floater(Vec3(0.3 * long, 0, 0), radius, holds,
                                                      2.0 * radius)], LOG_DRAG, LOG_HEAVE, False))
        End For
        Local all = [floated]
        all.AddAll(made.props)
        all.AddAll(made.logs)
        For body In all
            made.starts.Add((body, body.Position(), body.Rotation()))
        End For
        Return made
    End Method

    /// Puts each body back where it was made, still, for another game, and the swell's time to 0.
    @MainThread
    Public Method Reset()
        For start In starts
            Local body, place, turn = start
            body.Teleport(place, turn)
        End For
        owed = 0.0
        time = 0.0
    End Method

    /// Sets the tide's clock, `clock` seconds in, for the sea's height.
    @MainThread Public Method SetClock(clock: Float64)
        Self.clock = clock
    End Method

    /// Where you are and Pip is, on the ground, for what you each knock over.
    @MainThread
    Public Method SetWalkers(you: Vec3, pip: Vec3)
        youAt = you
        pipAt = pip
    End Method

    /// The tide's clock, as SetClock set it.
    @MainThread Public Method Clock(): Float64 => clock

    /// How high the sea is at (`x`, `z`) now.
    @MainThread
    Public Method WaterAt(x: Float, z: Float): Float => SeaHeight(clock) + SwellAt(x, z, time)

    /// Moves it all on `seconds` of real time, in as many steps as are due.
    @MainThread
    Public Method Step(seconds: Float)
        Local began = Instant.Now()
        owed += seconds As Float64
        // How many steps are due, so you and Pip go where you've walked across them, not in the first.
        Local due = 0
        Local left = owed
        While left >= STEP * 0.999 && due < MOST_STEPS
            left -= STEP
            due += 1
        End While
        Local youFrom = you.Position()
        Local pipFrom = pip.Position()
        Local youTo = youAt + Vec3(0, WALKER_KNEE + WALKER_HIGH * 0.5 + WALKER_RADIUS, 0)
        Local pipTo = pipAt + Vec3(0, PIP_HIGH * 0.5 + PIP_RADIUS, 0)
        Local taken = 0
        While owed >= STEP * 0.999 && taken < MOST_STEPS
            Buoy()
            Local through = ((taken + 1) As Float) / (Max(due, 1) As Float)
            Walk(you, youFrom, youTo, through)
            Walk(pip, pipFrom, pipTo, through)
            world.Step(STEP)
            owed -= STEP
            time += STEP
            taken += 1
            steps += 1
        End While
        If owed >= STEP Then owed = 0
        spent += (Instant.Now() - began).TotalSeconds
    End Method

    // Moves `walker` a step on its way from `from` to `to`, `through` of it by the step's end; one
    // that's jumped, as the flood puts you ashore, it puts there at once, pushing nothing.
    Method Walk(walker: Body, from: Vec3, to: Vec3, through: Float)
        If Distance(from, to) > JUMP
            walker.Teleport(to, Quat.Identity)
            Return
        End If
        walker.MoveTo(from + (to - from) * through, Quat.Identity, STEP As Float)
    End Method

    // Pushes what's in the water up, at each of its points, by how far under it is, and holds it
    // back, by how fast each point goes.
    Method Buoy()
        Local rising = SeaHeight(clock + 1.0) - SeaHeight(clock)
        For each In floating
            Local body = each.body
            Local place = body.Position()
            Local turn = body.Rotation()
            Local going = body.Velocity()
            Local turning = body.AngularVelocity()
            Local wet = False
            For point In each.points
                Local at = place + turn * point.at
                Local under = WaterAt(at.x, at.z) - at.y + point.below
                If under <= 0 Then Continue
                wet = True
                Local share = Min(under / point.deep, 1.0)
                Local moving = going + Cross(turning, at - place)
                Local push = Vec3(0, point.holds * PULL * share, 0) -
                             Vec3(moving.x * each.drag, moving.y * each.heave,
                                  moving.z * each.drag) *
                             (point.holds * share)
                body.AddForceAt(push, at)
            End For
            // The tide pulls the boat out from its bollard as it rises, swinging either way of straight
            // out as it goes.
            If each.pulled && wet && rising > 0
                Local swing = TIDE_SWING * (Sin(clock * TIDE_SWING_RATE) As Float)
                Local way = Quat.FromAxisAngle(Vec3(0, 1, 0), swing) * away
                body.AddForce(way * (TIDE_PULL * rising))
            End If
        End For
    End Method

    /// The boat.
    @MainThread Public Method Boat(): Body => boat

    /// The barrels and crates, as Make had them.
    @MainThread Public Method Props(): Body[] => props

    /// The logs, as Make had them.
    @MainThread Public Method Logs(): Body[] => logs

    /// Where the rope's tied on the boat now, in the world, and the bollard's top.
    @MainThread Public Method RopeEnds(): (Vec3, Vec3) => (boat.Position() + boat.Rotation() * tie,
                                                           bollard)

    /// How long the rope is.
    @MainThread Public Method RopeLength(): Float => length

    /// How many steps it's taken, and how long they took, in seconds of the machine's.
    @MainThread Public Method Steps(): Int64 => steps
    @MainThread Public Method Spent(): Float64 => spent

    /// The world's state, as a hash, for runs to compare.
    @MainThread Public Method StateHash(): UInt64 => world.StateHash()

    /// Frees it, and its world.
    @MainThread
    Public Method Free()
        world.Free()
    End Method
End Class
