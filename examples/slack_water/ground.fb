// The island's shape and the sea's height, as numbers, apart from anything drawn: two rocks and a
// low road between them, a sea that rises to top it as the flow says it floods, and where someone
// can walk, and which of the flow's places that is.

Import std.core
Import std.math
Import "./flow"
Import "./map"

/// How many squares the ground has on a side, each a meter.
Public Const SIDE: Int = 240
// How high the road's top is, above the sea at slack water.
Const ROAD_HEIGHT: Float = 0.5
// How far over the road the sea is as it floods, so what's under doesn't fight with it.
Const SURGE: Float = 0.1
// How high the sea rises, by the time the tide's in.
Const HIGH_WATER: Float = 1.6
// How far in from the terrain's edge its ground goes under, so no rock has an open side.
Const EDGE: Float = 14.0
// How wide each rock is, about.
Const MAIN_RADIUS: Float = 42.0
Const FAR_RADIUS: Float = 20.0
// The headland behind the mill, north of its yard, the island's high ground.
Const HEADLAND_X: Float = MAIN_X - 4.0
Const HEADLAND_Z: Float = -58.0
Const HEADLAND_RADIUS: Float = 22.0
// How high the crags on it and on the far rock get, over what's under them.
Const HEADLAND_CRAGS: Float = 16.0
Const FAR_CRAGS: Float = 4.0
// How far past its shores the road's ground runs, into each rock, so no gap's left.
Const ROAD_INTO: Float = 14.0
// How far in the sea you can wade, and how far past a line you have to go for it to count as crossed.
Const WADE: Float = 0.25
Const LINGER: Float = 1.0

// A number from 0 to 1 for a lattice point, the same each time.
Function Hash(x: Int, y: Int): Float
    Local mixed: Int64 = (((x As Int64) * 73856093) ^ ((y As Int64) * 19349663)) & 0x7FFFFFFF
    mixed = ((mixed ^ (mixed >> 13)) * 1274126177) & 0x7FFFFFFF
    mixed = mixed ^ (mixed >> 16)
    Return ((mixed & 0xFFFF) As Float) / 65535.0
End Function

// Value noise, smooth between the whole numbers, from 0 to 1.
Function Noise(x: Float, y: Float): Float
    Local left = Floor(x)
    Local top = Floor(y)
    Local u = x - left
    Local v = y - top
    u = u * u * (3.0 - 2.0 * u)
    v = v * v * (3.0 - 2.0 * v)
    Local a = Hash(left As Int, top As Int)
    Local b = Hash((left As Int) + 1, top As Int)
    Local c = Hash(left As Int, (top As Int) + 1)
    Local d = Hash((left As Int) + 1, (top As Int) + 1)
    Return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v
End Function

// Noise of a few octaves, from 0 to 1.
Function Rough(x: Float, y: Float): Float
    Return (Noise(x * 0.03, y * 0.03) * 0.57 + Noise(x * 0.09, y * 0.09) * 0.29 +
            Noise(x * 0.27, y * 0.27) * 0.14)
End Function

// A rock's shape: 1 at its middle, past 0 inside its `radius`, below it outside, its edge broken.
Function Mound(x: Float, z: Float, centerX: Float, centerZ: Float, radius: Float): Float
    Local dx = x - centerX
    Local dz = z - centerZ
    Local edge = radius * (0.72 + Rough(x + 300.0, z + 300.0) * 0.56)
    Return 1.0 - Sqrt(dx * dx + dz * dz) / edge
End Function

// Noise folded into ridges, from 0 to 1: crags at two scales, sharp along their tops.
Function Ridged(x: Float, z: Float): Float
    Local wide = 1.0 - Abs(2.0 * Noise(x * 0.04 + 11.0, z * 0.04 + 5.0) - 1.0)
    Local fine = 1.0 - Abs(2.0 * Noise(x * 0.11 + 3.0, z * 0.11 + 17.0) - 1.0)
    Return wide * wide * 0.6 + fine * fine * 0.4
End Function

/// How far the lighthouse's plinth reaches from its middle.
Public Const PLINTH: Float = 1.85

// How high the ground is at (`x`, `z`), but for the road, and flat round the lighthouse, out a little
// past its plinth, so it stands level.
Public Function RockHeight(x: Float, z: Float): Float
    Local spot = LighthouseSpot()
    Local away = Sqrt((x - spot.x) * (x - spot.x) + (z - spot.y) * (z - spot.y))
    Local pad = Clamp(1.0 - (away - PLINTH - 0.4) / 3.0, 0.0, 1.0)
    Local height = Rock(x, z)
    If pad <= 0.0 Then Return height
    Return height + (Rock(spot.x, spot.y) - height) * pad
End Function

// How high the rocks are at (`x`, `z`), as they are.
Function Rock(x: Float, z: Float): Float
    Local far = Mound(x, z, FAR_X, FAR_Z, FAR_RADIUS)
    Local headland = Mound(x, z, HEADLAND_X, HEADLAND_Z, HEADLAND_RADIUS)
    Local land = Max(Max(Mound(x, z, MAIN_X, 0.0, MAIN_RADIUS), far), headland)
    Local height = land * 6.0
    If land > 0.0
        Local high = Clamp(headland, 0.0, 1.0)
        Local low = Clamp(far, 0.0, 1.0)
        Local crags = Max(high * high * HEADLAND_CRAGS, low * low * FAR_CRAGS) * Ridged(x, z)
        // What's broken up, but for its shores, which stay as smooth as sand.
        Local broken = (Noise(x * 0.6, z * 0.6) - 0.5) * 0.5 * Clamp((land - 0.12) * 6.0, 0.0, 1.0)
        height = land * (5.0 + Rough(x, z) * 9.0) + crags + broken
    End If
    // The yard's flat, where the mill stands.
    Local yard = Clamp(1.0 - (Sqrt((x - MAIN_X) * (x - MAIN_X) + z * z) - 22.0) / 14.0, 0.0, 1.0)
    Return height + (4.0 - height) * yard
End Function

/// How high the ground is at (`x`, `z`), meters from its middle: under the sea, 0 at slack water,
/// but for the main rock, the far one, and the road from one to the other.
Public Function GroundHeight(x: Float, z: Float): Float
    Local height = RockHeight(x, z)
    If x > ROAD_WEST - ROAD_INTO && x < ROAD_EAST + ROAD_INTO
        Local road = Clamp(1.0 - (Abs(z - RoadZ(x)) - 3.0) / 3.0, 0.0, 1.0)
        height = Max(height, road * ROAD_HEIGHT + (1.0 - road) * height)
    End If
    // Under the water at the terrain's edge.
    Local half = (SIDE As Float) / 2.0
    Local inFrom = half - Max(Abs(x), Abs(z))
    If inFrom < EDGE
        Local fade = Clamp(inFrom / EDGE, 0.0, 1.0)
        height = Min(height, -1.0 + (height + 1.0) * fade)
    End If
    Return height
End Function

/// How high the sea is `clock` seconds into the slack water: flat, then rising, still under the
/// road, then over it, in one surge, as the flow says it floods.
Public Function SeaHeight(clock: Float64): Float
    If clock <= RISING_AT Then Return 0.0
    If clock < FLOOD_AT
        Return ((clock - RISING_AT) / (FLOOD_AT - RISING_AT)) As Float * ROAD_HEIGHT * 0.98
    End If
    Local over = ROAD_HEIGHT + SURGE
    Local on = Min((clock - FLOOD_AT) / (TIDE_IN_AT - FLOOD_AT), 1.0) As Float
    Return over + on * (HIGH_WATER - over)
End Function

/// The lowest the ground gets along the road: what the sea has to top to cut the rocks off.
Public Function LowestCrossing(): Float
    Local lowest = 1000.0
    For step = 0 To 200
        Local x = ROAD_WEST + (ROAD_EAST - ROAD_WEST) * (step As Float) / 200.0
        lowest = Min(lowest, GroundHeight(x, RoadZ(x)))
    End For
    Return lowest
End Function

/// Whether (`x`, `z`) is inside the mill's walls.
Public Function InMill(x: Float, z: Float): Bool => Abs(x - MAIN_X) < MILL_W + 0.3 &&
                                                    Abs(z) < MILL_D + 0.3

/// Whether (`x`, `z`) is on the road, between its shores and within its sides.
Public Function OnRoad(x: Float, z: Float): Bool
    Return x > ROAD_WEST && x < ROAD_EAST && Abs(z - RoadZ(x)) < ROAD_SIDE
End Function

/// Which of the flow's places (`x`, `z`) is in: the mill, the road, or whichever rock it's by.
Public Function PlaceAt(x: Float, z: Float): Area
    If InMill(x, z) Then Return Area.INSIDE
    If OnRoad(x, z) Then Return Area.CAUSEWAY
    If Mound(x, z, FAR_X, FAR_Z, FAR_RADIUS) > Mound(x, z, MAIN_X, 0.0, MAIN_RADIUS)
        Return Area.FAR_ROCK
    End If
    Return Area.YARD
End Function

/// Which place someone who was in `current` is in at (`x`, `z`): still that one, until they're a
/// little past its line, so walking along one doesn't say so over and over.
Public Function PlaceHeld(current: Area, x: Float, z: Float): Area
    Local at = PlaceAt(x, z)
    If at == current Then Return at
    // The mill's only got its door to linger in; along a wall, you're outside.
    If current == Area.INSIDE && Abs(x - MAIN_X) >= DOOR_W Then Return at
    If PlaceAt(x - LINGER, z) == current || PlaceAt(x + LINGER, z) == current Then Return current
    If PlaceAt(x, z - LINGER) == current || PlaceAt(x, z + LINGER) == current Then Return current
    Return at
End Function

/// Whether someone on the road at (`x`, `z`) is nearer the far rock's shore than the mill's.
Public Function NearerFar(x: Float, z: Float): Bool => x - ROAD_WEST > ROAD_EAST - x

/// Whether the flood takes someone at (`x`, `z`), with the sea at `sea`: on the road, or too deep beside
/// it, in its span.
Public Function SweptAt(x: Float, z: Float, sea: Float): Bool
    If OnRoad(x, z) Then Return True
    Return x > ROAD_WEST && x < ROAD_EAST && GroundHeight(x, z) < sea - WADE
End Function

/// Whether walking onto (`x`, `z`) goes through the mill's walls, or anything else solid.
Public Function Blocked(x: Float, z: Float): Bool
    Local dx = Abs(x - MAIN_X)
    // Its outer walls, as far as a person's width.
    Local inWalls = dx < MILL_W + 0.9 && Abs(z) < MILL_D + 0.9
    Local inside = dx < MILL_W - 0.3 && Abs(z) < MILL_D - 0.3
    Local door = dx < DOOR_W - 0.3 && z > 0.0
    If inWalls && !inside && !door Then Return True
    // The works, inside, and the wheel, outside its east wall.
    If Abs(x - (MAIN_X + 3.5)) < 1.6 && Abs(z + 3.0) < 1.6 Then Return True
    // The lighthouse's foot.
    Local place = LighthouseSpot()
    If (x - place.x) * (x - place.x) + (z - place.y) * (z - place.y) <
       LIGHTHOUSE_SOLID * LIGHTHOUSE_SOLID
        Return True
    End If
    // The millstone and bench inside. The barrels and crates between the wheel and the door are
    // bodies, which you and Pip walk into and knock over, so they're not solid here.
    If x > MAIN_X - 5.8 && x < MAIN_X - 4.8 && z > -3.6 && z < -1.6 Then Return True
    If x > MAIN_X - 3.3 && x < MAIN_X + 0.3 && z > -4.8 && z < -3.7 Then Return True
    Return Abs(x - (MAIN_X + 8.0)) < 0.9 && Abs(z) < 3.4
End Function

/// Whether someone can step from ground as high as `from` to ground as high as `to`, with the sea at
/// `sea`: not deeper than wading, unless it's no deeper than where they are.
Public Function CanStep(from: Float, to: Float, sea: Float): Bool
    Return to >= sea - WADE || to >= from
End Function

/// Whether someone can step from (`fromX`, `fromZ`) to (`x`, `z`), `clock` seconds in, not onto a
/// flooded road, however shallow it is yet, and not into the sea past wading; walls are the caller's,
/// as it slides along them.
Public Function CanWade(fromX: Float, fromZ: Float, x: Float, z: Float, clock: Float64,
                        flooded: Bool): Bool
    If flooded && OnRoad(x, z) Then Return False
    Return CanStep(GroundHeight(fromX, fromZ), GroundHeight(x, z), SeaHeight(clock))
End Function

/// How far the storm's come, `clock` seconds in, from 0 to 1: nothing until the water's rising, and all
/// of it by the time the tide's in.
Public Function StormAt(clock: Float64): Float
    Return Clamp(((clock - RISING_AT) / (TIDE_IN_AT - RISING_AT)) As Float, 0.0, 1.0)
End Function

/// How high the sun is `clock` seconds in, in radians above the horizon, and how far around, as it
/// lowers across the yard: its light's pitch is the first, and its yaw the second.
Public Function SunAt(clock: Float64): (Float, Float)
    Local through = Min(clock / TIDE_IN_AT, 1.0) As Float
    Return (0.66 - 0.36 * through, 0.52 - 0.8 * through)
End Function

// `from` to `to`, by `amount`, which holds it to between them.
Function Mixed(from: Vec3, to: Vec3, amount: Float): Vec3
    Local by = Clamp(amount, 0.0, 1.0)
    Return Vec3(from.x + (to.x - from.x) * by, from.y + (to.y - from.y) * by,
                from.z + (to.z - from.z) * by)
End Function

// The cover's noise: fine, a meter or so across, and patches, many meters.
Function Fine(x: Float, z: Float): Float => Noise(x * 0.8 + 1.0, z * 0.8 + 2.0)

Function Patches(x: Float, z: Float): Float
    Return Noise(x * 0.09 + 4.0, z * 0.09 + 6.0) * 0.6 + Noise(x * 0.31 + 8.0, z * 0.31 + 1.0) * 0.4
End Function

// How much turf holds on, `height` high with `slope`, in `patches`: high and flat.
Function Turf(height: Float, slope: Float, patches: Float): Float
    Local flat = Clamp((0.8 - slope) / 0.4, 0.0, 1.0)
    Return flat * Clamp((patches - 0.28) * 5.0, 0.0, 1.0) * Clamp((height - 2.3) / 1.2, 0.0, 1.0)
End Function

// How trodden (`x`, `z`) is: around the mill, and from its door to the road, where it isn't steep.
Function Trodden(x: Float, z: Float, slope: Float, patches: Float, fine: Float): Float
    Local fromMill = Sqrt((x - MAIN_X) * (x - MAIN_X) + z * z)
    Local trodden = Clamp((12.0 + patches * 5.0 - fromMill) / 3.0, 0.0, 1.0)
    If x > MAIN_X && x < ROAD_WEST
        Local across = (x - MAIN_X) / (ROAD_WEST - MAIN_X)
        Local pathZ = DoorSpot().y + (RoadZ(ROAD_WEST) - DoorSpot().y) * across
        trodden = Max(trodden, Clamp((2.2 + fine - Abs(z - pathZ)) / 1.2, 0.0, 1.0))
    End If
    Return trodden * Clamp((1.2 - slope) / 0.4, 0.0, 1.0)
End Function

// How sandy it is, `height` high with `slope`, in `patches`: low down, up to what the rock breaks.
Function Sand(height: Float, slope: Float, patches: Float): Float
    Return Clamp((1.5 + (patches - 0.5) * 1.8 - height) / 0.5, 0.0, 1.0) *
           Clamp((1.3 - slope) / 0.4, 0.0, 1.0)
End Function

/// How much of what covers the ground at (`x`, `z`), `height` high with `slope` meters up to the meter,
/// is turf that shows, from 0 to 1: CoverAt's turf, less what's trodden over it and sand: where grass
/// grows.
Public Function TurfAt(x: Float, z: Float, height: Float, slope: Float): Float
    Local patches = Patches(x, z)
    Local turf = Turf(height, slope, patches)
    Return turf * (1.0 - Trodden(x, z, slope, patches, Fine(x, z))) *
           (1.0 - Sand(height, slope, patches))
End Function

/// What covers the ground at (`x`, `z`), `height` high with `slope` meters up to the meter: its color, as
/// sRGB, and how rough it is, from 0 to 1. Sand low down and wet where the sea's just been, bare rock in
/// bands where it's steep, turf on what's high and flat, and the trodden ground by the mill and to the
/// road. From noise at several scales, so it's patches that have nothing to do with where a map repeats.
Public Function CoverAt(x: Float, z: Float, height: Float, slope: Float): (Vec3, Float)
    Local fine = Fine(x, z)
    Local patches = Patches(x, z)
    Local bands = Noise(x * 0.05 + z * 0.03, height * 1.6)
    Local color = Mixed(Vec3(0.27, 0.27, 0.27), Vec3(0.47, 0.46, 0.43), bands * 0.6 + fine * 0.4)
    // Its cracks, and lichen on it.
    Local crack = 1.0 - Abs(2.0 * Noise(x * 0.37 + 5.0, z * 0.37 + height * 0.5) - 1.0)
    color = Mixed(color, Vec3(0.12, 0.12, 0.12), Clamp((crack - 0.9) * 8.0, 0.0, 1.0))
    Local lichen = Clamp((Noise(x * 0.6 + 9.0, z * 0.6 + 2.0) - 0.68) * 6.0, 0.0, 1.0)
    color = Mixed(color, Vec3(0.62, 0.6, 0.42), lichen * 0.6)
    Local rough = 0.72 + fine * 0.2
    // Where the high water reaches, it's dark and wet, in patches.
    Local tide = Clamp(1.0 - Abs(height - 1.7) / 0.35, 0.0, 1.0) *
                 Clamp((patches - 0.25) * 4.0, 0.0, 1.0)
    color = Mixed(color, Vec3(0.18, 0.18, 0.16), tide * 0.7)
    rough -= tide * 0.3
    // Turf, where it can hold on.
    Local blades = Noise(x * 2.3 + 3.0, z * 2.3 + 7.0)
    Local turf = Turf(height, slope, patches)
    color = Mixed(color,
                  Mixed(Vec3(0.29, 0.35, 0.18), Vec3(0.45, 0.47, 0.25),
                        patches * 0.6 + blades * 0.6 - 0.2),
                  turf)
    rough = rough + (0.95 - rough) * turf
    // Trodden ground around the mill, and from its door to the road.
    Local trodden = Trodden(x, z, slope, patches, fine)
    color = Mixed(color, Mixed(Vec3(0.38, 0.33, 0.25), Vec3(0.5, 0.43, 0.32), fine), trodden)
    rough = rough + (0.88 - rough) * trodden
    // Sand, up to what's broken by the rock's own shape.
    Local sand = Sand(height, slope, patches)
    color = Mixed(color, Mixed(Vec3(0.72, 0.64, 0.47), Vec3(0.83, 0.76, 0.59), fine), sand)
    rough = rough + (0.92 - rough) * sand
    // Wet, where the sea's just been: darker, and it shines.
    Local wet = Clamp((0.55 + (fine - 0.5) * 0.3 - height) / 0.3, 0.0, 1.0)
    color = Mixed(color, Vec3(color.x * 0.58, color.y * 0.56, color.z * 0.54), wet)
    rough = rough + (0.28 - rough) * wet
    Return (color, Clamp(rough, 0.0, 1.0))
End Function

/// Where the far islet's lighthouse stands, on its side toward the yard.
Public Function LighthouseSpot(): Vec2 => Vec2(FAR_X - 2.0, FAR_Z - 11.0)

// How far from the lighthouse's middle its foot is solid: its plinth, and a person's width.
Const LIGHTHOUSE_SOLID: Float = PLINTH + 0.6

/// How far across the jetty runs, on the main island's west shore.
Public Const JETTY_Z: Float = -6.0

/// Where the main island's west shore is, along JETTY_Z: the first ground going west from the yard
/// that's under 0.3, at slack water.
Public Function JettyShore(): Vec2
    Local x = MAIN_X - 20.0
    While x > -(SIDE As Float) / 2.0 && GroundHeight(x, JETTY_Z) > 0.3
        x -= 0.25
    End While
    Return Vec2(x, JETTY_Z)
End Function

/// The jetty's landward end, on the shore, and its seaward end, out over the sea.
Public Function JettyStart(): Vec2 => Vec2(JettyShore().x + 3.0, JETTY_Z)

Public Function JettyEnd(): Vec2 => Vec2(JettyShore().x - 12.0, JETTY_Z)

/// How sandy what covers the ground is at (`x`, `z`), `height` high with `slope`, from 0 to 1, as
/// CoverAt paints it: where what's washed up lies.
Public Function SandAt(x: Float, z: Float, height: Float, slope: Float): Float
    Return Sand(height, slope, Patches(x, z))
End Function

/// Whether (`x`, `z`) is kept clear of what's washed up: the road and the causeway's shores, within 3 m
/// of a part's spot or a landing, by the jetty, and where anything's solid.
Public Function KeptClear(x: Float, z: Float): Bool
    If x > ROAD_WEST - ROAD_INTO && x < ROAD_EAST + ROAD_INTO && Abs(z - RoadZ(x)) < ROAD_SIDE + 3.0
        Return True
    End If
    If Blocked(x, z) Then Return True
    For spot In [GearSpot(), PaddleSpot(), BeltSpot(), Landing(False), Landing(True),
                 PipLanding(False),
                 PipLanding(True), JettyStart()]
        If (spot.x - x) * (spot.x - x) + (spot.y - z) * (spot.y - z) < 9.0 Then Return True
    End For
    Return Abs(z - JETTY_Z) < 4.0 && x < JettyStart().x + 2.0 && x > JettyEnd().x - 2.0
End Function

/// Where what's washed up lies along the shores, each on sand above the sea at slack water: where it
/// is, what it is (0 driftwood, 1 rope, 2 a rock), how it's turned, and how big. Never on the road or
/// the causeway's shores, by the parts' spots or the landings, by the jetty, or where anything's solid.
Public Function ShoreSpots(): (Vec2, Int, Float, Float)[]
    Local spots: (Vec2, Int, Float, Float)[] = []
    Local half = (SIDE As Float) / 2.0 - EDGE
    For row = 0 Until 60
        For column = 0 Until 60
            Local x = -half + ((column As Float) + Hash(column, row + 900)) * (2.0 * half / 60.0)
            Local z = -half + ((row As Float) + Hash(column + 900, row)) * (2.0 * half / 60.0)
            Local height = GroundHeight(x, z)
            If height < 0.15 || height > 1.4 Then Continue
            Local dx = GroundHeight(x + 1.0, z) - GroundHeight(x - 1.0, z)
            Local dz = GroundHeight(x, z + 1.0) - GroundHeight(x, z - 1.0)
            Local slope = Sqrt(dx * dx + dz * dz) / 2.0
            If SandAt(x, z, height, slope) < 0.7 Then Continue
            If KeptClear(x, z) Then Continue
            // Only some of what passes, so it's scattered.
            If Hash(column + 300, row + 700) > 0.45 Then Continue
            Local kind = (Hash(column + 50, row + 60) * 3.0) As Int
            spots.Add((Vec2(x, z), Min(kind, 2), Hash(column + 70, row + 80) * 6.283,
                       0.6 + Hash(column + 90, row + 10) * 0.8))
        End For
    End For
    Return spots
End Function
