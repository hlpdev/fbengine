// Slack Water: you keep a tide-mill, and have one slack water to restart it, with Pip, your small
// brass helper. WASD and the mouse walk the island, E takes, fits, and opens the sluice, Q hands
// things to Pip and takes them back, Escape ends it. With `--walk <bright|dim|dark> [<kept>]`, as ctest
// runs it, it's offscreen, played by key presses to that ending, ten steps a second, as fast as they
// go, and what it said is compared with what's kept; `--walk3d` does the same on the island, in 3D.
// With `--frames <folder>`, the same to its bright ending, saving a PNG there at each moment that shows
// something, and checking what's drawn. With `--check <folder>`, it loads the assets its tools made
// there, and checks what they are; with `--match <made> <kept>`, that two folders of them are the same.
// Whatever a check finds wrong is its exit code.

Import std.collections
Import std.core
Import std.image.image
Import std.image.png
Import std.io
Import std.math
Import std.os
Import std.text
Import fbengine
Import fbengine_audio
Import "./checks"
Import "./controls"
Import "./cues"
Import "./flow"
Import "./game"
Import "./ground"
Import "./island"
Import "./res" As Res
Import "./soundscape"
Import "./walks"

// Plays `walk` to its end, by key presses, offscreen, and gives how it ended, each step told to
// `stepped` once the flow's moved on.
Function Walked(walk: String[], lines: String[], stepped: Func(Flow)): Ending Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(960, 540)
    Defer EndGraphics()
    Local controls = TextControls()
    Local flow = Flow(Function(line: String)
        Print(line)
        lines.Add(line)
    End Function)
    Local next = 0
    While flow.Ended() == Ending.NONE
        If next < walk.Count && WalkReady(flow, walk[next])
            Local step = walk[next]
            If Int.Parse(step) != Null
                next += 1
            Else
                Select step
                    Case "W"
                        Try Simulate.PressKey(Key.W)
                    Case "S"
                        Try Simulate.PressKey(Key.S)
                    Case "E"
                        Try Simulate.PressKey(Key.E)
                    Default
                        Try Simulate.PressKey(Key.Q)
                End Select
                next += 1
            End If
        End If
        Flip(False)
        controls.Apply(flow)
        flow.Step(0.1)
        stepped(flow)
    End While
    Return flow.Ended()
End Function

// Whether what a walk said is what's kept in `kept`, line by line, without the clock's part if not
// `timed`, as a walk on foot goes by the ground's numbers.
Function Pinned(lines: String[], kept: Path, timed: Bool) Throws IOError
    Local wanted: String[] = []
    For line In (Try File.ReadText(kept)).Split("\n")
        Local clean = line.Trim()
        If clean != "" Then wanted.Add(timed ? clean : Untimed(clean))
    End For
    Local said: String[] = []
    For line In lines
        said.Add(timed ? line : Untimed(line))
    End For
    If said != wanted
        For at = 0 Until Max(said.Count, wanted.Count)
            Local one = at < said.Count ? said[at] : "(nothing)"
            Local two = at < wanted.Count ? wanted[at] : "(nothing)"
            If one != two Then Print("line {at}: said {one}, kept {two}")
        End For
    End If
    Checks("what the walk said is what's kept", said == wanted)
End Function

// A line, without its clock.
Function Untimed(line: String): String
    Local parts = line.Split("] ")
    Return parts[parts.Count - 1]
End Function

// The screen: how long's left, where you are, and the last of what's happened.
Function Draw(flow: Flow, lines: String[], font: Font)
    Local canvas = Screen.Canvas()
    canvas.SetColor(Color32(20, 28, 36, 255))
    canvas.Clear()
    canvas.SetColor(Color32(236, 232, 220, 255))
    canvas.DrawText(font, "{flow.ClockLine()}, at {PlaceName(flow.At())}", 24, 20)
    Local first = Max(lines.Count - 18, 0)
    For at = first Until lines.Count
        canvas.DrawText(font, lines[at], 24, 60 + (at - first) * 26)
    End For
End Function

// The bright walk, saving the screen in `folder` when you first hold something, when the causeway
// floods, and at its end.
Function Framed(folder: Path) Throws GraphicsError, IOError
    Try Dir.CreateAll(folder)
    Local lines: String[] = []
    Local font = Font.BuiltIn(20.0)
    Local holding = False
    Local flooded = False
    Local saved = 0
    Local failure = ""
    Local save = Function(flow: Flow, name: String)
        Draw(flow, lines, font)
        Try
            Try Screen.Save(folder / "{name}.png")
            saved += 1
        Catch e As GraphicsError
            failure = e.Message
        Catch e As IOError
            failure = e.Message
        End Try
    End Function
    Local ended = Try Walked(WalkOf("bright") ?? [], lines, Function(flow: Flow)
        If !holding && flow.Held() != Null
            holding = True
            save(flow, "holding")
        End If
        If !flooded && flow.Flooded()
            flooded = True
            save(flow, "flooded")
        End If
        If flow.Ended() != Ending.NONE Then save(flow, "ended")
    End Function)
    If failure != "" Then Throw IOError(IOErrorKind.OTHER, failure)
    Checks("saved 3 frames, ended BRIGHT", saved == 3 && ended == Ending.BRIGHT)
    Try SaveViews(folder)
End Function

// Global: whether any check of what's made went wrong, which is the program's exit code.
Global failed: Bool = False

// Says a check's result, and remembers a failure.
Function Checks(what: String, held: Bool)
    Print("{what} {held}")
    If !held Then failed = True
End Function

// The pixel a place in the world's drawn at, by the camera that drew it, or Null off the image.
Function PixelOf(camera: Camera, image: Image, place: Vec3): Color32?
    Local at = camera.Project(place)
    If at == Null Then Return Null
    Local x = at.x As Int
    Local y = at.y As Int
    If x < 0 || y < 0 || x >= image.Width || y >= image.Height Then Return Null
    Return image[x, y]
End Function

// The island, in `folder`, from each of its views, at slack water and at high tide; and whether
// what was drawn is what it should be, as the flow has the tide, by the pixels themselves.
Function SaveViews(folder: Path) Throws GraphicsError, IOError
    Window.SetHeadless(True)
    Try Graphics(1280, 720)
    Defer EndGraphics()
    Try Res.Mount()
    Defer Assets.StopWatching()
    Local island = Try Island.Make()
    Defer island.Free()
    Local camera = Camera()
    camera.SetClearColor(SKY)
    camera.SetRange(0.1, 4000.0)
    // The sea's far edge goes into the haze, with no line.
    camera.SetFogMode(FogMode.LINEAR)
    camera.SetFogColor(SKY)
    camera.SetFogRange(200.0, 1400.0)
    Local saved = 0
    Local images = Map<String, Image>()
    For view In Views()
        camera.SetPosition(view.1)
        camera.PointAt(view.2)
        island.Scene().Render()
        Try Screen.Save(folder / "{view.0}.png")
        images[view.0] = Try Screen.ToImage()
        saved += 1
        Flip(False)
    End For
    // High tide, from the island's view.
    Local first = Views()[0]
    camera.SetPosition(first.1)
    camera.PointAt(first.2)
    island.Update(TIDE_IN_AT)
    island.Scene().Render()
    Try Screen.Save(folder / "island_high_tide.png")
    Local high = Try Screen.ToImage()
    saved += 1
    Flip(False)
    Checks("saved 5 views of the island", saved == 5)

    // The numbers the flow goes by, as drawn.
    Local allAgree = True
    For second = 0 To 600
        island.Update(second As Float64)
        If Abs(island.SeaDrawnAt() - SeaHeight(second As Float64)) > 0.0001 Then allAgree = False
    End For
    Checks("the sea's drawn at the tide's height", allAgree)
    Local crossX = Round(CrossingX())
    Local crossZ = Round(CrossingZ(crossX))
    Local crossing = island.GroundDrawnAt(crossX, crossZ)
    Checks("the causeway's drawn at its height",
           crossing != Null && Abs(crossing - GroundHeight(crossX, crossZ)) < 0.01)
    Local millAt = island.GroundDrawnAt(MAIN_X, 0.0)
    Checks("the mill's ground's drawn at its height",
           millAt != Null && Abs(millAt - GroundHeight(MAIN_X, 0.0)) < 0.01)

    // The pixels: the causeway's there at slack, and gone at high; the far rock, and the roof, at
    // both; and the land's share falls, by what a rising sea would take.
    Local slack = images["island"]
    Local road = Vec3(CrossingX(), SeaHeight(0.0) + 0.5, CrossingZ(CrossingX()))
    Local dry = PixelOf(camera, slack, road)
    Checks("the causeway's land at slack water", dry != Null && !IsSea(dry))
    Local under = PixelOf(camera, high, Vec3(road.x, SeaHeight(TIDE_IN_AT), road.z))
    Checks("the causeway's sea at high tide", under != Null && IsSea(under))
    Local farRock = Vec3(FAR_X, GroundHeight(FAR_X, 8.0), 8.0)
    Local farSlack = PixelOf(camera, slack, farRock)
    Local farHigh = PixelOf(camera, high, farRock)
    Checks("the far rock's land at both",
           farSlack != Null && farHigh != Null && !IsSea(farSlack) && !IsSea(farHigh))
    Local roof = Vec3(MAIN_X, GroundHeight(MAIN_X, 0.0) + 5.6, 0.0)
    Local roofSlack = PixelOf(camera, slack, roof)
    Local roofHigh = PixelOf(camera, high, roof)
    Checks("the roof's land at both",
           roofSlack != Null && roofHigh != Null && !IsSea(roofSlack) && !IsSea(roofHigh))
    Local land = Function(pixel: Color32): Bool => !IsSea(pixel) && !IsSky(pixel)
    Local ratio = Share(high, land) / Max(Share(slack, land), 0.0001)
    Checks("the tide takes some of the land", ratio > 0.6 && ratio < 0.95)
    Checks("the sky's at the top of the yard's view", IsSky(images["yard"][640, 4]))
    Checks("the yard's middle isn't sky", !IsSky(images["yard"][640, 360]))
    Local pipPixel = images["pip"][640, 360]
    Checks("Pip's brass is in the middle of his view",
           pipPixel.r > pipPixel.g && pipPixel.g > pipPixel.b)
    Checks("no sky's seen from the mill's inside", Share(images["mill_inside"], IsSky) < 0.01)
End Function

// Loads every asset the tools make from `folder`, as the game will, and says what they are: what's
// wrong is a failure, as a sound with no sound in it, or one that clips.
Function Checked(folder: Path) Throws GraphicsError, IOError
    Assets.MountFolder("res://made", folder)
    Defer Assets.Unmount("res://made")
    Local soundsGood = True
    For name In ["wind", "sea", "gull", "creak", "wheel", "step_1", "step_2", "step_3", "splash"]
        Local sound = Try Assets.Load<Sound>("res://made/{name}.wav")
        Local fault = SoundFault(Try Assets.ReadBytes("res://made/{name}.wav"))
        If fault != Null
            Print("{name}: {fault}")
            soundsGood = False
        End If
        sound.Free()
    End For
    Checks("the sounds load, none silent, none clipping", soundsGood)
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    Window.SetHeadless(True)
    For material In ["rock", "sand", "wood", "brass", "iron"]
        Local albedo = Try Assets.Load<Texture>("res://made/{material}_albedo.png")
        Local normal = Try Assets.Load<Texture>("res://made/{material}_normal.png")
        Local rough = Try Assets.Load<Texture>("res://made/{material}_rough.png")
        Checks("{material}'s textures load as what they are",
               albedo.Width() == (material == "rock" || material == "sand" ? 256 : 128) &&
               albedo.Format() == TextureFormat.RGBA8 &&
               normal.Format() == TextureFormat.RGBA8_LINEAR &&
               rough.Format() == TextureFormat.RGBA8_LINEAR)
        albedo.Free()
        normal.Free()
        rough.Free()
    End For
    Local world = World()
    Defer world.Free()
    World.SetCurrent(world)
    Local pip = Try Assets.Load<Model>("res://made/pip.gltf")
    Defer pip.Free()
    Local root = Try pip.Spawn()
    Local found = root.Find("pip")
    Local clips: String[] = []
    For clip In pip.Clips()
        clips.Add(clip.Name())
    End For
    Checks("Pip's joints and clips are what they are", pip.Skins()[0].JointCount() == 8 &&
           ", ".Join(clips) == "idle, walk, carry")
    If !(found Is Mesh)
        Checks("Pip's a mesh", False)
        Return
    End If
    Local mesh = found As Mesh
    Local geometry = pip.Geometries()[0]
    Checks("its surfaces, morphs, and bones are what they are", geometry.SurfaceCount() == 2 &&
           geometry.Surface(0).MorphTargetCount() == 1 && mesh.Palette().Count == 8)
    Local bounds = geometry.Bounds()
    Checks("it's 0.8 m high, on the ground",
           IsClose(bounds.Max.y, 0.8, 0.001) && IsClose(bounds.Min.y, 0.0, 0.001))
    // No clip: every joint where it was bound, so its palette's all identity.
    Local identity = True
    For matrix In mesh.Palette()
        Local origin = matrix.TransformPoint(Vec3(0.3, 0.4, 0.5))
        If !IsClose(origin, Vec3(0.3, 0.4, 0.5), 0.00001) Then identity = False
    End For
    Checks("at rest, its palette moves nothing", identity)
    // Walking, at a key: a leg's foot moves, and the head's vertices don't, as the body's not bobbing
    // at that key. Joints: root 0, hips 1, body 2, head 3, arms 4 and 5, legs 6 and 7.
    Local player = root.Player()
    player.Play(pip.Clips()[1])
    player.SetTime(0.5)
    UpdateWorld(0.0)
    Local palette = mesh.Palette()
    Local foot = palette[7].TransformPoint(Vec3(-0.08, 0.0, 0.0))
    Local head = palette[3].TransformPoint(Vec3(0.0, 0.72, 0.0))
    Checks("walking, its foot moves", Abs(foot.z) > 0.05)
    Checks("and its head stays over it", Abs(head.x) < 0.001 && Abs(head.z) < 0.001)
    // At each of its walk's keys, its lowest point's on the ground, within a centimeter.
    Local grounded = True
    Local vertices = geometry.Surface(0).Vertices()
    Local joints = geometry.Surface(0).Joints()
    For key = 0 To 4
        player.SetTime((key As Float) * 0.25)
        UpdateWorld(0.0)
        Local posed = mesh.Palette()
        Local lowest = 1000.0
        For at = 0 Until vertices.Count
            Local placed = posed[joints[at].Joint0 As Int].TransformPoint(vertices[at].Position)
            lowest = Min(lowest, placed.y)
        End For
        If Abs(lowest) > 0.01
            Print("at key {key} it's {lowest} up")
            grounded = False
        End If
    End For
    Checks("at each key of its walk, it's on the ground", grounded)
    // The blink shuts its eyes: their tops come down.
    Local open = mesh.MorphedPositions(1)
    mesh.SetMorphWeights([1.0])
    Local shut = mesh.MorphedPositions(1)
    Local moved = False
    For at = 0 Until open.Count
        If shut[at].y < open[at].y Then moved = True
    End For
    Checks("blinking, its eyes shut", moved)
End Function

// Whether two folders' files are the same: every byte, but for PNGs, whose pixels are, as a PNG's
// bytes are its zlib's.
Function Matched(made: Path, kept: Path) Throws IOError
    Local same = True
    Local names: String[] = []
    For entry In Try Dir.Entries(kept)
        names.Add(entry.Name())
    End For
    Local madeNames: String[] = []
    For entry In Try Dir.Entries(made)
        madeNames.Add(entry.Name())
    End For
    If names.Count != madeNames.Count
        Print("{names.Count} files kept, {madeNames.Count} made")
        same = False
    End If
    For name In names
        If !madeNames.Contains(name)
            Print("{name} isn't made")
            same = False
            Continue
        End If
        Local one = Try File.ReadBytes(made / name)
        Local two = Try File.ReadBytes(kept / name)
        If name.EndsWith(".png")
            Local first = Try Png.Decode(one)
            Local second = Try Png.Decode(two)
            If first.Pixels.ToArray() != second.Pixels.ToArray()
                Print("{name}'s pixels differ")
                same = False
            End If
        ElseIf one != two
            Print("{name} differs")
            same = False
        End If
    End For
    Checks("what's kept is what the tools make", same)
End Function

// What a 3D walk does, a thing at a time: walks to a Spot or a part by its name, presses E or Q, or
// waits for the clock.
Function Walk3dOf(name: String): String[]?
    Select name
        // The gear and the paddle first, the gear in Pip's hands; then the belt, in time.
        Case "bright"
            Return ["door", "gear", "E", "Q", "crossing", "E", "door", "inside", "E", "Q", "E", "E",
                    "door", "crossing", "belt", "E", "crossing", "door", "inside", "E", "600"]
        // The same, but never going for the belt.
        Case "dim"
            Return ["door", "gear", "E", "Q", "crossing", "E", "door", "inside", "E", "Q", "E", "E",
                    "600"]
        // Out to the far rock, as the causeway floods behind you; then trying to walk back.
        Case "dark"
            Return ["door", "crossing", "belt", "421", "door", "600"]
        Default
            Return Null
    End Select
End Function

// Where a walk's step goes, or Null if it isn't a place.
Function WalkTarget(island: Island, step: String): Vec2?
    Select step
        Case "inside"
            Return island.PlaceOf(Spot.INSIDE)
        Case "door"
            Return island.PlaceOf(Spot.DOOR)
        Case "crossing"
            Return island.PlaceOf(Spot.CROSSING)
        Case "gear"
            Return island.PartSpot(Part.GEAR)
        Case "belt"
            Return island.PartSpot(Part.BELT)
        Default
            Return Null
    End Select
End Function

// Walks `walk` to its end, by W, E, and Q pressed, offscreen, and gives how it ended. It turns you
// to each place itself, as a person's mouse would; `stepped` hears of each step, with what's just
// been done.
Function Walked3d(island: Island, walk: String[], lines: String[],
                  stepped: Func(Game, String)): Ending Throws GraphicsError, IOError, AudioError
    Local controls = Controls()
    Local game = Game(island, Function(line: String)
        Print(line)
        lines.Add(line)
    End Function)
    Defer game.Free()
    // Heard as a person would, mixed here, as nothing's to play it to.
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local scape = Try Soundscape.Make(game, island)
    Defer scape.Free()
    Local loudest: Float = 0.0
    Local next = 0
    Local doing = ""
    Local walking = False
    While game.Story().Ended() == Ending.NONE
        doing = ""
        If next < walk.Count
            Local step = walk[next]
            Local target = WalkTarget(island, step)
            Local until = Int.Parse(step)
            If target != Null
                Local here = game.Location()
                Local dx = target.x - here.x
                Local dz = target.y - here.y
                // Within a step of it, or within reach of what lies there.
                If dx * dx + dz * dz < 1.0
                    If walking
                        Try Simulate.KeyUp(Key.W)
                        walking = False
                    End If
                    next += 1
                Else
                    game.Face(target.x, target.y)
                    If !walking
                        Try Simulate.KeyDown(Key.W)
                        walking = True
                    End If
                End If
            ElseIf until != Null
                If game.Story().Clock() >= (until As Float64) Then next += 1
            ElseIf step == "Q"
                If game.Story().PipHere()
                    Try Simulate.PressKey(Key.Q)
                    doing = step
                    next += 1
                End If
            Else
                Try Simulate.PressKey(Key.E)
                doing = step
                next += 1
            End If
        End If
        Flip(False)
        game.Step(controls, 0.1)
        scape.Update(game, 0.1)
        For sample In Audio.Mix(256)
            loudest = Max(loudest, Abs(sample))
        End For
        stepped(game, doing)
    End While
    If walking Then Try Simulate.KeyUp(Key.W)
    stepped(game, "ended")
    Heard(scape, game.Story(), loudest)
    Return game.Story().Ended()
End Function

// What the wheel's pitch should be by how it ended, 0 if it's still.
Function WheelPitchOf(ended: Ending): Float
    Select ended
        Case Ending.BRIGHT
            Return 1.0
        Case Ending.DIM
            Return 0.76
        Default
            Return 0.0
    End Select
End Function

// Whether what a walk heard is what it should be: the wind and sea all along, your feet, and the
// flood; the wheel by how it ended; and something in the mix itself.
Function Heard(scape: Soundscape, flow: Flow, loudest: Float)
    Checks("the wind and sea are streamed, and playing", scape.AroundYou())
    Checks("at their levels for the tide",
           IsClose(scape.WindNow(), WindLevel(flow.Clock()), 0.001) &&
           IsClose(scape.SeaNow(), SeaLevel(flow.Clock(), flow.At() == Area.INSIDE), 0.001))
    Checks("your steps are heard", scape.Played(Cue.STEP_1) > 0 && scape.Played(Cue.STEP_2) > 0 &&
           scape.Played(Cue.STEP_3) > 0)
    Checks("the flood splashes, once", scape.Played(Cue.SPLASH) == 1)
    Checks("the wheel turns by how it ended",
           IsClose(scape.WheelPitch(), WheelPitchOf(flow.Ended()), 0.001))
    Checks("what's outside is muffled only from inside the mill",
           scape.OutsideNow() == OutsideLowPass(flow.At() == Area.INSIDE))
    Checks("the mix isn't silent, and doesn't clip", loudest > 0.01 && loudest < 1.0)
End Function

// Opens what a walk draws on, offscreen, and the island.
Function Opened(): Island Throws GraphicsError, IOError
    Window.SetHeadless(True)
    Try Graphics(1280, 720)
    Try Res.Mount()
    Return Try Island.Make()
End Function

// A 3D walk, with nothing saved, as ctest runs one to each ending.
Function Walked3dBy(walk: String[], lines: String[]): Ending Throws GraphicsError, IOError,
                                                                    AudioError
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Return Try Walked3d(island, walk, lines, Function(game: Game, doing: String)
    End Function)
End Function

// The bright 3D walk, saving what you see at each moment that shows something.
Function SaveWalk(folder: Path) Throws GraphicsError, IOError, AudioError
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Local saved = 0
    Local failure = ""
    Local save = Function(game: Game, name: String)
        game.View().SetRenderTarget(Null)
        island.Scene().Render()
        Try
            Try Screen.Save(folder / "{name}.png")
            saved += 1
        Catch e As GraphicsError
            failure = e.Message
        Catch e As IOError
            failure = e.Message
        End Try
    End Function
    Local holding = False
    Local carrying = False
    Local fitted = False
    Local lines: String[] = []
    Local ended = Try Walked3d(island, Walk3dOf("bright") ?? [], lines,
                               Function(game: Game, doing: String)
        Local flow = game.Story()
        If !holding && flow.Held() != Null
            holding = True
            save(game, "walk_holding")
        End If
        If !carrying && flow.PipHolds() != Null
            carrying = True
            game.FacePip()
            save(game, "walk_pip_carrying")
        End If
        If !fitted && flow.Fitted(Part.PADDLE)
            fitted = True
            Local works = island.PlaceOf(Spot.WORKS)
            game.Face(works.x, works.y)
            game.Look(-0.1)
            save(game, "walk_fitting")
        End If
        If doing == "ended"
            // From outside, to see the lamp and the wheel.
            Local view = Views()[1]
            game.View().SetPosition(view.1)
            game.View().PointAt(view.2)
            save(game, "walk_lit")
        End If
    End Function)
    If failure != "" Then Throw IOError(IOErrorKind.OTHER, failure)
    Checks("saved 4 frames of a 3D walk, ended BRIGHT", saved == 4 && ended == Ending.BRIGHT)
End Function

// The game, in a window, for a person: WASD and the mouse, E, Q, and Escape.
Function Played() Throws GraphicsError, IOError, InputError, AudioError
    Try Graphics(1280, 720)
    Defer EndGraphics()
    Window.SetTitle("Slack Water")
    Try SetMouseRelative(True)
    Frame.SetLimit(60)
    Try Res.Mount()
    Defer Assets.StopWatching()
    Local island = Try Island.Make()
    Defer island.Free()
    Local controls = Controls()
    Local last = ""
    Local game = Game(island, Function(line: String)
        last = line
    End Function)
    Defer game.Free()
    // A machine with no sound still plays it, in silence.
    Local device = AudioDevice.DEFAULT
    Try
        Try Audio.Start(device)
    Catch e As AudioError
        PrintError("no sound: {e.Message}")
        Try Audio.Start(AudioDevice.SILENT)
    End Try
    Defer Audio.Stop()
    Local scape = Try Soundscape.Make(game, island)
    Defer scape.Free()
    Local font = Font.BuiltIn(20.0)
    While !Window.Closed() && !KeyHit(Key.ESCAPE)
        Flip()
        Local seconds = FrameStep(Frame.Delta()) As Float
        game.Step(controls, seconds)
        scape.Update(game, seconds)
        If Screen.Texture() == Null Then Continue
        island.Scene().Render()
        Local canvas = Screen.Canvas()
        canvas.SetColor(Color32(236, 232, 220, 255))
        Local flow = game.Story()
        canvas.DrawText(font, flow.ClockLine(), 24, 20)
        canvas.DrawText(font, last, 24, 48)
        canvas.DrawText(font, game.Prompt(), 24, 680)
    End While
End Function

Local arguments = Process.Arguments()
Const USAGE =
    "usage: slack_water [--walk <bright|dim|dark> [<kept>] | --walk3d <bright|dim|dark> " +
    "[<kept>] | --frames <folder> | --check <folder> | --match <made> <kept>]"
If arguments.Count >= 2 && arguments.Count <= 3 && arguments[0] == "--walk"
    Local walk = WalkOf(arguments[1])
    If walk == Null
        PrintError(USAGE)
        Process.Exit(2)
    Else
        Local lines: String[] = []
        Local ended = Try Walked(walk, lines, Function(flow: Flow)
        End Function)
        Print("ended {ended}")
        If arguments.Count == 3 Then Try Pinned(lines, Path(arguments[2]), True)
    End If
ElseIf arguments.Count >= 2 && arguments.Count <= 3 && arguments[0] == "--walk3d"
    Local walk = Walk3dOf(arguments[1])
    If walk == Null
        PrintError(USAGE)
        Process.Exit(2)
    ElseIf Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Local lines: String[] = []
        Print("ended {Try Walked3dBy(walk, lines)}")
        If arguments.Count == 3 Then Try Pinned(lines, Path(arguments[2]), False)
    End If
ElseIf arguments.Count == 3 && arguments[0] == "--match"
    Try Matched(Path(arguments[1]), Path(arguments[2]))
ElseIf arguments.Count == 2 && arguments[0] == "--check"
    Try Checked(Path(arguments[1]))
ElseIf arguments.Count == 2 && arguments[0] == "--frames"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try Framed(Path(arguments[1]))
        Try SaveWalk(Path(arguments[1]))
    End If
ElseIf arguments.Count == 0
    Try Played()
Else
    PrintError(USAGE)
    Process.Exit(2)
End If
If failed Then Process.Exit(1)
