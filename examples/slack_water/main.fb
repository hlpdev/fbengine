// Slack Water: you keep a tide-mill, and have one slack water to restart it, with Pip, your small
// brass helper. WASD and the mouse walk the island, E takes, fits, and opens the sluice, Q hands
// things to Pip and takes them back, Escape ends it. With `--walk <bright|dim|dark> [<kept>]`, as ctest
// runs it, it's offscreen, played by key presses to that ending, ten steps a second, as fast as they
// go, and what it said is compared with what's kept; `--walk3d <bright|dim|dark|cut|swept|wing|far_end>
// [<kept>]` does the same on the island, in 3D, checking how it stands at every step. With `--frames
// <folder>`, the same to its bright ending, saving a PNG there at each moment that shows something, and
// checking what's drawn. `--feel` tries its keys, mouse, and gamepad, `--hear` what's in its mix, and
// `--end <folder>` its end screen; `--fps <device> <frames>` says what a frame costs at 1080p. `--cooked <kept> <folder>`, in a release, walks and draws it from its
// pak.
// With `--check <folder>`, it loads the assets its tools made there, and checks what they are; with
// `--match <made> <kept>`, that two folders of them are the same; with `--alike <one> <other> <floor>`,
// that two folders of views are, by their PSNR. All of those but `--cooked` are for its tests, which set
// SLACK_WATER_CHECKS=1, and do nothing in a game without it. Whatever a check finds wrong is its exit
// code. README.md says how it's built and shipped.

Import std.collections
Import std.core
Import std.image.image
Import std.image.png
Import std.io
Import std.math
Import std.os
Import std.text
Import std.time
Import fbengine
Import fbengine_audio
Import fbengine_physics
Import fbengine_ui
Import "./checks"
Import "./controls"
Import "./cues"
Import "./flow"
Import "./captions"
Import "./follow"
Import "./frontend"
Import "./game"
Import "./hud"
Import "./ground"
Import "./afloat"
Import "./island"
Import "./landmarks"
Import "./map"
Import "./prompts"
Import "./res" As Res
Import "./plants"
Import "./screenmode"
Import "./screens"
Import "./sea"
Import "./settings"
Import "./sky"
Import "./soundscape"
Import "./walks"

// Plays `walk` to its end, by key presses, offscreen, and gives how it ended, each step told to
// `stepped` once the flow's moved on.
Function Walked(walk: String[], lines: String[], stepped: Func(Flow)): Ending Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(960, 540)
    Defer EndGraphics()
    Local controls = TextControls()
    Local flow = Flow(Function(line: String)
        Print(line)
        lines.Add(line)
    End Function)
    Local next = 0
    While flow.Ended() == Ending.NONE
        If next < walk.Count && WalkReady(flow, walk[next])
            Local step = walk[next]
            If Int.Parse(step) != Null
                next += 1
            Else
                Select step
                    Case "W"
                        Try Simulate.PressKey(Key.W)
                    Case "S"
                        Try Simulate.PressKey(Key.S)
                    Case "E"
                        Try Simulate.PressKey(Key.E)
                    Default
                        Try Simulate.PressKey(Key.Q)
                End Select
                next += 1
            End If
        End If
        Flip(False)
        controls.Apply(flow)
        flow.Step(0.1)
        stepped(flow)
    End While
    Return flow.Ended()
End Function

// Whether what a walk said is what's kept in `kept`, line by line, without the clock's part if not
// `timed`, as a walk on foot goes by the ground's numbers.
Function Pinned(lines: String[], kept: Path, timed: Bool) Throws IOError
    Local wanted: String[] = []
    For line In (Try File.ReadText(kept)).Split("\n")
        Local clean = line.Trim()
        If clean != "" Then wanted.Add(timed ? clean : Untimed(clean))
    End For
    Local said: String[] = []
    For line In lines
        said.Add(timed ? line : Untimed(line))
    End For
    If said != wanted
        For at = 0 Until Max(said.Count, wanted.Count)
            Local one = at < said.Count ? said[at] : "(nothing)"
            Local two = at < wanted.Count ? wanted[at] : "(nothing)"
            If one != two Then Print("line {at}: said {one}, kept {two}")
        End For
    End If
    Checks("what the walk said is what's kept", said == wanted)
End Function

// A line, without its clock.
Function Untimed(line: String): String
    Local parts = line.Split("] ")
    Return parts[parts.Count - 1]
End Function

// The screen: how long's left, where you are, and the last of what's happened.
Function Draw(flow: Flow, lines: String[], font: Font)
    Local canvas = Screen.Canvas()
    canvas.SetColor(Color32(20, 28, 36, 255))
    canvas.Clear()
    canvas.SetColor(Color32(236, 232, 220, 255))
    canvas.DrawText(font, "{flow.ClockLine()}, at {PlaceName(flow.At())}", 24, 20)
    Local first = Max(lines.Count - 18, 0)
    For at = first Until lines.Count
        canvas.DrawText(font, lines[at], 24, 60 + (at - first) * 26)
    End For
End Function

// The bright walk, saving the screen in `folder` when you first hold something, when the causeway
// floods, and at its end.
Function Framed(folder: Path) Throws GraphicsError, IOError
    Local began = Instant.Now()
    Try Dir.CreateAll(folder)
    Local lines: String[] = []
    Local font = Font.BuiltIn(20.0)
    Local holding = False
    Local flooded = False
    Local saved = 0
    Local failure = ""
    Local save = Function(flow: Flow, name: String)
        Draw(flow, lines, font)
        Try
            Try Screen.Save(folder / "{name}.png")
            saved += 1
        Catch e As GraphicsError
            failure = e.Message
        Catch e As IOError
            failure = e.Message
        End Try
    End Function
    Local ended = Try Walked(WalkOf("bright") ?? [], lines, Function(flow: Flow)
        If !holding && flow.Held() != Null
            holding = True
            save(flow, "holding")
        End If
        If !flooded && flow.Flooded()
            flooded = True
            save(flow, "flooded")
        End If
        If flow.Ended() != Ending.NONE Then save(flow, "ended")
    End Function)
    If failure != "" Then Throw IOError(IOErrorKind.OTHER, failure)
    Checks("saved 3 frames, ended BRIGHT", saved == 3 && ended == Ending.BRIGHT)
    Local walked = Lap("the walk's frames", began)
    Try SaveViews(folder)
    Lap("all of the views", walked)
End Function

// Global: whether any check of what's made went wrong, which is the program's exit code.
Global failed: Bool = False

// Says a check's result, and remembers a failure.
Function Checks(what: String, held: Bool)
    Print("{what} {held}")
    If !held Then failed = True
End Function

// The pixel a place in the world's drawn at, by the camera that drew it, or Null off the image.
Function PixelOf(camera: Camera, image: Image, place: Vec3): Color32?
    Local at = camera.Project(place)
    If at == Null Then Return Null
    Local x = at.x As Int
    Local y = at.y As Int
    If x < 0 || y < 0 || x >= image.Width || y >= image.Height Then Return Null
    Return image[x, y]
End Function

// How much of two images, from row `from` up to `to`, differs by more than 12 of
// 765 in brightness, from 0 to 1.
Function MovedShare(before: Image, after: Image, from: Int, to: Int): Float
    Local count = 0
    For y = from Until to
        For x = 0 Until before.Width
            If Abs(Brightness(before[x, y]) - Brightness(after[x, y])) > 12 Then count += 1
        End For
    End For
    Return (count As Float) / (((to - from) * before.Width) As Float)
End Function

// How much of the sea `depth` deep along the shore's south side is white with foam, from 0 to 1, by
// what `image` shows from `camera`, with the sea at 0: of 161 places along it, a quarter meter apart.
Function FoamAlong(camera: Camera, image: Image, depth: Float): Float
    Local foamed = 0
    Local seen = 0
    For across = -80 To 80
        Local x = MAIN_X + (across As Float) * 0.25
        Local z: Float = 0.0
        While -GroundHeight(x, z) < depth && z < 100.0
            z += 0.02
        End While
        Local pixel = PixelOf(camera, image, Vec3(x, 0.0, z))
        If pixel != Null
            seen += 1
            If pixel.r > 185 && pixel.g > 185 && pixel.b > 185 Then foamed += 1
        End If
    End For
    Return seen > 40 ? (foamed As Float) / (seen As Float) : 1.0
End Function

// The least and most bright, of 765, the sea `depth` deep along the shore's south side is, by what
// `image` shows from `camera`, with the sea at 0.
Function BrightnessAlong(camera: Camera, image: Image, depth: Float): (Float, Float)
    Local least: Float = 1000.0
    Local most: Float = 0.0
    For across = -20 To 20
        Local x = MAIN_X + (across As Float)
        Local z: Float = 0.0
        While -GroundHeight(x, z) < depth && z < 100.0
            z += 0.05
        End While
        Local pixel = PixelOf(camera, image, Vec3(x, 0.0, z))
        If pixel != Null
            least = Min(least, Brightness(pixel) As Float)
            most = Max(most, Brightness(pixel) As Float)
        End If
    End For
    Return (least, most)
End Function

// The color of where the sea's `depth` deep along the shore's south side, from beside the main rock,
// by what `image` shows of it from `camera`, with the sea at `height`, its channels' bytes summed
// over how many were seen; and how many.
Function ColorAtDepth(camera: Camera, image: Image, height: Float, depth: Float): (Vec3, Int)
    Local sum = Vec3(0.0, 0.0, 0.0)
    Local seen = 0
    For across = -20 To 20
        Local x = MAIN_X + (across As Float)
        Local z: Float = 0.0
        While height - GroundHeight(x, z) < depth && z < 100.0
            z += 0.05
        End While
        Local pixel = PixelOf(camera, image, Vec3(x, height, z))
        If pixel != Null
            sum = sum + Vec3(pixel.r As Float, pixel.g As Float, pixel.b As Float)
            seen += 1
        End If
    End For
    Return (seen > 0 ? sum * (1.0 / (seen As Float)) : sum, seen)
End Function

// How bright the sea is there: its channels' bytes, added.
Function SeaAtDepth(camera: Camera, image: Image, height: Float, depth: Float): (Float, Int)
    Local color, seen = ColorAtDepth(camera, image, height, depth)
    Return (color.x + color.y + color.z, seen)
End Function

// How far apart two colors are, by their channels' bytes.
Function Apart(one: Vec3, other: Vec3): Float
    Return Abs(one.x - other.x) + Abs(one.y - other.y) + Abs(one.z - other.z)
End Function

// What the island shows now.
Function Shown(island: Island): Image Throws GraphicsError, IOError
    island.Render()
    Local image = Try Screen.ToImage()
    Flip(False)
    Return image
End Function

// What the island shows now, saved as `name` in `folder`.
Function SavedAs(island: Island, folder: Path, name: String): Image Throws GraphicsError, IOError
    island.Render()
    Try Screen.Save(folder / "{name}.png")
    Local image = Try Screen.ToImage()
    Flip(False)
    Return image
End Function

// How many pixels of what the island shows, in the rows from `from` up to `to`, differ by more than
// `by` of 765 between how it is now and once `change` has been done.
Function ChangedBy(island: Island, change: Func(), from: Int, to: Int,
                   by: Int): Int Throws GraphicsError,
                                        IOError
    Local before = Try Shown(island)
    change()
    Local after = Try Shown(island)
    Local count = 0
    For y = from Until to
        For x = 0 Until before.Width
            If Abs(Brightness(before[x, y]) - Brightness(after[x, y])) > by Then count += 1
        End For
    End For
    Return count
End Function

// How many triangles the island's drawn with from where the camera is.
Function TrianglesDrawn(island: Island): Int64
    island.Render()
    Flip(False)
    island.Render()
    Local drawn = Gpu.Counters().Triangles
    Flip(False)
    Return drawn
End Function

// Whether a place's kept clear: by the mill, on the road, what's blocked, or near a clear spot.
Function InTheClear(at: Vec3): Bool
    If ByTheMill(at.x, at.z) || OnRoad(at.x, at.z) || Blocked(at.x, at.z) Then Return True
    For spot In ClearSpots()
        If Length(Vec2(at.x, at.z) - spot) < 1.5 Then Return True
    End For
    Return False
End Function

// How many of an image's sky pixels are shut in by what isn't sky, out of reach of its edges'.
Function EnclosedSky(image: Image): Int
    Local width = image.Width
    Local height = image.Height
    Local reached: Bool[] = []
    reached.Resize(width * height, False)
    Local next: Int[] = []
    Local reach = Function(x: Int, y: Int)
        If x < 0 || y < 0 || x >= width || y >= height Then Return
        Local at = y * width + x
        If reached[at] || !IsSky(image[x, y]) Then Return
        reached[at] = True
        next.Add(at)
    End Function
    For x = 0 Until width
        reach(x, 0)
        reach(x, height - 1)
    End For
    For y = 0 Until height
        reach(0, y)
        reach(width - 1, y)
    End For
    While next.Count > 0
        Local at = next.RemoveLast()
        Local x = at % width
        Local y = at / width
        reach(x - 1, y)
        reach(x + 1, y)
        reach(x, y - 1)
        reach(x, y + 1)
    End While
    Local shut = 0
    For y = 0 Until height
        For x = 0 Until width
            If IsSky(image[x, y]) && !reached[y * width + x] Then shut += 1
        End For
    End For
    Return shut
End Function

// Where plants.slang moves a point at `position` in its own space, of something at `place`, by its
// first two parameters, as it does on the GPU.
Function PlantMoved(position: Vec3, place: Vec3, wind: Vec4, shape: Vec4): Vec3
    Local high = Max(shape.x, 0.001)
    Local up = Clamp(position.y / high, 0.0, 1.0)
    Local at = position + place
    Local turn: Float = 6.2831853
    Local gust = 0.55 + 0.45 * Sin(turn * 13.0 / 60.0 * wind.w + shape.y + at.x * 0.9 + at.z * 0.7)
    Local flutter = 0.18 *
                    Sin(turn * 45.0 / 60.0 * wind.w + shape.y * 2.3 + at.x * 2.1 + at.y * 1.7 +
                        at.z * 2.6)
    Local bent = shape.z * wind.z * (gust + flutter) * up * up
    Return Vec3(position.x + wind.x * bent, position.y - 0.5 * bent * bent / high * up,
                position.z + wind.y * bent)
End Function

// A grid of `rows` by `columns` squares from `corner`, along `down` and `across`, its normal `facing`;
// or, `by` the plants' wind, each point where plants.slang moves it and its normal what the moved
// points around it say it is.
Function PlantGrid(corner: Vec3, down: Vec3, across: Vec3, facing: Vec3, rows: Int, columns: Int,
                   by: (Vec4, Vec4)?): Geometry
    Local made = Geometry()
    Local surface = made.AddSurface()
    Local at = Function(row: Float, column: Float): Vec3
        Local still = corner + down * (row / (rows As Float)) +
                      across * (column / (columns As Float))
        If by == Null Then Return still
        Return PlantMoved(still, Vec3(0.0, 0.0, 0.0), by.0, by.1)
    End Function
    Local first = -1
    For row = 0 To rows
        For column = 0 To columns
            Local here = at(row As Float, column As Float)
            Local normal = facing
            If by != Null
                Local step: Float = 0.01
                Local downward = at((row As Float) + step, column As Float) -
                                 at((row As Float) - step, column As Float)
                Local sideways = at(row As Float, (column As Float) + step) -
                                 at(row As Float, (column As Float) - step)
                normal = Normalize(Cross(sideways, downward))
                If Dot(normal, facing) < 0.0 Then normal = -normal
            End If
            Local index = surface.AddVertex(Vertex(here, normal, Vec2(0.0, 0.0), Vec2(0.0, 0.0),
                                                   Color(1.0, 1.0, 1.0)))
            If first < 0 Then first = index
        End For
    End For
    For row = 0 Until rows
        For column = 0 Until columns
            Local a = first + row * (columns + 1) + column
            Local b = a + columns + 1
            surface.AddTriangle(a, b, b + 1)
            surface.AddTriangle(a, b + 1, a + 1)
        End For
    End For
    Return made
End Function

// What the island shows with `geometry` drawn in `material` at `at`.
Function ShownWith(island: Island, geometry: Geometry, material: Material,
                   at: Vec3): Image Throws GraphicsError,
                                           IOError
    Local drawn = Mesh(geometry)
    drawn.SetMaterial(material)
    drawn.SetPosition(at)
    Local image = Try Shown(island)
    drawn.Free()
    Return image
End Function

// How many pixels of what the island shows differ by more than 40 of 765 between `from` seconds into
// the slack water and `to`.
Function ChangedOver(island: Island, from: Float64, to: Float64): Int Throws GraphicsError, IOError
    island.Update(from)
    Local before = Try Shown(island)
    island.Update(to)
    Local after = Try Shown(island)
    Local count = 0
    For y = 0 Until before.Height
        For x = 0 Until before.Width
            If Abs(Brightness(before[x, y]) - Brightness(after[x, y])) > 40 Then count += 1
        End For
    End For
    Return count
End Function

// How far, in brightness of 765, what `one` shows differs from what `other` does, on average,
// where either differs from `bare`.
Function ShadedApart(one: Image, other: Image, bare: Image): Float
    Local total = 0
    Local count = 0
    For y = 0 Until one.Height
        For x = 0 Until one.Width
            Local mine = Brightness(one[x, y])
            Local theirs = Brightness(other[x, y])
            Local none = Brightness(bare[x, y])
            If Abs(mine - none) > 20 || Abs(theirs - none) > 20
                total += Abs(mine - theirs)
                count += 1
            End If
        End For
    End For
    Return count == 0 ? 1000.0 : (total As Float) / (count As Float)
End Function

// A plant's normals lean as plants.slang bends it, as the moved points around each say they do:
// a side square to the wind, and a top, each drawn as the shader bends it against one bent here,
// with the normals its moved points give it.
Function CheckBentNormals(camera: Camera, island: Island) Throws GraphicsError, IOError
    Local shader = Try Assets.Load<Shader>(Res.Plants)
    Local wind = Vec4(1.0, 0.0, 1.0, 7.3)
    Local shape = Vec4(2.0, 0.4, 0.8, 0.0)
    Local looked = Function(normals: Bool, moving: Bool): Material
        Local made = Material(Color(1.0, 1.0, 1.0))
        made.SetShader(shader)
        made.SetMetalRough(0.0, 1.0)
        made.SetParameter(0, Vec4(wind.x, wind.y, moving ? wind.z : 0.0, wind.w))
        made.SetParameter(1, shape)
        made.SetParameter(2, Vec4(0.0, 0.0, 0.0, normals ? 1.0 : 0.0))
        Return made
    End Function
    Local bending = looked(True, True)
    Local unbent = looked(False, True)
    Local still = looked(False, False)
    Local middle = Vec3(MAIN_X, 60.0, 80.0)
    island.Grown().SetShown(False)
    Local sides = [(Vec3(0.0, 0.0, -0.6), Vec3(0.0, 2.0, 0.0), Vec3(0.0, 0.0, 1.2),
                    Vec3(1.0, 0.0, 0.0),
                    Vec3(4.0, 1.4, 0.3), "a side square to the wind"),
                   (Vec3(-0.6, 1.2, -0.6), Vec3(0.0, 0.0, 1.2), Vec3(1.2, 0.0, 0.0),
                    Vec3(0.0, 1.0, 0.0),
                    Vec3(1.2, 4.0, 0.8), "a top")]
    For side In sides
        camera.SetPosition(middle + side.4)
        camera.PointAt(middle + Vec3(0.0, 1.0, 0.0))
        Local bare = Try Shown(island)
        Local grid = PlantGrid(side.0, side.1, side.2, side.3, 40, 12, Null)
        Local bent = Try ShownWith(island, grid, bending, middle)
        Local leftAsWas = Try ShownWith(island, grid, unbent, middle)
        Local byPoints = Try ShownWith(island, PlantGrid(side.0, side.1, side.2, side.3, 40, 12,
                                                         (wind, shape)), still, middle)
        Local apart = ShadedApart(bent, byPoints, bare)
        Local asWas = ShadedApart(leftAsWas, byPoints, bare)
        Checks("{side.5}'s normals lean as its moved points do",
               apart < 3.0 && apart * 4.0 < asWas + 1.0)
    End For
    island.Grown().SetShown(True)
End Function

// What grows, saved to look at, and what it's for, by the pixels and where it is.
Function SavePlants(folder: Path, camera: Camera, island: Island) Throws GraphicsError, IOError
    Try CheckBentNormals(camera, island)
    Local grown = island.Grown()
    grown.Sway(10.0)
    Local eye = Vec3(MAIN_X - 24.0, GroundHeight(MAIN_X - 24.0, 18.0) + 1.7, 18.0)
    camera.SetPosition(eye)
    camera.PointAt(Vec3(MAIN_X, GroundHeight(MAIN_X, 0.0) + 1.0, 0.0))
    Local with = Try SavedAs(island, folder, "plants")
    grown.SetGrassShown(False)
    Local without = Try Shown(island)
    Local nearWithout = Try TrianglesDrawn(island)
    grown.SetGrassShown(True)
    Local nearWith = Try TrianglesDrawn(island)
    Local changed = 0
    For y = 380 Until 720
        For x = 0 Until with.Width
            If Abs(Brightness(with[x, y]) - Brightness(without[x, y])) > 30 Then changed += 1
        End For
    End For
    Checks("grass is drawn on the green", (changed As Float) / ((340 * with.Width) As Float) > 0.04)
    Local tufts = grown.Tufts()
    Checks("in thousands of tufts", tufts.Count > 2000)
    Local levels, levelCount, nearVertices = grown.TuftLevels()
    Print("the grass: {tufts.Count} tufts, {nearVertices} vertices near, triangles by level {levels}; " +
          "from here {nearWith - nearWithout} triangles of it, of {nearWith}")
    // Further off, a card's blades are as many along each row as near: at its fourth level, as much
    // of each of the card's rows is past half alpha, and drawn, as of the first level's rows it
    // covers.
    Local atlasImage = GrassAtlasImage()
    Local atlas = Try GrassAtlas()
    Local fourth = atlas.ReadPixels(3)
    Local fourthWidth = Max(atlasImage.Width / 8, 1)
    Local fourthHeight = Max(atlasImage.Height / 8, 1)
    Local rowsKept = True
    For y = 0 Until fourthHeight
        Local far = 0
        For x = fourthWidth / 2 Until fourthWidth
            If fourth[(y * fourthWidth + x) * 4 + 3] >= 128 Then far += 1
        End For
        Local near = 0
        For row = y * 8 Until y * 8 + 8
            For x = atlasImage.Width / 2 Until atlasImage.Width
                If atlasImage[x, row].a >= 128 Then near += 1
            End For
        End For
        Local farShare = (far As Float) / ((fourthWidth / 2) As Float)
        Local nearShare = (near As Float) / ((atlasImage.Width / 2 * 8) As Float)
        If Abs(farShare - nearShare) > 0.1 Then rowsKept = False
    End For
    atlas.Free()
    Checks("further off, a card's blades are as many along each row as near", rowsKept)
    Checks("a tuft's levels have fewer blades, then a card, then none",
           levelCount == 4 && levels.Count == 5 && levels[0] > levels[1] && levels[1] > levels[2] &&
           levels[2] > levels[3] && levels[3] > 0 && levels[4] == 0)
    // From high over the island, every tuft's past its last level, so the grass draws nothing.
    camera.SetPosition(Views()[0].1)
    camera.PointAt(Views()[0].2)
    grown.SetGrassShown(False)
    Local farWithout = Try TrianglesDrawn(island)
    grown.SetGrassShown(True)
    Local farWith = Try TrianglesDrawn(island)
    // As an Instances' levels go by its clusters' size, what's far off is a card a tuft, at most.
    Checks("near, it's blades, and from far off, cards at most",
           nearWith > nearWithout + 50000 &&
           farWith - farWithout <= (tufts.Count * levels[3]) As Int64)
    camera.SetPosition(eye)
    camera.PointAt(Vec3(MAIN_X, GroundHeight(MAIN_X, 0.0) + 1.0, 0.0))

    // Every tuft on the ground as it's drawn, a little into it.
    Local grounded = True
    For tuft In tufts
        Local drawn = island.GroundDrawnAt(tuft.At.x, tuft.At.z)
        If drawn == Null || Abs(tuft.At.y - drawn) > 0.031 Then grounded = False
    End For
    Checks("every tuft's on the ground as it's drawn", grounded)

    // None of it where it's kept clear: by the mill, the road, what's blocked, the parts' spots, the
    // door, and where the road's ends are landed on.
    Local clear = True
    For tuft In tufts
        If InTheClear(tuft.At) Then clear = False
    End For
    For plant In grown.Trees()
        If InTheClear(plant) Then clear = False
    End For
    For plant In grown.Shrubs()
        If InTheClear(plant) Then clear = False
    End For
    Checks("none of it where it's kept clear", clear)

    Local trees = grown.Trees()
    Local byTheMill = trees.Count == 3
    For tree In trees
        If Length(Vec2(tree.x - MAIN_X, tree.z)) > 30.0 Then byTheMill = False
    End For
    Checks("three trees stand by the mill", byTheMill)
    Checks("and shrubs grow about it", grown.Shrubs().Count >= 5)

    // A tree, square to the wind, so what it bends goes across the view.
    Local tree = trees[0]
    camera.SetPosition(tree + Vec3(-3.9, 1.5, 9.2))
    camera.PointAt(tree + Vec3(0.0, 3.6, 0.0))
    Try SavedAs(island, folder, "tree")
    // It sways: at one beat, the storm's wind moves it further from where it'd stand with none than
    // the calm's does.
    island.Update(0.0)
    Local calm = Try ChangedBy(island, Function()
        grown.SetWindless(True)
    End Function, 0, 400, 40)
    grown.SetWindless(False)
    island.Update(TIDE_IN_AT)
    Local stormy = Try ChangedBy(island, Function()
        grown.SetWindless(True)
    End Function, 0, 400, 40)
    grown.SetWindless(False)
    Checks("trees sway in the wind", calm > 200)
    Checks("harder in the storm, at one beat", stormy > calm + calm / 4)
    // Its normals lean as it bends.
    Local leaning = Try ChangedBy(island, Function()
        grown.SetBentNormals(False)
    End Function, 0, 400, 6)
    grown.SetBentNormals(True)
    Checks("its normals follow its bend", leaning > 100)

    // Its trunk bends as its leaves do: with them hidden, in the storm, its top moves, and its foot
    // doesn't.
    grown.SetCanopiesShown(False)
    // A meter up its trunk, which leans a tenth of that with the wind as it's built.
    Local foot = tree + Vec3(WIND.x * 0.1, 1.0, WIND.y * 0.1)
    Local footBefore = PixelOf(camera, Try Shown(island), foot)
    Local topMoved = Try ChangedBy(island, Function()
        grown.Sway(3.0)
    End Function, 0, 400, 40)
    Local footAfter = PixelOf(camera, Try Shown(island), foot)
    grown.SetCanopiesShown(True)
    Checks("its trunk bends as its leaves do", topMoved > 40)
    Checks("and its roots stay put",
           footBefore != Null && footAfter != Null && footBefore.r >= footBefore.g &&
           Abs((footBefore.r As Int) - (footAfter.r As Int)) + Abs((footBefore.g As Int) -
                                                                   (footAfter.g As Int)) +
           Abs((footBefore.b As Int) - (footAfter.b As Int)) < 20)
    island.Update(0.0)

    // Its canopy has holes, from below: the sky shows through within where its leaves are.
    camera.SetPosition(tree + Vec3(0.6, 1.2, 0.4))
    camera.PointAt(tree + Vec3(0.3, 9.0, 0.2))
    Local under = Try SavedAs(island, folder, "under_a_tree")
    grown.SetCanopiesShown(False)
    Local bare = Try Shown(island)
    grown.SetCanopiesShown(True)
    Local leafy = 0
    Local through = 0
    For y = 0 Until under.Height
        For x = 0 Until under.Width
            Local seen = under[x, y]
            Local sky = bare[x, y]
            If IsSky(sky)
                If Abs(Brightness(seen) - Brightness(sky)) > 40 Then leafy += 1 Else through += 1
            End If
        End For
    End For
    Checks("its canopy has holes the sky shows through",
           leafy > 20000 && (through As Float) / ((leafy + through) As Float) > 0.1)
    // Bent by the storm, its wood doesn't tear: no more sky's shut inside it than when it's still.
    grown.SetCanopiesShown(False)
    island.Update(TIDE_IN_AT)
    Local woodBent = Try Shown(island)
    grown.SetWindless(True)
    Local woodStill = Try Shown(island)
    grown.SetWindless(False)
    grown.SetCanopiesShown(True)
    island.Update(0.0)
    Local woodMoved = 0
    For y = 0 Until woodBent.Height
        For x = 0 Until woodBent.Width
            If IsSky(woodBent[x, y]) != IsSky(woodStill[x, y]) Then woodMoved += 1
        End For
    End For
    Checks("bent by the storm, its wood doesn't tear",
           woodMoved > 2000 && EnclosedSky(woodBent) <= EnclosedSky(woodStill) + 30)

    // Just off the view on the side the wind comes from, in the storm, its leaves bend into it: it's
    // drawn, as its box takes its bend. The view's square to the wind, which goes left to right across
    // it, from far off and narrow, so its edge goes nearly straight back, and slid along it till all of
    // the leaves' box, unbent, is past that edge. What's counted is leaves against the sky, as their
    // shadow's cast wherever they are.
    island.Update(TIDE_IN_AT)
    Local wide = camera.FieldOfView()
    camera.SetFieldOfView(0.12)
    SlidPast(camera, tree, grown.CanopyBoxes()[0], 0.0)
    // Its leaves alone, so nothing else that sways is counted, through a gust's whole beat: at its
    // hardest, they bend past their box's edge into the view.
    grown.SetShown(False)
    grown.SetCanopyShown(0, True)
    grown.SetWindless(True)
    Local edgeStill = Try Shown(island)
    grown.SetWindless(False)
    Local entered = 0
    For step = 0 Until 24
        grown.Sway(0.25)
        Local edgeShown = Try Shown(island)
        Local here = 0
        For y = 0 Until edgeShown.Height
            For x = 0 Until 160
                If IsSky(edgeStill[x, y]) && !IsSky(edgeShown[x, y]) Then here += 1
            End For
        End For
        entered = Max(entered, here)
    End For
    // And the tallest's box, which goes past its bounds by as far as it bends at most, is drawn
    // 1.3 meters past the edge: none of its own is, as it's still, but the view's what's counted.
    Local tallest = trees.Count - 1
    grown.SetCanopyShown(0, False)
    SlidPast(camera, trees[tallest], grown.CanopyBoxes()[tallest], 1.3)
    grown.SetCasting(False)
    grown.SetWindless(True)
    Local withoutIt = Try TrianglesDrawn(island)
    grown.SetCanopyShown(tallest, True)
    Local withIt = Try TrianglesDrawn(island)
    grown.SetWindless(False)
    grown.SetCasting(True)
    grown.SetShown(True)
    camera.SetFieldOfView(wide)
    island.Update(0.0)
    Checks("just off the view, a tree bent into it is drawn", entered > 30)
    Checks("and a box past the edge by less than the most it bends is drawn", withIt > withoutIt)

    // Each tree's and shrub's box goes past its leaves by as far as plants.slang bends them at most,
    // as the beat goes round, over the top of them.
    Local covered = True
    For canopy In grown.Canopies()
        Local geometry = canopy.Geometry() ?? Geometry()
        Local bounds = geometry.Bounds()
        Local box = geometry.CullBox() ?? bounds
        Local past = Min(Min(box.Max.x - bounds.Max.x, bounds.Min.x - box.Min.x),
                         Min(box.Max.z - bounds.Max.z, bounds.Min.z - box.Min.z))
        Local shape = (canopy.Material() ?? Material(Color(1.0, 1.0, 1.0))).Parameter(1)
        Local most: Float = 0.0
        For corner = 0 Until 25
            Local top = Vec3(bounds.Min.x +
                             (bounds.Max.x - bounds.Min.x) * ((corner % 5) As Float) / 4.0,
                             bounds.Max.y,
                             bounds.Min.z +
                             (bounds.Max.z - bounds.Min.z) * ((corner / 5) As Float) / 4.0)
            For beat = 0 Until 1200
                Local moved = PlantMoved(top, Vec3(0.0, 0.0, 0.0),
                                         Vec4(WIND.x, WIND.y, 1.0, (beat As Float) * 0.05), shape)
                most = Max(most, Length(Vec2(moved.x - top.x, moved.z - top.z)))
            End For
        End For
        If past < most Then covered = False
    End For
    Checks("each tree's and shrub's box takes the most it bends", covered)
End Function

// Turns `camera` square to the wind, from far off and narrow, and slides it along that till all of
// `box` is `beyond` meters past its left edge, looking at `tree`.
Function SlidPast(camera: Camera, tree: Vec3, box: AABB, beyond: Float)
    Local across = Normalize(Vec3(WIND.x, 0.0, WIND.y))
    Local ahead = Cross(Vec3(0.0, 1.0, 0.0), across)
    Local offEdge = 0.0
    While offEdge < 40.0
        Local from = tree + Vec3(0.0, 2.0, 0.0) - ahead * 100.0 + across * offEdge
        camera.SetPosition(from)
        camera.PointAt(from + ahead * 100.0 + Vec3(0.0, 3.0, 0.0))
        Local past = True
        For corner = 0 Until 8
            Local at = Vec3((corner & 1) == 0 ? box.Min.x : box.Max.x,
                            (corner & 2) == 0 ? box.Min.y : box.Max.y,
                            (corner & 4) == 0 ? box.Min.z : box.Max.z) + across * beyond
            Local seen = camera.Project(at)
            If seen != Null && seen.x >= 0.0 Then past = False
        End For
        If past Then Return
        offEdge += 0.05
    End While
End Function

// The sea and the sky, saved to look at, and what each of them's for, by the pixels.
Function SaveSeaAndSky(folder: Path, camera: Camera, island: Island) Throws GraphicsError, IOError
    // Over the edge of the main rock, along its south shore.
    Local shoreZ: Float = 0.0
    While GroundHeight(MAIN_X, shoreZ) > 0.0
        shoreZ += 0.25
    End While
    camera.SetPosition(Vec3(MAIN_X - 16.0, 4.5, shoreZ + 9.0))
    camera.PointAt(Vec3(MAIN_X + 2.0, 0.0, shoreZ - 1.0))
    Local shore = Try SavedAs(island, folder, "shore")
    Local edge, edges = SeaAtDepth(camera, shore, 0.0, 0.05)
    Local deep, deeps = SeaAtDepth(camera, shore, 0.0, 2.2)
    Checks("the sea has foam at its edge, none where it's deep",
           edges > 10 && deeps > 10 && edge > deep + 40.0)

    // It hides what's under it by how deep it is, which shows by taking that away.
    island.SetGroundHidden(True)
    Local bare = Try Shown(island)
    island.SetGroundHidden(False)
    Local shallowWith, _ = ColorAtDepth(camera, shore, 0.0, 0.3)
    Local shallowBare, _ = ColorAtDepth(camera, bare, 0.0, 0.3)
    Local deepWith, _ = ColorAtDepth(camera, shore, 0.0, 2.2)
    Local deepBare, _ = ColorAtDepth(camera, bare, 0.0, 2.2)
    Checks("the ground shows through what's shallow", Apart(shallowWith, shallowBare) > 20.0)
    Checks("and not through what's deep", Apart(deepWith, deepBare) < 25.0)

    // It goes up the shore with the tide.
    camera.SetPosition(Vec3(MAIN_X - 16.0, 6.0, shoreZ + 9.0))
    island.Update(TIDE_IN_AT)
    Local high = Try Shown(island)
    Local wasEdge, _ = SeaAtDepth(camera, high, SeaHeight(TIDE_IN_AT), SeaHeight(TIDE_IN_AT) + 0.05)
    Local nowEdge, _ = SeaAtDepth(camera, high, SeaHeight(TIDE_IN_AT), 0.05)
    Checks("its foam goes up the shore with the tide", nowEdge > wasEdge + 70.0)
    island.Update(0.0)

    // Its foam rolls in, at a depth it's at one moment and not the next.
    camera.SetPosition(Vec3(MAIN_X - 16.0, 4.5, shoreZ + 9.0))
    Local least: Float = 1000.0
    Local most: Float = 0.0
    For step = 0 Until 8
        island.Update((step As Float64) * 0.6)
        Local rolled, _ = SeaAtDepth(camera, Try Shown(island), 0.0, 0.55)
        least = Min(least, rolled)
        most = Max(most, rolled)
    End For
    island.Update(0.0)
    Checks("its foam rolls in", most > least + 25.0)

    // At the very edge, its foam's broken up along the shore, not a band.
    Local edgeShown = Try Shown(island)
    Local dimmest, brightest = BrightnessAlong(camera, edgeShown, 0.06)
    Checks("its foam's broken up along the shore", brightest > dimmest + 100.0)
    Local covered = FoamAlong(camera, edgeShown, 0.04)
    Checks("its edge's foam has holes in it", covered > 0.08 && covered < 0.7)
    // A meter deep, the shallows' own green, which the deep hasn't.
    Local shallow, _ = ColorAtDepth(camera, edgeShown, 0.0, 1.0)
    Checks("the shallows are their own color", shallow.y - shallow.x > 45.0)

    // Its normals move, out at sea, where there's no foam: and nothing but them does.
    camera.SetPosition(Vec3(MAIN_X, 12.0, 90.0))
    camera.PointAt(Vec3(MAIN_X, 0.0, 300.0))
    Local before = Try Shown(island)
    island.Update(0.25)
    Local after = Try Shown(island)
    island.Update(0.0)
    Local moved = Function(from: Int, to: Int): Float
        Local count = 0
        For y = from Until to
            For x = 0 Until before.Width
                If Abs(Brightness(before[x, y]) - Brightness(after[x, y])) > 12 Then count += 1
            End For
        End For
        Return (count As Float) / (((to - from) * before.Width) As Float)
    End Function
    Checks("the sea's waves move", moved(420, 720) > 0.2)

    // Its waves don't repeat by a tile of them, as two tiles across each other don't: seen from straight
    // above, with no patches of wind to tell them apart, the sea a tile along isn't what it was.
    Local waters = island.Waters()
    waters.SetPatched(False)
    camera.SetProjection(Projection.ORTHOGRAPHIC)
    camera.SetOrthographicHeight(40.0)
    camera.SetPosition(Vec3(0.0, 60.0, 400.0))
    camera.PointAt(Vec3(0.0, 0.0, 400.001))
    Local overhead = Try Shown(island)
    camera.SetPosition(Vec3(48.0, 60.0, 400.0))
    camera.PointAt(Vec3(48.0, 0.0, 400.001))
    Local alongATile = Try Shown(island)
    camera.SetProjection(Projection.PERSPECTIVE)
    Local apart: Float = 0.0
    For y = 100 Until 620
        For x = 200 Until 1080
            apart += Abs(Brightness(overhead[x, y]) - Brightness(alongATile[x, y])) As Float
        End For
    End For
    Checks("its waves don't repeat by a tile", apart / (520.0 * 880.0) > 1.5)
    waters.SetPatched(True)
    Checks("and the sky doesn't", moved(0, 100) < 0.01)
    // Each tile of them, alone, out at sea.
    camera.SetPosition(Vec3(MAIN_X, 12.0, 90.0))
    camera.PointAt(Vec3(MAIN_X, 0.0, 300.0))
    For first In [True, False]
        island.Waters().SetTilesKept(first, !first)
        Local alone = Try Shown(island)
        island.Update(0.25)
        Local aloneLater = Try Shown(island)
        island.Update(0.0)
        Checks(first ? "its first tile of waves moves" : "and its second",
               MovedShare(alone, aloneLater, 420, 720) > 0.1)
    End For
    island.Waters().SetTilesKept(True, True)
    // An hour in, they go on as they were: neither tile's place jumps.
    Local tilesAt = Function(clock: Float64): (Vec4, Vec4)
        island.Update(clock)
        Return (island.Waters().Shown().Parameter(1), island.Waters().Shown().Parameter(2))
    End Function
    Local oneBefore, otherBefore = tilesAt(3599.99)
    Local oneAfter, otherAfter = tilesAt(3600.01)
    island.Update(0.0)
    Local wrappedApart = Function(a: Float, b: Float): Float => Min(Abs(a - b), 1.0 - Abs(a - b))
    Checks("an hour in, its waves don't jump",
           Max(wrappedApart(oneBefore.y, oneAfter.y), wrappedApart(oneBefore.z, oneAfter.z)) <
           0.002 &&
           Max(wrappedApart(otherBefore.y, otherAfter.y),
               wrappedApart(otherBefore.z, otherAfter.z)) <
           0.002)

    // Each tile's slopes are the world's: with every texel of a tile tilted along x, the second's,
    // sampled turned, turned back, the two make what a map of their sum would.
    Local tilted = Try Texture(4, 4, TextureFormat.RGBA8_LINEAR, False)
    Local tiltedBytes: UInt8[] = []
    For texel = 0 Until 16
        tiltedBytes.AddAll([204 As UInt8, 128 As UInt8, 230 As UInt8, 0 As UInt8])
    End For
    tilted.WritePixels(0, 0, 4, 4, tiltedBytes)
    island.Waters().SetWaveTile(tilted)
    Local byTiles = Try Shown(island)
    island.Waters().SetWaveTile(Null)
    // (0.6, 0, 0.8), and it turned back: (0.48, -0.36, 0.8); their slopes added and their ups
    // multiplied, as water.slang does, as a map holds it: to within what a map's bytes round off, which
    // a glint shows.
    Local summed = Normalize(Vec3(1.08, -0.36, 0.64))
    Local mapped = island.Waters().Shown().Clone()
    mapped.SetShader(Null)
    Local summedMap = Try Texture(1, 1, TextureFormat.RGBA8_LINEAR, False)
    summedMap.WritePixels(0, 0, 1, 1, [Round((summed.x * 0.5 + 0.5) * 255.0) As UInt8,
                                       Round((summed.y * 0.5 + 0.5) * 255.0) As UInt8,
                                       Round((summed.z * 0.5 + 0.5) * 255.0) As UInt8,
                                       255 As UInt8])
    mapped.SetMap(MaterialMap.NORMAL, summedMap)
    island.Waters().SetDrawnWith(mapped)
    Local byMap = Try Shown(island)
    island.Waters().SetDrawnWith(Null)
    Local unlike = 0
    For y = 420 Until 720
        For x = 0 Until byMap.Width
            If Abs(Brightness(byMap[x, y]) - Brightness(byTiles[x, y])) > 9 Then unlike += 1
        End For
    End For
    Checks("its second tile's slopes are turned back to the world's",
           (unlike As Float) / ((300 * byMap.Width) As Float) < 0.15)

    // Out to sea, into the sun, which is where its light's from.
    Local way = WayToSun(0.0)
    camera.SetPosition(Vec3(MAIN_X, GroundHeight(MAIN_X, shoreZ - 6.0) + 3.0, shoreZ - 6.0))
    camera.PointAt(Vec3(MAIN_X + way.x * 100.0, 3.0 + way.y * 100.0 - 18.0, shoreZ + way.z * 100.0))
    Local sky = Try SavedAs(island, folder, "sun")
    Local sunPixel = PixelOf(camera, sky, island.SunPlace())
    Checks("the sun's drawn, bright", sunPixel != Null && Brightness(sunPixel) > 720)
    // From wherever it's seen, as far off: from 200 m along, it's still its way from there.
    Local here = camera.Position()
    camera.SetPosition(here + Vec3(200.0, 0.0, 0.0))
    island.Render()
    Local along = Try Screen.ToImage()
    Flip(False)
    Local seenFrom = PixelOf(camera, along, here + Vec3(200.0, 0.0, 0.0) + way * SUN_OFF)
    Checks("and it's its way from wherever it's seen",
           Length(island.SunPlace() - (here + Vec3(200.0, 0.0, 0.0) + way * SUN_OFF)) < 0.01 &&
           seenFrom != Null && Brightness(seenFrom) > 720)
    camera.SetPosition(here)
    Local light = island.SunTurned() * Vec3(0.0, 0.0, -1.0)
    Checks("where its light's from",
           Abs(light.x + way.x) < 0.001 && Abs(light.y + way.y) < 0.001 &&
           Abs(light.z + way.z) < 0.001)
    Local place = island.SunPlace()
    island.Update(TIDE_IN_AT)
    Checks("and it moves as that does", Length(island.SunPlace() - place) > 1000.0)
    island.Update(0.0)
    Local pale = Function(pixel: Color32): Bool => pixel.r > 190 && pixel.g > 190 && pixel.b > 190
    Local blue = Function(pixel: Color32): Bool => (pixel.b As Int) > (pixel.r As Int) + 25
    Checks("there are clouds in the sky, and sky between them",
           Share(sky, pale) > 0.08 && Share(sky, pale) < 0.7 && Share(sky, blue) > 0.15)

    // What's in the sea is that sky: where a still sea's mirror goes to cloud, it's brighter than
    // where it goes to none. It's only the Environment that could show it there. A moving one's as
    // smooth, but for its waves: the sun's glitter on them is past what this could tell apart.
    island.SetSeaStill(True)
    Local eye = Vec3(MAIN_X, 12.0, 90.0)
    camera.SetPosition(eye)
    camera.PointAt(Vec3(MAIN_X, 0.0, 300.0))
    Local still = Try SavedAs(island, folder, "still_sea")
    island.SetSeaStill(False)
    Checks("a still sea shows the clouds over it", CloudsIn(camera, still, eye) > 40.0)
    Checks("and a moving one's as smooth", island.SeaRoughness() <= 0.25)
    island.Waters().SetRoughness(0.5)
    Checks("which a rougher one isn't", island.SeaRoughness() > 0.25)
    island.Waters().SetRoughness(island.Waters().Roughness())

    // Where each of what drifts in its foam wraps to its start, the foam goes on as it was: from just
    // before to just after, no more of the shore that's shown changes than in as long where none
    // wraps. So sea.fb's period and water.slang's can't drift apart.
    camera.SetPosition(Vec3(MAIN_X - 16.0, 4.5, shoreZ + 9.0))
    camera.PointAt(Vec3(MAIN_X + 2.0, 0.0, shoreZ - 1.0))
    Local unwrapped = Try ChangedOver(island, 1799.999, 1800.001)
    For drift In [("coarse froth", FROTH_DRIFT), ("fine froth", FINE_FROTH_DRIFT),
                  ("streaking", STREAKS_DRIFT)]
        Local wraps = FROTH_PERIOD / drift.1
        Local across = Try ChangedOver(island, wraps - 0.001, wraps + 0.001)
        Checks("where its {drift.0} wraps, at {wraps} s, its foam doesn't jump",
               across < unwrapped * 2 + 200)
    End For
    island.Update(0.0)
End Function

// How much brighter, of 765, the sea `image` shows from `eye` is where its mirror goes to cloud than
// where it goes to clear sky, as far off.
Function CloudsIn(camera: Camera, image: Image, eye: Vec3): Float
    Local brighter: Float = 0.0
    Local cloudyCount = 0
    For along = 0 Until 40
        // Along a row, where it's all as far off, so the sky shows as much in each.
        Local cloudy: Float = 0.0
        Local clear: Float = 0.0
        Local cloudyHere = 0
        Local clearHere = 0
        For across = -40 To 40
            Local spot = Vec3(MAIN_X + (across As Float) * 6.0, 0.0, 130.0 + (along As Float) * 5.0)
            Local to = Normalize(spot - eye)
            Local cloud, _ = CloudAt(to.x, -to.y, to.z)
            Local pixel = PixelOf(camera, image, spot)
            If pixel != Null
                If cloud > 0.7
                    cloudy += Brightness(pixel) As Float
                    cloudyHere += 1
                ElseIf cloud < 0.02
                    clear += Brightness(pixel) As Float
                    clearHere += 1
                End If
            End If
        End For
        If cloudyHere > 0 && clearHere > 0
            brighter += (cloudy / (cloudyHere As Float) - clear / (clearHere As Float)) *
                        (cloudyHere As Float)
            cloudyCount += cloudyHere
        End If
    End For
    Return cloudyCount > 20 ? brighter / (cloudyCount As Float) : 0.0
End Function

// The island, in `folder`, from each of its views, at slack water and at high tide; and whether
// what was drawn is what it should be, as the flow has the tide, by the pixels themselves.
// How long it's been since `began`, said as `what` took, for a log to show what costs.
Function Lap(what: String, began: Instant): Instant
    Local now = Instant.Now()
    Print("{what} took {(now - began).TotalSeconds} s")
    Return now
End Function

Function SaveViews(folder: Path, stillsOnly: Bool = False) Throws GraphicsError, IOError
    Local lap = Instant.Now()
    Window.SetHeadless(True)
    Try Graphics(1280, 720)
    Defer EndGraphics()
    Try Res.Mount()
    Defer Assets.StopWatching()
    Local island = Try Island.Make()
    Defer island.Free()
    Local camera = Camera()
    Looked(camera)
    Checks("it's drawn with ambient occlusion, antialiasing over frames, and bloom",
           camera.AmbientOcclusion() > 0.0 && camera.TemporalAA() && !camera.Fxaa() &&
           camera.BloomIntensity() > 0.0)
    Local low = Camera()
    Looked(low, True)
    Checks("and low, with antialiasing from the picture alone, and bloom",
           low.AmbientOcclusion() == 0.0 && !low.TemporalAA() && low.Fxaa() &&
           low.BloomIntensity() > 0.0)
    low.Free()
    Local saved = 0
    Local images = Map<String, Image>()
    For view In Views()
        camera.SetPosition(view.1)
        camera.PointAt(view.2)
        island.Drawn(camera)
        Try Screen.Save(folder / "{view.0}.png")
        images[view.0] = Try Screen.ToImage()
        saved += 1
        Flip(False)
    End For
    lap = Lap("the views", lap)
    If !stillsOnly
        // The sea's and the plants' checks compare what's drawn as it is, as they were written to:
        // ambient occlusion shades it, and antialiasing over frames or from the picture moves it.
        camera.SetAmbientOcclusion(0.0)
        camera.SetTemporalAA(False)
        camera.SetFxaa(False)
        Try SaveSeaAndSky(folder, camera, island)
        Try SavePlants(folder, camera, island)
        Looked(camera)
        lap = Lap("the sea and sky", lap)
    End If
    // High tide, from the island's view.
    Local first = Views()[0]
    camera.SetPosition(first.1)
    camera.PointAt(first.2)
    island.Update(TIDE_IN_AT)
    island.Drawn(camera)
    Try Screen.Save(folder / "island_high_tide.png")
    Local high = Try Screen.ToImage()
    saved += 1
    Flip(False)
    Checks("saved 5 views of the island", saved == 5)
    // What a cooked game's views are compared by, and nothing more.
    If stillsOnly Then Return

    // The numbers the flow goes by, as drawn.
    Local allAgree = True
    For second = 0 To TIDE_IN_AT As Int
        island.Update(second As Float64)
        If Abs(island.SeaDrawnAt() - SeaHeight(second As Float64)) > 0.0001 Then allAgree = False
    End For
    Checks("the sea's drawn at the tide's height", allAgree)
    Local crossX = Round(PaddleSpot().x)
    Local crossZ = Round(RoadZ(crossX))
    Local crossing = island.GroundDrawnAt(crossX, crossZ)
    Checks("the causeway's drawn at its height",
           crossing != Null && Abs(crossing - GroundHeight(crossX, crossZ)) < 0.01)
    Local millAt = island.GroundDrawnAt(MAIN_X, 0.0)
    Checks("the mill's ground's drawn at its height",
           millAt != Null && Abs(millAt - GroundHeight(MAIN_X, 0.0)) < 0.01)

    // The pixels: the causeway's there at slack, and gone at high; the far rock, and the roof, at
    // both; and the land's share falls, by what a rising sea would take.
    Local slack = images["island"]
    Local road = Vec3(PaddleSpot().x, SeaHeight(0.0) + 0.5, PaddleSpot().y)
    Local dry = PixelOf(camera, slack, road)
    Checks("the causeway's land at slack water", dry != Null && !IsSea(dry))
    Local under = PixelOf(camera, high, Vec3(road.x, SeaHeight(TIDE_IN_AT), road.z))
    Checks("the causeway's sea at high tide", under != Null && IsSea(under))
    Local farRock = Vec3(FAR_X, GroundHeight(FAR_X, FAR_Z), FAR_Z)
    Local farSlack = PixelOf(camera, slack, farRock)
    Local farHigh = PixelOf(camera, high, farRock)
    Checks("the far rock's land at both",
           farSlack != Null && farHigh != Null && !IsSea(farSlack) && !IsSea(farHigh))
    Local roof = Vec3(MAIN_X, GroundHeight(MAIN_X, 0.0) + 5.6, 0.0)
    Local roofSlack = PixelOf(camera, slack, roof)
    Local roofHigh = PixelOf(camera, high, roof)
    Checks("the roof's land at both",
           roofSlack != Null && roofHigh != Null && !IsSea(roofSlack) && !IsSea(roofHigh))
    Local land = Function(pixel: Color32): Bool => !IsSea(pixel) && !IsSky(pixel)
    // Of what's around the rocks, as a far sea with clouds in it is pale, whatever the tide.
    Local ratio = ShareWithin(high, land, 300, 250, 900, 480) /
                  Max(ShareWithin(slack, land, 300, 250, 900, 480), 0.0001)
    Checks("the tide takes some of the land", ratio > 0.6 && ratio < 0.95)
    Checks("the sky's at the top of the yard's view", IsSky(images["yard"][640, 4]))
    Checks("the yard's middle isn't sky", !IsSky(images["yard"][640, 360]))
    Local pipPixel = images["pip"][640, 360]
    Checks("Pip's brass is in the middle of his view",
           pipPixel.r > pipPixel.g && pipPixel.g > pipPixel.b)
    Checks("no sky's seen from the mill's inside", Share(images["mill_inside"], IsSky) < 0.01)

    // The look: what each of its parts does, by turning it off, from Pip's view, where brass is.
    island.Update(0.0)
    Local pipView = Views()[2]
    camera.SetPosition(pipView.1)
    camera.PointAt(pipView.2)
    island.Drawn(camera)
    Local lit = Try Screen.ToImage()
    Flip(False)
    island.SetAround(False)
    island.Drawn(camera)
    Local unlit = Try Screen.ToImage()
    Flip(False)
    island.SetAround(True)
    Checks("the light around it reaches Pip's brass",
           Brightness(lit[640, 360]) > Brightness(unlit[640, 360]) + 30)
    Checks("the camera's in HDR, and tonemapped", camera.Hdr() && camera.Tonemap() == Tonemap.ACES)
    camera.SetHdr(False)
    island.Drawn(camera)
    Local flat = Try Screen.ToImage()
    Flip(False)
    camera.SetHdr(True)
    Checks("and that's what's drawn", Different(lit, flat) > 0.5)
    // The sun's moved by the tide's end, and its shadow's fallen across the yard.
    Local yardView = Views()[1]
    camera.SetPosition(yardView.1)
    camera.PointAt(yardView.2)
    Local early = island.SunTurned()
    island.Drawn(camera)
    Local yardEarly = Try Screen.ToImage()
    Flip(False)
    // The sun alone, as the sea's height would change the picture too.
    island.TurnSun(TIDE_IN_AT)
    Checks("the sun moves by the clock", island.SunTurned() != early)
    island.Drawn(camera)
    Local yardLate = Try Screen.ToImage()
    Flip(False)
    Checks("and what's lit with it", Different(yardEarly, yardLate) > 0.1)
    // The mill's shadow, on the yard.
    island.SetSunShadows(False)
    island.Drawn(camera)
    Local unshadowed = Try Screen.ToImage()
    Flip(False)
    island.SetSunShadows(True)
    Checks("the sun casts shadows", Different(yardLate, unshadowed) > 0.0005)
    // The ground's repeats, from high up.
    Local highView = Views()[0]
    camera.SetPosition(highView.1)
    camera.PointAt(highView.2)
    island.Drawn(camera)
    Local fromFar = Try Screen.ToImage()
    Flip(False)
    Checks("the ground's repeats don't show from far off",
           RepeatShows(camera, fromFar) > GROUND_APART)
    Local cover = island.GroundMaterial()
    Checks("the ground's as rough as what covers it, under grit at two scales, one turned",
           cover != Null && cover.Map(MaterialMap.METAL_ROUGH) != Null &&
           cover.Map(MaterialMap.METAL_ROUGH) != cover.Map(MaterialMap.NORMAL) &&
           cover.Texture(2) != Null && cover.LayerUv(2).Angle != 0.0 &&
           cover.LayerUv(2).Scale.x != cover.LayerUv(1).Scale.x)
    // The lantern, in the mill.
    Local insideView = Views()[3]
    camera.SetPosition(insideView.1)
    camera.PointAt(insideView.2)
    island.Drawn(camera)
    Local byLantern = Try Screen.ToImage()
    Flip(False)
    island.SetLantern(False)
    island.Drawn(camera)
    Local noLantern = Try Screen.ToImage()
    Flip(False)
    island.SetLantern(True)
    Checks("the lantern lights the mill", Different(byLantern, noLantern) > 0.2)
    Checks("no sky's reflected in the ceiling", SkyInCeiling(camera, noLantern) < CEILING_SKY)
    camera.SetPosition(yardView.1)
    camera.PointAt(yardView.2)
    // The storm's grade: greyer, by its saturation, and darker.
    camera.SetGrade(StormGrade(0.0))
    island.Drawn(camera)
    Local clear = Try Screen.ToImage()
    Flip(False)
    camera.SetGrade(StormGrade(1.0))
    island.Drawn(camera)
    Local stormy = Try Screen.ToImage()
    Flip(False)
    Try Screen.Save(folder / "storm.png")
    // By how bright it looks, which greying alone leaves about where it was.
    Checks("the storm darkens what's seen", Luma(stormy[640, 4]) < Luma(clear[640, 4]) * 0.97)
    Checks("Pip's body is its brass", island.PipHasMaps())
    // It's drawn by what's set on its model after it's spawned.
    camera.SetPosition(pipView.1)
    camera.PointAt(pipView.2)
    camera.SetGrade(StormGrade(0.0))
    island.Drawn(camera)
    Local brassy = Try Screen.ToImage()
    Flip(False)
    // Its eyes shut, saved for a person to see, and seen.
    island.BlinkPip(1.0)
    island.Drawn(camera)
    Try Screen.Save(folder / "pip_blink.png")
    Local blinked = Try Screen.ToImage()
    Flip(False)
    island.BlinkPip(0.0)
    // One of them, a little in front of its head, as Pip faces.
    Local pipNow = island.PipEntity()
    Local eyes = pipNow.Position(Space.WORLD) +
                 pipNow.Rotation(Space.WORLD) * Vec3(0.05, 0.745, 0.1)
    Local eyeAt = camera.Project(eyes)
    Local openWhite = eyeAt != Null ? WhiteAround(brassy, eyeAt.x As Int, eyeAt.y As Int) : 0
    Local shutWhite = eyeAt != Null ? WhiteAround(blinked, eyeAt.x As Int, eyeAt.y As Int) : 0
    Checks("its eyes shut, as they're drawn", openWhite > 2 * shutWhite + 4)
    Local body = island.PipBody()
    island.SetPipBody(Material(Color(0.0, 1.0, 0.0)))
    island.Drawn(camera)
    Local green = Try Screen.ToImage()
    Flip(False)
    island.SetPipBody(body)
    Checks("and what's set on its surface is what's drawn",
           (green[640, 360].g As Int) > (brassy[640, 360].g As Int) + 20)
    // A still's drawn afresh: the yard, drawn after the dark mill, as it is drawn after itself, with
    // nothing of the mill blended into it.
    camera.SetPosition(yardView.1)
    camera.PointAt(yardView.2)
    island.Drawn(camera)
    Local yardAgain = Try Screen.ToImage()
    Flip(False)
    island.SetLantern(False)
    camera.SetPosition(insideView.1)
    camera.PointAt(insideView.2)
    island.Drawn(camera)
    Flip(False)
    island.SetLantern(True)
    camera.SetPosition(yardView.1)
    camera.PointAt(yardView.2)
    island.Drawn(camera)
    Local yardAfterDark = Try Screen.ToImage()
    Flip(False)
    // By how bright it is, as the sea moves between them, and their pixels move by a part of one.
    Checks("a still's drawn afresh, with nothing of the view before it",
           Abs(MeanBrightness(yardAgain) - MeanBrightness(yardAfterDark)) < AFRESH)
    lap = Lap("the island's checks", lap)
    Try CheckLandmarks(folder, island, camera)
    lap = Lap("the landmarks", lap)
    Try CheckBodies(folder, island, camera)
    lap = Lap("the bodies", lap)
End Function

// Each of `island`'s landmarks, as `camera` sees it, with it hidden and shown: in `image` of the view
// it's in, whether it changes what's near `place`.
Function SeenIn(island: Island, camera: Camera, image: Image, thing: Entity,
                place: Vec3): Bool Throws GraphicsError
    thing.Hide()
    island.Drawn(camera)
    Local without = Try Screen.ToImage()
    Flip(False)
    thing.Show()
    Return DiffersNear(camera, image, without, place)
End Function

// What the GPU takes for a frame of what `camera` sees, in milliseconds: the middle of 16, after 4 to
// settle.
Function FrameMilliseconds(island: Island): Float
    Local costs: Float[] = []
    For frame = 1 To 20
        island.Scene().Render()
        Flip(False)
        If frame > 4 Then costs.Add(Gpu.Counters().GpuMilliseconds)
    End For
    costs.Sort()
    Return costs[costs.Count / 2]
End Function

// The lighthouse, seen from the yard and from by it, its lamp lit as the storm comes; the jetty and
// its boat, riding the sea; and what's along the shores. Each one's share of a frame of the whole
// island, said.
Function CheckLandmarks(folder: Path, island: Island, camera: Camera) Throws GraphicsError, IOError
    Local marks = island.Marks()
    Local pieces = marks.Pieces()
    // The parts lie on the ground where they're found, neither in the air nor under it: each's bottom,
    // its half-height under its middle, within a few centimeters of it.
    Local lying = True
    For part In [Part.GEAR, Part.PADDLE, Part.BELT]
        Local thing = island.PartEntity(part)
        Local at = thing.Position(Space.WORLD)
        Local bottom = at.y - thing.Scale().y
        If Abs(bottom - GroundHeight(at.x, at.z)) > 0.03 Then lying = False
    End For
    Checks("the parts lie on the ground", lying)
    // What a body can move: each barrel and crate on a pivot of its own with its meshes under it, of
    // its size; each log a mesh of its own, where it was placed; and the boat, which once driven stays
    // where it's put, whatever the sea does.
    Local props = island.Props()
    Local ownPivots = props.Count == 5
    For prop In props
        If prop.0.ChildCount() == 0 || prop.0.Parent() != island.Works() Then ownPivots = False
        If prop.1 == 0 && (prop.2.x != BARREL_RADIUS || prop.2.y != BARREL_HIGH) Then ownPivots = False
    End For
    Checks("the barrels and crates are each their own", ownPivots)
    Local logs = marks.Logs()
    Local logsPlaced = True
    Local logSpots: (Vec2, Int, Float, Float)[] = []
    For spot In ShoreSpots()
        If spot.1 == 0 Then logSpots.Add(spot)
    End For
    If logs.Count != logSpots.Count Then logsPlaced = False
    For at = 0 Until Min(logs.Count, logSpots.Count)
        Local placed = Placed(logSpots[at])
        Local log = logs[at]
        Local away = log.0.Position(Space.WORLD) - placed.0
        If Dot(away, away) > 0.0001 || Abs(log.1 - 2.0 * placed.2.x) > 0.0001 Then logsPlaced = False
    End For
    Checks("each log's its own, {logs.Count} of them, where it was placed",
           logs.Count > 0 && logsPlaced)
    Local rowboat = marks.Boat()
    Local afloat = rowboat.Position(Space.WORLD)
    marks.DriveBoat(True)
    rowboat.SetPosition(Vec3(1.0, 2.0, 3.0))
    island.Update(TIDE_IN_AT)
    marks.Animate(0.5)
    Local stayed = rowboat.Position(Space.WORLD) == Vec3(1.0, 2.0, 3.0)
    marks.DriveBoat(False)
    island.Update(0.0)
    Checks("a driven boat goes where it's driven", stayed &&
           rowboat.Position(Space.WORLD) != Vec3(1.0, 2.0, 3.0))
    // Its body drives it, from where it was.
    marks.DriveBoat(True)
    rowboat.SetPosition(afloat)
    Local yardView = Views()[1]
    camera.SetPosition(yardView.1)
    camera.PointAt(yardView.2)
    island.Update(0.0)
    island.Drawn(camera)
    Local yard = Try Screen.ToImage()
    Flip(False)
    Checks("the lighthouse is seen from the yard",
           Try SeenIn(island, camera, yard, pieces[0].1, marks.LampAt() - Vec3(0.0, 4.0, 0.0)))
    // From the road's far end, at slack water, and as the tide's in.
    Local by = Vec3(ROAD_EAST + 3.0, GroundHeight(ROAD_EAST + 3.0, RoadZ(ROAD_EAST + 3.0)) + 3.0,
                    RoadZ(ROAD_EAST + 3.0) + 3.0)
    camera.SetPosition(by)
    camera.PointAt(marks.LampAt() - Vec3(0.0, 3.0, 0.0))
    island.Update(0.0)
    Local unlit = marks.Beam()
    island.Drawn(camera)
    Local early = Try Screen.ToImage()
    Try Screen.Save(folder / "lighthouse.png")
    Flip(False)
    Checks("and from by it", Try SeenIn(island, camera, early, pieces[0].1, marks.LampAt()))
    island.Update(TIDE_IN_AT)
    island.Drawn(camera)
    Local late = Try Screen.ToImage()
    Try Screen.Save(folder / "lighthouse_lit.png")
    Flip(False)
    // Its beam, turned this way as it passes, out past the lamp room's frame.
    Local toward = by - marks.LampAt()
    marks.TurnBeam(Atan2(-toward.x, -toward.z))
    island.Drawn(camera)
    Try Screen.Save(folder / "lighthouse_beam.png")
    Flip(False)
    Local before = PixelOf(camera, early, marks.LampAt())
    Local after = PixelOf(camera, late, marks.LampAt())
    Checks("its lamp's lit as the storm comes, and not before",
           unlit == 0.0 && marks.Beam() > 0.0 && before != Null && after != Null &&
           Brightness(after) > Brightness(before) + 60)
    // The jetty, from its landward end, and the boat by it, riding the sea up.
    Local start = JettyStart()
    Local end = JettyEnd()
    camera.SetPosition(Vec3(start.x + 4.0, GroundHeight(start.x + 4.0, start.y) + 3.0,
                            start.y + 5.0))
    camera.PointAt(Vec3((start.x + end.x) / 2.0, 1.5, end.y))
    island.Update(0.0)
    Local boatLow = marks.BoatAt().y
    island.Drawn(camera)
    Local jetty = Try Screen.ToImage()
    Try Screen.Save(folder / "jetty.png")
    Flip(False)
    Checks("the jetty's seen", Try SeenIn(island, camera, jetty, pieces[1].1,
                                          Vec3((start.x + end.x) / 2.0, 2.0, end.y)))
    Checks("and the boat by it", Try SeenIn(island, camera, jetty, pieces[2].1, marks.BoatAt()))
    Local boat = marks.BoatAt()
    camera.SetPosition(boat + Vec3(2.6, 1.8, 2.2))
    camera.PointAt(boat + Vec3(0.0, 0.1, 0.0))
    island.Drawn(camera)
    Try Screen.Save(folder / "boat.png")
    Flip(False)
    // From over it, nothing of the sea's seen inside it: what's between its gunwales is its own.
    camera.SetPosition(boat + Vec3(0.0, 3.5, 0.01))
    camera.PointAt(boat)
    island.Drawn(camera)
    Local over = Try Screen.ToImage()
    Flip(False)
    Local sea = 0
    Local looked = 0
    For across = -2 To 2
        For along = -8 To 8
            Local inside = PixelOf(camera, over, boat + Vec3((across As Float) * 0.08, 0.0,
                                                             (along As Float) * 0.08))
            If inside == Null Then Continue
            looked += 1
            If (inside.b As Int) > (inside.r As Int) + 30 Then sea += 1
        End For
    End For
    Checks("nothing of the sea's seen in the boat, of {looked}", looked > 60 && sea == 0)
    // Floated up by the tide, in real time, as its body is.
    Tide(island, 0.0, TIDE_IN_AT, 10.0)
    Checks("which rides the sea up",
           Abs(marks.BoatAt().y - boatLow - (SeaHeight(TIDE_IN_AT) - SeaHeight(0.0))) < 0.2)
    Tide(island, TIDE_IN_AT, 0.0, 10.0)
    // What's along the shores: all of it placed, and some of it seen from the jetty.
    Local spots = ShoreSpots()
    Checks("what's washed up lies where it was placed, {spots.Count} of it",
           marks.LitterCount() == spots.Count && spots.Count >= 20)
    Local nearest = spots[0].0
    For spot In spots
        Local away = (spot.0.x - start.x) * (spot.0.x - start.x) +
                     (spot.0.y - start.y) * (spot.0.y - start.y)
        Local best = (nearest.x - start.x) * (nearest.x - start.x) +
                     (nearest.y - start.y) * (nearest.y - start.y)
        If away < best Then nearest = spot.0
    End For
    camera.SetPosition(Vec3(nearest.x + 3.0, GroundHeight(nearest.x, nearest.y) + 2.0,
                            nearest.y + 3.0))
    camera.PointAt(Vec3(nearest.x, GroundHeight(nearest.x, nearest.y), nearest.y))
    island.Drawn(camera)
    Local shore = Try Screen.ToImage()
    Try Screen.Save(folder / "shore_litter.png")
    Flip(False)
    Checks("and it's seen", Try SeenIn(island, camera, shore, pieces[3].1,
                                       Vec3(nearest.x, GroundHeight(nearest.x, nearest.y) + 0.1,
                                            nearest.y)))
    // Each one's share of a frame, which takes hundreds of frames to tell: only when asked.
    If Env.Get("SLACK_WATER_COSTS") == "1" Then CostsOf(island, camera, pieces)
End Function

// Moves the island's tide from `from` to `to` over `seconds` of real time, by tenths, as the flow's
// clock would, its bodies stepped as they go.
Function Tide(island: Island, from: Float64, to: Float64, seconds: Float)
    Local frames = Max(Round(seconds * 10.0) As Int, 1)
    For frame = 1 To frames
        island.Update(from + (to - from) * ((frame As Float64) / (frames As Float64)))
        island.Animate(0.1)
    End For
End Function

// The bodies, by fbengine_physics: the boat at low tide and at high tide, riding up and swinging on its
// rope; a barrel knocked over, by walking into it; and the driftwood the flood floats, and settles as
// it falls. Each saved, and what the bodies cost a frame, as a share of one at 60 fps.
Function CheckBodies(folder: Path, island: Island, camera: Camera) Throws GraphicsError, IOError
    Local bodies = island.Bodies()
    Local marks = island.Marks()
    Local spentFrom = bodies.Spent()
    Local stepsFrom = bodies.Steps()
    Tide(island, 0.0, 0.0, 3.0)
    Local boat = bodies.Boat().Position()
    Local tied, bollard = bodies.RopeEnds()
    Checks("the boat floats on the slack water, {boat.y - SeaHeight(0.0)} m over it, on its rope",
           Abs(boat.y - (SeaHeight(0.0) + RIDES)) < 0.02 &&
           Distance(tied, bollard) < bodies.RopeLength() + 0.05)
    Local start = JettyStart()
    Local end = JettyEnd()
    camera.SetPosition(Vec3(start.x + 4.0, GroundHeight(start.x + 4.0, start.y) + 3.0,
                            start.y + 5.0))
    camera.PointAt(Vec3((start.x + end.x) / 2.0, 1.5, end.y))
    island.Drawn(camera)
    Local low = Try Screen.ToImage()
    Try Screen.Save(folder / "boat_low_tide.png")
    Flip(False)
    Checks("and it's seen, at low tide", Try SeenIn(island, camera, low, marks.Boat(), boat))
    // The tide comes in, in a minute of real time, as the flow's clock goes at thirty times: the boat
    // never under the jetty's deck, and its floorboards over the sea at every step, as they're drawn,
    // with nothing of the sea seen in it when they're lowest.
    Local under = False
    bodies.LowestRide()
    Local lowest: Float = 1000.0
    Local seaInIt = 0
    Local lookedIn = 0
    For second = 1 To 60
        Tide(island, TIDE_IN_AT * ((second - 1) As Float64) / 60.0,
             TIDE_IN_AT * (second As Float64) / 60.0, 1.0)
        Local at = bodies.Boat().Position()
        If at.x > end.x - 0.5 && at.x < start.x && Abs(at.z - end.y) < 1.9 Then under = True
        Local ride = bodies.LowestRide()
        If ride < lowest
            lowest = ride
            Local seen = Try SeaInBoat(island, camera, at)
            seaInIt = seen.0
            lookedIn = seen.1
        End If
    End For
    Checks("and keeps clear of the jetty as the tide comes in", !under)
    Local boards = lowest - KEEL + FLOORBOARDS
    Checks("its floorboards over the sea all the while, {boards} m at the lowest", boards > 0.0)
    Checks("and nothing of the sea seen in it then, of {lookedIn}", lookedIn > 60 && seaInIt == 0)
    Tide(island, TIDE_IN_AT, TIDE_IN_AT, 3.0)
    Local high = bodies.Boat().Position()
    tied, bollard = bodies.RopeEnds()
    Checks("it's risen with the tide, {high.y - boat.y} m, on its rope",
           Abs(high.y - (SeaHeight(TIDE_IN_AT) + RIDES)) < 0.02 &&
           Distance(tied, bollard) < bodies.RopeLength() + 0.05)
    Checks("and swung on it, {Distance(Vec2(high.x, high.z), Vec2(boat.x, boat.z))} m",
           Distance(Vec2(high.x, high.z), Vec2(boat.x, boat.z)) > 0.2)
    island.Drawn(camera)
    Local highImage = Try Screen.ToImage()
    Try Screen.Save(folder / "boat_high_tide.png")
    Flip(False)
    Checks("and it's seen, at high tide", Try SeenIn(island, camera, highImage, marks.Boat(), high))
    // The driftwood the flood's reached floats, at the water's height.
    Local floating = 0
    Local afloat: Vec3? = Null
    For log In bodies.Logs()
        Local at = log.Position()
        If Abs(at.y - bodies.WaterAt(at.x, at.z)) < 0.2
            floating += 1
            If afloat == Null Then afloat = at
        End If
    End For
    Local some = afloat
    Checks("the flood floats driftwood, {floating} of {bodies.Logs().Count}",
           floating > 0 && some != Null)
    If some != Null
        camera.SetPosition(some + Vec3(3.0, 2.0, 3.0))
        camera.PointAt(some)
        island.Drawn(camera)
        Try Screen.Save(folder / "driftwood_afloat.png")
        Flip(False)
    End If
    // As the water falls, each settles near where it lay: at rest on the sand, or, where the slack
    // water's over its sand, as most of them are, afloat on it, riding the swell.
    Local lay = bodies.Logs().Map(Function(log: Body) => log.Position())
    Local back = False
    For second = 1 To 60
        Tide(island, TIDE_IN_AT * ((60 - second + 1) As Float64) / 60.0,
             TIDE_IN_AT * ((60 - second) As Float64) / 60.0, 1.0)
        Local at = bodies.Boat().Position()
        If at.x > end.x - 0.5 && at.x < start.x && Abs(at.z - end.y) < 1.9 Then back = True
    End For
    Checks("and keeps clear of the jetty as it goes out", !back)
    Tide(island, 0.0, 0.0, 5.0)
    Local resting = 0
    Local riding = 0
    Local strayed = False
    For at = 0 Until bodies.Logs().Count
        Local log = bodies.Logs()[at]
        Local place = log.Position()
        Local water = bodies.WaterAt(place.x, place.z)
        If Distance(log.Velocity(), Vec3(0.0, 0.0, 0.0)) < 0.05 && place.y > water
            resting += 1
        ElseIf Abs(place.y - water) < 0.15
            riding += 1
        End If
        If Distance(Vec2(place.x, place.z), Vec2(lay[at].x, lay[at].z)) > 3.0 Then strayed = True
    End For
    Checks("and settles as the water falls, near where it lay: {resting} at rest on the sand, " +
           "{riding} afloat in the shallows",
           resting + riding == bodies.Logs().Count && resting > 0 && !strayed)
    // The barrel that stands alone, walked into from the south, is knocked over, and lies still.
    Local barrel = island.Props()[1].0.Position(Space.WORLD)
    For step = 0 To 30
        Local z = barrel.z - 2.5 + (step As Float) * 0.15
        island.SetWalker(Vec3(barrel.x, island.FloorAt(barrel.x, z), z))
        island.Animate(0.1)
    End For
    Tide(island, 0.0, 0.0, 4.0)
    Local knocked = bodies.Props()[1]
    Local up = knocked.Rotation() * Vec3(0.0, 1.0, 0.0)
    Checks("a barrel you walk into is knocked over, {up}, and lies still",
           up.y < 0.5 && Distance(knocked.Velocity(), Vec3(0.0, 0.0, 0.0)) < 0.05 &&
           knocked.Position().y > GroundHeight(knocked.Position().x, knocked.Position().z) - 0.05)
    camera.SetPosition(knocked.Position() + Vec3(2.5, 1.8, 2.5))
    camera.PointAt(knocked.Position())
    island.Drawn(camera)
    Try Screen.Save(folder / "barrel_knocked.png")
    Flip(False)
    // What the bodies take of a frame at 60 fps: a step of each, on the machine's time.
    Local steps = bodies.Steps() - stepsFrom
    Local each = (bodies.Spent() - spentFrom) / (Max(steps, 1) As Float64)
    Print(
        "the bodies take {each * 1000.0} ms a step, {each * 60.0 * 100.0}% of a frame at 60 fps, " +
        "over {steps} steps")
    Checks("which is under a twentieth of a frame", each * 60.0 < 0.05)
    // At their worst: everything awake, the flood coming in fast over the driftwood and the boat, and
    // you walking back and forth through the barrels and crates.
    island.Reset()
    Local props = island.Props()[1].0.Position(Space.WORLD)
    Local worstSpent = bodies.Spent()
    Local worstSteps = bodies.Steps()
    For frame = 1 To 100
        Local across = props.x - 1.5 + 3.0 * Abs(Sin((frame As Float) * 0.08))
        Local along = props.z - 1.0 + 2.0 * Abs(Cos((frame As Float) * 0.05))
        island.SetWalker(Vec3(across, island.FloorAt(across, along), along))
        island.Update(TIDE_IN_AT * (frame As Float64) / 100.0)
        island.Animate(0.1)
    End For
    Local worst = (bodies.Spent() - worstSpent) / (Max(bodies.Steps() - worstSteps, 1) As Float64)
    Print("at their worst, all awake, flooded and pushed, the bodies take " +
          "{worst * 1000.0} ms a step, {worst * 60.0 * 100.0}% of a frame at 60 fps")
    Checks("which is under a tenth of a frame", worst * 60.0 < 0.1)
    island.Reset()
End Function

// From over the boat at `boat`: how many of the points between its gunwales show the sea, and how many
// were looked at.
Function SeaInBoat(island: Island, camera: Camera, boat: Vec3): (Int, Int) Throws GraphicsError
    camera.SetPosition(boat + Vec3(0.0, 3.5, 0.01))
    camera.PointAt(boat)
    island.Drawn(camera)
    Local over = Try Screen.ToImage()
    Flip(False)
    Local sea = 0
    Local looked = 0
    For across = -2 To 2
        For along = -8 To 8
            Local inside = PixelOf(camera, over, boat + Vec3((across As Float) * 0.08, 0.0,
                                                             (along As Float) * 0.08))
            If inside == Null Then Continue
            looked += 1
            If (inside.b As Int) > (inside.r As Int) + 30 Then sea += 1
        End For
    End For
    Return (sea, looked)
End Function

// Each of `pieces`' share of a frame of the whole island, from above, as `camera` sees it.
Function CostsOf(island: Island, camera: Camera, pieces: (String, Entity)[])
    // Each one's share of a frame of the whole island, from above: its draws and triangles, exactly,
    // and its time, as the middle of five turns of it hidden and shown, beside how much the frame's own
    // time wanders, which a share under can't be told from.
    Local whole = Views()[0]
    camera.SetPosition(whole.1)
    camera.PointAt(whole.2)
    FrameMilliseconds(island)
    Local counted = Gpu.Counters()
    Local all = FrameMilliseconds(island)
    Print("cost's wander: {Abs(FrameMilliseconds(island) - all) / all * 100.0}% of {all} ms, " +
          "{counted.Draws} draws, {counted.Triangles} triangles")
    For piece In pieces
        Local shares: Float[] = []
        Local draws: Int64 = 0
        Local triangles: Int64 = 0
        For turn = 1 To 5
            Local shown = FrameMilliseconds(island)
            piece.1.Hide()
            Local hidden = FrameMilliseconds(island)
            draws = counted.Draws - Gpu.Counters().Draws
            triangles = counted.Triangles - Gpu.Counters().Triangles
            piece.1.Show()
            shares.Add((shown - hidden) / shown * 100.0)
        End For
        shares.Sort()
        Print("cost of the {piece.0}: {shares[2]}% of the frame's time, {draws} draws, " +
              "{triangles} triangles")
    End For
End Function

// How much of two images of a size differ, by more than a little, from 0 to 1.
Function Different(one: Image, other: Image): Float
    Local count = 0
    For y = 0 Until one.Height
        For x = 0 Until one.Width
            Local a = one[x, y]
            Local b = other[x, y]
            If Abs((a.r As Int) - (b.r As Int)) + Abs((a.g As Int) - (b.g As Int)) +
               Abs((a.b As Int) - (b.b As Int)) > 6
                count += 1
            End If
        End For
    End For
    Return (count As Float) / ((one.Width * one.Height) As Float)
End Function

// Loads every asset the tools make from `folder`, as the game will, and says what they are: what's
// wrong is a failure, as a sound with no sound in it, or one that clips.
Function Checked(folder: Path) Throws GraphicsError, IOError
    Assets.MountFolder("res://made", folder)
    Defer Assets.Unmount("res://made")
    Local soundsGood = True
    For name In ["wind", "sea", "gull", "creak", "wheel", "step_1", "step_2", "step_3", "floor_1",
                 "floor_2", "wade_1", "wade_2", "splash"]
        Local sound = Try Assets.Load<Sound>("res://made/{name}.wav")
        Local fault = SoundFault(Try Assets.ReadBytes("res://made/{name}.wav"))
        If fault != Null
            Print("{name}: {fault}")
            soundsGood = False
        End If
        sound.Free()
    End For
    Checks("the sounds load, none silent, none clipping", soundsGood)
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    Window.SetHeadless(True)
    For material In ["rock", "sand", "wood", "brass", "iron", "grit"]
        Local albedo = Try Assets.Load<Texture>("res://made/{material}_albedo.png")
        Local normal = Try Assets.Load<Texture>("res://made/{material}_normal.png")
        Local rough = Try Assets.Load<Texture>("res://made/{material}_rough.png")
        Checks("{material}'s textures load as what they are",
               albedo.Width() ==
               (material == "rock" || material == "sand" || material == "grit" ? 256 : 128) &&
               albedo.Format() == TextureFormat.RGBA8 &&
               normal.Format() == TextureFormat.RGBA8_LINEAR &&
               rough.Format() == TextureFormat.RGBA8_LINEAR)
        albedo.Free()
        normal.Free()
        rough.Free()
    End For
    Local world = World()
    Defer world.Free()
    World.SetCurrent(world)
    Local pip = Try Assets.Load<Model>("res://made/pip.gltf")
    Defer pip.Free()
    Local root = Try pip.Spawn()
    Local found = root.Find("pip")
    Local clips: String[] = []
    For clip In pip.Clips()
        clips.Add(clip.Name())
    End For
    Checks("Pip's joints and clips are what they are", pip.Skins()[0].JointCount() == 8 &&
           ", ".Join(clips) == "idle, walk, carry")
    If !(found Is Mesh)
        Checks("Pip's a mesh", False)
        Return
    End If
    Local mesh = found As Mesh
    Local geometry = pip.Geometries()[0]
    Local morphs = 0
    For surface In geometry.Surfaces()
        morphs += surface.MorphTargetCount()
    End For
    Checks("its surfaces, morphs, and bones are what they are", geometry.SurfaceCount() == 3 &&
           morphs == 3 && geometry.Surface(0).MorphTargetCount() == 1 && mesh.Palette().Count == 8)
    Local bounds = geometry.Bounds()
    Checks("it's 0.9 m high to its antenna's top, on the ground",
           IsClose(bounds.Max.y, 0.9, 0.001) && IsClose(bounds.Min.y, 0.0, 0.001))
    // No clip: every joint where it was bound, so its palette's all identity.
    Local identity = True
    For matrix In mesh.Palette()
        Local origin = matrix.TransformPoint(Vec3(0.3, 0.4, 0.5))
        If !IsClose(origin, Vec3(0.3, 0.4, 0.5), 0.00001) Then identity = False
    End For
    Checks("at rest, its palette moves nothing", identity)
    // Walking, at a key: a leg's foot moves, and the head's vertices don't, as the body's not bobbing
    // at that key. Joints: root 0, hips 1, body 2, head 3, arms 4 and 5, legs 6 and 7.
    Local player = root.Player()
    player.Play(pip.Clips()[1])
    player.SetTime(0.5)
    UpdateWorld(0.0)
    Local palette = mesh.Palette()
    Local foot = palette[7].TransformPoint(Vec3(-0.08, 0.0, 0.0))
    Local head = palette[3].TransformPoint(Vec3(0.0, 0.72, 0.0))
    Checks("walking, its foot moves", Abs(foot.z) > 0.05)
    Checks("and its head stays over it", Abs(head.x) < 0.001 && Abs(head.z) < 0.001)
    // How far a turn of its walk takes a foot is what the game goes by, so its feet don't slide, and
    // its carry too.
    Local legR = 7
    Local footAt = Vec3(-0.08, 0.0, 0.0)
    Local firstFoot = palette[legR].TransformPoint(footAt).z
    player.SetTime(0.0)
    UpdateWorld(0.0)
    Local stride = 2.0 * Abs(mesh.Palette()[legR].TransformPoint(footAt).z - firstFoot) * 1.0
    Checks("its walk's stride is what the game goes by {stride}", Abs(stride - WALK_STRIDE) < 0.03)
    player.Play(pip.Clips()[2])
    player.SetTime(0.0)
    UpdateWorld(0.0)
    Local carryFrom = mesh.Palette()[legR].TransformPoint(footAt).z
    player.SetTime(0.5)
    UpdateWorld(0.0)
    Local carrying = 2.0 * Abs(mesh.Palette()[legR].TransformPoint(footAt).z - carryFrom)
    Checks("its carry's stride is too {carrying}", Abs(carrying - CARRY_STRIDE) < 0.03)
    player.Play(pip.Clips()[1])
    // At each eighth of its walk, its lowest point's on the ground, within a few millimeters.
    Local grounded = True
    Local vertices = geometry.Surface(0).Vertices()
    Local joints = geometry.Surface(0).Joints()
    For key = 0 To 8
        player.SetTime((key As Float) * 0.125)
        UpdateWorld(0.0)
        Local posed = mesh.Palette()
        Local lowest = 1000.0
        For at = 0 Until vertices.Count
            Local placed = posed[joints[at].Joint0 As Int].TransformPoint(vertices[at].Position)
            lowest = Min(lowest, placed.y)
        End For
        If Abs(lowest) > GROUNDED
            Print("at an eighth {key} it's {lowest} up")
            grounded = False
        End If
    End For
    Checks("at each eighth of its walk, it's on the ground", grounded)
    // The blink shuts its eyes: everything of its pupils and whites over their bottoms comes down,
    // its pupils to no higher than what's left of its whites.
    Local openPupils = mesh.MorphedPositions(1)
    Local openWhites = mesh.MorphedPositions(2)
    mesh.SetMorphWeights([1.0])
    Local shutPupils = mesh.MorphedPositions(1)
    Local shutWhites = mesh.MorphedPositions(2)
    Local allDown = True
    Local whitesTop = -1000.0
    For at = 0 Until shutWhites.Count
        whitesTop = Max(whitesTop, shutWhites[at].y)
    End For
    Local pupilsTop = -1000.0
    For at = 0 Until shutPupils.Count
        pupilsTop = Max(pupilsTop, shutPupils[at].y)
    End For
    For pair In [(openPupils, shutPupils), (openWhites, shutWhites)]
        Local lowest = 1000.0
        For point In pair.0
            lowest = Min(lowest, point.y)
        End For
        For at = 0 Until pair.0.Count
            If pair.0 [at].y > lowest + 0.002 && pair.1 [at].y >= pair.0 [at].y Then allDown = False
        End For
    End For
    Checks("blinking, its eyes shut", allDown && pupilsTop <= whitesTop)
End Function

// Whether two folders' files are the same: every byte, but for PNGs, whose pixels are, as a PNG's
// bytes are its zlib's. A shader's kept but not made: it's written by hand, as code is.
Function Matched(made: Path, kept: Path) Throws IOError
    Local same = True
    Local names: String[] = []
    For entry In Try Dir.Entries(kept)
        If !entry.Name().EndsWith(".slang") Then names.Add(entry.Name())
    End For
    Local madeNames: String[] = []
    For entry In Try Dir.Entries(made)
        madeNames.Add(entry.Name())
    End For
    If names.Count != madeNames.Count
        Print("{names.Count} files kept, {madeNames.Count} made")
        same = False
    End If
    For name In names
        If !madeNames.Contains(name)
            Print("{name} isn't made")
            same = False
            Continue
        End If
        Local one = Try File.ReadBytes(made / name)
        Local two = Try File.ReadBytes(kept / name)
        If name.EndsWith(".png")
            Local first = Try Png.Decode(one)
            Local second = Try Png.Decode(two)
            If first.Pixels.ToArray() != second.Pixels.ToArray()
                Print("{name}'s pixels differ")
                same = False
            End If
        ElseIf one != two
            Print("{name} differs")
            same = False
        End If
    End For
    Checks("what's kept is what the tools make", same)
End Function

// What a 3D walk does, a thing at a time: walks to a Spot or a part by its name, presses E or Q, or
// waits for the clock.
Function Walk3dOf(name: String): String[]?
    Select name
        // The gear and the paddle first, the gear in Pip's hands; then the belt, in time.
        Case "bright"
            Return ["door", "gear", "E", "Q", "crossing", "E", "door", "inside", "E", "Q", "E", "E",
                    "door", "crossing", "belt", "E", "crossing", "door", "inside", "E", "240"]
        // The same, but never going for the belt.
        Case "dim"
            Return ["door", "gear", "E", "Q", "crossing", "E", "door", "inside", "E", "Q", "E", "E",
                    "240"]
        // Out to the far rock, as the road floods behind you, and trying to walk back.
        Case "dark"
            Return ["door", "crossing", "belt", "131", "door", "240"]
        // With the paddle in hand on the mill's side, and the sluice shut, so nothing's settled, at
        // the flooded road, which holds you back.
        Case "cut"
            Return ["door", "crossing", "E", "shore", "131", "crossing", "240"]
        // Standing on the road near its mill end as it floods, Pip with you, which takes you the short
        // way.
        Case "swept"
            Return ["door", "near_west", "240"]
        // Beside the road, in its span, too deep once it floods.
        Case "wing"
            Return ["door", "crossing", "wing", "240"]
        // Just past the road's far end as it floods, which takes you nowhere.
        Case "far_end"
            Return ["door", "crossing", "far_end", "240"]
        Default
            Return Null
    End Select
End Function

// Where a walk's step goes, or Null if it isn't a place.
Function WalkTarget(island: Island, step: String): Vec2?
    Select step
        Case "inside"
            Return island.PlaceOf(Spot.INSIDE)
        Case "door"
            Return island.PlaceOf(Spot.DOOR)
        Case "crossing"
            Return island.PlaceOf(Spot.CROSSING)
        Case "shore"
            Return Landing(False)
        Case "near_west"
            Return Vec2(ROAD_WEST + 6.0, RoadZ(ROAD_WEST + 6.0))
        Case "wing"
            Return Vec2(15.0, RoadZ(15.0) - 3.8)
        Case "far_end"
            Return Vec2(ROAD_EAST + 0.8, RoadZ(ROAD_EAST + 0.8))
        Case "gear"
            Return island.PartSpot(Part.GEAR)
        Case "belt"
            Return island.PartSpot(Part.BELT)
        Default
            Return Null
    End Select
End Function

// A walk being walked, a thing at a time, by keys pressed.
Final Class Walker
    Field walk: String[]
    Field next: Int = 0
    Field walking: Bool = False
    Field holding: Bool = False

    New(walk: String[])
        Self.walk = walk
    End New

    // Presses what's next, turning you to where it goes, as a person's mouse would, and gives what's
    // just been pressed, or "".
    @MainThread
    Method Next(game: Game, island: Island): String Throws GraphicsError
        If next >= walk.Count Then Return ""
        Local step = walk[next]
        Local target = WalkTarget(island, step)
        Local until = Int.Parse(step)
        If target != Null
            Local here = game.Location()
            Local dx = target.x - here.x
            Local dz = target.y - here.y
            // Within a step of it, or within reach of what lies there.
            If dx * dx + dz * dz < 1.0
                Try Stop()
                next += 1
            Else
                game.Face(target.x, target.y)
                If !walking
                    Try Simulate.KeyDown(Key.W)
                    walking = True
                End If
            End If
        ElseIf until != Null
            If game.Story().Clock() >= (until As Float64) Then next += 1
        ElseIf step == "Q"
            If game.Story().PipHere()
                Try Simulate.PressKey(Key.Q)
                next += 1
                Return step
            End If
        ElseIf holding
            // Held till the sluice opens, as a person holds it.
            If game.Story().SluiceOpen()
                Try Simulate.KeyUp(Key.E)
                holding = False
                next += 1
                Return step
            End If
        ElseIf game.HoldsToOpen()
            Try Simulate.KeyDown(Key.E)
            holding = True
        Else
            Try Simulate.PressKey(Key.E)
            next += 1
            Return step
        End If
        Return ""
    End Method

    // Lets go of W, if it's held.
    @MainThread
    Method Stop() Throws GraphicsError
        If walking Then Try Simulate.KeyUp(Key.W)
        If holding Then Try Simulate.KeyUp(Key.E)
        walking = False
        holding = False
    End Method
End Class

// What's wrong with how the game stands, by what the flow says, or Null: where you and Pip are, how
// near Pip is, what's on the flooded road, where each part is, what you see from, and Pip's clip.
Function Fault(game: Game, island: Island): String?
    Local flow = game.Story()
    Local here = game.Location()
    Local pip = game.PipLocation()
    If flow.Ended() == Ending.NONE
        If PlaceHeld(flow.At(), here.x, here.y) != flow.At()
            Return "you're at {here.x}, {here.y}, not {PlaceName(flow.At())}"
        End If
        If PlaceHeld(flow.PipAt(), pip.x, pip.y) != flow.PipAt()
            Return "Pip's at {pip.x}, {pip.y}, not {PlaceName(flow.PipAt())}"
        End If
    End If
    If flow.PipHere() && !PipWithYou(pip.x, pip.y, here.x, here.y)
        Return "Pip's too far to be here"
    End If
    If game.EyeAt() <= SeaHeight(flow.Clock()) Then Return "your eyes are under the sea"
    If flow.Flooded() && (OnRoad(here.x, here.y) || OnRoad(pip.x, pip.y))
        Return "someone's on the flooded road"
    End If
    For number = 0 To 2
        Local part = number As Part
        Local thing = island.PartEntity(part)
        Local parent = thing.Parent()
        If flow.Fitted(part)
            If parent != island.Works() || thing.Hidden() Then Return "{PartName(part)} isn't fitted"
        ElseIf flow.Held() == part
            If parent != (game.View() As Entity) || thing.Hidden()
                Return "{PartName(part)} isn't in your hand"
            End If
        ElseIf flow.PipHolds() == part
            If parent != island.PipEntity() || thing.Hidden()
                Return "{PartName(part)} isn't in Pip's hands"
            End If
        ElseIf flow.Lying(part) != Null
            If parent != Null || thing.Hidden() Then Return "{PartName(part)} isn't lying"
        ElseIf !thing.Hidden()
            Return "{PartName(part)} isn't the sea's"
        End If
    End For
    Local seen = game.View().Position()
    If !IsClose(seen, Vec3(here.x, game.EyeAt() + game.Bob(), here.y), 0.001) Then Return "you see from {seen}"
    Local wanted = flow.PipHolds() != Null ? "carry" : game.PipMoved() > 0.0 ? "walk" : "idle"
    If island.PipClipName() != wanted Then Return "Pip's playing {island.PipClipName()}, not {wanted}"
    Return Null
End Function

// Walks `walk` to its end, by W, E, and Q pressed, offscreen, and gives how it ended, checking how it
// stands at every step. It turns you to each place itself, as a person's mouse would; `stepped` hears
// of each step, with what's just been done.
Function Walked3d(island: Island, walk: String[], lines: String[],
                  stepped: Func(Game, String)): Ending Throws GraphicsError, IOError, AudioError
    Local controls = Controls()
    Local game = Game(island, Function(line: String)
        Print(line)
        lines.Add(line)
    End Function)
    Defer game.Free()
    // Heard as a person would, mixed here, as nothing's to play it to.
    Try StartAudio(AudioDevice.MANUAL, 44100)
    Defer Audio.Stop()
    Local scape = Try Soundscape.Make(game, island)
    Defer scape.Free()
    // Before anything's said its level, it's already not loud.
    Checks("it starts quiet, before its first step", PeakOf(Audio.Mix(1024)) < 0.2)
    Local mixedFrom = Audio.Frames()
    Local bodiesFrom = island.Bodies().Steps()
    Local steps = 0
    Local loudest: Float = 0.0
    Local walker = Walker(walk)
    Local doing = ""
    Local fault: String? = Null
    Local flooded = False
    While game.Story().Ended() == Ending.NONE
        doing = Try walker.Next(game, island)
        Flip(False)
        game.Step(controls, 0.1)
        scape.Update(game, 0.1)
        // Mixed at the pace it's played, a tenth of a second a step.
        loudest = Max(loudest, PeakOf(Audio.Mix(4410)))
        steps += 1
        If !flooded && game.Story().Flooded()
            flooded = True
            Local you = game.Location()
            Local pip = game.PipLocation()
            Local apart = Sqrt((you.x - pip.x) * (you.x - pip.x) +
                               (you.y - pip.y) * (you.y - pip.y))
            If apart < 1.0 Then fault = "you and Pip landed on one spot"
        End If
        If fault == Null
            fault = Fault(game, island)
            If fault != Null Then Print("{game.Story().Clock()}: {fault}")
        End If
        stepped(game, doing)
    End While
    Try walker.Stop()
    stepped(game, "ended")
    Checks("it stood as the flow says, all along", fault == Null)
    // Heard on for 3 seconds past the end, as the game goes on, so Pip says how it feels.
    For step = 1 To 30
        Flip(False)
        game.Step(controls, 0.1)
        scape.Update(game, 0.1)
        loudest = Max(loudest, PeakOf(Audio.Mix(4410)))
        steps += 1
    End For
    Heard(scape, game.Story(), loudest)
    Flip(False)
    Checks("you hear from where you see", IsClose(Listener.Position(), game.View().Position(), 1.0))
    Checks("its mix went at the pace of the game",
           Audio.Frames() - mixedFrom == (steps As Int64) * 4410)
    // As do the bodies, six steps a tenth of a second, however fast the flow's clock went as it waited.
    Checks("the bodies stepped by real time all along",
           island.Bodies().Steps() - bodiesFrom == (steps As Int64) * 6)
    // Once it's ended, nothing more can happen, nor is anything offered, though the wheel goes round.
    Local said = lines.Count
    Local ended = game.Story().Ended()
    Local lampWas = island.LampMaterial()
    Local wheelWas = island.WheelTurned()
    Local beamWas = island.Marks().BeamTurned()
    Local stepsWas = island.Bodies().Steps()
    Try Simulate.PressKey(Key.E)
    Try Simulate.PressKey(Key.Q)
    Flip(False)
    game.Step(controls, 0.1)
    // The lighthouse's lamp turns by the tenth of a second that passed, whatever the flow's clock did.
    Checks("the lighthouse's lamp turns by real time",
           Abs(island.Marks().BeamTurned() - beamWas - BEAM_TURN * 0.1) < 0.0001)
    // And so do the bodies: six steps of a 60th of a second for that tenth.
    Checks("the bodies step by real time", island.Bodies().Steps() - stepsWas == 6)
    Checks("nothing's done after the end", lines.Count == said && game.Story().Ended() == ended)
    Checks("nothing's offered after the end", game.Prompt() == "")
    Checks("the lamp isn't lit again each step", island.LampMaterial() == lampWas)
    Checks("the wheel turns only if it was mended",
           (WheelSpeed(ended) > 0.0) == (island.WheelTurned() != wheelWas))
    // Walking out of the mill, after the end, is hearing outside.
    If InMill(game.Location().x, game.Location().y)
        Local door = DoorSpot()
        Try WalkedTo(game, controls, door.x, door.y + 3.0, 100)
        For step = 1 To 10
            Flip(False)
            game.Step(controls, 0.1)
            scape.Update(game, 0.1)
        End For
        Checks("out of the door, after the end, it's not muffled",
               scape.OutsideNow() == OutsideCutoff(False))
        Checks("nor quieter",
               IsClose(scape.SeaNow(), SeaLevel(game.Story().Clock(), False), 0.001) &&
               IsClose(scape.SurfNow(), SurfLevel(game.Story().Clock(), False), 0.001))
    End If
    Return ended
End Function

// The largest of `samples`, either way.
Function PeakOf(samples: Float[]): Float
    Local peak = 0.0
    For sample In samples
        peak = Max(peak, Abs(sample))
    End For
    Return peak
End Function

// How loud `samples` are, on average.
Function RmsOf(samples: Float[]): Float
    Local sum = 0.0
    For sample In samples
        sum += sample * sample
    End For
    Return Sqrt(sum / Max(samples.Count As Float, 1.0))
End Function

// How much `samples` change, from a sample to the next on the same channel, on average: how much of
// their highs there are.
Function HighsOf(samples: Float[]): Float
    Local sum = 0.0
    For at = 2 Until samples.Count
        Local step = samples[at] - samples[at - 2]
        sum += step * step
    End For
    Return Sqrt(sum / Max(samples.Count As Float, 1.0))
End Function

// Whether what a walk heard is what it should be: the wind, sea, and surf all along, your feet on each
// surface, the flood, the mill's parts and sluice; the wheel and works by how it ended; and a mix
// that's not silent, and doesn't clip.
Function Heard(scape: Soundscape, flow: Flow, loudest: Float)
    Checks("the wind, sea, and surf are streamed, and playing", scape.AroundYou())
    Checks("the music's streamed, and playing", scape.MusicPlaying())
    // By the end the storm's in: its theme, and none of the calm's.
    Local levels = MusicLevels(flow.Clock(), False)
    Checks("the music's at its levels by the weather and tide",
           IsClose(scape.MusicNow().0, levels.0, 0.0001) &&
           IsClose(scape.MusicNow().1, levels.1, 0.0001))
    // The storm's in by the end: the wind's whistling, at its pitch.
    Checks("the wind's pitched by the storm",
           IsClose(scape.WindPitchNow(), WindPitch(flow.Clock()), 0.001) &&
           scape.WindPitchNow() > 1.0)
    // On rock, sand, the trodden ground from the door to the road, and the mill's boards, each a walk
    // crosses.
    Checks("your steps are heard on rock, sand, turf, and boards",
           scape.Played(Cue.STEP_1) + scape.Played(Cue.STEP_2) + scape.Played(Cue.STEP_3) > 0 &&
           scape.Played(Cue.SAND_1) + scape.Played(Cue.SAND_2) > 0 &&
           scape.Played(Cue.TURF_1) + scape.Played(Cue.TURF_2) > 0 &&
           scape.Played(Cue.FLOOR_1) + scape.Played(Cue.FLOOR_2) > 0)
    Checks("there's a sound for each cue", scape.CueCount() == CUES)
    // Pip: a hello each time it's said to catch up with you, worried at the flood, and glad or sad by
    // how it ended.
    Checks("Pip says hello as it catches up, and is worried at the flood",
           scape.Played(Cue.PIP_HELLO) == flow.CaughtUp() && flow.CaughtUp() > 0 &&
           scape.Played(Cue.PIP_WORRIES) == (flow.Flooded() ? 1 : 0))
    Checks("Pip's glad or sad, as it ended",
           scape.Played(Cue.PIP_GLAD) == (flow.Ended() == Ending.BRIGHT ? 1 : 0) &&
           scape.Played(Cue.PIP_SAD) == (flow.Ended() == Ending.BRIGHT ? 0 : 1))
    Checks("the flood splashes, once", scape.Played(Cue.SPLASH) == 1)
    // A clank for each part fitted, and the sluice once, as how it ended says.
    Local fitted = 0
    For part In [Part.GEAR, Part.PADDLE, Part.BELT]
        If flow.Fitted(part) Then fitted += 1
    End For
    Checks("each part fitted's heard, and the sluice if it opened",
           scape.Played(Cue.FIT) == fitted &&
           scape.Played(Cue.SLUICE) == (flow.SluiceOpen() ? 1 : 0))
    Checks("the works run at the wheel's speed",
           IsClose(scape.WorksPitch(), WheelSpeed(flow.Ended()), 0.001))
    Checks("the wheel's pitch is its speed",
           IsClose(scape.WheelPitch(), WheelSpeed(flow.Ended()), 0.001))
    Print("its loudest was {loudest}")
    Checks("the mix isn't silent, and doesn't clip", loudest > 0.05 && loudest < 1.0)
End Function

// Hears what's in the mix by itself, offscreen: each cue in its band, with the wind and sea at
// nothing; that an emitter's fainter from further, and to its side; that nothing's left playing; that
// what's outside is muffled from inside, with no click at the door; and the gulls over the wind.
Function Listened() Throws GraphicsError, IOError, AudioError
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Local game = Game(island, Function(line: String)
    End Function)
    Defer game.Free()
    Try StartAudio(AudioDevice.MANUAL, 44100)
    Defer Audio.Stop()
    Local scape = Try Soundscape.Make(game, island)
    Defer scape.Free()
    Listener.Unfollow()
    Local rate = 44100
    // A settled bed's what's left to measure against: the first second's what it opens with.
    Local door = DoorSpot()
    Listener.SetPosition(Vec3(door.x, 5.0, door.y))
    Audio.Mix(rate)
    Local bed = RmsOf(Audio.Mix(rate))
    Checks("the wind and sea are heard at slack water", bed > 0.005)
    // The surf by itself, over a whole wave each: at its level, and louder with the storm in and its
    // roar than at slack water, by more than the wind and sea alone could make it.
    scape.SetWindAndSea(0.0)
    Local slackSurf = WaveOf(scape, 0.0, rate)
    Local stormSurf = WaveOf(scape, TIDE_IN_AT, rate)
    Checks("the surf's at its level, with the storm in",
           IsClose(scape.SurfNow(), SurfLevel(TIDE_IN_AT, False), 0.0001))
    Checks("the surf by itself is louder with the storm in", stormSurf > 2.0 * slackSurf)
    scape.SetWindAndSea(1.0)
    scape.Surroundings(0.0, False, 1.0)
    Audio.Mix(rate)
    // A gull, off over the water, over them.
    Local gullOver = 0
    For call = 1 To 6
        scape.Play(Cue.GULL, door)
        If PeakOf(Audio.Mix(rate)) > 1.5 * bed Then gullOver += 1
    End For
    Checks("a gull's heard over them", gullOver >= 3)
    scape.SetBeds(0.0)
    Audio.Mix(rate)
    Audio.Mix(rate)
    // The music by itself: ducked under a gull and back, and turning to the storm's theme with no click.
    scape.SetMusic(1.0)
    Listener.SetPosition(Vec3(door.x, 5.0, door.y))
    // Long enough after the gulls above to have come back from under them: a second after the last
    // ends, and 0.8 s up.
    For step = 1 To 300
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Checks("the music's whole at slack water", IsClose(scape.MusicBusNow(), 1.0, 0.0001))
    scape.Play(Cue.GULL, door)
    For step = 1 To 30
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Checks("the music ducks under a gull", IsClose(scape.MusicBusNow(), 0.5, 0.0001))
    For step = 1 To 150
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Checks("and comes back after", IsClose(scape.MusicBusNow(), 1.0, 0.0001))
    // The weather and tide from slack water to the tide in, over a whole loop, 16 seconds, against a
    // whole loop of each theme held still: no step through the crossfade larger than the two still
    // themes' added, which a crossfade of the two can come to.
    Local stillStep = 0.0
    For step = 1 To 960
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        stillStep = Max(stillStep, LargestStep(Audio.Mix(735)))
    End For
    Local turningStep = 0.0
    For step = 1 To 960
        scape.Surroundings(TIDE_IN_AT * (step As Float64) / 960.0, False, 1.0 / 60.0)
        turningStep = Max(turningStep, LargestStep(Audio.Mix(735)))
    End For
    Local stormStep = 0.0
    For step = 1 To 960
        scape.Surroundings(TIDE_IN_AT, False, 1.0 / 60.0)
        stormStep = Max(stormStep, LargestStep(Audio.Mix(735)))
    End For
    Print("the music's largest step, calm {stillStep}, storm {stormStep}, turning {turningStep}")
    Checks("the music turns to the storm's with no click",
           !Clicks(turningStep, stillStep + stormStep))
    Checks("the storm's theme is all of it, once the tide's in",
           scape.MusicNow().0 < 0.0001 &&
           IsClose(scape.MusicNow().1, MusicLevels(TIDE_IN_AT, False).1, 0.0001))
    // Quieter inside.
    For step = 1 To 60
        scape.Surroundings(TIDE_IN_AT, True, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Checks("the music's quieter inside", IsClose(scape.MusicBusNow(), 0.7, 0.0001))
    For step = 1 To 60
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    scape.SetMusic(0.0)
    For step = 1 To 6
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Audio.Mix(rate)
    Checks("with the beds at nothing, it's silent", PeakOf(Audio.Mix(1024)) < 0.0005)
    // The mill's room: what's in it is on its bus, whose ring's heard; your steps ring there, after
    // they've ended, and not outside; and it's muffled from out, as the outside is from in.
    Checks("the audio's stereo, as StartAudio starts it", Audio.Channels() == 2)
    Checks("what's in the mill is in its room, which rings, and your steps in it",
           scape.MillOnItsBus())
    For step = 1 To 60
        scape.Surroundings(0.0, True, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    scape.Play(Cue.FLOOR_1, door)
    Audio.Mix(rate / 5)
    Local ringing = RmsOf(Audio.Mix(rate * 2 / 5))
    For step = 1 To 60
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Audio.Mix(rate)
    scape.Play(Cue.FLOOR_1, door)
    Audio.Mix(rate / 5)
    Local dry = RmsOf(Audio.Mix(rate * 2 / 5))
    Print("a step's ring, inside {ringing}, and out {dry}")
    Checks("your steps ring in the mill, and not outside", ringing > 0.0005 && ringing > 10.0 * dry)
    Checks("the mill's muffled from outside", scape.MillNow() == OutsideCutoff(True))
    // A creak at the mill, from beside it, outside and in: from outside, its highs are 10 times less.
    Local atWorks = scape.MillAt()
    Listener.SetPosition(Vec3(atWorks.x, atWorks.y, atWorks.z + 1.0))
    Local creakFrom = Function(inside: Bool): Float
        For step = 1 To 60
            scape.Surroundings(0.0, inside, 1.0 / 60.0)
            Audio.Mix(735)
        End For
        Audio.Mix(rate)
        scape.Play(Cue.CREAK, door)
        Return HighBandOf(Audio.Mix(rate * 3 / 5), rate)
    End Function
    Local creakOutside = creakFrom(False)
    Local creakInside = creakFrom(True)
    Print("a creak's highs, from outside {creakOutside}, and in {creakInside}")
    Checks("a creak's muffled from outside, by what's heard", creakInside > 10.0 * creakOutside)
    // Item 1: the first step in is as bright as one long in, within 3 dB above 1 kHz.
    For step = 1 To 60
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Audio.Mix(rate)
    scape.Surroundings(0.0, True, 1.0 / 60.0)
    scape.Play(Cue.FLOOR_1, door)
    Local firstIn = HighBandOf(Audio.Mix(rate / 5), rate)
    For step = 1 To 120
        scape.Surroundings(0.0, True, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Audio.Mix(rate)
    scape.Play(Cue.FLOOR_1, door)
    Local longIn = HighBandOf(Audio.Mix(rate / 5), rate)
    Print("a step's highs, the first frame in {firstIn}, and long in {longIn}")
    Checks("the first step in is as bright as the rest",
           firstIn > 0.708 * longIn && firstIn < 1.413 * longIn)
    For step = 1 To 60
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Audio.Mix(rate)
    // Each cue, by itself, in its band, from nearby: the splash on the road, from outside, and the
    // rest at the mill's works, from inside it, where they are.
    Local mill = scape.MillAt()
    Local road = scape.SplashAt()
    For cue In [Cue.STEP_1, Cue.STEP_2, Cue.STEP_3, Cue.FLOOR_1, Cue.FLOOR_2, Cue.WADE_1,
                Cue.WADE_2, Cue.SAND_1, Cue.SAND_2, Cue.TURF_1, Cue.TURF_2,
                Cue.CREAK, Cue.SPLASH, Cue.FIT, Cue.SLUICE, Cue.PIP_HELLO, Cue.PIP_TAKES,
                Cue.PIP_GIVES, Cue.PIP_WORRIES, Cue.PIP_GLAD, Cue.PIP_SAD]
        Local near = cue == Cue.SPLASH ? road : IsPip(cue) ? scape.PipAt() : mill
        Listener.SetPosition(Vec3(near.x, near.y, near.z + 1.0))
        // From inside for what's in the mill, Pip's voice too while it's there, as it is to start.
        Local fromInside = IsPip(cue) ? scape.PipInMill() : cue != Cue.SPLASH
        For step = 1 To 30
            scape.Surroundings(0.0, fromInside, 1.0 / 60.0)
            Audio.Mix(735)
        End For
        scape.Play(cue, door)
        // The sluice's rush, of 2.2 s, all of it.
        Local peak = PeakOf(Audio.Mix(cue == Cue.SLUICE ? rate * 3 : rate))
        Print("cue {cue As Int} peaks at {peak}")
        Checks("cue {cue As Int} reaches the mix", peak > 0.05 && peak < 0.5)
    End For
    // A gull, out over the water, heard from where you stand, outside.
    Listener.SetPosition(Vec3(door.x, 5.0, door.y))
    For step = 1 To 60
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    scape.Play(Cue.GULL, door)
    Local gullPeak = PeakOf(Audio.Mix(rate))
    Print("a gull peaks at {gullPeak}")
    Checks("a gull reaches the mix", gullPeak > 0.01 && gullPeak < 0.5)
    Checks("what's outside is on its buses, under the options' levels", scape.OutsideOnItsBus())
    // Each of the options' levels at 0 silences its own, and only that; Master, all of it.
    Local heardAt = Function(slider: Mix): (Float, Float, Float)
        For mix In [Mix.MASTER, Mix.MUSIC, Mix.AMBIENCE, Mix.EFFECTS]
            scape.SetLevel(mix, mix == slider ? 0.0 : 1.0)
        End For
        Return Heard3(scape, door, rate)
    End Function
    Local all = Heard3(scape, door, rate)
    Checks("with every level up, music, beds, and effects are heard",
           all.0 > 0.0005 && all.1 > 0.0005 && all.2 > 0.01)
    For slider In [Mix.MUSIC, Mix.AMBIENCE, Mix.EFFECTS]
        Local heard = heardAt(slider)
        Local silent = slider == Mix.MUSIC ? heard.0 : slider == Mix.AMBIENCE ? heard.1 : heard.2
        Local rest = slider == Mix.MUSIC ? heard.1 + heard.2 : slider == Mix.AMBIENCE ? heard.0 + heard.2 : heard.0 + heard.1
        Print("{slider} at 0: music {heard.0}, beds {heard.1}, a gull {heard.2}")
        // Silent is 60 dB under what's still heard, as the mill's ring from a while ago is still there.
        Checks("{slider} at 0 silences it, and only it", silent < 0.001 * rest && rest > 0.001)
    End For
    Local mastered = heardAt(Mix.MASTER)
    Checks("Master at 0 silences everything", mastered.0 + mastered.1 + mastered.2 < 0.00001)
    For mix In [Mix.MASTER, Mix.MUSIC, Mix.AMBIENCE, Mix.EFFECTS]
        scape.SetLevel(mix, 1.0)
        Checks("{mix}'s level is what was set", scape.Level(mix) == 1.0)
    End For
    Local works = island.PlaceOf(Spot.WORKS)
    Checks("a creak's at the mill's works",
           IsClose(mill.x, works.x, 0.01) && IsClose(mill.z, works.y, 0.01))
    // Fainter from further.
    Listener.SetPosition(Vec3(mill.x, mill.y, mill.z + 5.0))
    scape.Play(Cue.CREAK, door)
    Local nearPeak = PeakOf(Audio.Mix(rate))
    Listener.SetPosition(Vec3(mill.x, mill.y, mill.z + 50.0))
    scape.Play(Cue.CREAK, door)
    Local farPeak = PeakOf(Audio.Mix(rate))
    Checks("a creak's fainter from further", nearPeak > 2.0 * farPeak && farPeak >= 0.0)
    // And to its side.
    Listener.SetPosition(Vec3(mill.x - 6.0, mill.y, mill.z))
    scape.Play(Cue.CREAK, door)
    Local mixed = Audio.Mix(rate)
    Local leftPeak = 0.0
    Local rightPeak = 0.0
    For at = 0 Until mixed.Count / 2
        leftPeak = Max(leftPeak, Abs(mixed[at * 2]))
        rightPeak = Max(rightPeak, Abs(mixed[at * 2 + 1]))
    End For
    Checks("a creak to your right's on your right", rightPeak > 1.5 * leftPeak)
    // Nothing's left playing, some seconds after: nothing's looping that shouldn't.
    For second = 1 To 3
        Audio.Mix(rate)
    End For
    Checks("only the beds and the music play on", Audio.Playing() == 5)
    // The wheel's where it's drawn, and heard outside.
    Local wheel = scape.WheelAt()
    Local drawn = island.WheelAt()
    Checks("the wheel's heard where it's drawn", IsClose(wheel, drawn, 0.001))
    // Muffled from inside, on the bus: quieter, and with far less of its highs.
    scape.SetBeds(1.0)
    Listener.SetPosition(Vec3(door.x, 5.0, door.y))
    For step = 1 To 60
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    // Over a whole wave of the surf, which breaks each 4 seconds, so it's each at its average.
    Local outsideMix = Audio.Mix(rate * 4)
    For step = 1 To 60
        scape.Surroundings(0.0, True, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Local insideMix = Audio.Mix(rate * 4)
    Local lower = 20.0 * Log10((RmsOf(outsideMix) / Max(RmsOf(insideMix), 0.00001)) As Float64)
    Print("from inside, it's {lower} dB lower")
    Checks("from inside, it's at least 6 dB lower", lower >= 6.0)
    Checks("and has less of its highs", HighsOf(outsideMix) > 2.0 * HighsOf(insideMix))
    // A splash goes through it too.
    scape.SetBeds(0.0)
    For step = 1 To 60
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Listener.SetPosition(Vec3(road.x, road.y, road.z + 1.0))
    scape.Play(Cue.SPLASH, door)
    Local openSplash = HighsOf(Audio.Mix(rate))
    For step = 1 To 60
        scape.Surroundings(0.0, True, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    scape.Play(Cue.SPLASH, door)
    Checks("the splash is muffled from inside", openSplash > 2.0 * HighsOf(Audio.Mix(rate)))
    // Through the door and back, a frame at a time, with no click: no sample's step stands out, over the
    // wind and sea, with the surf's crashes at nothing, as they'd hide one.
    scape.SetBeds(1.0)
    scape.SetSurf(0.0)
    For step = 1 To 60
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    // Over 8 seconds, long enough that the beds' own largest step is found, as a shorter while can miss it.
    Local largestBefore = 0.0
    For step = 1 To 480
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        largestBefore = Max(largestBefore, LargestStep(Audio.Mix(735)))
    End For
    Local largestDuring = 0.0
    For flip In [True, False, True, False]
        For step = 1 To 30
            scape.Surroundings(0.0, flip, 1.0 / 60.0)
            largestDuring = Max(largestDuring, LargestStep(Audio.Mix(735)))
        End For
    End For
    Print("the largest step's {largestBefore}, and {largestDuring} through the door")
    Checks("the door doesn't click", !Clicks(largestDuring, largestBefore))
    Checks("a click of 1.4 times the largest step would",
           Clicks(1.4 * largestBefore, largestBefore))
    scape.SetSurf(1.0)
End Function

// Whether the PNGs of each view in `one` are close to the same in `other`, by their PSNR, in decibels.
Function AlikeViews(one: Path, other: Path, floor: Float) Throws IOError
    For name In ["island", "island_high_tide", "yard", "pip", "mill_inside"]
        Local first = Try Png.Decode(Try File.ReadBytes(one / "{name}.png"))
        Local second = Try Png.Decode(Try File.ReadBytes(other / "{name}.png"))
        Local psnr = PsnrOf(first, second)
        Print("{name}: {psnr} dB")
        Checks("{name} is alike in both", psnr >= floor)
    End For
End Function

// How loud what's above 1 kHz is, of stereo `samples`' left, at `rate`: through four one-pole
// high-passes, 24 dB an octave, so what's an octave or two below hardly counts.
Function HighBandOf(samples: Float[], rate: Int): Float
    Local kept = 1.0 / (1.0 + 6.2831853 * 1000.0 / (rate As Float))
    Local count = samples.Count / 2
    Local band: Float[] = []
    For at = 0 Until count
        band.Add(samples[at * 2])
    End For
    For stage = 1 To 4
        Local out = 0.0
        Local last = 0.0
        For at = 0 Until count
            Local input = band[at]
            out = kept * (out + input - last)
            last = input
            band[at] = out
        End For
    End For
    Local sum = 0.0
    For value In band
        sum += value * value
    End For
    Return Sqrt(sum / Max(count As Float, 1.0))
End Function

// Starts the audio on `device`, at `rate`, or its own for 0, in stereo whatever its output is, as the
// mill's reverb, Freeverb's, can only be heard in stereo, and a surround output would leave it dry.
Function StartAudio(device: AudioDevice, rate: Int32 = 0) Throws AudioError
    Try Audio.Start(device, rate, 2)
End Function

// How loud the music, the beds, and a gull are, each by itself, from the door: the others at nothing.
Function Heard3(scape: Soundscape, door: Vec2, rate: Int): (Float, Float, Float)
    scape.SetMusic(1.0)
    scape.SetBeds(0.0)
    Settle(scape)
    Local music = RmsOf(Audio.Mix(rate))
    scape.SetMusic(0.0)
    scape.SetBeds(1.0)
    Settle(scape)
    Local beds = RmsOf(Audio.Mix(rate))
    scape.SetBeds(0.0)
    Settle(scape)
    scape.Play(Cue.GULL, door)
    Local gull = PeakOf(Audio.Mix(rate))
    Return (music, beds, gull)
End Function

// A second of the soundscape at slack water, outside, so what's been set's heard as it is, and no gull's
// left ringing.
Function Settle(scape: Soundscape)
    For step = 1 To 60
        scape.Surroundings(0.0, False, 1.0 / 60.0)
        Audio.Mix(735)
    End For
    Audio.Mix(44100 * 2)
End Function

// Whether a step of `during` stands out over `before`, the largest there was before it: a click.
Function Clicks(during: Float, before: Float): Bool => during > 1.25 * before

// The surf's loudness over a whole wave, 4 seconds, `clock` seconds in, once it's settled there.
Function WaveOf(scape: Soundscape, clock: Float64, rate: Int): Float
    scape.Surroundings(clock, False, 1.0)
    Audio.Mix(rate)
    Return RmsOf(Audio.Mix(rate * 4))
End Function

// The largest change from a sample to the next on the same channel.
Function LargestStep(samples: Float[]): Float
    Local largest = 0.0
    For at = 2 Until samples.Count
        largest = Max(largest, Abs(samples[at] - samples[at - 2]))
    End For
    Return largest
End Function

// Opens what a walk draws on, offscreen, and the island.
Function Opened(): Island Throws GraphicsError, IOError
    Window.SetHeadless(True)
    Try Graphics(1280, 720)
    Try Res.Mount()
    Return Try Island.Make()
End Function

// A 3D walk, with nothing saved, as ctest runs one to each ending.
Function Walked3dBy(walk: String[], lines: String[]): Ending Throws GraphicsError, IOError,
                                                                    AudioError
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Return Try Walked3d(island, walk, lines, Function(game: Game, doing: String)
    End Function)
End Function

// Whether a color's warm, as brass and oiled wood are, and not gray.
Function IsWarm(pixel: Color32): Bool => (pixel.r As Int) > (pixel.b As Int) + 20

// Whether `with` and `without` differ, by more than a little, in what's drawn at or just beside `place`, as
// the middle of a thin part seen from under it is only its underside.
Function DiffersNear(camera: Camera, with: Image, without: Image, place: Vec3): Bool
    Local at = camera.Project(place)
    Return at != Null && DiffersAround(with, without, at.x As Int, at.y As Int)
End Function

// How bright the mill's ceiling is, as `camera` sees it in `image`, drawn with no lantern, so by nothing
// but the light around: which it can't see, the roof being over it.
Function SkyInCeiling(camera: Camera, image: Image): Float
    Local seen = 0
    Local sum = 0.0
    Local y = GroundHeight(MAIN_X, 0.0) + CEILING - 0.03
    For across = -22 To 22
        For along = -18 To 18
            Local pixel = PixelOf(camera, image,
                                  Vec3(MAIN_X + (across As Float) * 0.25, y,
                                       (along As Float) * 0.25))
            If pixel != Null
                seen += 1
                sum += Luma(pixel)
            End If
        End For
    End For
    Return seen > 0 ? sum / (seen As Float) : 255.0
End Function

// How different the main rock is, from `camera`, in `image`, from itself a repeat of its maps along: the
// mean, in how bright it looks. Near 0, and its pattern shows.
Function RepeatShows(camera: Camera, image: Image): Float
    Local sum = 0.0
    Local count = 0
    For across = -6 To 6
        For along = -6 To 6
            Local x = MAIN_X + (across As Float) * 2.5
            Local z = 12.0 + (along As Float) * 2.5
            Local here = PixelOf(camera, image, Vec3(x, GroundHeight(x, z), z))
            Local there = PixelOf(camera, image,
                                  Vec3(x + GROUND_REPEAT, GroundHeight(x + GROUND_REPEAT, z), z))
            If here != Null && there != Null
                sum += Abs(Luma(here) - Luma(there))
                count += 1
            End If
        End For
    End For
    Return count > 0 ? sum / (count As Float) : 0.0
End Function

// Whether what's drawn at `place`, in view, is brighter by more than `least` with bloom than without.
Function BloomsAt(camera: Camera, bloomed: Image, plain: Image, place: Vec3, least: Int): Bool
    Local with = PixelOf(camera, bloomed, place)
    Local without = PixelOf(camera, plain, place)
    Return with != Null && without != Null && Brightness(with) > Brightness(without) + least
End Function

// How bright a color looks.
// How bright the ceiling's let be by the light around alone, how much the sky's let bloom, and how
// different the ground's let be from itself a repeat along: each between what's drawn and what's not fixed.
Const CEILING_SKY: Float = 12.0
Const SKY_BLOOM: Int = 1
Const GROUND_APART: Float = 10.0
// How far off the ground Pip's lowest point may be, walking.
Const GROUNDED: Float = 0.003
// How much brighter or darker a still may be than the same drawn after itself: the yard after the dark
// mill, with the mill's frame blended in, was 2.5 darker, and afresh, 0.13.
Const AFRESH: Float = 0.8

Function Luma(pixel: Color32): Float
    Return 0.2126 * (pixel.r As Float) + 0.7152 * (pixel.g As Float) + 0.0722 * (pixel.b As Float)
End Function

// How bright a color is, adding its channels.
Function Brightness(pixel: Color32): Int => (pixel.r As Int) + (pixel.g As Int) + (pixel.b As Int)

// The bright 3D walk, saving what you see at each moment that shows something, and looking at what
// was saved: what's in your hand, what's fitted, the wheel, and the lamp, brighter than dim.
Function SaveWalk(folder: Path) Throws GraphicsError, IOError, AudioError
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Local saved = 0
    Local failure = ""
    Local save = Function(game: Game, name: String): Image?
        game.View().SetRenderTarget(Null)
        island.Drawn(game.View())
        Try
            Try Screen.Save(folder / "{name}.png")
            saved += 1
            Return Try Screen.ToImage()
        Catch e As GraphicsError
            failure = e.Message
        Catch e As IOError
            failure = e.Message
        End Try
        Return Null
    End Function
    // Whether it's `part` that's seen: what's drawn without it isn't what's in `image`.
    Local isSeen = Function(game: Game, image: Image?, part: Part, what: String)
        Local thing = island.PartEntity(part)
        thing.Hide()
        island.Drawn(game.View())
        Try
            Local without = Try Screen.ToImage()
            Flip(False)
            Local place = thing.Position(Space.WORLD)
            Checks(what, image != Null && DiffersNear(game.View(), image, without, place) &&
                   !DiffersNear(game.View(), without, without, place))
        Catch e As GraphicsError
            failure = e.Message
        End Try
        thing.Show()
    End Function
    Local holding = False
    Local carrying = False
    Local fitted = False
    Local lines: String[] = []
    Local ended = Try Walked3d(island, Walk3dOf("bright") ?? [], lines,
                               Function(game: Game, doing: String)
        Local flow = game.Story()
        If !holding && flow.Held() != Null
            holding = True
            isSeen(game, save(game, "walk_holding"), Part.GEAR, "the gear's seen in your hand")
        End If
        If !carrying && flow.PipHolds() != Null
            carrying = True
            game.FacePip()
            save(game, "walk_pip_carrying")
        End If
        If !fitted && flow.Fitted(Part.PADDLE)
            fitted = True
            Local works = island.PlaceOf(Spot.WORKS)
            game.Face(works.x, works.y)
            game.Look(-0.1)
            isSeen(game, save(game, "walk_fitting"), Part.PADDLE, "the paddle's seen, fitted")
        End If
        If doing == "ended"
            Checks("the storm's grade is on what you see, at its end",
                   game.View().Grade().Saturation < 1.0)
            // From outside, to see the lamp and the wheel.
            Local view = LitView()
            game.View().SetPosition(view.0)
            game.View().PointAt(view.1)
            Local lit = save(game, "walk_lit")
            Checks("the lit mill's saved", lit != Null)
            If lit != Null
                Local wheel = PixelOf(game.View(), lit, island.WheelAt())
                // In its own shade, from here, so only a little warm.
                Checks("the wheel's seen", wheel != Null && (wheel.r As Int) > (wheel.b As Int) + 4)
                Local lamp = PixelOf(game.View(), lit, island.LampAt())
                island.LightLamp(False)
                island.Drawn(game.View())
                Try
                    Local dim = PixelOf(game.View(), Try Screen.ToImage(), island.LampAt())
                    Checks("the lamp's brighter lit than dim", lamp != Null && dim != Null &&
                           Brightness(lamp) > Brightness(dim))
                    // Its bloom: the sky just beside it's lighter with it than without.
                    island.LightLamp(True)
                    island.Drawn(game.View())
                    Local bloomed = Try Screen.ToImage()
                    game.View().SetBloom(0.0, 1.0)
                    island.Drawn(game.View())
                    Local plain = Try Screen.ToImage()
                    Looked(game.View())
                    // And the sky's past where bloom starts, far from the lamp.
                    Checks("the sky doesn't bloom",
                           Brightness(bloomed[40, 40]) <= Brightness(plain[40, 40]) + SKY_BLOOM)
                    Local core = PixelOf(game.View(), bloomed, island.LampAt())
                    Checks("the lit lamp's warm, not white",
                           core != Null && (core.r As Int) > (core.b As Int) + 30)
                    Checks("and its bloom reaches past it",
                           BloomsAt(game.View(), bloomed, plain,
                                    island.LampAt() + Vec3(0.0, 1.6, 0.0), 1))
                    Checks("the lamp blooms over what's beside it",
                           BloomsAt(game.View(), bloomed, plain,
                                    island.LampAt() + Vec3(0.0, 0.9, 0.0), 3))
                Catch e As GraphicsError
                    failure = e.Message
                End Try
                island.LightLamp(True)
            End If
        End If
    End Function)
    If failure != "" Then Throw IOError(IOErrorKind.OTHER, failure)
    Checks("saved 4 frames of a 3D walk, ended BRIGHT", saved == 4 && ended == Ending.BRIGHT)
End Function

// How many devices the loader shows, or SLACK_WATER_DEVICES says it does, as a test of what's refused
// can't have two; 0 if there's no Vulkan to ask, which each mode says for itself.
Function DevicesShown(): Int
    Local said = Int.Parse(Env.Get("SLACK_WATER_DEVICES") ?? "")
    If said != Null Then Return said
    // Asking starts SDL's video, which headless has to come before, and each of those modes is.
    Window.SetHeadless(True)
    Try
        Return (Try Gpu.Devices()).Count
    Catch e As GraphicsError
        Return 0
    End Try
End Function

// How much a frame of it costs on GPU `device`, at 1920 by 1080, with no window, by the GPU's own
// timestamps, walking the island and looking back at it, as a game does: the median of the frames after
// its first, and its worst. Run as a release, with nothing else on the GPU, it's the number for 60 fps.
Function FrameCost(device: Int32, frames: Int) Throws GraphicsError, IOError, AudioError
    Window.SetHeadless(True)
    // Not on a real GPU unless it's asked for and the loader shows that one alone: on an integrated one,
    // this lost the GPU, over and over, and took the machine with it.
    Local devices = Try Gpu.Devices()
    Local chosen = devices[device]
    If !MayMeasureOn(chosen.Kind == GpuKind.CPU, Env.Get("SLACK_WATER_REAL_GPU"), devices.Count)
        PrintError("--fps is on a real GPU only with SLACK_WATER_REAL_GPU=1, and with it the only device " +
                   "the loader shows, not {chosen} of {devices.Count}")
        Process.Exit(2)
    End If
    Gpu.SetDevice(device)
    Try Graphics(1920, 1080)
    Defer EndGraphics()
    Try Res.Mount()
    Defer Assets.StopWatching()
    Local island = Try Island.Make()
    Defer island.Free()
    Local game = Game(island, Function(line: String)
    End Function)
    Defer game.Free()
    Local camera = game.View()
    Local costs: Float[] = []
    // Its views, each for as many frames, as the tide goes from slack to in: the sea, sun, and storm by the
    // clock, and the lamp lit at the end, seen from outside.
    Local lit = LitView()
    Local views = [(Views()[1].1, Views()[1].2), (Views()[2].1, Views()[2].2),
                   (Views()[3].1, Views()[3].2),
                   (Views()[0].1, Views()[0].2), lit]
    For frame = 1 To frames
        Local clock = ((frame As Float64) / (frames As Float64)) * TIDE_IN_AT
        island.Update(clock)
        camera.SetGrade(StormGrade(StormAt(clock)))
        Local view = views[((frame - 1) * views.Count) / frames]
        camera.SetPosition(view.0)
        camera.PointAt(view.1)
        If view.0 == lit.0 Then island.LightLamp(True)
        Flip(False)
        UpdateWorld(1.0 / 60.0)
        island.Render()
        If frame > 10 Then costs.Add(Gpu.Counters().GpuMilliseconds)
    End For
    Local last = Try Screen.ToImage()
    // What went to the GPU last, whose loss would be unseen until it's waited for: a frame's wait for each
    // that can be going.
    For wait = 1 To 3
        Flip(False)
    End For
    Checks("it went outdoors, by the clock, with the lamp lit",
           Brightness(last[640, 4]) > 200 && island.SeaDrawnAt() > 0.5 && island.LampLit())
    costs.Sort()
    Local median = costs[costs.Count / 2]
    Local worst = costs[costs.Count - 1]
    Local counters = Gpu.Counters()
    Print("{Gpu.Name()}, {Gpu.Kind()}: {median} ms a frame, {worst} at most, at 1920 by 1080; " +
          "{counters.Draws} draws, {counters.Triangles} triangles")
    // What lavapipe says it uses isn't this program's alone.
    If Gpu.Kind() != GpuKind.CPU Then Print("{Gpu.MemoryUsage() / 1048576} MB of the GPU's memory")
    Checks("the GPU's not lost, and its time was read", CostWasRead(Gpu.Lost(), costs[0]))
    If Gpu.Kind() != GpuKind.CPU
        Checks("under 16.6 ms a frame, for 60 fps", worst < 16.6)
    End If
End Function

// One frame of the game for a person, which doesn't go on while the window's not in front.
Function Moved(game: Game, controls: Controls, seconds: Float): Bool
    If !Window.Focused() Then Return False
    game.Step(controls, seconds)
    Return True
End Function

// Crossing the mill's door ahead of Pip, out and in five times, with a second at each side for Pip to
// come up: Pip says hello as often as it's said to catch up, not each time it's beside you again.
Function HelloedAtTheDoor() Throws GraphicsError, IOError, AudioError
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Local caught: String[] = []
    Local game = Game(island, Function(line: String)
        If line.EndsWith("Pip catches up") Then caught.Add(line)
    End Function)
    Defer game.Free()
    Try StartAudio(AudioDevice.MANUAL, 44100)
    Defer Audio.Stop()
    Local scape = Try Soundscape.Make(game, island)
    Defer scape.Free()
    Local controls = Controls()
    Local stepped = Function()
        Flip(False)
        game.Step(controls, 0.1)
        scape.Update(game, 0.1)
        Audio.Mix(4410)
    End Function
    Local door = DoorSpot()
    Local crossed = 0
    // Each step, on the side of the door it's on, the first each way too.
    Local stepsHeard = [0, 0]
    Local wrongSide = 0
    Local stepsPlayed = Function(): Int
        Local count = 0
        For number = 0 Until CUES
            If IsStep(number As Cue) Then count += scape.Played(number As Cue)
        End For
        Return count
    End Function
    Local heardOnItsSide = Function()
        Local before = stepsPlayed()
        stepped()
        If stepsPlayed() > before
            Local inside = InMill(game.Location().x, game.Location().y)
            stepsHeard[inside ? 1 : 0] += 1
            If scape.LastStepInMill() != inside Then wrongSide += 1
        End If
    End Function
    Local ringOpen = True
    Local ringMuffled = True
    For crossing = 1 To 5
        For spot In [Vec2(door.x, door.y + 3.0), MillSpot()]
            Local inside = Try WalkedOnTo(game, spot, heardOnItsSide)
            If inside == InMill(spot.x, spot.y) Then crossed += 1
            For step = 1 To 10
                stepped()
            End For
            If inside Then ringOpen = ringOpen && scape.StepsRingNow() == OutsideCutoff(False)
            If !inside Then ringMuffled = ringMuffled && scape.StepsRingNow() == OutsideCutoff(True)
        End For
    End For
    // And just out of the door and straight back in, five times, Pip left inside: it's beside you
    // again each time, with nothing new to say.
    Local besideAgain = 0
    For crossing = 1 To 5
        Local out = Try WalkedOnTo(game, Vec2(door.x, door.y - 1.0), heardOnItsSide)
        Local wasHere = game.Story().PipHere()
        Local back = Try WalkedOnTo(game, MillSpot(), heardOnItsSide)
        For step = 1 To 10
            stepped()
        End For
        If !out && back && !wasHere && game.Story().PipHere() Then besideAgain += 1
    End For
    Print("just out and back in, Pip's beside you again {besideAgain} times")
    Checks("just out of the door and back, Pip's beside you again", besideAgain > 0)
    Local hellos = scape.Played(Cue.PIP_HELLO)
    Print(
        "across the door {crossed} times, Pip's said to catch up {caught.Count} times, and says " +
        "hello {hellos}")
    Checks("the door's crossed, out and in, five times", crossed == 10)
    Print("steps heard outside {stepsHeard[0]}, inside {stepsHeard[1]}, on the wrong side {wrongSide}")
    Checks("each step's heard on its side of the door, the first each way too",
           wrongSide == 0 && stepsHeard[0] > 0 && stepsHeard[1] > 0)
    Checks("your steps' ring is open inside, and muffled a second out",
           ringOpen && ringMuffled)
    Checks("Pip says hello as often as it's said to catch up", hellos == caught.Count &&
           hellos == game.Story().CaughtUp())
End Function

// Walks you to `spot`, by W, within a meter, at most 100 steps, each `stepped`, and says whether you're
// in the mill.
Function WalkedOnTo(game: Game, spot: Vec2, stepped: Func()): Bool Throws GraphicsError
    Try Simulate.KeyDown(Key.W)
    For step = 1 To 100
        Local here = game.Location()
        If (spot.x - here.x) * (spot.x - here.x) + (spot.y - here.y) * (spot.y - here.y) < 1.0
            Break
        End If
        game.Face(spot.x, spot.y)
        stepped()
    End For
    Try Simulate.KeyUp(Key.W)
    Return InMill(game.Location().x, game.Location().y)
End Function

// Walks you to (`toX`, `toZ`), by W, within a meter, at most `steps` steps.
Function WalkedTo(game: Game, controls: Controls, toX: Float, toZ: Float,
                  steps: Int) Throws GraphicsError
    Try Simulate.KeyDown(Key.W)
    For step = 1 To steps
        Local here = game.Location()
        Local dx = toX - here.x
        Local dz = toZ - here.y
        If dx * dx + dz * dz < 1.0 Then Break
        game.Face(toX, toZ)
        Flip(False)
        game.Step(controls, 0.1)
    End For
    Try Simulate.KeyUp(Key.W)
    Flip(False)
End Function

// Holds `key` down for five steps, and gives how far that went.
Function WentBy(game: Game, controls: Controls, key: Key): Vec2 Throws GraphicsError
    Local from = game.Location()
    Try Simulate.KeyDown(key)
    For step = 1 To 5
        Flip(False)
        game.Step(controls, 0.1)
    End For
    Try Simulate.KeyUp(key)
    Flip(False)
    Local to = game.Location()
    Return Vec2(to.x - from.x, to.y - from.y)
End Function

// How the game feels, a thing at a time, offscreen: its keys, mouse, and gamepad; what E says with
// nothing near; a part in your hand against a wall; the clock when the window's not in front; and a
// second Game on one Island.
Function Felt() Throws GraphicsError, IOError, InputError
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Local controls = Controls()
    Local lines: String[] = []
    Local game = Game(island, Function(line: String)
        lines.Add(line)
    End Function)
    // Pip's head turns to you, and it blinks, as it stands.
    For step = 1 To 41
        Flip(False)
        game.Step(controls, 0.1)
    End For
    Local turned0 = island.PipHeadTurned()
    Checks("Pip's head turns to you", Abs(turned0.y) > 0.1)
    Checks("Pip blinks", island.PipBlink() > 0.5)
    // Facing out of the door, +Z, inside the mill, whose right is -X.
    Local ahead = Try WentBy(game, controls, Key.W)
    Checks("W goes ahead", ahead.y > 1.0 && Abs(ahead.x) < 0.01)
    Local back = Try WentBy(game, controls, Key.S)
    Checks("S goes back", back.y < -1.0 && Abs(back.x) < 0.01)
    Local right = Try WentBy(game, controls, Key.D)
    Checks("D goes right", right.x < -1.0 && Abs(right.y) < 0.01)
    Local left = Try WentBy(game, controls, Key.A)
    Checks("A goes left", left.x > 1.0 && Abs(left.y) < 0.01)
    // The mouse, to the right, turns you right, and down, down, as far as it goes.
    Local yaw = game.Yaw()
    Try Simulate.MouseMotion(100.0, 0.0)
    Flip(False)
    game.Step(controls, 0.1)
    Checks("the mouse going right turns you right", IsClose(game.Yaw(), yaw - 0.3, 0.001))
    Try Simulate.MouseMotion(0.0, 10000.0)
    Flip(False)
    game.Step(controls, 0.1)
    Checks("the mouse going down looks down, as far as it goes", IsClose(game.Pitch(), -1.4, 0.001))
    Try Simulate.MouseMotion(0.0, -20000.0)
    Flip(False)
    game.Step(controls, 0.1)
    Checks("and up, as far as it goes", IsClose(game.Pitch(), 1.4, 0.001))
    game.Look(0.0)
    // A stick turns you by the second, however many steps they are.
    Local pad = Try Simulate.ConnectGamepad()
    pad.SetAxis(GamepadAxis.RIGHT_X, 1.0)
    Flip(False)
    Local turned: Float[] = []
    For rate In [30, 120]
        Local from = game.Yaw()
        For step = 1 To rate
            game.Step(controls, 1.0 / (rate As Float))
        End For
        turned.Add(from - game.Yaw())
    End For
    pad.SetAxis(GamepadAxis.RIGHT_X, 0.0)
    pad.SetAxis(GamepadAxis.RIGHT_Y, -1.0)
    Flip(False)
    game.Step(controls, 0.1)
    Checks("a stick looks up", game.Pitch() > 0.1)
    pad.SetAxis(GamepadAxis.RIGHT_Y, 0.0)
    Flip(False)
    Checks("a stick turns you the same at 30 and at 120 steps a second",
           turned[0] > 1.0 && IsClose(turned[0], turned[1], 0.01))
    // You stand on what's drawn, where it's between its grid's points too.
    Local onDrawn = True
    For step = 0 To 40
        Local x = MAIN_X + 20.0 + (step As Float) * 0.77
        Local z = 3.3 + (step As Float) * 0.13
        Local drawn = island.GroundDrawnAt(x, z)
        If drawn == Null || Abs(island.FloorAt(x, z) - drawn) > 0.0001 Then onDrawn = False
    End For
    Checks("what you stand on is what's drawn", onDrawn)
    // With nothing near, E says so.
    Local door = DoorSpot()
    Try WalkedTo(game, controls, door.x, door.y, 80)
    Try Simulate.PressKey(Key.E)
    Flip(False)
    game.Step(controls, 0.1)
    Checks("at the door, E says there's nothing near",
           lines[lines.Count - 1].EndsWith("there's nothing within reach"))
    // The gear in hand, into a wall, and it's seen this side of it.
    Local gear = GearSpot()
    Try WalkedTo(game, controls, gear.x, gear.y, 100)
    Try Simulate.PressKey(Key.E)
    Flip(False)
    game.Step(controls, 0.1)
    Checks("E takes the gear", game.Story().Held() == Part.GEAR)
    Try WalkedTo(game, controls, door.x, door.y, 100)
    Try WalkedTo(game, controls, MAIN_X, 0.0, 60)
    game.Face(MAIN_X, -100.0)
    Local into = Vec2(0.0, 0.0)
    For push = 1 To 4
        into = Try WentBy(game, controls, Key.W)
    End For
    Checks("the wall stops you", Abs(into.y) < 0.01)
    island.Render()
    Local image = Try Screen.ToImage()
    Local held = PixelOf(game.View(), image, island.PartEntity(Part.GEAR).Position(Space.WORLD))
    Checks("what's in your hand is seen against a wall", held != Null && IsWarm(held))
    // Not in front, the tide waits.
    Try Simulate.BlurWindow()
    Flip(False)
    Local clock = game.Story().Clock()
    Checks("not in front, it doesn't step", !Moved(game, controls, 0.1))
    Checks("and the clock stands still", game.Story().Clock() == clock)
    Try Simulate.FocusWindow()
    Flip(False)
    Checks("in front, it does", Moved(game, controls, 0.1) && game.Story().Clock() > clock)
    // Another Game on it, with the first's gear back where it lay.
    game.Free()
    Local second = Game(island, Function(line: String)
    End Function)
    Checks("another Game begins with every part lying",
           island.PartEntity(Part.GEAR).Parent() == Null)
    Flip(False)
    second.Step(controls, 0.1)
    second.Free()
End Function

// A game being played, and played again: its island, keys, Game, sounds, and what's shown over it.
Final Class Session
    Field island: Island
    Field controls: Controls
    Field game: Game
    Field scape: Soundscape
    Field ending: EndScreen
    // The last thing said, in what its Games say it through.
    Field last: String[]
    Field font: Font
    Field left: Bool = False
    // Whether the mouse is free, to point at the end screen or a menu.
    Field pointing: Bool = False
    // The title, pause, and options, and the HUD.
    Field front: Frontend
    Field hud: Hud
    Field captions: Captions
    // The window its options put, a player's or a test's, or Null for one they leave as it is; and
    // the size it's framed at.
    Field port: WindowLike? = Null
    Field framed: (Int32, Int32)
    // Whether it was paused at the last Step: the game stopped under the menus.
    Field held: Bool = False

    // Whether it's drawn as a low GPU can, whatever its options say.
    Field low: Bool

    New(island: Island, last: String[], game: Game, scape: Soundscape, front: Frontend,
        low: Bool = False)
        Self.island = island
        Self.low = low
        Self.last = last
        controls = Controls()
        Self.game = game
        Self.scape = scape
        Self.front = front
        ending = EndScreen()
        font = Font.BuiltIn(20.0)
        hud = Hud()
        captions = Captions()
        framed = (1280, 720)
    End New

    // One at its first moment, on `island`, with the audio started, being played, or `atTitle`, with
    // the options kept in `file`, or the defaults for Null, drawn as a `low` GPU can, if it's one.
    @MainThread
    Static Method Make(island: Island, file: Path? = Null, atTitle: Bool = False,
                       low: Bool = False): Session Throws IOError, InputError
        Local front = Frontend(file)
        If !atTitle Then front.Open(Page.PLAYING)
        Try SetMouseRelative(!atTitle)
        Local last = [""]
        Local game = Game(island, Function(line: String)
            last[0] = line
        End Function, low)
        Local made = Session(island, last, game, Try Soundscape.Make(game, island), front,
                             low)
        made.pointing = atTitle
        made.Applied()
        Return made
    End Method

    // What the options say, put into what they're of: the volumes, the look, the picture, and, in a
    // player's window, the window.
    @MainThread
    Method Applied()
        Local options = front.Current()
        // Paused, the effects stop, and the music and the wind and sea go on, quieter.
        Local quieter = held ? PAUSED_LEVEL : 1.0
        scape.SetLevel(Mix.MASTER, options.Master)
        scape.SetLevel(Mix.MUSIC, options.Music * quieter)
        scape.SetLevel(Mix.AMBIENCE, options.Ambience * quieter)
        scape.SetLevel(Mix.EFFECTS, held ? 0.0 : options.Effects)
        controls = Controls(options.Keys)
        controls.SetLook(options.Look, options.InvertY)
        hud.SetScale(options.TextScale())
        captions.SetScale(options.TextScale())
        ending.SetScale(options.TextScale())
        game.SetMotion(!options.ReducedMotion)
        game.SetHold(options.HoldToOpen)
        Pictured(island, game.View(), low ? Quality.LOW : options.Picture)
    End Method

    // Puts the window as `choice` says, if it's one its options put.
    @MainThread
    Method Put(choice: WindowChoice)
        Local window = port
        If window == Null Then Return
        Try
            Try Switched(window, choice, framed)
        Catch e As GraphicsError
            PrintError("the window can't be {choice.Name()}: {e.Message}")
        End Try
    End Method

    // Gives it `window` to put, at the choice its options say, framed at the size it is now.
    @MainThread
    Method Windowing(window: WindowLike, display: Display?)
        port = window
        If window.Mode() == WindowMode.WINDOWED Then framed = (window.Width(), window.Height())
        Local choice = front.SetModes(display)
        If choice.Shown != window.Mode() || choice.Shown == WindowMode.FULLSCREEN Then Put(choice)
    End Method

    // A game at its first moment, in place of the one there was.
    @MainThread
    Method Fresh() Throws IOError
        scape.Free()
        game.Free()
        Local said = last
        said[0] = ""
        game = Game(island, Function(line: String)
            said[0] = line
        End Function, low)
        scape = Try Soundscape.Make(game, island)
        Applied()
        Local heard = scape
        captions.Reset(Function(cue: Cue) => heard.Played(cue))
        ending.Update(game.Story(), 0.0)
    End Method

    // Moves it all on `seconds`, whether the window's in front or not. With the end screen shown, the
    // mouse and keys are its, not the game's. It plays again if that's been chosen.
    @MainThread
    Method Step(seconds: Float) Throws IOError, InputError
        front.Update(ending.Showing(), seconds)
        If front.QuitChosen() Then left = True
        If front.LeaveChosen() Then Try Fresh()
        Local asked = front.WindowAsked()
        If asked != Null Then Put(asked)
        Local page = front.Showing()
        Local holding = page != Page.PLAYING && front.OverGame()
        If front.OptionsChanged() || holding != held
            held = holding
            Applied()
        End If
        controls.Set.SetEnabled(page == Page.PLAYING && !ending.Showing())
        If page == Page.TITLE
            front.Fly(game.View(), seconds)
            scape.Update(game, 0.0)
        ElseIf page == Page.PLAYING
            scape.Update(game, Moved(game, controls, seconds) ? seconds : 0.0)
            Local heard = scape
            captions.Update(Function(cue: Cue) => heard.Played(cue), game.Story().Clock(), seconds)
            ending.Update(game.Story(), seconds)
            If ending.LeaveChosen() Then left = True
            If ending.AgainChosen() Then Try Fresh()
        Else
            scape.Update(game, 0.0)
        End If
        Local free = page != Page.PLAYING || ending.Showing()
        If free != pointing
            pointing = free
            Try SetMouseRelative(!pointing)
        End If
    End Method

    // Draws what it says over what's drawn.
    @MainThread
    Method Draw()
        Local options = front.Current()
        If front.OverGame()
            hud.Draw(game.Story().ClockLine(), options.Subtitles ? Untimed(last[0]) : "",
                     ending.Showing() ? "" : game.Prompt(), front.Device(), game.Opening())
            If options.SoundCaptions Then captions.Draw()
        End If
        ending.Draw()
        front.Draw()
    End Method

    @MainThread
    Method Free()
        scape.Free()
        game.Free()
    End Method
End Class

// How loud the music and the wind and sea are, paused, of what they'd be.
Const PAUSED_LEVEL: Float = 0.5

// Sets what `camera` and `island` spend on the picture for `quality`: everything, or, low, no bloom
// and no sun's shadows.
@MainThread
Function Pictured(island: Island, camera: Camera, quality: Quality)
    Local low = quality == Quality.LOW
    Looked(camera, low)
    If low Then camera.SetBloom(0.0, 1.0)
    island.SetSunShadows(!low)
End Function

// The display the window's on, for its modes, or Null with none, as offscreen.
@MainThread
Function FirstDisplay(): Display?
    Try
        Local all = Try Displays()
        Return all.Count > 0 ? all[0] : Null
    Catch e As GraphicsError
        Return Null
    End Try
End Function

// Steps `session` on `steps` tenths of a second, offscreen, mixing what it plays.
Function Stepped(session: Session, steps: Int) Throws IOError, InputError
    For step = 1 To steps
        Flip(False)
        Try session.Step(0.1)
        Audio.Mix(4410)
    End For
End Function

// Walks `session` to how `walk` ends, by its keys.
Function WalkedToEnd(session: Session, walk: String[]) Throws GraphicsError, IOError, InputError
    Local walker = Walker(walk)
    While session.game.Story().Ended() == Ending.NONE
        Try walker.Next(session.game, session.island)
        Try Stepped(session, 1)
    End While
    Try walker.Stop()
End Function

// Steps `session` on until playing again has happened, and says so, whose step it gives no more than.
Function SteppedToAgain(session: Session, ended: Flow): Bool Throws IOError, InputError
    For step = 1 To 5
        Try Stepped(session, 1)
        If session.game.Story() != ended Then Return True
    End For
    Return False
End Function

// That the end's as it should be for how `said` says it ended, and that playing again, by the key on
// what's focused, begins again from a world as it was at `wheelAtFirst`.
Function EndAndAgain(session: Session, said: String, wheelAtFirst: Quat) Throws GraphicsError,
                                                                                IOError,
                                                                                InputError
    Local island = session.island
    Local flow = session.game.Story()
    Checks("nothing's shown just after it ends", !session.ending.Showing())
    // The wind's beat goes on in real seconds after the end, as it did before it.
    Local beat = island.Grown().Phase()
    Try Stepped(session, 10)
    Local went = island.Grown().Phase() - beat
    Checks("after the end, the wind's beat goes on in real seconds",
           Abs((went < 0.0 ? went + (BEAT As Float64) : went) - 1.0) < 0.05)
    Try Stepped(session, 35)
    Checks("it's shown after a while", session.ending.Showing())
    Checks("it says how it ended: {said}", session.ending.Says() == said)
    Checks("the mouse is free to point at it", !MouseRelative())
    // The mouse and keys are its: you don't turn, or walk.
    Local yaw = session.game.Yaw()
    Local at = session.game.Location()
    Try Simulate.MouseMotion(200.0, 50.0)
    Try Simulate.KeyDown(Key.W)
    Try Stepped(session, 5)
    Try Simulate.KeyUp(Key.W)
    Try Stepped(session, 1)
    Checks("under it, the mouse doesn't turn you", session.game.Yaw() == yaw)
    Checks("nor do keys walk you", session.game.Location() == at)
    // The player's levels, set in the options, and kept as it begins again.
    Local scapeWas = session.scape
    Checks("its levels the player's", session.scape.Level(Mix.MUSIC) == 0.25 &&
           session.scape.Level(Mix.EFFECTS) == 0.5)
    // E, with it: not a key the new game hears.
    Try Simulate.PressKey(Key.E)
    Try Simulate.PressKey(Key.SPACE)
    Checks("playing again begins again", Try SteppedToAgain(session, flow))
    Checks("with the player's levels as they set them",
           session.scape != scapeWas && session.scape.Level(Mix.MASTER) == 1.0 &&
           session.scape.Level(Mix.MUSIC) == 0.25 && session.scape.Level(Mix.AMBIENCE) == 1.0 &&
           session.scape.Level(Mix.EFFECTS) == 0.5)
    Checks("the sea's back as soon as it does", island.SeaDrawnAt() == SeaHeight(0.0))
    Checks("and the mouse is the game's", MouseRelative())
    Try Stepped(session, 1)
    Checks("and hears nothing of the end's keys", session.last[0] == "")
    Local fresh = session.game.Story()
    Checks("from its first moment", fresh.Ended() == Ending.NONE && fresh.Clock() < 1.0)
    Checks("and the end's gone", !session.ending.Showing())
    Checks("with its wheel still", session.scape.WheelPitch() == 0.0)
    Checks("as it was drawn at first", island.WheelTurned() == wheelAtFirst)
    Checks("its lamp as it was", !island.LampLit() && island.LampAsUnlit())
    Checks("every part lying", island.PartEntity(Part.GEAR).Parent() == Null &&
           !island.PartEntity(Part.BELT).Hidden())
End Function

// The end screen, a thing at a time, offscreen: not shown until it's been a little while; what it says,
// walked to each ending; what it looks like, in `folder`; playing again from each; then leaving, by
// the keyboard, the mouse, and a gamepad.
Function EndShown(folder: Path) Throws GraphicsError, IOError, AudioError, InputError
    Try Dir.CreateAll(folder)
    Local kept = Try TempDir()
    Local file = kept.Path / "options.ini"
    Local options = Options()
    options.Music = 0.25
    options.Effects = 0.5
    Try KeepOptions(options, file)
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Try StartAudio(AudioDevice.MANUAL, 44100)
    Defer Audio.Stop()
    Local session = Try Session.Make(island, file)
    Defer session.Free()
    Try Simulate.FocusWindow()
    Flip(False)
    Local wheelAtFirst = island.WheelTurned()
    Checks("it starts with the mouse the game's", MouseRelative())
    Try Stepped(session, 5)
    Checks("nothing's shown while it's played", !session.ending.Showing())

    Try WalkedToEnd(session, Walk3dOf("bright") ?? [])
    Checks("walked to its bright ending", session.game.Story().Ended() == Ending.BRIGHT)
    Try EndAndAgain(session, "The lamp burns bright\n" +
                    "All three fitted, and the wheel turning, as the storm comes in.\n" +
                    "3 of 3 parts fitted", wheelAtFirst)
    Try WalkedToEnd(session, Walk3dOf("dim") ?? [])
    Checks("walked to its dim ending", session.game.Story().Ended() == Ending.DIM)
    Try EndAndAgain(session, "The lamp burns, dimmer\n" +
                    "The wheel turns slowly, without its belt, which the sea has.\n" +
                    "2 of 3 parts fitted", wheelAtFirst)

    // Dark, and what it looks like: its panel where it says, with something in it, and nothing else
    // touched.
    session.game.Story().Step(TIDE_IN_AT)
    Checks("it's ended, dark, with nothing done", session.game.Story().Ended() == Ending.DARK)
    Try Stepped(session, 35)
    Checks("dark says so", session.ending.Says() ==
           "The lamp stays dark\nThe tide came in with the sluice shut.\n0 of 3 parts fitted")
    island.Render()
    Local bare = Try Screen.ToImage()
    session.ending.Draw()
    Try Screen.Save(folder / "end_dark.png")
    Local over = Try Screen.ToImage()
    Local box = session.ending.PanelBox()
    Local title = session.ending.TitleBox()
    Local inside = 0
    Local outside = 0
    Local colors = Set<Int>()
    For y = 0 Until over.Height
        For x = 0 Until over.Width
            Local one = over[x, y]
            Local two = bare[x, y]
            Local changed = one.r != two.r || one.g != two.g || one.b != two.b
            Local within = (x As Float) >= box.X - 1.0 && (x As Float) <= box.X + box.Width + 1.0 &&
                           (y As Float) >= box.Y - 1.0 && (y As Float) <= box.Y + box.Height + 1.0
            If changed && within Then inside += 1
            If changed && !within Then outside += 1
            // Its words, where its title's laid out.
            Local inTitle = (x As Float) >= title.X && (x As Float) <= title.X + title.Width &&
                            (y As Float) >= title.Y && (y As Float) <= title.Y + title.Height
            If inTitle
                colors.Add(((one.r As Int) << 16) | ((one.g As Int) << 8) | (one.b As Int))
            End If
        End For
    End For
    Local center = box.Center
    Checks("its panel's in the middle of the screen", Abs(center.x - 640.0) < 40.0 &&
           Abs(center.y - 360.0) < 60.0)
    Checks("it's drawn over its panel", inside > 2000)
    Checks("and nothing outside it", outside == 0)
    Checks("with words in it, not a blank box", colors.Count > 8)

    // Leave, by the mouse.
    Local leaving = session.ending.LeaveAt()
    Try Simulate.MoveMouse(leaving.x, leaving.y)
    Try Simulate.Click(MouseButton.LEFT)
    Try Stepped(session, 2)
    Checks("Leave leaves, by the mouse", session.left)
    session.left = False
    // And by the keyboard's Tab, from Play again.
    session.ending.Focus()
    Try Simulate.PressKey(Key.TAB)
    Try Stepped(session, 1)
    Try Simulate.PressKey(Key.SPACE)
    Try Stepped(session, 2)
    Checks("Leave leaves, by the keyboard", session.left)
    session.left = False
    // Play again, by a gamepad's button on what's focused, Tab having gone to and fro.
    Local pad = Try Simulate.ConnectGamepad()
    Defer pad.Unplug()
    Flip(False)
    session.ending.Focus()
    Local flow = session.game.Story()
    pad.SetButton(GamepadButton.SOUTH, True)
    Try Stepped(session, 2)
    pad.SetButton(GamepadButton.SOUTH, False)
    Try Stepped(session, 2)
    Checks("Play again, by a gamepad", session.game.Story() != flow)
End Function

// A release, from its pak: what's in it is cooked, a walk goes as it should, against what's `kept`, and
// the island's drawn as it should be, in `folder`.
Function CookedWalk(kept: Path, folder: Path) Throws GraphicsError, IOError, AudioError
    Try Res.Mount()
    // A KTX2's signature, what the cooker makes of an image.
    Local first = (Try Assets.ReadBytes(Res.RockAlbedo))[0]
    Print("the rock's first byte is {first}")
    Checks("it's from its pak, cooked", first == 0xAB)
    Assets.StopWatching()
    Local lines: String[] = []
    // Its transcript says how it ended.
    Try Walked3dBy(Walk3dOf("bright") ?? [], lines)
    Try Pinned(lines, kept, False)
    Try Dir.CreateAll(folder)
    Try SaveViews(folder, True)
    Checks("the views from it are saved", File.Exists(folder / "island.png"))
End Function

// The game, in a window, for a person: WASD and the mouse, E, Q, and Escape.
Function Played(low: Bool) Throws GraphicsError, IOError, InputError, AudioError
    // Its files first, so a game missing them says so, with no window.
    Try
        Try Res.Mount()
    Catch e As IOError
        PrintError("Slack Water can't read its files: {e.Message}")
        Process.Exit(1)
    End Try
    Defer Assets.StopWatching()
    Try Graphics(1280, 720)
    Defer EndGraphics()
    Window.SetTitle("Slack Water")
    Frame.SetLimit(60)
    Local island = Try Island.Make()
    Defer island.Free()
    // A machine with no sound still plays it, in silence.
    Local device = AudioDevice.DEFAULT
    Try
        Try StartAudio(device)
    Catch e As AudioError
        PrintError("no sound: {e.Message}")
        Try StartAudio(AudioDevice.SILENT)
    End Try
    Defer Audio.Stop()
    Local session = Try Session.Make(island, OptionsFile(), True, low)
    Defer session.Free()
    session.Windowing(RealWindow(), FirstDisplay())
    Defer session.front.KeepNow()
    While !Window.Closed() && !session.left
        Flip()
        Try session.Step(FrameStep(Frame.Delta()) As Float)
        If Screen.Texture() == Null Then Continue
        island.Render()
        session.Draw()
    End While
End Function

// How many of `image`'s pixels in `box` are near `color`, each channel within 40.
Function NearIn(image: Image, box: Rect, color: Color32): Int
    Local count = 0
    For y = Max(box.Y As Int, 0) Until Min((box.Y + box.Height) As Int, image.Height)
        For x = Max(box.X As Int, 0) Until Min((box.X + box.Width) As Int, image.Width)
            Local one = image[x, y]
            If Abs((one.r As Int) - (color.r As Int)) < 40 &&
               Abs((one.g As Int) - (color.g As Int)) < 40 &&
               Abs((one.b As Int) - (color.b As Int)) < 40
                count += 1
            End If
        End For
    End For
    Return count
End Function

// The box of what's called `name` in the front end, in the screen's pixels, as its UI's units are
// scaled by the text's size.
Function BoxOf(session: Session, name: String): Rect
    Local box = session.front.Find(name)?.Box() ?? Rect(0, 0, 0, 0)
    Local by = session.front.Scale()
    Return Rect(box.X * by, box.Y * by, box.Width * by, box.Height * by)
End Function

// The island drawn with what's over it, saved as `name` in `folder`, and given.
Function Pictured(session: Session, folder: Path, name: String): Image Throws GraphicsError, IOError
    session.island.Scene().Render()
    session.Draw()
    Try Screen.Save(folder / "{name}.png")
    Return Try Screen.ToImage()
End Function

// Presses `key`, a step on each side.
Function Pressed(session: Session, key: Key) Throws GraphicsError, IOError, InputError
    Try Simulate.PressKey(key)
    Try Stepped(session, 1)
End Function

// Presses `button` on `pad`, as a person does.
Function PadPressed(session: Session, pad: VirtualGamepad,
                    button: GamepadButton) Throws GraphicsError, IOError, InputError
    pad.SetButton(button, True)
    Try Stepped(session, 1)
    pad.SetButton(button, False)
    Try Stepped(session, 1)
End Function

// Clicks what's called `name` in the front end.
Function Clicked(session: Session, name: String) Throws GraphicsError, IOError, InputError
    Local at = BoxOf(session, name).Center
    Try Simulate.MoveMouse(at.x, at.y)
    Try Stepped(session, 1)
    Try Simulate.Click(MouseButton.LEFT)
    Try Stepped(session, 2)
End Function

// The title, the pause menu, and Options, a thing at a time, offscreen, by the keyboard, the mouse,
// and a gamepad, with what each looks like saved in `folder`, and the options kept in a folder of
// its own.
Function MenusShown(folder: Path) Throws GraphicsError, IOError, AudioError, InputError
    Try Dir.CreateAll(folder)
    Local kept = Try TempDir()
    Local file = kept.Path / "options.ini"
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local session = Try Session.Make(island, file, True)
    Defer session.Free()
    Try Simulate.FocusWindow()
    Flip(False)

    // The title, over the island, the clock not running, the mouse free.
    Local clock = session.game.Story().Clock()
    Try Stepped(session, 10)
    Local from = session.game.View().Position(Space.WORLD)
    Try Stepped(session, 10)
    Checks("it starts at the title", session.front.Showing() == Page.TITLE)
    Checks("the clock doesn't run there", session.game.Story().Clock() == clock)
    Checks("the mouse is free there", !MouseRelative())
    Local flight = Apart(from, session.game.View().Position(Space.WORLD))
    Checks("its camera flies round the island", flight > 1.0)
    Local title = Try Pictured(session, folder, "title")
    Checks("its name's drawn in brass", NearIn(title, BoxOf(session, "title.name"), BRASS) > 200)
    Checks("with no HUD", NearIn(title, Rect(24, 24, 4, 52), BRASS) < 20)

    // Options, by the keyboard: down to it, Enter, and the master volume down by four steps.
    Try Pressed(session, Key.DOWN)
    Try Pressed(session, Key.RETURN)
    Checks("Options, by the keyboard", session.front.Showing() == Page.OPTIONS)
    Local seen = session.game.View().Position(Space.WORLD)
    For step = 1 To 4
        Try Pressed(session, Key.LEFT)
    End For
    Checks("the view stays where the title flew it",
           Apart(seen, session.game.View().Position(Space.WORLD)) < 0.0001)
    Checks("the master volume's 0.80, and heard so",
           Abs(session.scape.Level(Mix.MASTER) - 0.8) < 0.001)
    // Music, by the keyboard, down one row and four steps.
    Try Pressed(session, Key.DOWN)
    For step = 1 To 4
        Try Pressed(session, Key.LEFT)
    End For
    Checks("the music's 0.80, and heard so", Abs(session.scape.Level(Mix.MUSIC) - 0.8) < 0.001)
    Checks("and nothing else moved", session.scape.Level(Mix.AMBIENCE) == 1.0 &&
           session.scape.Level(Mix.EFFECTS) == 1.0)
    Local shown = Try Pictured(session, folder, "options")
    Checks("its heading's drawn in brass",
           NearIn(shown, BoxOf(session, "options.name"), BRASS) > 200)
    Checks("with no HUD from the title", NearIn(shown, Rect(24, 24, 4, 52), BRASS) < 20)
    Try Pressed(session, Key.ESCAPE)
    Checks("Escape goes back to the title", session.front.Showing() == Page.TITLE)
    Checks("and keeps them", KeptOptions(file).Master == 0.8 && KeptOptions(file).Music == 0.8)

    // Play, by a gamepad, as the title's Play has the focus.
    Local pad = Try Simulate.ConnectGamepad("Xbox Wireless Controller")
    Defer pad.Unplug()
    Flip(False)
    Try PadPressed(session, pad, GamepadButton.SOUTH)
    Checks("Play, by a gamepad", session.front.Showing() == Page.PLAYING)
    Checks("the mouse is the game's", MouseRelative())
    Try Stepped(session, 5)
    Checks("and the clock runs", session.game.Story().Clock() > clock)
    Checks("its prompts are the pad's", session.front.Device().Current() == Device.PAD)

    // Paused by Escape, and resumed by it.
    Try Pressed(session, Key.ESCAPE)
    Checks("paused, by Escape", session.front.Showing() == Page.PAUSED)
    Try Pressed(session, Key.ESCAPE)
    Checks("resumed, by Escape", session.front.Showing() == Page.PLAYING)
    Try Stepped(session, 3)

    // Paused by Start: the clock stops, and Pip, and the effects, and the music and the wind and sea
    // go on quieter; and the menu's over the game, with the HUD under it.
    Local pip = island.PipEntity().Player()
    Try PadPressed(session, pad, GamepadButton.START)
    Checks("paused, by Start", session.front.Showing() == Page.PAUSED)
    Local stopped = session.game.Story().Clock()
    Local pipAt = pip.Time()
    Try Stepped(session, 10)
    Checks("its clock stops", session.game.Story().Clock() == stopped)
    Checks("Pip's clip stops", pip.Time() == pipAt)
    Checks("the effects stop", session.scape.Level(Mix.EFFECTS) == 0.0)
    Checks("the music goes on, quieter", Abs(session.scape.Level(Mix.MUSIC) - 0.4) < 0.001 &&
           Abs(session.scape.Level(Mix.AMBIENCE) - 0.5) < 0.001)
    Checks("the mouse is free", !MouseRelative())
    Local paused = Try Pictured(session, folder, "pause")
    Checks("its heading's drawn in brass",
           NearIn(paused, BoxOf(session, "pause.name"), BRASS) > 200)
    Checks("over the HUD's brass edge", NearIn(paused, Rect(24, 24, 4, 52), BRASS) > 150)

    // Options from it, by the mouse; Invert Y by a click; back by the pad's east.
    Try Clicked(session, "pause.options")
    Checks("Options, by the mouse", session.front.Showing() == Page.OPTIONS)
    Checks("its prompts are the keys' now", session.front.Device().Current() == Device.KEYS)
    Try Clicked(session, "options.invert")
    Checks("Invert Y, by a click", session.front.Current().InvertY)
    // Look, by a click three quarters along its slider.
    Local track = BoxOf(session, "options.look")
    Try Simulate.MoveMouse(track.X + track.Width * 0.75, track.Y + track.Height * 0.5)
    Try Stepped(session, 1)
    Try Simulate.Click(MouseButton.LEFT)
    Try Stepped(session, 2)
    Local look = session.front.Current().Look
    Checks("Look, by a click", look > 2.0 && look < 2.6)
    // Kept a second on, before Back, as closing the window then wouldn't lose it.
    Try Stepped(session, 12)
    Checks("kept a second on", Abs(KeptOptions(file).Look - look) < 0.01)
    Try PadPressed(session, pad, GamepadButton.EAST)
    Checks("back to the pause menu, by the pad", session.front.Showing() == Page.PAUSED)
    Checks("and kept", KeptOptions(file).InvertY)
    // Resumed by Escape, and the game's looking's inverted.
    Try Pressed(session, Key.ESCAPE)
    Checks("resumed, by Escape", session.front.Showing() == Page.PLAYING)
    Checks("the effects back", session.scape.Level(Mix.EFFECTS) == 1.0 &&
           Abs(session.scape.Level(Mix.MUSIC) - 0.8) < 0.001)
    Local pitch = session.game.Pitch()
    Try Simulate.MouseMotion(0.0, 100.0)
    Try Stepped(session, 1)
    Checks("the mouse down looks up, inverted", session.game.Pitch() > pitch)
    // The mouse turns by the look's sensitivity: 100 pixels at 0.003 a pixel, by it.
    Local yaw = session.game.Yaw()
    Try Simulate.MouseMotion(100.0, 0.0)
    Try Stepped(session, 1)
    Checks("the mouse turns by the sensitivity",
           Abs(Abs(session.game.Yaw() - yaw) - 0.3 * look) < 0.01)
    // And the right stick, down, looks up too, inverted.
    pitch = session.game.Pitch()
    pad.SetAxis(GamepadAxis.RIGHT_Y, 0.5)
    Try Stepped(session, 1)
    pad.SetAxis(GamepadAxis.RIGHT_Y, 0.0)
    Try Stepped(session, 1)
    Checks("the stick down looks up, inverted", session.game.Pitch() > pitch)
    // And leaves to the title, by the mouse, a new game waiting.
    Try PadPressed(session, pad, GamepadButton.START)
    Try Clicked(session, "pause.leave")
    Checks("Leave goes to the title", session.front.Showing() == Page.TITLE)
    Checks("with a game at its first moment", session.game.Story().Clock() == 0.0)
    // Controls: Use to F by a click and a key, and Hand to F refused, as Use has it.
    Try Clicked(session, "title.options")
    Try Clicked(session, "options.keys")
    Checks("Controls, by the mouse", session.front.Showing() == Page.KEYS)
    Try Clicked(session, "keys.4")
    Try Pressed(session, Key.F)
    Checks("Use is F", session.front.Current().Keys.Of(Bound.USE) == Key.F)
    Checks("and says so", (session.front.Find("keys.4") As? Button)?.Text() == "Use: F")
    Checks("and kept", KeptOptions(file).Keys.Of(Bound.USE) == Key.F)
    Checks("its prompts say F", PromptName(Device.KEYS, GamepadType.STANDARD, Prompted.USE,
                                           session.front.Device().Keys()) == "F")
    Try Clicked(session, "keys.5")
    Try Pressed(session, Key.F)
    Checks("Hand to F is refused", session.front.Current().Keys.Of(Bound.HAND) == Key.Q)
    Checks("and says why",
           (session.front.Find("keys.said") As? Label)?.Text() == "F is Use's already")
    // Escape, waiting for one, leaves it as it was.
    Try Clicked(session, "keys.0")
    Try Pressed(session, Key.ESCAPE)
    Checks("Escape leaves Forward as it was",
           session.front.Current().Keys.Of(Bound.FORWARD) == Key.W)
    Try Pressed(session, Key.ESCAPE)
    Try Pressed(session, Key.ESCAPE)
    Checks("back to the title", session.front.Showing() == Page.TITLE)
    // Accessibility, by the mouse: larger text, by the keyboard, at once; reduced motion, by the pad.
    Try Clicked(session, "title.options")
    Try Clicked(session, "options.access")
    Checks("Accessibility, by the mouse", session.front.Showing() == Page.ACCESS)
    Try Pressed(session, Key.DOWN)
    Try Pressed(session, Key.DOWN)
    Try Pressed(session, Key.RIGHT)
    Checks("larger text, by the keyboard", session.front.Current().TextSize == 1 &&
           session.hud.Scale() == 1.25)
    Local accessed = Try Pictured(session, folder, "access")
    Checks("its heading's drawn in brass, larger",
           NearIn(accessed, BoxOf(session, "access.name"), BRASS) > 300 &&
           BoxOf(session, "access.name").Height > 50.0)
    Try PadPressed(session, pad, GamepadButton.DPAD_DOWN)
    Try PadPressed(session, pad, GamepadButton.SOUTH)
    Checks("reduced motion, by the pad", session.front.Current().ReducedMotion)
    Try PadPressed(session, pad, GamepadButton.DPAD_DOWN)
    Try PadPressed(session, pad, GamepadButton.SOUTH)
    Checks("the sluice opened by a press, by the pad", !session.front.Current().HoldToOpen)
    Try Pressed(session, Key.ESCAPE)
    Try Pressed(session, Key.ESCAPE)
    Checks("and kept", KeptOptions(file).ReducedMotion && KeptOptions(file).TextSize == 1 &&
           !KeptOptions(file).HoldToOpen)
    // The title's flight, slower.
    Local slowFrom = session.game.View().Position(Space.WORLD)
    Try Stepped(session, 10)
    Local slow = Apart(slowFrom, session.game.View().Position(Space.WORLD))
    Checks("its flight's slower, with reduced motion", slow > 0.0 && slow < flight * 0.5)
    // The game's Use is F now.
    Local use = session.controls.Use.Bindings()
    Checks("the game's Use is F", use.Count > 0 && use[0].Code == Key.F As Int32)
    Try Clicked(session, "title.quit")
    Checks("Quit, by the mouse", session.left)
End Function

// A window a test stands in for, framed at first, which can't be resized while it's fullscreen, as a
// real one can't, and is fullscreen at the size it was set to.
Final Class FakeWindow Implements WindowLike
    Field mode: WindowMode = WindowMode.WINDOWED
    Field width: Int32 = 1280
    Field height: Int32 = 720
    Public Field Calls: String[] = []

    Public New()
    End New

    Public Method Mode(): WindowMode => mode

    Public Method SetMode(to: WindowMode) Throws GraphicsError
        Calls.Add("{to}")
        mode = to
    End Method

    Public Method SetSize(across: Int32, down: Int32) Throws GraphicsError
        If mode == WindowMode.FULLSCREEN Then Throw GraphicsError("a fullscreen window's size is its mode's")
        Calls.Add("{across}x{down}")
        width = across
        height = down
    End Method

    Public Method Width(): Int32 => width

    Public Method Height(): Int32 => height
End Class

// A display of two sizes, at two rates each.
Function TwoSizes(): Display
    Local modes = [DisplayMode(1920, 1080, 60.0, 1.0), DisplayMode(1920, 1080, 144.0, 1.0),
                   DisplayMode(1280, 720, 60.0, 1.0), DisplayMode(1280, 720, 144.0, 1.0)]
    Return Display("two sizes", modes[0], modes)
End Function

// The window's choices, a thing at a time, through a window the test stands in for: a size kept that
// the display hasn't, the nearest taken and said; stepping changes nothing until it's confirmed; from
// one fullscreen size to another; going back after ten seconds; and keeping it.
Function WindowsShown() Throws GraphicsError, IOError, AudioError, InputError
    Local kept = Try TempDir()
    Local file = kept.Path / "options.ini"
    Local options = Options()
    options.Shown = WindowMode.FULLSCREEN
    options.Width = 2560
    options.Height = 1440
    Try KeepOptions(options, file)
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local session = Try Session.Make(island, file, True)
    Defer session.Free()
    Local window = FakeWindow()
    session.Windowing(window, TwoSizes())
    Try Simulate.FocusWindow()
    Flip(False)
    Local chooser = session.front.Find("options.window") As? Chooser
    If chooser == Null Then Panic("there's no window chooser")
    Checks("a size it hasn't is the nearest, and says so",
           chooser.Text() == "Window: Fullscreen 1920x1080 (nearest to 2560x1440)")
    Checks("and the window's that",
           window.Mode() == WindowMode.FULLSCREEN && window.Width() == 1920)
    // Stepping to the other size changes nothing, until Enter.
    Try Clicked(session, "title.options")
    session.front.Open(Page.OPTIONS)
    For step = 1 To 5
        Try Pressed(session, Key.DOWN)
    End For
    Try Pressed(session, Key.RIGHT)
    Checks("a step's only a step", chooser.Text() == "Window: Fullscreen 1280x720" &&
           window.Width() == 1920)
    window.Calls = []
    Try Pressed(session, Key.RETURN)
    Checks("Enter puts it, through windowed", window.Mode() == WindowMode.FULLSCREEN &&
           window.Width() == 1280 && window.Calls.Join(" ") == "WINDOWED 1280x720 FULLSCREEN")
    Checks("and asks to keep it", session.front.Keeping())
    // Ten seconds go by, and it goes back.
    Try Stepped(session, 105)
    Checks("unkept, it goes back", !session.front.Keeping() && window.Width() == 1920 &&
           chooser.Text().StartsWith("Window: Fullscreen 1920x1080"))
    Checks("and isn't kept", KeptOptions(file).Width != 1280)
    // Again, kept by the mouse.
    Try Pressed(session, Key.RIGHT)
    Try Pressed(session, Key.RETURN)
    Try Clicked(session, "keep.keep")
    Checks("kept, by the mouse", !session.front.Keeping() && window.Width() == 1280 &&
           KeptOptions(file).Width == 1280)
    // Windowed again: framed at the size it was.
    Try Pressed(session, Key.LEFT)
    Try Pressed(session, Key.LEFT)
    Try Pressed(session, Key.LEFT)
    Try Pressed(session, Key.RETURN)
    Checks("windowed, at the size it was", window.Mode() == WindowMode.WINDOWED &&
           window.Width() == 1280 && window.Height() == 720)
    Try Clicked(session, "keep.keep")
    Checks("and kept", KeptOptions(file).Shown == WindowMode.WINDOWED)
End Function

// Captions and subtitles, drawn: a sound's caption on its panel, and what's said shown or not.
Function CaptionsDrawn(folder: Path) Throws GraphicsError, IOError, AudioError, InputError
    Local kept = Try TempDir()
    Local file = kept.Path / "options.ini"
    Local options = Options()
    options.SoundCaptions = True
    Try KeepOptions(options, file)
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local session = Try Session.Make(island, file)
    Defer session.Free()
    Try Simulate.FocusWindow()
    Flip(False)
    Try Stepped(session, 2)
    session.game.Story().Say("you reach the yard")
    session.captions.Say("[a gull cries]")
    Local shown = Try Pictured(session, folder, "captions")
    Local box = Rect(400, 520, 480, 120)
    Checks("a caption's drawn, on its panel", NearIn(shown, box, PAPER) > 100 &&
           NearIn(shown, box, SEA_DARK) > 2000)
    Checks("and what's said, in the HUD", NearIn(shown, Rect(40, 70, 400, 30), FAINT) > 50)
    // Subtitles off: what's said isn't shown.
    Local off = Options.Read(session.front.Current().Written())
    off.Subtitles = False
    Try KeepOptions(off, file)
    Local quiet = Try Session.Make(island, file)
    Defer quiet.Free()
    Try Stepped(quiet, 2)
    quiet.game.Story().Say("you reach the yard")
    Try Stepped(quiet, 1)
    Local hidden = Try Pictured(quiet, folder, "subtitles_off")
    Checks("without subtitles, nothing said's shown",
           NearIn(hidden, Rect(40, 70, 400, 30), FAINT) < 10)
End Function

// A walk to the ending `walk` names, its sound captions on, each captioned sound's caption shown in
// the frame it starts, and, if the sea floods the road, the surf's.
Function CaptionsWalked(walk: String) Throws GraphicsError, IOError, AudioError, InputError
    Local kept = Try TempDir()
    Local file = kept.Path / "options.ini"
    Local options = Options()
    options.SoundCaptions = True
    Try KeepOptions(options, file)
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local session = Try Session.Make(island, file)
    Defer session.Free()
    Try Simulate.FocusWindow()
    Flip(False)
    Local walker = Walker(Walk3dOf(walk) ?? [])
    Local heard = 0
    Local said = 0
    Local surfed = False
    Local cues = CaptionedCues()
    While session.game.Story().Ended() == Ending.NONE
        Try walker.Next(session.game, session.island)
        Local before: Int[] = []
        For cue In cues
            before.Add(session.scape.Played(cue))
        End For
        Try Stepped(session, 1)
        Local shown = session.captions.Shown()
        If shown.Contains("[surf crashes]") Then surfed = True
        For at = 0 Until cues.Count
            If session.scape.Played(cues[at]) > before[at]
                heard += 1
                If shown.Contains(CaptionOf(cues[at])) Then said += 1
            End If
        End For
    End While
    Try walker.Stop()
    Local flooded = session.game.Story().Flooded()
    Print("captioned sounds heard {heard}, each shown in its frame {said == heard && heard > 3}" +
          (flooded ? ", flooded, the surf shown {surfed}" : ""))
End Function

// The walk's bob, under the footsteps, and the hold that opens the sluice, its ring filling, as they're
// made; then, with reduced motion and the hold off, no bob, and a press that opens it.
Function MotionHeld(folder: Path) Throws GraphicsError, IOError, AudioError, InputError
    Local kept = Try TempDir()
    Local file = kept.Path / "options.ini"
    Try KeepOptions(Options(), file)
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local session = Try Session.Make(island, file)
    Defer session.Free()
    Try Simulate.FocusWindow()
    Flip(False)
    Local walked = Try ToTheSluice(session)
    Checks("your eyes bob as you walk, lowest at each step, where you're seen from",
           walked[0] < -BOB_HEIGHT * 0.9 && walked[1] > 5.0 && walked[2] == 0.0 && walked[3] == 0.0)
    Local game = session.game
    Checks("the sluice asks to be held", game.Prompt() == "E: hold to open the sluice")
    Try Pressed(session, Key.E)
    Try Stepped(session, 4)
    Checks("a press doesn't open it", !game.Story().SluiceOpen() && game.Opening() == 0.0)
    Try Simulate.KeyDown(Key.E)
    Try Stepped(session, 5)
    Local half = game.Opening()
    Local ring = Try Pictured(session, folder, "hold")
    Try Simulate.KeyUp(Key.E)
    Try Stepped(session, 1)
    Checks("half a second's half its ring, and letting go starts it again",
           half > 0.4 && half < 0.6 && !game.Story().SluiceOpen() && game.Opening() == 0.0)
    Checks("its ring's drawn in brass, about its key",
           NearIn(ring, Rect(440, 620, 400, 100), BRASS) > 40)
    Try Simulate.KeyDown(Key.E)
    Try Stepped(session, 10)
    Try Simulate.KeyUp(Key.E)
    Try Stepped(session, 1)
    Checks("a whole second's hold opens it", game.Story().SluiceOpen())
    // Reduced motion, and a press.
    Local other = Options()
    other.ReducedMotion = True
    other.HoldToOpen = False
    Try KeepOptions(other, file)
    Local still = Try Session.Make(island, file)
    Defer still.Free()
    Local calm = Try ToTheSluice(still)
    Checks("with reduced motion, your eyes don't bob",
           calm[0] == 0.0 && calm[1] > 5.0 && calm[3] == 0.0)
    Checks("without the hold, a press is asked", still.game.Prompt() == "E: open the sluice")
    Try Pressed(still, Key.E)
    Checks("and opens it", still.game.Story().SluiceOpen())
End Function

// Walks `session` to the sluice, its gear and paddle fitted, and gives the lowest the bob went, how
// many steps were heard, how many of those weren't low in the bob, and how many frames were seen from
// elsewhere than your eyes.
Function ToTheSluice(session: Session): Float[] Throws GraphicsError, IOError, InputError
    Local walker = Walker(["door", "gear", "E", "Q", "crossing", "E", "door", "inside", "E", "Q",
                           "E"])
    Local lowest: Float = 0.0
    Local steps = 0
    Local high = 0
    Local unseated = 0
    Local frames = 0
    Local game = session.game
    While !game.Prompt().EndsWith("open the sluice") && frames < 3000
        Try walker.Next(game, session.island)
        Local heard = session.scape.Played(Cue.STEP_1) + session.scape.Played(Cue.STEP_2) +
                      session.scape.Played(Cue.STEP_3)
        Try Stepped(session, 1)
        frames += 1
        Local bob = game.Bob()
        lowest = Min(lowest, bob)
        Local seen = game.View().Position(Space.WORLD)
        If Abs(seen.y - (game.EyeAt() + bob)) > 0.001 Then unseated += 1
        If session.scape.Played(Cue.STEP_1) + session.scape.Played(Cue.STEP_2) +
           session.scape.Played(Cue.STEP_3) > heard
            steps += 1
            If bob > -BOB_HEIGHT * 0.5 Then high += 1
        End If
    End While
    Try walker.Stop()
    Checks("walked to the sluice", game.Prompt().EndsWith("open the sluice"))
    Return [lowest, steps As Float, high As Float, unseated As Float]
End Function

// Changes options on one run, by the mouse, the keyboard, and a gamepad, in the folder `kept`, or, on
// a run after it, says what it finds kept there, and in what the game does.
Function KeptAcross(stage: String, kept: Path) Throws GraphicsError, IOError, AudioError, InputError
    Local file = kept / "options.ini"
    Local island = Try Opened()
    Defer EndGraphics()
    Defer Assets.StopWatching()
    Defer island.Free()
    Try Audio.Start(AudioDevice.MANUAL, 44100, 2)
    Defer Audio.Stop()
    Local session = Try Session.Make(island, file, True)
    Defer session.Free()
    Try Simulate.FocusWindow()
    Flip(False)
    Try Stepped(session, 2)
    If stage == "set"
        Try Dir.CreateAll(kept)
        If File.Exists(file) Then Try File.Delete(file)
        Try Clicked(session, "title.options")
        // Quality, by a click: low.
        Try Clicked(session, "options.quality")
        // Look, by the keyboard: down to it from the master volume, and four steps up.
        session.front.Open(Page.OPTIONS)
        For step = 1 To 6
            Try Pressed(session, Key.DOWN)
        End For
        For step = 1 To 4
            Try Pressed(session, Key.RIGHT)
        End For
        // Invert Y, by a gamepad's south on it, and back by its east.
        Local pad = Try Simulate.ConnectGamepad()
        Defer pad.Unplug()
        Flip(False)
        Try PadPressed(session, pad, GamepadButton.DPAD_DOWN)
        Try PadPressed(session, pad, GamepadButton.SOUTH)
        Try PadPressed(session, pad, GamepadButton.EAST)
        Local options = session.front.Current()
        Print("set: quality {options.Picture}, look {options.Look:.2}, invert {options.InvertY}, back at the title {session.front.Showing() == Page.TITLE}")
    Else
        Local options = session.front.Current()
        Print("after a restart: quality {options.Picture}, look {options.Look:.2}, invert {options.InvertY}")
        Try Clicked(session, "title.options")
        Local chooser = session.front.Find("options.quality") As? Chooser
        Print("shown as {chooser?.Text() ?? "nothing"}")
        Print("its bloom off {session.game.View().BloomIntensity() == 0.0}")
    End If
End Function

Local arguments = Process.Arguments()
Const USAGE = "usage: slack_water [--low | --walk <bright|dim|dark> [<kept>] | --walk3d " +
              "<bright|dim|dark|cut|swept|wing|far_end> [<kept>] | --feel | --hear | " +
              "--end <folder> | --cooked <kept> <folder> | " +
              "--frames <folder> | --menus <folder> | --kept <set|check> <folder> | " +
              "--check <folder> | --match <made> <kept>]"
// What's for its tests only, so a game on a player's machine can't be made to write anywhere else.
Local checking = Env.Get("SLACK_WATER_CHECKS") == "1"
If PlaysLow(arguments) != Null
    Try Played(PlaysLow(arguments) == True)
ElseIf DrawsWithoutAPerson(arguments) && Env.Get("FBENGINE_NO_GPU") != "1" &&
       !MayDrawOn(DevicesShown())
    // By hand it would reach the best GPU there is, which has already taken a machine down.
    PrintError("this draws only when the loader shows one device: set VK_DRIVER_FILES or " +
               "VK_LOADER_DRIVERS_SELECT")
    Process.Exit(2)
ElseIf arguments.Count == 3 && arguments[0] == "--cooked"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try CookedWalk(Path(arguments[1]), Path(arguments[2]))
    End If
ElseIf !checking
    PrintError(USAGE)
    Process.Exit(2)
ElseIf arguments.Count >= 2 && arguments.Count <= 3 && arguments[0] == "--walk"
    Local walk = WalkOf(arguments[1])
    If walk == Null
        PrintError(USAGE)
        Process.Exit(2)
    Else
        Local lines: String[] = []
        Local ended = Try Walked(walk, lines, Function(flow: Flow)
        End Function)
        Print("ended {ended}")
        If arguments.Count == 3 Then Try Pinned(lines, Path(arguments[2]), True)
    End If
ElseIf arguments.Count >= 2 && arguments.Count <= 3 && arguments[0] == "--walk3d"
    Local walk = Walk3dOf(arguments[1])
    If walk == Null
        PrintError(USAGE)
        Process.Exit(2)
    ElseIf Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Local lines: String[] = []
        Print("ended {Try Walked3dBy(walk, lines)}")
        If arguments.Count == 3 Then Try Pinned(lines, Path(arguments[2]), False)
    End If
ElseIf arguments.Count == 3 && arguments[0] == "--fps"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try FrameCost(Int.Parse(arguments[1]) ?? 0, Int.Parse(arguments[2]) ?? 100)
    End If
ElseIf arguments.Count == 2 && arguments[0] == "--end"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try EndShown(Path(arguments[1]))
    End If
ElseIf arguments.Count == 1 && arguments[0] == "--hear"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try Listened()
        Try HelloedAtTheDoor()
    End If
ElseIf arguments.Count == 1 && arguments[0] == "--feel"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try Felt()
    End If
ElseIf arguments.Count == 3 && arguments[0] == "--match"
    Try Matched(Path(arguments[1]), Path(arguments[2]))
ElseIf arguments.Count == 2 && arguments[0] == "--check"
    Try Checked(Path(arguments[1]))
ElseIf arguments.Count == 2 && arguments[0] == "--frames"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Local began = Instant.Now()
        Try Framed(Path(arguments[1]))
        Local framed = Instant.Now()
        Try SaveWalk(Path(arguments[1]))
        Lap("the 3D walk's frames", framed)
        Lap("--frames", began)
    End If
ElseIf arguments.Count == 2 && arguments[0] == "--menus"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try MenusShown(Path(arguments[1]))
        Try WindowsShown()
        Try CaptionsDrawn(Path(arguments[1]))
        Try MotionHeld(Path(arguments[1]))
    End If
ElseIf arguments.Count == 2 && arguments[0] == "--captions"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try CaptionsWalked(arguments[1])
    End If
ElseIf arguments.Count == 3 && arguments[0] == "--kept" &&
       (arguments[1] == "set" || arguments[1] == "check")
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try KeptAcross(arguments[1], Path(arguments[2]))
    End If
ElseIf arguments.Count == 4 && arguments[0] == "--alike"
    Try AlikeViews(Path(arguments[1]), Path(arguments[2]), Float.Parse(arguments[3]) ?? 100.0)
Else
    PrintError(USAGE)
    Process.Exit(2)
End If
If failed Then Process.Exit(1)
