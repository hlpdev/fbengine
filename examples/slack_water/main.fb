// Slack Water: you keep a tide-mill, and have one slack water to restart it, with Pip, your small
// brass helper. For now it's its flow, in text, in a window: W goes out toward the far rock, S goes
// back toward the mill, E takes, fits, and opens the sluice, Q hands things to Pip and takes them
// back, Escape ends it. With `--walk <bright|dim|dark>`, as ctest runs it, it's offscreen, played
// by key presses to that ending, ten steps a second, as fast as they go. With `--frames <folder>`,
// the same to its bright ending, saving a PNG there at each moment that shows something. With
// `--check <folder>`, it loads the assets its tools made there, and says what they are.

Import std.collections
Import std.core
Import std.io
Import std.math
Import std.os
Import std.text
Import fbengine
Import fbengine_audio
Import "./flow"
Import "./island"
Import "./res" As Res

// A game's keys, bound to what they do.
Final Class Controls
    Field Set: ActionSet
    Field Out: Action
    Field Back: Action
    Field Use: Action
    Field Hand: Action

    New()
        Set = ActionSet()
        Out = Set.Add("out")
        Out.Bind(Binding.OfKey(Key.W))
        Out.Bind(Binding.OfGamepadButton(GamepadButton.NORTH))
        Back = Set.Add("back")
        Back.Bind(Binding.OfKey(Key.S))
        Back.Bind(Binding.OfGamepadButton(GamepadButton.EAST))
        Use = Set.Add("use")
        Use.Bind(Binding.OfKey(Key.E))
        Use.Bind(Binding.OfGamepadButton(GamepadButton.SOUTH))
        Hand = Set.Add("hand")
        Hand.Bind(Binding.OfKey(Key.Q))
        Hand.Bind(Binding.OfGamepadButton(GamepadButton.WEST))
    End New

    // Does to `flow` what was pressed since the last Flip.
    Method Apply(flow: Flow)
        If Out.Hit() Then flow.GoOut()
        If Back.Hit() Then flow.GoBack()
        If Use.Hit() Then flow.Use()
        If Hand.Hit() Then flow.Hand()
    End Method
End Class

// What a walk presses, a key at a time, each once you've stopped walking and Pip's caught up: W, S,
// E, and Q as they're played. A number is the clock to wait for, in seconds.
Function WalkOf(name: String): String[]?
    Select name
        // The gear and the paddle first, with Pip's hands too; then the belt, in time.
        Case "bright"
            Return ["W", "E", "Q", "W", "E", "S", "S", "E", "Q", "E", "E",
                    "W", "W", "W", "E", "S", "S", "S", "E", "E", "600"]
        // The same, but setting off too late for the belt.
        Case "dim"
            Return ["W", "E", "Q", "W", "E", "S", "S", "E", "Q", "E", "E", "E",
                    "430", "W", "W", "S", "600"]
        // Out to the far rock, with nothing done, as the causeway floods behind you.
        Case "dark"
            Return ["W", "W", "W", "600"]
        Default
            Return Null
    End Select
End Function

// Plays `walk` to its end, by key presses, offscreen, and gives how it ended, each step told to
// `stepped` once the flow's moved on.
Function Walked(walk: String[], lines: String[], stepped: Func(Flow)): Ending Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(960, 540)
    Defer EndGraphics()
    Local controls = Controls()
    Local flow = Flow(Function(line: String)
        Print(line)
        lines.Add(line)
    End Function)
    Local next = 0
    While flow.Ended() == Ending.NONE
        If next < walk.Count && !flow.Walking() && flow.PipHere()
            Local step = walk[next]
            Local until = Int.Parse(step)
            If until != Null
                If flow.Clock() >= (until As Float) Then next += 1
            Else
                Select step
                    Case "W"
                        Try Simulate.PressKey(Key.W)
                    Case "S"
                        Try Simulate.PressKey(Key.S)
                    Case "E"
                        Try Simulate.PressKey(Key.E)
                    Default
                        Try Simulate.PressKey(Key.Q)
                End Select
                next += 1
            End If
        End If
        Flip(False)
        controls.Apply(flow)
        flow.Step(0.1)
        stepped(flow)
    End While
    Return flow.Ended()
End Function

// The screen: how long's left, where you are, and the last of what's happened.
Function Draw(flow: Flow, lines: String[], font: Font)
    Local canvas = Screen.Canvas()
    canvas.SetColor(Color32(20, 28, 36, 255))
    canvas.Clear()
    canvas.SetColor(Color32(236, 232, 220, 255))
    canvas.DrawText(font, "{flow.Left() As Int} seconds of slack water, at {PlaceName(flow.At())}",
                    24, 20)
    Local first = Max(lines.Count - 18, 0)
    For at = first Until lines.Count
        canvas.DrawText(font, lines[at], 24, 60 + (at - first) * 26)
    End For
End Function

// The bright walk, saving the screen in `folder` when you first hold something, when the causeway
// floods, and at its end.
Function Framed(folder: Path) Throws GraphicsError, IOError
    Try Dir.CreateAll(folder)
    Local lines: String[] = []
    Local font = Font.BuiltIn(20.0)
    Local holding = False
    Local flooded = False
    Local saved = 0
    Local failure = ""
    Local save = Function(flow: Flow, name: String)
        Draw(flow, lines, font)
        Try
            Try Screen.Save(folder / "{name}.png")
            saved += 1
        Catch e As GraphicsError
            failure = e.Message
        Catch e As IOError
            failure = e.Message
        End Try
    End Function
    Local ended = Try Walked(WalkOf("bright") ?? [], lines, Function(flow: Flow)
        If !holding && flow.Held() != Null
            holding = True
            save(flow, "holding")
        End If
        If !flooded && flow.Clock() >= FLOOD_AT
            flooded = True
            save(flow, "flooded")
        End If
        If flow.Ended() != Ending.NONE Then save(flow, "ended")
    End Function)
    If failure != "" Then Throw IOError(IOErrorKind.OTHER, failure)
    Print("saved {saved} frames, ended {ended}")
    Try SaveViews(folder)
End Function

// The island, in `folder`, from each of its views, at slack water and at high tide.
Function SaveViews(folder: Path) Throws GraphicsError, IOError
    Window.SetHeadless(True)
    Try Graphics(1280, 720)
    Defer EndGraphics()
    Try Res.Mount()
    Defer Assets.StopWatching()
    Local island = Try Island.Make()
    Defer island.Free()
    Local camera = Camera()
    Local sky = Color(0.62, 0.72, 0.8)
    camera.SetClearColor(sky)
    camera.SetRange(0.1, 4000.0)
    // The sea's far edge goes into the haze, with no line.
    camera.SetFogMode(FogMode.LINEAR)
    camera.SetFogColor(sky)
    camera.SetFogRange(200.0, 1400.0)
    Local saved = 0
    For view In Views()
        camera.SetPosition(view.1)
        camera.PointAt(view.2)
        island.Scene().Render()
        Try Screen.Save(folder / "{view.0}.png")
        saved += 1
        Flip(False)
    End For
    island.Update(TIDE_IN_AT)
    Local first = Views()[0]
    camera.SetPosition(first.1)
    camera.PointAt(first.2)
    island.Scene().Render()
    Try Screen.Save(folder / "island_high_tide.png")
    saved += 1
    Flip(False)
    Print("saved {saved} views of the island")
    // What the flow says of the tide is what's drawn: the causeway, dry, then cut.
    Local crossing = LowestCrossing()
    Print("the causeway's dry at slack water {crossing > SeaHeight(0.0)}")
    Print("and under as it floods {crossing < SeaHeight(FLOOD_AT + 1.0)}")
    Print("the mill's dry at high tide {GroundHeight(-45.0, 0.0) > SeaHeight(TIDE_IN_AT)}")
End Function

// Loads every asset the tools make from `folder`, as the game will, and says what they are.
Function Checked(folder: Path) Throws GraphicsError, IOError
    Assets.MountFolder("res://made", folder)
    Defer Assets.Unmount("res://made")
    For name In ["wind", "sea", "gull", "creak", "wheel", "step_1", "step_2", "step_3", "splash"]
        Local sound = Try Assets.Load<Sound>("res://made/{name}.wav")
        If sound.Frames() == 0 Then Print("{name} is silent")
        sound.Free()
    End For
    Print("the sounds load")
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    Window.SetHeadless(True)
    For material In ["rock", "sand", "wood", "brass", "iron"]
        Local albedo = Try Assets.Load<Texture>("res://made/{material}_albedo.png")
        Local normal = Try Assets.Load<Texture>("res://made/{material}_normal.png")
        Local rough = Try Assets.Load<Texture>("res://made/{material}_rough.png")
        Print("{material}: {albedo.Width()} across, {albedo.Format()}, {normal.Format()}, " +
              "{rough.Format()}")
        albedo.Free()
        normal.Free()
        rough.Free()
    End For
    Local world = World()
    Defer world.Free()
    World.SetCurrent(world)
    Local pip = Try Assets.Load<Model>("res://made/pip.gltf")
    Defer pip.Free()
    Local root = Try pip.Spawn()
    Local mesh = root.Find("pip")
    Local clips: String[] = []
    For clip In pip.Clips()
        clips.Add(clip.Name())
    End For
    Print("Pip: {pip.Skins()[0].JointCount()} joints, clips {", ".Join(clips)}")
    If mesh Is Mesh
        Local drawn = mesh As Mesh
        Local geometry = pip.Geometries()[0]
        Print("{geometry.SurfaceCount()} surfaces, " +
              "{geometry.Surface(0).MorphTargetCount()} morph target, " +
              "{drawn.Palette().Count} bones in its palette")
        Local bounds = geometry.Bounds()
        Print("0.8 m high {IsClose(bounds.Max.y, 0.8, 0.001)}, on the ground " +
              "{IsClose(bounds.Min.y, 0.0, 0.001)}")
        // A clip moves it, and the blink shuts its eyes: their tops come down.
        Local player = root.Player()
        player.Play(pip.Clips()[1])
        UpdateWorld(0.1)
        Local leg = root.Find("leg_r")
        Print("walking, its leg's turned {leg != Null && leg.Rotation().x != 0.0}")
        Local open = drawn.MorphedPositions(1)
        drawn.SetMorphWeights([1.0] As Float[])
        Local shut = drawn.MorphedPositions(1)
        Local moved = False
        For at = 0 Until open.Count
            If shut[at].y < open[at].y Then moved = True
        End For
        Print("blinking, its eyes shut {moved}")
    End If
End Function

// The game, in a window of its lines of text, for a person.
Function Played() Throws GraphicsError
    Try Graphics(960, 540)
    Defer EndGraphics()
    Window.SetTitle("Slack Water")
    Frame.SetLimit(60)
    Local controls = Controls()
    Local lines: String[] = []
    Local flow = Flow(Function(line: String)
        lines.Add(line)
    End Function)
    Local font = Font.BuiltIn(20.0)
    While !Window.Closed() && !KeyHit(Key.ESCAPE)
        Flip()
        controls.Apply(flow)
        flow.Step(Frame.Delta() As Float)
        If Screen.Texture() != Null Then Draw(flow, lines, font)
    End While
End Function

Local arguments = Process.Arguments()
If arguments.Count == 2 && arguments[0] == "--walk"
    Local walk = WalkOf(arguments[1])
    If walk == Null
        PrintError(
            "usage: slack_water [--walk <bright|dim|dark> | --frames <folder> | --check <folder>]")
        Process.Exit(2)
    Else
        Local lines: String[] = []
        Local ended = Try Walked(walk, lines, Function(flow: Flow)
        End Function)
        Print("ended {ended}")
    End If
ElseIf arguments.Count == 2 && arguments[0] == "--check"
    Try Checked(Path(arguments[1]))
ElseIf arguments.Count == 2 && arguments[0] == "--frames"
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
    Else
        Try Framed(Path(arguments[1]))
    End If
ElseIf arguments.Count == 0
    Try Played()
Else
    PrintError(
        "usage: slack_water [--walk <bright|dim|dark> | --frames <folder> | --check <folder>]")
    Process.Exit(2)
End If
