// What the tools make, by its numbers: sounds each their own, that loop without a click, around 0,
// and under clipping, and that end at nothing if they're played once; a fade that holds its power; and
// materials that tile.

Import std.collections
Import std.core
Import std.math
Import std.test
Import slack_water_tools.sounds
Import slack_water_tools.textures

// The largest step between two samples next to each other.
Function LargestStep(samples: Float[]): Float
    Local largest = 0.0
    For at = 1 Until samples.Count
        largest = Max(largest, Abs(samples[at] - samples[at - 1]))
    End For
    Return largest
End Function

// Every sound the tools make.
Function AllSounds(): Float[][]
    Return [Wind(), Sea(), Surf(), Calm(), Storm(), Gull(), Creak(), Wheel(), Works(), Step(5),
            Step(6), Step(7),
            FloorStep(9), FloorStep(10), Wade(11), Wade(12), SandStep(13), SandStep(14),
            TurfStep(15), TurfStep(16), Splash(), Fit(), Sluice(), PipHello(), PipTakes(),
            PipGives(),
            PipWorries(), PipGlad(), PipSad()]
End Function

// What's played once, not looped.
Function OneShots(): Float[][]
    Return [Gull(), Creak(), Step(5), Step(6), Step(7), FloorStep(9), FloorStep(10), Wade(11),
            Wade(12), SandStep(13), SandStep(14), TurfStep(15), TurfStep(16), Splash(), Fit(),
            Sluice(), PipHello(), PipTakes(), PipGives(), PipWorries(), PipGlad(), PipSad()]
End Function

// The samples' root mean square.
Function Rms(samples: Float[], from: Int, until: Int): Float
    Local sum = 0.0
    For at = from Until until
        sum += samples[at] * samples[at]
    End For
    Return Sqrt(sum / ((until - from) As Float))
End Function

@Test
Function EverySoundIsItsOwn()
    Local sounds = AllSounds()
    For one = 0 Until sounds.Count
        For two = one + 1 Until sounds.Count
            Expect(sounds[one] != sounds[two])
        End For
    End For
End Function

@Test
Function WhatLoopsDoesntClick()
    For sound In [Wind(), Sea(), Surf(), Wheel(), Works(), Calm(), Storm()]
        Expect(Abs(sound[sound.Count - 1] - sound[0]) <= LargestStep(sound))
        Local mean = 0.0
        For sample In sound
            mean += sample / (sound.Count As Float)
        End For
        Expect(Abs(mean) < 0.001)
    End For
End Function

@Test
Function NothingClips()
    For sound In AllSounds()
        For sample In sound
            Expect(Abs(sample) < 1.0)
        End For
    End For
End Function

// The music's loops meet their starts as if they went on: their last sample's step to their first is
// no larger than the steps inside them, and is a sixteen-second loop's.
@Test
Function TheMusicLoopsWhereItStarted()
    For theme In [Calm(), Storm()]
        Expect(theme.Count == 16 * 22050)
        Local largest = 0.0
        For at = 1 Until theme.Count
            largest = Max(largest, Abs(theme[at] - theme[at - 1]))
        End For
        Expect(Abs(theme[0] - theme[theme.Count - 1]) <= largest)
        // And it's the same a loop on: its first second's the next loop's first second.
        Expect(Abs(theme[0] - theme[theme.Count - 1]) < 0.05)
    End For
End Function

// A tone of whole cycles, looped on itself in a line, doesn't swell where its ends are crossfaded, as
// equal power would, by up to 1.41.
@Test
Function ALoopOfATonesEndsDoesntSwell()
    Local tone: Float[] = []
    For at = 0 Until 22050 * 2
        tone.Add(Sin(((at As Float) / 22050.0 * 45.0 * 6.283185307179586) As Float64) As Float)
    End For
    Local loudest = 0.0
    For sample In Looped(tone, 0.25, True)
        loudest = Max(loudest, Abs(sample))
    End For
    Expect(loudest <= 1.01)
End Function

// What's played once ends at nothing, so it doesn't click as it stops.
@Test
Function WhatsPlayedOnceEndsAtNothing()
    For sound In OneShots()
        Expect(Abs(sound[sound.Count - 1]) < 0.005)
    End For
End Function

// On steady noise, what's faded is as loud as what isn't.
@Test
Function AFadeHoldsItsPower()
    Local state: UInt32 = 12345
    Local noise: Float[] = []
    For at = 0 Until 44100
        state = state ^ (state << 13)
        state = state ^ (state >> 17)
        state = state ^ (state << 5)
        noise.Add(((state & 0xFFFF) As Float) / 32767.5 - 1.0)
    End For
    Local looped = Looped(noise, 0.5)
    Local fade = 11025
    Local decibels = 20.0 *
                     Log10((Rms(looped, 0, fade) / Rms(looped, fade, looped.Count)) As Float64)
    Expect(Abs(decibels) < 1.0)
End Function

// The step from a tile's last row or column to its first is no bigger than any inside it.
@Test
Function EveryMaterialTiles()
    For material In Materials()
        Local side = material.1
        Local heights = Heights(material.2, side)
        Local inside = 0.0
        Local wrap = 0.0
        For a = 0 Until side
            For b = 0 Until side
                Local here = heights[a * side + b]
                Local across = heights[a * side + (b + 1) % side]
                Local down = heights[((a + 1) % side) * side + b]
                If b == side - 1 Then wrap = Max(wrap, Abs(here - across))
                If b != side - 1 Then inside = Max(inside, Abs(here - across))
                If a == side - 1 Then wrap = Max(wrap, Abs(here - down))
                If a != side - 1 Then inside = Max(inside, Abs(here - down))
            End For
        End For
        Expect(wrap <= inside)
    End For
End Function
