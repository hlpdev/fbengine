// The game's sounds, synthesized: wind and sea from filtered noise, gulls, creaks, the wheel, steps on
// each surface, and a splash, as mono 16-bit WAVs of 22050 samples a second.

Import std.collections
Import std.core
Import std.io
Import std.math

Const RATE: Int = 22050
Const TAU: Float = 6.283185307179586

// Sine, cosine, and exponent through the double-precision libm, whose results round the same on
// every machine this far down, where the single-precision ones differ.
Function Sine(x: Float): Float => Sin(x As Float64) As Float
Function Cosine(x: Float): Float => Cos(x As Float64) As Float
Function Decay(x: Float): Float => Exp(x As Float64) As Float

// Noise from a seed, the same each time, from -1 to 1.
Final Class Hiss
    Field state: UInt32

    New(seed: UInt32)
        // Odd, as a shift register's state can't be 0, and each seed its own.
        state = seed * 2 + 1
    End New

    Method Next(): Float
        state = state ^ (state << 13)
        state = state ^ (state >> 17)
        state = state ^ (state << 5)
        Return ((state & 0xFFFF) As Float) / 32767.5 - 1.0
    End Method
End Class

// A one-pole low-pass, `amount` from 0, closed, to 1, open.
Final Class Smooth
    Field held: Float = 0.0

    Method Next(input: Float, amount: Float): Float
        held += (input - held) * amount
        Return held
    End Method
End Class

// `samples` with their last `fade` seconds faded over their first, so they loop without a click: at
// equal power, for noise, whose two ends aren't the same; or, `alike`, in a line, for what's the same
// material either side, as a tone or a beat is, which equal power would swell by up to 1.41.
Public Function Looped(samples: Float[], fade: Float, alike: Bool = False): Float[]
    Local count = (fade * (RATE As Float)) As Int
    Local whole = samples.Count - count
    Local looped: Float[] = []
    For at = 0 Until whole
        If at < count
            Local part = (at As Float) / (count As Float)
            If alike
                looped.Add(samples[at] * part + samples[whole + at] * (1.0 - part))
            Else
                looped.Add(samples[at] * Sine(part * TAU / 4.0) +
                           samples[whole + at] * Cosine(part * TAU / 4.0))
            End If
        Else
            looped.Add(samples[at])
        End If
    End For
    Return looped
End Function

// `samples` around 0, and scaled so the loudest is at `peak`, under what a WAV can hold.
Function Leveled(samples: Float[], peak: Float): Float[]
    Local mean = 0.0
    For sample In samples
        mean += sample / (samples.Count As Float)
    End For
    Local loudest = 0.0
    For sample In samples
        loudest = Max(loudest, Abs(sample - mean))
    End For
    Local leveled: Float[] = []
    For sample In samples
        leveled.Add((sample - mean) / loudest * peak)
    End For
    Return leveled
End Function

// `samples`, played once, faded to nothing over their last 5 ms, as leveling them around 0 can leave
// their last sample off it, a click as they stop.
Function Ended(samples: Float[]): Float[]
    Local count = Min(Samples(0.005), samples.Count)
    Local ended = samples
    For at = 0 Until count
        Local from = samples.Count - count + at
        ended[from] = samples[from] * (((count - 1 - at) As Float) / (count As Float))
    End For
    Return ended
End Function

// Writes `samples`, from -1 to 1, as a WAV.
Function WriteWav(path: Path, samples: Float[]) Throws IOError
    Local bytes: UInt8[] = []
    Local int = Function(value: Int, count: Int)
        For at = 0 Until count
            bytes.Add(((value >> (at * 8)) & 0xFF) As UInt8)
        End For
    End Function
    Local text = Function(value: String)
        For byte In value.Bytes
            bytes.Add(byte)
        End For
    End Function
    text("RIFF")
    int(36 + samples.Count * 2, 4)
    text("WAVEfmt ")
    int(16, 4)
    int(1, 2)
    int(1, 2)
    int(RATE, 4)
    int(RATE * 2, 4)
    int(2, 2)
    int(16, 2)
    text("data")
    int(samples.Count * 2, 4)
    For sample In samples
        Local level = (Clamp(sample, -1.0, 1.0) * 32767.0) As Int
        int(level & 0xFFFF, 2)
    End For
    Try File.WriteBytes(path, bytes)
End Function

// How many samples `seconds` are.
Function Samples(seconds: Float): Int => (seconds * (RATE As Float)) As Int

// The rates of the wind sound's own swell, in radians a second, which the game's gusts keep apart from.
Public Const WIND_SWELL: Float = 0.9
Public Const WIND_SWELL_TOO: Float = 2.3

// Wind: noise, swelling, through a filter that opens as it does.
Public Function Wind(): Float[]
    Local hiss = Hiss(1)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(7.0)
        Local t = (at As Float) / (RATE As Float)
        Local swell = 0.55 + 0.25 * Sine(t * WIND_SWELL) + 0.2 * Sine(t * WIND_SWELL_TOO + 1.0)
        made.Add(low.Next(hiss.Next(), 0.02 + swell * 0.05) * (0.8 + swell))
    End For
    Return Leveled(Looped(made, 1.0), 0.7)
End Function

// The sea: darker noise, in slow waves.
Public Function Sea(): Float[]
    Local hiss = Hiss(2)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(7.0)
        Local t = (at As Float) / (RATE As Float)
        Local crest = 0.5 + 0.5 * Sine(t * TAU / 3.0)
        Local wave = crest * crest
        made.Add(low.Next(hiss.Next(), 0.015 + wave * 0.06) * (0.5 + wave))
    End For
    Return Leveled(Looped(made, 1.0), 0.7)
End Function

// Surf: waves breaking on rock, one each 4 seconds, two to a loop, each a bright crash that darkens, and
// the hiss of it drawing back.
Public Function Surf(): Float[]
    Local hiss = Hiss(17)
    Local low = Smooth()
    Local body = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(9.0)
        Local t = (at As Float) / (RATE As Float)
        Local into = Fract(t / 4.0) * 4.0
        // The crash, from nothing to its height in a tenth of a second, then dying away; the draw
        // back after, softer and darker.
        Local crash = Min(into / 0.1, 1.0) * Decay(-into * 1.6)
        Local back = Sine(Clamp((into - 0.8) / 3.2, 0.0, 1.0) * 3.14159) * 0.35
        Local noise = hiss.Next()
        Local bright = low.Next(noise, 0.05 + crash * 0.4)
        made.Add(bright * (crash + back) + body.Next(noise, 0.01) * 2.0 * (crash + 0.3))
    End For
    Return Leveled(Looped(made, 1.0), 0.7)
End Function

// A gull's call: a falling cry, twice.
Public Function Gull(): Float[]
    Local made: Float[] = []
    Local phase = 0.0
    For at = 0 Until Samples(0.7)
        Local t = (at As Float) / (RATE As Float)
        Local part = Fract(t / 0.35)
        Local pitch = 1500.0 - part * 500.0 + Sine(t * 70.0) * 60.0
        phase += pitch * TAU / (RATE As Float)
        Local envelope = Sine(part * 3.14159)
        made.Add((Sine(phase) + 0.4 * Sine(phase * 2.0)) * envelope)
    End For
    Return Ended(Leveled(made, 0.6))
End Function

// Wood creaking: a low tone in stutters.
Public Function Creak(): Float[]
    Local hiss = Hiss(3)
    Local made: Float[] = []
    Local phase = 0.0
    For at = 0 Until Samples(0.5)
        Local t = (at As Float) / (RATE As Float)
        phase += (180.0 + t * 90.0) * TAU / (RATE As Float)
        Local stutter = Fract(t * 22.0) < 0.35 ? 1.0 : 0.15
        Local fade = Sine(t / 0.5 * 3.14159)
        made.Add((Sine(phase) * 0.6 + hiss.Next() * 0.1) * stutter * fade)
    End For
    Return Ended(Leveled(made, 0.6))
End Function

// The wheel: a slow thump, and water, turning once in its length, which is whole beats once its
// fade's taken off.
Public Function Wheel(): Float[]
    Local hiss = Hiss(4)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(2.25)
        Local t = (at As Float) / (RATE As Float)
        Local beat = Fract(t * 2.0)
        Local thump = Sine(beat * TAU * 3.0) * Decay(-beat * 9.0) * 0.8
        made.Add(thump + low.Next(hiss.Next(), 0.1) * 0.5)
    End For
    Return Leveled(Looped(made, 0.25, True), 0.7)
End Function

// A step on rock: a click and a little noise, a seed for each of three.
Public Function Step(seed: UInt32): Float[]
    Local hiss = Hiss(seed)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(0.14)
        Local t = (at As Float) / (RATE As Float)
        made.Add(low.Next(hiss.Next(), 0.25) * Decay(-t * 38.0))
    End For
    Return Ended(Leveled(made, 0.7))
End Function

// A step on the mill's boards: a low knock, a seed for each of two.
Public Function FloorStep(seed: UInt32): Float[]
    Local hiss = Hiss(seed)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(0.16)
        Local t = (at As Float) / (RATE As Float)
        Local knock = Sine(t * TAU * 140.0) * Decay(-t * 30.0)
        made.Add(knock + low.Next(hiss.Next(), 0.1) * Decay(-t * 60.0))
    End For
    Return Ended(Leveled(made, 0.7))
End Function

// The music's loops: 16 seconds, four bars of four at 60 beats a minute.
Const BARS: Float = 16.0

// A note's frequency in hertz, `semitones` from A4's 440, rounded so a whole number of its cycles fits
// in a loop, so it meets its start: by under a 32nd of a hertz, which no ear hears.
Function Note(semitones: Float): Float
    Local hertz = 440.0 * (Exp((semitones / 12.0 * 0.6931472) As Float64) As Float)
    Return Round(hertz * BARS) / BARS
End Function

// `amount` of a tone at `hertz` added to `into`, a loop, from `start` seconds for `seconds`, swelling
// in and out over `swell`, and wrapping round its end onto its start.
Function Pad(into: Float[], hertz: Float, start: Float, seconds: Float, swell: Float, amount: Float)
    Local count = Samples(seconds)
    Local first = Samples(start)
    For at = 0 Until count
        Local t = (at As Float) / (RATE As Float)
        Local edge = Min(Min(t / swell, (seconds - t) / swell), 1.0)
        Local shape = Sine(edge * TAU / 4.0)
        Local time = ((first + at) As Float) / (RATE As Float)
        // Two voices a little apart, for a chorus, each a whole number of cycles in the loop.
        Local voice = Sine(time * TAU * hertz) + 0.5 * Sine(time * TAU * (hertz + 1.0 / BARS))
        Local index = ((first + at) % into.Count + into.Count) % into.Count
        into[index] = into[index] + voice * shape * amount
    End For
End Function

// A note plucked at `start` seconds, `hertz`, dying away over `decay`, wrapping round the loop's end.
Function Pluck(into: Float[], hertz: Float, start: Float, decay: Float, amount: Float)
    Local first = Samples(start)
    For at = 0 Until Samples(decay * 5.0)
        Local t = (at As Float) / (RATE As Float)
        Local time = ((first + at) As Float) / (RATE As Float)
        Local tone = Sine(time * TAU * hertz) + 0.3 * Sine(time * TAU * hertz * 2.0)
        Local index = ((first + at) % into.Count + into.Count) % into.Count
        into[index] = into[index] + tone * Min(t / 0.004, 1.0) * Decay(-t / decay) * amount
    End For
End Function

// The calm theme, for slack water: a slow pad in D dorian, Dm9, Bbmaj7, Fmaj7, and Cadd9, a bar each,
// each swelling into the next, with a few plucked notes over it, sparse, as the water's still. A loop
// of 16 seconds whose end meets its start, as every tone in it is a whole number of cycles and every
// note wraps round.
Public Function Calm(): Float[]
    Local made: Float[] = []
    For at = 0 Until Samples(BARS)
        made.Add(0.0)
    End For
    // Semitones from A4: D3 is -19.
    Local chords = [[-19.0, -16.0, -12.0, -9.0, -5.0], [-23.0, -19.0, -16.0, -12.0],
                    [-28.0, -24.0, -21.0, -17.0], [-21.0, -17.0, -14.0, -7.0]]
    For bar = 0 Until 4
        For note In chords[bar]
            // Each chord over its bar and a second more, so it's under the next's swell.
            Pad(made, Note(note), (bar As Float) * 4.0 - 0.5, 5.0, 1.5, 0.12)
        End For
    End For
    // D5, F5, G5, A5, C6: the pentatonic of D minor, at fixed beats, sparse.
    Local melody = [(1.0, 5.0), (2.5, 8.0), (5.0, 12.0), (7.0, 10.0), (9.5, 3.0), (11.0, 5.0),
                    (13.0, 15.0), (14.5, 12.0)]
    For each In melody
        Pluck(made, Note(each.1), each.0, 0.45, 0.35)
    End For
    Return Leveled(made, 0.6)
End Function

// The storm's theme, for when it comes and the flood: a low D's drone, pulsing in eighth notes, its
// fifth, a minor second over it that rubs, and a drum's hit at each bar, louder each bar in four. A
// loop of 16 seconds, as Calm is.
Public Function Storm(): Float[]
    Local made: Float[] = []
    For at = 0 Until Samples(BARS)
        made.Add(0.0)
    End For
    Local d2 = Note(-31.0)
    Local a2 = Note(-24.0)
    Local eb3 = Note(-18.0)
    For at = 0 Until made.Count
        Local time = (at As Float) / (RATE As Float)
        // Eighth notes at 60 a minute: twice a second, each swelling and falling.
        Local pulse = 0.55 + 0.45 * Sine(time * TAU * 2.0 - TAU / 4.0)
        Local drone = Sine(time * TAU * d2) + 0.5 * Sine(time * TAU * d2 * 2.0) +
                      0.33 * Sine(time * TAU * d2 * 3.0)
        Local fifth = 0.5 * Sine(time * TAU * a2)
        // The minor second, coming and going over each bar.
        Local rub = 0.3 * Sine(time * TAU * eb3) * (0.5 + 0.5 * Sine(time * TAU / 4.0))
        made[at] = drone * pulse * 0.5 + fifth * 0.4 + rub
    End For
    For bar = 0 Until 4
        // A drum's hit: a low tone falling in pitch, dying away, wrapping round.
        Local first = Samples((bar As Float) * 4.0)
        Local phase = 0.0
        For at = 0 Until Samples(1.2)
            Local t = (at As Float) / (RATE As Float)
            phase += (55.0 + 40.0 * Decay(-t * 12.0)) * TAU / (RATE As Float)
            Local index = (first + at) % made.Count
            made[index] = made[index] + Sine(phase) * Decay(-t * 3.5) * Min(t / 0.003, 1.0) *
                          (0.6 + 0.15 * (bar As Float))
        End For
    End For
    Return Leveled(made, 0.6)
End Function

// Pip's voice: a little brass helper's, by frequency modulation, a tone at twice the note bending it
// as much as its envelope says, so it's bright as it starts and rounder as it dies. Each of `notes` is
// its hertz at its start and end, and how long it is; each one's swells in and out over 15 ms.
Function Chirps(notes: (Float, Float, Float)[]): Float[]
    Local made: Float[] = []
    Local phase = 0.0
    Local turn = 0.0
    For note In notes
        Local count = Samples(note.2)
        For at = 0 Until count
            Local part = (at As Float) / (count As Float)
            Local hertz = note.0 + (note.1 - note.0) * part
            phase += hertz * TAU / (RATE As Float)
            turn += hertz * 2.0 * TAU / (RATE As Float)
            Local t = (at As Float) / (RATE As Float)
            Local edge = Min(Min(t / 0.015, (note.2 - t) / 0.015), 1.0)
            Local bright = 1.5 * (1.0 - part * 0.7)
            made.Add(Sine(phase + bright * Sine(turn)) * edge)
        End For
    End For
    Return Ended(Leveled(made, 0.6))
End Function

// Pip's hello: two notes up, E5 to A5, as it catches up.
Public Function PipHello(): Float[] => Chirps([(659.0, 680.0, 0.12), (0.0, 0.0, 0.05),
                                               (880.0, 900.0, 0.16)])

// Pip taking something: a quick glide up.
Public Function PipTakes(): Float[] => Chirps([(600.0, 1200.0, 0.16)])

// Pip giving something back: a quick glide down.
Public Function PipGives(): Float[] => Chirps([(1200.0, 600.0, 0.16)])

// Pip worried, as the flood comes over the road: three wobbling notes, each lower.
Public Function PipWorries(): Float[]
    Local notes: (Float, Float, Float)[] = []
    For each = 0 Until 3
        Local base = 760.0 - (each As Float) * 70.0
        notes.Add((base, base - 40.0, 0.14))
        notes.Add((base - 40.0, base + 10.0, 0.08))
        notes.Add((0.0, 0.0, 0.05))
    End For
    Return Chirps(notes)
End Function

// Pip glad, as the lamp burns bright: C6, E6, G6, C7, up.
Public Function PipGlad(): Float[]
    Return Chirps([(1047.0, 1047.0, 0.09), (1319.0, 1319.0, 0.09), (1568.0, 1568.0, 0.09),
                   (2093.0, 2100.0, 0.22)])
End Function

// Pip sad, as the lamp burns dim or not at all: G5, E5, C5, slowly down, each sagging.
Public Function PipSad(): Float[]
    Return Chirps([(784.0, 760.0, 0.22), (659.0, 630.0, 0.22), (523.0, 480.0, 0.4)])
End Function

// A part fitted: iron struck on iron, a few partials that aren't harmonics, ringing down, and a
// ratchet's clicks as it's seated.
Public Function Fit(): Float[]
    Local hiss = Hiss(18)
    Local made: Float[] = []
    For at = 0 Until Samples(0.7)
        Local t = (at As Float) / (RATE As Float)
        Local ring = Sine(t * TAU * 523.0) * Decay(-t * 7.0) +
                     0.6 * Sine(t * TAU * 1307.0) * Decay(-t * 11.0) +
                     0.35 * Sine(t * TAU * 2291.0) * Decay(-t * 16.0)
        Local click = t > 0.25 && Fract((t - 0.25) *
                                        18.0) < 0.12 && t < 0.5 ? hiss.Next() * 0.5 : 0.0
        made.Add(ring * Min(t / 0.002, 1.0) + click)
    End For
    Return Ended(Leveled(made, 0.6))
End Function

// The sluice opened: its wood groaning as it's raised, a low tone in stutters that rises, then the
// water let into the race, rushing louder.
Public Function Sluice(): Float[]
    Local hiss = Hiss(19)
    Local low = Smooth()
    Local made: Float[] = []
    Local phase = 0.0
    For at = 0 Until Samples(2.2)
        Local t = (at As Float) / (RATE As Float)
        phase += (70.0 + t * 40.0) * TAU / (RATE As Float)
        Local raised = Clamp(1.0 - t / 0.9, 0.0, 1.0)
        Local stutter = Fract(t * 14.0) < 0.4 ? 1.0 : 0.2
        Local groan = (Sine(phase) + 0.5 * Sine(phase * 2.0)) * stutter * raised *
                      Min(t / 0.05, 1.0)
        Local rush = low.Next(hiss.Next(), 0.08 + 0.15 * Clamp((t - 0.5) / 1.0, 0.0, 1.0)) *
                     Clamp((t - 0.4) / 0.8, 0.0, 1.0) * Clamp((2.2 - t) / 0.4, 0.0, 1.0) * 2.5
        made.Add(groan * 0.6 + rush)
    End For
    Return Ended(Leveled(made, 0.7))
End Function

// The mill's works, driven: a gear's teeth clicking twelve times a second, a shaft's low hum, and the
// knock of each turn of the great wheel, two seconds of it, which loop.
Public Function Works(): Float[]
    Local hiss = Hiss(20)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(2.25)
        Local t = (at As Float) / (RATE As Float)
        Local tooth = Fract(t * 12.0)
        Local click = low.Next(hiss.Next(), 0.3) * Decay(-tooth * 60.0)
        Local hum = Sine(t * TAU * 45.0) * (0.6 + 0.4 * Sine(t * TAU * 0.5))
        Local turn = Fract(t * 0.5)
        Local knock = Sine(turn * TAU * 60.0) * Decay(-turn * 25.0)
        made.Add(click * 0.8 + hum * 0.3 + knock * 0.5)
    End For
    Return Leveled(Looped(made, 0.25, True), 0.6)
End Function

// A step on sand: grains giving way, a crunch of noise in short bursts, darker as it settles, a seed for
// each of two.
Public Function SandStep(seed: UInt32): Float[]
    Local hiss = Hiss(seed)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(0.22)
        Local t = (at As Float) / (RATE As Float)
        // Grains: the noise let through in bursts, more of them at first.
        Local grain = hiss.Next()
        Local through = Abs(grain) > 0.55 + t * 2.0 ? 1.0 : 0.25
        Local swell = Sine(Min(t / 0.03, 1.0) * TAU / 4.0) * Decay(-t * 14.0) *
                      Clamp((0.22 - t) / 0.06, 0.0, 1.0)
        made.Add(low.Next(grain * through, 0.45 - t) * swell)
    End For
    Return Ended(Leveled(made, 0.6))
End Function

// A step on turf: a soft, low thud, and the grass brushed, a seed for each of two.
Public Function TurfStep(seed: UInt32): Float[]
    Local hiss = Hiss(seed)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(0.2)
        Local t = (at As Float) / (RATE As Float)
        Local thud = Sine(t * TAU * 75.0) * Decay(-t * 25.0)
        Local brush = low.Next(hiss.Next(), 0.12) * Sine(Min(t / 0.2, 1.0) * TAU / 2.0) * 0.6
        made.Add(thud + brush)
    End For
    Return Ended(Leveled(made, 0.6))
End Function

// A step in the shallows: a wash of noise, a seed for each of two.
Public Function Wade(seed: UInt32): Float[]
    Local hiss = Hiss(seed)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(0.35)
        Local t = (at As Float) / (RATE As Float)
        Local swell = Sine(Min(t / 0.35, 1.0) * TAU / 2.0)
        made.Add(low.Next(hiss.Next(), 0.2 + 0.25 * swell) * swell)
    End For
    Return Ended(Leveled(made, 0.6))
End Function

// A splash: noise, bright at first, darkening and dying away.
Public Function Splash(): Float[]
    Local hiss = Hiss(8)
    Local low = Smooth()
    Local made: Float[] = []
    For at = 0 Until Samples(0.9)
        Local t = (at As Float) / (RATE As Float)
        made.Add(low.Next(hiss.Next(), 0.5 * Decay(-t * 4.0) + 0.03) * Decay(-t * 4.5))
    End For
    Return Ended(Leveled(made, 0.8))
End Function

/// Writes every sound in `folder`.
Public Function WriteSounds(folder: Path) Throws IOError
    Try WriteWav(folder / "wind.wav", Wind())
    Try File.WriteText(folder / "wind.wav.toml", "streamed = true\n")
    Try WriteWav(folder / "sea.wav", Sea())
    Try File.WriteText(folder / "sea.wav.toml", "streamed = true\n")
    Try WriteWav(folder / "surf.wav", Surf())
    Try File.WriteText(folder / "surf.wav.toml", "streamed = true\n")
    Try WriteWav(folder / "gull.wav", Gull())
    Try WriteWav(folder / "creak.wav", Creak())
    Try WriteWav(folder / "wheel.wav", Wheel())
    Try WriteWav(folder / "step_1.wav", Step(5))
    Try WriteWav(folder / "step_2.wav", Step(6))
    Try WriteWav(folder / "step_3.wav", Step(7))
    Try WriteWav(folder / "floor_1.wav", FloorStep(9))
    Try WriteWav(folder / "floor_2.wav", FloorStep(10))
    Try WriteWav(folder / "wade_1.wav", Wade(11))
    Try WriteWav(folder / "wade_2.wav", Wade(12))
    Try WriteWav(folder / "splash.wav", Splash())
