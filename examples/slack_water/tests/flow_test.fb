@Test
Function WhatDrawsWithNoPersonDoesntPickAGpu()
    For mode In ["--cooked", "--walk3d", "--end", "--hear", "--feel", "--frames"]
        Expect(DrawsWithoutAPerson([mode, "x"]))
    End For
    Expect(!DrawsWithoutAPerson([]))
    Expect(!DrawsWithoutAPerson(["--walk", "x"]))
