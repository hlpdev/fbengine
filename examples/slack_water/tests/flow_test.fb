    Expect(PlaysLow(["--low"]) == True)
    Expect(PlaysLow(["--low", "x"]) == Null)
    Expect(PlaysLow(["--frames", "x"]) == Null)
    Expect(PlaysLow(["--fps"]) == Null)
End Function

