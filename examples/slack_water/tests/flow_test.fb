@Test
Function WhatsWhiteIsBrightAndGrey()
    Local image = Image(20, 20)
    image[10, 10] = Color32(230, 228, 220, 255)
    image[11, 10] = Color32(240, 200, 90, 255)
    image[12, 10] = Color32(160, 160, 160, 255)
    // Bright, but brass's color.
    image[10, 11] = Color32(255, 210, 175, 255)
    image[17, 10] = Color32(250, 250, 250, 255)
    Expect(WhiteAround(image, 10, 10) == 1)
    Expect(WhiteAround(image, 11, 10) == 2)
