        For z = -85 To -30
            highest = Max(highest, GroundHeight(x As Float, z As Float))
        End For
    End For
    Expect(highest > 16.0, "{highest}")
    Expect(Abs(GroundHeight(MAIN_X, 0.0) - 4.0) < 0.001)
    Expect(Abs(GroundHeight(MAIN_X + 15.0, 10.0) - 4.0) < 0.001)
