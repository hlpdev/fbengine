// What the sea's waves and shore, and the sky's clouds, are made of, by their numbers.

Import std.core
Import std.math
Import std.test
Import slack_water.ground
Import slack_water.sea
Import slack_water.sky

Const SIDE_OF_WAVES: Int = 256

// How far apart two texels' first two numbers are.
Function Apart(frame: UInt8[], x: Int, y: Int, otherX: Int, otherY: Int): Int
    Local one = (y * SIDE_OF_WAVES + x) * 4
    Local other = (otherY * SIDE_OF_WAVES + otherX) * 4
    Return Abs((frame[one] As Int) - (frame[other] As Int)) +
           Abs((frame[one + 1] As Int) - (frame[other + 1] As Int))
End Function

@Test
Function WavesTileAcrossTheirEdgesAsWithinThem()
    Local tile = WaveTile()
    Local inside = 0
    Local edges = 0
    For at = 0 Until SIDE_OF_WAVES
        inside += Apart(tile, 100, at, 101, at) + Apart(tile, at, 100, at, 101)
        edges += Apart(tile, 255, at, 0, at) + Apart(tile, at, 255, at, 0)
    End For
    Expect(inside > 0)
    Expect((edges As Float) < (inside As Float) * 1.3)
    Expect((edges As Float) > (inside As Float) * 0.7)
End Function

@Test
Function WavesFaceMostlyUpAndColorNothing()
    Local tile = WaveTile()
    Expect(tile.Count == SIDE_OF_WAVES * SIDE_OF_WAVES * 4)
    Local at = 0
    While at < tile.Count
        // Up's blue, and a sheer one would be 128.
        Expect(tile[at + 2] > 200)
        // Laid over the sea by its alpha, which is none.
        Expect(tile[at + 3] == 0)
        at += 4
    End While
End Function

@Test
Function AFlatNormalIsWhatAMapSaysIsFlat()
    Local r, g, b = NormalTexel(0.0, 0.0)
    Expect(r == 128 && g == 128 && b == 255)
    Local across, _, _ = NormalTexel(0.2, 0.0)
    Local back, _, _ = NormalTexel(-0.2, 0.0)
    // Mirrored, to a byte, as 127.5 is between two.
    Expect(Abs((across As Int) + (back As Int) - 256) <= 1)
End Function

@Test
Function TheSunsWayIsAWay()
    For clock In [0.0, 100.0, 1000.0]
        Local way = WayToSun(clock)
        Expect(Abs(Length(way) - 1.0) < 0.0001)
        Expect(way.y > 0.0)
        Local height, _ = SunAt(clock)
        Expect(Abs(way.y - Sin(height)) < 0.0001)
    End For
End Function

@Test
Function NoCloudIsBelowTheHorizon()
    Local cloud, _ = CloudAt(1.0, 0.0, 0.0)
    Expect(cloud == 0.0)
    cloud, _ = CloudAt(0.7, -0.7, 0.0)
    Expect(cloud == 0.0)
End Function

@Test
Function CloudsAreLitOnTheirSunsSideAndDarkOnTheOther()
    Local brightest: Float = 0.0
    Local darkest: Float = 1.0
    For along = 0 Until 60
        For across = 0 Until 60
            Local x = (across As Float) / 30.0 - 1.0
            Local z = (along As Float) / 30.0 - 1.0
            Local cloud, lit = CloudAt(x, 0.5, z)
            If cloud > 0.5
                brightest = Max(brightest, lit)
                darkest = Min(darkest, lit)
            End If
        End For
    End For
    Expect(brightest > 0.95)
    Expect(darkest < 0.5)
End Function

@Test
Function TheSkyHasCloudAndNoneAndIsWhole()
    Local image = SkyImage()
    Expect(image.Width == 1024)
    Expect(image.Height == 512)
    Local brightest: Float = 0.0
    Local dimmestUp: Float = 100.0
    Local row = 0
    While row < image.Height / 2 - 20
        For column = 0 Until image.Width
            Local at = (row * image.Width + column) * 4
            Local red = image.Pixels[at] As Float
            Expect(red == red && red >= 0.0 && red < 10.0)
            brightest = Max(brightest, red)
            dimmestUp = Min(dimmestUp, red)
        End For
        row += 7
    End While
    // Past white, and a blue with little red.
    Expect(brightest > 1.0)
    Expect(dimmestUp < 0.6)
End Function

@Test
Function TheHorizonIsWhatTheFogGoesInto()
    // So nothing shows where a sea in its fog meets the sky.
    Local image = SkyImage()
    Local at = (image.Height / 2 * image.Width + 17) * 4
    Expect(Abs((image.Pixels[at] As Float) - SKY.r * SKY_LIGHT) < 0.02)
    Expect(Abs((image.Pixels[at + 1] As Float) - SKY.g * SKY_LIGHT) < 0.02)
    Expect(Abs((image.Pixels[at + 2] As Float) - SKY.b * SKY_LIGHT) < 0.02)
End Function
