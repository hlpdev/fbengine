// When the game makes each sound, by its flow and your feet, with no device.

Import std.collections
Import std.core
Import std.io
Import std.math
Import std.test
Import std.text
Import slack_water.cues
Import slack_water.flow
Import slack_water.ground
Import slack_water.map
Import slack_water.walks

// A flow that says nothing to anyone.
Function Quiet(): Flow
    Return Flow(Function(line: String)
    End Function)
End Function

// How many of `cue` are in `cues`.
Function Count(cues: Cue[], cue: Cue): Int
    Local count = 0
    For one In cues
        If one == cue Then count += 1
    End For
    Return count
End Function

@Test
Function StepsAreByHowFarYouWalkNeverTheSameTwice()
    Local cues = Cues()
    Local flow = Quiet()
    Local steps: Cue[] = []
    // Standing still, none.
    For tick = 1 To 50
        For cue In cues.Step(flow, 0.0, 0.1, Surface.ROCK, False)
            Expect(!IsStep(cue))
        End For
    End For
    // Ten seconds at 4 m/s: 40 m, 22 strides of 1.8.
    For tick = 1 To 100
        For cue In cues.Step(flow, 0.4, 0.1, Surface.ROCK, False)
            If IsStep(cue) Then steps.Add(cue)
        End For
    End For
    Expect(steps.Count == 22)
    For at = 1 Until steps.Count
        Expect(steps[at] != steps[at - 1])
    End For
    // They don't go round in order.
    Local inOrder = True
    For at = 3 Until steps.Count
        If steps[at] != steps[at - 3] Then inOrder = False
    End For
    Expect(!inOrder)
End Function

// What you're on says which steps those are.
@Test
Function StepsAreByTheSurface()
    Local heights = TerrainHeights()
    Expect(SurfaceAt(heights, MAIN_X, 0.0, True, 0.0) == Surface.FLOOR)
    Expect(SurfaceAt(heights, PaddleSpot().x, PaddleSpot().y, False, 0.0) == Surface.ROAD)
    Expect(SurfaceAt(heights, PaddleSpot().x, PaddleSpot().y, False, 0.6) == Surface.SHALLOWS)
    Expect(StepPitch(Surface.ROAD) < StepPitch(Surface.ROCK))
    Local banks = [(Surface.FLOOR, [Cue.FLOOR_1, Cue.FLOOR_2]),
                   (Surface.SHALLOWS, [Cue.WADE_1, Cue.WADE_2]),
                   (Surface.ROCK, [Cue.STEP_1, Cue.STEP_2, Cue.STEP_3]),
                   (Surface.ROAD, [Cue.STEP_1, Cue.STEP_2, Cue.STEP_3]),
                   (Surface.SAND, [Cue.SAND_1, Cue.SAND_2]),
                   (Surface.TURF, [Cue.TURF_1, Cue.TURF_2])]
    For pair In banks
        Local cues = Cues()
        Local flow = Quiet()
        For tick = 1 To 50
            For cue In cues.Step(flow, 0.4, 0.1, pair.0, False)
                If IsStep(cue) Then Expect(pair.1.Contains(cue))
            End For
        End For
    End For
End Function

// Outside, off the road and above the sea, your steps are on what the bake painted there, at each texel's
// middle, as the island's GroundCover reads the terrain's heights: sand, turf and trodden ground, and
// rock; and the island has each, with nothing but sand and rock at the sea's edge.
@Test
Function StepsAreOnWhatsPaintedThere()
    Local heights = TerrainHeights()
    Local half = (SIDE As Float) / 2.0
    Local found = [0, 0, 0]
    Local edges = 0
    For row = 0 Until 120
        For column = 0 Until 120
            // A texel's middle, 2 to the meter, as GroundCover bakes them, in every other meter.
            Local across = (column As Float) * 2.0 + 0.25
            Local down = (row As Float) * 2.0 + 0.25
            Local x = across - half
            Local z = down - half
            Local baked = BakedAt(heights, across, down)
            If baked.0 < 0.0 || OnRoad(x, z) Then Continue
            Local wanted = Underfoot(CoverParts(x, z, baked.0, baked.1))
            Local heard = SurfaceAt(heights, x, z, False, 0.0)
            Expect(heard == wanted)
            found[wanted == Surface.SAND ? 0 : wanted == Surface.TURF ? 1 : 2] += 1
            // The sea's edge, under 30 cm up, at slack water: sand or rock, never turf.
            If baked.0 < 0.3
                edges += 1
                Expect(heard == Surface.SAND || heard == Surface.ROCK)
            End If
        End For
    End For
    Expect(found[0] > 20 && found[1] > 20 && found[2] > 20)
    Expect(edges > 20)
    Local door = DoorSpot()
    Expect(SurfaceAt(heights, door.x, door.y + 2.0, False, 0.0) == Surface.TURF)
End Function

// CUES is how many cues there are, by Cue's own members, numbered 0 to CUES less one, each with a level.
@Test
Function CuesCountsThem()
    Local count = 0
    For Member m In Cue
        Local number = m.Value As Int
        Expect(number >= 0 && number < CUES)
        Expect(CueLevel(m.Value) > 0.0)
        count += 1
    End For
    Expect(count == CUES)
End Function

// The terrain's heights past its edges are the nearest edge's: west and south of its corner too.
@Test
Function PastTheCornerIsTheEdge()
    Local heights = TerrainHeights()
    Expect(HeightIn(heights, -3.0, -5.0) == HeightIn(heights, 0.0, 0.0))
    Expect(HeightIn(heights, -0.5, 10.25) == HeightIn(heights, 0.0, 10.25))
    Local far = (SIDE As Float) + 4.0
    Expect(HeightIn(heights, far, far) == HeightIn(heights, SIDE As Float, SIDE As Float))
    // And what's underfoot there is the corner's, as the player can stand off the grid's south-west.
    Local half = (SIDE As Float) / 2.0
    Expect(SurfaceAt(heights, -half - 5.0, -half - 5.0, False, -10.0) ==
           SurfaceAt(heights, -half, -half, False, -10.0))
End Function

// The game's gusts share no rate with the wind sound's own swell, which tools/sounds.fb says, read from
// the game's folder, where its tests run.
@Test
Function TheGustsAreApartFromTheWindsOwnSwell() Throws IOError
    Local found: Float[] = []
    For line In (Try File.ReadText(Path("tools/sounds.fb"))).Split("\n")
        If line.StartsWith("Public Const WIND_SWELL")
            found.Add(Float.Parse(line.Split("=")[1].Trim()) ?? -1.0)
        End If
    End For
    Expect(found.Count == 2)
    For rate In found
        Expect(rate > 0.0)
        For gust In GustRates()
            Expect(Abs(gust - rate) > 0.05)
        End For
    End For
End Function

// What's most seen decides it, after the painting order: sand over trodden ground, which is over turf.
@Test
Function WhatsMostSeenIsUnderfoot()
    Expect(Underfoot((0.45, 0.0, 0.55)) == Surface.SAND)
    Expect(Underfoot((0.0, 0.0, 0.0)) == Surface.ROCK)
    Expect(Underfoot((0.0, 0.9, 0.0)) == Surface.TURF)
    Expect(Underfoot((0.0, 0.0, 0.6)) == Surface.TURF)
    Expect(Underfoot((0.3, 0.0, 0.0)) == Surface.ROCK)
    // Ties go to what's painted last, on top: sand over trodden ground, trodden ground over turf.
    Expect(Underfoot((0.5, 0.0, 1.0)) == Surface.SAND)
    Expect(Underfoot((0.0, 1.0, 0.5)) == Surface.TURF)
    Expect(Underfoot((0.2, 0.0, 0.0)) == Surface.ROCK)
End Function

// The water carrying you isn't walking.
@Test
Function ACarryIsntSteps()
    Local cues = Cues()
    For cue In cues.Step(Quiet(), 80.0, 0.1, Surface.ROCK, False)
        Expect(!IsStep(cue))
    End For
End Function

// Gulls call now and then, until the flood; there's one splash, at it.
@Test
Function GullsStopAtTheFloodWhichSplashes()
    Local cues = Cues()
    Local flow = Quiet()
    Local gulls = 0
    Local splashes = 0
    For tick = 1 To 1000
        flow.Step(0.1)
        Local heard = cues.Step(flow, 0.0, 0.1, Surface.ROCK, False)
        gulls += Count(heard, Cue.GULL)
        splashes += Count(heard, Cue.SPLASH)
    End For
    // 100 s, at one each 5 to 14 s.
    Expect(gulls >= 7 && gulls <= 20)
    Expect(splashes == 0)
    flow.Step(FLOOD_AT - 100.0 + 1.0)
    Expect(flow.Flooded())
    Local after = cues.Step(flow, 0.0, 100.0, Surface.ROCK, False)
    Expect(Count(after, Cue.SPLASH) == 1)
    Expect(Count(after, Cue.GULL) == 0)
    Expect(Count(cues.Step(flow, 0.0, 100.0, Surface.ROCK, False), Cue.SPLASH) == 0)
End Function

// A gull's off over the water, on different sides, from anywhere on the walk.
@Test
Function GullsAreOverTheWater()
    Local cues = Cues()
    For place In [DoorSpot(), GearSpot(), PaddleSpot(), BeltSpot()]
        Local first = cues.GullAt(place.x, place.y)
        Local apart = 0.0
        For call = 1 To 40
            Local at = cues.GullAt(place.x, place.y)
            Expect(GroundHeight(at.x, at.y) < 0.0)
            Local dx = at.x - first.x
            Local dz = at.y - first.y
            apart = Max(apart, dx * dx + dz * dz)
        End For
        // Not all from the one place: at least ten meters apart.
        Expect(apart > 100.0)
    End For
End Function

// Creaks are inside the mill, or by the turning wheel, not out on the rocks.
@Test
Function CreaksAreAtTheMill()
    Local inside = Cues()
    Local flow = Quiet()
    Local creaks = 0
    For tick = 1 To 300
        creaks += Count(inside.Step(flow, 0.0, 0.1, Surface.FLOOR, True), Cue.CREAK)
    End For
    Expect(creaks >= 3)
    Local outside = Cues()
    creaks = 0
    For tick = 1 To 300
        creaks += Count(outside.Step(flow, 0.0, 0.1, Surface.ROCK, False), Cue.CREAK)
    End For
    Expect(creaks == 0)
End Function

// With the wheel turning, its creaks are heard from outside too.
@Test
Function TheWheelCreaks()
    Local flow = Quiet()
    Local steps = WalkOf("bright") ?? []
    Local next = 0
    While flow.Ended() == Ending.NONE
        If next < steps.Count && WalkReady(flow, steps[next])
            Select steps[next]
                Case "W"
                    flow.GoOut()
                Case "S"
                    flow.GoBack()
                Case "E"
                    flow.Use()
                Case "Q"
                    flow.Hand()
            End Select
            next += 1
        End If
        flow.Step(0.1)
    End While
    Local cues = Cues()
    Local creaks = 0
    For tick = 1 To 300
        creaks += Count(cues.Step(flow, 0.0, 0.1, Surface.ROCK, False), Cue.CREAK)
    End For
    Expect(creaks >= 3)
End Function

@Test
Function TheWindAndSeaRiseWithTheTide()
    Expect(WindLevel(0.0, False) < WindLevel(RISING_AT, False))
    Expect(WindLevel(RISING_AT, False) < WindLevel(TIDE_IN_AT, False))
    Expect(WindLevel(FLOOD_AT, True) < WindLevel(FLOOD_AT, False))
    Expect(SeaLevel(0.0, False) == SeaLevel(RISING_AT, False))
    Expect(SeaLevel(RISING_AT, False) < SeaLevel(FLOOD_AT, False))
    Expect(SeaLevel(FLOOD_AT, False) < SeaLevel(TIDE_IN_AT, False))
    Expect(SeaLevel(FLOOD_AT, True) < SeaLevel(FLOOD_AT, False))
End Function

// The wind gusts only in the storm, either way, by no more than GUSTS, and whistles higher as it comes;
// the surf rises with the storm and roars from the flood, over 20 seconds; each quieter inside.
@Test
Function TheWindGustsAndTheSurfRoarsWithTheStorm()
    For tick = 0 Until 700
        Expect(Gust((tick As Float64) * 0.1) == 1.0)
    End For
    Local least = 2.0
    Local most = 0.0
    For tick = 0 Until 600
        Local gust = Gust(TIDE_IN_AT + (tick As Float64) * 0.1)
        least = Min(least, gust)
        most = Max(most, gust)
    End For
    Expect(least < 0.9 && least >= 0.7 && most > 1.1 && most <= 1.3)
    // Its swells don't come round in ten minutes: at no lag of a second to 600 are they all within
    // 0.1 of where they were.
    For lag = 10 To 6000
        Local apart = 0.0
        For tick = 0 Until 64
            Local at = (tick As Float64) * 0.73
            apart = Max(apart, Abs(Swells(at) - Swells(at + (lag As Float64) * 0.1)))
        End For
        Expect(apart > 0.1)
    End For
    Expect(WindPitch(0.0) == 1.0 && WindPitch(RISING_AT) == 1.0)
    Expect(WindPitch(FLOOD_AT) > 1.0 && WindPitch(FLOOD_AT) < WindPitch(TIDE_IN_AT))
    Expect(IsClose(WindPitch(TIDE_IN_AT), 1.2, 0.0001))
    Expect(SurfLevel(0.0, False) == SurfLevel(RISING_AT, False))
    Expect(SurfLevel(RISING_AT, False) < SurfLevel(FLOOD_AT, False))
    // Its roar: none until the flood, evenly to all of it 20 seconds on, then held.
    Expect(Roar(FLOOD_AT - 1.0) == 0.0 && Roar(FLOOD_AT) == 0.0)
    Expect(IsClose(Roar(FLOOD_AT + 5.0), 0.25, 0.0001) &&
           IsClose(Roar(FLOOD_AT + 10.0), 0.5, 0.0001))
    Expect(Roar(FLOOD_AT + 20.0) == 1.0 && Roar(TIDE_IN_AT) == 1.0)
    // On top of the storm's: a fifth of slack water's again, all told.
    Local slack = SurfLevel(0.0, False) / 0.2
    Expect(IsClose(SurfLevel(FLOOD_AT + 20.0, False) - SurfLevel(FLOOD_AT, False),
                   ((StormAt(FLOOD_AT + 20.0) - StormAt(FLOOD_AT)) * 0.4 + 0.2) * slack, 0.0001))
    Expect(SurfLevel(TIDE_IN_AT, True) < SurfLevel(TIDE_IN_AT, False))
End Function

// Each part fitted clanks, once, and the sluice opening's heard once, when they happen, in a walk to
// the bright ending; and the works run only once the wheel turns, louder the faster.
@Test
Function TheMillsPartsAndSluiceAreHeardOnceEach()
    Local flow = Quiet()
    Local cues = Cues()
    Local steps = WalkOf("bright") ?? []
    Local next = 0
    Local fits = 0
    Local sluices = 0
    Local fittedWhenHeard = 0
    While flow.Ended() == Ending.NONE
        If next < steps.Count && WalkReady(flow, steps[next])
            Select steps[next]
                Case "W"
                    flow.GoOut()
                Case "S"
                    flow.GoBack()
                Case "E"
                    flow.Use()
                Case "Q"
                    flow.Hand()
            End Select
            next += 1
        End If
        flow.Step(0.1)
        For cue In cues.Step(flow, 0.0, 0.1, Surface.ROCK, False)
            If cue == Cue.FIT
                fits += 1
                fittedWhenHeard = 0
                For part In [Part.GEAR, Part.PADDLE, Part.BELT]
                    If flow.Fitted(part) Then fittedWhenHeard += 1
                End For
                Expect(fittedWhenHeard == fits)
            End If
            If cue == Cue.SLUICE
                sluices += 1
                Expect(flow.SluiceOpen())
            End If
        End For
    End While
    Expect(fits == 3)
    Expect(sluices == 1)
    For tick = 1 To 50
        For cue In cues.Step(flow, 0.0, 0.1, Surface.ROCK, False)
            Expect(cue != Cue.FIT && cue != Cue.SLUICE)
        End For
    End For
    Expect(WorksLevel(0.0) == 0.0)
    Expect(WorksLevel(0.6) > 0.0 && WorksLevel(0.6) < WorksLevel(1.0))
End Function

// The music crossfades from the calm theme to the storm's at equal power, so it's as loud all through,
// with no step between two moments a hundredth of a second apart; it's all calm at slack water, all
// storm once it's in, and quieter inside.
@Test
Function TheMusicTurnsWithTheWeatherAndTide()
    Local slack = MusicLevels(0.0, False)
    Expect(slack.1 == 0.0 && slack.0 > 0.0)
    Local whole = slack.0
    Local storm = MusicLevels(TIDE_IN_AT, False)
    Expect(storm.0 >= 0.0 && storm.0 < 0.0001 && IsClose(storm.1, whole, 0.0001))
    Expect(MusicLevels(FLOOD_AT + 20.0, False).0 >= 0.0)
    Local was = slack
    For tick = 0 To 30000
        Local clock = (tick As Float64) * 0.01
        Local now = MusicLevels(clock, False)
        // A volume, never under 0, at the storm's height too.
        Expect(now.0 >= 0.0 && now.1 >= 0.0)
        Expect(IsClose(now.0 * now.0 + now.1 * now.1, whole * whole, 0.000001))
        Expect(Abs(now.0 - was.0) < 0.0005 && Abs(now.1 - was.1) < 0.0005)
        Expect(now.1 >= was.1 - 0.0000001)
        was = now
        Local inside = MusicLevels(clock, True)
        Expect(IsClose(inside.0, now.0 * 0.7, 0.000001) && IsClose(inside.1, now.1 * 0.7, 0.000001))
    End For
    Expect(Tension(RISING_AT) == 0.0 && Tension(FLOOD_AT) > StormAt(FLOOD_AT) - 0.0001)
    Expect(Tension(FLOOD_AT + 20.0) > StormAt(FLOOD_AT + 20.0))
End Function

// The music ducks under a cue, in a line, to half in 0.15 s, holds a second after the last, and comes
// back over 0.8 s, never stepping more than that rate allows.
@Test
Function TheMusicDucksUnderACueWithoutAClick()
    Local ducking = Ducking()
    Expect(ducking.Step(0.01, False) == 1.0)
    Local was = 1.0
    Local tick = 0
    Local reachedAt = -1
    Local backAt = -1
    For step = 1 To 400
        Local now = ducking.Step(0.01, step == 10 || step == 50)
        Expect(Abs(now - was) <= 0.5 * 0.01 / 0.15 + 0.000001)
        If reachedAt < 0 && now <= 0.5 + 0.000001 Then reachedAt = step
        If reachedAt > 0 && backAt < 0 && now >= 1.0 - 0.000001 Then backAt = step
        was = now
    End For
    // Half by 15 hundredths after the first; held until a second after the second, at 50; back by
    // 0.8 s after that.
    Expect(reachedAt >= 24 && reachedAt <= 26)
    Expect(backAt >= 228 && backAt <= 232)
End Function

// What can sound at once, each at the tools' peak, doesn't clip: to the end, the sluice opening as the
// wheel and works start, a part being fitted, and the flood.
@Test
Function NothingAtOnceClips()
    Local loudestBeds = 0.0
    For tick = 0 Until 600
        Local clock = TIDE_IN_AT + (tick As Float64) * 0.1
        loudestBeds = Max(loudestBeds, WindLevel(clock, False) + SeaLevel(clock, False) +
                          SurfLevel(clock, False))
    End For
    // The music, both themes at once, at their peak, ducked under the cues.
    Local music = (MusicLevels(FLOOD_AT, False).0 + MusicLevels(FLOOD_AT, False).1) * 0.6 * 0.5
    Local toTheEnd = loudestBeds * 0.7 + WheelLevel(1.0) * 0.7 + WorksLevel(1.0) * 0.6 +
                     CueLevel(Cue.STEP_1) * 0.7 + CueLevel(Cue.CREAK) * 0.6 +
                     CueLevel(Cue.SLUICE) * 0.7 + music
    Expect(toTheEnd < 1.0)
    // A part fitted, before the wheel turns.
    Local fitting = loudestBeds * 0.7 + CueLevel(Cue.FIT) * 0.6 + CueLevel(Cue.STEP_1) * 0.7 +
                    CueLevel(Cue.CREAK) * 0.6 + music
    Expect(fitting < 1.0)
    Local floodBeds = 0.0
    For tick = 0 To 9
        Local clock = FLOOD_AT + (tick As Float64) * 0.1
        floodBeds = Max(floodBeds, WindLevel(clock, False) + SeaLevel(clock, False) +
                        SurfLevel(clock, False))
    End For
    Local atTheFlood = floodBeds * 0.7 + CueLevel(Cue.SPLASH) * 0.8 + CueLevel(Cue.STEP_1) * 0.7 +
                       CueLevel(Cue.GULL) * 0.6 + music
    Expect(atTheFlood < 1.0)
End Function

// The low-pass goes from open to muffled, by its octaves, over half a second, and never to
// nothing.
@Test
Function TheCutoffRamps()
    Expect(OutsideCutoff(True) >= 300.0 && OutsideCutoff(True) <= 400.0)
    Expect(OutsideCutoff(False) > 0.0)
    Local open = OutsideCutoff(False)
    Local muffled = OutsideCutoff(True)
    Local at = open
    Local steps = 0
    While at != muffled && steps < 100
        Local next = CutoffToward(at, muffled, 1.0 / 60.0)
        Expect(next < at)
        Expect(next / at > 0.5)
        at = next
        steps += 1
    End While
    Expect(at == muffled)
    Expect(steps >= 10)
    Expect(CutoffToward(muffled, open, 0.5) == open)
End Function

// The wheel's heard and drawn at one speed, so its pitch and turning keep their ratio.
@Test
Function TheWheelTurnsByHowItEnded()
    Expect(WheelSpeed(Ending.NONE) == 0.0)
    Expect(WheelSpeed(Ending.DARK) == 0.0)
    Expect(WheelSpeed(Ending.DIM) > 0.0)
    Expect(WheelSpeed(Ending.DIM) < WheelSpeed(Ending.BRIGHT))
End Function
