// The sea: a sheet at the tide's height, drawn by a shader of its own, assets/water.slang. Its normals
// are two tiles of waves scrolled across each other; its color, how much it hides, and its foam go by
// how deep it is over the ground, which it reads from a map of the ground's heights made once. Smooth,
// so what it mostly shows is the sky, by the Environment.

Import std.core
Import std.image.hdr
Import std.math
Import fbengine
Import "./ground"
Import "./res" As Res
Import "./sky"

// How far the sheet goes each way from the middle, past any fog.
Const SHEET: Float = 3000.0
// The tile of waves: its texels, and how many meters across each of the two scrolled is, which way it
// goes, and how fast.
Const WAVES_SIDE: Int = 256
Const TILE: Float = 48.0
Const OTHER_TILE: Float = 19.0
Const SPEED: Float = 0.9
Const OTHER_SPEED: Float = 0.55
// The map of the ground under it: its texels, and how far below 0 the lowest it holds is, as a half
// float of a texture holds nothing below 0.
Const GROUND_SIDE: Int = 512
Const GROUND_BELOW: Float = 10.0
// How much a bright sky shows in it: a low roughness, and how much the normals are of what's in them.
Const ROUGHNESS: Float = 0.2
Const NORMALS: Float = 1.0
// How many meters across the patches the wind makes on it are, what roughens the sheet's far parts.
Const PATCHES: Float = 900.0
// Its colors, as they're stored: the deep's, the shallows', and the foam's.
Const DEEP: Color = Color(0.1, 0.3, 0.38)
Const SHALLOW: Color = Color(0.22, 0.52, 0.52)
Const FOAM: Color = Color(0.95, 0.97, 0.95)

// A sine's values, by a whole turn in this many steps, a power of 2.
Const TURN: Int = 1024

/// How many steps of a sine a wave's made of: across and along a tile, by whole waves so it tiles;
/// how steep it is; and where it starts.
Struct Wave
    Field across: Int
    Field along: Int
    Field steep: Float
    Field start: Int
End Struct

// Many, none long, so what's seen from far off has little to repeat by, and the steepness is in the
// short ones, as water's is; all ways, mostly with the wind.
Function Waves(): Wave[]
    Return [Wave(9, 2, 0.02, 0), Wave(7, -6, 0.018, 311), Wave(6, 11, 0.018, 97),
            Wave(13, 4, 0.025, 640), Wave(11, -9, 0.022, 203), Wave(17, 3, 0.028, 871),
            Wave(8, -15, 0.02, 450), Wave(21, 8, 0.03, 12), Wave(25, -6, 0.03, 733),
            Wave(19, 17, 0.024, 529), Wave(31, 7, 0.032, 158), Wave(35, -13, 0.03, 902),
            Wave(41, 11, 0.028, 366), Wave(47, -18, 0.024, 684), Wave(37, 29, 0.022, 75),
            Wave(57, 6, 0.02, 590), Wave(63, -23, 0.016, 417), Wave(71, 19, 0.012, 266)]
End Function

/// A normal's texel, its red, green, and blue, for a surface that slopes by these across and along:
/// rounded, so a flat one's 128, 128, 255.
Public Function NormalTexel(slopeX: Float, slopeY: Float): (UInt8, UInt8, UInt8)
    Local size = 1.0 / Sqrt(slopeX * slopeX + slopeY * slopeY + 1.0)
    Return (Round((-slopeX * size * 0.5 + 0.5) * 255.0) As UInt8,
            Round((-slopeY * size * 0.5 + 0.5) * 255.0) As UInt8,
            Round((size * 0.5 + 0.5) * 255.0) As UInt8)
End Function

/// The waves' tile of normals, row by row, with no alpha: its top and bottom, and left and right, are
/// neighbors.
Public Function WaveTile(): UInt8[]
    Local cosine: Float[] = []
    For step = 0 Until TURN
        cosine.Add(Cos((step As Float) / (TURN As Float) * 6.2831853))
    End For
    Local waves = Waves()
    // A texel's steps of each wave, along each way, whole as the side divides a turn.
    Local perTexel = TURN / WAVES_SIDE
    Local bytes: UInt8[] = []
    For y = 0 Until WAVES_SIDE
        For x = 0 Until WAVES_SIDE
            Local slopeX: Float = 0.0
            Local slopeY: Float = 0.0
            For wave In waves
                Local step = (wave.across * x + wave.along * y) * perTexel + wave.start
                Local value = cosine[step & (TURN - 1)]
                Local long = Sqrt(((wave.across * wave.across + wave.along * wave.along) As Float))
                slopeX += wave.steep * (wave.across As Float) / long * value
                slopeY += wave.steep * (wave.along As Float) / long * value
            End For
            Local r, g, b = NormalTexel(slopeX, slopeY)
            bytes.Add(r)
            bytes.Add(g)
            bytes.Add(b)
            bytes.Add(0)
        End For
    End For
    Return bytes
End Function

// A color as it's stored, in linear light, as a shader's given it.
Function Linear(stored: Color): Vec3
    Local decode = Function(value: Float): Float
        Return value <= 0.04045 ? value / 12.92 : Exp(Log((value + 0.055) / 1.055) * 2.4)
    End Function
    Return Vec3(decode(stored.r), decode(stored.g), decode(stored.b))
End Function

// Patches of wind on the water, as what multiplies its roughness, in green: mostly calm, some rough;
// and the most it does, from 0 to 1.
@MainThread
Function WindPatches(): (Texture, Float) Throws GraphicsError
    Local side: Int32 = 256
    Local bytes: UInt8[] = []
    Local most: Int = 0
    For y = 0 Until side
        For x = 0 Until side
            // Noise that tiles, by mixing its ends with what's beyond them.
            Local along = (x As Float) / (side As Float)
            Local down = (y As Float) / (side As Float)
            Local here = TiledNoise(along, down)
            Local rough = 0.3 + 0.7 * Smooth(0.42, 0.62, here)
            bytes.Add(255)
            Local level = Round(rough * 255.0) As Int
            most = Max(most, level)
            bytes.Add(level As UInt8)
            bytes.Add(0)
            bytes.Add(255)
        End For
    End For
    Local patches = Try Texture(side, side, TextureFormat.RGBA8_LINEAR, True)
    patches.WritePixels(0, 0, side, side, bytes)
    Return (patches, (most As Float) / 255.0)
End Function

// Noise of a few octaves over a square whose opposite edges meet.
Function TiledNoise(x: Float, y: Float): Float
    Local sum: Float = 0.0
    Local weight: Float = 0.5
    Local cells = 6
    For octave = 0 Until 4
        Local across = x * (cells As Float)
        Local down = y * (cells As Float)
        Local left = Floor(across) As Int
        Local top = Floor(down) As Int
        Local u = across - Floor(across)
        Local v = down - Floor(down)
        u = u * u * (3.0 - 2.0 * u)
        v = v * v * (3.0 - 2.0 * v)
        Local a = LatticeAt(left % cells, top % cells, octave)
        Local b = LatticeAt((left + 1) % cells, top % cells, octave)
        Local c = LatticeAt(left % cells, (top + 1) % cells, octave)
        Local d = LatticeAt((left + 1) % cells, (top + 1) % cells, octave)
        sum += weight * (a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v)
        weight *= 0.5
        cells *= 2
    End For
    Return sum / 0.9375
End Function

// A lattice point's number, from 0 to 1, by SoftNoise's, each octave its own.
Function LatticeAt(x: Int, y: Int, octave: Int): Float
    Return SoftNoise((x As Float) + (octave As Float) * 97.0,
                     (y As Float) + (octave As Float) * 61.0)
End Function

// The map of the ground under the sea, in half floats, so what's between its texels is: the ground's
// height in red, GROUND_BELOW over it, what breaks the foam up in green, and no alpha, over the
// terrain's square.
@MainThread
Function GroundMap(): Texture Throws GraphicsError
    Local values: Float32[] = []
    For y = 0 Until GROUND_SIDE
        For x = 0 Until GROUND_SIDE
            Local placeX = ((x As Float) + 0.5) / (GROUND_SIDE As Float) * (SIDE As Float) -
                           (SIDE As Float) * 0.5
            Local placeZ = ((y As Float) + 0.5) / (GROUND_SIDE As Float) * (SIDE As Float) -
                           (SIDE As Float) * 0.5
            values.Add(Max(GroundHeight(placeX, placeZ) + GROUND_BELOW, 0.0) As Float32)
            Local broken = 0.3 + 0.28 * SoftNoise(placeX * 0.35, placeZ * 0.35) +
                           0.3 * SoftNoise(placeX * 1.3 + 40.0, placeZ * 1.3)
            values.Add(Clamp(broken, 0.0, 1.0) As Float32)
            values.Add(0.0)
            values.Add(0.0)
        End For
    End For
    Local map = Try Texture.FromHdr(HdrImage.FromFloats(GROUND_SIDE, GROUND_SIDE, values), False)
    map.SetWrap(TextureWrap.CLAMP, TextureWrap.CLAMP)
    Return map
End Function

/// The sheet of sea and what it's drawn with.
Public Final Class Sea
    Field sheet: Mesh
    Field water: Material
    Field mostRough: Float = 0.0

    New(sheet: Mesh, water: Material, mostRough: Float)
        Self.sheet = sheet
        Self.water = water
        Self.mostRough = mostRough
        Update(0.0)
    End New

    /// Makes it; what it's made of's kept in `held`.
    @MainThread
    Public Static Method Make(held: Texture[]): Sea Throws GraphicsError, IOError
        Local tile = Try Texture(WAVES_SIDE As Int32, WAVES_SIDE As Int32,
                                 TextureFormat.RGBA8_LINEAR,
                                 True)
        tile.WritePixels(0, 0, WAVES_SIDE As Int32, WAVES_SIDE As Int32, WaveTile())
        held.Add(tile)
        Local ground = Try GroundMap()
        held.Add(ground)
        Local patches, mostPatched = Try WindPatches()
        held.Add(patches)

        Local deep = Linear(DEEP)
        Local water = Material(Color(deep.x, deep.y, deep.z))
        water.SetMetalRough(0.0, ROUGHNESS)
        water.SetNormalScale(NORMALS)
        water.SetBlend(Blend.ALPHA)
        // Neither colors it: each is laid over by an alpha of none, and water.slang reads them.
        water.SetTexture(0, ground)
        water.SetLayer(0, LayerBlend.ALPHA)
        water.SetTexture(1, tile)
        water.SetLayer(1, LayerBlend.ALPHA)
        water.SetMap(MaterialMap.METAL_ROUGH, patches)
        Local patchScale = PATCHES / (SHEET * 2.0)
        water.SetMapUv(MaterialMap.METAL_ROUGH, UvTurn(Vec2(patchScale, patchScale), 0.0,
                                                       Vec2(0.0, 0.0)))
        water.SetShader(Try Assets.Load<Shader>(Res.Water))
        water.SetParameter(1, Vec4(TILE, 0.92, 0.39, SPEED))
        water.SetParameter(2, Vec4(OTHER_TILE, -0.45, 0.89, OTHER_SPEED))
        water.SetParameter(3, Vec4(deep.x, deep.y, deep.z, 0.0))
        Local shallow = Linear(SHALLOW)
        water.SetParameter(4, Vec4(shallow.x, shallow.y, shallow.z, 0.0))
        Local foam = Linear(FOAM)
        water.SetParameter(5, Vec4(foam.x, foam.y, foam.z, GROUND_BELOW))

        Local sheet = Mesh(Geometry.Plane(1))
        sheet.SetScale(Vec3(SHEET, 1.0, SHEET))
        sheet.SetMaterial(water)
        Return Sea(sheet, water, ROUGHNESS * mostPatched)
    End Method

    /// Sets it as it is `clock` seconds into the slack water.
    @MainThread
    Public Method Update(clock: Float64)
        Local height = SeaHeight(clock)
        sheet.SetPosition(Vec3(0.0, height, 0.0))
        // Its time, from 0 to an hour and back, so a float's steps stay small.
        Local time = (clock % 3600.0) As Float
        water.SetParameter(0, Vec4(height, time, (SIDE As Float) * 0.5, SHEET))
    End Method

    /// Stills it, a mirror, to see what's in it, or sets it going again.
    @MainThread
    Public Method SetStill(still: Bool)
        Local deep = Linear(DEEP)
        water.SetParameter(3, Vec4(deep.x, deep.y, deep.z, still ? 1.0 : 0.0))
        water.SetMetalRough(0.0, still ? 0.02 : ROUGHNESS)
    End Method

    /// How rough it's drawn at most: its roughness, times the most its patches of wind make it.
    @MainThread Public Method MostRough(): Float => mostRough

    /// How high it's drawn.
    @MainThread Public Method DrawnAt(): Float => sheet.Position().y

    /// What it's drawn with.
    @MainThread Public Method Shown(): Material => water
End Class
