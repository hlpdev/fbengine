// A player walks through a door on its hinges, pushing it open, into a room whose sensor notices
// it come in: a character, a joint, and a trigger, stepped at 60 a second.

Import std.core
Import std.math
Import fbengine_physics

Local world = PhysicsWorld()
Body(world, Shape.Box(Vec3(20, 1, 20)), Motion.STATIC, Vec3(0, -0.5, 0))

// A door a meter wide across the way at z = -3, hung on its left edge.
Local door = Body(world, Shape.Box(Vec3(1, 2, 0.1)), Motion.DYNAMIC, Vec3(0.5, 1, -3))
door.SetMass(10)
Local hinge = Joint.Hinge(door, Null, Vec3(0, 1, -3), Vec3(0, 1, 0))
hinge.SetLimits(-Pi / 2, Pi / 2)

// The room past it, which notices what comes in.
Local room = Body(world, Shape.Box(Vec3(6, 3, 4)), Motion.STATIC, Vec3(0, 1.5, -6))
room.SetSensor(True)

Local player = Character(world, Shape.Capsule(1.8, 0.3), Vec3(0.5, 0.9, 0))
Local entered = False
Local fall: Float = 0
For frame = 1 To 240
    fall = player.OnGround() ? 0.0 : fall - 9.81 / 60
    player.Move(Vec3(0, fall, -1.5), 1.0 / 60)
    world.Update(1.0 / 60)
    For contact In world.Began()
        If (contact.A == room && contact.B == player.Body()) ||
           (contact.B == room && contact.A == player.Body())
            entered = True
        End If
    End For
End For

Print("the door swung open: {Abs(hinge.Position()) > 0.5}")
Print("the player walked into the room: {entered}, and is in it: {room.Touching().Contains(player.Body())}")
world.Free()
