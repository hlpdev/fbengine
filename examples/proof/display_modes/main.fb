// The display's modes, and the window as a game's settings choose it: windowed, fullscreen, or
// borderless at the desktop's size, and a screen of its own size scaled into it. It prints what it
// found; with --watch, a window that goes through each, and back.

Import std.collections
Import std.core
Import std.math
Import std.os
Import fbengine

Function Proved() Throws GraphicsError
    Window.SetHeadless(True)
    Try Graphics(640, 360)
    Defer EndGraphics()
    Local displays = Try Displays()
    Print("there's a display {displays.Count > 0}")
    Local main = displays[0]
    Print("its desktop's a size {main.Desktop.Width > 0 && main.Desktop.Height > 0}")
    // Its modes for fullscreen, largest first; those a settings menu lists.
    Local largestFirst = True
    For i = 1 To main.Modes.Count - 1
        If main.Modes[i].Width > main.Modes[i - 1].Width Then largestFirst = False
    End For
    Print("its modes go largest first {largestFirst}")
    Print("windowed at first {Window.Mode()}, {Window.Width()} by {Window.Height()}")
    // A headless window stays as it is in each, as it has no display to fill; a real one's in --watch.
    For mode In [WindowMode.BORDERLESS, WindowMode.FULLSCREEN, WindowMode.WINDOWED]
        Try
            Try Window.SetMode(mode)
            Print("asked for {mode}: {Window.Mode()}")
        Catch e As GraphicsError
            Print("asked for {mode}: {e.Message}")
        End Try
    End For
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    // A screen of its own size, which the window shows scaled, as a game's render scale is.
    Flip()
    Screen.SetSize(320, 180)
    Print("the screen's {Screen.Width()} by {Screen.Height()}, its own {!Screen.FollowsWindow()}")
    Local shown = Screen.Area()
    Print("shown in {shown?.Width ?? 0.0} by {shown?.Height ?? 0.0} of the window")
    Screen.SetSize(0, 0)
    Print("the window's again {Screen.Width()} by {Screen.Height()}, {Screen.FollowsWindow()}")
End Function

// A window that goes through each mode, 3 seconds each, and back; or `frames` frames offscreen.
Function Watched(frames: Int) Throws GraphicsError
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("display modes: Escape ends it")
    Frame.SetLimit(60)
    Local font = Font.BuiltIn(18.0)
    Local main = (Try Displays())[0]
    Local modes = [WindowMode.WINDOWED, WindowMode.BORDERLESS, WindowMode.WINDOWED,
                   WindowMode.FULLSCREEN, WindowMode.WINDOWED]
    Local at = 0
    Local waited: Float64 = 0.0
    Local count = 0
    Local said = ""
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        waited += frames > 0 ? 3.0 : Frame.Delta()
        If waited >= 3.0
            waited = 0.0
            at = (at + 1) % modes.Count
            Try
                Try Window.SetMode(modes[at])
                said = ""
            Catch e As GraphicsError
                said = e.Message
            End Try
        End If
        If Screen.Texture() == Null Then Continue
        Local canvas = Screen.Canvas()
        canvas.SetColor(Color32(24, 28, 36, 255))
        canvas.Clear()
        canvas.SetColor(Color32(230, 232, 235, 255))
        canvas.DrawText(font, "{Window.Mode()}, {Window.Width()} by {Window.Height()}; screen {Screen.Width()} by {Screen.Height()}", 16, 16)
        canvas.DrawText(font,
                        "desktop {main.Desktop}, {main.Modes.Count} modes for fullscreen {said}",
                        16, 44)
        // A square a pixel from each corner, to see it's all shown.
        Local wide = Screen.Width()
        Local high = Screen.Height()
        canvas.SetColor(Color32(76, 141, 255, 255))
        canvas.DrawRect(1, high - 21, 20, 20)
        canvas.DrawRect(wide - 21, high - 21, 20, 20)
    End While
    If Window.Open() Then Try Window.SetMode(WindowMode.WINDOWED)
    Print("watched {count} frames")
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

Local arguments = Process.Arguments()
If arguments.Contains("--watch")
    Try Watched(Asked(arguments))
Else
    Try Proved()
End If
