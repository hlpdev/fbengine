// A generator of the numbers an old game's seeds gave: the same seed, the same sequence, whatever the
// machine. The values it prints were worked out apart from it, by the multiplier alone, without
// Schrage's method: its 10000th from a seed of 1 is 399268537, the value Park and Miller's own test
// gives for this multiplier. With --watch, a window of where it falls, by bars.

Import std.collections
Import std.core
Import std.math
Import std.os
Import "./park_miller"
Import fbengine

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

// Whether any of the screen's pixels isn't what's in its corner, as what's behind everything is.
Function Drew(): Bool Throws GraphicsError
    Local image = Try Screen.ToImage()
    Local behind = image[0, 0]
    For y = 0 To image.Height - 1
        For x = 0 To image.Width - 1
            If image[x, y] != behind Then Return True
        End For
    End For
    Return False
End Function

// The next `count` of `next`.
Function Taken(count: Int, next: Func(): String): String
    Local said: String[] = []
    For i = 1 To count
        said.Add(next())
    End For
    Return said.Join(", ")
End Function

Function Proved()
    // At first, before any seed, 0x1234: 4660 x 48271 is 224942860, within its 31 bits.
    Local dice = ParkMiller()
    Print("at first its state {dice.State()}")
    Print("its first numbers {Taken(5, Function() => "{dice.Next()}")}")
    Print("then its state {dice.State()}")

    // The value Park and Miller's own test gives, which goes through every branch of Schrage's.
    dice.Seed(1)
    For i = 1 To 10000
        dice.Next()
    End For
    Print("the 10000th from 1 {dice.State()}")

    // Whole numbers, and each way round.
    dice.Seed(42)
    Print("from 1 to 6 {Taken(8, Function() => "{dice.NextInt(1, 6)}")}")
    dice.Seed(42)
    Print("from -3 to 1 {Taken(8, Function() => "{dice.NextInt(-3, 1)}")}")
    dice.Seed(42)
    Print("from 1 to -3, the same {Taken(8, Function() => "{dice.NextInt(1, -3)}")}")
    dice.Seed(42)
    Print("floats from -5 to 5 {Taken(4, Function() => "{dice.NextFloat(-5.0, 5.0):.4}")}")

    // The same seed the same sequence, and another another.
    dice.Seed(7)
    Local first = Taken(6, Function() => "{dice.NextInt(0, 999)}")
    dice.Seed(7)
    Local again = Taken(6, Function() => "{dice.NextInt(0, 999)}")
    dice.Seed(8)
    Local other = Taken(6, Function() => "{dice.NextInt(0, 999)}")
    Print("the same seed the same {first == again}, another another {first != other}")

    // Its seed's low 31 bits, 0 being 1; and all ones stuck at 0, its floats half a step above it.
    dice.Seed(0)
    Print("a seed of 0 is {dice.State()}")
    dice.Seed(-2147483647)
    Print("a seed with its top bit is {dice.State()}")
    dice.Seed(-1)
    Print("a seed of all ones is {dice.State()}")
    Print("then {dice.Next()}, its state {dice.State()}, and {dice.Next()}")

    // A seed in words: 97 ^ (98 << 1) ^ (99 << 2), and around after 24 characters.
    Print("the seed of abc {SeedOfWords("abc")}")
    Print("of 25 a's {SeedOfWords("aaaaaaaaaaaaaaaaaaaaaaaaa")}")

    // What it isn't: std.math's Random, from the same seed, gives others.
    Local other32 = Random(42)
    Print("std's Random from 42 isn't it {(other32.Float() As Float32) != ParkMillerFirst(42)}")
End Function

// The first number from `seed`.
Function ParkMillerFirst(seed: Int32): Float32
    Local dice = ParkMiller()
    dice.Seed(seed)
    Return dice.Next()
End Function

// A window of 32 bars of where its numbers fall, filling evenly; or `frames` frames offscreen.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("seeded random: Escape ends it")
    Frame.SetLimit(60)
    Local font = Font.BuiltIn(18.0)
    Local dice = ParkMiller()
    dice.Seed(42)
    Local bars: Int[] = []
    For i = 0 To 31
        bars.Add(0)
    End For
    Local count = 0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        For i = 1 To 200
            bars[dice.NextInt(0, 31)] += 1
        End For
        Local canvas = Screen.Canvas()
        canvas.SetColor(Color32(24, 28, 36, 255))
        canvas.Clear()
        canvas.SetColor(Color32(76, 141, 255, 255))
        Local most = 1
        For each In bars
            most = Max(most, each)
        End For
        For i = 0 To 31
            Local tall = (bars[i] * 360 / most) As Int32
            canvas.DrawRect(16 + (i As Int32) * 24, 430 - tall, 20, tall)
        End For
        canvas.SetColor(Color32(230, 232, 235, 255))
        canvas.DrawText(font, "32 bars from seed 42, its state {dice.State()}", 16, 16)
    End While
    Print("drew {Try Drew()}")
    Print("watched {count} frames")
End Function

Local arguments = Process.Arguments()
If !arguments.Contains("--watch")
    Proved()
ElseIf Env.Get("FBENGINE_NO_GPU") == "1"
    Print("no GPU here")
Else
    Try Watched(Asked(arguments), arguments)
End If
