// The scene as a tree: parents and children, what's inherited, names and finding by them, children
// in the order they were made, copying a whole tree, hiding and showing, and every way of moving. It
// prints what each did; with --watch, a window of a turning room, its door swinging, a copy beside it,
// a part hiding and showing.
//
// Its degrees and left-handed axes, Blitz's, are a recorded difference: radians, and right-handed, -Z
// forward.

Import std.core
Import std.image.image
Import std.math
Import fbengine
Import std.collections
Import std.os

Function Shown(at: Vec3): String => "{at.x:.2}, {at.y:.2}, {at.z:.2}"

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

// Whether two colors are within 2 of each other in each channel, as a GPU's rounding of what's
// encoded leaves them.
Function Near(got: Color32, wanted: Color32): Bool
    Return Abs((got.r As Int) - (wanted.r As Int)) <= 2 &&
           Abs((got.g As Int) - (wanted.g As Int)) <= 2 &&
           Abs((got.b As Int) - (wanted.b As Int)) <= 2
End Function

// `wanted` if `got` is near it, else `got`, to print.
Function Shown(got: Color32, wanted: Color32): Color32 => Near(got, wanted) ? wanted : got

// What's drawn where `camera` sees `place`.
Function Seen(camera: Camera, image: Image, place: Vec3): Color32
    Local at = camera.Project(place) ?? Vec3(0, 0, 0)
    Return image[at.x As Int, at.y As Int]
End Function

// A material of no lighting.
Function Painted(color: Color): Material
    Local made = Material()
    made.SetShading(Shading.UNLIT)
    made.SetColor(color)
    Return made
End Function

// A window's camera at `at`, looking at `looking`, over almost black.
Function Watching(at: Vec3, looking: Vec3): Camera
    Local camera = Camera()
    camera.SetPosition(at)
    camera.PointAt(looking)
    camera.SetClearColor(Color(0.02, 0.02, 0.03))
    Return camera
End Function

// A window of a room of a door and its handle, a copy of it, each turning, a part of it blinking; or
// `frames` frames offscreen.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("scene trees: Escape ends it")
    Frame.SetLimit(60)
    Local world = World()
    World.SetCurrent(world)
    Defer world.Free()
    Local room = Mesh(Geometry.Cube())
    room.SetName("room")
    room.SetScale(Vec3(1, 0.1, 1))
    room.SetMaterial(Painted(Color(0.2, 0.2, 0.3)))
    Local door = Mesh(Geometry.Cube(), room)
    door.SetName("door")
    door.SetPosition(Vec3(0, 6, 0))
    door.SetScale(Vec3(0.3, 5, 0.1))
    door.SetMaterial(Painted(Color(0.7, 0.4, 0.2)))
    Local handle = Mesh(Geometry.Sphere(), door)
    handle.SetName("handle")
    handle.SetPosition(Vec3(0.8, 0, 2))
    handle.SetScale(Vec3(0.3, 0.1, 1))
    handle.SetMaterial(Painted(Color(0.9, 0.9, 0.3)))
    room.SetPosition(Vec3(-2.5, 0, -7))
    Local copy = room.Copy()
    copy.SetPosition(Vec3(2.5, 0, -7))
    Local shut = copy.Find("door")
    Local camera = Watching(Vec3(0, 3, 0), Vec3(0, 0.5, -7))
    Local time: Float = 0.0
    Local count = 0
    Local blinks = 0
    Local wrong = 0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        Local seconds = frames > 0 ? 0.1 : Frame.Delta() As Float
        time += seconds
        room.SetRotation(Quat.FromEuler(0.0, time * 0.7, 0.0))
        copy.SetRotation(Quat.FromEuler(0.0, -time * 0.5, 0.0))
        door.SetRotation(Quat.FromEuler(0.0, Sin(time) * 0.8, 0.0))
        If shut != Null
            If (Floor(time) As Int) % 2 == 0 Then shut.Hide() Else shut.Show()
        End If
        RenderWorld()
        // Each frame, the copy's door's color on the copy's side of the view, the right, just while
        // it isn't hidden, as it turns edge on too.
        If frames > 0 && shut != Null
            Local image = Try Screen.ToImage()
            Local drawn = False
            For y = 0 Until image.Height Step 2
                For x = image.Width / 2 Until image.Width Step 2
                    If Near(image[x, y], Color32(218, 170, 124, 255)) Then drawn = True
                End For
            End For
            If shut.Hidden() Then blinks += 1
            If drawn == shut.Hidden() Then wrong += 1
        End If
    End While
    If count == frames
        // Each where its parents have it, in its color, stored: a door's 218, 170, 124, and its
        // handle's 242, 242, 149 where it's on the door's side the camera sees, else the door's.
        Local shown = Try Screen.ToImage()
        Local doorAt = door.Position(Space.WORLD)
        Local handleAt = handle.Position(Space.WORLD)
        Local seenSide = Dot(handleAt - doorAt, camera.Position(Space.WORLD) - doorAt) > 0.0
        Local wanted = seenSide ? Color32(242, 242, 149, 255) : Color32(218, 170, 124, 255)
        Print("a door {Shown(Seen(camera, shown, doorAt), Color32(218, 170, 124, 255))}, its handle on the side it's seen from {seenSide}, drawn so {Near(Seen(camera, shown, handleAt), wanted)}")
        If shut != Null
            Print("the copy's door hidden {blinks} frames of {count}, drawn just while it's not {wrong == 0}")
        End If
    End If
    Print("watched {count} frames")
End Function

// To a thousandth.
Function Fine(at: Vec3): String => "{at.x:.3}, {at.y:.3}, {at.z:.3}"

// Every way of moving's sums, what a copy keeps, and alpha 0, which still collides and picks.
Function WaysAndCopies() Throws GraphicsError
    Local world = World()
    World.SetCurrent(world)
    world.SetCollisionResponse(1, 2, CollisionResponse.STOP)

    Local parent = Pivot()
    parent.SetPosition(Vec3(10, 0, 0))
    parent.Turn(0, Deg(90), 0)
    Local child = Pivot(parent)
    child.SetPosition(Vec3(0, 0, -2))
    Print("TransformPoint: {Fine(TransformPoint(Vec3(0, 1, 0), child, Null))}, into the parent {Fine(TransformPoint(Vec3(0, 1, 0), child, parent))}")
    Print("TransformVector: {Fine(TransformVector(Vec3(0, 0, -1), parent, Null))}")
    Local at = Pivot()
    Print("YawTo a place to its left {at.YawTo(Vec3(-1, 0, 0)):.3}, PitchTo above {at.PitchTo(Vec3(0, 1, -1)):.3}")
    Print("YawOf {YawOf(Vec3(-1, 0, 0)):.3}, PitchOf {PitchOf(Vec3(0, 1, -1)):.3}")
    at.AlignTo(Vec3(1, 0, 0))
    Print("AlignTo: forward {Fine(at.Forward())}")
    at.SetRotation(0, 0, 0)
    at.Turn(0, Deg(90), 0)
    at.Turn(Deg(90), 0, 0, Space.WORLD)
    Print("Turn in the world: forward {Fine(at.Forward())}")

    // A copy collides and picks as its original, and a mesh keeps its geometry and what's hidden.
    Local room = Pivot()
    room.SetName("room")
    Local door = Mesh(Geometry.Cube(), room)
    door.SetName("door")
    door.SetCollisionGroup(2)
    door.SetPickMode(PickMode.MESH)
    door.SetBlocksSight(True)
    door.SetAlpha(0.5)
    Local lamp = Pivot(room)
    lamp.SetName("lamp")
    lamp.Hide()
    Local copy = room.Copy()
    Local copiedDoor = copy.Find("door") ?? copy
    Print("a copy's door: kind {copiedDoor.Kind()}, group {copiedDoor.CollisionGroup()}, pick {copiedDoor.PickMode()}, blocks {copiedDoor.BlocksSight()}, bounds {Fine(copiedDoor.Bounds().Max)}")
    Print("its lamp hidden {(copy.Find("lamp") ?? copy).Hidden()}")
    copy.Free()

    // Alpha 0: not drawn, but it still collides and picks.
    door.SetName("the door")
    door.SetAlpha(0)
    Local picked = world.Pick(Vec3(0, 5, 0), Vec3(0, -5, 0))
    Print("alpha 0: showing {door.Showing()}, picked {picked != Null ? picked.Entity.Name() : "nothing"}")
    Local mover = Pivot()
    mover.SetCollisionGroup(1)
    mover.SetCollisionRadius(0.5)
    mover.SetPosition(Vec3(0, 5, 0))
    world.Collide()
    mover.Translate(Vec3(0, -10, 0))
    world.Collide()
    Print("alpha 0: a mover rests at {Fine(mover.Position())}")

    // And not drawn: what's looked down on is the door at alpha 1, and what's behind it at 0.
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        world.Free()
        Return
    End If
    Window.SetHeadless(True)
    Local target = Try Texture.Target(16, 16, TextureFormat.RGBA8, 1, True)
    Local above = Camera()
    above.SetRenderTarget(target)
    above.SetClearColor(Color(0, 0, 1))
    above.SetPosition(Vec3(0, 5, 0))
    above.SetRotation(Quat.FromAxisAngle(Vec3(1, 0, 0), Deg(-90)))
    Local painted = Material()
    painted.SetShading(Shading.UNLIT)
    painted.SetColor(Color(1, 0, 0))
    door.SetMaterial(painted)
    door.SetAlpha(1)
    above.Render()
    Print("alpha 1: what's over it {target.ToImage()[8, 8]}")
    Flip(False)
    door.SetAlpha(0)
    above.Render()
    Print("alpha 0: what's over it {target.ToImage()[8, 8]}")
    Flip(False)
    world.Free()
End Function

Local arguments = Process.Arguments()
If !arguments.Contains("--watch")
    Local world = World()
    World.SetCurrent(world)

    // A room, its door, and the door's handle, by names.
    Local room = Pivot()
    room.SetName("room")
    room.SetPosition(Vec3(10, 0, 0))
    Local door = Mesh(Geometry.Cube(), room)
    door.SetName("door")
    door.SetPosition(Vec3(2, 0, 0))
    Local handle = Pivot(door)
    handle.SetName("handle")
    handle.SetPosition(Vec3(0, 1, 0))
    Local lamp = Pivot(room)
    lamp.SetName("lamp")
    Print("the room has {room.ChildCount()}, first {room.Child(0).Name()}, then {room.Child(1).Name()}")
    Print("the handle's parent {handle.Parent()?.Name() ?? "none"}, the room's {room.Parent()?.Name() ?? "none"}")
    Print(
        "found under the room {room.Find("handle") == handle}, not there {room.Find("window") == Null}")

    // Where it is: its own place, and through its parents.
    Print("the handle's own place {Shown(handle.Position())}, in the world {Shown(handle.Position(Space.WORLD))}")
    room.Turn(0, Deg(90), 0)
    Print("the room turned a quarter: {Shown(handle.Position(Space.WORLD))}")
    room.SetRotation(0, 0, 0)
    room.SetScale(Vec3(2, 2, 2))
    Print("scaled twice: {Shown(handle.Position(Space.WORLD))}")
    room.SetScale(Vec3(1, 1, 1))

    // Between parents: where it is in the world kept, or not.
    handle.SetParent(lamp)
    Print("under the lamp, world kept: {Shown(handle.Position(Space.WORLD))}, own {Shown(handle.Position())}")
    handle.SetParent(door, False)
    Print("back, own kept: {Shown(handle.Position())}, world {Shown(handle.Position(Space.WORLD))}")
    handle.SetPosition(Vec3(0, 1, 0))

    // Moving: along its own axes or the world's, by turning, and pointing at something.
    Local mover = Pivot()
    mover.Turn(0, Deg(90), 0)
    mover.Move(Vec3(0, 0, -1))
    Print("moved forward, turned a quarter: {Shown(mover.Position())}")
    mover.SetPosition(Vec3(0, 0, 0))
    mover.Translate(Vec3(0, 0, -1))
    Print("translated, whichever way it faces: {Shown(mover.Position())}")
    mover.SetPosition(Vec3(0, 0, 0))
    mover.PointAt(Vec3(0, 0, 5))
    Local forward = mover.Forward()
    Print("pointed at +Z, forward is {Shown(forward)}")
    Print("distance to the door {mover.DistanceTo(door):.2}")

    // A copy of a whole tree: its children and names, and its own after that.
    Local copy = room.Copy()
    copy.SetPosition(Vec3(-10, 0, 0))
    Print("a copy has {copy.ChildCount()}, its handle {copy.Find("handle") != Null}, not the same one {copy.Find("handle") != handle}")
    Print("in its order: {copy.Child(0).Name()}, {copy.Child(1).Name()}")
    Print("its handle in the world {Shown((copy.Find("handle") ?? copy).Position(Space.WORLD))}, the first's {Shown(handle.Position(Space.WORLD))}")

    // Hiding: what's in it goes too, but keeps its own say for when it's shown.
    door.Hide()
    room.Hide()
    Print("room hidden: the room's showing {room.Showing()}, the lamp's {lamp.Showing()}, hidden itself {lamp.Hidden()}")
    room.Show()
    Print("room shown: the lamp's {lamp.Showing()}, the door's still {door.Showing()}")
    door.Show()
    Print("door shown: the handle's {handle.Showing()}, the copy's door was never hidden {(copy.Find("door") ?? copy).Showing()}")

    // Freeing a tree frees what's in it, and the copy stays.
    Local handleOfCopy = copy.Find("handle")
    room.Free()
    Print("freed: the room {room.Freed()}, its handle {handle.Freed()}, the copy's {handleOfCopy?.Freed() ?? True}")
    world.Free()
    Try WaysAndCopies()
ElseIf Env.Get("FBENGINE_NO_GPU") == "1"
    Print("no GPU here")
Else
    Try Watched(Asked(arguments), arguments)
End If
