// Several cameras in a frame: viewports of one target, each clearing only its own, in their order;
// an overlay's orthographic camera that keeps what's there; several worlds drawn in a frame; a
// camera's field of view, range, and fog, each its own; and hiding a camera. It prints each pixel it
// reads; with --watch, a window of them, a turning cube and an overlay.

Import std.collections
Import std.core
From std.image Import Image
Import std.math
Import std.os
Import fbengine

// A square from -1 to 1 facing +Z, `away` wound to face -Z; each corner's first UVs across it, its
// second all `second`, and its color `color`.
Function Square(color: Color? = Null, second: Vec2? = Null, away: Bool = False): Geometry
    Local tint = color ?? Color(1, 1, 1)
    Local other = second ?? Vec2(0, 0)
    Local made = Geometry()
    Local surface = made.AddSurface()
    Local facing = Vec3(0, 0, away ? -1.0 : 1.0)
    Local a = surface.AddVertex(Vertex(Vec3(-1, 1, 0), facing, Vec2(0, 0), other, tint))
    Local b = surface.AddVertex(Vertex(Vec3(1, 1, 0), facing, Vec2(1, 0), other, tint))
    Local c = surface.AddVertex(Vertex(Vec3(1, -1, 0), facing, Vec2(1, 1), other, tint))
    Local d = surface.AddVertex(Vertex(Vec3(-1, -1, 0), facing, Vec2(0, 1), other, tint))
    If away
        surface.AddTriangle(a, b, c)
        surface.AddTriangle(a, c, d)
    Else
        surface.AddTriangle(a, c, b)
        surface.AddTriangle(a, d, c)
    End If
    Return made
End Function

// Prints `what`, and `wanted` if the pixel's within 2 of it each way, as GPUs round; else the pixel.
Function Check(what: String, got: Color32, wanted: Color32)
    Local close = Abs((got.r As Int) - (wanted.r As Int)) <= 2 &&
                  Abs((got.g As Int) - (wanted.g As Int)) <= 2 &&
                  Abs((got.b As Int) - (wanted.b As Int)) <= 2
    Print("{what}: {close ? wanted : got}")
End Function

// A shade of gray, as bytes.
Function Gray(value: Int): Color32 => Color32(value As UInt8, value As UInt8, value As UInt8, 255)

// A material of no lighting, white unless given.
Function Plain(color: Color? = Null): Material
    Local made = Material()
    made.SetShading(Shading.UNLIT)
    made.SetColor(color ?? Color(1, 1, 1))
    Return made
End Function

Function Proved() Throws GraphicsError
    Local world = World()
    World.SetCurrent(world)
    Defer world.Free()
    Local target = Try Texture.Target(64, 32, TextureFormat.RGBA8, 1, True)
    Local red = Plain(Color(1, 0, 0))
    Local box = Mesh(Square())
    box.SetMaterial(red)
    box.SetPosition(Vec3(0, 0, -5))

    // Two viewports, each half, each its own clear color: a second camera's clear leaves the first's.
    Local left = Camera()
    left.SetRenderTarget(target)
    left.SetViewport(Rect(0, 0, 32, 32))
    left.SetClearColor(Color(0, 0, 1))
    left.SetOrder(0)
    Local right = Camera()
    right.SetRenderTarget(target)
    right.SetViewport(Rect(32, 0, 32, 32))
    right.SetClearColor(Color(0, 1, 0))
    right.SetOrder(1)
    RenderWorld()
    Local read = target.ToImage()
    Check("the left camera's middle", read[16, 16], Color32(255, 0, 0, 255))
    Check("its clear", read[1, 1], Color32(0, 0, 255, 255))
    Check("the right camera's middle", read[48, 16], Color32(255, 0, 0, 255))
    Check("its clear", read[33, 1], Color32(0, 255, 0, 255))

    // A square 2 across, 5 away, at 60 degrees: the view's half is tan(30) x 5 = 2.89 there, so the
    // square's 1 is 5.5 of the viewport's 16 either side of its middle, and 4 from its middle is in it.
    // At 90 degrees, 1 of 5 is 3.2 of 16, so it isn't; at 15, the view's half is 0.66, so it fills it.
    Check("at 60 degrees, 4 from its middle", read[12, 16], Color32(255, 0, 0, 255))
    left.SetFieldOfView(Deg(90))
    RenderWorld()
    read = target.ToImage()
    Check("at 90 degrees, the same place", read[12, 16], Color32(0, 0, 255, 255))
    left.SetFieldOfView(Deg(15))
    RenderWorld()
    read = target.ToImage()
    Check("at 15 degrees, its corner", read[1, 1], Color32(255, 0, 0, 255))
    left.SetFieldOfView(Deg(60))

    // Its range: past its far end it's not drawn.
    left.SetRange(0.1, 3)
    RenderWorld()
    read = target.ToImage()
    Check("past its range", read[16, 16], Color32(0, 0, 255, 255))
    Check("the other's range is its own", read[48, 16], Color32(255, 0, 0, 255))
    left.SetRange(0.1, 1000)

    // Its fog's its own, half way, on what's stored, to its own color.
    right.SetFogMode(FogMode.LINEAR)
    right.SetFogColor(Color(1, 1, 1))
    right.SetFogRange(0, 10)
    Local unfogged = Plain(Color(0, 0, 0))
    box.SetMaterial(unfogged)
    RenderWorld()
    read = target.ToImage()
    Check("in the other's fog", read[48, 16], Gray(128))
    Check("in its own, none", read[16, 16], Gray(0))
    right.SetFogMode(FogMode.NONE)
    box.SetMaterial(red)

    // Another world in the same frame, its orthographic camera over the first's, keeping its colors:
    // an overlay, 8 pixels square in the corner.
    Local overlay = World()
    World.SetCurrent(overlay)
    Local over = Camera()
    over.SetRenderTarget(target)
    over.SetViewport(Rect(0, 0, 32, 32))
    over.SetProjection(Projection.ORTHOGRAPHIC)
    over.SetOrthographicHeight(8)
    over.SetClear(False, True)
    Local badge = Mesh(Square())
    badge.SetMaterial(Plain(Color(1, 1, 0)))
    badge.SetPosition(Vec3(-3, 3, -5))
    World.SetCurrent(world)
    RenderWorld()
    World.SetCurrent(overlay)
    RenderWorld()
    read = target.ToImage()
    // From -4 to -2 of its 8 across, and down: 8 pixels of 32, as it wouldn't be with perspective.
    Check("the overlay", read[7, 7], Color32(255, 255, 0, 255))
    Check("the world under it", read[16, 16], Color32(255, 0, 0, 255))
    Check("its clear under it", read[1, 30], Color32(0, 0, 255, 255))

    // Hidden, a camera draws nothing: what it drew stays, and the next draws what's its own.
    World.SetCurrent(world)
    left.Hide()
    right.SetClearColor(Color(1, 0, 1))
    RenderWorld()
    read = target.ToImage()
    Check("a hidden camera's part stays", read[1, 30], Color32(0, 0, 255, 255))
    Check("the other's changes", read[33, 1], Color32(255, 0, 255, 255))
    left.Show()
    overlay.Free()
End Function

// A window of a turning cube, by two cameras side by side, and an overlay's world over them; or
// `frames` frames offscreen.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("cameras and viewports: Escape ends it")
    Frame.SetLimit(60)
    Local world = World()
    World.SetCurrent(world)
    Defer world.Free()
    Local cube = Mesh(Geometry.Cube())
    cube.SetMaterial(Plain(Color(0.8, 0.2, 0.1)))
    cube.SetPosition(Vec3(0, 0, -5))
    Local left = Camera()
    left.SetViewport(Rect(0, 0, 400, 450))
    left.SetClearColor(Color(0.02, 0.02, 0.1))
    Local right = Camera()
    right.SetViewport(Rect(400, 0, 400, 450))
    right.SetClearColor(Color(0.02, 0.1, 0.02))
    right.SetFieldOfView(Deg(25))
    right.SetFogMode(FogMode.LINEAR)
    right.SetFogColor(Color(0.4, 0.4, 0.4))
    right.SetFogRange(0, 12)
    Local overlay = World()
    World.SetCurrent(overlay)
    Defer overlay.Free()
    Local over = Camera()
    over.SetProjection(Projection.ORTHOGRAPHIC)
    over.SetOrthographicHeight(9)
    over.SetClear(False, True)
    Local badge = Mesh(Square())
    badge.SetMaterial(Plain(Color(1, 0.8, 0)))
    badge.SetPosition(Vec3(-7, 3.5, -5))
    Local drew = False
    Local time: Float = 0.0
    Local count = 0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        time += frames > 0 ? 0.1 : Frame.Delta() As Float
        cube.SetRotation(Quat.FromEuler(time * 0.5, time, 0.0))
        badge.SetRotation(Quat.FromEuler(0.0, 0.0, time))
        World.SetCurrent(world)
        RenderWorld()
        If frames > 0 && !drew Then drew = Try Drew()
        World.SetCurrent(overlay)
        RenderWorld()
    End While
    World.SetCurrent(world)
    Print("drew {drew}")
    Print("watched {count} frames")
End Function

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

// Whether any of the screen's pixels isn't what's in its corner, as what's behind everything is.
Function Drew(): Bool Throws GraphicsError
    Local image = Try Screen.ToImage()
    Local behind = image[0, 0]
    For y = 0 To image.Height - 1
        For x = 0 To image.Width - 1
            If image[x, y] != behind Then Return True
        End For
    End For
    Return False
End Function

Local arguments = Process.Arguments()
If Env.Get("FBENGINE_NO_GPU") == "1"
    Print("no GPU here")
ElseIf arguments.Contains("--watch")
    Try Watched(Asked(arguments), arguments)
Else
    Try Proved()
End If
