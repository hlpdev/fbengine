// Swept collisions: something moving is stopped or slid by what it hits, whatever the size of its
// step: falling, walking into a wall and a corner, up a step, as a tall ellipsoid or a ball, against
// meshes, boxes, and other movers, with what it touched reported. It prints where each ended up; with
// --watch, a window of a ball walking round a room, sliding along its walls.
//
// fbengine differs from Blitz's here on purpose, each pinned below: targets are tested where they are
// now, not where they were, so a door moved in the same frame stops the mover; 8 contacts a move by
// default, not 10, which SetCollisionIterations changes; using them up settles the mover where it is,
// so a move of the same length ends at another place by how many it's let have; and riding over an
// edge takes SetStepHeight.

Import std.core
Import std.image.image
Import std.math
Import fbengine
Import std.collections
Import std.os

Const MOVER = 1
Const LEVEL = 2
Const OTHER = 3

Function Shown(at: Vec3): String => "{at.x:.2}, {at.y:.2}, {at.z:.2}"

// A floor 20 across at y = 0, facing up.
Function Floor(): Mesh
    Local floor = Mesh(Geometry.Plane(4))
    floor.SetScale(Vec3(10, 1, 10))
    floor.SetCollisionGroup(LEVEL)
    Return floor
End Function

// A box of the level, `size` across, its middle at `at`.
Function Block(at: Vec3, size: Vec3): Mesh
    Local block = Mesh(Geometry.Cube())
    block.SetPosition(at)
    block.SetScale(size * 0.5)
    block.SetCollisionGroup(LEVEL)
    Return block
End Function

// Something moving, of radius `wide` across and `tall` up and down, whose first Collide only notes
// where it is.
Function Mover(world: World, at: Vec3, wide: Float, tall: Float): Pivot
    Local mover = Pivot()
    mover.SetCollisionGroup(MOVER)
    mover.SetCollisionRadius(wide, tall)
    mover.SetPosition(at)
    world.Collide()
    Return mover
End Function

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

// Whether two colors are within 2 of each other in each channel, as a GPU's rounding of what's
// encoded leaves them.
Function Near(got: Color32, wanted: Color32): Bool
    Return Abs((got.r As Int) - (wanted.r As Int)) <= 2 &&
           Abs((got.g As Int) - (wanted.g As Int)) <= 2 &&
           Abs((got.b As Int) - (wanted.b As Int)) <= 2
End Function

// `wanted` if `got` is near it, else `got`, to print.
Function Shown(got: Color32, wanted: Color32): Color32 => Near(got, wanted) ? wanted : got

// What's drawn where `camera` sees `place`.
Function Seen(camera: Camera, image: Image, place: Vec3): Color32
    Local at = camera.Project(place) ?? Vec3(0, 0, 0)
    Return image[at.x As Int, at.y As Int]
End Function

// A material of no lighting.
Function Painted(color: Color): Material
    Local made = Material()
    made.SetShading(Shading.UNLIT)
    made.SetColor(color)
    Return made
End Function

// A window's camera at `at`, looking at `looking`, over almost black.
Function Watching(at: Vec3, looking: Vec3): Camera
    Local camera = Camera()
    camera.SetPosition(at)
    camera.PointAt(looking)
    camera.SetClearColor(Color(0.02, 0.02, 0.03))
    Return camera
End Function

// A window of a ball sliding round a walled floor, what it's touching lit; or `frames` frames
// offscreen.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("swept collisions: Escape ends it")
    Frame.SetLimit(60)
    Local world = World()
    World.SetCurrent(world)
    Defer world.Free()
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.SLIDE)
    Local floor = Floor()
    floor.SetMaterial(Painted(Color(0.15, 0.15, 0.2)))
    Local walls = [Block(Vec3(0, 1, -10), Vec3(20, 2, 1)), Block(Vec3(0, 1, 10), Vec3(20, 2, 1)),
                   Block(Vec3(-10, 1, 0), Vec3(1, 2, 20)), Block(Vec3(10, 1, 0), Vec3(1, 2, 20)),
                   Block(Vec3(3, 1, 2), Vec3(6, 2, 2))]
    Local plain = Painted(Color(0.4, 0.4, 0.5))
    Local touching = Painted(Color(0.9, 0.5, 0.1))
    For wall In walls
        wall.SetMaterial(plain)
    End For
    Local mover = Mover(world, Vec3(0, 1, 0), 0.8, 0.8)
    Local ball = Mesh(Geometry.Sphere(), mover)
    ball.SetScale(Vec3(0.8, 0.8, 0.8))
    ball.SetMaterial(Painted(Color(0.2, 0.7, 0.9)))
    Local camera = Watching(Vec3(0, 18, 14), Vec3(0, 0, 0))
    Local time: Float = 0.0
    Local count = 0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        Local seconds = frames > 0 ? 0.1 : Frame.Delta() As Float
        time += seconds
        mover.Translate(Vec3(Cos(time * 0.7), -0.2, Sin(time * 0.5)) * (12.0 * seconds))
        world.Collide()
        For wall In walls
            wall.SetMaterial(plain)
        End For
        For hit In mover.Collisions()
            Local wall = hit.Other As? Mesh
            If wall != Null && !RefEquals(wall, floor) Then wall.SetMaterial(touching)
        End For
        RenderWorld()
    End While
    If count == frames
        // The ball where it went, inside its walls, and each wall lit just while it's touched, as sRGB
        // stores their colors: 0.2, 0.7, 0.9 is 124, 218, 242; 0.4, 0.4, 0.5 is 170, 170, 188; and
        // 0.9, 0.5, 0.1 is 242, 188, 89.
        Local shown = Try Screen.ToImage()
        Local at = mover.Position()
        Print("the ball's inside {Abs(at.x) < 9.2 && Abs(at.z) < 9.2}, drawn {Shown(Seen(camera, shown, at + Vec3(0, 0.7, 0)), Color32(124, 218, 242, 255))}")
        Local touched = 0
        Local right = True
        For wall In walls
            Local lit = False
            For hit In mover.Collisions()
                If RefEquals(hit.Other, wall) Then lit = True
            End For
            If lit Then touched += 1
            Local wanted = lit ? Color32(242, 188, 89, 255) : Color32(170, 170, 188, 255)
            If !Near(Seen(camera, shown, wall.Position() + Vec3(0, 1, 0)), wanted) Then right = False
        End For
        Print("its walls, {touched} touched, each its color {right}")
    End If
    Print("watched {count} frames")
End Function

// To the skin, each by its own world.
Function Fine(at: Vec3): String => "{at.x:.3}, {at.y:.3}, {at.z:.3}"

// What rests a skin off: a corner, a ring, each group, a box, a door, and a world's own step.
Function Contacts()
    Local world = World()
    World.SetCurrent(world)
    Print("iterations by default {world.CollisionIterations()}")
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.SLIDE_HORIZONTAL)
    Local wall = Block(Vec3(0, 2, -5), Vec3(20, 4, 1))
    Local walker = Mover(world, Vec3(0, 1, 0), 0.5, 0.5)
    walker.Translate(Vec3(3, 0, -10))
    world.Collide()
    Print("SLIDE_HORIZONTAL along a wall: {Fine(walker.Position())}")
    walker.Free()

    // Against a corner, two walls: two contacts, and the crease.
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.SLIDE)
    Local side = Block(Vec3(5, 2, 0), Vec3(1, 4, 20))
    Local cornered = Mover(world, Vec3(0, 1, 0), 0.5, 0.5)
    cornered.Translate(Vec3(10, 0, -10))
    world.Collide()
    Print("into a corner: {Fine(cornered.Position())}, touching {cornered.Collisions().Count}")
    For each In cornered.Collisions()
        Print("  a contact, facing {Fine(each.Normal)}, at {Fine(each.Point)}")
    End For
    cornered.Free()
    side.Free()

    // A tall one: into a wall by its width, the contact back in the world.
    Local tall = Mover(world, Vec3(0, 2, 0), 0.5, 1.5)
    tall.Translate(Vec3(0, 0, -10))
    world.Collide()
    Print("a tall one into a wall: {Fine(tall.Position())}, facing {Fine(tall.Collisions()[0].Normal)}, at {Fine(tall.Collisions()[0].Point)}")
    tall.Free()

    // Two groups at once: Collided by each.
    world.SetCollisionResponse(MOVER, OTHER, CollisionResponse.SLIDE)
    Local rock = Pivot()
    rock.SetCollisionGroup(OTHER)
    rock.SetCollisionRadius(1)
    rock.SetPosition(Vec3(0, 1, -3.5))
    Local both = Mover(world, Vec3(0.5, 1, 0), 0.5, 0.5)
    both.Translate(Vec3(0, 0, -10))
    world.Collide()
    Print("past a rock to a wall: {Fine(both.Position())}, touching {both.Collisions().Count}")
    Print("  by group: level {both.Collided(LEVEL) == wall}, other {both.Collided(OTHER) == rock}, first's normal {Fine(both.Collisions()[0].Normal)}")
    both.Free()

    // Tall onto a tall rock, y scaled against an ellipsoid.
    rock.SetCollisionRadius(1, 2)
    rock.SetPosition(Vec3(0, 3, 10))
    Local high = Mover(world, Vec3(0, 7, 10), 0.5, 1.5)
    high.Translate(Vec3(0, -6, 0))
    world.Collide()
    Print("a tall one onto a tall rock: {Fine(high.Position())}")
    high.Free()
    rock.Free()

    // Around a ring of 32 walls, facing in: as many contacts as its iterations allow.
    For k = 0 To 31
        Local angle = (k As Float) * (Pi / 16.0)
        Local piece = Block(Vec3(45 + 5.5 * Cos(angle), 2, 5.5 * Sin(angle)), Vec3(1, 4, 1.25))
        piece.Turn(0, -angle, 0)
    End For
    Local ringed = Mover(world, Vec3(45 + 3.9, 1, 0), 0.5, 0.5)
    ringed.Translate(Vec3(0.5, 0, -8))
    world.Collide()
    Print("around a ring, 8 iterations: {Fine(ringed.Position())}, touching {ringed.Collisions().Count}")
    ringed.Free()
    world.SetCollisionIterations(10)
    Local ringed10 = Mover(world, Vec3(45 + 3.9, 1, 0), 0.5, 0.5)
    ringed10.Translate(Vec3(0.5, 0, -8))
    world.Collide()
    Print("around a ring, 10 iterations: {Fine(ringed10.Position())}, touching {ringed10.Collisions().Count}")
    ringed10.Free()
    world.SetCollisionIterations(8)

    // Around a tighter one, of 128 short walls: more contacts than it's let have, so it stops where
    // the last leaves it, further along with 10 than with 8.
    For k = 0 To 127
        Local angle = (k As Float) * (Pi / 64.0)
        Local piece = Block(Vec3(70 + 5.5 * Cos(angle), 2, 5.5 * Sin(angle)), Vec3(1, 4, 0.3))
        piece.Turn(0, -angle, 0)
    End For
    Local tight = Mover(world, Vec3(70 + 4.4, 1, 0), 0.5, 0.5)
    tight.Translate(Vec3(0.5, 0, -8))
    world.Collide()
    Print("around a tight ring, 8 iterations: {Fine(tight.Position())}, touching {tight.Collisions().Count}")
    tight.Free()
    world.SetCollisionIterations(10)
    Local tight10 = Mover(world, Vec3(70 + 4.4, 1, 0), 0.5, 0.5)
    tight10.Translate(Vec3(0.5, 0, -8))
    world.Collide()
    Print("around a tight ring, 10 iterations: {Fine(tight10.Position())}, touching {tight10.Collisions().Count}")
    tight10.Free()
    world.SetCollisionIterations(8)

    // A mover against a mover: touched where its last move ended, each by its own sweep.
    world.SetCollisionResponse(MOVER, MOVER, CollisionResponse.STOP)
    Local ahead = Mover(world, Vec3(-40, 1, -3), 0.5, 0.5)
    Local behind = Mover(world, Vec3(-40, 1, 0), 0.5, 0.5)
    ahead.Translate(Vec3(0, 0, -10))
    behind.Translate(Vec3(0, 0, -10))
    world.Collide()
    Print("a mover into one moving away: {Fine(behind.Position())}, the other {Fine(ahead.Position())}")
    ahead.Free()
    behind.Free()
    world.SetCollisionResponse(MOVER, MOVER, CollisionResponse.NONE)

    // A tall one on a slope: the contact's normal back in the world.
    Local slope = Mesh(Geometry.Plane(2))
    slope.SetScale(Vec3(10, 1, 10))
    slope.SetPosition(Vec3(-70, 0, 0))
    slope.Turn(0, 0, Deg(30))
    slope.SetCollisionGroup(LEVEL)
    Local onSlope = Mover(world, Vec3(-70, 4, 0), 0.5, 1.5)
    onSlope.Translate(Vec3(0, -5, 0))
    world.Collide()
    Print("a tall one onto a slope of 30: facing {Fine(onSlope.Collisions()[0].Normal)}")
    onSlope.Free()

    // Touching a wall, then a rock: Collided by each group.
    Local wall2 = Block(Vec3(-100, 2, -5), Vec3(20, 4, 1))
    Local rock2 = Pivot()
    rock2.SetCollisionGroup(OTHER)
    rock2.SetCollisionRadius(1)
    rock2.SetPosition(Vec3(-97, 1, -4))
    Local twoGroups = Mover(world, Vec3(-100, 1, -3.9), 0.5, 0.5)
    twoGroups.Translate(Vec3(5, 0, -1))
    world.Collide()
    Print("a wall, then a rock: touching {twoGroups.Collisions().Count}, level {twoGroups.Collided(LEVEL) == wall2}, other {twoGroups.Collided(OTHER) == rock2}")
    twoGroups.Free()
    wall2.Free()
    rock2.Free()

    // A door closing across a move in the same frame: where it is now, not where it was.
    wall.Free()
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.SLIDE)
    Local door = Block(Vec3(0, 2, -20), Vec3(20, 4, 1))
    Local through = Mover(world, Vec3(0, 1, 0), 0.5, 0.5)
    door.SetPosition(Vec3(0, 2, -5))
    through.Translate(Vec3(0, 0, -10))
    world.Collide()
    Print("a door moved across the move, this frame: {Fine(through.Position())}")
    door.Free()
    through.Free()

    // Once a step, by UpdateWorld.
    Block(Vec3(0, -0.5, 0), Vec3(100, 1, 100))
    Local dropped = Mover(world, Vec3(0, 3, 0), 0.5, 0.5)
    dropped.Translate(Vec3(0, -10, 0))
    UpdateWorld()
    Print("by UpdateWorld: {Fine(dropped.Position())}, touching {dropped.Collisions().Count}")

    // A box shape, the shape the sample's header says it hits.
    Local crate = Pivot()
    crate.SetPosition(Vec3(140, 1, 0))
    crate.SetCollisionShape(CollisionShape.BOX)
    crate.SetCollisionGroup(LEVEL)
    Local at = Mover(world, Vec3(135, 1, 0), 0.5, 0.5)
    at.Translate(Vec3(10, 0, 0))
    world.Collide()
    Print("into a box: {Fine(at.Position())}")
    world.Free()
End Function

Local arguments = Process.Arguments()
If !arguments.Contains("--watch")
    Local world = World()
    World.SetCurrent(world)
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.SLIDE)
    Local floor = Floor()

    // Falling, by one step far past the floor: it isn't missed, and rests on its radius.
    Local ball = Mover(world, Vec3(0, 5, 0), 0.5, 0.5)
    ball.Translate(Vec3(0, -100, 0))
    world.Collide()
    Print("a ball falls 100 and rests at {Shown(ball.Position())}")
    Local touched = ball.Collisions()
    Print("it touched {touched.Count}, the floor {touched[0].Other == floor}, facing {Shown(touched[0].Normal)}, at {Shown(touched[0].Point)}")
    Print("what it hit has it too {floor.Collisions().Count == 1 && floor.Collided(MOVER) == ball}")

    // A tall one rests on its height, not its width: radii scaled up and down.
    Local tall = Mover(world, Vec3(4, 5, 4), 0.5, 1.5)
    tall.Translate(Vec3(0, -100, 0))
    world.Collide()
    Print("a tall one rests at {Shown(tall.Position())}")
    tall.Free()

    // Into a wall at an angle: it slides along it, losing what went into it.
    Local wall = Block(Vec3(0, 2, -5), Vec3(20, 4, 1))
    Local walker = Mover(world, Vec3(0, 1, 0), 0.5, 0.5)
    walker.Translate(Vec3(3, 0, -10))
    world.Collide()
    Print("sliding along a wall ends at {Shown(walker.Position())}")
    Print("touching the wall {walker.Collided(LEVEL) != Null}, facing {Shown(walker.Collisions()[0].Normal)}")
    walker.Free()

    // The same with STOP: it stays where it touched.
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.STOP)
    Local stopper = Mover(world, Vec3(0, 1, 0), 0.5, 0.5)
    stopper.Translate(Vec3(3, 0, -10))
    world.Collide()
    Print("stopping at it ends at {Shown(stopper.Position())}")
    stopper.Free()

    // With no response, it goes through.
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.NONE)
    Local ghost = Mover(world, Vec3(0, 1, 0), 0.5, 0.5)
    ghost.Translate(Vec3(0, 0, -10))
    world.Collide()
    Print("with none it ends at {Shown(ghost.Position())}, touching {ghost.Collisions().Count}")
    ghost.Free()
    wall.Free()

    // A slope: gravity slides a ball down, but not with SLIDE_HORIZONTAL, which stays where it's put.
    Local ramp = Mesh(Geometry.Plane(2))
    ramp.SetScale(Vec3(10, 1, 10))
    ramp.SetPosition(Vec3(30, 0, 0))
    ramp.Turn(0, 0, Deg(20))
    ramp.SetCollisionGroup(LEVEL)
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.SLIDE)
    Local slider = Mover(world, Vec3(30, 2, 0), 0.5, 0.5)
    slider.Translate(Vec3(0, -3, 0))
    world.Collide()
    Local sliddenX = slider.Position().x
    slider.Free()
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.SLIDE_HORIZONTAL)
    Local stander = Mover(world, Vec3(30, 2, 0), 0.5, 0.5)
    stander.Translate(Vec3(0, -3, 0))
    world.Collide()
    Print("on a slope, sliding moves it across {Abs(sliddenX - 30.0) > 0.05}, standing {Abs(stander.Position().x - 30.0) < 0.01}")
    stander.Free()
    ramp.Free()

    // Up a step: one no higher than its step height it climbs; a higher one stops it.
    world.SetCollisionResponse(MOVER, LEVEL, CollisionResponse.SLIDE)
    Local step = Block(Vec3(0, 0.15, -3), Vec3(4, 0.3, 2))
    Local climber = Mover(world, Vec3(0, 0.51, 0), 0.5, 0.5)
    climber.SetStepHeight(0.4)
    climber.Translate(Vec3(0, 0, -3))
    world.Collide()
    Print("over a step of 0.3 it reaches z {climber.Position().z:.2}, y {climber.Position().y:.2}")
    climber.SetStepHeight(0.1)
    climber.SetPosition(Vec3(0, 0.51, 0))
    climber.ResetCollisions()
    world.Collide()
    climber.Translate(Vec3(0, 0, -3))
    world.Collide()
    Print("with a step height of 0.1 it stops at z {climber.Position().z:.2}")
    climber.Free()
    step.Free()

    // A mover against a mover: an ellipsoid, each by the other's radius.
    world.SetCollisionResponse(MOVER, OTHER, CollisionResponse.STOP)
    Local rock = Pivot()
    rock.SetCollisionGroup(OTHER)
    rock.SetCollisionRadius(1)
    rock.SetPosition(Vec3(0, 5, -5))
    ball.SetPosition(Vec3(0, 5, 0))
    ball.ResetCollisions()
    world.Collide()
    ball.Translate(Vec3(0, 0, -10))
    world.Collide()
    Print("a ball into a rock stops at z {ball.Position().z:.2}, y {ball.Position().y:.2}, having hit it {ball.Collided(OTHER) == rock}")
    world.Free()
    Contacts()
ElseIf Env.Get("FBENGINE_NO_GPU") == "1"
    Print("no GPU here")
Else
    Try Watched(Asked(arguments), arguments)
End If
