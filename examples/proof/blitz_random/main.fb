// A random stream the same as Blitz's, which a game has to have to get a map back from its seed: the
// same seed gives the same map only with this generator, which is why it's the game's to write, here
// a few lines of its own, and not the engine's. Park-Miller's, with a multiplier of 48271, by
// Schrage's 44488 and 3399, so nothing overflows 31 bits. It prints each number it makes, which
// tests/CMakeLists.txt has as they were worked out from the formula, not from this.

Import std.core

// Blitz's stream. There's one, which everything in a game draws from.
Final Class BlitzRandom
    // Where a stream starts that's never been seeded.
    Field state: Int = 0x1234

    // Starts it again: only 31 bits of the seed count, and 0 would never leave 0, so is 1.
    Method Seed(seed: Int)
        Local masked = seed & 0x7FFFFFFF
        state = masked != 0 ? masked : 1
    End Method

    // The stream's next state.
    Method Next(): Int
        state = 48271 * (state % 44488) - 3399 * (state / 44488)
        If state < 0 Then state += 2147483647
        Return state
    End Method

    // The next from 0 to 1, of 65536 steps, each in the middle of its step, so never 0 or 1.
    Method Float(): Float32
        Local low = (Next() & 65535) As Float32
        Return low / (65536.0 As Float32) + (0.5 As Float32) / (65536.0 As Float32)
    End Method

    // The next from `low` to `high`.
    Method Rnd(low: Float32, high: Float32): Float32 => Float() * (high - low) + low

    // The next whole number from `low` to `high`, either way round.
    Method Rand(low: Int, high: Int): Int
        If high < low Then Return Rand(high, low)
        Return (Float() * ((high - low + 1) As Float32)) As Int + low
    End Method
End Class

Function Main()
    Local stream = BlitzRandom()
    // One that's never seeded starts where Blitz's does.
    Print("unseeded: {stream.Next()}, {stream.Next()}, {stream.Next()}")
    stream.Seed(0x1234)
    Print("0x1234's states: {stream.Next()}, {stream.Next()}, {stream.Next()}")
    stream.Seed(0x1234)
    Print("its floats: {stream.Float()}, {stream.Float()}, {stream.Float()}")
    stream.Seed(0x1234)
    Print("Rand(1, 100): {stream.Rand(1, 100)}, {stream.Rand(1, 100)}, {stream.Rand(1, 100)}")
    stream.Seed(0x1234)
    Print("Rand(100, 1): {stream.Rand(100, 1)}, {stream.Rand(100, 1)}, {stream.Rand(100, 1)}")
    stream.Seed(0x1234)
    Print("Rand(-3, 1): {stream.Rand(-3, 1)}, {stream.Rand(-3, 1)}, {stream.Rand(-3, 1)}")
    stream.Seed(0x1234)
    Print("Rnd(-1, 1): {stream.Rnd(-1, 1)}")
    stream.Seed(0)
    Print("seed 0 is seed 1: {stream.Next()}")
    stream.Seed(1)
    Print("as seed 1 is: {stream.Next()}")
    // Its top bit goes: -5 is 0xFFFFFFFB as 32 bits, which masks to 2147483643.
    stream.Seed(-5)
    Print("seed -5 is 2147483643: {stream.state}, then {stream.Next()}")
    stream.Seed(2147483643)
    Print("as 2147483643 is: {stream.state}, then {stream.Next()}")
    // A state past what the multiplier leaves under 31 bits, which goes below 0 and comes back.
    stream.Seed(0x7FFFFFFE)
    Print("0x7FFFFFFE's next: {stream.Next()}")
    // The same seed again is the same stream, however far it had gone.
    stream.Seed(99)
    Local first = stream.Next()
    For i = 0 Until 1000
        stream.Next()
    End For
    stream.Seed(99)
    Print("seeded again, the same: {stream.Next() == first}")
End Function

Main()
