// What a camera might see, wherever it is and however it's turned: an entity by the 8 corners of its
// bounds, a point, and a box, against the camera's 6 planes, near and far included, with nothing hiding anything; and, apart from that,
// whether one thing has a line of sight to another. It prints each; with --watch, a window of cubes
// orbiting a watching camera, seen from above, green while they're in its view.

Import std.core
Import std.image.image
Import std.math
Import fbengine
Import std.collections
Import std.os

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

// Whether two colors are within 2 of each other in each channel, as a GPU's rounding of what's
// encoded leaves them.
Function Near(got: Color32, wanted: Color32): Bool
    Return Abs((got.r As Int) - (wanted.r As Int)) <= 2 &&
           Abs((got.g As Int) - (wanted.g As Int)) <= 2 &&
           Abs((got.b As Int) - (wanted.b As Int)) <= 2
End Function

// What's drawn where `camera` sees `place`.
Function Seen(camera: Camera, image: Image, place: Vec3): Color32
    Local at = camera.Project(place) ?? Vec3(0, 0, 0)
    Return image[at.x As Int, at.y As Int]
End Function

// A material of no lighting.
Function Painted(color: Color): Material
    Local made = Material()
    made.SetShading(Shading.UNLIT)
    made.SetColor(color)
    Return made
End Function

// A window's camera at `at`, looking at `looking`, over almost black.
Function Watching(at: Vec3, looking: Vec3): Camera
    Local camera = Camera()
    camera.SetPosition(at)
    camera.PointAt(looking)
    camera.SetClearColor(Color(0.02, 0.02, 0.03))
    Return camera
End Function

// A window from above of cubes going round a camera, green while it might see them; or `frames` frames
// offscreen.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("in view by bounds: Escape ends it")
    Frame.SetLimit(60)
    Local world = World()
    World.SetCurrent(world)
    Defer world.Free()
    Local watching = Camera()
    watching.SetViewport(Rect(0, 0, 800, 600))
    watching.SetFieldOfView(Deg(60))
    watching.SetRange(1, 12)
    watching.Hide()
    Local marker = Mesh(Geometry.Cone())
    marker.SetRotation(Quat.FromEuler(Deg(-90), 0.0, 0.0))
    marker.SetMaterial(Painted(Color(1, 1, 1)))
    Local inView = Painted(Color(0.2, 0.9, 0.3))
    Local outOf = Painted(Color(0.7, 0.15, 0.15))
    Local cubes: Mesh[] = []
    For i = 0 To 11
        Local cube = Mesh(Geometry.Cube())
        cube.SetScale(Vec3(0.6, 0.6, 0.6))
        cubes.Add(cube)
    End For
    Local above = Watching(Vec3(0, 25, 0.01), Vec3(0, 0, 0))
    Local time: Float = 0.0
    Local count = 0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        Local seconds = frames > 0 ? 0.1 : Frame.Delta() As Float
        time += seconds
        For i = 0 To cubes.Count - 1
            Local turn = time * 0.4 + (i As Float) * Tau / 12.0
            Local reach = 5.0 + ((i % 3) As Float) * 4.0
            cubes[i].SetPosition(Vec3(Cos(turn) * reach, 0, Sin(turn) * reach))
            watching.Show()
            cubes[i].SetMaterial(watching.InView(cubes[i]) ? inView : outOf)
            watching.Hide()
        End For
        RenderWorld()
    End While
    If count == frames
        // Green, 0.2, 0.9, 0.3's stored 124, 242, 149, for those wholly in its view by the sums; red,
        // 0.7, 0.15, 0.15's 218, 108, 108, for those wholly out of it. It looks down -z, 60 degrees
        // high and 800 by 600, from 1 to 12, and a cube's corners are 0.6 x root 3 from its middle.
        Local shown = Try Screen.ToImage()
        Local reach: Float = 0.6 * Sqrt(3.0)
        Local green = 0
        Local red = 0
        Local right = True
        For cube In cubes
            Local at = cube.Position()
            Local wide = Tan(Deg(30)) * -at.z * 4.0 / 3.0
            // A plane leans from what's straight ahead by up to this much.
            Local lean = reach * Sqrt(1.0 + (Tan(Deg(30)) * 4.0 / 3.0) ** 2.0)
            Local wholly = -at.z > 1.0 + reach && -at.z < 12.0 - reach && Abs(at.x) < wide - lean
            Local outside = -at.z < 1.0 - reach || -at.z > 12.0 + reach || Abs(at.x) > wide + lean
            Local drawn = Seen(above, shown, at + Vec3(0, 0.6, 0))
            If Near(drawn, Color32(124, 242, 149, 255)) Then green += 1
            If Near(drawn, Color32(218, 108, 108, 255)) Then red += 1
            If wholly && !Near(drawn, Color32(124, 242, 149, 255)) Then right = False
            If outside && !Near(drawn, Color32(218, 108, 108, 255)) Then right = False
        End For
        Print("{green} green and {red} red, as the sums have them {right}")
    End If
    Print("watched {count} frames")
End Function

// The vertical field of view of a zoom, as a game coming from Blitz's has one: its zoom sets what's
// across, 1 being 90 degrees, in a view of `width` by `height`.
Function FieldOfViewOf(zoom: Float, width: Float, height: Float): Float
    Return 2.0 * Atan((height / width) / zoom)
End Function

// Its field of view across, in degrees, of a vertical one.
Function DegreesAcross(fieldOfView: Float, width: Float, height: Float): Float
    Return 2.0 * Atan(Tan(fieldOfView / 2.0) * width / height) * 180.0 / Pi
End Function

// By zoom: at 1, what's across at a depth of 10 goes to 10, and what's up it to 7.5, in a view of
// 800 by 600; at the most a game's blood loss gives, 1.1, 2 x atan(1 / 1.1) across.
Function Zoomed()
    Local world = World()
    World.SetCurrent(world)
    Local eye = Camera()
    eye.SetViewport(Rect(0, 0, 800, 600))
    eye.SetRange(1, 50)
    eye.SetFieldOfView(FieldOfViewOf(1.0, 800, 600))
    Print("at zoom 1, x 9.9 {eye.InView(Vec3(9.9, 0, -10))}, 10.1 {eye.InView(Vec3(10.1, 0, -10))}")
    Print("y 7.4 {eye.InView(Vec3(0, 7.4, -10))}, 7.6 {eye.InView(Vec3(0, 7.6, -10))}")
    Local closer = FieldOfViewOf(1.1, 800, 600)
    eye.SetFieldOfView(closer)
    Print("at zoom 1.1, {DegreesAcross(closer, 800, 600):.1} degrees across")
    Print("x 9 {eye.InView(Vec3(9, 0, -10))}, 9.2 {eye.InView(Vec3(9.2, 0, -10))}")
    world.Free()
End Function

// Every plane, a camera moved and turned, what's around the whole view, and what blocks sight.
Function MovedAndTurned()
    Local world = World()
    World.SetCurrent(world)
    Local eye = Camera()
    eye.SetViewport(Rect(0, 0, 800, 600))
    eye.SetFieldOfView(Deg(90))
    eye.SetRange(1, 50)
    Print("left {eye.InView(Vec3(-14, 0, -10))} {eye.InView(Vec3(-13, 0, -10))}, right {eye.InView(Vec3(14, 0, -10))} {eye.InView(Vec3(13, 0, -10))}")
    Print("bottom {eye.InView(Vec3(0, -11, -10))} {eye.InView(Vec3(0, -9, -10))}, top {eye.InView(Vec3(0, 11, -10))} {eye.InView(Vec3(0, 9, -10))}")
    Print("a box with every corner outside, around the view: {eye.InView(AABB(Vec3(-100, -100, -30), Vec3(100, 100, -20)))}")
    Local wide = Mesh(Geometry.Cube())
    wide.SetPosition(Vec3(0, 0, -10))
    wide.SetScale(Vec3(100, 100, 1))
    Print("a mesh with every corner outside, around the view: {eye.InView(wide)}")
    wide.Free()

    // A turned mesh's 8 corners: a long thin bar, turned, whose world box reaches into the view though
    // none of it is in view.
    Local bar = Mesh(Geometry.Cube())
    bar.SetScale(Vec3(10.55, 0.1, 0.1))
    bar.Turn(0, Deg(36.3), 0)
    bar.SetPosition(Vec3(23.5, 0, -16.25))
    Print("a turned bar, its corners outside: {eye.InView(bar)}, the box around it {eye.InView(bar.Bounds())}")
    bar.Free()

    eye.SetPosition(Vec3(100, 0, 0))
    Print("moved, what it faced {eye.InView(Vec3(0, 0, -10))}, what it faces now {eye.InView(Vec3(100, 0, -10))}")
    eye.SetPosition(Vec3(0, 0, 0))
    eye.Turn(0, Deg(180), 0)
    Print("turned about, what it faced {eye.InView(Vec3(0, 0, -10))}, behind it {eye.InView(Vec3(0, 0, 10))}")
    eye.SetRotation(0, 0, 0)
    Local place = Pivot()
    place.SetPosition(Vec3(0, 0, 10))
    Print("a pivot out of view {eye.InView(place)}")
    place.SetPosition(Vec3(0, 0, -60))
    Print("a pivot past the far plane {eye.InView(place)}")
    Local mesh = Mesh(Geometry.Cube())
    mesh.SetPosition(Vec3(0, 0, -60))
    Print("a mesh past the far plane {eye.InView(mesh)}")
    mesh.SetPosition(Vec3(0, 0, -50.5))
    Print("a mesh across the far plane {eye.InView(mesh)}")
    mesh.SetPosition(Vec3(0, 0, -10))
    mesh.Hide()
    Print("a mesh hidden in view {eye.InView(mesh)}")
    mesh.Show()
    mesh.Free()

    // Sight: what blocks it, hidden, and a target that itself blocks.
    place.SetPosition(Vec3(0, 0, -10))
    Local wall = Mesh(Geometry.Plane())
    wall.SetScale(Vec3(20, 1, 20))
    wall.Turn(Deg(90), 0, 0)
    wall.SetPosition(Vec3(0, 0, -5))
    wall.SetBlocksSight(True)
    Print("through a wall {eye.CanSee(place)}, a point {eye.CanSee(Vec3(0, 0, -10))}, this side of it {eye.CanSee(Vec3(0, 0, -2))}")
    wall.Hide()
    Print("the wall hidden {eye.CanSee(place)}")
    wall.Show()
    Local target = Mesh(Geometry.Cube())
    target.SetPosition(Vec3(0, 0, -4))
    target.SetBlocksSight(True)
    Print("a target that blocks sight, before the wall {eye.CanSee(target)}")
    target.Free()

    // Something not a mesh with a pick mode, told to block sight.
    wall.SetBlocksSight(False)
    Local body = Pivot()
    body.SetCollisionRadius(1)
    body.SetPosition(Vec3(0, 0, -5))
    body.SetPickMode(PickMode.ELLIPSOID)
    body.SetBlocksSight(True)
    Print("past an ellipsoid told to block sight {eye.CanSee(place)}")
    Local boxed = Pivot()
    boxed.SetPosition(Vec3(0, 0, -7))
    boxed.SetPickMode(PickMode.BOX)
    boxed.SetBlocksSight(True)
    Print("past a box told to block sight {eye.CanSee(place)}")
    world.Free()
End Function

Local arguments = Process.Arguments()
If !arguments.Contains("--watch")
    Local world = World()
    World.SetCurrent(world)
    // Looking down -Z, seeing from 1 to 50.
    Local camera = Camera()
    camera.SetViewport(Rect(0, 0, 800, 600))
    camera.SetFieldOfView(Deg(90))
    camera.SetRange(1, 50)

    // Points: in front, behind, and at each end of its range.
    Print("in front {camera.InView(Vec3(0, 0, -10))}, behind {camera.InView(Vec3(0, 0, 10))}")
    Print(
        "at its near end {camera.InView(Vec3(0, 0, -1))}, nearer {camera.InView(Vec3(0, 0, -0.5))}")
    Print(
        "at its far end {camera.InView(Vec3(0, 0, -50))}, farther {camera.InView(Vec3(0, 0, -51))}")
    Print("past its top {camera.InView(Vec3(0, 11, -10))}, inside it {camera.InView(Vec3(0, 9, -10))}")

    // A box: whole, part of it in, and none of it.
    Print("a box inside {camera.InView(AABB(Vec3(-1, -1, -11), Vec3(1, 1, -9)))}")
    Print("a box half out {camera.InView(AABB(Vec3(10, -1, -11), Vec3(30, 1, -9)))}")
    Print("a box out {camera.InView(AABB(Vec3(30, -1, -11), Vec3(40, 1, -9)))}")

    // An entity, by its bounds: its middle out of view, but a corner in, counts.
    Local big = Mesh(Geometry.Cube())
    big.SetScale(Vec3(10, 1, 1))
    big.SetPosition(Vec3(18, 0, -10))
    Local bounds = big.Bounds()
    Print("its bounds are {bounds.Min.x:.0} to {bounds.Max.x:.0} across")
    Print("a long mesh with only its end in view {camera.InView(big)}, its middle {camera.InView(big.Position())}")
    big.SetPosition(Vec3(40, 0, -10))
    Print("moved out {camera.InView(big)}")
    // Something with no mesh goes by its place.
    Local place = Pivot()
    place.SetPosition(Vec3(0, 0, -10))
    Print("a pivot in view {camera.InView(place)}")

    // Nothing hides anything: a wall in front of it changes nothing.
    Local wall = Mesh(Geometry.Plane())
    wall.SetScale(Vec3(20, 1, 20))
    wall.Turn(Deg(90), 0, 0)
    wall.SetPosition(Vec3(0, 0, -5))
    wall.SetBlocksSight(True)
    Print("behind a wall {camera.InView(place)}")

    // Sight is the other question: that wall blocks it, until it doesn't.
    Print("a line of sight through the wall {camera.CanSee(place)}")
    wall.SetBlocksSight(False)
    Print("with it not blocking {camera.CanSee(place)}")
    world.Free()
    MovedAndTurned()
    Zoomed()
ElseIf Env.Get("FBENGINE_NO_GPU") == "1"
    Print("no GPU here")
Else
    Try Watched(Asked(arguments), arguments)
End If
