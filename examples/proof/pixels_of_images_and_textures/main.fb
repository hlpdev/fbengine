// Pixels by a game's own code: an image's read and written one at a time on the CPU, and a texture's,
// a target's and a plain one's, locked, written, with alpha, and drawn from. It prints what it read
// back, and whether a million were quick; with --watch, a window of a texture being painted.

Import std.collections
Import std.core
From std.image Import Image
Import std.math
Import std.os
Import std.time
Import fbengine

Function Proved() Throws GraphicsError
    // An image's, on the CPU, as a game reads a terrain's heights from one.
    Local map = Image(16, 16)
    For y = 0 To 15
        For x = 0 To 15
            map[x, y] = Color32((x * 16) As UInt8, (y * 16) As UInt8, 0, 255)
        End For
    End For
    Local total = 0
    For y = 0 To 15
        For x = 0 To 15
            total += map[x, y].r As Int
        End For
    End For
    Print("the image's red adds up to {total}")
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    Window.SetHeadless(True)
    Try Graphics(64, 64)
    Defer EndGraphics()

    // A texture of it, read back as it was.
    Local texture = Try Texture.FromImage(map, False)
    Print("a pixel from the GPU {texture.ReadPixel(5, 9)}")

    // A target, locked and written a pixel at a time.
    Local locked = Try Texture.Target(32, 32)
    Local pixels = locked.LockPixels()
    Print("locked {pixels.Width()} by {pixels.Height()}")
    For y = 0 To 31
        For x = 0 To 31
            pixels.Set(x, y, Color32(x * 8 As UInt8, y * 8 As UInt8, 128, 255))
        End For
    End For
    Print("as written {pixels.Get(3, 4)}")
    pixels.Unlock()
    Print("unlocked, from the GPU {locked.ReadPixel(3, 4)}")

    // A plain texture, locked, an alpha ramp written, then drawn with ALPHA over a solid color, as a
    // font's atlas written by hand is. Blending's in linear light on the canvas, so half alpha over
    // black reads 188, sRGB's half, not 128, whatever a material's fixed-function look encodes.
    Local blank = Image(4, 1)
    blank.Fill(Color32(0, 0, 0, 0))
    Local ramp = Try Texture.FromImage(blank, False)
    Local written = ramp.LockPixels()
    For x = 0 To 3
        written.Set(x, 0, Color32(255, 255, 255, [0, 64, 128, 255][x] As UInt8))
    End For
    written.Unlock()
    Print("a plain texture's alpha from the GPU {ramp.ReadPixel(2, 0)}")
    Local over = Try Texture.Target(4, 1)
    Local onto = Canvas(over)
    onto.SetColor(Color32(0, 0, 0, 255))
    onto.Clear()
    onto.SetBlend(Blend2D.ALPHA)
    onto.SetColor(Color32(255, 255, 255, 255))
    onto.Draw(Sprite2D(ramp), 0.0, 0.0)
    Print("drawn over black {over.ReadPixel(0, 0)}, {over.ReadPixel(1, 0)}, {over.ReadPixel(2, 0)}, {over.ReadPixel(3, 0)}")

    // What's drawn is read back too, and part of it as an image.
    Local canvas = Canvas(locked)
    canvas.SetColor(Color32(255, 0, 0, 255))
    canvas.DrawRect(10, 10, 2, 2)
    Print("drawn, then read {locked.ReadPixel(10, 10)}")
    Local part = locked.ToImage(10, 10, 4, 4)
    Print("a part of it {part.Width} by {part.Height}: {part[0, 0]}, {part[3, 3]}")

    // The screen's, as a screenshot's.
    Flip()
    Local screen = Screen.Canvas()
    screen.SetColor(Color32(1, 2, 3, 255))
    screen.Clear()
    Print("the screen's {(Try Screen.ToImage())[0, 0]}")

    // A lot at once: writing a locked texture stays quick.
    Local many = Try Texture.Target(1024, 1024)
    Local run = many.LockPixels()
    Local clock = Stopwatch.StartNew()
    For y = 0 To 1023
        For x = 0 To 1023
            run.Set(x, y, Color32(255, 255, 255, 255))
        End For
    End For
    Local seconds = clock.Elapsed.TotalSeconds
    run.Unlock()
    Print("a million written in under 10 seconds {seconds < 10.0}")
End Function

// A window of a texture being painted a pixel at a time; or `frames` frames offscreen.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("pixels of images and textures: Escape ends it")
    Frame.SetLimit(60)
    Local paper = Try Texture.Target(128, 128)
    paper.SetFilter(TextureFilter.NEAREST)
    Local sprite = Sprite2D(paper)
    Local font = Font.BuiltIn(18.0)
    Local count = 0
    Local at = 0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        Local pixels = paper.LockPixels()
        For i = 1 To 256
            Local x = at % 128
            Local y = (at / 128) % 128
            Local wave = Sin((x As Float) * 0.2 + (count As Float) * 0.05) * Cos((y As Float) * 0.2)
            pixels.Set(x, y,
                       Color32((128.0 + wave * 127.0) As UInt8, (x * 2) As UInt8, (y * 2) As UInt8,
                               255))
            at += 1
        End For
        pixels.Unlock()
        If Screen.Texture() == Null Then Continue
        Local canvas = Screen.Canvas()
        canvas.SetColor(Color32(24, 28, 36, 255))
        canvas.Clear()
        canvas.SetColor(Color32(255, 255, 255, 255))
        canvas.SetScale(3.0, 3.0)
        canvas.Draw(sprite, 208.0, 20.0)
        canvas.SetScale(1.0, 1.0)
        canvas.DrawText(font, "a texture written a pixel at a time, {at} so far", 16, 416)
    End While
    Print("watched {count} frames")
End Function

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

Local arguments = Process.Arguments()
If arguments.Contains("--watch")
    Try Watched(Asked(arguments), arguments)
Else
    Try Proved()
End If
