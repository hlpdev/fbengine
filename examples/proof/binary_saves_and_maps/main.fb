// A game's saves and maps, as binary files, through std: ints, floats, bools, and strings with their
// lengths, in folders it makes, lists, and cleans up. It prints what it read back; with --watch, a
// window of a map read back from its file, each room lit by its light, saved again as it changes.

Import std.collections
Import std.core
Import std.io
Import std.math
Import std.text
Import std.os
Import fbengine

// A room of a map: a name, where it is, and which doors it has.
Struct Room
    Field Name: String
    Field X: Int32
    Field Z: Int32
    Field Light: Float32
    Field Doors: UInt8
    Field Locked: Bool
End Struct

// A string as its length, then its bytes.
Function WriteName(writer: BinaryWriter, name: String) Throws IOError
    Try writer.WriteInt32(name.Length)
    Try writer.WriteText(name)
End Function

Function ReadName(reader: BinaryReader): String Throws IOError
    Local length = Try reader.ReadInt32()
    Return Try reader.ReadText(length As Int64)
End Function

Function Saved(path: Path, rooms: Room[], seed: Int64, time: Float64) Throws IOError
    Local file = Try File.Create(path)
    Defer file.Close()
    Local writer = BinaryWriter(file)
    Try writer.WriteText("MAP1")
    Try writer.WriteInt64(seed)
    Try writer.WriteFloat64(time)
    Try writer.WriteInt32(rooms.Count)
    For room In rooms
        Try WriteName(writer, room.Name)
        Try writer.WriteInt32(room.X)
        Try writer.WriteInt32(room.Z)
        Try writer.WriteFloat32(room.Light)
        Try writer.WriteUInt8(room.Doors)
        Try writer.WriteBool(room.Locked)
    End For
End Function

Function Main() Throws IOError
    // A folder of its own, so two runs at once don't meet.
    Local temporary = Try TempDir()
    Local folder = temporary.Path / "saves"
    Try Dir.CreateAll(folder / "slot 1")
    Local path = folder / "slot 1" / "map.bin"

    Local rooms = [Room("lobby", 0, 0, 0.75, 3, False), Room("tunnel, é", -8, 16, 0.25, 2, True)]
    Try Saved(path, rooms, 1234567890123, 61.5)
    Print("the file's {(Try File.ReadBytes(path)).Count} bytes")

    // Read back as it was written, little-endian whatever the machine.
    Local file = Try File.Open(path)
    Local reader = BinaryReader(file)
    Print("its magic {Try reader.ReadText(4)}")
    Print("seed {Try reader.ReadInt64()}, time {Try reader.ReadFloat64()}")
    Local count = Try reader.ReadInt32()
    Print("{count} rooms")
    For i = 1 To count
        Local name = Try ReadName(reader)
        Local x = Try reader.ReadInt32()
        Local z = Try reader.ReadInt32()
        Local light = Try reader.ReadFloat32()
        Local doors = Try reader.ReadUInt8()
        Local locked = Try reader.ReadBool()
        Print("{name} at {x}, {z}, light {light}, doors {doors}, locked {locked}")
    End For

    // Past its end is an error, not a zero.
    Local ended = False
    Try
        Try reader.ReadInt32()
    Catch e As IOError
        ended = True
    End Try
    Print("reading past the end throws {ended}")
    file.Close()

    // Bytes on disk are what they say: a known layout, by hand.
    Local bytes = Try File.ReadBytes(path)
    Print("its first bytes {bytes[0]}, {bytes[1]}, {bytes[2]}, {bytes[3]}")
    Print("the seed's low byte {bytes[4]}, as 1234567890123 % 256 is {(1234567890123 As Int64) % 256}")

    // And the other way: what's read from bytes written by hand, not by its writer.
    Local known = folder / "known.bin"
    Try File.WriteBytes(known,
                        [120 As UInt8, 86 As UInt8, 52 As UInt8, 18 As UInt8, 0 As UInt8,
                         0 As UInt8,
                         128 As UInt8, 63 As UInt8, 2 As UInt8, 0 As UInt8, 0 As UInt8, 0 As UInt8,
                         195 As UInt8, 169 As UInt8])
    Local byHand = Try File.Open(known)
    Local handReader = BinaryReader(byHand)
    Print("an Int32 {Try handReader.ReadInt32()}, a Float32 {Try handReader.ReadFloat32()}")
    Print("a name of 2 bytes is an accented e {(Try ReadName(handReader)) == "\u{e9}"}")
    byHand.Close()
    Try File.Delete(known)

    // Folders: what's in one, and each kind.
    Try File.WriteBytes(folder / "options.bin", [1 As UInt8, 2 As UInt8])
    Local names: String[] = []
    For entry In Try Dir.Entries(folder)
        names.Add("{entry.Name()}{entry.IsDirectory() ? "/" : ""}")
    End For
    names.Sort()
    Print("in its folder: {names.Join(", ")}")
    Print("before deleting, it's there {File.Exists(folder / "options.bin")}")
    Print("a folder as a file {File.Exists(folder)}, a file as a folder {Dir.Exists(folder / "options.bin")}, the folder {Dir.Exists(folder)}")
    Try File.Delete(folder / "options.bin")
    Print("deleted, it's there {File.Exists(folder / "options.bin")}")
    Try Dir.RemoveAll(folder)
    Print("its folder removed, it's there {Dir.Exists(folder)}")
    Try temporary.Close()
End Function

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

// A file's rooms.
Function Loaded(path: Path): Room[] Throws IOError
    Local file = Try File.Open(path)
    Defer file.Close()
    Local reader = BinaryReader(file)
    Try reader.ReadText(4)
    Try reader.ReadInt64()
    Try reader.ReadFloat64()
    Local rooms: Room[] = []
    For i = 1 To Try reader.ReadInt32()
        Local name = Try ReadName(reader)
        Local x = Try reader.ReadInt32()
        Local z = Try reader.ReadInt32()
        Local light = Try reader.ReadFloat32()
        Local doors = Try reader.ReadUInt8()
        Local locked = Try reader.ReadBool()
        rooms.Add(Room(name, x, z, light, doors, locked))
    End For
    Return rooms
End Function

// A window of a map saved and read back each second, its rooms' lights moving; or `frames` frames
// offscreen, saving each.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError, IOError
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("binary saves and maps: Escape ends it")
    Frame.SetLimit(60)
    Local folder = Try TempDir()
    Local path = folder.Path / "map.bin"
    Local font = Font.BuiltIn(18.0)
    Local rooms = [Room("lobby", 0, 0, 0.75, 3, False), Room("tunnel", 8, 4, 0.25, 2, True),
                   Room("vault", 16, 8, 0.5, 1, True), Room("hall", 4, 10, 1.0, 4, False)]
    Local read: Room[] = []
    Local count = 0
    Local waited: Float = 1.0
    Local time: Float = 0.0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        Local seconds = frames > 0 ? 1.0 : Frame.Delta() As Float
        time += seconds
        waited += seconds
        If waited >= 1.0
            waited = 0.0
            For i = 0 To rooms.Count - 1
                Local room = rooms[i]
                rooms[i] = Room(room.Name, room.X, room.Z, Fract(room.Light + 0.13), room.Doors,
                                room.Locked)
            End For
            Try Saved(path, rooms, count As Int64, time As Float64)
            read = Try Loaded(path)
        End If
        If Screen.Texture() == Null Then Continue
        Local canvas = Screen.Canvas()
        canvas.SetColor(Color32(24, 28, 36, 255))
        canvas.Clear()
        For room In read
            Local shade = (room.Light * 255.0) As UInt8
            canvas.SetColor(Color32(shade, shade, room.Locked ? 60 : shade, 255))
            canvas.DrawRect(room.X * 30 + 40, room.Z * 30 + 40, 100, 60)
            canvas.SetColor(Color32(230, 232, 235, 255))
            canvas.DrawText(font, "{room.Name}, {room.Doors} doors", room.X * 30 + 40,
                            room.Z * 30 + 104)
        End For
    End While
    If count == frames
        // Each room's rectangle, where and as lit as what was read back says.
        Local shown = Try Screen.ToImage()
        Local right = read.Count == 4
        For room In read
            Local shade = (room.Light * 255.0) As UInt8
            If shown[room.X * 30 + 90, room.Z * 30 + 70] !=
               Color32(shade, shade, room.Locked ? 60 : shade, 255)
                right = False
            End If
        End For
        Print("{read.Count} rooms, each drawn by what's read back {right}, the first's light {read[0].Light:.2}")
    End If
    Try folder.Close()
    Print("watched {count} frames")
End Function

Local arguments = Process.Arguments()
If !arguments.Contains("--watch")
    Try Main()
ElseIf Env.Get("FBENGINE_NO_GPU") == "1"
    Print("no GPU here")
Else
    Try Watched(Asked(arguments), arguments)
End If
