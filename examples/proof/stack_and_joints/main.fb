// A stack and what joints do, each piece a body driving an entity: a pyramid that stands, a heavy
// block held out on a chain and let go into it, a door a motor swings on its hinge, a lift a motor
// runs up its rail with a crate on it, and a fan a motor turns. It prints how that went, twice over,
// to show it goes the same. With --watch, a window plays it again and again, its entities the
// meshes the renderer draws; --frames, as a test runs it, keeps that headless, a 60th of a second a
// frame, and says what was drawn.

Import std.collections
Import std.core
Import std.math
Import std.os
Import fbengine
Import fbengine_physics

// Steps at 60 a second before the block's let go, and between the door's and the lift's turns.
Const HELD: Int32 = 180
Const TURN: Int32 = 240
Const LINKS: Int32 = 5
Const LINK: Float = 1.2

// A box, a mesh its body drives.
Class Piece
    ReadOnly Field entity: Entity
    ReadOnly Field body: Body
    ReadOnly Field size: Vec3
    ReadOnly Field start: Vec3

    New(world: PhysicsWorld, cube: Geometry, size: Vec3, motion: Motion, start: Vec3, color: Color)
        Local mesh = Mesh(cube)
        // Light adds up in linear values, and these are as a screen shows them, more or less.
        mesh.SetMaterial(Material(Color(color.r * color.r, color.g * color.g, color.b * color.b)))
        // The cube's 2 across.
        mesh.SetScale(size * 0.5)
        mesh.SetPosition(start)
        entity = mesh
        body = Body(world, Shape.Box(size), motion, entity)
        Self.size = size
        Self.start = start
    End New

    Method Moved(): Float => Distance(entity.Position(Space.WORLD), start)
End Class

Function Added(pieces: Piece[], piece: Piece): Piece
    pieces.Add(piece)
    Return piece
End Function

// A pyramid six high at the middle of the floor.
Function Pyramid(world: PhysicsWorld, cube: Geometry, pieces: Piece[]): Piece[]
    Local stack: Piece[] = []
    For layer = 0 To 5
        For i = 0 To 5 - layer
            Local at = Vec3((i As Float) - ((5 - layer) As Float) / 2, 0.5 + (layer As Float), 0)
            Local warm = Color(0.8 - (layer As Float) * 0.06, 0.45 + (i As Float) * 0.05, 0.25)
            Local box = Piece(world, cube, Vec3(1, 1, 1), Motion.DYNAMIC, at, warm)
            box.body.SetMass(50)
            stack.Add(Added(pieces, box))
        End For
    End For
    Return stack
End Function

Class Scene
    ReadOnly Field stage: World
    ReadOnly Field world: PhysicsWorld
    ReadOnly Field camera: Camera
    ReadOnly Field pieces: Piece[] = []
    ReadOnly Field stack: Piece[]
    ReadOnly Field links: Piece[] = []
    ReadOnly Field block: Piece
    ReadOnly Field hold: Joint
    ReadOnly Field door: Piece
    ReadOnly Field hinge: Joint
    ReadOnly Field lift: Piece
    ReadOnly Field rail: Joint
    ReadOnly Field crate: Piece
    ReadOnly Field fan: Piece
    Field steps: Int32 = 0

    New()
        stage = World()
        World.SetCurrent(stage)
        stage.SetAmbientLight(Color(0.2, 0.2, 0.24))
        Local sun = Light(LightType.DIRECTIONAL)
        sun.SetPosition(Vec3(12, 24, 14))
        sun.PointAt(Vec3(0, 0, 0))
        camera = Camera()
        camera.SetClearColor(Color(0.01, 0.012, 0.018))
        world = PhysicsWorld()
        Local cube = Geometry.Cube()
        Local gray = Color(0.36, 0.38, 0.42)
        Added(pieces, Piece(world, cube, Vec3(30, 1, 30), Motion.STATIC, Vec3(0, -0.5, 0), gray))
        stack = Pyramid(world, cube, pieces)

        // Links straight out from a hook, the block at their end, which a fixed joint holds there.
        Local hook = Vec3(0, 8.5, 1)
        Local steel = Color(0.67, 0.69, 0.73)
        Local linkSize = Vec3(0.12, 0.12, LINK - 0.1)
        Local above: Body? = Null
        For i = 0 Until LINKS
            Local along = (i As Float) * LINK
            Local link = Piece(world, cube, linkSize, Motion.DYNAMIC,
                               hook + Vec3(0, 0, along + LINK / 2),
                               steel)
            Added(pieces, link)
            link.body.SetMass(100)
            Joint.Point(link.body, above, hook + Vec3(0, 0, along))
            links.Add(link)
            above = link.body
        End For
        Local end = hook + Vec3(0, 0, (LINKS As Float) * LINK)
        block = Piece(world, cube, Vec3(1.6, 1.6, 1.6), Motion.DYNAMIC, end + Vec3(0, 0, 0.8),
                      Color(0.85, 0.15, 0.12))
        Added(pieces, block)
        block.body.SetMass(1000)
        Joint.Point(block.body, above, end)
        hold = Joint.Fixed(block.body, Null)

        // A door on its left edge, a quarter turn either way.
        door = Piece(world, cube, Vec3(2, 3, 0.2), Motion.DYNAMIC, Vec3(9, 1.6, 0),
                     Color(0.27, 0.47, 0.78))
        Added(pieces, door)
        door.body.SetMass(20)
        hinge = Joint.Hinge(door.body, Null, Vec3(8, 1.6, 0), Vec3(0, 1, 0))
        hinge.SetLimits(-Pi / 2, Pi / 2)

        // A lift on a rail up from the floor, with a crate on it.
        lift = Piece(world, cube, Vec3(3, 0.5, 3), Motion.DYNAMIC, Vec3(-8, 0.5, 8),
                     Color(0.31, 0.67, 0.43))
        Added(pieces, lift)
        lift.body.SetMass(100)
        rail = Joint.Slider(lift.body, Null, Vec3(0, 1, 0))
        rail.SetLimits(0, 4)
        crate = Piece(world, cube, Vec3(1, 1, 1), Motion.DYNAMIC, Vec3(-8, 1.25, 8),
                      Color(0.75, 0.59, 0.35))
        Added(pieces, crate)
        crate.body.SetMass(50)

        // A fan's blade, turning about its middle.
        fan = Piece(world, cube, Vec3(4, 0.4, 0.2), Motion.DYNAMIC, Vec3(-8, 3, 0),
                    Color(0.78, 0.75, 0.31))
        Added(pieces, fan)
        Joint.Hinge(fan.body, Null, Vec3(-8, 3, 0), Vec3(0, 0, 1)).SetMotorSpeed(2, 500)
        world.Optimize()
    End New

    // On by `seconds` of time, the motors told where to go next, and the block let go when it's due.
    Method Update(seconds: Float64)
        For step = 1 To world.Update(seconds)
            Scheduled()
            steps += 1
        End For
    End Method

    Method Scheduled()
        If steps % TURN == 0
            Local out = (steps / TURN) % 2 == 0
            hinge.SetMotorTarget(out ? Pi / 2 : -Pi / 2, 400)
            door.body.Wake()
            rail.SetMotorTarget(out ? 4.0 : 0.0, 6000)
            lift.body.Wake()
        End If
        If steps == HELD
            hold.SetEnabled(False)
            block.body.Wake()
        End If
    End Method

    Method Free()
        world.Free()
        stage.Free()
    End Method
End Class

// Where every piece has been left and how fast it's going, to the bit.
Function Left(scene: Scene): String
    Local left = ""
    For piece In scene.pieces
        left += " {piece.entity.Position(Space.WORLD)} {piece.entity.Rotation(Space.WORLD)} {piece.body.Velocity()}"
    End For
    Return left
End Function

// One run, saying how it goes if `saying`, of where it ends.
Function Run(saying: Bool): String
    Local scene = Scene()
    Defer scene.Free()
    For frame = 1 To HELD
        scene.Update(1.0 / 60)
    End For
    If saying
        Local standing = True
        For piece In scene.stack
            standing = standing && piece.Moved() < 0.25 && !piece.body.Active()
        End For
        Print("the stack stands, at rest: {standing}")
        Print("the block's held where it was: {scene.block.Moved() < 0.05}")
        Print("the door's opened a quarter turn: {Abs(scene.hinge.Position() - Pi / 2) < 0.1}")
        Print("the lift's 4 m up: {Abs(scene.rail.Position() - 4) < 0.15}")
        Print("the crate's on it: {Abs(scene.crate.body.Position().y - scene.lift.body.Position().y - 0.75) < 0.05}")
        Print("the fan's turning at its motor's speed: {Abs(scene.fan.body.AngularVelocity().z - 2) < 0.1}")
    End If
    For frame = 1 To 180
        scene.Update(1.0 / 60)
    End For
    If saying
        Local knocked = 0
        For piece In scene.stack
            If piece.Moved() > 0.5 Then knocked += 1
        End For
        Print("let go, the block's knocked at least five of the stack away: {knocked >= 5}")
        Local together = True
        For i = 1 Until LINKS
            Local apart = Distance(scene.links[i].body.Position(),
                                   scene.links[i - 1].body.Position())
            together = together && Abs(apart - LINK) < 0.1
        End For
        Print("the chain's held together: {together}")
        Print("the door's swung back: {Abs(scene.hinge.Position() + Pi / 2) < 0.2}")
        Print("the lift's come back down: {scene.rail.Position() < 0.2}")
        Local onBodies = True
        For piece In scene.pieces
            onBodies = onBodies && piece.entity.Position(Space.WORLD) == piece.body.Position()
        End For
        Print("every entity's on its body: {onBodies}")
    End If
    Return Left(scene)
End Function

// The scene again and again, until the window's closed or Escape's pressed, or for `frames` frames
// if it's not 0, a new one every 12 seconds, the camera going around.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError
    If Env.Get("FBENGINE_NO_GPU") == "1"
        Print("no GPU here")
        Return
    End If
    Window.SetHeadless(frames > 0)
    Try Graphics(960, 600)
    Defer EndGraphics()
    Window.SetTitle("a stack and joints: Escape ends it")
    Frame.SetLimit(60)
    Local scene = Scene()
    Local turning: Float = 0
    Local count = 0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        If scene.steps >= 720 || count == Asked(arguments, "--again-at")
            scene.Free()
            scene = Scene()
        End If
        Local seconds = frames > 0 ? 1.0 / 60 : Frame.Delta()
        scene.Update(seconds)
        turning += (seconds * 0.1) As Float
        scene.camera.SetPosition(Vec3(Sin(turning) * 30, 12, Cos(turning) * 30))
        scene.camera.PointAt(Vec3(0, 3, 0))
        RenderWorld()
    End While
    If count == frames Then Try Say(scene)
    scene.Free()
    Print("watched {count} frames")
End Function

// What the camera drew at the end of a walk: every piece, the block in its red where it's held.
Function Say(scene: Scene) Throws GraphicsError
    Print("{scene.camera.Draws().Count} of {scene.pieces.Count} pieces drawn")
    Local at = scene.camera.Project(scene.block.entity.Position(Space.WORLD))
    If at == Null
        Print("the block's behind the camera")
        Return
    End If
    Local shown = (Try Screen.ToImage())[at.x As Int32, at.y As Int32]
    Print("the block's drawn red: {shown.r > shown.g * 2 && shown.r > shown.b * 2}")
End Function

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// The number `arguments` has after `name`, or 0.
Function Asked(arguments: String[], name: String): Int
    Local at = arguments.IndexOf(name)
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

Local arguments = Process.Arguments()
If arguments.Contains("--watch")
    Try
        Try Watched(Asked(arguments, "--frames"), arguments)
    Catch error As GraphicsError
        Print("couldn't draw it: {error.Message}")
    End Try
Else
    Local first = Run(True)
    Print("twice over, it all ends alike: {first == Run(False)}")
End If
