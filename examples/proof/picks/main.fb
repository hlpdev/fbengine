// Picks: a line through the world, a line with a radius, what's ahead of an entity, and what's under
// a point of a camera's view, with what each reports. It prints them; with --watch, a window of the
// mouse's or a sweeping line's pick marked where it lands.

Import std.core
Import std.math
Import fbengine
Import std.collections
Import std.os

Function Shown(at: Vec3): String => "{at.x:.2}, {at.y:.2}, {at.z:.2}"

Function Said(pick: Pick?): String
    If pick == Null Then Return "nothing"
    Return "{pick.Entity.Name()} at {Shown(pick.Point)}, facing {Shown(pick.Normal)}, {pick.Time:.2} along"
End Function

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

// Whether any of the screen's pixels isn't what's in its corner, as what's behind everything is.
Function Drew(): Bool Throws GraphicsError
    Local image = Try Screen.ToImage()
    Local behind = image[0, 0]
    For y = 0 To image.Height - 1
        For x = 0 To image.Width - 1
            If image[x, y] != behind Then Return True
        End For
    End For
    Return False
End Function

// A material of no lighting.
Function Painted(color: Color): Material
    Local made = Material()
    made.SetShading(Shading.UNLIT)
    made.SetColor(color)
    Return made
End Function

// A window's camera at `at`, looking at `looking`, over almost black.
Function Watching(at: Vec3, looking: Vec3): Camera
    Local camera = Camera()
    camera.SetPosition(at)
    camera.PointAt(looking)
    camera.SetClearColor(Color(0.02, 0.02, 0.03))
    Return camera
End Function

// A window of what's under the mouse, or a sweep across the view offscreen, marked and named; or
// `frames` frames offscreen.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("picks: Escape ends it")
    Frame.SetLimit(60)
    Local world = World()
    World.SetCurrent(world)
    Defer world.Free()
    Local floor = Mesh(Geometry.Plane(4))
    floor.SetName("floor")
    floor.SetScale(Vec3(10, 1, 10))
    floor.SetPickMode(PickMode.MESH)
    floor.SetMaterial(Painted(Color(0.15, 0.15, 0.2)))
    Local ball = Mesh(Geometry.Sphere())
    ball.SetName("ball")
    ball.SetPosition(Vec3(2, 1, 0))
    ball.SetCollisionRadius(1)
    ball.SetPickMode(PickMode.ELLIPSOID)
    ball.SetMaterial(Painted(Color(0.2, 0.7, 0.9)))
    Local crate = Mesh(Geometry.Cube())
    crate.SetName("crate")
    crate.SetPosition(Vec3(-3, 1, 0))
    crate.SetCollisionBox(AABB(Vec3(-1, -1, -1), Vec3(1, 1, 1)))
    crate.SetPickMode(PickMode.BOX)
    crate.SetMaterial(Painted(Color(0.8, 0.5, 0.2)))
    Local marker = Mesh(Geometry.Sphere())
    marker.SetScale(Vec3(0.15, 0.15, 0.15))
    marker.SetMaterial(Painted(Color(1, 0.1, 0.1)))
    Local camera = Watching(Vec3(0, 6, 9), Vec3(0, 0, 0))
    Local font = Font.BuiltIn(18.0)
    Local time: Float = 0.0
    Local count = 0
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        Local seconds = frames > 0 ? 0.1 : Frame.Delta() As Float
        time += seconds
        Local point = frames > 0 ? Vec2((400.0 + Sin(time) * 300.0) As Float32,
                                        240.0) : Vec2(MouseX(), MouseY())
        Local pick = camera.Pick(point)
        If pick != Null
            marker.Show()
            marker.SetPosition(pick.Point)
        Else
            marker.Hide()
        End If
        RenderWorld()
        Local canvas = Screen.Canvas()
        canvas.SetBlend(Blend2D.ALPHA)
        canvas.SetColor(Color32(230, 232, 235, 255))
        canvas.DrawText(font, pick != Null ? "{Said(pick)}" : "nothing", 16, 16)
    End While
    Print("drew {Try Drew()}")
    Print("watched {count} frames")
End Function

Local arguments = Process.Arguments()
If !arguments.Contains("--watch")
    Local world = World()
    World.SetCurrent(world)
    Local floor = Mesh(Geometry.Plane(4))
    floor.SetName("floor")
    floor.SetScale(Vec3(10, 1, 10))
    floor.SetPickMode(PickMode.MESH)
    Local ball = Pivot()
    ball.SetName("ball")
    ball.SetPosition(Vec3(2, 1, 0))
    ball.SetCollisionRadius(0.5)
    ball.SetPickMode(PickMode.ELLIPSOID)
    Local crate = Pivot()
    crate.SetName("crate")
    crate.SetPosition(Vec3(-3, 1, 0))
    crate.SetCollisionBox(AABB(Vec3(-1, -1, -1), Vec3(1, 1, 1)))
    crate.SetPickMode(PickMode.BOX)
    Local ignored = Pivot()
    ignored.SetName("not pickable")
    ignored.SetPosition(Vec3(0, 3, 3))
    ignored.SetCollisionRadius(1)

    // A line: the nearest thing it meets, and each of the three kinds.
    Print("down onto the floor: {Said(world.Pick(Vec3(1, 5, 3), Vec3(1, -5, 3)))}")
    Print("down onto the ball: {Said(world.Pick(Vec3(2, 5, 0), Vec3(2, -5, 0)))}")
    Print("down onto the crate: {Said(world.Pick(Vec3(-3, 5, 0), Vec3(-3, -5, 0)))}")
    Local hit = world.Pick(Vec3(1, 5, 3), Vec3(1, -5, 3))
    Print("the floor's surface {hit?.Surface != Null}, a triangle {(hit?.Triangle ?? -1) >= 0}")
    Print("the ball's surface {world.Pick(Vec3(2, 5, 0), Vec3(2, -5, 0))?.Surface == Null}")

    // What doesn't count: an entity with no pick mode, one hidden, one left out, and a mesh's back.
    Print("through what isn't pickable: {Said(world.Pick(Vec3(0, 5, 3), Vec3(0, -5, 3)))}")
    Print("from under the floor: {Said(world.Pick(Vec3(1, -5, 3), Vec3(1, 5, 3)))}")
    Print("ignoring the ball: {Said(world.Pick(Vec3(2, 5, 0), Vec3(2, -5, 0), 0, ball))}")
    ball.Hide()
    Print("with the ball hidden: {Said(world.Pick(Vec3(2, 5, 0), Vec3(2, -5, 0)))}")
    ball.Show()

    // With a radius: a line that misses the ball, swept wide enough, meets it.
    Print("a line beside the ball: {Said(world.Pick(Vec3(2.8, 5, 0), Vec3(2.8, 1.5, 0)))}")
    Print("a line of radius 0.5 beside it: {Said(world.Pick(Vec3(2.8, 5, 0), Vec3(2.8, 1.5, 0), 0.5))}")

    // Ahead of an entity, as far as its range.
    Local looker = Pivot()
    looker.SetPosition(Vec3(2, 1, 5))
    Print("ahead of something: {Said(looker.Pick(10))}")
    Print("ahead, not far enough: {Said(looker.Pick(2))}")

    // Under a point of a camera's view: its middle, looking at the ball, and a corner, at nothing.
    Local camera = Camera()
    camera.SetViewport(Rect(0, 0, 800, 600))
    camera.SetPosition(Vec3(2, 1, 8))
    Print("the camera's middle: {Said(camera.Pick(Vec2(400, 300)))}")
    Print("high in its view: {Said(camera.Pick(Vec2(400, 0)))}")
    world.Free()
ElseIf Env.Get("FBENGINE_NO_GPU") == "1"
    Print("no GPU here")
Else
    Try Watched(Asked(arguments), arguments)
End If
