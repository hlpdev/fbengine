// A route over a map's waypoints, through std.algo.search's A*: the cheapest by distance, a door
// closing that sends it the long way, no way at all, and a graph that grows. It prints each; with
// --watch, a window of a grid whose walls move, its route found again each time. The
// graph, and what a step costs, are the game's: here, waypoints by their indexes, so nothing holds
// anything in a cycle.

Import std.algo.search
Import std.collections
Import std.core
Import std.math
Import std.os
Import fbengine

Class Graph
    Field Names: String[] = []
    Field Places: Vec2[] = []
    Field Links: Int[][] = []

    New()
    End New

    // Adds a waypoint, and gives its index.
    Method Add(name: String, x: Float32, y: Float32): Int
        Names.Add(name)
        Places.Add(Vec2(x, y))
        Links.Add([])
        Return Names.Count - 1
    End Method

    // Links two waypoints, both ways.
    Method Link(a: Int, b: Int)
        Links[a].Add(b)
        Links[b].Add(a)
    End Method

    // The cheapest route from `from` to `to`, by distance, past `closed` ones, or Null.
    Method Path(from: Int, to: Int, closed: Int[]): Path<Int, Float32>?
        Local steps = Function(at: Int): (Int, Float32)[]
            Local found: (Int, Float32)[] = []
            For next In Links[at]
                If !closed.Contains(next) Then found.Add((next, Distance(Places[at], Places[next])))
            End For
            Return found
        End Function
        Local guess = Function(at: Int): Float32 => Distance(Places[at], Places[to])
        Return AStar(from, steps, guess, Function(at: Int) => at == to)
    End Method

    // That route, as its names and its length.
    Method Route(from: Int, to: Int, closed: Int[] = []): String
        Local path = Path(from, to, closed)
        If path == Null Then Return "no way"
        Local names: String[] = []
        For each In path.Nodes
            names.Add(Names[each])
        End For
        Return "{names.Join(" ")}, {path.Cost:.2} long"
    End Method
End Class

// Presses Escape, or closes the window, at the frames `arguments` says, as a person would: a test's.
Function Driven(arguments: String[], frame: Int) Throws GraphicsError
    For i = 0 To arguments.Count - 2
        If arguments[i + 1] != "{frame}" Then Continue
        If arguments[i] == "--press-at" Then Try Simulate.PressKey(Key.ESCAPE)
        If arguments[i] == "--close-at" Then Try Simulate.CloseWindow()
    End For
End Function

// How many frames `arguments` asks for after --frames, 0 for no end.
Function Asked(arguments: String[]): Int
    Local at = arguments.IndexOf("--frames")
    If at == Null || at + 1 >= arguments.Count Then Return 0
    Return Int.Parse(arguments[at + 1]) ?? 0
End Function

// A window of a grid, a wall moving across it, and the way through; or `frames` frames offscreen.
Function Watched(frames: Int, arguments: String[]) Throws GraphicsError
    Window.SetHeadless(frames > 0)
    Try Graphics(800, 450)
    Defer EndGraphics()
    Window.SetTitle("pathfinding over a graph: Escape ends it")
    Frame.SetLimit(60)
    Local grid = Graph()
    For y = 0 To 17
        For x = 0 To 31
            grid.Add("", x As Float32, y As Float32)
        End For
    End For
    For y = 0 To 17
        For x = 0 To 31
            If x < 31 Then grid.Link(y * 32 + x, y * 32 + x + 1)
            If y < 17 Then grid.Link(y * 32 + x, (y + 1) * 32 + x)
        End For
    End For
    Local count = 0
    Local time: Float = 0.0
    Local route: Int[] = []
    Local shut: Int[] = []
    While !Window.Closed() && !KeyHit(Key.ESCAPE) && (frames == 0 || count < frames)
        Flip()
        count += 1
        Try Driven(arguments, count)
        time += frames > 0 ? 0.25 : Frame.Delta() As Float
        // A wall across the middle, its gap going up and down.
        Local gap = ((Sin(time) + 1.0) * 8.0) As Int
        Local closed: Int[] = []
        For y = 0 To 17
            If y != gap Then closed.Add(y * 32 + 16)
        End For
        Local path = grid.Path(0, 17 * 32 + 31, closed)
        route = path?.Nodes ?? []
        shut = closed
        If Screen.Texture() == Null Then Continue
        Local canvas = Screen.Canvas()
        canvas.SetColor(Color32(24, 28, 36, 255))
        canvas.Clear()
        canvas.SetColor(Color32(200, 60, 60, 255))
        For each In closed
            canvas.DrawRect((each % 32) * 25 + 1, (each / 32) * 25 + 1, 23, 23)
        End For
        canvas.SetColor(Color32(80, 200, 120, 255))
        If path != Null
            For each In path.Nodes
                canvas.DrawRect((each % 32) * 25 + 6, (each / 32) * 25 + 6, 13, 13)
            End For
        End If
    End While
    If count == frames
        // Each square of its way, and of its wall, in its color; its way goes through the wall's gap,
        // corner to corner, so it's 32 + 18 - 1 squares at the least.
        Local shown = Try Screen.ToImage()
        Local right = True
        For each In route
            If shown[(each % 32) * 25 + 12, (each / 32) * 25 + 12] != Color32(80, 200, 120, 255) Then right = False
        End For
        For each In shut
            If shown[(each % 32) * 25 + 12, (each / 32) * 25 + 12] != Color32(200, 60, 60, 255) Then right = False
            If route.Contains(each) Then right = False
        End For
        Print("its way {route.Count} squares from {route[0]} to {route[route.Count - 1]}, by a wall of {shut.Count}, each its color {right}")
    End If
    Print("watched {count} frames")
End Function

// A route over `links`, each from, to, and cost, as AStar finds it by `guess`.
Function Over(links: (Int, Int, Int)[], from: Int, to: Int, guess: Func(Int): Int): String
    Local steps = Function(at: Int): (Int, Int)[]
        Local found: (Int, Int)[] = []
        For link In links
            Local a, b, cost = link
            If a == at Then found.Add((b, cost))
        End For
        Return found
    End Function
    Local found = AStar(from, steps, guess, Function(at: Int) => at == to)
    If found == Null Then Return "none"
    Return "{found.Nodes}, cost {found.Cost}"
End Function

// How many waypoints it opens across a grid of `side` squares, to its far corner, by `guess`.
Function Opened(side: Int, guess: Func(Int): Int): Int
    Local opened = 0
    Local steps = Function(at: Int): (Int, Int)[]
        opened += 1
        Local found: (Int, Int)[] = []
        If at % side < side - 1 Then found.Add((at + 1, 1))
        If at + side < side * side Then found.Add((at + side, 1))
        Return found
    End Function
    AStar(0, steps, guess, Function(at: Int) => at == side * side - 1)
    Return opened
End Function

// What only A* does: the cheapest, not the fewest steps; past a guess's favorite; and a good guess
// opens fewer than none.
Function ByCost()
    Print("cheapest with more steps: {Over([(0, 1, 1), (1, 2, 1), (2, 3, 1), (0, 3, 10)], 0, 3, Function(at: Int) => 0)}")
    Print("past a guess's favorite: {Over([(0, 1, 1), (1, 3, 11), (0, 2, 2), (2, 3, 2)], 0, 3, Function(at: Int) => at == 1 ? 1 : at == 2 ? 2 : 0)}")
    Local blind = Opened(10, Function(at: Int) => 0)
    Local guessed = Opened(10, Function(at: Int) => (9 - at % 10) + (9 - at / 10))
    Print("a good guess opens fewer than none {guessed < blind}")
End Function

Local arguments = Process.Arguments()
If !arguments.Contains("--watch")
    // A lobby, and two ways to the vault: short through a door, long round by a hall.
    Local map = Graph()
    Local lobby = map.Add("lobby", 0.0, 0.0)
    Local door = map.Add("door", 4.0, 0.0)
    Local vault = map.Add("vault", 8.0, 0.0)
    Local hall = map.Add("hall", 0.0, 6.0)
    Local bend = map.Add("bend", 8.0, 6.0)
    map.Link(lobby, door)
    map.Link(door, vault)
    map.Link(lobby, hall)
    map.Link(hall, bend)
    map.Link(bend, vault)
    Print(map.Route(lobby, vault))
    Print("the door closed: {map.Route(lobby, vault, [door])}")
    Print("both closed: {map.Route(lobby, vault, [door, hall])}")
    Print("to itself: {map.Route(lobby, lobby)}")

    // A room with no link has no way; linked, it has one.
    Local attic = map.Add("attic", 8.0, 9.0)
    Print("to a room with no link: {map.Route(lobby, attic)}")
    map.Link(bend, attic)
    Print("linked: {map.Route(lobby, attic)}")

    // A link straight there's shorter than round by two, so it takes it.
    Local corner = map.Add("corner", 3.0, 0.0)
    Local top = map.Add("top", 3.0, 4.0)
    Local start = map.Add("start", 0.0, 0.0)
    map.Link(start, corner)
    map.Link(corner, top)
    map.Link(start, top)
    Print(map.Route(start, top))

    // A grid of 40 by 40, its middle row walled but for its end: the long way's found.
    Local grid = Graph()
    For y = 0 To 39
        For x = 0 To 39
            grid.Add("{x},{y}", x As Float32, y As Float32)
        End For
    End For
    For y = 0 To 39
        For x = 0 To 39
            If x < 39 Then grid.Link(y * 40 + x, y * 40 + x + 1)
            If y < 39 Then grid.Link(y * 40 + x, (y + 1) * 40 + x)
        End For
    End For
    Local walled: Int[] = []
    For x = 0 To 38
        walled.Add(20 * 40 + x)
    End For
    Print("over the grid, straight: {grid.Path(0, 39 * 40, [])?.Cost ?? -1.0}")
    Print("over the grid, walled but for its end: {grid.Path(0, 39 * 40, walled)?.Cost ?? -1.0}")
    ByCost()
ElseIf Env.Get("FBENGINE_NO_GPU") == "1"
    Print("no GPU here")
Else
    Try Watched(Asked(arguments), arguments)
End If
